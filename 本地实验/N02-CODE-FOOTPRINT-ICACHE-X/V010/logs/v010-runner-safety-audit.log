    33	static uint16_t FloatToHalf(float value)
    34	{
    35	    uint32_t bits = 0;
    36	    std::memcpy(&bits, &value, sizeof(bits));
    37	    const uint32_t sign = (bits >> 16) & 0x8000u;
    38	    const uint32_t exponent = (bits >> 23) & 0xffu;
    39	    uint32_t mantissa = bits & 0x7fffffu;
    40	    if (exponent == 0xffu) {
    41	        return static_cast<uint16_t>(sign | 0x7c00u | (mantissa ? 0x0200u : 0u));
    42	    }
    43	    int32_t halfExponent = static_cast<int32_t>(exponent) - 112;
    44	    if (halfExponent >= 31) {
    45	        return static_cast<uint16_t>(sign | 0x7c00u);
    46	    }
    47	    if (halfExponent <= 0) {
    48	        if (halfExponent < -10) {
    49	            return static_cast<uint16_t>(sign);
    50	        }
    51	        mantissa |= 0x800000u;
    52	        const int32_t shift = 14 - halfExponent;
    53	        const uint32_t round = (1u << (shift - 1)) - 1u + ((mantissa >> shift) & 1u);
    54	        return static_cast<uint16_t>(sign | ((mantissa + round) >> shift));
    55	    }
    56	    mantissa += 0xfffu + ((mantissa >> 13) & 1u);
    57	    if (mantissa & 0x800000u) {
    58	        mantissa = 0;
    59	        ++halfExponent;
    60	        if (halfExponent >= 31) {
    61	            return static_cast<uint16_t>(sign | 0x7c00u);
    62	        }
    63	    }
    64	    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(halfExponent) << 10) |
    65	                                 (mantissa >> 13));
    66	}
