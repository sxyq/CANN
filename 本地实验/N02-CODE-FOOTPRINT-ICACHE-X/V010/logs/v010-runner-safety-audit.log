    83	static uint16_t FloatToBfloat16(float value)
    84	{
    85	    uint32_t bits = 0;
    86	    std::memcpy(&bits, &value, sizeof(bits));
    87	    bits += 0x7fffu + ((bits >> 16) & 1u);
    88	    return static_cast<uint16_t>(bits >> 16);
    89	}
