    91	static float Bfloat16ToFloat(uint16_t value)
    92	{
    93	    const uint32_t bits = static_cast<uint32_t>(value) << 16;
    94	    float result = 0.0f;
    95	    std::memcpy(&result, &bits, sizeof(result));
    96	    return result;
    97	}
