    68	static float HalfToFloat(uint16_t value)
    69	{
    70	    const float sign = (value & 0x8000u) ? -1.0f : 1.0f;
    71	    const uint32_t exponent = (value >> 10) & 0x1fu;
    72	    const uint32_t mantissa = value & 0x03ffu;
    73	    if (exponent == 0) {
    74	        return sign * std::ldexp(static_cast<float>(mantissa), -24);
    75	    }
    76	    if (exponent == 0x1fu) {
    77	        return mantissa ? NAN : sign * INFINITY;
    78	    }
    79	    return sign * std::ldexp(1.0f + static_cast<float>(mantissa) / 1024.0f,
    80	                             static_cast<int>(exponent) - 15);
    81	}
