static_assert(std::is_standard_layout<TensorInfo>::value, "TensorInfo must be standard-layout");
static_assert(offsetof(TensorInfo, shape) == 0, "TensorInfo.shape ABI offset mismatch");
static_assert(offsetof(TensorInfo, numDims) == 8, "TensorInfo.numDims ABI offset mismatch");
static_assert(offsetof(TensorInfo, dtype) == 16, "TensorInfo.dtype ABI offset mismatch");
static_assert(sizeof(TensorInfo) == 24, "TensorInfo ABI size mismatch");
static_assert(std::is_standard_layout<TensorGroupInfo>::value,
              "TensorGroupInfo must be standard-layout");
static_assert(offsetof(TensorGroupInfo, tensors) == 0,
              "TensorGroupInfo.tensors ABI offset mismatch");
static_assert(offsetof(TensorGroupInfo, numTensors) == 8,
              "TensorGroupInfo.numTensors ABI offset mismatch");
static_assert(sizeof(TensorGroupInfo) == 16, "TensorGroupInfo ABI size mismatch");

using RouteRunKernelAbi = void (*)(GM_ADDR, const TensorGroupInfo&, GM_ADDR,
                                   const TensorGroupInfo&, GM_ADDR,
                                   const TensorGroupInfo&, GM_ADDR,
                                   const TensorGroupInfo&, GM_ADDR,
                                   const TensorGroupInfo&, int64_t, aclrtStream, float);
static_assert(std::is_same<decltype(&run_kernel), RouteRunKernelAbi>::value,
              "run_kernel ABI signature mismatch");

namespace {

constexpr float kEpsilon = 1.0e-5f;
constexpr char kKernelSourceSha256[] = "a8c19a1972207acc67e3fb0cd393cc70b0a4b183d1eaf5610edf80c2879b15e3";

enum class DType : int32_t { Fp32 = 0, Fp16 = 1, Bf16 = 2 };

struct ShapeCase {
    uint32_t rows;
    uint32_t width;
};

struct CaseData {
    std::vector<uint8_t> x;
    std::vector<uint8_t> residual;
    std::vector<uint8_t> gamma;
    std::vector<uint8_t> bias;
    std::vector<double> golden;
};

struct DeviceBuffers {
    void* x = nullptr;
    void* residual = nullptr;
    void* gamma = nullptr;
    void* bias = nullptr;
    void* output = nullptr;
};

struct Tolerance {
    double atol;
    double rtol;
    double maxAbs;
};

uint16_t FloatToHalf(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const uint32_t sign = (bits >> 16) & 0x8000U;
    const uint32_t rawExp = (bits >> 23) & 0xffU;
    uint32_t mantissa = bits & 0x7fffffU;
    if (rawExp == 0xffU) {
        return static_cast<uint16_t>(sign | 0x7c00U | (mantissa ? 0x0200U : 0U));
    }
    int32_t exponent = static_cast<int32_t>(rawExp) - 127 + 15;
    if (exponent >= 31) return static_cast<uint16_t>(sign | 0x7c00U);
    if (exponent <= 0) {
        if (exponent < -10) return static_cast<uint16_t>(sign);
        mantissa |= 0x800000U;
        const uint32_t shift = static_cast<uint32_t>(14 - exponent);
        const uint32_t rounded = mantissa >> shift;
        const uint32_t remainder = mantissa & ((1U << shift) - 1U);
        const uint32_t halfway = 1U << (shift - 1U);
        return static_cast<uint16_t>(sign + rounded +
            ((remainder > halfway || (remainder == halfway && (rounded & 1U))) ? 1U : 0U));
    }
    uint32_t rounded = mantissa >> 13;
    const uint32_t remainder = mantissa & 0x1fffU;
    if (remainder > 0x1000U || (remainder == 0x1000U && (rounded & 1U))) {
        ++rounded;
        if (rounded == 0x400U) {
            rounded = 0;
            ++exponent;
            if (exponent >= 31) return static_cast<uint16_t>(sign | 0x7c00U);
        }
    }
    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(exponent) << 10) | rounded);
}

float HalfToFloat(uint16_t value)
{
    const uint32_t sign = static_cast<uint32_t>(value & 0x8000U) << 16;
    uint32_t exponent = (value >> 10) & 0x1fU;
    uint32_t mantissa = value & 0x03ffU;
    uint32_t bits = 0;
    if (exponent == 0) {
        if (mantissa == 0) {
            bits = sign;
        } else {
            int32_t exp32 = -14;
            while ((mantissa & 0x0400U) == 0) {
                mantissa <<= 1;
                --exp32;
            }
            mantissa &= 0x03ffU;
            bits = sign | (static_cast<uint32_t>(exp32 + 127) << 23) | (mantissa << 13);
        }
    } else if (exponent == 0x1fU) {
        bits = sign | 0x7f800000U | (mantissa << 13);
    } else {
        bits = sign | ((exponent + 112U) << 23) | (mantissa << 13);
    }
    float result = 0.0f;
    std::memcpy(&result, &bits, sizeof(result));
    return result;
}

uint16_t FloatToBf16(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const uint32_t upper = bits >> 16;
    const uint32_t lower = bits & 0xffffU;
    return static_cast<uint16_t>(upper +
        ((lower > 0x8000U || (lower == 0x8000U && (upper & 1U))) ? 1U : 0U));
}

float Bf16ToFloat(uint16_t value)
{
    const uint32_t bits = static_cast<uint32_t>(value) << 16;
    float result = 0.0f;
    std::memcpy(&result, &bits, sizeof(result));
    return result;
}

size_t ElementBytes(DType dtype)
{
    return dtype == DType::Fp32 ? sizeof(float) : sizeof(uint16_t);
}

void StoreValue(std::vector<uint8_t>& bytes, size_t index, DType dtype, float value)
{
    if (dtype == DType::Fp32) {
        std::memcpy(bytes.data() + index * sizeof(float), &value, sizeof(value));
        return;
    }
    const uint16_t encoded = dtype == DType::Fp16 ? FloatToHalf(value) : FloatToBf16(value);
    std::memcpy(bytes.data() + index * sizeof(uint16_t), &encoded, sizeof(encoded));
}

float LoadValue(const uint8_t* bytes, size_t index, DType dtype)
{
    if (dtype == DType::Fp32) {
        float value = 0.0f;
        std::memcpy(&value, bytes + index * sizeof(float), sizeof(value));
        return value;
    }
    uint16_t encoded = 0;
    std::memcpy(&encoded, bytes + index * sizeof(uint16_t), sizeof(encoded));
    return dtype == DType::Fp16 ? HalfToFloat(encoded) : Bf16ToFloat(encoded);
}

float LoadValue(const std::vector<uint8_t>& bytes, size_t index, DType dtype)
{
    return LoadValue(bytes.data(), index, dtype);
}

const char* DTypeName(DType dtype)
{
    switch (dtype) {
        case DType::Fp32: return "fp32";
        case DType::Fp16: return "fp16";
        case DType::Bf16: return "bf16";
    }
    return "unknown";
}

Tolerance GetTolerance(DType dtype)
{
    switch (dtype) {
        case DType::Fp16: return {1.0 / 512.0, 1.0 / 512.0, 0.1};
        case DType::Bf16: return {1.0 / 64.0, 1.0 / 64.0, 1.0};
        case DType::Fp32: return {1.0 / 65536.0, 1.0 / 1024.0, 1.0e-2};
    }
    return {0.0, 0.0, 0.0};
}

bool CheckAcl(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) return true;
    std::fprintf(stderr, "ACL_ERROR operation=%s code=%d\n", operation,
                 static_cast<int>(status));
    return false;
}

CaseData MakeCaseData(const ShapeCase& shape, DType dtype, uint32_t seed)
{
    const size_t elements = static_cast<size_t>(shape.rows) * shape.width;
    const size_t bytes = elements * ElementBytes(dtype);
    CaseData data;
    data.x.resize(bytes);
    data.residual.resize(bytes);
    data.gamma.resize(static_cast<size_t>(shape.width) * ElementBytes(dtype));
    data.bias.resize(static_cast<size_t>(shape.width) * ElementBytes(dtype));
    data.golden.resize(elements);

    std::mt19937 generator(seed);
    std::uniform_real_distribution<float> xDistribution(-2.0f, 2.0f);
    std::uniform_real_distribution<float> residualDistribution(-1.0f, 1.0f);
    std::uniform_real_distribution<float> gammaDistribution(0.5f, 1.5f);
    std::uniform_real_distribution<float> biasDistribution(-0.25f, 0.25f);
    for (size_t i = 0; i < elements; ++i) {
        StoreValue(data.x, i, dtype, xDistribution(generator));
        StoreValue(data.residual, i, dtype, residualDistribution(generator));
    }
    for (size_t i = 0; i < shape.width; ++i) {
        StoreValue(data.gamma, i, dtype, gammaDistribution(generator));
        StoreValue(data.bias, i, dtype, biasDistribution(generator));
    }

    for (uint32_t row = 0; row < shape.rows; ++row) {
        const size_t rowOffset = static_cast<size_t>(row) * shape.width;
        double squareSum = 0.0;
        for (uint32_t col = 0; col < shape.width; ++col) {
            const double sum = static_cast<double>(LoadValue(data.x, rowOffset + col, dtype)) +
                               LoadValue(data.residual, rowOffset + col, dtype);
            squareSum += sum * sum;
        }
        const double invRms = 1.0 / std::sqrt(squareSum / shape.width + kEpsilon);
        for (uint32_t col = 0; col < shape.width; ++col) {
            const size_t index = rowOffset + col;
            const double sum = static_cast<double>(LoadValue(data.x, index, dtype)) +
                               LoadValue(data.residual, index, dtype);
            data.golden[index] = sum * invRms * LoadValue(data.gamma, col, dtype) +
                                 LoadValue(data.bias, col, dtype);
        }
    }
    return data;
}

void FreeBuffers(DeviceBuffers& buffers)
{
    if (buffers.output) aclrtFree(buffers.output);
    if (buffers.bias) aclrtFree(buffers.bias);
    if (buffers.gamma) aclrtFree(buffers.gamma);
    if (buffers.residual) aclrtFree(buffers.residual);
    if (buffers.x) aclrtFree(buffers.x);
    buffers = {};
}

bool AllocateBuffers(const CaseData& data, const ShapeCase& shape, DType dtype,
                     DeviceBuffers& buffers)
{
    const size_t dataBytes = static_cast<size_t>(shape.rows) * shape.width * ElementBytes(dtype);
    const size_t paramBytes = static_cast<size_t>(shape.width) * ElementBytes(dtype);
    const struct Allocation { void** pointer; size_t size; const char* name; } allocations[] = {
        {&buffers.x, dataBytes, "x"}, {&buffers.residual, dataBytes, "residual"},
        {&buffers.gamma, paramBytes, "gamma"}, {&buffers.bias, paramBytes, "bias"},
        {&buffers.output, dataBytes, "output"},
    };
    for (const auto& allocation : allocations) {
        if (!CheckAcl(aclrtMalloc(allocation.pointer, allocation.size,
                                  ACL_MEM_MALLOC_HUGE_FIRST), allocation.name)) {
            FreeBuffers(buffers);
            return false;
        }
    }
    const struct Copy { void* dst; const void* src; size_t size; const char* name; } copies[] = {
        {buffers.x, data.x.data(), dataBytes, "copy_x"},
        {buffers.residual, data.residual.data(), dataBytes, "copy_residual"},
        {buffers.gamma, data.gamma.data(), paramBytes, "copy_gamma"},
        {buffers.bias, data.bias.data(), paramBytes, "copy_bias"},
    };
    for (const auto& copy : copies) {
        if (!CheckAcl(aclrtMemcpy(copy.dst, copy.size, copy.src, copy.size,
                                  ACL_MEMCPY_HOST_TO_DEVICE), copy.name)) {
            FreeBuffers(buffers);
            return false;
        }
    }
    std::vector<uint8_t> zeros(dataBytes, 0);
    if (!CheckAcl(aclrtMemcpy(buffers.output, dataBytes, zeros.data(), dataBytes,
                              ACL_MEMCPY_HOST_TO_DEVICE), "initialize_output")) {
        FreeBuffers(buffers);
        return false;
    }
    return true;
}

void Launch(const ShapeCase& shape, DType dtype, int64_t coreCount,
            aclrtStream stream, const DeviceBuffers& buffers,
            uint32_t launchCoreCount)
{
    const int64_t dims[] = {static_cast<int64_t>(shape.rows),
                            static_cast<int64_t>(shape.width)};
    const TensorInfo tensors[] = {{dims, 2, static_cast<int32_t>(dtype)}};
    const TensorGroupInfo group = {tensors, 1};
    const int64_t parameterDims[] = {static_cast<int64_t>(shape.width)};
    const TensorInfo parameterTensors[] = {
        {parameterDims, 1, static_cast<int32_t>(dtype)}};
    const TensorGroupInfo parameterGroup = {parameterTensors, 1};
    run_kernel(static_cast<uint8_t*>(buffers.x), group,
               static_cast<uint8_t*>(buffers.residual), group,
               static_cast<uint8_t*>(buffers.gamma), parameterGroup,
               static_cast<uint8_t*>(buffers.bias), parameterGroup,
               static_cast<uint8_t*>(buffers.output), group,
               launchCoreCount, stream, kEpsilon);
}

bool RunCorrectnessCase(const ShapeCase& shape, DType dtype, int64_t coreCount,
                        aclrtStream stream, uint32_t launchCoreCount)
{
    const uint32_t seed = 0x5a17U + shape.rows * 131U + shape.width * 17U +
                          static_cast<uint32_t>(dtype);
    const CaseData data = MakeCaseData(shape, dtype, seed);
    DeviceBuffers buffers;
    if (!AllocateBuffers(data, shape, dtype, buffers)) return false;
    Launch(shape, dtype, coreCount, stream, buffers, launchCoreCount);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "correctness_sync")) {
        FreeBuffers(buffers);
        return false;
    }
    std::vector<uint8_t> output(data.x.size());
    const bool copied = CheckAcl(aclrtMemcpy(output.data(), output.size(), buffers.output,
                                             output.size(), ACL_MEMCPY_DEVICE_TO_HOST),
                                 "copy_output_to_host");
    FreeBuffers(buffers);
    if (!copied) return false;

    const Tolerance tolerance = GetTolerance(dtype);
    size_t matched = 0;
    double maxAbs = 0.0;
    size_t maxAbsIndex = 0;
    size_t firstMismatchIndex = data.golden.size();
    std::vector<size_t> rowMatched(shape.rows, 0);
    std::vector<double> rowMaxAbs(shape.rows, 0.0);
    std::vector<size_t> rowMaxAbsIndex(shape.rows, 0);
    const size_t tileWidth = 4096;
    std::vector<size_t> tileMatched((shape.width + tileWidth - 1) / tileWidth, 0);
    std::vector<size_t> tileElements(tileMatched.size(), 0);
    std::vector<size_t> firstMismatchIndices;
    for (size_t i = 0; i < data.golden.size(); ++i) {
        const double actual = LoadValue(output.data(), i, dtype);
        const double error = std::abs(actual - data.golden[i]);
        const size_t row = i / shape.width;
        const size_t tile = (i % shape.width) / tileWidth;
        ++tileElements[tile];
        if (error > maxAbs) {
            maxAbs = error;
            maxAbsIndex = i;
        }
        if (error > rowMaxAbs[row]) {
            rowMaxAbs[row] = error;
            rowMaxAbsIndex[row] = i;
        }
        if (error <= tolerance.atol + tolerance.rtol * std::abs(data.golden[i])) {
            ++matched;
            ++rowMatched[row];
            ++tileMatched[tile];
        } else {
            if (firstMismatchIndex == data.golden.size()) firstMismatchIndex = i;
            if (firstMismatchIndices.size() < 12) firstMismatchIndices.push_back(i);
        }
    }
    const double ratio = static_cast<double>(matched) / data.golden.size();
    const bool pass = ratio >= 0.99 && maxAbs <= tolerance.maxAbs;
    const double firstActual = LoadValue(output.data(), 0, dtype);
    std::printf("CASE dtype=%s rows=%u width=%u matched_ratio=%.9f max_abs=%.9g first_actual=%.9g first_golden=%.9g first_bad_idx=%zu max_abs_idx=%zu status=%s\n",
                DTypeName(dtype), shape.rows, shape.width, ratio, maxAbs,
                firstActual, data.golden[0], firstMismatchIndex, maxAbsIndex,
                pass ? "PASS" : "FAIL");
    if (!pass) {
        for (size_t tile = 0; tile < tileMatched.size(); ++tile) {
            std::printf("TILE_DIAG tile=%zu begin=%zu elements=%zu matched_ratio=%.9f\n",
                        tile, tile * tileWidth, tileElements[tile],
                        static_cast<double>(tileMatched[tile]) / tileElements[tile]);
        }
        for (size_t index : firstMismatchIndices) {
            const size_t row = index / shape.width;
            const size_t col = index % shape.width;
            const double actual = LoadValue(output.data(), index, dtype);
            const double golden = data.golden[index];
            const double error = std::abs(actual - golden);
            const double allowed = tolerance.atol + tolerance.rtol * std::abs(golden);
            std::printf("MISMATCH idx=%zu row=%zu col=%zu actual=%.9g golden=%.9g abs_error=%.9g allowed=%.9g\n",
                        index, row, col, actual, golden, error, allowed);
        }
        for (size_t row = 0; row < shape.rows; ++row) {
            const size_t worstIndex = rowMaxAbsIndex[row];
            const double rowRatio = static_cast<double>(rowMatched[row]) / shape.width;
            std::printf("ROW_DIAG row=%zu matched_ratio=%.9f max_abs=%.9g max_abs_col=%zu actual=%.9g golden=%.9g\n",
                        row, rowRatio, rowMaxAbs[row], worstIndex % shape.width,
                        LoadValue(output.data(), worstIndex, dtype), data.golden[worstIndex]);
        }
        if (dtype == DType::Fp32 && shape.width > 8192) {
            const size_t probes[] = {0, 1, 7, 8, 1023, 1024, 4095, 4096,
                                     4103, 8191, 8192, 16383, 16384,
                                     32767, 32768};
            for (size_t row = 0; row < shape.rows; ++row) {
                const size_t rowOffset = row * shape.width;
                double squareSum = 0.0;
                for (size_t col = 0; col < shape.width; ++col) {
                    const double sum = LoadValue(data.x, rowOffset + col, dtype) +
                                       LoadValue(data.residual, rowOffset + col, dtype);
                    squareSum += sum * sum;
                }
                const double expectedScale =
                    1.0 / std::sqrt(squareSum / shape.width + kEpsilon);
                for (size_t col : probes) {
                    if (col >= shape.width) continue;
                    const size_t index = rowOffset + col;
                    const double sum = LoadValue(data.x, index, dtype) +
                                        LoadValue(data.residual, index, dtype);
                    const double gamma = LoadValue(data.gamma, col, dtype);
                    const double bias = LoadValue(data.bias, col, dtype);
                    const double actual = LoadValue(output.data(), index, dtype);
                    const double denom = sum * gamma;
                    const double observedScale = std::abs(denom) > 1.0e-12
                        ? (actual - bias) / denom : 0.0;
                    std::printf("VALUE_DIAG row=%zu col=%zu x=%.9g residual=%.9g gamma=%.9g bias=%.9g actual=%.9g golden=%.9g observed_scale=%.9g expected_scale=%.9g\n",
                                row, col, LoadValue(data.x, index, dtype),
                                LoadValue(data.residual, index, dtype), gamma, bias,
                                actual, data.golden[index], observedScale, expectedScale);
                }
            }
        }
    }
    return pass;
}

bool RunBenchmark(const ShapeCase& shape, DType dtype, int64_t coreCount,
                  aclrtStream stream, uint32_t warmup, uint32_t samples,
                  uint32_t launchCoreCount)
{
    const CaseData data = MakeCaseData(shape, dtype, 0x7b31U);
    DeviceBuffers buffers;
    if (!AllocateBuffers(data, shape, dtype, buffers)) return false;
    aclrtEvent startEvent = nullptr;
    aclrtEvent stopEvent = nullptr;
    if (!CheckAcl(aclrtCreateEvent(&startEvent), "create_start_event") ||
        !CheckAcl(aclrtCreateEvent(&stopEvent), "create_stop_event")) {
        if (startEvent) aclrtDestroyEvent(startEvent);
        if (stopEvent) aclrtDestroyEvent(stopEvent);
        FreeBuffers(buffers);
        return false;
    }
    for (uint32_t i = 0; i < warmup; ++i) {
        Launch(shape, dtype, coreCount, stream, buffers, launchCoreCount);
    }
    if (!CheckAcl(aclrtSynchronizeStream(stream), "warmup_sync")) {
        aclrtDestroyEvent(stopEvent);
        aclrtDestroyEvent(startEvent);
        FreeBuffers(buffers);
        return false;
    }
    for (uint32_t i = 0; i < samples; ++i) {
        if (!CheckAcl(aclrtRecordEvent(startEvent, stream), "record_start_event")) break;
        const auto wallStart = std::chrono::steady_clock::now();
        Launch(shape, dtype, coreCount, stream, buffers, launchCoreCount);
        if (!CheckAcl(aclrtRecordEvent(stopEvent, stream), "record_stop_event") ||
            !CheckAcl(aclrtSynchronizeEvent(stopEvent), "sync_stop_event")) break;
        const auto wallStop = std::chrono::steady_clock::now();
        float elapsedMs = 0.0f;
        if (!CheckAcl(aclrtEventElapsedTime(&elapsedMs, startEvent, stopEvent),
                      "event_elapsed_time")) break;
        const double wallUs = std::chrono::duration<double, std::micro>(
            wallStop - wallStart).count();
        std::printf("SAMPLE index=%u device_us=%.6f wall_us=%.6f\n", i,
                    static_cast<double>(elapsedMs) * 1000.0, wallUs);
    }
    const bool eventsFreed = CheckAcl(aclrtDestroyEvent(stopEvent), "destroy_stop_event") &&
                             CheckAcl(aclrtDestroyEvent(startEvent), "destroy_start_event");
    FreeBuffers(buffers);
    return eventsFreed;
}

std::vector<ShapeCase> CorrectnessCases()
{
    return {{1, 1}, {3, 7}, {4, 8}, {8, 15}, {8, 16},
            {16, 127}, {16, 128}, {16, 129}, {16, 255}, {16, 256}, {16, 257},
            {8, 4095}, {8, 4096}, {8, 4097}, {4, 8191}, {4, 8192}, {4, 8193},
            {2, 16383}, {2, 16384}, {2, 16385}, {1, 32768}, {1, 32769}};
}

bool ParseUnsigned(const char* text, uint32_t& value, bool allowZero = false)
{
    char* end = nullptr;
    const unsigned long parsed = std::strtoul(text, &end, 10);
    if (end == text || *end != '\0' || (!allowZero && parsed == 0) ||
        parsed > UINT32_MAX) return false;
    value = static_cast<uint32_t>(parsed);
    return true;
}

}  // namespace

int main(int argc, char** argv)
{
    std::string suite;
    std::string dtypeName;
    std::string caseSet = "all";
    uint32_t deviceId = 7, rows = 128, width = 16384, warmup = 20, samples = 8;
    uint32_t correctnessRepeats = 1;
    uint32_t launchCoreCount = 0;
    for (int i = 1; i < argc; ++i) {
        if (i + 1 >= argc) {
            std::fprintf(stderr, "missing value for option %s\n", argv[i]);
            return 2;
        }
        const char* option = argv[i++];
        const char* value = argv[i];
        if (std::strcmp(option, "--suite") == 0) suite = value;
        else if (std::strcmp(option, "--dtype") == 0) dtypeName = value;
        else if (std::strcmp(option, "--case-set") == 0) caseSet = value;
        else if (std::strcmp(option, "--device") == 0) {
            if (!ParseUnsigned(value, deviceId, true)) return 2;
        } else if (std::strcmp(option, "--rows") == 0) {
            if (!ParseUnsigned(value, rows)) return 2;
        } else if (std::strcmp(option, "--width") == 0) {
            if (!ParseUnsigned(value, width)) return 2;
        } else if (std::strcmp(option, "--warmup") == 0) {
            if (!ParseUnsigned(value, warmup)) return 2;
        } else if (std::strcmp(option, "--samples") == 0) {
            if (!ParseUnsigned(value, samples)) return 2;
        } else if (std::strcmp(option, "--launch-cores") == 0) {
            if (!ParseUnsigned(value, launchCoreCount)) return 2;
        } else if (std::strcmp(option, "--repeat") == 0) {
            if (!ParseUnsigned(value, correctnessRepeats)) return 2;
        } else {
            std::fprintf(stderr, "unknown option %s\n", option);
            return 2;
        }
    }
    if (suite != "correctness" && suite != "benchmark") {
        std::fprintf(stderr, "--suite must be correctness or benchmark\n");
        return 2;
    }
    if (caseSet != "all" && caseSet != "wide-fp32") {
        std::fprintf(stderr, "--case-set must be all or wide-fp32\n");
        return 2;
    }
    DType selected = DType::Fp16;
    if (suite == "benchmark") {
        if (dtypeName == "fp32") selected = DType::Fp32;
        else if (dtypeName == "fp16") selected = DType::Fp16;
        else if (dtypeName == "bf16") selected = DType::Bf16;
        else {
            std::fprintf(stderr, "benchmark requires --dtype fp32|fp16|bf16\n");
            return 2;
        }
    }
    if (!CheckAcl(aclInit(nullptr), "aclInit") ||
        !CheckAcl(aclrtSetDevice(static_cast<int32_t>(deviceId)), "aclrtSetDevice")) return 1;
    int64_t coreCount = 0;
    if (!CheckAcl(aclrtGetDeviceInfo(static_cast<int32_t>(deviceId),
                                     ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount),
                  "get_vector_core_count")) return 1;
    if (launchCoreCount == 0) {
        launchCoreCount = static_cast<uint32_t>(coreCount);
    }
    aclrtStream stream = nullptr;
    if (!CheckAcl(aclrtCreateStream(&stream), "create_stream")) return 1;
    std::printf("RUN_META device=%u vector_cores=%lld launch_cores=%u suite=%s epsilon=%.9g\n",
                deviceId, static_cast<long long>(coreCount), launchCoreCount,
                suite.c_str(), kEpsilon);
    std::printf("RUNNER_SOURCE_SHA256=%s\n", kKernelSourceSha256);

    bool pass = true;
    if (suite == "correctness") {
        uint32_t caseCount = 0;
        std::vector<ShapeCase> shapes = CorrectnessCases();
        std::vector<DType> dtypes = {DType::Fp32, DType::Fp16, DType::Bf16};
        if (caseSet == "wide-fp32") {
            shapes = {{4, 8193}, {2, 16383}, {2, 16384}, {2, 16385},
                      {1, 32768}, {1, 32769}};
            dtypes = {DType::Fp32};
        }
        for (uint32_t repeat = 0; repeat < correctnessRepeats; ++repeat) {
            std::printf("CORRECTNESS_REPEAT index=%u of=%u case_set=%s\n",
                        repeat + 1, correctnessRepeats, caseSet.c_str());
            for (const ShapeCase& shape : shapes) {
                for (DType dtype : dtypes) {
                    pass = RunCorrectnessCase(shape, dtype, coreCount, stream,
                                              launchCoreCount) && pass;
                    ++caseCount;
                }
            }
        }
        std::printf("SUMMARY suite=correctness cases=%u status=%s\n", caseCount,
                    pass ? "PASS" : "FAIL");
    } else {
        pass = RunBenchmark({rows, width}, selected, coreCount, stream,
                            warmup, samples, launchCoreCount);
        std::printf("SUMMARY suite=benchmark dtype=%s rows=%u width=%u samples=%u status=%s\n",
                    DTypeName(selected), rows, width, samples, pass ? "PASS" : "FAIL");
    }
    const bool streamDestroyed = CheckAcl(aclrtDestroyStream(stream), "destroy_stream");
    const bool deviceReset = CheckAcl(aclrtResetDevice(static_cast<int32_t>(deviceId)),
                                      "reset_device");
    const bool finalized = CheckAcl(aclFinalize(), "aclFinalize");
    return pass && streamDestroyed && deviceReset && finalized ? 0 : 1;
}
