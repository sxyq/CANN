#include <acl/acl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "kernel.asc"

struct DeviceBuffer {
    void* ptr = nullptr;
    ~DeviceBuffer() { if (ptr != nullptr) (void)aclrtFree(ptr); }
    bool Allocate(size_t bytes)
    {
        return aclrtMalloc(&ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    }
};

struct Runtime {
    bool initialized = false;
    bool deviceSet = false;
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    ~Runtime()
    {
        if (stream != nullptr) (void)aclrtDestroyStream(stream);
        if (deviceSet) (void)aclrtResetDevice(deviceId);
        if (initialized) (void)aclFinalize();
    }
};

#define ACL_REQUIRE(call) do { \
    const aclError status = (call); \
    if (status != ACL_SUCCESS) { \
        fprintf(stderr, "%s failed: %d\n", #call, static_cast<int>(status)); \
        return 1; \
    } \
} while (0)

static bool Upload(const void* host, size_t bytes, DeviceBuffer& device)
{
    return device.Allocate(bytes) &&
        aclrtMemcpy(device.ptr, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
}

int main(int argc, char** argv)
{
    if (argc != 5 && argc != 6) {
        fprintf(stderr, "usage: %s rows width dtype(0=float32,1=float16) device [available_cores]\n", argv[0]);
        return 2;
    }
    const uint64_t rows = strtoull(argv[1], nullptr, 10);
    const uint64_t width = strtoull(argv[2], nullptr, 10);
    const int32_t dtype = atoi(argv[3]);
    const int32_t deviceId = atoi(argv[4]);
    const int64_t requestedCores = argc == 6 ? strtoll(argv[5], nullptr, 10) : 0;
    if (rows == 0 || width == 0 || (dtype != 0 && dtype != 1) || deviceId < 0 ||
        rows > SIZE_MAX / width || requestedCores < 0) {
        fprintf(stderr, "invalid rows, width, dtype, or device\n");
        return 2;
    }

    Runtime runtime;
    runtime.deviceId = deviceId;
    ACL_REQUIRE(aclInit(nullptr));
    runtime.initialized = true;
    ACL_REQUIRE(aclrtSetDevice(deviceId));
    runtime.deviceSet = true;
    int64_t coreCount = 0;
    ACL_REQUIRE(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount));
    if (requestedCores > 0 && requestedCores < coreCount) coreCount = requestedCores;
    ACL_REQUIRE(aclrtCreateStream(&runtime.stream));

    const size_t elementBytes = dtype == 0 ? sizeof(float) : sizeof(uint16_t);
    const size_t rowElements = static_cast<size_t>(rows * width);
    const size_t tensorBytes = rowElements * elementBytes;
    const size_t parameterBytes = static_cast<size_t>(width) * elementBytes;
    uint8_t* x = static_cast<uint8_t*>(calloc(tensorBytes, 1));
    uint8_t* residual = static_cast<uint8_t*>(calloc(tensorBytes, 1));
    uint8_t* gamma = static_cast<uint8_t*>(calloc(parameterBytes, 1));
    uint8_t* bias = static_cast<uint8_t*>(calloc(parameterBytes, 1));
    uint8_t* output = static_cast<uint8_t*>(malloc(tensorBytes));
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        fprintf(stderr, "host allocation failed\n");
        free(x); free(residual); free(gamma); free(bias); free(output);
        return 1;
    }
    memset(output, 0xA5, tensorBytes);
    if (dtype == 0) {
        float* values = reinterpret_cast<float*>(gamma);
        for (size_t i = 0; i < static_cast<size_t>(width); ++i) values[i] = 1.0f;
    } else {
        for (size_t i = 0; i < parameterBytes; i += 2) {
            gamma[i] = 0x00;
            gamma[i + 1] = 0x3c;
        }
    }

    DeviceBuffer xDevice, residualDevice, gammaDevice, biasDevice, outputDevice;
    if (!Upload(x, tensorBytes, xDevice) || !Upload(residual, tensorBytes, residualDevice) ||
        !Upload(gamma, parameterBytes, gammaDevice) || !Upload(bias, parameterBytes, biasDevice) ||
        !outputDevice.Allocate(tensorBytes)) {
        fprintf(stderr, "device allocation or input transfer failed\n");
        free(x); free(residual); free(gamma); free(bias); free(output);
        return 1;
    }

    const int64_t inputShape[] = {static_cast<int64_t>(rows), static_cast<int64_t>(width)};
    const int64_t parameterShape[] = {static_cast<int64_t>(width)};
    TensorInfo xTensor = {inputShape, 2, dtype};
    TensorInfo residualTensor = {inputShape, 2, dtype};
    TensorInfo gammaTensor = {parameterShape, 1, dtype};
    TensorInfo biasTensor = {parameterShape, 1, dtype};
    TensorInfo outputTensor = {inputShape, 2, dtype};
    TensorGroupInfo xInfo = {&xTensor, 1};
    TensorGroupInfo residualInfo = {&residualTensor, 1};
    TensorGroupInfo gammaInfo = {&gammaTensor, 1};
    TensorGroupInfo biasInfo = {&biasTensor, 1};
    TensorGroupInfo outputInfo = {&outputTensor, 1};

    run_kernel((GM_ADDR)xDevice.ptr, xInfo,
               (GM_ADDR)residualDevice.ptr, residualInfo,
               (GM_ADDR)gammaDevice.ptr, gammaInfo,
               (GM_ADDR)biasDevice.ptr, biasInfo,
               (GM_ADDR)outputDevice.ptr, outputInfo,
               coreCount, runtime.stream, 1.0e-5f);
    ACL_REQUIRE(aclrtSynchronizeStream(runtime.stream));
    ACL_REQUIRE(aclrtMemcpy(output, tensorBytes, outputDevice.ptr, tensorBytes,
                            ACL_MEMCPY_DEVICE_TO_HOST));
    bool allZero = true;
    for (size_t i = 0; i < tensorBytes; ++i) allZero = allZero && output[i] == 0;
    if (!allZero) {
        fprintf(stderr, "zero-input output validation failed\n");
        free(x); free(residual); free(gamma); free(bias); free(output);
        return 3;
    }
    printf("PARENT_RUN_OK rows=%llu width=%llu dtype=%s device=%d vector_cores=%lld bytes=%zu\n",
                static_cast<unsigned long long>(rows), static_cast<unsigned long long>(width),
                dtype == 0 ? "fp32" : "fp16", deviceId, static_cast<long long>(coreCount), tensorBytes);
    free(x); free(residual); free(gamma); free(bias); free(output);
    return 0;
}
