+// W4-R10 V001: Host mirror of AddRmsNormBiasKernel::ChooseWideFullYRows().
+// It reproduces the resident complete-y row count the wide full-y path picks
+// inside the kernel, so the launch width can be capped by how many rows one
+// active core can actually hold.  Host-side only; kernel code unchanged.
+static uint64_t HostWideFullYRows(uint64_t rowWidth, uint32_t yTypeBytes,
+                                 uint32_t ioTiles, uint32_t ioTypeBytes,
+                                 uint32_t workTiles)
+{
+    const uint64_t tileElems = 4096;
+    const uint64_t reduceStride = 16;
+    const uint64_t budgetBytes = 176 * 1024;
+    const uint64_t yBytesPerRow = rowWidth * static_cast<uint64_t>(yTypeBytes);
+    const uint64_t ioBytes = static_cast<uint64_t>(ioTiles) * tileElems *
+                             static_cast<uint64_t>(ioTypeBytes);
+    const uint64_t workBytes = static_cast<uint64_t>(workTiles) * tileElems *
+                               static_cast<uint64_t>(sizeof(float));
+    for (uint64_t rows = 8; rows > 1; --rows) {
+        const uint64_t reduceBytes = rows * reduceStride * sizeof(float);
+        if (yBytesPerRow * rows + ioBytes + workBytes + reduceBytes <= budgetBytes) {
+            return rows;
+        }
+    }
+    return 1;
+}
