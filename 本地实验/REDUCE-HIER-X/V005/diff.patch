+
+    // N3: whole-reduce sum with vector-side output (vcadd mode=0) instead of
+    // AscendC::ReduceSum's acc-register route (vcadd mode=1 + V/S drain +
+    // get_acc_val + S/V + S_MTE3 per call).  WholeReduceSum emits one sum per
+    // natural repeat (64 FP32), so spans wider than one repeat are reduced in
+    // two vector-only steps through the caller-supplied work area: first one
+    // sum per 64-element group, then one sum over those partials.  No scalar
+    // handoff and no pipe drain anywhere in the chain.  Mask is set in normal
+    // bit-mask mode (<= 64 elements) following the production rms_norm
+    // WholeReduceSum pattern on dav-2201.
+    __aicore__ inline void VectorWholeReduceSum(AscendC::LocalTensor<float> dst,
+                                                AscendC::LocalTensor<float> src,
+                                                AscendC::LocalTensor<float> work,
+                                                int32_t count)
+    {
+        constexpr int32_t kRepElems = 64;
+        if (count <= kRepElems) {
+            AscendC::AscendCUtils::SetMask<float>(count);
+            AscendC::WholeReduceSum<float, false>(dst, src, AscendC::MASK_PLACEHOLDER,
+                                                  1, 0, 1, 0);
+            return;
+        }
+        const int32_t full = count / kRepElems;
+        const int32_t tail = count - full * kRepElems;
+        AscendC::AscendCUtils::SetMask<float>(kRepElems);
+        AscendC::WholeReduceSum<float, false>(work, src, AscendC::MASK_PLACEHOLDER,
+                                              full, 1, 1, 8);
+        int32_t partials = full;
+        if (tail > 0) {
+            AscendC::AscendCUtils::SetMask<float>(tail);
+            AscendC::WholeReduceSum<float, false>(work[full], src[full * kRepElems],
+                                                  AscendC::MASK_PLACEHOLDER, 1, 0, 1, 0);
+            partials = full + 1;
+        }
+        AscendC::AscendCUtils::SetMask<float>(partials);
+        AscendC::WholeReduceSum<float, false>(dst, work, AscendC::MASK_PLACEHOLDER,
+                                              1, 0, 1, 0);
     }
 
