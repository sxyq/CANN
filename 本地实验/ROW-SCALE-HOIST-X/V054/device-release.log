total" free_hbm=$((hbm_total - hbm_used)) printf 'DEVICE_0_HBM_USED_MB=%s\nDEVICE_0_HBM_TOTAL_MB=%s\nDEVICE_0_FREE_HBM_MB=%s\n' "$hbm_used" "$hbm_total" "$free_hbm" | tee -a "$v054_snapshot" test "$free_hbm" -ge 100 {   printf 'REVISION=V054\nDEVICE=0\nSHAPE=128x256 FP32\n'   printf 'PARENT_SOURCE_SHA256=7c2569d9e3830c845f2b5dc4587a73a05a0bdf041168614cd55ad84204e063f9\nCANDIDATE_SOURCE_SHA256=58844eee194a62ae7b0f051484ba9e7b0c069ce1cac1fdc6c63b67d9452530c0\n'   printf 'PARENT_EXECUTABLE=%s/v054_correctness_parent\nPARENT_EXECUTABLE_SHA256=%s\n' "$runner_build_dir" "$(sha256sum "$runner_build_dir/v054_correctness_parent" | cut -d' ' -f1)"   printf 'CANDIDATE_EXECUTABLE=%s/v054_correctness_candidate\nCANDIDATE_EXECUTABLE_SHA256=%s\n' "$runner_build_dir" "$(sha256sum "$runner_build_dir/v054_correctness_candidate" | cut -d' ' -f1)"   printf 'CORRECTNESS_START_UTC=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" } > "$v054_root/correctness-invocation.txt" set +e "$runner_build_dir/v054_correctness_parent" > "$v054_root/correctness-parent.log" 2>&1 parent_exit=$? printf 'PARENT_EXIT=%s\n' "$parent_exit" >> "$v054_root/correctness-invocation.txt" "$runner_build_dir/v054_correctness_candidate" > "$v054_root/correctness-candidate.log" 2>&1 candidate_exit=$? printf 'CANDIDATE_EXIT=%s\n' "$candidate_exit" >> "$v054_root/correctness-invocation.txt" set -e printf 'CORRECTNESS_END_UTC=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$v054_root/correctness-invocation.txt" cat "$v054_root/correctness-parent.log" cat "$v054_root/correctness-candidate.log" if [ "$parent_exit" -ne 0 ] || [ "$candidate_exit" -ne 0 ] || ! rg -q '"status":"PASS"' "$v054_root/correctness-parent.log" || ! rg -q '"status":"PASS"' "$v054_root/correctness-candidate.log"; then   printf 'CORRECTNESS_GATE=FAIL_OR_UNRESOLVED\n' >> "$v054_root/correctness-invocation.txt"   {     date -u '+POST_CORRECTNESS_RELEASE_SNAPSHOT_UTC=%Y-%m-%dT%H:%M:%SZ'     npu-smi info     npu-smi info -t usages -i 0     ps -eo pid,user,comm,args | rg -i 'v054|row.scale.hoist|cann-row-scale' || true     printf 'DEVICE_0_RELEASED_AFTER_CORRECTNESS_CAPTURE=true\n'   } 2>&1 | tee "$v054_root/device-release.log"   exit 2 fi printf 'CORRECTNESS_GATE=PASS\n' >> "$v054_root/correctness-invocation.txt" local_invocation="$v054_root/local-invocation.txt" printf 'REVISION=V054\nDEVICE=0\nLOCAL_METHOD=parent stability 32 samples; four interleaved P/C blocks, 32 samples per arm per block; 20 warmups per process; ACL device events\nLOCAL_START_UTC=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$local_invocation" run_v054_local() {   label="$1"   binary="$2"   logfile="$3"   printf 'RUN_LABEL=%s\nRUN_LOG=%s\nRUN_START_UTC=%s\n' "$label" "$logfile" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$local_invocation"   set +e   "$binary" > "$logfile" 2>&1   run_status=$?   set -e   printf 'RUN_EXIT=%s\nRUN_END_UTC=%s\n' "$run_status" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$local_invocation"   cat "$logfile"   test "$run_status" -eq 0   rg -q 'RUNNER_RESULT=' "$logfile" } run_v054_local PARENT_STABILITY "$runner_build_dir/v054_local_parent" "$v054_root/local-parent-stability.log" for block in 1 2 3 4; do   run_v054_local "PARENT_BLOCK${block}" "$runner_build_dir/v054_local_parent" "$v054_root/local-parent-block${block}.log"   run_v054_local "CANDIDATE_BLOCK${block}" "$runner_build_dir/v054_local_candidate" "$v054_root/local-candidate-block${block}.log" done printf 'LOCAL_END_UTC=%s\nLOCAL_RUN_FAILURES=0\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$local_invocation" {   date -u '+POST_CAPTURE_SNAPSHOT_UTC=%Y-%m-%dT%H:%M:%SZ'   npu-smi info   npu-smi info -t usages -i 0   uptime   ps -eo pid,user,comm,args | rg -i 'v054|row.scale.hoist|cann-row-scale' || true   printf 'DEVICE_0_RELEASED_AFTER_NUMERIC_RAW_CAPTURE=true\n' } 2>&1 | tee "$v054_root/device-release.log"
