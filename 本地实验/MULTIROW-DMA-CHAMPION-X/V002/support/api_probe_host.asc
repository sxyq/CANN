#include <acl/acl.h>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

#define API_PROBE_KERNEL "api_probe_kernel.asc"
#include API_PROBE_KERNEL

int main(int argc, char **argv)
{
    if (argc < 2) {
        std::fprintf(stderr, "usage: %s device_id\n", argv[0]);
        return 2;
    }
    const int deviceId = std::atoi(argv[1]);
    const size_t kBufBytes = 8192;
    aclrtStream stream = nullptr;
    if (aclInit(nullptr) != ACL_SUCCESS) return 10;
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) return 11;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) return 12;

    std::vector<uint8_t> hostSrc(kBufBytes), hostDst(kBufBytes);
    for (size_t i = 0; i < kBufBytes; ++i) {
        hostSrc[i] = static_cast<uint8_t>((i * 7u + 13u) & 0xFFu);
    }
    void *devSrc = nullptr, *devDst = nullptr;
    if (aclrtMalloc(&devSrc, kBufBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 13;
    if (aclrtMalloc(&devDst, kBufBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 14;
    if (aclrtMemcpy(devSrc, kBufBytes, hostSrc.data(), kBufBytes, ACL_MEMCPY_HOST_TO_DEVICE)
        != ACL_SUCCESS) return 15;

    // blockLenField values cover both unit hypotheses:
    //   32B units -> bytes = field*32 ;  byte units -> bytes = field
    const uint32_t fields[] = {4, 8, 32, 64, 256};
    std::printf("field\tbytes_if_32B_units\tbytes_if_byte_units\tcopied_prefix_bytes\ttail_mismatch\n");
    for (uint32_t field : fields) {
        if (aclrtMemset(devDst, kBufBytes, 0, kBufBytes) != ACL_SUCCESS) return 16;
        run_api_probe<<<1, nullptr, stream>>>((GM_ADDR)devDst, (GM_ADDR)devSrc, field);
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
            std::printf("%u\t%zu\t%u\tSYNC_FAIL\t-\n", field,
                        static_cast<size_t>(field) * 32u, field);
            continue;
        }
        std::memset(hostDst.data(), 0, kBufBytes);
        if (aclrtMemcpy(hostDst.data(), kBufBytes, devDst, kBufBytes, ACL_MEMCPY_DEVICE_TO_HOST)
            != ACL_SUCCESS) return 17;
        size_t prefix = 0;
        while (prefix < kBufBytes && hostDst[prefix] == hostSrc[prefix]) ++prefix;
        size_t mismatch = 0;
        for (size_t i = prefix; i < kBufBytes; ++i) {
            if (hostDst[i] != 0) ++mismatch;
        }
        std::printf("%u\t%zu\t%u\t%zu\t%zu\n", field,
                    static_cast<size_t>(field) * 32u, field, prefix, mismatch);
    }

    aclrtFree(devSrc);
    aclrtFree(devDst);
    aclrtDestroyStream(stream);
    aclFinalize();
    return 0;
}
