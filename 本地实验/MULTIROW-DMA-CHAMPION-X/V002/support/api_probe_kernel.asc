#include <cstdint>
#include "kernel_operator.h"

// V002 API probe: GM -> UB -> GM with DataCopyParams, to determine
// whether blockLen is in 32-byte units or in bytes.
class ApiProbeKernel {
public:
    __aicore__ void Init(GM_ADDR dst, GM_ADDR src)
    {
        dstGm_.SetGlobalBuffer((__gm__ uint8_t *)dst);
        srcGm_.SetGlobalBuffer((__gm__ uint8_t *)src);
        pipe_.InitBuffer(ub_, 8192);
    }

    __aicore__ void Process(uint32_t blockLenField)
    {
        AscendC::LocalTensor<uint8_t> ub = ub_.Get<uint8_t>();
        const AscendC::DataCopyParams inParams(
            1, static_cast<uint16_t>(blockLenField), 0, 0);
        AscendC::DataCopy(ub, srcGm_, inParams);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
        const AscendC::DataCopyParams outParams(
            1, static_cast<uint16_t>(blockLenField), 0, 0);
        AscendC::DataCopy(dstGm_, ub, outParams);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> ub_;
    AscendC::GlobalTensor<uint8_t> dstGm_;
    AscendC::GlobalTensor<uint8_t> srcGm_;
};

extern "C" __global__ __vector__ void run_api_probe(GM_ADDR dst, GM_ADDR src,
                                                   uint32_t blockLenField)
{
    ApiProbeKernel k;
    k.Init(dst, src);
    k.Process(blockLenField);
}
