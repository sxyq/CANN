#include <acl/acl.h>

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <vector>

struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};

struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};

#include "../submission.asc"

namespace {

constexpr int kFp16 = 1;
constexpr int kDeviceId = 4;
constexpr int64_t kRows = 2;
constexpr float kEpsilon = 1.0e-5f;
constexpr float kAtol = 0.001953125f;
constexpr float kRtol = 0.001953125f;
constexpr float kMaxAbsError = 0.1f;

struct DeviceBuffer {
    void* data = nullptr;

    ~DeviceBuffer()
    {
        if (data != nullptr) {
            aclrtFree(data);
        }
    }

    bool Allocate(size_t bytes, const char* name)
    {
        const aclError status = aclrtMalloc(&data, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        if (status != ACL_SUCCESS) {
            std::fprintf(stderr, "ACL_FAIL aclrtMalloc(%s)=%d\n", name, static_cast<int>(status));
            return false;
        }
        return true;
    }
};

struct StreamGuard {
    aclrtStream stream = nullptr;

    ~StreamGuard()
    {
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
    }

    bool Create()
    {
        const aclError status = aclrtCreateStream(&stream);
        if (status != ACL_SUCCESS) {
            std::fprintf(stderr, "ACL_FAIL aclrtCreateStream=%d\n", static_cast<int>(status));
            return false;
        }
        return true;
    }
};

bool CheckAcl(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL_FAIL %s=%d\n", operation, static_cast<int>(status));
    return false;
}

float InputValue(int64_t index, int multiplier, int offset)
{
    return static_cast<float>((index * multiplier + offset) % 997) / 498.0f - 1.0f;
}

uint16_t ToHalfBits(float value)
{
    const aclFloat16 halfValue = aclFloatToFloat16(value);
    uint16_t bits = 0;
    std::memcpy(&bits, &halfValue, sizeof(bits));
    return bits;
}

float FromHalfBits(uint16_t bits)
{
    aclFloat16 halfValue;
    std::memcpy(&halfValue, &bits, sizeof(bits));
    return aclFloat16ToFloat(halfValue);
}

bool RunCase(int64_t width, const char* name)
{
    const size_t elements = static_cast<size_t>(kRows * width);
    const size_t dataBytes = elements * sizeof(uint16_t);
    const size_t parameterBytes = static_cast<size_t>(width) * sizeof(uint16_t);
    std::vector<uint16_t> xHost(elements), residualHost(elements);
    std::vector<uint16_t> gammaHost(static_cast<size_t>(width));
    std::vector<uint16_t> biasHost(static_cast<size_t>(width));
    std::vector<uint16_t> outputHost(elements, 0);
    std::vector<float> xFp32(elements), residualFp32(elements);
    std::vector<float> gammaFp32(static_cast<size_t>(width));
    std::vector<float> biasFp32(static_cast<size_t>(width));
    std::vector<float> expected(elements);

    for (size_t i = 0; i < elements; ++i) {
        xHost[i] = ToHalfBits(InputValue(static_cast<int64_t>(i), 3, 1));
        residualHost[i] = ToHalfBits(InputValue(static_cast<int64_t>(i), 5, 7));
        xFp32[i] = FromHalfBits(xHost[i]);
        residualFp32[i] = FromHalfBits(residualHost[i]);
    }
    for (int64_t col = 0; col < width; ++col) {
        const size_t i = static_cast<size_t>(col);
        gammaHost[i] = ToHalfBits(InputValue(col, 11, 3) * 0.1f + 1.0f);
        biasHost[i] = ToHalfBits(InputValue(col, 13, 5) * 0.05f);
        gammaFp32[i] = FromHalfBits(gammaHost[i]);
        biasFp32[i] = FromHalfBits(biasHost[i]);
    }

    for (int64_t row = 0; row < kRows; ++row) {
        float squareSum = 0.0f;
        for (int64_t col = 0; col < width; ++col) {
            const size_t index = static_cast<size_t>(row * width + col);
            const float y = FromHalfBits(ToHalfBits(xFp32[index] + residualFp32[index]));
            squareSum += y * y;
        }
        const float invRms = 1.0f / std::sqrt(squareSum / static_cast<float>(width) + kEpsilon);
        for (int64_t col = 0; col < width; ++col) {
            const size_t index = static_cast<size_t>(row * width + col);
            const float y = FromHalfBits(ToHalfBits(xFp32[index] + residualFp32[index]));
            const float scaled = FromHalfBits(ToHalfBits(y * invRms));
            const float affine = FromHalfBits(ToHalfBits(scaled * gammaFp32[static_cast<size_t>(col)]));
            expected[index] = FromHalfBits(ToHalfBits(affine + biasFp32[static_cast<size_t>(col)]));
        }
    }

    StreamGuard stream;
    DeviceBuffer xDevice, residualDevice, gammaDevice, biasDevice, outputDevice;
    if (!stream.Create() ||
        !xDevice.Allocate(dataBytes, "x") ||
        !residualDevice.Allocate(dataBytes, "residual") ||
        !gammaDevice.Allocate(parameterBytes, "gamma") ||
        !biasDevice.Allocate(parameterBytes, "bias") ||
        !outputDevice.Allocate(dataBytes, "output")) {
        return false;
    }
    if (!CheckAcl(aclrtMemcpy(xDevice.data, dataBytes, xHost.data(), dataBytes,
                              ACL_MEMCPY_HOST_TO_DEVICE), "copy x") ||
        !CheckAcl(aclrtMemcpy(residualDevice.data, dataBytes, residualHost.data(), dataBytes,
                              ACL_MEMCPY_HOST_TO_DEVICE), "copy residual") ||
        !CheckAcl(aclrtMemcpy(gammaDevice.data, parameterBytes, gammaHost.data(), parameterBytes,
                              ACL_MEMCPY_HOST_TO_DEVICE), "copy gamma") ||
        !CheckAcl(aclrtMemcpy(biasDevice.data, parameterBytes, biasHost.data(), parameterBytes,
                              ACL_MEMCPY_HOST_TO_DEVICE), "copy bias")) {
        return false;
    }

    int64_t dataShape[] = {kRows, width};
    int64_t parameterShape[] = {width};
    TensorInfo xTensor{dataShape, 2, kFp16};
    TensorInfo residualTensor{dataShape, 2, kFp16};
    TensorInfo gammaTensor{parameterShape, 1, kFp16};
    TensorInfo biasTensor{parameterShape, 1, kFp16};
    TensorInfo outputTensor{dataShape, 2, kFp16};
    TensorGroupInfo xInfo{&xTensor, 1};
    TensorGroupInfo residualInfo{&residualTensor, 1};
    TensorGroupInfo gammaInfo{&gammaTensor, 1};
    TensorGroupInfo biasInfo{&biasTensor, 1};
    TensorGroupInfo outputInfo{&outputTensor, 1};

    run_kernel((GM_ADDR)xDevice.data, xInfo,
               (GM_ADDR)residualDevice.data, residualInfo,
               (GM_ADDR)gammaDevice.data, gammaInfo,
               (GM_ADDR)biasDevice.data, biasInfo,
               (GM_ADDR)outputDevice.data, outputInfo,
               1, stream.stream, kEpsilon);
    if (!CheckAcl(aclrtSynchronizeStream(stream.stream), "synchronize kernel") ||
        !CheckAcl(aclrtMemcpy(outputHost.data(), dataBytes, outputDevice.data, dataBytes,
                              ACL_MEMCPY_DEVICE_TO_HOST), "copy output")) {
        return false;
    }

    size_t matched = 0;
    float maxAbs = 0.0f;
    for (size_t i = 0; i < elements; ++i) {
        const float actual = FromHalfBits(outputHost[i]);
        const float error = std::fabs(actual - expected[i]);
        maxAbs = std::max(maxAbs, error);
        if (error <= kAtol + kRtol * std::fabs(expected[i])) {
            ++matched;
        }
    }
    const double matchedRatio = static_cast<double>(matched) / static_cast<double>(elements);
    const bool pass = matchedRatio >= 0.99 && maxAbs <= kMaxAbsError;
    std::printf("CASE name=%s device=%d rows=%lld D=%lld dtype=FP16 requested_blocks=1 matched_ratio=%.8f max_abs=%.8g correctness=%s\n",
                name, kDeviceId, static_cast<long long>(kRows), static_cast<long long>(width),
                matchedRatio, maxAbs, pass ? "PASS" : "FAIL");
    return pass;
}

}  // namespace

int main()
{
    if (!CheckAcl(aclInit(nullptr), "aclInit")) {
        return 2;
    }
    bool pass = false;
    if (CheckAcl(aclrtSetDevice(kDeviceId), "aclrtSetDevice")) {
        const bool primary = RunCase(12288, "h2_primary_wide_path");
        const bool control = RunCase(8192, "h2_unmodified_path_control");
        pass = primary && control;
    }
    if (!CheckAcl(aclFinalize(), "aclFinalize")) {
        pass = false;
    }
    std::printf("SUMMARY device=%d cases=2 failures=%d correctness=%s timing=NOT_RUN\n",
                kDeviceId, pass ? 0 : 1, pass ? "ALL_PASS" : "HAS_FAIL");
    return pass ? 0 : 1;
}
