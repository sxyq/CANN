#include <vector>

static std::string g_caseContext;
static aclError g_lastSyncStatus = ACL_SUCCESS;
static std::string g_lastRuntimeMessage;

static aclError ExtDiagnosticSynchronizeStream(aclrtStream stream)
{
    g_lastSyncStatus = aclrtSynchronizeStream(stream);
    const char *message = aclGetRecentErrMsg();
    g_lastRuntimeMessage = message == nullptr ? "<null>" : message;
    std::cout << "SYNC_CASE=" << g_caseContext << " ACLRT_SYNC_STATUS=" << g_lastSyncStatus
              << " ACL_RECENT_ERROR=" << g_lastRuntimeMessage << std::endl;
    return g_lastSyncStatus;
}

#define aclrtSynchronizeStream(stream) ExtDiagnosticSynchronizeStream(stream)
#include "submission.asc"
#undef aclrtSynchronizeStream

namespace {

uint16_t FloatToHalf(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const uint32_t sign = (bits >> 16U) & 0x8000U;
    int32_t exponent = static_cast<int32_t>((bits >> 23U) & 0xffU) - 127 + 15;
    uint32_t mantissa = bits & 0x7fffffU;
    if (exponent <= 0) {
        if (exponent < -10) {
            return static_cast<uint16_t>(sign);
        }
        mantissa = (mantissa | 0x800000U) >> static_cast<uint32_t>(1 - exponent);
        return static_cast<uint16_t>(sign | ((mantissa + 0x1000U) >> 13U));
    }
    if (exponent >= 31) {
        return static_cast<uint16_t>(sign | 0x7c00U);
    }
    mantissa += 0x1000U;
    if ((mantissa & 0x800000U) != 0U) {
        mantissa = 0;
        ++exponent;
        if (exponent >= 31) {
            return static_cast<uint16_t>(sign | 0x7c00U);
        }
    }
    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(exponent) << 10U) | (mantissa >> 13U));
}

float HalfToFloat(uint16_t value)
{
    const uint32_t sign = static_cast<uint32_t>(value & 0x8000U) << 16U;
    uint32_t exponent = (value >> 10U) & 0x1fU;
    uint32_t mantissa = value & 0x03ffU;
    uint32_t bits = 0;
    if (exponent == 0U) {
        if (mantissa == 0U) {
            bits = sign;
        } else {
            int32_t adjusted = -14;
            while ((mantissa & 0x0400U) == 0U) {
                mantissa <<= 1U;
                --adjusted;
            }
            mantissa &= 0x03ffU;
            bits = sign | (static_cast<uint32_t>(adjusted + 127) << 23U) | (mantissa << 13U);
        }
    } else if (exponent == 31U) {
        bits = sign | 0x7f800000U | (mantissa << 13U);
    } else {
        bits = sign | ((exponent + 112U) << 23U) | (mantissa << 13U);
    }
    float result = 0.0F;
    std::memcpy(&result, &bits, sizeof(result));
    return result;
}

uint16_t FloatToBfloat16(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    bits += 0x7fffU + ((bits >> 16U) & 1U);
    return static_cast<uint16_t>(bits >> 16U);
}

float Bfloat16ToFloat(uint16_t value)
{
    const uint32_t bits = static_cast<uint32_t>(value) << 16U;
    float result = 0.0F;
    std::memcpy(&result, &bits, sizeof(result));
    return result;
}

struct HostBuffer {
    GM_ADDR device = nullptr;
    size_t bytes = 0;
};

bool AllocateAndCopy(const std::vector<uint8_t> &host, HostBuffer &buffer)
{
    buffer.bytes = host.size();
    if (aclrtMalloc(reinterpret_cast<void **>(&buffer.device), buffer.bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return false;
    }
    return aclrtMemcpy(buffer.device, buffer.bytes, host.data(), host.size(), ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
}

void Release(HostBuffer &buffer)
{
    if (buffer.device != nullptr) {
        aclrtFree(buffer.device);
        buffer.device = nullptr;
    }
}

std::vector<uint8_t> Encode(const std::vector<float> &values, int32_t dtype)
{
    const size_t elementBytes = dtype == 0 ? sizeof(float) : sizeof(uint16_t);
    std::vector<uint8_t> bytes(values.size() * elementBytes);
    for (size_t i = 0; i < values.size(); ++i) {
        if (dtype == 0) {
            std::memcpy(bytes.data() + i * elementBytes, &values[i], sizeof(float));
        } else {
            const uint16_t encoded = dtype == 1 ? FloatToHalf(values[i]) : FloatToBfloat16(values[i]);
            std::memcpy(bytes.data() + i * elementBytes, &encoded, sizeof(encoded));
        }
    }
    return bytes;
}

float Decode(const uint8_t *bytes, size_t index, int32_t dtype)
{
    if (dtype == 0) {
        float value = 0.0F;
        std::memcpy(&value, bytes + index * sizeof(float), sizeof(value));
        return value;
    }
    uint16_t encoded = 0;
    std::memcpy(&encoded, bytes + index * sizeof(encoded), sizeof(encoded));
    return dtype == 1 ? HalfToFloat(encoded) : Bfloat16ToFloat(encoded);
}

bool RunCase(const std::string &name, const std::vector<int64_t> &shape, int32_t dtype, uint32_t cores,
             aclrtStream stream)
{
    const uint32_t dim = static_cast<uint32_t>(shape.back());
    uint64_t rows64 = 1;
    for (size_t i = 0; i + 1 < shape.size(); ++i) {
        rows64 *= static_cast<uint64_t>(shape[i]);
    }
    const size_t rows = static_cast<size_t>(rows64);
    const size_t count = rows * dim;
    std::vector<float> x(count), residual(count), gamma(dim), bias(dim);
    for (size_t i = 0; i < count; ++i) {
        x[i] = (static_cast<int32_t>((i * 7U) % 23U) - 11) * 0.03125F;
        residual[i] = (static_cast<int32_t>((i * 5U) % 17U) - 8) * 0.015625F;
    }
    for (size_t i = 0; i < dim; ++i) {
        gamma[i] = 0.75F + static_cast<float>(i % 13U) * 0.03125F;
        bias[i] = (static_cast<int32_t>(i % 7U) - 3) * 0.0078125F;
    }
    const float epsilon = 1.0e-5F;
    const std::vector<uint8_t> xBytes = Encode(x, dtype);
    const std::vector<uint8_t> residualBytes = Encode(residual, dtype);
    const std::vector<uint8_t> gammaBytes = Encode(gamma, dtype);
    const std::vector<uint8_t> biasBytes = Encode(bias, dtype);
    HostBuffer dx, dr, dg, db, dy;
    bool ok = AllocateAndCopy(xBytes, dx) && AllocateAndCopy(residualBytes, dr) &&
              AllocateAndCopy(gammaBytes, dg) && AllocateAndCopy(biasBytes, db);
    if (ok) {
        const size_t elementBytes = dtype == 0 ? sizeof(float) : sizeof(uint16_t);
        dy.bytes = count * elementBytes;
        ok = aclrtMalloc(reinterpret_cast<void **>(&dy.device), dy.bytes, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    }
    if (!ok) {
        std::cerr << name << " allocation/copy failed" << std::endl;
        Release(dx); Release(dr); Release(dg); Release(db); Release(dy);
        return false;
    }

    TensorInfo xInfo{shape.data(), static_cast<int64_t>(shape.size()), dtype};
    TensorInfo residualInfo{shape.data(), static_cast<int64_t>(shape.size()), dtype};
    TensorInfo gammaInfo{shape.data() + shape.size() - 1, 1, dtype};
    TensorInfo biasInfo{shape.data() + shape.size() - 1, 1, dtype};
    TensorInfo outputInfo{shape.data(), static_cast<int64_t>(shape.size()), dtype};
    TensorGroupInfo xGroup{&xInfo, 1};
    TensorGroupInfo residualGroup{&residualInfo, 1};
    TensorGroupInfo gammaGroup{&gammaInfo, 1};
    TensorGroupInfo biasGroup{&biasInfo, 1};
    TensorGroupInfo outputGroup{&outputInfo, 1};
    const uint32_t elementBytes = dtype == 0 ? sizeof(float) : sizeof(uint16_t);
    const auto tiling = ext_ascend_x::ChooseTiling(static_cast<uint32_t>(rows), dim, cores, elementBytes);
    g_caseContext = name + ":dtype=" + std::to_string(dtype) + ":rows=" + std::to_string(rows) +
                    ":dim=" + std::to_string(dim) + ":cores=" + std::to_string(cores);
    std::cout << "TILING_CASE=" << g_caseContext << " BLOCK_FACTOR=" << tiling.blockFactor
              << " ROW_FACTOR=" << tiling.rowFactor << " UB_FACTOR=" << tiling.ubFactor
              << " ALIGNED_UB_FACTOR=" << tiling.alignedUbFactor << std::endl;
    g_lastSyncStatus = ACL_SUCCESS;
    g_lastRuntimeMessage.clear();
    run_kernel(dx.device, xGroup, dr.device, residualGroup,
               dg.device, gammaGroup, db.device, biasGroup,
               dy.device, outputGroup, cores, stream, epsilon);
    const aclError syncStatus = g_lastSyncStatus;
    const std::string runtimeMessage = g_lastRuntimeMessage;
    std::vector<uint8_t> outputBytes(dy.bytes);
    ok = aclrtMemcpy(outputBytes.data(), outputBytes.size(), dy.device, dy.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;

    float maxError = 0.0F;
    float maxAllowed = 0.0F;
    size_t matchedElements = 0;
    size_t totalElements = 0;
    if (ok) {
        const float atol = dtype == 0 ? 1.52587890625e-5F : (dtype == 1 ? 1.953125e-3F : 1.5625e-2F);
        const float rtol = dtype == 0 ? 9.765625e-4F : (dtype == 1 ? 1.953125e-3F : 1.5625e-2F);
        totalElements = count;
        for (size_t row = 0; row < rows; ++row) {
            float squareSum = 0.0F;
            for (size_t col = 0; col < dim; ++col) {
                const size_t offset = row * dim + col;
                const float value = Decode(xBytes.data(), offset, dtype) + Decode(residualBytes.data(), offset, dtype);
                squareSum += value * value;
            }
            const float inverseRms = 1.0F / std::sqrt(squareSum / static_cast<float>(dim) + epsilon);
            for (size_t col = 0; col < dim; ++col) {
                const size_t offset = row * dim + col;
                const float value = Decode(xBytes.data(), offset, dtype) + Decode(residualBytes.data(), offset, dtype);
                const float expected = value * inverseRms * Decode(gammaBytes.data(), col, dtype) +
                                       Decode(biasBytes.data(), col, dtype);
                const float actual = Decode(outputBytes.data(), offset, dtype);
                const float error = std::fabs(actual - expected);
                const float allowed = atol + rtol * std::fabs(expected);
                maxError = std::max(maxError, error);
                maxAllowed = std::max(maxAllowed, allowed);
                if (error <= allowed) {
                    ++matchedElements;
                }
            }
        }
    }
    const double matchedRatio = totalElements == 0 ? 0.0 : static_cast<double>(matchedElements) / totalElements;
    ok = ok && syncStatus == ACL_SUCCESS && matchedRatio >= 0.99;
    std::cout << "CASE=" << name << " DTYPE=" << dtype << " ROWS=" << rows << " DIM=" << dim
              << " CORES=" << cores << " BLOCK_FACTOR=" << tiling.blockFactor
              << " ROW_FACTOR=" << tiling.rowFactor << " UB_FACTOR=" << tiling.ubFactor
              << " STATUS=" << (ok ? "PASS" : "FAIL") << " SYNC_STATUS=" << syncStatus
              << " RECENT_ERROR=" << runtimeMessage << " MATCHED_RATIO=" << matchedRatio
              << " MAX_ABS_ERROR=" << maxError << " MAX_ALLOWED=" << maxAllowed << std::endl;
    Release(dx); Release(dr); Release(dg); Release(db); Release(dy);
    return ok;
}

}  // namespace

int main()
{
    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(0) != ACL_SUCCESS) {
        std::cerr << "ACL initialization/device selection failed" << std::endl;
        return 2;
    }
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        std::cerr << "ACL stream creation failed" << std::endl;
        aclrtResetDevice(0);
        aclFinalize();
        return 2;
    }
    bool ok = true;
    const char *matrixFilter = std::getenv("EXT_DIAG_MATRIX");
    const char *dtypeFilter = std::getenv("EXT_DTYPE");
    if (matrixFilter != nullptr) {
        const uint32_t dims[] = {256U, 4096U, 8192U};
        for (uint32_t dim : dims) {
            for (uint32_t rows = 1; rows <= 3; ++rows) {
                for (uint32_t cores = 1; cores <= 3; ++cores) {
                    if (dtypeFilter != nullptr && std::atoi(dtypeFilter) != 0) {
                        continue;
                    }
                    const std::string name = "diag_fp32_d" + std::to_string(dim) + "_rows" +
                                             std::to_string(rows) + "_cores" + std::to_string(cores);
                    ok = RunCase(name, {static_cast<int64_t>(rows), static_cast<int64_t>(dim)}, 0, cores, stream) && ok;
                }
            }
        }
    } else {
    const std::vector<std::pair<std::string, std::vector<int64_t>>> cases = {
        {"2d_rows1_d256", {1, 256}}, {"2d_rows2_d256", {2, 256}}, {"2d_rows3_tail_d256", {3, 256}},
        {"2d_rows1_d4096", {1, 4096}}, {"2d_rows2_d4096", {2, 4096}}, {"2d_rows3_tail_d4096", {3, 4096}},
        {"2d_rows1_d8192", {1, 8192}}, {"2d_rows2_d8192", {2, 8192}}, {"2d_rows3_tail_d8192", {3, 8192}},
        {"2d_rows1_d16384", {1, 16384}}, {"2d_rows2_d16384", {2, 16384}}, {"2d_rows3_tail_d16384", {3, 16384}},
        {"2d_rows1_d32768", {1, 32768}}, {"2d_rows2_d32768", {2, 32768}}, {"2d_rows3_tail_d32768", {3, 32768}},
        {"3d_rows1_d256", {1, 1, 256}}, {"3d_rows2_d256", {2, 1, 256}}, {"3d_rows3_tail_d256", {3, 1, 256}},
        {"3d_rows1_d4096", {1, 1, 4096}}, {"3d_rows2_d4096", {2, 1, 4096}}, {"3d_rows3_tail_d4096", {3, 1, 4096}},
        {"3d_rows1_d8192", {1, 1, 8192}}, {"3d_rows2_d8192", {2, 1, 8192}}, {"3d_rows3_tail_d8192", {3, 1, 8192}},
        {"3d_rows1_d16384", {1, 1, 16384}}, {"3d_rows2_d16384", {2, 1, 16384}}, {"3d_rows3_tail_d16384", {3, 1, 16384}},
        {"3d_rows1_d32768", {1, 1, 32768}}, {"3d_rows2_d32768", {2, 1, 32768}}, {"3d_rows3_tail_d32768", {3, 1, 32768}},
        {"4d_rows1_d256", {1, 1, 1, 256}}, {"4d_rows2_d256", {1, 2, 1, 256}}, {"4d_rows3_tail_d256", {1, 3, 1, 256}},
        {"4d_rows1_d4096", {1, 1, 1, 4096}}, {"4d_rows2_d4096", {1, 2, 1, 4096}}, {"4d_rows3_tail_d4096", {1, 3, 1, 4096}},
        {"4d_rows1_d8192", {1, 1, 1, 8192}}, {"4d_rows2_d8192", {1, 2, 1, 8192}}, {"4d_rows3_tail_d8192", {1, 3, 1, 8192}},
        {"4d_rows1_d16384", {1, 1, 1, 16384}}, {"4d_rows2_d16384", {1, 2, 1, 16384}}, {"4d_rows3_tail_d16384", {1, 3, 1, 16384}},
        {"4d_rows1_d32768", {1, 1, 1, 32768}}, {"4d_rows2_d32768", {1, 2, 1, 32768}}, {"4d_rows3_tail_d32768", {1, 3, 1, 32768}},
    };
    for (const auto &test : cases) {
        const uint32_t cores = test.first.find("rows3_tail") != std::string::npos ? 2U : 3U;
        for (int32_t dtype = 0; dtype < 3; ++dtype) {
            if (dtypeFilter != nullptr && dtype != std::atoi(dtypeFilter)) {
                continue;
            }
            ok = RunCase(test.first, test.second, dtype, cores, stream) && ok;
        }
    }
    }
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ok ? 0 : 1;
}
