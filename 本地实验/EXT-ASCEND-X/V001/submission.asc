#include <algorithm>
#include <cstdint>

#include "kernel_operator.h"
#include "acl/acl_rt.h"

namespace ext_ascend_x {

constexpr uint32_t kVectorUbBytes = 184U * 1024U;
constexpr uint32_t kReservedUbBytes = 8U * 1024U;
constexpr uint32_t kUsableUbBytes = kVectorUbBytes - kReservedUbBytes;
constexpr uint32_t kDmaAlignmentBytes = 32U;
constexpr uint32_t kScalarStrideBytes = 32U;

struct DynamicTilingData {
    uint32_t blockFactor;
    uint32_t rowFactor;
    uint32_t ubFactor;
    uint32_t alignedUbFactor;
    uint32_t scalarStride;
    uint32_t elementBytes;
    uint32_t rows;
    uint32_t dim;
    uint32_t availableCores;
    float reciprocalDim;
    uint32_t reservedUbBytes;
    uint32_t usableUbBytes;
};

inline uint32_t AlignUp(uint32_t value, uint32_t alignment)
{
    return ((value + alignment - 1U) / alignment) * alignment;
}

inline uint64_t CeilDiv(uint64_t value, uint64_t divisor)
{
    return (value + divisor - 1U) / divisor;
}

inline uint64_t BufferBytes(uint32_t rowFactor, uint32_t ubFactor, uint32_t elementBytes)
{
    const uint32_t aligned = AlignUp(ubFactor * elementBytes, kDmaAlignmentBytes) / elementBytes;
    const uint32_t scalarStride = kScalarStrideBytes / elementBytes;
    const uint64_t rowQueues = static_cast<uint64_t>(3U) * rowFactor * aligned * elementBytes;
    const uint64_t vectorQueues = static_cast<uint64_t>(2U) * aligned * elementBytes;
    const uint64_t scalarBuffers = static_cast<uint64_t>(3U) * rowFactor * scalarStride * elementBytes;
    const uint64_t reductionBuffer = static_cast<uint64_t>(aligned) * elementBytes;
    return rowQueues + vectorQueues + scalarBuffers + reductionBuffer;
}

inline DynamicTilingData ChooseTiling(uint32_t rows, uint32_t dim, uint32_t availableCores,
                                      uint32_t elementBytes)
{
    DynamicTilingData result{};
    const uint32_t cores = std::max(availableCores, 1U);
    const uint32_t elementBlock = std::max(kDmaAlignmentBytes / elementBytes, 1U);
    const uint32_t maxBlocks = std::min(cores, std::max(rows, 1U));
    const uint32_t alignedDim = AlignUp(dim * elementBytes, kDmaAlignmentBytes) / elementBytes;
    uint32_t selectedBlocks = maxBlocks;
    uint32_t selectedRows = static_cast<uint32_t>(CeilDiv(rows, selectedBlocks));
    uint32_t selectedUb = std::min(alignedDim, std::max(elementBlock, 1U));

    for (uint32_t candidateBlocks = maxBlocks; candidateBlocks >= 1U; --candidateBlocks) {
        const uint32_t candidateRows = static_cast<uint32_t>(CeilDiv(rows, candidateBlocks));
        uint32_t candidateUb = alignedDim;
        while (candidateUb >= elementBlock && BufferBytes(candidateRows, candidateUb, elementBytes) > kUsableUbBytes) {
            candidateUb -= elementBlock;
        }
        if (candidateUb >= elementBlock || dim < elementBlock) {
            selectedBlocks = candidateBlocks;
            selectedRows = candidateRows;
            selectedUb = dim < elementBlock ? dim : std::max(candidateUb, elementBlock);
            break;
        }
    }
    if (selectedUb == 0U) {
        selectedUb = std::min(dim, elementBlock);
    }
    result.blockFactor = selectedBlocks;
    result.rowFactor = selectedRows;
    result.ubFactor = selectedUb;
    result.alignedUbFactor = AlignUp(selectedUb * elementBytes, kDmaAlignmentBytes) / elementBytes;
    result.scalarStride = kScalarStrideBytes / elementBytes;
    result.elementBytes = elementBytes;
    result.rows = rows;
    result.dim = dim;
    result.availableCores = cores;
    result.reciprocalDim = 1.0F / static_cast<float>(dim);
    result.reservedUbBytes = kReservedUbBytes;
    result.usableUbBytes = kUsableUbBytes;
    return result;
}

template <typename T>
class DynamicRowsKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
                                uint32_t rows, uint32_t dim, float epsilon,
                                const __gm__ DynamicTilingData *tiling)
    {
        tiling_ = tiling;
        rows_ = rows;
        dim_ = dim;
        epsilon_ = epsilon;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x));
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(residual));
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gamma));
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bias));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(output));

        xStride_ = tiling_->alignedUbFactor;
        scalarStride_ = tiling_->scalarStride;
        pipe_.InitBuffer(xQueue_, 1, tiling_->rowFactor * xStride_ * sizeof(T));
        pipe_.InitBuffer(residualQueue_, 1, tiling_->rowFactor * xStride_ * sizeof(T));
        pipe_.InitBuffer(affineQueue_, 1, 2U * xStride_ * sizeof(T));
        pipe_.InitBuffer(outputQueue_, 1, tiling_->rowFactor * xStride_ * sizeof(T));
        pipe_.InitBuffer(sumBuffer_, tiling_->rowFactor * scalarStride_ * sizeof(T));
        pipe_.InitBuffer(tileSumBuffer_, tiling_->rowFactor * scalarStride_ * sizeof(T));
        pipe_.InitBuffer(inverseRmsBuffer_, tiling_->rowFactor * scalarStride_ * sizeof(T));
        pipe_.InitBuffer(reduceBuffer_, xStride_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t block = AscendC::GetBlockIdx();
        if (block >= tiling_->blockFactor) {
            return;
        }
        const uint32_t rowBegin = block * tiling_->rowFactor;
        if (rowBegin >= rows_) {
            return;
        }
        const uint32_t rowCount = tiling_->rowFactor < (rows_ - rowBegin) ? tiling_->rowFactor : (rows_ - rowBegin);
        auto sums = sumBuffer_.Get<T>();
        auto tileSums = tileSumBuffer_.Get<T>();
        auto inverseRms = inverseRmsBuffer_.Get<T>();
        auto reduceTmp = reduceBuffer_.Get<T>();
        AscendC::Duplicate(sums, static_cast<T>(0), tiling_->rowFactor * scalarStride_);

        for (uint32_t col = 0; col < dim_; col += tiling_->ubFactor) {
            const uint32_t cols = tiling_->ubFactor < (dim_ - col) ? tiling_->ubFactor : (dim_ - col);
            CopyRows(xGm_, residualGm_, rowBegin, rowCount, col, cols);
            auto xLocal = xQueue_.DeQue<T>();
            auto residualLocal = residualQueue_.DeQue<T>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                const uint32_t localOffset = row * xStride_;
                const uint32_t scalarOffset = row * scalarStride_;
                AscendC::Add(xLocal[localOffset], xLocal[localOffset], residualLocal[localOffset],
                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Mul(residualLocal[localOffset], xLocal[localOffset], xLocal[localOffset],
                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::ReduceSum<T, true>(tileSums[scalarOffset], residualLocal[localOffset], reduceTmp,
                                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Add(sums[scalarOffset], sums[scalarOffset], tileSums[scalarOffset], 1);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            xQueue_.FreeTensor(xLocal);
            residualQueue_.FreeTensor(residualLocal);
        }

        for (uint32_t row = 0; row < rowCount; ++row) {
            const uint32_t scalarOffset = row * scalarStride_;
            AscendC::Duplicate(reduceTmp, static_cast<T>(tiling_->reciprocalDim), 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Mul(sums[scalarOffset], sums[scalarOffset], reduceTmp, 1);
            AscendC::Duplicate(reduceTmp, static_cast<T>(epsilon_), 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Add(sums[scalarOffset], sums[scalarOffset], reduceTmp, 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Rsqrt(inverseRms[scalarOffset], sums[scalarOffset], 1);
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        for (uint32_t col = 0; col < dim_; col += tiling_->ubFactor) {
            const uint32_t cols = tiling_->ubFactor < (dim_ - col) ? tiling_->ubFactor : (dim_ - col);
            CopyRows(xGm_, residualGm_, rowBegin, rowCount, col, cols);
            CopyVectors(col, cols);
            auto xLocal = xQueue_.DeQue<T>();
            auto residualLocal = residualQueue_.DeQue<T>();
            auto affineLocal = affineQueue_.DeQue<T>();
            auto gammaLocal = affineLocal;
            auto biasLocal = affineLocal[xStride_];
            auto outputLocal = outputQueue_.AllocTensor<T>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                const uint32_t localOffset = row * xStride_;
                const uint32_t scalarOffset = row * scalarStride_;
                AscendC::Add(xLocal[localOffset], xLocal[localOffset], residualLocal[localOffset],
                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Duplicate(reduceTmp, inverseRms.GetValue(scalarOffset), 1);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Mul(xLocal[localOffset], xLocal[localOffset], reduceTmp,
                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Mul(xLocal[localOffset], xLocal[localOffset], affineLocal, static_cast<int32_t>(cols));
                AscendC::Add(outputLocal[localOffset], xLocal[localOffset], biasLocal,
                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            outputQueue_.EnQue(outputLocal);
            xQueue_.FreeTensor(xLocal);
            residualQueue_.FreeTensor(residualLocal);
            affineQueue_.FreeTensor(affineLocal);
            auto outputReady = outputQueue_.DeQue<T>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                const uint32_t localOffset = row * xStride_;
                const uint32_t globalOffset = (rowBegin + row) * dim_ + col;
                AscendC::DataCopyPad(outputGm_[globalOffset], outputReady[localOffset],
                                     AscendC::DataCopyExtParams(1, cols * sizeof(T), 0, 0, 0));
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            outputQueue_.FreeTensor(outputReady);
        }
    }

private:
    __aicore__ inline void CopyRows(AscendC::GlobalTensor<T> &first, AscendC::GlobalTensor<T> &second,
                                    uint32_t rowBegin, uint32_t rowCount, uint32_t col, uint32_t cols)
    {
        auto firstLocal = xQueue_.AllocTensor<T>();
        auto secondLocal = residualQueue_.AllocTensor<T>();
        for (uint32_t row = 0; row < rowCount; ++row) {
            const uint32_t localOffset = row * xStride_;
            const uint32_t globalOffset = (rowBegin + row) * dim_ + col;
            const AscendC::DataCopyExtParams copyParams(1, cols * sizeof(T), 0, 0, 0);
            const AscendC::DataCopyPadExtParams<T> padParams(false, 0, 0, static_cast<T>(0));
            AscendC::DataCopyPad(firstLocal[localOffset], first[globalOffset], copyParams, padParams);
            AscendC::DataCopyPad(secondLocal[localOffset], second[globalOffset], copyParams, padParams);
        }
        xQueue_.EnQue(firstLocal);
        residualQueue_.EnQue(secondLocal);
    }

    __aicore__ inline void CopyVectors(uint32_t col, uint32_t cols)
    {
        auto affineLocal = affineQueue_.AllocTensor<T>();
        const AscendC::DataCopyExtParams copyParams(1, cols * sizeof(T), 0, 0, 0);
        const AscendC::DataCopyPadExtParams<T> padParams(false, 0, 0, static_cast<T>(0));
        AscendC::DataCopyPad(affineLocal, gammaGm_[col], copyParams, padParams);
        AscendC::DataCopyPad(affineLocal[xStride_], biasGm_[col], copyParams, padParams);
        affineQueue_.EnQue(affineLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> residualQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> affineQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tileSumBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inverseRmsBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceBuffer_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> residualGm_;
    AscendC::GlobalTensor<T> gammaGm_;
    AscendC::GlobalTensor<T> biasGm_;
    AscendC::GlobalTensor<T> outputGm_;
    const __gm__ DynamicTilingData *tiling_;
    uint32_t rows_ = 0;
    uint32_t dim_ = 0;
    uint32_t xStride_ = 0;
    uint32_t scalarStride_ = 0;
    float epsilon_ = 0.0F;
};

template <>
class DynamicRowsKernel<bfloat16_t> {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
                                uint32_t rows, uint32_t dim, float epsilon,
                                const __gm__ DynamicTilingData *tiling)
    {
        tiling_ = tiling;
        rows_ = rows;
        dim_ = dim;
        epsilon_ = epsilon;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x));
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(residual));
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(gamma));
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(bias));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(output));
        xStride_ = tiling_->alignedUbFactor;
        scalarStride_ = tiling_->scalarStride;
        pipe_.InitBuffer(inputQueue_, 1, tiling_->rowFactor * xStride_ * sizeof(bfloat16_t));
        pipe_.InitBuffer(outputQueue_, 1, tiling_->rowFactor * xStride_ * sizeof(bfloat16_t));
        pipe_.InitBuffer(xFloat_, tiling_->rowFactor * xStride_ * sizeof(float));
        pipe_.InitBuffer(residualFloat_, tiling_->rowFactor * xStride_ * sizeof(float));
        pipe_.InitBuffer(affineFloat_, xStride_ * sizeof(float));
        pipe_.InitBuffer(sumBuffer_, tiling_->rowFactor * scalarStride_ * sizeof(float));
        pipe_.InitBuffer(tileSumBuffer_, tiling_->rowFactor * scalarStride_ * sizeof(float));
        pipe_.InitBuffer(inverseRmsBuffer_, tiling_->rowFactor * scalarStride_ * sizeof(float));
        pipe_.InitBuffer(reduceBuffer_, xStride_ * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        const uint32_t block = AscendC::GetBlockIdx();
        if (block >= tiling_->blockFactor) {
            return;
        }
        const uint32_t rowBegin = block * tiling_->rowFactor;
        if (rowBegin >= rows_) {
            return;
        }
        const uint32_t rowCount = tiling_->rowFactor < (rows_ - rowBegin) ? tiling_->rowFactor : (rows_ - rowBegin);
        auto xFloat = xFloat_.Get<float>();
        auto residualFloat = residualFloat_.Get<float>();
        auto affineFloat = affineFloat_.Get<float>();
        auto sums = sumBuffer_.Get<float>();
        auto tileSums = tileSumBuffer_.Get<float>();
        auto inverseRms = inverseRmsBuffer_.Get<float>();
        auto reduceTmp = reduceBuffer_.Get<float>();
        AscendC::Duplicate(sums, 0.0F, tiling_->rowFactor * scalarStride_);

        for (uint32_t col = 0; col < dim_; col += tiling_->ubFactor) {
            const uint32_t cols = tiling_->ubFactor < (dim_ - col) ? tiling_->ubFactor : (dim_ - col);
            LoadRows(xGm_, rowBegin, rowCount, col, cols);
            auto input = inputQueue_.DeQue<bfloat16_t>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                const uint32_t localOffset = row * xStride_;
                AscendC::Cast<float, bfloat16_t>(xFloat[localOffset], input[localOffset],
                                                 AscendC::RoundMode::CAST_NONE, cols);
            }
            inputQueue_.FreeTensor(input);
            LoadRows(residualGm_, rowBegin, rowCount, col, cols);
            input = inputQueue_.DeQue<bfloat16_t>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                const uint32_t localOffset = row * xStride_;
                const uint32_t scalarOffset = row * scalarStride_;
                AscendC::Cast<float, bfloat16_t>(residualFloat[localOffset], input[localOffset],
                                                 AscendC::RoundMode::CAST_NONE, cols);
                AscendC::Add(xFloat[localOffset], xFloat[localOffset], residualFloat[localOffset],
                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Mul(residualFloat[localOffset], xFloat[localOffset], xFloat[localOffset],
                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::ReduceSum<float, true>(tileSums[scalarOffset], residualFloat[localOffset], reduceTmp,
                                                 static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Add(sums[scalarOffset], sums[scalarOffset], tileSums[scalarOffset], 1);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            inputQueue_.FreeTensor(input);
        }

        for (uint32_t row = 0; row < rowCount; ++row) {
            const uint32_t scalarOffset = row * scalarStride_;
            AscendC::Duplicate(reduceTmp, static_cast<float>(tiling_->reciprocalDim), 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Mul(sums[scalarOffset], sums[scalarOffset], reduceTmp, 1);
            AscendC::Duplicate(reduceTmp, static_cast<float>(epsilon_), 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Add(sums[scalarOffset], sums[scalarOffset], reduceTmp, 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Rsqrt(inverseRms[scalarOffset], sums[scalarOffset], 1);
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        for (uint32_t col = 0; col < dim_; col += tiling_->ubFactor) {
            const uint32_t cols = tiling_->ubFactor < (dim_ - col) ? tiling_->ubFactor : (dim_ - col);
            LoadRows(xGm_, rowBegin, rowCount, col, cols);
            auto input = inputQueue_.DeQue<bfloat16_t>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                AscendC::Cast<float, bfloat16_t>(xFloat[row * xStride_], input[row * xStride_],
                                                 AscendC::RoundMode::CAST_NONE, cols);
            }
            inputQueue_.FreeTensor(input);
            LoadRows(residualGm_, rowBegin, rowCount, col, cols);
            input = inputQueue_.DeQue<bfloat16_t>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                AscendC::Cast<float, bfloat16_t>(residualFloat[row * xStride_], input[row * xStride_],
                                                 AscendC::RoundMode::CAST_NONE, cols);
            }
            inputQueue_.FreeTensor(input);
            LoadVector(gammaGm_, col, cols);
            input = inputQueue_.DeQue<bfloat16_t>();
            AscendC::Cast<float, bfloat16_t>(affineFloat, input, AscendC::RoundMode::CAST_NONE, cols);
            inputQueue_.FreeTensor(input);
            for (uint32_t row = 0; row < rowCount; ++row) {
                const uint32_t localOffset = row * xStride_;
                const uint32_t scalarOffset = row * scalarStride_;
                AscendC::Add(xFloat[localOffset], xFloat[localOffset], residualFloat[localOffset],
                             static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Duplicate(reduceTmp, inverseRms.GetValue(scalarOffset), 1);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Mul(xFloat[localOffset], xFloat[localOffset], reduceTmp, static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Mul(xFloat[localOffset], xFloat[localOffset], affineFloat, static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            LoadVector(biasGm_, col, cols);
            input = inputQueue_.DeQue<bfloat16_t>();
            AscendC::Cast<float, bfloat16_t>(affineFloat, input, AscendC::RoundMode::CAST_NONE, cols);
            inputQueue_.FreeTensor(input);
            auto output = outputQueue_.AllocTensor<bfloat16_t>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                const uint32_t localOffset = row * xStride_;
                AscendC::Add(xFloat[localOffset], xFloat[localOffset], affineFloat, static_cast<int32_t>(cols));
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Cast<bfloat16_t, float>(output[localOffset], xFloat[localOffset],
                                                 AscendC::RoundMode::CAST_RINT, cols);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            outputQueue_.EnQue(output);
            auto outputReady = outputQueue_.DeQue<bfloat16_t>();
            for (uint32_t row = 0; row < rowCount; ++row) {
                const uint32_t localOffset = row * xStride_;
                const uint32_t globalOffset = (rowBegin + row) * dim_ + col;
                AscendC::DataCopyPad(outputGm_[globalOffset], outputReady[localOffset],
                                     AscendC::DataCopyExtParams(1, cols * sizeof(bfloat16_t), 0, 0, 0));
                AscendC::PipeBarrier<PIPE_ALL>();
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            outputQueue_.FreeTensor(outputReady);
        }
    }

private:
    __aicore__ inline void LoadRows(AscendC::GlobalTensor<bfloat16_t> &source, uint32_t rowBegin,
                                    uint32_t rowCount, uint32_t col, uint32_t cols)
    {
        auto local = inputQueue_.AllocTensor<bfloat16_t>();
        const AscendC::DataCopyExtParams copyParams(1, cols * sizeof(bfloat16_t), 0, 0, 0);
        const AscendC::DataCopyPadExtParams<bfloat16_t> padParams(false, 0, 0, static_cast<bfloat16_t>(0));
        for (uint32_t row = 0; row < rowCount; ++row) {
            const uint32_t localOffset = row * xStride_;
            const uint32_t globalOffset = (rowBegin + row) * dim_ + col;
            AscendC::DataCopyPad(local[localOffset], source[globalOffset], copyParams, padParams);
        }
        inputQueue_.EnQue(local);
    }

    __aicore__ inline void LoadVector(AscendC::GlobalTensor<bfloat16_t> &source, uint32_t col, uint32_t cols)
    {
        auto local = inputQueue_.AllocTensor<bfloat16_t>();
        const AscendC::DataCopyExtParams copyParams(1, cols * sizeof(bfloat16_t), 0, 0, 0);
        const AscendC::DataCopyPadExtParams<bfloat16_t> padParams(false, 0, 0, static_cast<bfloat16_t>(0));
        AscendC::DataCopyPad(local, source[col], copyParams, padParams);
        inputQueue_.EnQue(local);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> residualFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> affineFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tileSumBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inverseRmsBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceBuffer_;
    AscendC::GlobalTensor<bfloat16_t> xGm_;
    AscendC::GlobalTensor<bfloat16_t> residualGm_;
    AscendC::GlobalTensor<bfloat16_t> gammaGm_;
    AscendC::GlobalTensor<bfloat16_t> biasGm_;
    AscendC::GlobalTensor<bfloat16_t> outputGm_;
    const __gm__ DynamicTilingData *tiling_;
    uint32_t rows_ = 0;
    uint32_t dim_ = 0;
    uint32_t xStride_ = 0;
    uint32_t scalarStride_ = 0;
    float epsilon_ = 0.0F;
};

template <typename T>
__global__ __vector__ void ext_ascend_x_kernel(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias,
                                                GM_ADDR output, uint32_t rows, uint32_t dim, float epsilon,
                                                GM_ADDR tiling)
{
    DynamicRowsKernel<T> kernel;
    kernel.Init(x, residual, gamma, bias, output, rows, dim, epsilon,
                reinterpret_cast<const __gm__ DynamicTilingData *>(tiling));
    kernel.Process();
}

}  // namespace ext_ascend_x

extern "C" void run_kernel(GM_ADDR x, TensorGroupInfo xInfo, GM_ADDR residual, TensorGroupInfo residualInfo,
                            GM_ADDR gamma, TensorGroupInfo gammaInfo, GM_ADDR bias, TensorGroupInfo biasInfo,
                            GM_ADDR output, TensorGroupInfo outputInfo, uint32_t availableCoreNum,
                            aclrtStream stream, float epsilon)
{
    (void)residualInfo;
    (void)gammaInfo;
    (void)biasInfo;
    (void)outputInfo;
    if (xInfo.numTensors < 1 || xInfo.tensors == nullptr) {
        return;
    }
    const TensorInfo &info = xInfo.tensors[0];
    uint64_t rowCount = 1U;
    for (int64_t i = 0; i + 1 < info.numDims; ++i) {
        rowCount *= static_cast<uint64_t>(info.shape[i]);
    }
    const uint32_t rows = static_cast<uint32_t>(rowCount);
    const uint32_t dim = static_cast<uint32_t>(info.shape[info.numDims - 1]);
    const uint32_t elementBytes = info.dtype == 0 ? sizeof(float) : sizeof(half);
    const auto tiling = ext_ascend_x::ChooseTiling(rows, dim, availableCoreNum, elementBytes);
    GM_ADDR tilingDevice = nullptr;
    if (aclrtMalloc(reinterpret_cast<void **>(&tilingDevice), sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return;
    }
    if (aclrtMemcpy(tilingDevice, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        aclrtFree(tilingDevice);
        return;
    }
    if (info.dtype == 0) {
        ext_ascend_x::ext_ascend_x_kernel<float><<<tiling.blockFactor, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, epsilon, tilingDevice);
    } else if (info.dtype == 1) {
        ext_ascend_x::ext_ascend_x_kernel<half><<<tiling.blockFactor, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, epsilon, tilingDevice);
    } else if (info.dtype == 2) {
        ext_ascend_x::ext_ascend_x_kernel<bfloat16_t><<<tiling.blockFactor, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, epsilon, tilingDevice);
    }
    aclrtSynchronizeStream(stream);
    aclrtFree(tilingDevice);
}
