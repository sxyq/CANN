#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#include "kernel.txt"

#define ACL_CHECK(expr) do { \
    aclError _ret = (expr); \
    if (_ret != 0) { \
        fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); \
        return 1; \
    } \
} while (0)

#define FILE_CHECK(expr) do { \
    if (!(expr)) { \
        fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); \
        return 1; \
    } \
} while (0)

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t shape[] = {1, 64};
    TensorInfo tensor[] = {{shape, 2, 1}};
    TensorGroupInfo info = {tensor, 1};
    const size_t bytes = 128;
    uint8_t* host = nullptr;
    uint8_t* device = nullptr;
    uint8_t* outputHost = nullptr;
    uint8_t* outputDevice = nullptr;

    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void**>(&host), bytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&device), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void**>(&outputHost), bytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&outputDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x.bin", bytes, host, bytes));
    ACL_CHECK(aclrtMemcpy(device, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    run_kernel(device, info, device, info, device, info, device, info, outputDevice, info,
        availableCoreNum, stream, 1e-5f);

    ACL_CHECK(aclrtMemcpy(outputHost, bytes, outputDevice, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/output.bin", outputHost, bytes));

    aclrtFree(device);
    aclrtFreeHost(host);
    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
