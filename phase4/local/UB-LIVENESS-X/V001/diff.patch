+// UB-LIVENESS-X V001
+// SINGLE_HYPOTHESIS: phase-role UB liveness/aliasing — the same physical pool bytes
+// serve INGEST in pass1 and EMIT in pass2, freeing peak live-set for param residency
+// and depth-2 slots under the 184 KiB budget.
+// Math: u=x+res; rms=sqrt(mean(u*u)+eps); out=u/rms*gamma+bias.
+#ifndef UB_LIVENESS_ALIAS
+#define UB_LIVENESS_ALIAS 1
+#endif
+
+#include <cmath>
+#include <type_traits>
+#include <cstdint>
+#include "kernel_operator.h"
+
+using AscendC::TPipe;
+using AscendC::TBuf;
+using AscendC::LocalTensor;
+using AscendC::GlobalTensor;
+using AscendC::DataCopyExtParams;
+using AscendC::DataCopyPadExtParams;
+using AscendC::Muls;
+using AscendC::Add;
+using AscendC::Mul;
+using AscendC::Cast;
+using AscendC::Duplicate;
+using AscendC::Sqrt;
+using AscendC::SetFlag;
+using AscendC::WaitFlag;
+using AscendC::HardEvent;
+using AscendC::GetBlockIdx;
+using AscendC::GetBlockNum;
+using AscendC::DataCopyPad;
+using AscendC::PipeBarrier;
+
+static constexpr int32_t kDtypeF32 = 0;
+static constexpr int32_t kDtypeF16 = 1;
+static constexpr int32_t kDtypeBF16 = 2;
+static constexpr int32_t kReduceWorkBytes = 8 * 1024;
+static constexpr int32_t kUbBudgetBytes = 184 * 1024;
+static constexpr int32_t kEventV2S = static_cast<int32_t>(EVENT_ID0);
+static constexpr int32_t kEventS2V = static_cast<int32_t>(EVENT_ID1);
+
+static inline int32_t NormalizeDtype(int32_t raw)
+{
+    if (raw == 27) {
+        return kDtypeBF16;
+    }
+    return raw;
+}
+
+__aicore__ inline int32_t Align32(int32_t bytes)
+{
+    return (bytes + 31) / 32 * 32;
+}
+
+template <typename T>
+__aicore__ inline void CopyInPad(LocalTensor<T>& dst, GlobalTensor<T>& srcGm, int64_t gmOffset,
+                                 int32_t validCount)
+{
+    const uint32_t byteLen = static_cast<uint32_t>(validCount) * static_cast<uint32_t>(sizeof(T));
+    DataCopyExtParams cp(1, byteLen, 0, 0, 0);
+    DataCopyPadExtParams<T> pad(true, 0, 0, static_cast<T>(0));
+    DataCopyPad(dst, srcGm[static_cast<uint32_t>(gmOffset)], cp, pad);
+    SetFlag<HardEvent::MTE2_V>(EVENT_ID7);
+    WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
+}
+
+template <typename T>
+__aicore__ inline void CopyOutPad(GlobalTensor<T>& dstGm, LocalTensor<T>& src, int64_t gmOffset,
+                                  int32_t validCount)
+{
+    const uint32_t byteLen = static_cast<uint32_t>(validCount) * static_cast<uint32_t>(sizeof(T));
+    DataCopyExtParams cp(1, byteLen, 0, 0, 0);
+    DataCopyPad(dstGm[static_cast<uint32_t>(gmOffset)], src, cp);
+    PipeBarrier<PIPE_MTE3>();
+}
+
+template <typename T>
+__aicore__ inline void ToFloatSeq(LocalTensor<float>& dst, LocalTensor<T>& src, int32_t n)
+{
+    if constexpr (sizeof(T) == 4) {
+        for (int32_t i = 0; i < n; ++i) {
+            dst.SetValue(i, src.GetValue(i));
+        }
+    } else if constexpr (std::is_same<T, bfloat16_t>::value) {
+        for (int32_t i = 0; i < n; ++i) {
+            bfloat16_t v = src.GetValue(i);
+            uint16_t bits = *reinterpret_cast<uint16_t*>(&v);
+            const uint32_t wide = static_cast<uint32_t>(bits) << 16;
+            float f = 0.0f;
+            *reinterpret_cast<uint32_t*>(&f) = wide;
+            dst.SetValue(i, f);
+        }
+    } else {
+        Cast(dst, src, AscendC::RoundMode::CAST_NONE, n);
+    }
+    PipeBarrier<PIPE_V>();
+}
+
+template <typename T>
+__aicore__ inline void FromFloatSeq(LocalTensor<T>& dst, LocalTensor<float>& src, int32_t n)
+{
+    if constexpr (sizeof(T) == 4) {
+        for (int32_t i = 0; i < n; ++i) {
+            dst.SetValue(i, src.GetValue(i));
+        }
+    } else if constexpr (std::is_same<T, bfloat16_t>::value) {
+        for (int32_t i = 0; i < n; ++i) {
+            float f = src.GetValue(i);
+            uint32_t bits = *reinterpret_cast<uint32_t*>(&f);
+            bits += 0x7fffU + ((bits >> 16) & 1U);
+            const uint16_t b = static_cast<uint16_t>(bits >> 16);
+            bfloat16_t outv = *reinterpret_cast<bfloat16_t*>(const_cast<uint16_t*>(&b));
+            dst.SetValue(i, outv);
+        }
+    } else {
+        Cast(dst, src, AscendC::RoundMode::CAST_RINT, n);
+    }
+    PipeBarrier<PIPE_V>();
+}
+
+template <typename T>
+class UbLivenessKernel {
+public:
+    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias,
+                                GM_ADDR output, int64_t rows, int64_t dim, float epsilon,
+                                int64_t availableCoreNum)
+    {
+        rows_ = rows;
+        dim_ = static_cast<int32_t>(dim);
+        epsilon_ = epsilon;
+        invD_ = 1.0f / static_cast<float>(dim_);
+        elemBytes_ = static_cast<int32_t>(sizeof(T));
+
+        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
+        resGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual));
+        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
+        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias));
+        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output));
+
+        coreNum_ = GetBlockNum();
+        if (coreNum_ <= 0) {
+            coreNum_ = 1;
+        }
+        if (availableCoreNum > 0 && availableCoreNum < coreNum_) {
+            coreNum_ = static_cast<int32_t>(availableCoreNum);
+        }
+        coreId_ = GetBlockIdx();
+
+#if UB_LIVENESS_ALIAS
+        alias_ = true;
+#else
+        alias_ = false;
+#endif
+        PlanAndAlloc();
+
+        const int64_t per = (rows_ + coreNum_ - 1) / coreNum_;
+        row0_ = coreId_ * per;
+        row1_ = row0_ + per;
+        if (row1_ > rows_) {
+            row1_ = rows_;
+        }
+    }
+
+    __aicore__ inline void Run()
+    {
+        if (row0_ >= row1_) {
+            return;
+        }
+        if (fullParam_) { LoadFullParams(); }
+        ProcessTwoPass();
+    }
+
+private:
+    __aicore__ static int32_t EstBytes(int32_t tile, int32_t dim, int32_t elemBytes, int32_t dimF,
+                                       bool paramFull, bool d2, bool alias)
+    {
+        const int32_t slot = Align32(tile * elemBytes);
+        const int32_t tileF = Align32(tile * 4);
+        const int32_t nSlots = d2 ? 4 : 2;
+        const int32_t param = paramFull ? (2 * dimF) : (2 * tileF);
+        const int32_t reduce = kReduceWorkBytes;
+        if (alias) {
+            const int32_t pool = nSlots * slot + 2 * tileF;
+            return Align32(param + reduce) + Align32(pool);
+        }
+        int32_t b = param + reduce + (d2 ? 2 : 1) * slot * 3 + 2 * tileF;
+        return Align32(b);
+    }
+
+    __aicore__ inline void PlanAndAlloc()
+    {
+        const int32_t dimF = Align32(dim_ * 4);
+        const int32_t tileChoices[] = {2048, 1024, 512, 256, 128, 64};
+        fullParam_ = false;
+        depth2_ = true;
+        tile_ = dim_ < 64 ? dim_ : 64;
+
+        for (int32_t c : tileChoices) {
+            const int32_t t = (c > dim_) ? dim_ : c;
+            if (t < 64 && dim_ >= 64) {
+                continue;
+            }
+            if (EstBytes(t, dim_, elemBytes_, dimF, true, true, alias_) <= kUbBudgetBytes) {
+                tile_ = t;
+                fullParam_ = true;
+                depth2_ = true;
+                break;
+            }
+            if (EstBytes(t, dim_, elemBytes_, dimF, true, false, alias_) <= kUbBudgetBytes) {
+                tile_ = t;
+                fullParam_ = true;
+                depth2_ = false;
+                break;
+            }
+            if (EstBytes(t, dim_, elemBytes_, dimF, false, true, alias_) <= kUbBudgetBytes) {
+                tile_ = t;
+                fullParam_ = false;
+                depth2_ = true;
+                break;
+            }
+            if (EstBytes(t, dim_, elemBytes_, dimF, false, false, alias_) <= kUbBudgetBytes) {
+                tile_ = t;
+                fullParam_ = false;
+                depth2_ = false;
+                break;
+            }
+        }
+        if (tile_ > dim_) {
+            tile_ = dim_;
+        }
+        if (tile_ < 1) {
+            tile_ = 1;
+        }
+
+        slotBytes_ = Align32(tile_ * elemBytes_);
+        tileFBytes_ = Align32(tile_ * 4);
+        gElems_ = fullParam_ ? (Align32(dim_ * 4) / 4) : (tileFBytes_ / 4);
+        constexpr int32_t kRDst = 16;
+
+        if (alias_) {
+            const int32_t nNative = depth2_ ? 4 : 2;
+            const int32_t pool = nNative * slotBytes_ + 2 * tileFBytes_;
+            const int32_t anchor = 2 * (fullParam_ ? Align32(dim_ * 4) : tileFBytes_) + kRDst * 4 +
+                                   kReduceWorkBytes;
+            pipe_.InitBuffer(bufAnchor_, static_cast<uint32_t>(Align32(anchor)));
+            pipe_.InitBuffer(bufPool_, static_cast<uint32_t>(Align32(pool)));
+            LocalTensor<float> a = bufAnchor_.Get<float>();
+            gammaF_ = a;
+            biasF_ = a[gElems_];
+            reduceDst_ = a[2 * gElems_];
+            reduceWork_ = a[2 * gElems_ + kRDst];
+
+            LocalTensor<float> poolF = bufPool_.Get<float>();
+            LocalTensor<T> poolT = bufPool_.Get<T>();
+            x0_ = poolT;
+            x1_ = depth2_ ? poolT[slotBytes_ / elemBytes_] : x0_;
+            int32_t offB = (depth2_ ? 2 : 1) * slotBytes_;
+            res0_ = poolT[offB / elemBytes_];
+            res1_ = depth2_ ? poolT[(offB + slotBytes_) / elemBytes_] : res0_;
+            offB += (depth2_ ? 2 : 1) * slotBytes_;
+            formF_ = poolF[offB / 4];
+            mulF_ = poolF[(offB + tileFBytes_) / 4];
+            // alias mode: emit stages through ingest x-slot bytes
+            out0_ = x0_;
+            out1_ = x1_;
+        } else {
+            int32_t pBytes = fullParam_ ? (2 * Align32(dim_ * 4)) : (2 * tileFBytes_);
+            pipe_.InitBuffer(bufParam_, static_cast<uint32_t>(Align32(pBytes)));
+            pipe_.InitBuffer(bufTmp_, static_cast<uint32_t>(kRDst * 4 + kReduceWorkBytes));
+            pipe_.InitBuffer(bufX_, static_cast<uint32_t>((depth2_ ? 2 : 1) * slotBytes_));
+            pipe_.InitBuffer(bufRes_, static_cast<uint32_t>((depth2_ ? 2 : 1) * slotBytes_));
+            pipe_.InitBuffer(bufOut_, static_cast<uint32_t>((depth2_ ? 2 : 1) * slotBytes_));
+            pipe_.InitBuffer(bufScratch_, static_cast<uint32_t>(Align32(2 * tileFBytes_)));
+            LocalTensor<float> p = bufParam_.Get<float>();
+            gammaF_ = p;
+            biasF_ = p[gElems_];
+            reduceDst_ = bufTmp_.Get<float>();
+            reduceWork_ = bufTmp_.Get<float>()[kRDst];
+            x0_ = bufX_.Get<T>();
+            x1_ = depth2_ ? x0_[slotBytes_ / elemBytes_] : x0_;
+            res0_ = bufRes_.Get<T>();
+            res1_ = depth2_ ? res0_[slotBytes_ / elemBytes_] : res0_;
+            out0_ = bufOut_.Get<T>();
+            out1_ = depth2_ ? out0_[slotBytes_ / elemBytes_] : out0_;
+            LocalTensor<float> sc = bufScratch_.Get<float>();
+            formF_ = sc;
+            mulF_ = sc[tileFBytes_ / 4];
+        }
+    }
+
+    __aicore__ inline void LoadFullParams()
+    {
+        LocalTensor<T> stage = out0_;
+        for (int32_t off = 0; off < dim_; off += tile_) {
+            int32_t n = dim_ - off;
+            if (n > tile_) {
+                n = tile_;
+            }
+            CopyInPad(stage, gammaGm_, off, n);
+            LocalTensor<float> gDst = gammaF_[off];
+            ToFloatSeq(gDst, stage, n);
+            CopyInPad(stage, biasGm_, off, n);
+            LocalTensor<float> bDst = biasF_[off];
+            ToFloatSeq(bDst, stage, n);
+        }
+    }
+
+    __aicore__ inline void LoadParamChunk(int32_t off, int32_t n)
+    {
+        if (fullParam_) {
+            return;
+        }
+        LocalTensor<T> stage = out0_;
+        CopyInPad(stage, gammaGm_, off, n);
+        ToFloatSeq(gammaF_, stage, n);
+        CopyInPad(stage, biasGm_, off, n);
+        ToFloatSeq(biasF_, stage, n);
+    }
+
+    __aicore__ inline float SumSq(LocalTensor<float>& u, int32_t n)
+    {
+        float acc = 0.0f;
+        for (int32_t i = 0; i < n; ++i) {
+            const float v = u.GetValue(i);
+            acc += v * v;
+        }
+        return acc;
+    }
+
+    __aicore__ inline float InvRms(float acc)
+    {
+        const float meanTerm = acc * invD_ + epsilon_;
+        Duplicate(reduceDst_, meanTerm, 1);
+        Sqrt(reduceDst_, reduceDst_, 1);
+        SetFlag<HardEvent::V_S>(kEventV2S);
+        WaitFlag<HardEvent::V_S>(kEventV2S);
+        const float rms = reduceDst_.GetValue(0);
+        SetFlag<HardEvent::S_V>(kEventS2V);
+        WaitFlag<HardEvent::S_V>(kEventS2V);
+        return acc; //DBG
+    }
+
+    // u in uTile (formF_); params in gammaF_/biasF_; results in mulF_ then outStage.
+    __aicore__ inline void EmitTile(LocalTensor<T>& outStage, LocalTensor<float>& uTile, float inv,
+                                    int32_t off, int32_t n)
+    {
+        LoadParamChunk(off, n);
+        LocalTensor<float> gSeg = fullParam_ ? gammaF_[off] : gammaF_;
+        LocalTensor<float> bSeg = fullParam_ ? biasF_[off] : biasF_;
+        for (int32_t i = 0; i < n; ++i) {
+            const float o = uTile.GetValue(i) * inv * gSeg.GetValue(i) + bSeg.GetValue(i);
+            mulF_.SetValue(i, o);
+        }
+        FromFloatSeq(outStage, mulF_, n);
+    }
+
+    __aicore__ inline void ProcessTwoPass()
+    {
+        // Warmup: first DataCopyPad after InitBuffer can race scalar reads on some toolchains.
+        {
+            LocalTensor<T> xs = x0_;
+            LocalTensor<T> rs = res0_;
+            CopyInPad(xs, xGm_, 0, dim_ < tile_ ? dim_ : tile_);
+            CopyInPad(rs, resGm_, 0, dim_ < tile_ ? dim_ : tile_);
+        }
+        for (int64_t r = row0_; r < row1_; ++r) {
+            const int64_t base = r * static_cast<int64_t>(dim_);
+
+            // Pass1: fuse+sum from xs,rs directly
+            float acc = 0.0f;
+            int32_t flip = 0;
+            for (int32_t off = 0; off < dim_; off += tile_) {
+                int32_t n = dim_ - off;
+                if (n > tile_) {
+                    n = tile_;
+                }
+                LocalTensor<T> xs = (flip == 0) ? x0_ : x1_;
+                LocalTensor<T> rs = (flip == 0) ? res0_ : res1_;
+                CopyInPad(xs, xGm_, base + off, n);
+                CopyInPad(rs, resGm_, base + off, n);
+                if constexpr (sizeof(T) == 4) {
+                    for (int32_t i = 0; i < n; ++i) {
+                        const float u = xs.GetValue(i) + rs.GetValue(i);
+                        acc += u * u;
+                    }
+                } else {
+                    ToFloatSeq(formF_, xs, n);
+                    ToFloatSeq(mulF_, rs, n);
+                    for (int32_t i = 0; i < n; ++i) {
+                        const float u = formF_.GetValue(i) + mulF_.GetValue(i);
+                        acc += u * u;
+                    }
+                }
+                flip ^= 1;
+            }
+
+            const float meanTerm = acc * invD_ + epsilon_;
+            Duplicate(reduceDst_, meanTerm, 1);
+            Sqrt(reduceDst_, reduceDst_, 1);
+            SetFlag<HardEvent::V_S>(kEventV2S);
+            WaitFlag<HardEvent::V_S>(kEventV2S);
+            const float rms = reduceDst_.GetValue(0);
+            SetFlag<HardEvent::S_V>(kEventS2V);
+            WaitFlag<HardEvent::S_V>(kEventS2V);
+            const float inv = 1.0f / rms;
+
+            // Pass2: fuse into formF_, emit with params
+            flip = 0;
+            for (int32_t off = 0; off < dim_; off += tile_) {
+                int32_t n = dim_ - off;
+                if (n > tile_) {
+                    n = tile_;
+                }
+                LocalTensor<T> xs = (flip == 0) ? x0_ : x1_;
+                LocalTensor<T> rs = (flip == 0) ? res0_ : res1_;
+                CopyInPad(xs, xGm_, base + off, n);
+                CopyInPad(rs, resGm_, base + off, n);
+                if constexpr (sizeof(T) == 4) {
+                    for (int32_t i = 0; i < n; ++i) {
+                        formF_.SetValue(i, xs.GetValue(i) + rs.GetValue(i));
+                    }
+                } else {
+                    ToFloatSeq(formF_, xs, n);
+                    ToFloatSeq(mulF_, rs, n);
+                    for (int32_t i = 0; i < n; ++i) {
+                        formF_.SetValue(i, formF_.GetValue(i) + mulF_.GetValue(i));
+                    }
+                }
+                LoadParamChunk(off, n);
+                LocalTensor<float> gSeg = fullParam_ ? gammaF_[off] : gammaF_;
+                LocalTensor<float> bSeg = fullParam_ ? biasF_[off] : biasF_;
+                for (int32_t i = 0; i < n; ++i) {
+                    mulF_.SetValue(i, formF_.GetValue(i) * inv * gSeg.GetValue(i) + bSeg.GetValue(i));
+                }
+                LocalTensor<T> outStage = alias_ ? xs : ((flip == 0) ? out0_ : out1_);
+                FromFloatSeq(outStage, mulF_, n);
+                CopyOutPad(outGm_, outStage, base + off, n);
+                flip ^= 1;
+            }
+        }
+    }
+
+    TPipe pipe_;
+    TBuf<> bufAnchor_, bufPool_;
+    TBuf<> bufParam_, bufTmp_, bufX_, bufRes_, bufOut_, bufScratch_;
+
+    GlobalTensor<T> xGm_, resGm_, gammaGm_, biasGm_, outGm_;
+    LocalTensor<float> gammaF_, biasF_, reduceDst_, reduceWork_, formF_, mulF_;
+    LocalTensor<T> x0_, x1_, res0_, res1_, out0_, out1_;
+
+    int64_t rows_ = 0;
+    int32_t dim_ = 0;
+    int32_t tile_ = 64;
+    int32_t slotBytes_ = 0;
+    int32_t tileFBytes_ = 0;
+    int32_t elemBytes_ = 2;
+    int32_t gElems_ = 0;
+    int32_t coreNum_ = 1;
+    int32_t coreId_ = 0;
+    int64_t row0_ = 0;
+    int64_t row1_ = 0;
+    float epsilon_ = 1e-5f;
+    float invD_ = 1.0f;
+    bool alias_ = true;
+    bool fullParam_ = false;
+    bool depth2_ = true;
+};
+
+template <typename T>
+__aicore__ void Entry(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
+                      int64_t rows, int64_t dim, float epsilon, int64_t availableCoreNum)
+{
+    UbLivenessKernel<T> k;
+    k.Init(x, residual, gamma, bias, output, rows, dim, epsilon, availableCoreNum);
+    k.Run();
+}
+
+extern "C" __global__ __vector__ void ub_liveness_fp32(
+    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, int64_t rows,
+    int64_t dim, float epsilon, int64_t availableCoreNum)
+{
+    Entry<float>(x, residual, gamma, bias, output, rows, dim, epsilon, availableCoreNum);
+}
+
+extern "C" __global__ __vector__ void ub_liveness_fp16(
+    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, int64_t rows,
+    int64_t dim, float epsilon, int64_t availableCoreNum)
+{
+    Entry<half>(x, residual, gamma, bias, output, rows, dim, epsilon, availableCoreNum);
+}
+
+extern "C" __global__ __vector__ void ub_liveness_bf16(
+    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, int64_t rows,
+    int64_t dim, float epsilon, int64_t availableCoreNum)
+{
+    Entry<bfloat16_t>(x, residual, gamma, bias, output, rows, dim, epsilon, availableCoreNum);
+}
+
+extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
+                           const TensorGroupInfo& info_residual, GM_ADDR gamma,
+                           const TensorGroupInfo& info_gamma, GM_ADDR bias,
+                           const TensorGroupInfo& info_bias, GM_ADDR output,
+                           const TensorGroupInfo& info_output, int64_t availableCoreNum,
+                           aclrtStream stream, float epsilon)
+{
+    (void)info_residual;
+    (void)info_gamma;
+    (void)info_bias;
+    (void)info_output;
+    if (info_x.tensors == nullptr || info_x.numTensors < 1) {
+        return;
+    }
+    const TensorInfo& tx = info_x.tensors[0];
+    if (tx.numDims < 2 || tx.shape == nullptr) {
+        return;
+    }
+    int64_t rows = 1;
+    for (int64_t i = 0; i + 1 < tx.numDims; ++i) {
+        if (tx.shape[i] <= 0) {
+            return;
+        }
+        rows *= tx.shape[i];
+    }
+    const int64_t dim = tx.shape[tx.numDims - 1];
+    if (dim <= 0 || rows <= 0) {
+        return;
+    }
+
+    const int32_t dtype = NormalizeDtype(tx.dtype);
+    int64_t blocks = availableCoreNum > 0 ? availableCoreNum : 1;
+    if (blocks > rows) {
+        blocks = rows;
+    }
+    if (blocks < 1) {
+        blocks = 1;
+    }
+
+    if (dtype == kDtypeF32) {
+        ub_liveness_fp32<<<blocks, nullptr, stream>>>(x, residual, gamma, bias, output, rows, dim,
+                                                      epsilon, blocks);
+    } else if (dtype == kDtypeF16) {
+        ub_liveness_fp16<<<blocks, nullptr, stream>>>(x, residual, gamma, bias, output, rows, dim,
+                                                      epsilon, blocks);
+    } else if (dtype == kDtypeBF16) {
+        ub_liveness_bf16<<<blocks, nullptr, stream>>>(x, residual, gamma, bias, output, rows, dim,
+                                                      epsilon, blocks);
+    }
+}
