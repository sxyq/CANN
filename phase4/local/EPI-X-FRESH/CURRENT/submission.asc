#include "kernel_operator.h"
#include "epi_x_fresh_tiling.h"

namespace {

constexpr uint32_t kMaxVectorCores = 40;
constexpr uint32_t kRowsPerGroup = 8;

template <typename T>
class EpiXFreshKernel {
public:
    static constexpr uint32_t kChunk = (sizeof(T) == sizeof(float)) ? 3072 : 4096;
    static constexpr uint32_t kElemsPer32B = 32 / sizeof(T);
    static constexpr uint32_t kWorkFloats = 7 * kChunk + 2 * kRowsPerGroup * 8 + 8;

    __aicore__ inline EpiXFreshKernel(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias,
        GM_ADDR output, const __gm__ EpiXFreshTilingData* tiling)
    {
        tiling_ = tiling;
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t rowBegin = blockIdx * tiling_->rowsPerBlock;
        rowCount_ = (blockIdx + 1 == tiling_->blockNum)
            ? (tiling_->rows - rowBegin) : tiling_->rowsPerBlock;
        d_ = tiling_->d;
        invD_ = tiling_->invD;
        epsilon_ = tiling_->epsilon;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) +
            static_cast<uint64_t>(rowBegin) * d_, static_cast<uint64_t>(rowCount_) * d_);
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual) +
            static_cast<uint64_t>(rowBegin) * d_, static_cast<uint64_t>(rowCount_) * d_);
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma), d_);
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias), d_);
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output) +
            static_cast<uint64_t>(rowBegin) * d_, static_cast<uint64_t>(rowCount_) * d_);

        pipe_->InitBuffer(xQueue_, 1, kChunk * sizeof(T));
        pipe_->InitBuffer(residualQueue_, 1, kChunk * sizeof(T));
        pipe_->InitBuffer(paramQueue_, 1, 2 * kChunk * sizeof(T));
        pipe_->InitBuffer(outputQueue_, 1, kChunk * sizeof(T));
        pipe_->InitBuffer(workBuffer_, kWorkFloats * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        auto work = workBuffer_.Get<float>();
        auto xFloat = work[0 * kChunk];
        auto residualFloat = work[1 * kChunk];
        auto uFloat = work[2 * kChunk];
        auto squareFloat = work[3 * kChunk];
        auto gammaFloat = work[4 * kChunk];
        auto biasFloat = work[5 * kChunk];
        auto reduceTmp = work[6 * kChunk];
        auto sumVectors = work[7 * kChunk];
        auto invVectors = sumVectors[2 * kRowsPerGroup * 8];
        auto partial = invVectors[2 * kRowsPerGroup * 8];

        for (uint32_t groupBegin = 0; groupBegin < rowCount_; groupBegin += kRowsPerGroup) {
            const uint32_t groupRows = (rowCount_ - groupBegin < kRowsPerGroup)
                ? (rowCount_ - groupBegin) : kRowsPerGroup;
            AscendC::Duplicate(sumVectors, 0.0f, kRowsPerGroup * 8);

            for (uint32_t offset = 0; offset < d_; offset += kChunk) {
                const uint32_t count = (d_ - offset < kChunk) ? (d_ - offset) : kChunk;
                const uint32_t alignedCount = Align32(count);
                LoadParameters(offset, count, alignedCount, gammaFloat, biasFloat);

                for (uint32_t row = 0; row < groupRows; ++row) {
                    LoadInputs(groupBegin + row, offset, count, alignedCount);
                    auto xLocal = xQueue_.DeQue<T>();
                    auto residualLocal = residualQueue_.DeQue<T>();
                    ToFloat(xFloat, xLocal, count);
                    ToFloat(residualFloat, residualLocal, count);
                    AscendC::Add(uFloat, xFloat, residualFloat, static_cast<int32_t>(count));
                    AscendC::Mul(squareFloat, uFloat, uFloat, static_cast<int32_t>(count));
                    AscendC::ReduceSum(partial, squareFloat, reduceTmp, static_cast<int32_t>(count));
                    AscendC::Add(sumVectors[row * 8], sumVectors[row * 8], partial, 1);
                    xQueue_.FreeTensor(xLocal);
                    residualQueue_.FreeTensor(residualLocal);
                }
            }

            for (uint32_t row = 0; row < groupRows; ++row) {
                AscendC::Muls(partial, sumVectors[row * 8], invD_, 1);
                AscendC::Adds(partial, partial, epsilon_, 1);
                AscendC::Rsqrt(invVectors[row * 8], partial, 1);
                const int32_t eventIdVToS = pipe_->FetchEventID(AscendC::HardEvent::V_S);
                AscendC::SetFlag<AscendC::HardEvent::V_S>(eventIdVToS);
                AscendC::WaitFlag<AscendC::HardEvent::V_S>(eventIdVToS);
            }

            for (uint32_t offset = 0; offset < d_; offset += kChunk) {
                const uint32_t count = (d_ - offset < kChunk) ? (d_ - offset) : kChunk;
                const uint32_t alignedCount = Align32(count);
                LoadParameters(offset, count, alignedCount, gammaFloat, biasFloat);

                for (uint32_t row = 0; row < groupRows; ++row) {
                    LoadInputs(groupBegin + row, offset, count, alignedCount);
                    auto xLocal = xQueue_.DeQue<T>();
                    auto residualLocal = residualQueue_.DeQue<T>();
                    ToFloat(xFloat, xLocal, count);
                    ToFloat(residualFloat, residualLocal, count);
                    if (alignedCount > count) {
                        AscendC::Duplicate(uFloat, 0.0f, static_cast<int32_t>(alignedCount));
                    }
                    AscendC::Add(uFloat, xFloat, residualFloat, static_cast<int32_t>(count));
                    const float inv = invVectors.GetValue(row * 8);
                    AscendC::Duplicate(reduceTmp, inv, static_cast<int32_t>(count));
                    AscendC::Mul(uFloat, uFloat, reduceTmp, static_cast<int32_t>(count));
                    AscendC::Mul(uFloat, uFloat, gammaFloat, static_cast<int32_t>(count));
                    AscendC::Add(uFloat, uFloat, biasFloat, static_cast<int32_t>(count));
                    StoreOutput(groupBegin + row, offset, count, alignedCount, uFloat);
                    xQueue_.FreeTensor(xLocal);
                    residualQueue_.FreeTensor(residualLocal);
                }
            }
        }
    }

private:
    __aicore__ inline uint32_t Align32(uint32_t count) const
    {
        return (count + kElemsPer32B - 1) / kElemsPer32B * kElemsPer32B;
    }

    __aicore__ inline void LoadInputs(uint32_t row, uint32_t offset,
        uint32_t count, uint32_t alignedCount)
    {
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};
        auto xLocal = xQueue_.AllocTensor<T>();
        auto residualLocal = residualQueue_.AllocTensor<T>();
        const uint64_t rowOffset = static_cast<uint64_t>(row) * d_ + offset;
        AscendC::DataCopyPad(xLocal, xGm_[rowOffset], copyParams, padParams);
        AscendC::DataCopyPad(residualLocal, residualGm_[rowOffset], copyParams, padParams);
        xQueue_.EnQue(xLocal);
        residualQueue_.EnQue(residualLocal);
    }

    __aicore__ inline void LoadParameters(uint32_t offset, uint32_t count,
        uint32_t alignedCount, const AscendC::LocalTensor<float>& gammaFloat,
        const AscendC::LocalTensor<float>& biasFloat)
    {
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};
        auto params = paramQueue_.AllocTensor<T>();
        AscendC::DataCopyPad(params, gammaGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(params[kChunk], biasGm_[offset], copyParams, padParams);
        paramQueue_.EnQue(params);
        auto paramsLocal = paramQueue_.DeQue<T>();
        if constexpr (sizeof(T) == sizeof(float)) {
            AscendC::DataCopy(gammaFloat, paramsLocal, alignedCount);
            AscendC::DataCopy(biasFloat, paramsLocal[kChunk], alignedCount);
        } else {
            AscendC::Cast(gammaFloat, paramsLocal, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Cast(biasFloat, paramsLocal[kChunk], AscendC::RoundMode::CAST_NONE, count);
        }
        paramQueue_.FreeTensor(paramsLocal);
    }

    __aicore__ inline void ToFloat(const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<T>& src, uint32_t count)
    {
        if constexpr (sizeof(T) == sizeof(float)) {
            AscendC::DataCopy(dst, src, count);
        } else {
            AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
        }
    }

    __aicore__ inline void StoreOutput(uint32_t row, uint32_t offset, uint32_t count,
        uint32_t alignedCount, const AscendC::LocalTensor<float>& src)
    {
        auto outputLocal = outputQueue_.AllocTensor<T>();
        if constexpr (sizeof(T) == sizeof(float)) {
            AscendC::DataCopy(outputLocal, src, alignedCount);
        } else {
            AscendC::Cast(outputLocal, src, AscendC::RoundMode::CAST_ROUND, alignedCount);
        }
        outputQueue_.EnQue(outputLocal);
        auto outputReady = outputQueue_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const uint64_t rowOffset = static_cast<uint64_t>(row) * d_ + offset;
        AscendC::DataCopyPad(outputGm_[rowOffset], outputReady, copyParams);
        outputQueue_.FreeTensor(outputReady);
    }

    AscendC::TPipe* pipe_;
    const __gm__ EpiXFreshTilingData* tiling_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> residualGm_;
    AscendC::GlobalTensor<T> gammaGm_;
    AscendC::GlobalTensor<T> biasGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> residualQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> paramQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workBuffer_;
    uint32_t rowCount_ = 0;
    uint32_t d_ = 0;
    float invD_ = 0.0f;
    float epsilon_ = 0.0f;
};

}  // namespace

extern "C" __global__ __vector__ void epi_x_fresh_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, GM_ADDR tiling)
{
    auto* data = reinterpret_cast<__gm__ EpiXFreshTilingData*>(tiling);
    AscendC::TPipe pipe;
    if (data->dtype == 0) {
        EpiXFreshKernel<half> op(&pipe);
        op.Init(x, residual, gamma, bias, output, data);
        op.Process();
    } else if (data->dtype == 1) {
        EpiXFreshKernel<bfloat16_t> op(&pipe);
        op.Init(x, residual, gamma, bias, output, data);
        op.Process();
    } else {
        EpiXFreshKernel<float> op(&pipe);
        op.Init(x, residual, gamma, bias, output, data);
        op.Process();
    }
}
