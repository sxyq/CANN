#include <cmath>
#include "kernel_operator.h"

// MID-X V002 — mid multi-row batch, correctness-first revision.
// V001 online: mid speed real (T04/T07), numerics broken.
// V002 fixes:
//   (1) ~75% WA: ReduceSum dest was sumSq[r] (misaligned). Always reduce into
//       an 8-slot/32B-aligned scalar, GetValue immediately, host invRms.
//   (2) 4-13% WA: DataCopyPad rightPadding in bytes (32B remainder), mean uses
//       invD on d_ only, pad zeros never enter reduce counts.
//   (3) T15 RE: generic path is single-block, small tile, conservative UB;
//       out-of-mid-domain forced to generic.

namespace mid_x_v002 {

constexpr uint32_t kUbBudget = 184U * 1024U;
constexpr uint32_t kReduceTmpBytes = 8U * 1024U;
constexpr uint32_t kMaxBatch = 32U;
constexpr uint32_t kMidMaxD = 4096U;
constexpr uint32_t kGenericTile = 256U;
constexpr int32_t kDtypeFp32 = 0;
constexpr int32_t kDtypeFp16 = 1;
constexpr int32_t kDtypeBf16 = 2;

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline uint32_t Align32(uint32_t bytes)
{
    return (bytes + 31U) & ~31U;
}

__aicore__ inline uint8_t RightPadBytes(uint32_t bytes)
{
    const uint32_t rem = bytes % 32U;
    return rem == 0U ? static_cast<uint8_t>(0) : static_cast<uint8_t>(32U - rem);
}

template <typename T>
__aicore__ inline void CopyInPad(AscendC::LocalTensor<T> dst, AscendC::GlobalTensor<T> src, uint32_t len)
{
    const uint32_t bytes = len * static_cast<uint32_t>(sizeof(T));
    AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
    const uint8_t rpad = RightPadBytes(bytes);
    AscendC::DataCopyPadExtParams<T> padParams;
    padParams.isPad = (rpad != 0);
    padParams.leftPadding = 0;
    padParams.rightPadding = rpad;
    padParams.paddingValue = static_cast<T>(0);
    AscendC::DataCopyPad(dst, src, copyParams, padParams);
}

template <typename T>
__aicore__ inline void CopyOutPad(AscendC::GlobalTensor<T> dst, AscendC::LocalTensor<T> src, uint32_t len)
{
    const uint32_t bytes = len * static_cast<uint32_t>(sizeof(T));
    AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
    AscendC::DataCopyPad(dst, src, copyParams);
}

template <typename T>
__aicore__ inline void CopyInRows(AscendC::LocalTensor<T> dst, AscendC::GlobalTensor<T> src,
    uint32_t rowBegin, uint32_t rowCount, uint32_t cols, uint32_t colsPad)
{
    for (uint32_t r = 0; r < rowCount; ++r) {
        AscendC::LocalTensor<T> dstRow = dst[r * colsPad];
        AscendC::GlobalTensor<T> srcRow = src[static_cast<uint64_t>(rowBegin + r) * cols];
        CopyInPad<T>(dstRow, srcRow, cols);
    }
}

template <typename T>
__aicore__ inline void CopyOutRows(AscendC::GlobalTensor<T> dst, AscendC::LocalTensor<T> src,
    uint32_t rowBegin, uint32_t rowCount, uint32_t cols, uint32_t colsPad)
{
    for (uint32_t r = 0; r < rowCount; ++r) {
        AscendC::GlobalTensor<T> dstRow = dst[static_cast<uint64_t>(rowBegin + r) * cols];
        AscendC::LocalTensor<T> srcRow = src[r * colsPad];
        CopyOutPad<T>(dstRow, srcRow, cols);
    }
}

template <typename T>
struct TypeOps {
    __aicore__ inline static void ToFloat(AscendC::LocalTensor<float> dst, AscendC::LocalTensor<T> src,
        uint32_t count)
    {
        AscendC::Cast<float, T>(dst, src, AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(count));
    }
    __aicore__ inline static void FromFloat(AscendC::LocalTensor<T> dst, AscendC::LocalTensor<float> src,
        uint32_t count)
    {
        AscendC::Cast<T, float>(dst, src, AscendC::RoundMode::CAST_RINT, static_cast<int32_t>(count));
    }
};

template <>
struct TypeOps<float> {
    __aicore__ inline static void ToFloat(AscendC::LocalTensor<float> dst, AscendC::LocalTensor<float> src,
        uint32_t count)
    {
        AscendC::Adds(dst, src, 0.0f, static_cast<int32_t>(count));
    }
    __aicore__ inline static void FromFloat(AscendC::LocalTensor<float> dst, AscendC::LocalTensor<float> src,
        uint32_t count)
    {
        AscendC::Adds(dst, src, 0.0f, static_cast<int32_t>(count));
    }
};

// ReduceSum destination must stay 32B / 8-slot aligned. Always write slot 0.
__aicore__ inline float AlignedSumSq(AscendC::LocalTensor<float> sq, AscendC::LocalTensor<float> scalar,
    AscendC::LocalTensor<float> reduceTmp, uint32_t count)
{
    AscendC::ReduceSum<float, true>(scalar, sq, reduceTmp, static_cast<int32_t>(count));
    AscendC::PipeBarrier<PIPE_V>();
    return scalar.GetValue(0);
}

// Device-safe invRms = rsqrt(mean + eps) via 1-element Rsqrt (no sqrtf in __aicore__).
__aicore__ inline float InvRmsFromSum(float sumSq, float invD, float epsilon,
    AscendC::LocalTensor<float> scalar)
{
    scalar.SetValue(0, sumSq * invD + epsilon);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Rsqrt<float>(scalar, scalar, 1);
    AscendC::PipeBarrier<PIPE_V>();
    return scalar.GetValue(0);
}

inline uint32_t PickBatch(uint32_t colsPad, uint32_t elemSize, uint32_t maxBatch)
{
    // depth-2 x/res/out + one FP32 u row. Conservative fixed overhead.
    const unsigned long long perRow =
        6ULL * colsPad * elemSize + static_cast<unsigned long long>(colsPad) * 4ULL;
    const unsigned long long fixed =
        static_cast<unsigned long long>(colsPad) * 12ULL + kReduceTmpBytes + 1024ULL;
    if (perRow == 0) {
        return 1U;
    }
    // 25% headroom against InitBuffer rounding / TQue slot align.
    unsigned long long room = (static_cast<unsigned long long>(kUbBudget) * 3ULL) / 4ULL;
    if (room <= fixed) {
        return 1U;
    }
    room -= fixed;
    unsigned long long batch = room / perRow;
    if (batch < 1ULL) {
        batch = 1ULL;
    }
    if (batch > maxBatch) {
        batch = maxBatch;
    }
    return static_cast<uint32_t>(batch);
}

inline bool MidDomain(uint32_t d, uint32_t elemSize)
{
    if (d == 0 || d > kMidMaxD) {
        return false;
    }
    const uint32_t colsPad = ((d * elemSize + 31U) / 32U * 32U) / elemSize;
    const unsigned long long uBytes = static_cast<unsigned long long>(colsPad) * 4ULL;
    const unsigned long long queueBytes = 6ULL * colsPad * elemSize;
    const unsigned long long fixed = static_cast<unsigned long long>(colsPad) * 12ULL + kReduceTmpBytes + 1024ULL;
    return (uBytes + queueBytes + fixed) <= ((static_cast<unsigned long long>(kUbBudget) * 3ULL) / 4ULL);
}

template <typename T>
class MidBatchKernel {
public:
    __aicore__ inline MidBatchKernel(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
        uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores, uint32_t batchRows)
    {
        rows_ = rows;
        d_ = d;
        epsilon_ = epsilon;
        invD_ = invD;
        usedCores_ = usedCores == 0 ? 1U : usedCores;
        colsPad_ = ((d_ * static_cast<uint32_t>(sizeof(T)) + 31U) / 32U * 32U) / static_cast<uint32_t>(sizeof(T));
        if (colsPad_ < d_) {
            colsPad_ = d_;
        }
        batch_ = batchRows == 0 ? 1U : MinU32(batchRows, kMaxBatch);

        const uint32_t block = AscendC::GetBlockIdx();
        const uint32_t base = rows_ / usedCores_;
        const uint32_t extra = rows_ % usedCores_;
        firstRow_ = block * base + (block < extra ? block : extra);
        rowsThisCore_ = base + (block < extra ? 1U : 0U);

        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), static_cast<uint64_t>(rows_) * d_);
        res_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual), static_cast<uint64_t>(rows_) * d_);
        gam_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma), d_);
        biasG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias), d_);
        out_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), static_cast<uint64_t>(rows_) * d_);

        const uint32_t tBytes = static_cast<uint32_t>(sizeof(T));
        const uint32_t rowT = Align32(colsPad_ * tBytes);
        const uint32_t rowF = Align32(colsPad_ * sizeof(float));
        pipe_->InitBuffer(xQue_, 2, batch_ * rowT);
        pipe_->InitBuffer(resQue_, 2, batch_ * rowT);
        pipe_->InitBuffer(outQue_, 2, batch_ * rowT);
        pipe_->InitBuffer(uBuf_, batch_ * rowF);
        pipe_->InitBuffer(workBuf_, rowF);
        pipe_->InitBuffer(gammaF_, rowF);
        pipe_->InitBuffer(biasF_, rowF);
        pipe_->InitBuffer(scalarBuf_, 32);  // 8 x FP32: ReduceSum dest alignment
        pipe_->InitBuffer(reduceTmp_, kReduceTmpBytes);
    }

    __aicore__ inline void Process()
    {
        if (rowsThisCore_ == 0) {
            return;
        }
        LoadParams();
        AscendC::LocalTensor<float> gammaF = gammaF_.Get<float>();
        AscendC::LocalTensor<float> biasF = biasF_.Get<float>();
        AscendC::LocalTensor<float> uAll = uBuf_.Get<float>();
        AscendC::LocalTensor<float> work = workBuf_.Get<float>();
        AscendC::LocalTensor<float> scalar = scalarBuf_.Get<float>();
        AscendC::LocalTensor<float> reduceTmp = reduceTmp_.Get<float>();

        for (uint32_t batchBegin = 0; batchBegin < rowsThisCore_; batchBegin += batch_) {
            const uint32_t tileRows = MinU32(batch_, rowsThisCore_ - batchBegin);
            const uint32_t absRow = firstRow_ + batchBegin;

            AscendC::LocalTensor<T> xAlloc = xQue_.AllocTensor<T>();
            AscendC::LocalTensor<T> rAlloc = resQue_.AllocTensor<T>();
            CopyInRows<T>(xAlloc, x_, absRow, tileRows, d_, colsPad_);
            CopyInRows<T>(rAlloc, res_, absRow, tileRows, d_, colsPad_);
            xQue_.EnQue(xAlloc);
            resQue_.EnQue(rAlloc);
            AscendC::LocalTensor<T> xLoc = xQue_.DeQue<T>();
            AscendC::LocalTensor<T> rLoc = resQue_.DeQue<T>();
            AscendC::LocalTensor<T> oAlloc = outQue_.AllocTensor<T>();

            // Single pass: u -> aligned sum -> invRms -> apply. One GetValue pair per row.
            for (uint32_t r = 0; r < tileRows; ++r) {
                AscendC::LocalTensor<float> uRow = uAll[r * colsPad_];
                AscendC::LocalTensor<T> xRow = xLoc[r * colsPad_];
                AscendC::LocalTensor<T> rRow = rLoc[r * colsPad_];
                AscendC::LocalTensor<T> oRow = oAlloc[r * colsPad_];
                if constexpr (sizeof(T) == 4) {
                    AscendC::LocalTensor<float> xF = xRow;
                    AscendC::LocalTensor<float> rF = rRow;
                    AscendC::Add<float>(uRow, xF, rF, static_cast<int32_t>(d_));
                } else {
                    TypeOps<T>::ToFloat(work, xRow, d_);
                    TypeOps<T>::ToFloat(uRow, rRow, d_);
                    AscendC::Add<float>(uRow, uRow, work, static_cast<int32_t>(d_));
                }
                AscendC::Mul<float>(work, uRow, uRow, static_cast<int32_t>(d_));
                const float sumSq = AlignedSumSq(work, scalar, reduceTmp, d_);
                const float invRms = InvRmsFromSum(sumSq, invD_, epsilon_, scalar);
                AscendC::Muls<float>(uRow, uRow, invRms, static_cast<int32_t>(d_));
                AscendC::Mul<float>(uRow, uRow, gammaF, static_cast<int32_t>(d_));
                AscendC::Add<float>(uRow, uRow, biasF, static_cast<int32_t>(d_));
                TypeOps<T>::FromFloat(oRow, uRow, d_);
            }
            outQue_.EnQue(oAlloc);
            AscendC::LocalTensor<T> oLoc = outQue_.DeQue<T>();
            CopyOutRows<T>(out_, oLoc, absRow, tileRows, d_, colsPad_);
            outQue_.FreeTensor(oLoc);
            xQue_.FreeTensor(xLoc);
            resQue_.FreeTensor(rLoc);
        }
    }

private:
    __aicore__ inline void LoadParams()
    {
        AscendC::LocalTensor<T> gAlloc = xQue_.AllocTensor<T>();
        AscendC::LocalTensor<T> bAlloc = resQue_.AllocTensor<T>();
        CopyInPad<T>(gAlloc, gam_, d_);
        CopyInPad<T>(bAlloc, biasG_, d_);
        xQue_.EnQue(gAlloc);
        resQue_.EnQue(bAlloc);
        AscendC::LocalTensor<T> gLoc = xQue_.DeQue<T>();
        AscendC::LocalTensor<T> bLoc = resQue_.DeQue<T>();
        TypeOps<T>::ToFloat(gammaF_.Get<float>(), gLoc, d_);
        TypeOps<T>::ToFloat(biasF_.Get<float>(), bLoc, d_);
        xQue_.FreeTensor(gLoc);
        resQue_.FreeTensor(bLoc);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> x_, res_, gam_, biasG_, out_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> xQue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> resQue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> uBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> biasF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scalarBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceTmp_;
    uint32_t rows_{0};
    uint32_t d_{0};
    float epsilon_{1e-5f};
    float invD_{1.f};
    uint32_t usedCores_{1};
    uint32_t colsPad_{0};
    uint32_t batch_{1};
    uint32_t firstRow_{0};
    uint32_t rowsThisCore_{0};
};

// Full-domain generic: single block, small tile, no shared ReduceSum dest aliasing.
template <typename T>
class GenericKernel {
public:
    __aicore__ inline GenericKernel(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
        uint32_t rows, uint32_t d, float epsilon, float invD)
    {
        rows_ = rows;
        d_ = d;
        epsilon_ = epsilon;
        invD_ = invD;
        tile_ = MinU32(kGenericTile, d_);
        colsPad_ = ((tile_ * static_cast<uint32_t>(sizeof(T)) + 31U) / 32U * 32U) / static_cast<uint32_t>(sizeof(T));
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), static_cast<uint64_t>(rows_) * d_);
        res_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual), static_cast<uint64_t>(rows_) * d_);
        gam_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma), d_);
        biasG_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias), d_);
        out_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), static_cast<uint64_t>(rows_) * d_);

        const uint32_t tBytes = Align32(colsPad_ * static_cast<uint32_t>(sizeof(T)));
        const uint32_t fBytes = Align32(colsPad_ * sizeof(float));
        pipe_->InitBuffer(xQue_, 1, tBytes);
        pipe_->InitBuffer(resQue_, 1, tBytes);
        pipe_->InitBuffer(outQue_, 1, tBytes);
        pipe_->InitBuffer(workA_, fBytes);
        pipe_->InitBuffer(workB_, fBytes);
        pipe_->InitBuffer(gammaF_, fBytes);
        pipe_->InitBuffer(biasF_, fBytes);
        pipe_->InitBuffer(scalarBuf_, 32);
        pipe_->InitBuffer(reduceTmp_, kReduceTmpBytes);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> scalar = scalarBuf_.Get<float>();
        AscendC::LocalTensor<float> reduceTmp = reduceTmp_.Get<float>();
        AscendC::LocalTensor<float> workA = workA_.Get<float>();
        AscendC::LocalTensor<float> workB = workB_.Get<float>();
        AscendC::LocalTensor<float> gammaF = gammaF_.Get<float>();
        AscendC::LocalTensor<float> biasF = biasF_.Get<float>();

        for (uint32_t row = 0; row < rows_; ++row) {
            const uint64_t rowOff = static_cast<uint64_t>(row) * d_;
            float sum = 0.0f;
            for (uint32_t col = 0; col < d_; col += tile_) {
                const uint32_t len = MinU32(tile_, d_ - col);
                AscendC::LocalTensor<T> xAlloc = xQue_.AllocTensor<T>();
                AscendC::LocalTensor<T> rAlloc = resQue_.AllocTensor<T>();
                CopyInPad<T>(xAlloc, x_[rowOff + col], len);
                CopyInPad<T>(rAlloc, res_[rowOff + col], len);
                xQue_.EnQue(xAlloc);
                resQue_.EnQue(rAlloc);
                AscendC::LocalTensor<T> xLoc = xQue_.DeQue<T>();
                AscendC::LocalTensor<T> rLoc = resQue_.DeQue<T>();
                TypeOps<T>::ToFloat(workA, xLoc, len);
                TypeOps<T>::ToFloat(workB, rLoc, len);
                AscendC::Add<float>(workA, workA, workB, static_cast<int32_t>(len));
                AscendC::Mul<float>(workB, workA, workA, static_cast<int32_t>(len));
                sum += AlignedSumSq(workB, scalar, reduceTmp, len);
                xQue_.FreeTensor(xLoc);
                resQue_.FreeTensor(rLoc);
            }
            const float invRms = InvRmsFromSum(sum, invD_, epsilon_, scalar);
            for (uint32_t col = 0; col < d_; col += tile_) {
                const uint32_t len = MinU32(tile_, d_ - col);
                AscendC::LocalTensor<T> xAlloc = xQue_.AllocTensor<T>();
                AscendC::LocalTensor<T> rAlloc = resQue_.AllocTensor<T>();
                CopyInPad<T>(xAlloc, x_[rowOff + col], len);
                CopyInPad<T>(rAlloc, res_[rowOff + col], len);
                xQue_.EnQue(xAlloc);
                resQue_.EnQue(rAlloc);
                AscendC::LocalTensor<T> xLoc = xQue_.DeQue<T>();
                AscendC::LocalTensor<T> rLoc = resQue_.DeQue<T>();
                TypeOps<T>::ToFloat(workA, xLoc, len);
                TypeOps<T>::ToFloat(workB, rLoc, len);
                AscendC::Add<float>(workA, workA, workB, static_cast<int32_t>(len));
                AscendC::Muls<float>(workA, workA, invRms, static_cast<int32_t>(len));
                xQue_.FreeTensor(xLoc);
                resQue_.FreeTensor(rLoc);

                AscendC::LocalTensor<T> gAlloc = xQue_.AllocTensor<T>();
                AscendC::LocalTensor<T> bAlloc = resQue_.AllocTensor<T>();
                CopyInPad<T>(gAlloc, gam_[col], len);
                CopyInPad<T>(bAlloc, biasG_[col], len);
                xQue_.EnQue(gAlloc);
                resQue_.EnQue(bAlloc);
                AscendC::LocalTensor<T> gLoc = xQue_.DeQue<T>();
                AscendC::LocalTensor<T> bLoc = resQue_.DeQue<T>();
                TypeOps<T>::ToFloat(gammaF, gLoc, len);
                TypeOps<T>::ToFloat(biasF, bLoc, len);
                AscendC::Mul<float>(workA, workA, gammaF, static_cast<int32_t>(len));
                AscendC::Add<float>(workA, workA, biasF, static_cast<int32_t>(len));
                AscendC::LocalTensor<T> oAlloc = outQue_.AllocTensor<T>();
                TypeOps<T>::FromFloat(oAlloc, workA, len);
                outQue_.EnQue(oAlloc);
                AscendC::LocalTensor<T> oLoc = outQue_.DeQue<T>();
                CopyOutPad<T>(out_[rowOff + col], oLoc, len);
                outQue_.FreeTensor(oLoc);
                xQue_.FreeTensor(gLoc);
                resQue_.FreeTensor(bLoc);
            }
        }
    }

private:
    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> x_, res_, gam_, biasG_, out_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> resQue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workA_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workB_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> biasF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scalarBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceTmp_;
    uint32_t rows_{0};
    uint32_t d_{0};
    uint32_t tile_{kGenericTile};
    uint32_t colsPad_{0};
    float epsilon_{1e-5f};
    float invD_{1.f};
};

template <typename T>
__aicore__ inline void RunMid(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores, uint32_t batchRows)
{
    AscendC::TPipe pipe;
    MidBatchKernel<T> op(&pipe);
    op.Init(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores, batchRows);
    op.Process();
}

template <typename T>
__aicore__ inline void RunGeneric(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t d, float epsilon, float invD)
{
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }
    AscendC::TPipe pipe;
    GenericKernel<T> op(&pipe);
    op.Init(x, residual, gamma, bias, output, rows, d, epsilon, invD);
    op.Process();
}

}  // namespace mid_x_v002

extern "C" __global__ __vector__ void mid_x_v002_batch(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores,
    uint32_t batchRows, int32_t dtype, int32_t mode)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        return;
    }
    if (rows == 0 || d == 0) {
        return;
    }
    if (mode == 0) {
        if (usedCores == 0 || AscendC::GetBlockIdx() >= usedCores) {
            return;
        }
        if (dtype == mid_x_v002::kDtypeFp32) {
            mid_x_v002::RunMid<float>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores, batchRows);
        } else if (dtype == mid_x_v002::kDtypeFp16) {
            mid_x_v002::RunMid<half>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores, batchRows);
        } else if (dtype == mid_x_v002::kDtypeBf16) {
            mid_x_v002::RunMid<bfloat16_t>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores, batchRows);
        }
    } else {
        if (dtype == mid_x_v002::kDtypeFp32) {
            mid_x_v002::RunGeneric<float>(x, residual, gamma, bias, output, rows, d, epsilon, invD);
        } else if (dtype == mid_x_v002::kDtypeFp16) {
            mid_x_v002::RunGeneric<half>(x, residual, gamma, bias, output, rows, d, epsilon, invD);
        } else if (dtype == mid_x_v002::kDtypeBf16) {
            mid_x_v002::RunGeneric<bfloat16_t>(x, residual, gamma, bias, output, rows, d, epsilon, invD);
        }
    }
}

namespace mid_x_v002 {
namespace {

inline bool GroupPresent(const TensorGroupInfo& g)
{
    return g.tensors != nullptr && g.numTensors > 0 && g.tensors[0].shape != nullptr && g.tensors[0].numDims > 0;
}

inline bool ShapeRD(const TensorGroupInfo& g, uint32_t& rows, uint32_t& d)
{
    const TensorInfo& t = g.tensors[0];
    if (t.numDims < 2 || t.numDims > 4) {
        return false;
    }
    const long long dim = t.shape[t.numDims - 1];
    if (dim < 64 || dim > 32768) {
        return false;
    }
    unsigned long long r = 1;
    for (long long i = 0; i < t.numDims - 1; ++i) {
        if (t.shape[i] <= 0) {
            return false;
        }
        r *= static_cast<unsigned long long>(t.shape[i]);
    }
    if (r == 0 || r > 0xffffffffULL || dim > 0xffffffffULL) {
        return false;
    }
    rows = static_cast<uint32_t>(r);
    d = static_cast<uint32_t>(dim);
    return true;
}

inline int32_t NormalizeDtype(int32_t raw)
{
    if (raw == 0 || raw == 1 || raw == 2) {
        return raw;
    }
    if (raw == 27) {
        return kDtypeBf16;
    }
    return -1;
}

}  // namespace
}  // namespace mid_x_v002

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
    const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma, GM_ADDR bias,
    const TensorGroupInfo& info_bias, GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    (void)info_residual;
    (void)info_gamma;
    (void)info_bias;
    (void)info_output;
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        return;
    }
    if (!mid_x_v002::GroupPresent(info_x) || !mid_x_v002::GroupPresent(info_residual) ||
        !mid_x_v002::GroupPresent(info_gamma) || !mid_x_v002::GroupPresent(info_bias) ||
        !mid_x_v002::GroupPresent(info_output)) {
        return;
    }
    uint32_t rows = 0;
    uint32_t d = 0;
    if (!mid_x_v002::ShapeRD(info_x, rows, d)) {
        return;
    }
    const int32_t dtype = mid_x_v002::NormalizeDtype(info_x.tensors[0].dtype);
    if (dtype < 0 || availableCoreNum <= 0) {
        return;
    }
    const uint32_t elemSize = (dtype == mid_x_v002::kDtypeFp32) ? 4U : 2U;
    const uint32_t colsPad = ((d * elemSize + 31U) / 32U * 32U) / elemSize;
    const float invD = 1.0f / static_cast<float>(d);

    const bool mid = mid_x_v002::MidDomain(d, elemSize);
    uint32_t usedCores = 1;
    uint32_t batchRows = 1;
    if (mid) {
        usedCores = rows;
        if (static_cast<int64_t>(usedCores) > availableCoreNum) {
            usedCores = static_cast<uint32_t>(availableCoreNum);
        }
        if (usedCores > 40U) {
            usedCores = 40U;
        }
        if (usedCores == 0) {
            usedCores = 1;
        }
        batchRows = mid_x_v002::PickBatch(colsPad, elemSize, mid_x_v002::kMaxBatch);
    }

    const int32_t mode = mid ? 0 : 1;
    const uint32_t launchCores = mid ? usedCores : 1U;
    mid_x_v002_batch<<<launchCores, nullptr, stream>>>(x, residual, gamma, bias, output, rows, d, epsilon, invD,
        usedCores, batchRows, dtype, mode);
}
