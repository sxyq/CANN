// SEQ-FUSE-2 DIV_FEASIBILITY_PROBE — feasibility only, NOT a performance kernel.
// One form per process invocation (P2/P3 are expected to abort the device).
//   usage: div_probe <FORM> [deviceId]
//   FORM in {P1, P2, P3, P4, P5}
// P1: Div(out, ones, denom, 8)  distinct 32B-aligned slots
// P2: Div(denom, ones, denom, 8) dst == src1 (known 507035 hazard)
// P3: Div(out, ones+1elem, denom, 8) onesSlot at +4B offset (hazard)
// P4: Div(out, ones, denom, 1)  count=1
// P5: P1 over a denominator sweep, ulp vs correctly-rounded reciprocal
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
#include <acl/acl.h>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

__global__ __vector__ void div_probe_kernel(
    GM_ADDR inGmAddr, GM_ADDR outGmAddr, uint32_t form, uint32_t n)
{
    AscendC::TPipe pipe;
    // 16-float slots: P3's +4B-offset read stays in-bounds so a failure
    // signature is the alignment abort, not a UB overrun.
    AscendC::TBuf<AscendC::TPosition::VECCALC> onesBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> denomBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> outBuf;
    pipe.InitBuffer(onesBuf, 16 * sizeof(float));
    pipe.InitBuffer(denomBuf, 16 * sizeof(float));
    pipe.InitBuffer(outBuf, 16 * sizeof(float));

    AscendC::GlobalTensor<float> inGm;
    AscendC::GlobalTensor<float> outGm;
    inGm.SetGlobalBuffer((__gm__ float *)inGmAddr);
    outGm.SetGlobalBuffer((__gm__ float *)outGmAddr);

    AscendC::LocalTensor<float> ones = onesBuf.Get<float>();
    AscendC::LocalTensor<float> denom = denomBuf.Get<float>();
    AscendC::LocalTensor<float> out = outBuf.Get<float>();

    AscendC::Duplicate(ones, 1.0f, 8);
    // DataCopyPad-like load via the framework's copy: use DataCopy on aligned 8.
    AscendC::DataCopy(denom, inGm[0], n < 8 ? n : 8);
    AscendC::PipeBarrier<PIPE_MTE2>();
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

    const int32_t count = (form == 4) ? 1 : 8;
    if (form == 1 || form == 5) {
        // P1/P5: distinct dst, distinct aligned operands.
        AscendC::Div(out, ones, denom, count);
    } else if (form == 2) {
        // P2: dst == src1 (denominator slot is overwritten by the result).
        AscendC::Div(denom, ones, denom, count);
    } else if (form == 3) {
        // P3: numerator slot starts at +4B (float element index 1).
        AscendC::Div(out, ones[1], denom, count);
    } else if (form == 4) {
        // P4: count=1 form, distinct aligned operands.
        AscendC::Div(out, ones, denom, 1);
    }
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::DataCopy(outGm[0], out, 8);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
}

extern "C" void run_div_probe(GM_ADDR in, GM_ADDR out, uint32_t form,
                              uint32_t n, aclrtStream stream)
{
    div_probe_kernel<<<1, nullptr, stream>>>(in, out, form, n);
}

static bool CheckAcl(aclError s, const char* op)
{
    if (s == ACL_SUCCESS) return true;
    std::fprintf(stderr, "ACL_FAIL %s=%d\n", op, (int)s);
    return false;
}

// ULP distance between float a and correctly-rounded double reference.
static double UlpDistance(float a, double ref)
{
    const float rounded = static_cast<float>(ref);
    if (rounded == a) return 0.0;
    const float step = std::nextafter(rounded, INFINITY) - rounded;
    return step > 0 ? std::fabs(static_cast<double>(a) - static_cast<double>(rounded)) /
                          static_cast<double>(step)
                    : 0.0;
}

int main(int argc, char** argv)
{
    if (argc < 2) {
        std::fprintf(stderr, "usage: %s FORM [deviceId]\n", argv[0]);
        return 2;
    }
    const int form = std::atoi(argv[1]);
    const int deviceId = argc > 2 ? std::atoi(argv[2]) : 4;

    // Denominator sweep: normal, small, large, sqrt(eps)-region, tiny, huge.
    const float denoms[8] = {
        1.25f, 0.875f, 1.0e-6f, 1.0e+6f,
        1.1920929e-07f, 8.0f, 0.03125f, 3.0f};

    if (!CheckAcl(aclInit(nullptr), "aclInit")) return 1;
    if (!CheckAcl(aclrtSetDevice(deviceId), "setDevice")) return 1;
    aclrtStream stream = nullptr;
    if (!CheckAcl(aclrtCreateStream(&stream), "stream")) return 1;

    void *inD = nullptr, *outD = nullptr;
    const size_t bytes = 8 * sizeof(float);
    if (!CheckAcl(aclrtMalloc(&inD, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc in")) return 1;
    if (!CheckAcl(aclrtMalloc(&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc out")) return 1;
    float outH[8] = {0};
    if (!CheckAcl(aclrtMemcpy(inD, bytes, denoms, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "cp in")) return 1;
    if (!CheckAcl(aclrtMemcpy(outD, bytes, outH, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "cp out")) return 1;

    std::printf("FORM=P%d device=%d launch...\n", form, deviceId);
    std::fflush(stdout);
    run_div_probe((GM_ADDR)inD, (GM_ADDR)outD, (uint32_t)form, 8, stream);
    const aclError jr = aclrtSynchronizeStream(stream);
    if (jr != ACL_SUCCESS) {
        std::printf("RESULT=P%d status=ACL_FAIL sync=%d\n", form, (int)jr);
        std::fflush(stdout);
        // Hazard forms are EXPECTED to fail here (507035).
        return 10 + form;
    }
    if (!CheckAcl(aclrtMemcpy(outH, bytes, outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "cp back")) return 1;

    double maxUlp = 0.0;
    for (int i = 0; i < 8; ++i) {
        const double ref = 1.0 / static_cast<double>(denoms[i]);
        const double ulp = UlpDistance(outH[i], ref);
        if (ulp > maxUlp) maxUlp = ulp;
        std::printf("  denom=%.9g -> device=%.9g ref=%.9g ulp=%.3f\n",
                    (double)denoms[i], (double)outH[i], ref, ulp);
    }
    std::printf("RESULT=P%d status=PASS max_ulp=%.3f\n", form, maxUlp);
    std::fflush(stdout);

    aclrtFree(inD); aclrtFree(outD);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
