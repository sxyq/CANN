#include <cmath>
#include "kernel_operator.h"

// EPI-X V001: fused normalize+gamma+bias epilogue after one u residency.
// u = x + residual (FP32 resident)
// invRms = rsqrt(mean(u*u) + eps)
// out = u * invRms * gamma + bias   // single vector pass, no norm intermediate
// Software mask zeroes 32B pad lanes past D before sum and scale.

using AscendC::TPipe;
using AscendC::TBuf;
using AscendC::LocalTensor;
using AscendC::GlobalTensor;
using AscendC::DataCopyExtParams;
using AscendC::DataCopyPadExtParams;
using AscendC::ReduceSum;
using AscendC::Rsqrt;
using AscendC::Muls;
using AscendC::Adds;
using AscendC::Add;
using AscendC::Mul;
using AscendC::Cast;
using AscendC::Duplicate;
using AscendC::SetFlag;
using AscendC::WaitFlag;
using AscendC::HardEvent;
using AscendC::GetBlockIdx;
using AscendC::PipeBarrier;

static constexpr int32_t kDtypeF32 = 0;
static constexpr int32_t kDtypeF16 = 1;
static constexpr int32_t kDtypeBF16 = 2;
static constexpr int32_t kReduceTmpBytes = 8 * 1024;
static constexpr int32_t kTileF32 = 1024;
static constexpr int32_t kTileLow = 2048;
static constexpr int32_t kMaxDim = 32768;
static constexpr int32_t kMaxTiles = (kMaxDim + kTileF32 - 1) / kTileF32;
// FP32 lanes per 32B block.
static constexpr int32_t kAlignFloats = 8;

static inline int32_t NormalizeDtype(int32_t raw)
{
    if (raw == 27) {
        return kDtypeBF16;
    }
    return raw;
}

__aicore__ inline void SyncMTE2ToV()
{
    SetFlag<HardEvent::MTE2_V>(0);
    WaitFlag<HardEvent::MTE2_V>(0);
}

__aicore__ inline void SyncVToMTE2()
{
    SetFlag<HardEvent::V_MTE2>(0);
    WaitFlag<HardEvent::V_MTE2>(0);
}

__aicore__ inline void SyncVToMTE3()
{
    SetFlag<HardEvent::V_MTE3>(0);
    WaitFlag<HardEvent::V_MTE3>(0);
}

__aicore__ inline void SyncMTE3ToV()
{
    SetFlag<HardEvent::MTE3_V>(0);
    WaitFlag<HardEvent::MTE3_V>(0);
}

__aicore__ inline void SyncVToS()
{
    SetFlag<HardEvent::V_S>(0);
    WaitFlag<HardEvent::V_S>(0);
}

__aicore__ inline void SyncSToV()
{
    SetFlag<HardEvent::S_V>(0);
    WaitFlag<HardEvent::S_V>(0);
}

template <typename T>
__aicore__ inline void LoadPad(
    LocalTensor<T> dst,
    GlobalTensor<T> srcGm,
    int64_t gmOffset,
    int32_t validCount)
{
    const uint32_t byteLen =
        static_cast<uint32_t>(validCount) * static_cast<uint32_t>(sizeof(T));
    DataCopyExtParams cp(1, byteLen, 0, 0, 0);
    T padVal{};
    const uint32_t rem = byteLen & 31u;
    const uint16_t rightPadBytes = static_cast<uint16_t>((rem == 0u) ? 0u : (32u - rem));
    DataCopyPadExtParams<T> pad(true, 0, rightPadBytes, padVal);
    AscendC::DataCopyPad(dst, srcGm[static_cast<uint32_t>(gmOffset)], cp, pad);
}

template <typename T>
__aicore__ inline void StorePad(
    GlobalTensor<T> dstGm,
    LocalTensor<T> src,
    int64_t gmOffset,
    int32_t validCount)
{
    const uint32_t byteLen =
        static_cast<uint32_t>(validCount) * static_cast<uint32_t>(sizeof(T));
    DataCopyExtParams cp(1, byteLen, 0, 0, 0);
    AscendC::DataCopyPad(dstGm[static_cast<uint32_t>(gmOffset)], src, cp);
}

template <typename T>
__aicore__ inline void ToFloat(
    LocalTensor<float> dst,
    LocalTensor<T> src,
    int32_t n)
{
    if constexpr (sizeof(T) == 4) {
        Adds(dst, src, 0.0f, n);
    } else {
        Cast(dst, src, AscendC::RoundMode::CAST_NONE, n);
    }
}

template <typename T>
__aicore__ inline void FromFloat(
    LocalTensor<T> dst,
    LocalTensor<float> src,
    int32_t n)
{
    if constexpr (sizeof(T) == 4) {
        Adds(dst, src, 0.0f, n);
    } else {
        Cast(dst, src, AscendC::RoundMode::CAST_ROUND, n);
    }
}

template <typename T>
__aicore__ inline void FormU(
    LocalTensor<float> u32,
    LocalTensor<float> scratchF,
    LocalTensor<T> xLocal,
    LocalTensor<T> resLocal,
    int32_t n)
{
    if constexpr (sizeof(T) == 4) {
        Add(u32, xLocal, resLocal, n);
    } else {
        ToFloat(u32, xLocal, n);
        ToFloat(scratchF, resLocal, n);
        Add(u32, u32, scratchF, n);
    }
}

// MASK_STRATEGY: zero 32B pad lanes of resident u past valid D so ReduceSum
// and the fused epilogue cannot pick up stale pad garbage.
__aicore__ inline void SoftwareMaskTail(LocalTensor<float> u32, int32_t D)
{
    const int32_t slots = ((D + kAlignFloats - 1) / kAlignFloats) * kAlignFloats;
    if (slots > D) {
        LocalTensor<float> tail = u32[D];
        Duplicate(tail, 0.0f, slots - D);
    }
}

// FUSION_STAGES: (1) form resident u once (2) sum(u*u)+invRms
// (3) fused scale*gamma+bias store — no intermediate norm row.
template <typename T>
__aicore__ void ProcessRowFused(
    GlobalTensor<T>& xGm,
    GlobalTensor<T>& resGm,
    GlobalTensor<T>& gammaGm,
    GlobalTensor<T>& biasGm,
    GlobalTensor<T>& outGm,
    LocalTensor<T>& xLocal,
    LocalTensor<T>& resLocal,
    LocalTensor<T>& gammaLocal,
    LocalTensor<T>& biasLocal,
    LocalTensor<T>& outLocal,
    LocalTensor<float>& u32,
    LocalTensor<float>& scratchF,
    LocalTensor<float>& tileSum,
    LocalTensor<float>& acc,
    LocalTensor<float>& work,
    LocalTensor<float>& tmpLocal,
    int64_t row,
    int32_t D,
    int32_t tile,
    float invD,
    float eps)
{
    const int64_t base = row * static_cast<int64_t>(D);

    // Stage 1: one GM read of x and residual into resident u32.
    for (int32_t off = 0; off < D; off += tile) {
        int32_t n = D - off;
        if (n > tile) {
            n = tile;
        }
        LoadPad(xLocal, xGm, base + off, n);
        LoadPad(resLocal, resGm, base + off, n);
        SyncMTE2ToV();
        FormU(u32[off], scratchF, xLocal, resLocal, n);
        PipeBarrier<PIPE_V>();
        SyncVToMTE2();
    }
    SoftwareMaskTail(u32, D);
    PipeBarrier<PIPE_V>();

    // Stage 2: sum(u*u) over resident u, then invRms in V + one GetValue.
    Duplicate(acc, 0.0f, 1);
    PipeBarrier<PIPE_V>();
    const int32_t tileCount = (D + tile - 1) / tile;
    for (int32_t i = 0; i < tileCount; ++i) {
        const int32_t off = i * tile;
        int32_t n = D - off;
        if (n > tile) {
            n = tile;
        }
        LocalTensor<float> uTile = u32[off];
        Mul(scratchF, uTile, uTile, n);
        PipeBarrier<PIPE_V>();
        // Dest is 8B-aligned (offset 0 of a 64B buffer).
        ReduceSum<float, true>(tileSum, scratchF, tmpLocal, n);
        PipeBarrier<PIPE_V>();
        Add(acc, acc, tileSum, 1);
        PipeBarrier<PIPE_V>();
    }
    Muls(acc, acc, invD, 1);
    Adds(acc, acc, eps, 1);
    PipeBarrier<PIPE_V>();
    Rsqrt(work, acc, 1);
    PipeBarrier<PIPE_V>();
    SyncVToS();
    const float invRms = work.GetValue(0);
    SyncSToV();

    // Stage 3: fused epilogue on resident u. out = u*invRms*gamma+bias.
    for (int32_t off = 0; off < D; off += tile) {
        int32_t n = D - off;
        if (n > tile) {
            n = tile;
        }
        LocalTensor<float> uTile = u32[off];
        Muls(uTile, uTile, invRms, n);
        PipeBarrier<PIPE_V>();

        LoadPad(gammaLocal, gammaGm, off, n);
        LoadPad(biasLocal, biasGm, off, n);
        SyncMTE2ToV();
        ToFloat(scratchF, gammaLocal, n);
        PipeBarrier<PIPE_V>();
        Mul(uTile, uTile, scratchF, n);
        PipeBarrier<PIPE_V>();
        ToFloat(scratchF, biasLocal, n);
        PipeBarrier<PIPE_V>();
        Add(uTile, uTile, scratchF, n);
        PipeBarrier<PIPE_V>();
        SyncVToMTE2();

        FromFloat(outLocal, uTile, n);
        PipeBarrier<PIPE_V>();
        SyncVToMTE3();
        StorePad(outGm, outLocal, base + off, n);
        SyncMTE3ToV();
    }
}

template <typename T>
__aicore__ void EpiXKernelImpl(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t dim, uint32_t blockCount, float epsilon)
{
    GlobalTensor<T> xGm, resGm, gammaGm, biasGm, outGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
    resGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual));
    gammaGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
    biasGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias));
    outGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output));

    const int32_t D = static_cast<int32_t>(dim);
    const float invD = 1.0f / static_cast<float>(D);
    const int32_t tile = (sizeof(T) == 4) ? kTileF32 : kTileLow;
    const int32_t tBytes = static_cast<int32_t>(sizeof(T));
    const int32_t nativeTile = (tile * tBytes + 31) / 32 * 32;
    const int32_t floatTile = (tile * 4 + 31) / 32 * 32;
    const int32_t uBytes = (D * 4 + 31) / 32 * 32;

    uint32_t cores = blockCount;
    if (cores == 0) {
        cores = 1;
    }
    const uint64_t coreId = static_cast<uint64_t>(GetBlockIdx());
    const int64_t per = (rows + static_cast<int64_t>(cores) - 1) / static_cast<int64_t>(cores);
    const int64_t row0 = static_cast<int64_t>(coreId) * per;
    int64_t row1 = row0 + per;
    if (row1 > rows) {
        row1 = rows;
    }
    if (row0 >= row1) {
        return;
    }

    TPipe pipe;
    TBuf bX, bRes, bGamma, bBias, bOut, bU, bS, bTile, bAcc, bWork, bTmp;
    pipe.InitBuffer(bX, static_cast<uint32_t>(nativeTile));
    pipe.InitBuffer(bRes, static_cast<uint32_t>(nativeTile));
    pipe.InitBuffer(bGamma, static_cast<uint32_t>(nativeTile));
    pipe.InitBuffer(bBias, static_cast<uint32_t>(nativeTile));
    pipe.InitBuffer(bOut, static_cast<uint32_t>(nativeTile));
    pipe.InitBuffer(bU, static_cast<uint32_t>(uBytes));
    pipe.InitBuffer(bS, static_cast<uint32_t>(floatTile));
    pipe.InitBuffer(bTile, 64);
    pipe.InitBuffer(bAcc, 64);
    pipe.InitBuffer(bWork, 64);
    pipe.InitBuffer(bTmp, static_cast<uint32_t>(kReduceTmpBytes));

    LocalTensor<T> xLocal = bX.Get<T>();
    LocalTensor<T> resLocal = bRes.Get<T>();
    LocalTensor<T> gammaLocal = bGamma.Get<T>();
    LocalTensor<T> biasLocal = bBias.Get<T>();
    LocalTensor<T> outLocal = bOut.Get<T>();
    LocalTensor<float> u32 = bU.Get<float>();
    LocalTensor<float> scratchF = bS.Get<float>();
    LocalTensor<float> tileSum = bTile.Get<float>();
    LocalTensor<float> acc = bAcc.Get<float>();
    LocalTensor<float> work = bWork.Get<float>();
    LocalTensor<float> tmpLocal = bTmp.Get<float>();

    (void)kMaxTiles;
    for (int64_t r = row0; r < row1; ++r) {
        ProcessRowFused<T>(
            xGm, resGm, gammaGm, biasGm, outGm,
            xLocal, resLocal, gammaLocal, biasLocal, outLocal,
            u32, scratchF, tileSum, acc, work, tmpLocal,
            r, D, tile, invD, epsilon);
    }
}

__global__ __vector__ void epi_x_fp32(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t dim, uint32_t blockCount, float epsilon)
{
    EpiXKernelImpl<float>(x, residual, gamma, bias, output, rows, dim, blockCount, epsilon);
}

__global__ __vector__ void epi_x_fp16(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t dim, uint32_t blockCount, float epsilon)
{
    EpiXKernelImpl<half>(x, residual, gamma, bias, output, rows, dim, blockCount, epsilon);
}

__global__ __vector__ void epi_x_bf16(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t dim, uint32_t blockCount, float epsilon)
{
    EpiXKernelImpl<bfloat16_t>(x, residual, gamma, bias, output, rows, dim, blockCount, epsilon);
}

static inline int64_t FlattenRows(const TensorGroupInfo& g)
{
    if (g.tensors == nullptr) {
        return 0;
    }
    const TensorInfo& t = g.tensors[0];
    if (t.shape == nullptr || t.numDims < 1) {
        return 0;
    }
    int64_t rows = 1;
    for (int64_t i = 0; i < t.numDims - 1; ++i) {
        if (t.shape[i] <= 0) {
            return 0;
        }
        rows *= t.shape[i];
    }
    return rows;
}

static inline int64_t LastDim(const TensorGroupInfo& g)
{
    if (g.tensors == nullptr) {
        return 0;
    }
    const TensorInfo& t = g.tensors[0];
    if (t.shape == nullptr || t.numDims < 1) {
        return 0;
    }
    return t.shape[t.numDims - 1];
}

static inline int32_t GroupDtype(const TensorGroupInfo& g)
{
    if (g.tensors == nullptr) {
        return kDtypeF32;
    }
    return NormalizeDtype(g.tensors[0].dtype);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual, const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma, GM_ADDR bias, const TensorGroupInfo& info_bias, GM_ADDR output, const TensorGroupInfo& info_output, int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr ||
        output == nullptr || info_x.tensors == nullptr || info_residual.tensors == nullptr ||
        info_gamma.tensors == nullptr || info_bias.tensors == nullptr ||
        info_output.tensors == nullptr) {
        return;
    }
    const int64_t rows = FlattenRows(info_x);
    const int64_t dim = LastDim(info_x);
    if (rows <= 0 || dim <= 0 || dim > kMaxDim) {
        return;
    }
    int64_t coreNum = availableCoreNum > 0 ? availableCoreNum : 1;
    if (coreNum > rows) {
        coreNum = rows;
    }
    if (coreNum < 1) {
        coreNum = 1;
    }
    const uint32_t blockCount = static_cast<uint32_t>(coreNum);
    const int32_t dtype = GroupDtype(info_x);
    if (dtype == kDtypeF16) {
        epi_x_fp16<<<blockCount, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, blockCount, epsilon);
    } else if (dtype == kDtypeBF16) {
        epi_x_bf16<<<blockCount, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, blockCount, epsilon);
    } else {
        epi_x_fp32<<<blockCount, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, blockCount, epsilon);
    }
}
