#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace a001_submission {

constexpr uint32_t kDoubleBuffer = 2;
constexpr uint32_t kHotPathD = 1024;
constexpr uint32_t kHalfChunk = 3072;
constexpr uint32_t kFp32Chunk = 2048;

template <typename T>
class RowResidentKernel {
public:
    __aicore__ inline RowResidentKernel(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
        GM_ADDR bias, GM_ADDR output, uint64_t rows, uint64_t d, float epsilon,
        float inverseD, uint32_t blockDim)
    {
        rows_ = rows;
        d_ = d;
        epsilon_ = epsilon;
        inverseD_ = inverseD;
        blockDim_ = blockDim;
        const uint32_t block = AscendC::GetBlockIdx();
        const uint64_t base = rows / blockDim;
        const uint64_t extra = rows % blockDim;
        firstRow_ = static_cast<uint64_t>(block) * base +
            (static_cast<uint64_t>(block) < extra ? block : extra);
        rowsThisCore_ = base + (static_cast<uint64_t>(block) < extra ? 1 : 0);

        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + firstRow_ * d_,
            rowsThisCore_ * d_);
        residual_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(residual) + firstRow_ * d_,
            rowsThisCore_ * d_);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(output) + firstRow_ * d_,
            rowsThisCore_ * d_);
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gamma), d_);
        bias_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bias), d_);

        const uint32_t chunk = d_ <= kHotPathD ? static_cast<uint32_t>(d_) : Chunk();
        const uint32_t slotBytes = AlignBytes(chunk * sizeof(T));
        pipe_->InitBuffer(xQueue_, kDoubleBuffer, slotBytes);
        pipe_->InitBuffer(residualQueue_, kDoubleBuffer, slotBytes);
        pipe_->InitBuffer(gammaQueue_, kDoubleBuffer, slotBytes);
        pipe_->InitBuffer(biasQueue_, kDoubleBuffer, slotBytes);
        pipe_->InitBuffer(outputQueue_, kDoubleBuffer, slotBytes);
        pipe_->InitBuffer(xFloat_, AlignBytes(chunk * sizeof(float)));
        pipe_->InitBuffer(residualFloat_, AlignBytes(chunk * sizeof(float)));
        pipe_->InitBuffer(gammaFloat_, AlignBytes(chunk * sizeof(float)));
        pipe_->InitBuffer(biasFloat_, AlignBytes(chunk * sizeof(float)));
        pipe_->InitBuffer(uFloat_, AlignBytes(chunk * sizeof(float)));
        pipe_->InitBuffer(squareFloat_, AlignBytes(chunk * sizeof(float)));
        pipe_->InitBuffer(outputFloat_, AlignBytes(chunk * sizeof(float)));
        pipe_->InitBuffer(reduceTmp_, AlignBytes(chunk * sizeof(float)));
        pipe_->InitBuffer(sum_, 32);
        pipe_->InitBuffer(rms_, 32);
    }

    __aicore__ inline void Process()
    {
        const uint32_t chunk = d_ <= kHotPathD ? static_cast<uint32_t>(d_) : Chunk();
        for (uint64_t row = 0; row < rowsThisCore_; ++row) {
            ProcessRow(row * d_, chunk);
        }
    }

private:
    __aicore__ inline uint32_t Chunk() const
    {
        return sizeof(T) == sizeof(float) ? kFp32Chunk : kHalfChunk;
    }

    __aicore__ inline uint32_t AlignBytes(uint64_t bytes) const
    {
        return static_cast<uint32_t>((bytes + 31U) & ~31U);
    }

    __aicore__ inline void CopyIn(AscendC::LocalTensor<T> dst,
        const AscendC::GlobalTensor<T> &src, uint64_t offset, uint32_t count)
    {
        if ((static_cast<uint64_t>(count) * sizeof(T)) % 32 == 0 &&
            (offset * sizeof(T)) % 32 == 0) {
            AscendC::DataCopy(dst, src[offset],
                {1, static_cast<uint16_t>((count * sizeof(T)) / 32), 0, 0});
        } else {
            AscendC::DataCopyPad(dst, src[offset],
                {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0},
                {false, 0, 0, 0});
        }
    }

    __aicore__ inline void ToFloat(AscendC::LocalTensor<float> dst,
        AscendC::LocalTensor<T> src, uint32_t count)
    {
        if constexpr (AscendC::Std::is_same_v<T, float>) {
            AscendC::DataCopy<float>(dst, src,
                {1, static_cast<uint16_t>((count + 7) / 8), 0, 0});
        } else {
            AscendC::Cast<float, T>(dst, src, AscendC::RoundMode::CAST_NONE, count);
        }
    }

    __aicore__ inline void FromFloat(AscendC::LocalTensor<T> dst,
        AscendC::LocalTensor<float> src, uint32_t count)
    {
        if constexpr (AscendC::Std::is_same_v<T, float>) {
            AscendC::DataCopy<float>(dst, src,
                {1, static_cast<uint16_t>((count + 7) / 8), 0, 0});
        } else {
            AscendC::Cast<T, float>(dst, src, AscendC::RoundMode::CAST_ROUND, count);
        }
    }

    __aicore__ inline void LoadFloatParams(AscendC::LocalTensor<float> gamma,
        AscendC::LocalTensor<float> bias, uint64_t column, uint32_t count)
    {
        auto gammaIn = gammaQueue_.AllocTensor<T>();
        auto biasIn = biasQueue_.AllocTensor<T>();
        CopyIn(gammaIn, gamma_, column, count);
        CopyIn(biasIn, bias_, column, count);
        gammaQueue_.EnQue(gammaIn);
        biasQueue_.EnQue(biasIn);
        auto gammaSrc = gammaQueue_.DeQue<T>();
        auto biasSrc = biasQueue_.DeQue<T>();
        ToFloat(gamma, gammaSrc, count);
        ToFloat(bias, biasSrc, count);
        gammaQueue_.FreeTensor(gammaSrc);
        biasQueue_.FreeTensor(biasSrc);
    }

    __aicore__ inline void LoadU(AscendC::LocalTensor<float> u,
        uint64_t rowOffset, uint64_t column, uint32_t count)
    {
        auto xIn = xQueue_.AllocTensor<T>();
        auto residualIn = residualQueue_.AllocTensor<T>();
        CopyIn(xIn, x_, rowOffset + column, count);
        CopyIn(residualIn, residual_, rowOffset + column, count);
        xQueue_.EnQue(xIn);
        residualQueue_.EnQue(residualIn);
        auto xSrc = xQueue_.DeQue<T>();
        auto residualSrc = residualQueue_.DeQue<T>();
        auto xFloat = xFloat_.Get<float>();
        auto residualFloat = residualFloat_.Get<float>();
        ToFloat(xFloat, xSrc, count);
        ToFloat(residualFloat, residualSrc, count);
        AscendC::Add(u, xFloat, residualFloat, count);
        xQueue_.FreeTensor(xSrc);
        residualQueue_.FreeTensor(residualSrc);
    }

    __aicore__ inline void Accumulate(AscendC::LocalTensor<float> sum,
        AscendC::LocalTensor<float> u, uint32_t count)
    {
        auto square = squareFloat_.Get<float>();
        auto reduceTmp = reduceTmp_.Get<float>();
        auto part = rms_.Get<float>();
        AscendC::Duplicate(part, 0.0f, 8);
        AscendC::Mul(square, u, u, count);
        AscendC::ReduceSum<float, true>(part, square, reduceTmp, count);
        AscendC::Add(sum, sum, part, 8);
    }

    __aicore__ inline void ProcessRow(uint64_t rowOffset, uint32_t chunk)
    {
        auto sum = sum_.Get<float>();
        auto rms = rms_.Get<float>();
        AscendC::Duplicate(sum, 0.0f, 8);

        for (uint64_t column = 0; column < d_; column += chunk) {
            const uint32_t count = static_cast<uint32_t>(
                column + chunk <= d_ ? chunk : d_ - column);
            auto u = uFloat_.Get<float>();
            LoadU(u, rowOffset, column, count);
            Accumulate(sum, u, count);
        }

        AscendC::Muls(sum, sum, inverseD_, 8);
        AscendC::Adds(sum, sum, epsilon_, 8);
        AscendC::Sqrt(rms, sum, 8);

        for (uint64_t column = 0; column < d_; column += chunk) {
            const uint32_t count = static_cast<uint32_t>(
                column + chunk <= d_ ? chunk : d_ - column);
            auto u = uFloat_.Get<float>();
            auto gamma = gammaFloat_.Get<float>();
            auto bias = biasFloat_.Get<float>();
            auto outFloat = outputFloat_.Get<float>();
            LoadU(u, rowOffset, column, count);
            LoadFloatParams(gamma, bias, column, count);
            AscendC::Muls(outFloat, u, 1.0f / rms.GetValue(0), count);
            AscendC::Mul(outFloat, outFloat, gamma, count);
            AscendC::Add(outFloat, outFloat, bias, count);
            auto outputLocal = outputQueue_.AllocTensor<T>();
            FromFloat(outputLocal, outFloat, count);
            outputQueue_.EnQue(outputLocal);
            auto outputReady = outputQueue_.DeQue<T>();
            if ((static_cast<uint64_t>(count) * sizeof(T)) % 32 == 0 &&
                ((rowOffset + column) * sizeof(T)) % 32 == 0) {
                AscendC::DataCopy(output_[rowOffset + column], outputReady,
                    {1, static_cast<uint16_t>((count * sizeof(T)) / 32), 0, 0});
            } else {
                AscendC::DataCopyPad(output_[rowOffset + column], outputReady,
                    {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0});
            }
            outputQueue_.FreeTensor(outputReady);
        }
    }

    AscendC::TPipe *pipe_;
    uint64_t rows_;
    uint64_t d_;
    uint64_t firstRow_;
    uint64_t rowsThisCore_;
    uint32_t blockDim_;
    float epsilon_;
    float inverseD_;
    AscendC::GlobalTensor<T> x_, residual_, gamma_, bias_, output_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_, residualQueue_, gammaQueue_, biasQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xFloat_, residualFloat_, gammaFloat_, biasFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> uFloat_, squareFloat_, outputFloat_, reduceTmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sum_, rms_;
};

template <typename T>
__global__ __vector__ void Launch(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
    GM_ADDR bias, GM_ADDR output, uint64_t rows, uint64_t d, float epsilon,
    float inverseD, uint32_t blockDim)
{
    if (blockDim == 0 || AscendC::GetBlockIdx() >= blockDim || rows == 0 || d == 0) {
        return;
    }
    AscendC::TPipe pipe;
    RowResidentKernel<T> op(&pipe);
    op.Init(x, residual, gamma, bias, output, rows, d, epsilon, inverseD, blockDim);
    op.Process();
}

}  // namespace a001_submission

template <typename Group>
static inline bool A001GroupPresent(const Group& group)
{
    return group.tensors != nullptr && group.numTensors > 0 &&
        group.tensors[0].shape != nullptr && group.tensors[0].numDims > 0;
}

template <typename Group>
static inline uint64_t A001NumRows(const Group& group, uint64_t d)
{
    const auto& info = group.tensors[0];
    uint64_t rows = 1;
    for (int64_t i = 0; i + 1 < info.numDims; ++i) {
        if (info.shape[i] <= 0 || rows > UINT64_MAX / static_cast<uint64_t>(info.shape[i])) {
            return 0;
        }
        rows *= static_cast<uint64_t>(info.shape[i]);
    }
    return d == 0 ? 0 : rows;
}

template <typename InfoX, typename InfoR, typename InfoG, typename InfoB, typename InfoO,
    typename CoreNum, typename Stream>
void run_kernel(GM_ADDR x, const InfoX& info_x,
    GM_ADDR residual, const InfoR& info_residual,
    GM_ADDR gamma, const InfoG& info_gamma,
    GM_ADDR bias, const InfoB& info_bias,
    GM_ADDR output, const InfoO& info_output,
    CoreNum availableCoreNum, Stream stream, float epsilon)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr ||
        output == nullptr || !A001GroupPresent(info_x) || !A001GroupPresent(info_residual) ||
        !A001GroupPresent(info_gamma) || !A001GroupPresent(info_bias) ||
        !A001GroupPresent(info_output)) {
        return;
    }
    const auto& xInfo = info_x.tensors[0];
    const auto& residualInfo = info_residual.tensors[0];
    const auto& gammaInfo = info_gamma.tensors[0];
    const auto& biasInfo = info_bias.tensors[0];
    const auto& outputInfo = info_output.tensors[0];
    if (xInfo.numDims < 1 || residualInfo.numDims != xInfo.numDims ||
        outputInfo.numDims != xInfo.numDims || gammaInfo.numDims != 1 ||
        biasInfo.numDims != 1 || xInfo.dtype != residualInfo.dtype ||
        xInfo.dtype != gammaInfo.dtype || xInfo.dtype != biasInfo.dtype ||
        xInfo.dtype != outputInfo.dtype) {
        return;
    }
    const int64_t dSigned = xInfo.shape[xInfo.numDims - 1];
    if (dSigned < 64 || dSigned > 32768 || gammaInfo.shape[0] != dSigned ||
        biasInfo.shape[0] != dSigned) {
        return;
    }
    const uint64_t d = static_cast<uint64_t>(dSigned);
    const uint64_t rows = A001NumRows(info_x, d);
    if (rows == 0 || rows > UINT32_MAX * static_cast<uint64_t>(UINT32_MAX)) {
        return;
    }
    uint64_t requested = static_cast<uint64_t>(availableCoreNum);
    if (requested == 0) {
        requested = 1;
    }
    if (requested > rows) {
        requested = rows;
    }
    const uint32_t blockDim = static_cast<uint32_t>(requested);
    if (xInfo.dtype == 0) {
        a001_submission::Launch<float><<<blockDim, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, d, epsilon,
            1.0f / static_cast<float>(d), blockDim);
    } else if (xInfo.dtype == 1) {
        a001_submission::Launch<half><<<blockDim, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, d, epsilon,
            1.0f / static_cast<float>(d), blockDim);
    } else if (xInfo.dtype == 2) {
        a001_submission::Launch<bfloat16_t><<<blockDim, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, d, epsilon,
            1.0f / static_cast<float>(d), blockDim);
    }
}
