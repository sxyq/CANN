#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace a001_submission {

constexpr uint32_t kSingleBuffer = 1;
constexpr uint32_t kUbBudget = 188416;
constexpr uint32_t kHotPathD = 1024;
constexpr uint32_t kHalfChunk = 5120;
constexpr uint32_t kFp32Chunk = 4096;
constexpr uint64_t kFastMaxElems = 262144;

__aicore__ inline uint32_t A001AlignBytes(uint64_t bytes)
{
    return static_cast<uint32_t>((bytes + 31U) & ~31U);
}

// ---------------------------------------------------------------------------
// FastKernel: small shapes. One x/res read, u kept in UB, params loaded per
// row through queues (V008 proven sync pattern), single GetValue, one pass.
// ---------------------------------------------------------------------------
template <typename T>
class FastKernel {
public:
    __aicore__ inline FastKernel(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
        GM_ADDR bias, GM_ADDR output, uint64_t rows, uint64_t d, float epsilon,
        float inverseD, uint32_t blockDim)
    {
        rows_ = rows;
        d_ = d;
        epsilon_ = epsilon;
        inverseD_ = inverseD;

        const uint32_t block = AscendC::GetBlockIdx();
        const uint64_t base = rows_ / blockDim;
        const uint64_t extra = rows_ % blockDim;
        firstRow_ = static_cast<uint64_t>(block) * base +
            (static_cast<uint64_t>(block) < extra ? block : extra);
        rowsThisCore_ = base + (static_cast<uint64_t>(block) < extra ? 1 : 0);

        const uint32_t d32 = static_cast<uint32_t>(d_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + firstRow_ * d_,
            rowsThisCore_ * d_);
        residual_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(residual) + firstRow_ * d_,
            rowsThisCore_ * d_);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(output) + firstRow_ * d_,
            rowsThisCore_ * d_);
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gamma), d_);
        bias_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bias), d_);

        pipe_->InitBuffer(xQueue_, kSingleBuffer, A001AlignBytes(d32 * sizeof(T)));
        pipe_->InitBuffer(resQueue_, kSingleBuffer, A001AlignBytes(d32 * sizeof(T)));
        pipe_->InitBuffer(outQueue_, kSingleBuffer, A001AlignBytes(d32 * sizeof(T)));
        pipe_->InitBuffer(paramQueue_, kSingleBuffer, A001AlignBytes(d32 * sizeof(T)));
        pipe_->InitBuffer(uFull_, A001AlignBytes(d32 * sizeof(float)));
        pipe_->InitBuffer(workA_, A001AlignBytes(d32 * sizeof(float)));
        pipe_->InitBuffer(gammaF_, A001AlignBytes(d32 * sizeof(float)));
        pipe_->InitBuffer(biasF_, A001AlignBytes(d32 * sizeof(float)));
        pipe_->InitBuffer(reduceTmp_, A001AlignBytes(d32 * sizeof(float)));
        pipe_->InitBuffer(sum_, 32);
        pipe_->InitBuffer(rms_, 32);
    }

    __aicore__ inline void Process()
    {
        const uint32_t d32 = static_cast<uint32_t>(d_);
        for (uint64_t row = 0; row < rowsThisCore_; ++row) {
            const uint64_t gOffset = row * d_;

            auto xIn = xQueue_.AllocTensor<T>();
            CopyIn(xIn, x_, gOffset, d32);
            xQueue_.EnQue(xIn);
            auto resIn = resQueue_.AllocTensor<T>();
            CopyIn(resIn, residual_, gOffset, d32);
            resQueue_.EnQue(resIn);
            auto xSrc = xQueue_.DeQue<T>();
            auto resSrc = resQueue_.DeQue<T>();

            auto u = uFull_.Get<float>();
            auto work = workA_.Get<float>();
            ToFloat(u, xSrc, d32);
            ToFloat(work, resSrc, d32);
            AscendC::Add(u, u, work, d32);
            xQueue_.FreeTensor(xSrc);
            resQueue_.FreeTensor(resSrc);

            AscendC::Mul(work, u, u, d32);
            auto sum = sum_.Get<float>();
            auto reduceTmp = reduceTmp_.Get<float>();
            AscendC::Duplicate(sum, 0.0f, 8);
            AscendC::ReduceSum<float, true>(sum, work, reduceTmp, d32);
            AscendC::Muls(sum, sum, inverseD_, 8);
            AscendC::Adds(sum, sum, epsilon_, 8);
            auto rms = rms_.Get<float>();
            AscendC::Sqrt(rms, sum, 8);
            const float inverseRms = 1.0f / rms.GetValue(0);

            LoadFloatParams(d32);

            auto gammaF = gammaF_.Get<float>();
            auto biasF = biasF_.Get<float>();
            auto outF = workA_.Get<float>();
            AscendC::Muls(outF, u, inverseRms, d32);
            AscendC::Mul(outF, outF, gammaF, d32);
            AscendC::Add(outF, outF, biasF, d32);

            auto outLocal = outQueue_.AllocTensor<T>();
            FromFloat(outLocal, outF, d32);
            outQueue_.EnQue(outLocal);
            auto outReady = outQueue_.DeQue<T>();
            CopyOut(output_, gOffset, outReady, d32);
            outQueue_.FreeTensor(outReady);
        }
    }

private:
    __aicore__ inline void CopyIn(AscendC::LocalTensor<T> dst,
        const AscendC::GlobalTensor<T> &src, uint64_t offset, uint32_t count)
    {
        if ((static_cast<uint64_t>(count) * sizeof(T)) % 32 == 0 &&
            (offset * sizeof(T)) % 32 == 0) {
            AscendC::DataCopy(dst, src[offset],
                {1, static_cast<uint16_t>((count * sizeof(T)) / 32), 0, 0});
        } else {
            AscendC::DataCopyPad(dst, src[offset],
                {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0},
                {false, 0, 0, 0});
        }
    }

    __aicore__ inline void CopyOut(AscendC::GlobalTensor<T> &dst, uint64_t offset,
        AscendC::LocalTensor<T> src, uint32_t count)
    {
        if ((static_cast<uint64_t>(count) * sizeof(T)) % 32 == 0 &&
            (offset * sizeof(T)) % 32 == 0) {
            AscendC::DataCopy(dst[offset], src,
                {1, static_cast<uint16_t>((count * sizeof(T)) / 32), 0, 0});
        } else {
            AscendC::DataCopyPad(dst[offset], src,
                {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0});
        }
    }

    __aicore__ inline void ToFloat(AscendC::LocalTensor<float> dst,
        AscendC::LocalTensor<T> src, uint32_t count)
    {
        if constexpr (AscendC::Std::is_same_v<T, float>) {
            AscendC::DataCopy<float>(dst, src,
                {1, static_cast<uint16_t>((count + 7) / 8), 0, 0});
        } else {
            AscendC::Cast<float, T>(dst, src, AscendC::RoundMode::CAST_NONE, count);
        }
    }

    __aicore__ inline void FromFloat(AscendC::LocalTensor<T> dst,
        AscendC::LocalTensor<float> src, uint32_t count)
    {
        if constexpr (AscendC::Std::is_same_v<T, float>) {
            AscendC::DataCopy<float>(dst, src,
                {1, static_cast<uint16_t>((count + 7) / 8), 0, 0});
        } else {
            AscendC::Cast<T, float>(dst, src, AscendC::RoundMode::CAST_ROUND, count);
        }
    }

    // V008-proven queue sync for gamma/bias -> FP32 work buffers.
    __aicore__ inline void LoadFloatParams(uint32_t count)
    {
        auto gammaIn = paramQueue_.AllocTensor<T>();
        CopyIn(gammaIn, gamma_, 0, count);
        paramQueue_.EnQue(gammaIn);
        auto gammaSrc = paramQueue_.DeQue<T>();
        ToFloat(gammaF_.Get<float>(), gammaSrc, count);
        paramQueue_.FreeTensor(gammaSrc);

        auto biasIn = paramQueue_.AllocTensor<T>();
        CopyIn(biasIn, bias_, 0, count);
        paramQueue_.EnQue(biasIn);
        auto biasSrc = paramQueue_.DeQue<T>();
        ToFloat(biasF_.Get<float>(), biasSrc, count);
        paramQueue_.FreeTensor(biasSrc);
    }

    AscendC::TPipe *pipe_;
    uint64_t rows_ = 0;
    uint64_t d_ = 0;
    uint64_t firstRow_ = 0;
    uint64_t rowsThisCore_ = 0;
    float epsilon_ = 0.0f;
    float inverseD_ = 1.0f;
    AscendC::GlobalTensor<T> x_, residual_, gamma_, bias_, output_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_, resQueue_, paramQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> uFull_, workA_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaF_, biasF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceTmp_, sum_, rms_;
};

// ---------------------------------------------------------------------------
// ResidentKernel: exact V010 architecture (known 15/15 / 33.25). Full-u
// residency, optional param cache, 2D split with output-tail partial reduce.
// ---------------------------------------------------------------------------
template <typename T>
class ResidentKernel {
public:
    __aicore__ inline ResidentKernel(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
        GM_ADDR bias, GM_ADDR output, uint64_t partialsOff,
        uint64_t rows, uint64_t d, float epsilon, float inverseD,
        uint32_t rowParallel, uint32_t colParallel)
    {
        rows_ = rows;
        d_ = d;
        epsilon_ = epsilon;
        inverseD_ = inverseD;
        rowParallel_ = rowParallel;
        colParallel_ = colParallel;

        const uint32_t block = AscendC::GetBlockIdx();
        const uint32_t rowGroup = block / colParallel_;
        const uint32_t colGroup = block % colParallel_;
        colGroup_ = colGroup;

        const uint64_t rowBase = rows_ / rowParallel_;
        const uint64_t rowExtra = rows_ % rowParallel_;
        firstRow_ = static_cast<uint64_t>(rowGroup) * rowBase +
            (static_cast<uint64_t>(rowGroup) < rowExtra ? rowGroup : rowExtra);
        rowsThisCore_ = rowBase + (static_cast<uint64_t>(rowGroup) < rowExtra ? 1 : 0);

        const uint64_t colBase = d_ / colParallel_;
        const uint64_t colExtra = d_ % colParallel_;
        firstCol_ = static_cast<uint64_t>(colGroup) * colBase +
            (static_cast<uint64_t>(colGroup) < colExtra ? colGroup : colExtra);
        colsThisCore_ = colBase + (static_cast<uint64_t>(colGroup) < colExtra ? 1 : 0);

        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), rows_ * d_);
        residual_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(residual), rows_ * d_);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(output), rows_ * d_);
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gamma), d_);
        bias_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bias), d_);
        if (colParallel_ > 1) {
            __gm__ uint8_t *outBytes = reinterpret_cast<__gm__ uint8_t *>(output);
            __gm__ float *partPtr =
                reinterpret_cast<__gm__ float *>(outBytes + partialsOff);
            partials_.SetGlobalBuffer(partPtr, rows_ * colParallel_);
        }

        const uint64_t uBytes = colsThisCore_ * sizeof(float);
        const uint64_t paramBytes = 2 * colsThisCore_ * sizeof(T);
        const uint64_t reserve = 512;
        uint64_t remain = kUbBudget > uBytes + reserve ? kUbBudget - uBytes - reserve : 0;

        cacheParams_ = false;
        if (remain >= paramBytes + 4096) {
            cacheParams_ = true;
            remain -= paramBytes;
        }

        uint32_t tile = static_cast<uint32_t>(colsThisCore_);
        if (tile > 4096) {
            tile = 4096;
        }
        const uint64_t peakTile =
            static_cast<uint64_t>(sizeof(T)) * 3 + static_cast<uint64_t>(sizeof(float)) * 4;
        while (tile > 64 && tile * peakTile > remain) {
            tile /= 2;
        }
        if (tile < 64) {
            tile = 64;
        }
        if (tile > colsThisCore_) {
            tile = static_cast<uint32_t>(colsThisCore_);
        }
        tile_ = tile;

        pipe_->InitBuffer(uFull_, A001AlignBytes(colsThisCore_ * sizeof(float)));
        pipe_->InitBuffer(xQueue_, kSingleBuffer, A001AlignBytes(tile_ * sizeof(T)));
        pipe_->InitBuffer(resQueue_, kSingleBuffer, A001AlignBytes(tile_ * sizeof(T)));
        pipe_->InitBuffer(outQueue_, kSingleBuffer, A001AlignBytes(tile_ * sizeof(T)));
        pipe_->InitBuffer(paramQueue_, kSingleBuffer, A001AlignBytes(tile_ * sizeof(T)));
        pipe_->InitBuffer(workA_, A001AlignBytes(tile_ * sizeof(float)));
        pipe_->InitBuffer(workB_, A001AlignBytes(tile_ * sizeof(float)));
        pipe_->InitBuffer(gammaF_, A001AlignBytes(tile_ * sizeof(float)));
        pipe_->InitBuffer(biasF_, A001AlignBytes(tile_ * sizeof(float)));
        pipe_->InitBuffer(reduceTmp_, A001AlignBytes(tile_ * sizeof(float)));
        pipe_->InitBuffer(sum_, 32);
        pipe_->InitBuffer(rms_, 32);
        pipe_->InitBuffer(scratch_, 32);
        if (cacheParams_) {
            pipe_->InitBuffer(gammaCache_, A001AlignBytes(colsThisCore_ * sizeof(T)));
            pipe_->InitBuffer(biasCache_, A001AlignBytes(colsThisCore_ * sizeof(T)));
            LoadParamCache();
        }
    }

    __aicore__ inline void Process()
    {
        if (rowsThisCore_ == 0 || colsThisCore_ == 0) {
            if (colParallel_ > 1) {
                AscendC::SyncAll();
                AscendC::SyncAll();
            }
            return;
        }

        if (colParallel_ == 1) {
            for (uint64_t row = 0; row < rowsThisCore_; ++row) {
                float sumSq = BuildU(firstRow_ + row);
                StoreRow(firstRow_ + row, sumSq);
            }
            return;
        }

        for (uint64_t row = 0; row < rowsThisCore_; ++row) {
            const uint64_t gRow = firstRow_ + row;
            const float sumSq = BuildU(gRow);
            AscendC::LocalTensor<float> scratch = scratch_.Get<float>();
            AscendC::Duplicate(scratch, sumSq, 8);
            AscendC::DataCopyPad(
                partials_[static_cast<uint64_t>(colGroup_) * rows_ + gRow], scratch,
                {1, static_cast<uint32_t>(sizeof(float)), 0, 0, 0});
        }

        AscendC::SyncAll();

        for (uint64_t row = 0; row < rowsThisCore_; ++row) {
            const uint64_t gRow = firstRow_ + row;
            float total = 0.0f;
            for (uint32_t g = 0; g < colParallel_; ++g) {
                AscendC::LocalTensor<float> scratch = scratch_.Get<float>();
                AscendC::DataCopyPad(scratch,
                    partials_[static_cast<uint64_t>(g) * rows_ + gRow],
                    {1, static_cast<uint32_t>(sizeof(float)), 0, 0, 0},
                    {false, 0, 0, 0});
                total += scratch.GetValue(0);
            }
            StoreRow(gRow, total);
        }

        AscendC::SyncAll();
    }

private:
    __aicore__ inline void CopyIn(AscendC::LocalTensor<T> dst,
        const AscendC::GlobalTensor<T> &src, uint64_t offset, uint32_t count)
    {
        if ((static_cast<uint64_t>(count) * sizeof(T)) % 32 == 0 &&
            (offset * sizeof(T)) % 32 == 0) {
            AscendC::DataCopy(dst, src[offset],
                {1, static_cast<uint16_t>((count * sizeof(T)) / 32), 0, 0});
        } else {
            AscendC::DataCopyPad(dst, src[offset],
                {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0},
                {false, 0, 0, 0});
        }
    }

    __aicore__ inline void CopyOut(AscendC::GlobalTensor<T> &dst, uint64_t offset,
        AscendC::LocalTensor<T> src, uint32_t count)
    {
        if ((static_cast<uint64_t>(count) * sizeof(T)) % 32 == 0 &&
            (offset * sizeof(T)) % 32 == 0) {
            AscendC::DataCopy(dst[offset], src,
                {1, static_cast<uint16_t>((count * sizeof(T)) / 32), 0, 0});
        } else {
            AscendC::DataCopyPad(dst[offset], src,
                {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0});
        }
    }

    __aicore__ inline void ToFloat(AscendC::LocalTensor<float> dst,
        AscendC::LocalTensor<T> src, uint32_t count)
    {
        if constexpr (AscendC::Std::is_same_v<T, float>) {
            AscendC::DataCopy<float>(dst, src,
                {1, static_cast<uint16_t>((count + 7) / 8), 0, 0});
        } else {
            AscendC::Cast<float, T>(dst, src, AscendC::RoundMode::CAST_NONE, count);
        }
    }

    __aicore__ inline void FromFloat(AscendC::LocalTensor<T> dst,
        AscendC::LocalTensor<float> src, uint32_t count)
    {
        if constexpr (AscendC::Std::is_same_v<T, float>) {
            AscendC::DataCopy<float>(dst, src,
                {1, static_cast<uint16_t>((count + 7) / 8), 0, 0});
        } else {
            AscendC::Cast<T, float>(dst, src, AscendC::RoundMode::CAST_ROUND, count);
        }
    }

    __aicore__ inline void LoadParamCache()
    {
        const uint32_t n = static_cast<uint32_t>(colsThisCore_);
        AscendC::LocalTensor<T> gammaCache = gammaCache_.template Get<T>();
        AscendC::LocalTensor<T> biasCache = biasCache_.template Get<T>();
        CopyIn(gammaCache, gamma_, firstCol_, n);
        CopyIn(biasCache, bias_, firstCol_, n);
    }

    __aicore__ inline float BuildU(uint64_t gRow)
    {
        auto sum = sum_.Get<float>();
        AscendC::Duplicate(sum, 0.0f, 8);
        AscendC::LocalTensor<float> uFull = uFull_.Get<float>();

        for (uint64_t col = 0; col < colsThisCore_; col += tile_) {
            const uint32_t count = static_cast<uint32_t>(
                col + tile_ <= colsThisCore_ ? tile_ : colsThisCore_ - col);
            const uint64_t gOffset = gRow * d_ + firstCol_ + col;

            auto xIn = xQueue_.AllocTensor<T>();
            CopyIn(xIn, x_, gOffset, count);
            xQueue_.EnQue(xIn);
            auto xSrc = xQueue_.DeQue<T>();

            auto resIn = resQueue_.AllocTensor<T>();
            CopyIn(resIn, residual_, gOffset, count);
            resQueue_.EnQue(resIn);
            auto resSrc = resQueue_.DeQue<T>();

            auto workA = workA_.Get<float>();
            auto workB = workB_.Get<float>();
            AscendC::LocalTensor<float> uTile = uFull[col];
            ToFloat(uTile, xSrc, count);
            ToFloat(workA, resSrc, count);
            AscendC::Add(uTile, uTile, workA, count);
            xQueue_.FreeTensor(xSrc);
            resQueue_.FreeTensor(resSrc);

            auto reduceTmp = reduceTmp_.Get<float>();
            AscendC::Mul(workB, uTile, uTile, count);
            auto part = rms_.Get<float>();
            AscendC::Duplicate(part, 0.0f, 8);
            AscendC::ReduceSum<float, true>(part, workB, reduceTmp, count);
            AscendC::Add(sum, sum, part, 8);
        }
        auto sumSrc = sum_.Get<float>();
        return sumSrc.GetValue(0);
    }

    __aicore__ inline void LoadParamsTile(AscendC::LocalTensor<float> gammaF,
        AscendC::LocalTensor<float> biasF, uint64_t col, uint32_t count)
    {
        if (cacheParams_) {
            AscendC::LocalTensor<T> gammaCache = gammaCache_.template Get<T>();
            AscendC::LocalTensor<T> biasCache = biasCache_.template Get<T>();
            ToFloat(gammaF, gammaCache[col], count);
            ToFloat(biasF, biasCache[col], count);
            return;
        }
        auto gammaIn = paramQueue_.AllocTensor<T>();
        CopyIn(gammaIn, gamma_, firstCol_ + col, count);
        paramQueue_.EnQue(gammaIn);
        auto gSrc = paramQueue_.DeQue<T>();
        ToFloat(gammaF, gSrc, count);
        paramQueue_.FreeTensor(gSrc);

        auto biasIn = paramQueue_.AllocTensor<T>();
        CopyIn(biasIn, bias_, firstCol_ + col, count);
        paramQueue_.EnQue(biasIn);
        auto bSrc = paramQueue_.DeQue<T>();
        ToFloat(biasF, bSrc, count);
        paramQueue_.FreeTensor(bSrc);
    }

    __aicore__ inline void StoreRow(uint64_t gRow, float sumOfSquares)
    {
        auto sum = sum_.Get<float>();
        auto rms = rms_.Get<float>();
        AscendC::Duplicate(sum, sumOfSquares, 8);
        AscendC::Muls(sum, sum, inverseD_, 8);
        AscendC::Adds(sum, sum, epsilon_, 8);
        AscendC::Sqrt(rms, sum, 8);
        const float inverseRms = 1.0f / rms.GetValue(0);

        AscendC::LocalTensor<float> uFull = uFull_.Get<float>();
        for (uint64_t col = 0; col < colsThisCore_; col += tile_) {
            const uint32_t count = static_cast<uint32_t>(
                col + tile_ <= colsThisCore_ ? tile_ : colsThisCore_ - col);
            const uint64_t gOffset = gRow * d_ + firstCol_ + col;

            auto gammaF = gammaF_.Get<float>();
            auto biasF = biasF_.Get<float>();
            LoadParamsTile(gammaF, biasF, col, count);

            auto outF = workA_.Get<float>();
            AscendC::LocalTensor<float> uTile = uFull[col];
            AscendC::Muls(outF, uTile, inverseRms, count);
            AscendC::Mul(outF, outF, gammaF, count);
            AscendC::Add(outF, outF, biasF, count);

            auto outLocal = outQueue_.AllocTensor<T>();
            FromFloat(outLocal, outF, count);
            outQueue_.EnQue(outLocal);
            auto outReady = outQueue_.DeQue<T>();
            CopyOut(output_, gOffset, outReady, count);
            outQueue_.FreeTensor(outReady);
        }
    }

    AscendC::TPipe *pipe_;
    uint64_t rows_ = 0;
    uint64_t d_ = 0;
    uint64_t firstRow_ = 0;
    uint64_t rowsThisCore_ = 0;
    uint64_t firstCol_ = 0;
    uint64_t colsThisCore_ = 0;
    uint32_t rowParallel_ = 1;
    uint32_t colParallel_ = 1;
    uint32_t colGroup_ = 0;
    uint32_t tile_ = 0;
    bool cacheParams_ = false;
    float epsilon_ = 0.0f;
    float inverseD_ = 1.0f;
    AscendC::GlobalTensor<T> x_, residual_, gamma_, bias_, output_;
    AscendC::GlobalTensor<float> partials_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_, resQueue_, paramQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> uFull_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workA_, workB_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaF_, biasF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceTmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sum_, rms_, scratch_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaCache_, biasCache_;
};

template <typename T>
__global__ __vector__ void LaunchFast(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
    GM_ADDR bias, GM_ADDR output, uint64_t rows, uint64_t d, float epsilon,
    float inverseD, uint32_t blockDim)
{
    if (blockDim == 0 || AscendC::GetBlockIdx() >= blockDim || rows == 0 || d == 0) {
        return;
    }
    AscendC::TPipe pipe;
    FastKernel<T> op(&pipe);
    op.Init(x, residual, gamma, bias, output, rows, d, epsilon, inverseD, blockDim);
    op.Process();
}

template <typename T>
__global__ __vector__ void Launch(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
    GM_ADDR bias, GM_ADDR output, uint64_t partialsOff,
    uint64_t rows, uint64_t d, float epsilon, float inverseD,
    uint32_t rowParallel, uint32_t colParallel, uint32_t blockDim)
{
    if (blockDim == 0 || AscendC::GetBlockIdx() >= blockDim || rows == 0 || d == 0) {
        return;
    }
    AscendC::TPipe pipe;
    ResidentKernel<T> op(&pipe);
    op.Init(x, residual, gamma, bias, output, partialsOff, rows, d, epsilon, inverseD,
        rowParallel, colParallel);
    op.Process();
}

}  // namespace a001_submission

template <typename Group>
static inline bool A001GroupPresent(const Group& group)
{
    return group.tensors != nullptr && group.numTensors > 0 &&
        group.tensors[0].shape != nullptr && group.tensors[0].numDims > 0;
}

template <typename Group>
static inline uint64_t A001NumRows(const Group& group, uint64_t d)
{
    const auto& info = group.tensors[0];
    uint64_t rows = 1;
    for (int64_t i = 0; i + 1 < info.numDims; ++i) {
        if (info.shape[i] <= 0 || rows > UINT64_MAX / static_cast<uint64_t>(info.shape[i])) {
            return 0;
        }
        rows *= static_cast<uint64_t>(info.shape[i]);
    }
    return d == 0 ? 0 : rows;
}

template <typename InfoX, typename InfoR, typename InfoG, typename InfoB, typename InfoO,
    typename CoreNum, typename Stream>
void run_kernel(GM_ADDR x, const InfoX& info_x,
    GM_ADDR residual, const InfoR& info_residual,
    GM_ADDR gamma, const InfoG& info_gamma,
    GM_ADDR bias, const InfoB& info_bias,
    GM_ADDR output, const InfoO& info_output,
    CoreNum availableCoreNum, Stream stream, float epsilon)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr ||
        output == nullptr || !A001GroupPresent(info_x) || !A001GroupPresent(info_residual) ||
        !A001GroupPresent(info_gamma) || !A001GroupPresent(info_bias) ||
        !A001GroupPresent(info_output)) {
        return;
    }
    const auto& xInfo = info_x.tensors[0];
    const auto& residualInfo = info_residual.tensors[0];
    const auto& gammaInfo = info_gamma.tensors[0];
    const auto& biasInfo = info_bias.tensors[0];
    const auto& outputInfo = info_output.tensors[0];
    if (xInfo.numDims < 1 || residualInfo.numDims != xInfo.numDims ||
        outputInfo.numDims != xInfo.numDims || gammaInfo.numDims != 1 ||
        biasInfo.numDims != 1 || xInfo.dtype != residualInfo.dtype ||
        xInfo.dtype != gammaInfo.dtype || xInfo.dtype != biasInfo.dtype ||
        xInfo.dtype != outputInfo.dtype) {
        return;
    }
    const int64_t dSigned = xInfo.shape[xInfo.numDims - 1];
    if (dSigned < 64 || dSigned > 32768 || gammaInfo.shape[0] != dSigned ||
        biasInfo.shape[0] != dSigned) {
        return;
    }
    const uint64_t d = static_cast<uint64_t>(dSigned);
    const uint64_t rows = A001NumRows(info_x, d);
    if (rows == 0 || rows > UINT32_MAX * static_cast<uint64_t>(UINT32_MAX)) {
        return;
    }
    uint64_t cores = static_cast<uint64_t>(availableCoreNum);
    if (cores == 0) {
        cores = 1;
    }
    const uint32_t elemSize = (xInfo.dtype == 0) ? 4u : 2u;
    const float invD = 1.0f / static_cast<float>(d);

    // FastKernel UB: 4 queues * d * elemSize + 5 float tiles * d * 4 + scalars.
    const uint64_t fastUb =
        d * (static_cast<uint64_t>(elemSize) * 4ULL + 20ULL) + 512ULL;
    const bool useFast = (rows * d <= a001_submission::kFastMaxElems) &&
        (fastUb <= a001_submission::kUbBudget);

    if (useFast) {
        uint64_t blockCount = cores;
        if (blockCount > rows) {
            blockCount = rows;
        }
        const uint32_t fastDim = static_cast<uint32_t>(blockCount);
        if (xInfo.dtype == 0) {
            a001_submission::LaunchFast<float><<<fastDim, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, epsilon, invD, fastDim);
        } else if (xInfo.dtype == 1) {
            a001_submission::LaunchFast<half><<<fastDim, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, epsilon, invD, fastDim);
        } else if (xInfo.dtype == 2) {
            a001_submission::LaunchFast<bfloat16_t><<<fastDim, nullptr, stream>>>(
                x, residual, gamma, bias, output, rows, d, epsilon, invD, fastDim);
        }
        return;
    }

    uint32_t rowParallel = 1;
    uint32_t colParallel = 1;
    if (rows >= cores) {
        rowParallel = static_cast<uint32_t>(cores);
        colParallel = 1;
    } else {
        rowParallel = static_cast<uint32_t>(rows);
        uint32_t maxColByCores = static_cast<uint32_t>(cores / rowParallel);
        if (maxColByCores < 1) {
            maxColByCores = 1;
        }
        uint32_t maxColByScratch = static_cast<uint32_t>((d * elemSize) / 4);
        if (maxColByScratch < 1) {
            maxColByScratch = 1;
        }
        uint32_t maxColByWidth = static_cast<uint32_t>((d + 127) / 128);
        if (maxColByWidth < 1) {
            maxColByWidth = 1;
        }
        colParallel = maxColByCores;
        if (colParallel > maxColByScratch) {
            colParallel = maxColByScratch;
        }
        if (colParallel > maxColByWidth) {
            colParallel = maxColByWidth;
        }
        if (static_cast<uint64_t>(rowParallel) * colParallel > cores) {
            colParallel = static_cast<uint32_t>(cores / rowParallel);
        }
        if (colParallel < 1) {
            colParallel = 1;
        }
    }

    const uint64_t outputBytes = rows * d * elemSize;
    const uint64_t scratchBytes = static_cast<uint64_t>(colParallel) * rows * 4;
    if (colParallel > 1 && scratchBytes > outputBytes) {
        rowParallel = static_cast<uint32_t>(rows < cores ? rows : cores);
        colParallel = 1;
    }

    const uint32_t launchDim = rowParallel * colParallel;
    const uint64_t partialsOff = (colParallel > 1 && scratchBytes <= outputBytes)
        ? (outputBytes - scratchBytes)
        : 0;

    if (xInfo.dtype == 0) {
        a001_submission::Launch<float><<<launchDim, nullptr, stream>>>(
            x, residual, gamma, bias, output, partialsOff, rows, d, epsilon, invD,
            rowParallel, colParallel, launchDim);
    } else if (xInfo.dtype == 1) {
        a001_submission::Launch<half><<<launchDim, nullptr, stream>>>(
            x, residual, gamma, bias, output, partialsOff, rows, d, epsilon, invD,
            rowParallel, colParallel, launchDim);
    } else if (xInfo.dtype == 2) {
        a001_submission::Launch<bfloat16_t><<<launchDim, nullptr, stream>>>(
            x, residual, gamma, bias, output, partialsOff, rows, d, epsilon, invD,
            rowParallel, colParallel, launchDim);
    }
}
