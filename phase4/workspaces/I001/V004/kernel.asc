#include <cmath>
#include "kernel_operator.h"

// I001 V004 — keep V003 ABI; fix unaligned copies, reduce tmp, T13 UB.
// Do NOT redefine TensorInfo / TensorGroupInfo.
// dtype: 0=FP32, 1=FP16, 2=BF16 (27 accepted as BF16)

static const int32_t I004_DT_FLOAT = 0;
static const int32_t I004_DT_FLOAT16 = 1;
static const int32_t I004_DT_BF16 = 2;
static const int32_t I004_DT_BF16_ACL = 27;
static const uint32_t I004_REDUCE_TMP_BYTES = 8192U;
static const uint32_t I004_TILE = 256U;

template <typename T>
struct I004Ops {
    __aicore__ static void ToFloat(AscendC::LocalTensor<float>& dst,
                                   AscendC::LocalTensor<T>& src, uint32_t count)
    {
        AscendC::Cast<float, T>(dst, src, AscendC::RoundMode::CAST_NONE,
                                static_cast<int32_t>(count));
    }
    __aicore__ static void FromFloat(AscendC::LocalTensor<T>& dst,
                                     AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::Cast<T, float>(dst, src, AscendC::RoundMode::CAST_ROUND,
                                static_cast<int32_t>(count));
    }
};

template <>
struct I004Ops<float> {
    __aicore__ static void ToFloat(AscendC::LocalTensor<float>& dst,
                                   AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::DataCopy(dst, src, static_cast<int32_t>(count));
    }
    __aicore__ static void FromFloat(AscendC::LocalTensor<float>& dst,
                                     AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::DataCopy(dst, src, static_cast<int32_t>(count));
    }
};

template <typename T>
__aicore__ static uint32_t I004ElemBlock()
{
    return 32U / static_cast<uint32_t>(sizeof(T));
}

template <typename T>
__aicore__ static uint32_t I004Align(uint32_t count, uint32_t elemBlock)
{
    return (count + elemBlock - 1U) / elemBlock * elemBlock;
}

// Load n real elems into first n slots; zero-pad up to workN (32B block).
template <typename T>
__aicore__ static void I004LoadPad(AscendC::GlobalTensor<T>& gm,
                                   AscendC::LocalTensor<T>& ub,
                                   uint32_t off, uint32_t n, uint32_t workN)
{
    AscendC::DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.blockLen = n * static_cast<uint32_t>(sizeof(T));
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    AscendC::DataCopyPadExtParams<T> pad;
    pad.isPad = true;
    pad.leftPadding = 0;
    pad.rightPadding = static_cast<uint8_t>(workN - n);
    pad.paddingValue = static_cast<T>(0);
    AscendC::DataCopyPad(ub, gm[off], cp, pad);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// Store exactly n elements (no pad write).
template <typename T>
__aicore__ static void I004StoreN(AscendC::GlobalTensor<T>& gm,
                                  AscendC::LocalTensor<T>& ub,
                                  uint32_t off, uint32_t n)
{
    AscendC::DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.blockLen = n * static_cast<uint32_t>(sizeof(T));
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    AscendC::DataCopyPad(gm[off], ub, cp);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T>
__aicore__ static void I004Row(
    AscendC::GlobalTensor<T>& xg, AscendC::GlobalTensor<T>& rg,
    AscendC::GlobalTensor<T>& gg, AscendC::GlobalTensor<T>& bg,
    AscendC::GlobalTensor<T>& og,
    AscendC::LocalTensor<T>& xU, AscendC::LocalTensor<T>& rU,
    AscendC::LocalTensor<T>& sU,
    AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
    AscendC::LocalTensor<float>& redDst, AscendC::LocalTensor<float>& redTmp,
    uint32_t base, uint32_t cols, uint32_t tile, float eps)
{
    uint32_t elemBlock = I004ElemBlock<T>();
    uint32_t d;
    uint32_t n;
    uint32_t workN;
    float ss;
    float var;
    float denom;
    float invRms;

    ss = 0.0f;
    for (d = 0; d < cols; d += tile) {
        n = cols - d;
        if (n > tile) {
            n = tile;
        }
        workN = I004Align<T>(n, elemBlock);
        I004LoadPad(xg, xU, base + d, n, workN);
        I004LoadPad(rg, rU, base + d, n, workN);
        I004Ops<T>::ToFloat(fA, xU, workN);
        I004Ops<T>::ToFloat(fB, rU, workN);
        AscendC::Add(fA, fA, fB, workN);
        AscendC::Mul(fB, fA, fA, workN);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::ReduceSum<float, true>(redDst, fB, redTmp, static_cast<int32_t>(workN));
        AscendC::PipeBarrier<PIPE_ALL>();
        ss += redDst.GetValue(0);
    }

    var = ss / static_cast<float>(static_cast<int32_t>(cols)) + eps;
    if (!(var > 0.0f)) {
        var = 0.0f;
    }
    fB.SetValue(0, var);
    AscendC::Sqrt(fA, fB, 1);
    AscendC::PipeBarrier<PIPE_ALL>();
    denom = fA.GetValue(0);
    invRms = (denom > 0.0f) ? (1.0f / denom) : 0.0f;

    for (d = 0; d < cols; d += tile) {
        n = cols - d;
        if (n > tile) {
            n = tile;
        }
        workN = I004Align<T>(n, elemBlock);
        I004LoadPad(xg, xU, base + d, n, workN);
        I004LoadPad(rg, rU, base + d, n, workN);
        I004Ops<T>::ToFloat(fA, xU, workN);
        I004Ops<T>::ToFloat(fB, rU, workN);
        AscendC::Add(fA, fA, fB, workN);
        AscendC::Muls(fA, fA, invRms, workN);
        I004LoadPad(gg, xU, d, n, workN);
        I004LoadPad(bg, rU, d, n, workN);
        I004Ops<T>::ToFloat(fB, xU, workN);
        AscendC::Mul(fA, fA, fB, workN);
        I004Ops<T>::ToFloat(fB, rU, workN);
        AscendC::Add(fA, fA, fB, workN);
        I004Ops<T>::FromFloat(sU, fA, workN);
        AscendC::PipeBarrier<PIPE_ALL>();
        I004StoreN(og, sU, base + d, n);
    }
}

template <typename T>
__aicore__ static void I004Run(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t cols, float eps)
{
    AscendC::GlobalTensor<T> xg, rg, gg, bg, og;
    xg.SetGlobalBuffer((__gm__ T*)x, static_cast<uint64_t>(rows) * cols);
    rg.SetGlobalBuffer((__gm__ T*)residual, static_cast<uint64_t>(rows) * cols);
    gg.SetGlobalBuffer((__gm__ T*)gamma, cols);
    bg.SetGlobalBuffer((__gm__ T*)bias, cols);
    og.SetGlobalBuffer((__gm__ T*)output, static_cast<uint64_t>(rows) * cols);

    uint32_t elemBlock = I004ElemBlock<T>();
    uint32_t tile = I004_TILE;
    if (tile > cols) {
        tile = I004Align<T>(cols, elemBlock);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx, qr, qs;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bfA, bfB, bredDst, bredTmp;
    pipe.InitBuffer(qx, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(qr, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(qs, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(bfA, tile * 4U);
    pipe.InitBuffer(bfB, tile * 4U);
    pipe.InitBuffer(bredDst, 64U);
    pipe.InitBuffer(bredTmp, I004_REDUCE_TMP_BYTES);

    AscendC::LocalTensor<T> xU = qx.AllocTensor<T>();
    AscendC::LocalTensor<T> rU = qr.AllocTensor<T>();
    AscendC::LocalTensor<T> sU = qs.AllocTensor<T>();
    AscendC::LocalTensor<float> fA = bfA.Get<float>();
    AscendC::LocalTensor<float> fB = bfB.Get<float>();
    AscendC::LocalTensor<float> redDst = bredDst.Get<float>();
    AscendC::LocalTensor<float> redTmp = bredTmp.Get<float>();

    uint32_t blk = static_cast<uint32_t>(AscendC::GetBlockIdx());
    uint32_t nb = static_cast<uint32_t>(AscendC::GetBlockNum());
    uint32_t per = (rows + nb - 1U) / nb;
    uint32_t r0 = blk * per;
    uint32_t r1 = r0 + per;
    if (r1 > rows) {
        r1 = rows;
    }

    uint32_t row;
    for (row = r0; row < r1; ++row) {
        I004Row<T>(xg, rg, gg, bg, og, xU, rU, sU, fA, fB, redDst, redTmp,
                   row * cols, cols, tile, eps);
    }

    qx.FreeTensor(xU);
    qr.FreeTensor(rU);
    qs.FreeTensor(sU);
}

extern "C" __global__ __vector__ void i001_fp32(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t cols, float eps)
{
    I004Run<float>(x, residual, gamma, bias, output, rows, cols, eps);
}

extern "C" __global__ __vector__ void i001_fp16(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t cols, float eps)
{
    I004Run<half>(x, residual, gamma, bias, output, rows, cols, eps);
}

extern "C" __global__ __vector__ void i001_bf16(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t cols, float eps)
{
    I004Run<bfloat16_t>(x, residual, gamma, bias, output, rows, cols, eps);
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    (void)info_residual;
    (void)info_gamma;
    (void)info_bias;
    (void)info_output;

    if (info_x.numTensors < 1 || info_x.tensors == 0 ||
        info_x.tensors[0].shape == 0 || info_x.tensors[0].numDims < 2 ||
        availableCoreNum <= 0) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    uint64_t rows = 1;
    int64_t axis;
    for (axis = 0; axis + 1 < xInfo.numDims; ++axis) {
        rows *= static_cast<uint64_t>(xInfo.shape[axis]);
    }
    const uint64_t cols64 = static_cast<uint64_t>(xInfo.shape[xInfo.numDims - 1]);
    if (rows == 0 || cols64 == 0 || rows > 0xffffffffULL || cols64 > 0xffffffffULL) {
        return;
    }
    const uint32_t rows32 = static_cast<uint32_t>(rows);
    const uint32_t cols = static_cast<uint32_t>(cols64);
    const int32_t dtype = xInfo.dtype;

    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);
    if (blockNum > 40U) {
        blockNum = 40U;
    }
    if (blockNum > rows32) {
        blockNum = rows32;
    }
    if (blockNum == 0U) {
        return;
    }

    if (dtype == I004_DT_FLOAT) {
        i001_fp32<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows32, cols, epsilon);
    } else if (dtype == I004_DT_FLOAT16) {
        i001_fp16<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows32, cols, epsilon);
    } else if (dtype == I004_DT_BF16 || dtype == I004_DT_BF16_ACL) {
        i001_bf16<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows32, cols, epsilon);
    }
}
