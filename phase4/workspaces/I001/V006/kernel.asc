#include <cmath>
#include "kernel_operator.h"

// I001 V006 — wide-D retained-y + large-tile two-pass + few-row D-split.
// Fix vs V005: retained-u buffer must cover padded workN, not raw cols.
// ABI identical to V003/V004 (online 15/15). Do NOT redefine TensorInfo / TensorGroupInfo.

static const int32_t I005_DT_FLOAT = 0;
static const int32_t I005_DT_FLOAT16 = 1;
static const int32_t I005_DT_BF16 = 2;
static const int32_t I005_DT_BF16_ACL = 27;
static const uint32_t I005_REDUCE_TMP_BYTES = 8192U;
static const uint32_t I005_TILE = 2048U;
static const uint32_t I005_TILE_SMALL = 512U;
// workN = Align32B(n) can exceed n by up to 15 elems; last-tile keepOff+workN can
// therefore reach cols + 15. Keep float slack well above that.
static const uint32_t I005_U_SLACK = 32U;

template <typename T>
struct I005Ops {
    __aicore__ static void ToFloat(AscendC::LocalTensor<float>& dst,
                                   AscendC::LocalTensor<T>& src, uint32_t count)
    {
        AscendC::Cast<float, T>(dst, src, AscendC::RoundMode::CAST_NONE,
                                static_cast<int32_t>(count));
    }
    __aicore__ static void FromFloat(AscendC::LocalTensor<T>& dst,
                                     AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::Cast<T, float>(dst, src, AscendC::RoundMode::CAST_ROUND,
                                static_cast<int32_t>(count));
    }
};

template <>
struct I005Ops<float> {
    __aicore__ static void ToFloat(AscendC::LocalTensor<float>& dst,
                                   AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::DataCopy(dst, src, static_cast<int32_t>(count));
    }
    __aicore__ static void FromFloat(AscendC::LocalTensor<float>& dst,
                                     AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::DataCopy(dst, src, static_cast<int32_t>(count));
    }
};

template <typename T>
__aicore__ static uint32_t I005Align(uint32_t count)
{
    const uint32_t eb = 32U / static_cast<uint32_t>(sizeof(T));
    return (count + eb - 1U) / eb * eb;
}

template <typename T>
__aicore__ static void I005LoadPad(AscendC::GlobalTensor<T>& gm,
                                   AscendC::LocalTensor<T>& ub,
                                   uint32_t off, uint32_t n, uint32_t workN)
{
    AscendC::DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.blockLen = n * static_cast<uint32_t>(sizeof(T));
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    AscendC::DataCopyPadExtParams<T> pad;
    pad.isPad = true;
    pad.leftPadding = 0;
    pad.rightPadding = static_cast<uint8_t>(workN - n);
    pad.paddingValue = static_cast<T>(0);
    AscendC::DataCopyPad(ub, gm[off], cp, pad);
}

template <typename T>
__aicore__ static void I005StoreN(AscendC::GlobalTensor<T>& gm,
                                  AscendC::LocalTensor<T>& ub,
                                  uint32_t off, uint32_t n)
{
    AscendC::DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.blockLen = n * static_cast<uint32_t>(sizeof(T));
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    AscendC::DataCopyPad(gm[off], ub, cp);
}

template <typename T>
__aicore__ static void I005SqTile(
    AscendC::GlobalTensor<T>& xg, AscendC::GlobalTensor<T>& rg,
    AscendC::LocalTensor<T>& xU, AscendC::LocalTensor<T>& rU,
    AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
    AscendC::LocalTensor<float>& redDst, AscendC::LocalTensor<float>& redTmp,
    AscendC::LocalTensor<float>& uKeep, int keep,
    uint32_t dataOff, uint32_t keepOff, uint32_t n, uint32_t workN, float& ss)
{
    I005LoadPad(xg, xU, dataOff, n, workN);
    I005LoadPad(rg, rU, dataOff, n, workN);
    AscendC::PipeBarrier<PIPE_ALL>();
    I005Ops<T>::ToFloat(fA, xU, workN);
    I005Ops<T>::ToFloat(fB, rU, workN);
    AscendC::Add(fA, fA, fB, workN);
    AscendC::Mul(fB, fA, fA, workN);
    if (keep) {
        AscendC::LocalTensor<float> uT = uKeep[keepOff];
        // workN includes D-tail pad; uKeep sized cols+I005_U_SLACK so this fits
        AscendC::Adds(uT, fA, 0.0f, workN);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::ReduceSum<float, true>(redDst, fB, redTmp, static_cast<int32_t>(workN));
    AscendC::PipeBarrier<PIPE_ALL>();
    ss += redDst.GetValue(0);
}

template <typename T>
__aicore__ static void I005NormTile(
    AscendC::GlobalTensor<T>& xg, AscendC::GlobalTensor<T>& rg,
    AscendC::GlobalTensor<T>& gg, AscendC::GlobalTensor<T>& bg,
    AscendC::GlobalTensor<T>& og,
    AscendC::LocalTensor<T>& xU, AscendC::LocalTensor<T>& rU,
    AscendC::LocalTensor<T>& sU,
    AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
    AscendC::LocalTensor<float>& uKeep, int keep,
    uint32_t dataOff, uint32_t paramOff, uint32_t keepOff,
    uint32_t n, uint32_t workN, float invRms)
{
    if (keep) {
        AscendC::LocalTensor<float> uT = uKeep[keepOff];
        AscendC::Muls(fA, uT, invRms, workN);
    } else {
        I005LoadPad(xg, xU, dataOff, n, workN);
        I005LoadPad(rg, rU, dataOff, n, workN);
        AscendC::PipeBarrier<PIPE_ALL>();
        I005Ops<T>::ToFloat(fA, xU, workN);
        I005Ops<T>::ToFloat(fB, rU, workN);
        AscendC::Add(fA, fA, fB, workN);
        AscendC::Muls(fA, fA, invRms, workN);
    }
    I005LoadPad(gg, xU, paramOff, n, workN);
    I005LoadPad(bg, rU, paramOff, n, workN);
    AscendC::PipeBarrier<PIPE_ALL>();
    I005Ops<T>::ToFloat(fB, xU, workN);
    AscendC::Mul(fA, fA, fB, workN);
    I005Ops<T>::ToFloat(fB, rU, workN);
    AscendC::Add(fA, fA, fB, workN);
    I005Ops<T>::FromFloat(sU, fA, workN);
    AscendC::PipeBarrier<PIPE_ALL>();
    I005StoreN(og, sU, dataOff, n);
}

__aicore__ static float I005InvRms(float ss, uint32_t cols, float eps,
                                   AscendC::LocalTensor<float>& fA,
                                   AscendC::LocalTensor<float>& fB)
{
    float var = ss / static_cast<float>(static_cast<int32_t>(cols)) + eps;
    if (!(var > 0.0f)) {
        var = 0.0f;
    }
    fB.SetValue(0, var);
    AscendC::Sqrt(fA, fB, 1);
    AscendC::PipeBarrier<PIPE_ALL>();
    float denom = fA.GetValue(0);
    return (denom > 0.0f) ? (1.0f / denom) : 0.0f;
}

// mode 0: two-pass stream; mode 1: retained-y (u kept in UB)
template <typename T>
__aicore__ static void I005RowMode(
    AscendC::GlobalTensor<T>& xg, AscendC::GlobalTensor<T>& rg,
    AscendC::GlobalTensor<T>& gg, AscendC::GlobalTensor<T>& bg,
    AscendC::GlobalTensor<T>& og,
    AscendC::LocalTensor<T>& xU, AscendC::LocalTensor<T>& rU,
    AscendC::LocalTensor<T>& sU,
    AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
    AscendC::LocalTensor<float>& redDst, AscendC::LocalTensor<float>& redTmp,
    AscendC::LocalTensor<float>& uRow,
    uint32_t base, uint32_t cols, uint32_t tile, float eps, int mode)
{
    int keep = (mode == 1) ? 1 : 0;
    uint32_t d;
    uint32_t n;
    uint32_t workN;
    float ss = 0.0f;

    for (d = 0; d < cols; d += tile) {
        n = cols - d;
        if (n > tile) {
            n = tile;
        }
        workN = I005Align<T>(n);
        I005SqTile(xg, rg, xU, rU, fA, fB, redDst, redTmp, uRow, keep,
                   base + d, d, n, workN, ss);
    }

    float invRms = I005InvRms(ss, cols, eps, fA, fB);

    for (d = 0; d < cols; d += tile) {
        n = cols - d;
        if (n > tile) {
            n = tile;
        }
        workN = I005Align<T>(n);
        I005NormTile(xg, rg, gg, bg, og, xU, rU, sU, fA, fB, uRow, keep,
                     base + d, d, d, n, workN, invRms);
    }
}

template <typename T>
__aicore__ static void I005RunRow(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t cols, float eps, int mode)
{
    AscendC::GlobalTensor<T> xg, rg, gg, bg, og;
    xg.SetGlobalBuffer((__gm__ T*)x, static_cast<uint64_t>(rows) * cols);
    rg.SetGlobalBuffer((__gm__ T*)residual, static_cast<uint64_t>(rows) * cols);
    gg.SetGlobalBuffer((__gm__ T*)gamma, cols);
    bg.SetGlobalBuffer((__gm__ T*)bias, cols);
    og.SetGlobalBuffer((__gm__ T*)output, static_cast<uint64_t>(rows) * cols);

    uint32_t tile = I005_TILE;
    if (tile > cols) {
        tile = I005Align<T>(cols);
    }
    if (tile < I005_TILE_SMALL) {
        tile = I005_TILE_SMALL;
    }
    if (tile > cols && cols > 0) {
        tile = I005Align<T>(cols);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx, qr, qs;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bfA, bfB, bredDst, bredTmp, bu;
    pipe.InitBuffer(qx, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(qr, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(qs, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(bfA, tile * 4U);
    pipe.InitBuffer(bfB, tile * 4U);
    pipe.InitBuffer(bredDst, 64U);
    pipe.InitBuffer(bredTmp, I005_REDUCE_TMP_BYTES);
    // mode 1: one float per column + pad slack (workN can exceed cols on D tail)
    uint32_t uBytes = (mode == 1) ? ((cols + I005_U_SLACK) * 4U) : (tile * 4U);
    pipe.InitBuffer(bu, uBytes);

    AscendC::LocalTensor<T> xU = qx.AllocTensor<T>();
    AscendC::LocalTensor<T> rU = qr.AllocTensor<T>();
    AscendC::LocalTensor<T> sU = qs.AllocTensor<T>();
    AscendC::LocalTensor<float> fA = bfA.Get<float>();
    AscendC::LocalTensor<float> fB = bfB.Get<float>();
    AscendC::LocalTensor<float> redDst = bredDst.Get<float>();
    AscendC::LocalTensor<float> redTmp = bredTmp.Get<float>();
    AscendC::LocalTensor<float> uRow = bu.Get<float>();

    uint32_t blk = static_cast<uint32_t>(AscendC::GetBlockIdx());
    uint32_t nb = static_cast<uint32_t>(AscendC::GetBlockNum());
    uint32_t per = (rows + nb - 1U) / nb;
    uint32_t r0 = blk * per;
    uint32_t r1 = r0 + per;
    if (r1 > rows) {
        r1 = rows;
    }

    uint32_t row;
    for (row = r0; row < r1; ++row) {
        I005RowMode<T>(xg, rg, gg, bg, og, xU, rU, sU, fA, fB, redDst, redTmp, uRow,
                       row * cols, cols, tile, eps, mode);
    }

    qx.FreeTensor(xU);
    qr.FreeTensor(rU);
    qs.FreeTensor(sU);
}

// mode 2: low-sync D-stripe for few rows + wide D. ws: float[cores * rows + rows]
template <typename T>
__aicore__ static void I005RunSplit(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    GM_ADDR ws, uint32_t rows, uint32_t cols, float eps)
{
    AscendC::GlobalTensor<T> xg, rg, gg, bg, og;
    AscendC::GlobalTensor<float> wsGm;
    xg.SetGlobalBuffer((__gm__ T*)x, static_cast<uint64_t>(rows) * cols);
    rg.SetGlobalBuffer((__gm__ T*)residual, static_cast<uint64_t>(rows) * cols);
    gg.SetGlobalBuffer((__gm__ T*)gamma, cols);
    bg.SetGlobalBuffer((__gm__ T*)bias, cols);
    og.SetGlobalBuffer((__gm__ T*)output, static_cast<uint64_t>(rows) * cols);
    uint32_t blk = static_cast<uint32_t>(AscendC::GetBlockIdx());
    uint32_t nb = static_cast<uint32_t>(AscendC::GetBlockNum());
    wsGm.SetGlobalBuffer((__gm__ float*)ws, nb * rows + rows + 8U);

    uint32_t tile = I005_TILE;
    uint32_t stripe = (cols + nb - 1U) / nb;
    uint32_t d0 = blk * stripe;
    uint32_t d1 = d0 + stripe;
    if (d1 > cols) {
        d1 = cols;
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx, qr, qs;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bfA, bfB, bredDst, bredTmp, bu;
    pipe.InitBuffer(qx, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(qr, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(qs, 1, tile * static_cast<uint32_t>(sizeof(T)));
    pipe.InitBuffer(bfA, tile * 4U);
    pipe.InitBuffer(bfB, tile * 4U);
    pipe.InitBuffer(bredDst, 64U);
    pipe.InitBuffer(bredTmp, I005_REDUCE_TMP_BYTES);
    pipe.InitBuffer(bu, tile * 4U);

    AscendC::LocalTensor<T> xU = qx.AllocTensor<T>();
    AscendC::LocalTensor<T> rU = qr.AllocTensor<T>();
    AscendC::LocalTensor<T> sU = qs.AllocTensor<T>();
    AscendC::LocalTensor<float> fA = bfA.Get<float>();
    AscendC::LocalTensor<float> fB = bfB.Get<float>();
    AscendC::LocalTensor<float> redDst = bredDst.Get<float>();
    AscendC::LocalTensor<float> redTmp = bredTmp.Get<float>();
    AscendC::LocalTensor<float> uKeep = bu.Get<float>();

    uint32_t row;
    uint32_t d;
    uint32_t n;
    uint32_t workN;
    for (row = 0; row < rows; ++row) {
        float ss = 0.0f;
        if (d0 < d1) {
            for (d = d0; d < d1; d += tile) {
                n = d1 - d;
                if (n > tile) {
                    n = tile;
                }
                workN = I005Align<T>(n);
                I005SqTile(xg, rg, xU, rU, fA, fB, redDst, redTmp, uKeep, 0,
                           row * cols + d, d, n, workN, ss);
            }
        }
        wsGm.SetValue(blk * rows + row, ss);
    }

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll();

    if (blk == 0) {
        for (row = 0; row < rows; ++row) {
            float total = 0.0f;
            uint32_t k;
            for (k = 0; k < nb; ++k) {
                total += wsGm.GetValue(k * rows + row);
            }
            wsGm.SetValue(nb * rows + row, total);
        }
    }

    AscendC::SyncAll();

    for (row = 0; row < rows; ++row) {
        float ss = wsGm.GetValue(nb * rows + row);
        float invRms = I005InvRms(ss, cols, eps, fA, fB);
        if (d0 >= d1) {
            continue;
        }
        for (d = d0; d < d1; d += tile) {
            n = d1 - d;
            if (n > tile) {
                n = tile;
            }
            workN = I005Align<T>(n);
            I005NormTile(xg, rg, gg, bg, og, xU, rU, sU, fA, fB, uKeep, 0,
                         row * cols + d, d, d, n, workN, invRms);
        }
    }

    qx.FreeTensor(xU);
    qr.FreeTensor(rU);
    qs.FreeTensor(sU);
}

extern "C" __global__ __vector__ void i001_fp32_row(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t cols, float eps, int32_t mode)
{
    I005RunRow<float>(x, residual, gamma, bias, output, rows, cols, eps, mode);
}

extern "C" __global__ __vector__ void i001_fp16_row(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t cols, float eps, int32_t mode)
{
    I005RunRow<half>(x, residual, gamma, bias, output, rows, cols, eps, mode);
}

extern "C" __global__ __vector__ void i001_bf16_row(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t cols, float eps, int32_t mode)
{
    I005RunRow<bfloat16_t>(x, residual, gamma, bias, output, rows, cols, eps, mode);
}

extern "C" __global__ __vector__ void i001_fp32_split(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    GM_ADDR ws, uint32_t rows, uint32_t cols, float eps)
{
    I005RunSplit<float>(x, residual, gamma, bias, output, ws, rows, cols, eps);
}

extern "C" __global__ __vector__ void i001_fp16_split(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    GM_ADDR ws, uint32_t rows, uint32_t cols, float eps)
{
    I005RunSplit<half>(x, residual, gamma, bias, output, ws, rows, cols, eps);
}

extern "C" __global__ __vector__ void i001_bf16_split(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    GM_ADDR ws, uint32_t rows, uint32_t cols, float eps)
{
    I005RunSplit<bfloat16_t>(x, residual, gamma, bias, output, ws, rows, cols, eps);
}

static GM_ADDR I005AllocWs(int64_t floats)
{
    GM_ADDR p = 0;
    size_t bytes = static_cast<size_t>(floats) * sizeof(float);
    if (bytes < 4096U) {
        bytes = 4096U;
    }
    if (aclrtMalloc(reinterpret_cast<void**>(&p), bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return 0;
    }
    aclrtMemset(p, bytes, 0, bytes);
    return p;
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    (void)info_residual;
    (void)info_gamma;
    (void)info_bias;
    (void)info_output;

    if (info_x.numTensors < 1 || info_x.tensors == 0 ||
        info_x.tensors[0].shape == 0 || info_x.tensors[0].numDims < 2 ||
        availableCoreNum <= 0) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    uint64_t rows = 1;
    int64_t axis;
    for (axis = 0; axis + 1 < xInfo.numDims; ++axis) {
        rows *= static_cast<uint64_t>(xInfo.shape[axis]);
    }
    const uint64_t cols64 = static_cast<uint64_t>(xInfo.shape[xInfo.numDims - 1]);
    if (rows == 0 || cols64 == 0 || rows > 0xffffffffULL || cols64 > 0xffffffffULL) {
        return;
    }
    const uint32_t rows32 = static_cast<uint32_t>(rows);
    const uint32_t cols = static_cast<uint32_t>(cols64);
    const int32_t dtype = xInfo.dtype;
    const uint32_t esz = (dtype == I005_DT_FLOAT) ? 4U : 2U;

    // retained-y if full FP32 u row fits comfortably in UB with tile workspace
    const uint64_t retainNeed =
        static_cast<uint64_t>(cols + I005_U_SLACK) * 4U + 4U * I005_TILE_SMALL * esz +
        2U * I005_TILE_SMALL * 4U + I005_REDUCE_TMP_BYTES + 4096U;
    int32_t mode = (retainNeed <= 140ULL * 1024ULL) ? 1 : 0;

    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);
    if (blockNum > 40U) {
        blockNum = 40U;
    }

    int useSplit = 0;
    if (mode == 0 && rows32 <= 4U && cols >= 4096U) {
        useSplit = 1;
        uint32_t want = (cols + 511U) / 512U;
        if (want < 1U) {
            want = 1U;
        }
        if (blockNum > want) {
            blockNum = want;
        }
        if (blockNum < 1U) {
            blockNum = 1U;
        }
    } else {
        if (blockNum > rows32) {
            blockNum = rows32;
        }
    }
    if (blockNum == 0U) {
        return;
    }

    if (useSplit) {
        GM_ADDR ws = I005AllocWs(static_cast<int64_t>(blockNum) * rows32 + rows32 + 8);
        if (ws == 0) {
            useSplit = 0;
        } else {
            if (dtype == I005_DT_FLOAT) {
                i001_fp32_split<<<blockNum, nullptr, stream>>>(
                    x, residual, gamma, bias, output, ws, rows32, cols, epsilon);
            } else if (dtype == I005_DT_FLOAT16) {
                i001_fp16_split<<<blockNum, nullptr, stream>>>(
                    x, residual, gamma, bias, output, ws, rows32, cols, epsilon);
            } else {
                i001_bf16_split<<<blockNum, nullptr, stream>>>(
                    x, residual, gamma, bias, output, ws, rows32, cols, epsilon);
            }
            aclrtSynchronizeStream(stream);
            aclrtFree(ws);
            return;
        }
    }

    if (blockNum > rows32) {
        blockNum = rows32;
    }
    if (blockNum == 0U) {
        return;
    }

    if (dtype == I005_DT_FLOAT) {
        i001_fp32_row<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows32, cols, epsilon, mode);
    } else if (dtype == I005_DT_FLOAT16) {
        i001_fp16_row<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows32, cols, epsilon, mode);
    } else if (dtype == I005_DT_BF16 || dtype == I005_DT_BF16_ACL) {
        i001_bf16_row<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows32, cols, epsilon, mode);
    }
}
