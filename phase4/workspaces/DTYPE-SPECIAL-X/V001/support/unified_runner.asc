#include <acl/acl.h>
#include "kernel_operator.h"

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <ctime>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <sstream>
#include <string>
#include <sys/stat.h>
#include <time.h>
#include <vector>

struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};

struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};

namespace dtype_parent {
#define run_kernel dtype_run_kernel_parent
#include "parent_submission.asc"
#undef run_kernel
}

namespace dtype_candidate {
#define run_kernel dtype_run_kernel_candidate
#include "../submission.asc"
#undef run_kernel
}

static const char* kParentSha =
    "a8c19a1972207acc67e3fb0cd393cc70b0a4b183d1eaf5610edf80c2879b15e3";
static const char* kCandidateSha =
    "e2717055199f541d98d85ceef2e011e52e2749d932ca954dc887868de7db880f";
static const int64_t kRows = 12;
static const int64_t kMaxWidth = 8192;
static const float kEpsilon = 1.0e-5f;
static const int64_t kWidths[] = {64, 65, 127, 128, 129, 1024, 4096, 8192};
static const int64_t kPrefixes[][3] = {{12, 0, 0}, {3, 4, 0}, {1, 2, 6}};
static const int kPrefixRanks[] = {1, 2, 3};

using RunKernel = void (*)(
    GM_ADDR, const TensorGroupInfo&, GM_ADDR, const TensorGroupInfo&,
    GM_ADDR, const TensorGroupInfo&, GM_ADDR, const TensorGroupInfo&,
    GM_ADDR, const TensorGroupInfo&, int64_t, aclrtStream, float);

struct Options {
    std::string mode;
    std::string implementation;
    std::string leaseId;
    std::string owner;
    std::string preflightUtc;
    std::string runnerSha;
    std::string outputPrefix;
    std::string qualificationFile;
    int device = -1;
    int shapeIndex = -1;
    int warmup = 10;
    int samples = 31;
    int blocks = 2;
    int pairs = 4;
};

struct Shape {
    int index;
    int prefixIndex;
    int rank;
    int64_t width;
    std::vector<int64_t> dims;
};

struct Sample {
    double deviceUs;
    double wallUs;
};

struct Stats {
    double median;
    double mean;
    double stdev;
    double cv;
    double min;
    double max;
    double maxMin;
    double mad;
    double p10;
    double p90;
    double spread;
};

static void Fail(const std::string& message)
{
    std::fprintf(stderr, "ERROR: %s\n", message.c_str());
    std::exit(2);
}

static void CheckAcl(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        std::fprintf(stderr, "%s failed: %d %s\n", operation, status,
                     aclGetRecentErrMsg() ? aclGetRecentErrMsg() : "");
        std::exit(2);
    }
}

static bool PathExists(const std::string& path)
{
    struct stat status;
    return stat(path.c_str(), &status) == 0;
}

static int ParseInt(const char* value, const char* name)
{
    char* end = nullptr;
    const long parsed = std::strtol(value, &end, 10);
    if (end == value || *end != '\0' || parsed < -2147483647L ||
        parsed > 2147483647L) {
        Fail(std::string("invalid integer for ") + name);
    }
    return static_cast<int>(parsed);
}

static void PrintUsage(const char* program)
{
    std::printf(
        "Usage: %s --mode correctness|noise-floor|paired --device N "
        "--lease-id ID --owner MAIN-1|MAIN-2 --preflight-utc UTC "
        "--runner-sha256 SHA --out-prefix PATH [options]\n"
        "  correctness: --implementation parent|candidate (all 24 shapes)\n"
        "  noise-floor: --implementation parent|candidate --shape-index 0..23\n"
        "               [--warmup 10] [--samples 31] [--blocks 2]\n"
        "  paired: --shape-index 0..23 --qualification-file PATH\n"
        "          [--warmup 10] [--samples 31] [--pairs 4]\n",
        program);
}

static Options ParseOptions(int argc, char** argv)
{
    Options options;
    for (int i = 1; i < argc; ++i) {
        const std::string key(argv[i]);
        if (key == "--help" || key == "-h") {
            PrintUsage(argv[0]);
            std::exit(0);
        }
        if (i + 1 >= argc) {
            Fail("missing value for " + key);
        }
        const char* value = argv[++i];
        if (key == "--mode") options.mode = value;
        else if (key == "--implementation") options.implementation = value;
        else if (key == "--lease-id") options.leaseId = value;
        else if (key == "--owner") options.owner = value;
        else if (key == "--preflight-utc") options.preflightUtc = value;
        else if (key == "--runner-sha256") options.runnerSha = value;
        else if (key == "--out-prefix") options.outputPrefix = value;
        else if (key == "--qualification-file") options.qualificationFile = value;
        else if (key == "--device") options.device = ParseInt(value, "--device");
        else if (key == "--shape-index") options.shapeIndex = ParseInt(value, "--shape-index");
        else if (key == "--warmup") options.warmup = ParseInt(value, "--warmup");
        else if (key == "--samples") options.samples = ParseInt(value, "--samples");
        else if (key == "--blocks") options.blocks = ParseInt(value, "--blocks");
        else if (key == "--pairs") options.pairs = ParseInt(value, "--pairs");
        else Fail("unknown option " + key);
    }
    return options;
}

static std::time_t ParseUtc(const std::string& text)
{
    std::tm parsed = {};
    std::istringstream input(text);
    input >> std::get_time(&parsed, "%Y-%m-%dT%H:%M:%SZ");
    if (input.fail() || input.peek() != std::char_traits<char>::eof()) {
        Fail("--preflight-utc must use YYYY-MM-DDTHH:MM:SSZ");
    }
    return timegm(&parsed);
}

static void ValidateOptions(const Options& options)
{
    if (options.mode != "correctness" && options.mode != "noise-floor" &&
        options.mode != "paired") {
        Fail("mode must be correctness, noise-floor, or paired");
    }
    if (options.device < 0 || options.leaseId.empty() ||
        (options.owner != "MAIN-1" && options.owner != "MAIN-2") ||
        options.runnerSha.size() != 64 || options.outputPrefix.empty()) {
        Fail("device, active lease identity, owner, runner SHA, and output prefix are required");
    }
    const std::time_t preflight = ParseUtc(options.preflightUtc);
    const std::time_t now = std::time(nullptr);
    if (preflight > now + 60 || now - preflight > 300) {
        Fail("preflight timestamp is more than five minutes old or is in the future");
    }
    if (options.mode == "correctness") {
        if (options.implementation != "parent" && options.implementation != "candidate") {
            Fail("correctness requires --implementation parent|candidate");
        }
    } else if (options.mode == "noise-floor") {
        if (options.implementation != "parent" && options.implementation != "candidate") {
            Fail("noise-floor requires --implementation parent|candidate");
        }
        if (options.shapeIndex < 0 || options.shapeIndex >= 24 ||
            options.warmup < 10 || options.samples < 21 || options.blocks != 2) {
            Fail("noise-floor requires shape 0..23, warmup >=10, samples >=21, and exactly two blocks");
        }
    } else if (options.shapeIndex < 0 || options.shapeIndex >= 24 ||
               options.warmup < 10 || options.samples < 21 || options.pairs < 4 ||
               options.qualificationFile.empty()) {
        Fail("paired requires shape 0..23, qualification file, warmup >=10, "
             "samples >=21, and pairs >=4");
    }
}

static Shape GetShape(int index)
{
    Shape shape;
    shape.index = index;
    shape.prefixIndex = index / 8;
    shape.rank = kPrefixRanks[shape.prefixIndex] + 1;
    shape.width = kWidths[index % 8];
    for (int i = 0; i < shape.rank - 1; ++i) {
        shape.dims.push_back(kPrefixes[shape.prefixIndex][i]);
    }
    shape.dims.push_back(shape.width);
    return shape;
}

static double Quantile(const std::vector<double>& sorted, double fraction)
{
    const size_t rank = static_cast<size_t>(std::ceil(fraction * sorted.size()));
    const size_t index = rank == 0 ? 0 : std::min(rank - 1, sorted.size() - 1);
    return sorted[index];
}

static double Median(std::vector<double> values)
{
    std::sort(values.begin(), values.end());
    const size_t middle = values.size() / 2;
    if (values.size() % 2 != 0) return values[middle];
    return (values[middle - 1] + values[middle]) * 0.5;
}

static Stats CalculateStats(const std::vector<Sample>& samples)
{
    std::vector<double> values;
    values.reserve(samples.size());
    double sum = 0.0;
    double minimum = samples.front().deviceUs;
    double maximum = samples.front().deviceUs;
    for (const Sample& sample : samples) {
        values.push_back(sample.deviceUs);
        sum += sample.deviceUs;
        minimum = std::min(minimum, sample.deviceUs);
        maximum = std::max(maximum, sample.deviceUs);
    }
    std::vector<double> sorted = values;
    std::sort(sorted.begin(), sorted.end());
    const double mean = sum / values.size();
    double variance = 0.0;
    for (double value : values) variance += (value - mean) * (value - mean);
    variance /= values.size();
    const double median = Median(values);
    std::vector<double> deviations;
    deviations.reserve(values.size());
    for (double value : values) deviations.push_back(std::fabs(value - median));
    return {median, mean, std::sqrt(variance), std::sqrt(variance) / mean,
            minimum, maximum, minimum > 0.0 ? maximum / minimum : 0.0,
            Median(deviations), Quantile(sorted, 0.10), Quantile(sorted, 0.90),
            maximum - minimum};
}

static std::string ShapeText(const Shape& shape)
{
    std::ostringstream text;
    for (size_t i = 0; i < shape.dims.size(); ++i) {
        if (i != 0) text << 'x';
        text << shape.dims[i];
    }
    return text.str();
}

static RunKernel SelectKernel(const std::string& implementation)
{
    return implementation == "parent" ? dtype_parent::dtype_run_kernel_parent
                                        : dtype_candidate::dtype_run_kernel_candidate;
}

class Runtime {
public:
    explicit Runtime(int device) : device_(device)
    {
        const size_t maxElements = static_cast<size_t>(kRows * kMaxWidth);
        x_.resize(maxElements);
        residual_.resize(maxElements);
        output_.resize(maxElements);
        gamma_.resize(kMaxWidth);
        bias_.resize(kMaxWidth);
        for (size_t i = 0; i < maxElements; ++i) {
            x_[i] = 0.19f * std::sin(static_cast<float>((i * 17) % 997) * 0.013f);
            residual_[i] = 0.11f * std::cos(static_cast<float>((i * 29) % 991) * 0.017f);
        }
        for (int64_t col = 0; col < kMaxWidth; ++col) {
            gamma_[col] = 0.85f + static_cast<float>(col % 23) * 0.002f;
            bias_[col] = -0.025f + static_cast<float>(col % 19) * 0.001f;
        }

        CheckAcl(aclInit(nullptr), "aclInit");
        CheckAcl(aclrtSetDevice(device_), "aclrtSetDevice");
        CheckAcl(aclrtCreateStream(&stream_), "aclrtCreateStream");
        CheckAcl(aclrtCreateEvent(&startEvent_), "aclrtCreateEvent(start)");
        CheckAcl(aclrtCreateEvent(&stopEvent_), "aclrtCreateEvent(stop)");
        CheckAcl(aclrtMalloc(&dx_, maxElements * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc x");
        CheckAcl(aclrtMalloc(&dr_, maxElements * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc residual");
        CheckAcl(aclrtMalloc(&dg_, kMaxWidth * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc gamma");
        CheckAcl(aclrtMalloc(&db_, kMaxWidth * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc bias");
        CheckAcl(aclrtMalloc(&dout_, maxElements * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc output");
    }

    void CopyInputs(const Shape& shape)
    {
        const size_t elements = static_cast<size_t>(kRows * shape.width);
        const size_t dataBytes = elements * sizeof(float);
        const size_t paramBytes = static_cast<size_t>(shape.width) * sizeof(float);
        CheckAcl(aclrtMemcpy(dx_, dataBytes, x_.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy x");
        CheckAcl(aclrtMemcpy(dr_, dataBytes, residual_.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy residual");
        CheckAcl(aclrtMemcpy(dg_, paramBytes, gamma_.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy gamma");
        CheckAcl(aclrtMemcpy(db_, paramBytes, bias_.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy bias");
    }

    void Launch(RunKernel kernel, const Shape& shape)
    {
        const TensorInfo dataInfo{shape.dims.data(), static_cast<int64_t>(shape.dims.size()), 0};
        const TensorInfo paramInfo{&shape.width, 1, 0};
        const TensorGroupInfo dataGroup{&dataInfo, 1};
        const TensorGroupInfo paramGroup{&paramInfo, 1};
        kernel((GM_ADDR)dx_, dataGroup,
               (GM_ADDR)dr_, dataGroup,
               (GM_ADDR)dg_, paramGroup,
               (GM_ADDR)db_, paramGroup,
               (GM_ADDR)dout_, dataGroup,
               8, stream_, kEpsilon);
    }

    void Warmup(RunKernel kernel, const Shape& shape, int count)
    {
        for (int i = 0; i < count; ++i) {
            Launch(kernel, shape);
            CheckAcl(aclrtSynchronizeStream(stream_), "warmup synchronize");
        }
    }

    Sample TimedLaunch(RunKernel kernel, const Shape& shape)
    {
        const auto wallStart = std::chrono::steady_clock::now();
        CheckAcl(aclrtRecordEvent(startEvent_, stream_), "record start event");
        Launch(kernel, shape);
        CheckAcl(aclrtRecordEvent(stopEvent_, stream_), "record stop event");
        CheckAcl(aclrtSynchronizeEvent(stopEvent_), "synchronize stop event");
        const auto wallStop = std::chrono::steady_clock::now();
        float elapsedMs = 0.0f;
        CheckAcl(aclrtEventElapsedTime(&elapsedMs, startEvent_, stopEvent_), "event elapsed time");
        const double wallUs = std::chrono::duration<double, std::micro>(wallStop - wallStart).count();
        return {static_cast<double>(elapsedMs) * 1000.0, wallUs};
    }

    void CopyOutput(const Shape& shape)
    {
        const size_t bytes = static_cast<size_t>(kRows * shape.width) * sizeof(float);
        CheckAcl(aclrtMemcpy(output_.data(), bytes, dout_, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy output");
    }

    void Synchronize(const char* operation)
    {
        CheckAcl(aclrtSynchronizeStream(stream_), operation);
    }

    float InputX(size_t index) const { return x_[index]; }
    float InputResidual(size_t index) const { return residual_[index]; }
    float Gamma(size_t index) const { return gamma_[index]; }
    float Bias(size_t index) const { return bias_[index]; }
    float Output(size_t index) const { return output_[index]; }

    void Close()
    {
        CheckAcl(aclrtFree(dout_), "free output");
        CheckAcl(aclrtFree(db_), "free bias");
        CheckAcl(aclrtFree(dg_), "free gamma");
        CheckAcl(aclrtFree(dr_), "free residual");
        CheckAcl(aclrtFree(dx_), "free x");
        CheckAcl(aclrtDestroyEvent(stopEvent_), "destroy stop event");
        CheckAcl(aclrtDestroyEvent(startEvent_), "destroy start event");
        CheckAcl(aclrtDestroyStream(stream_), "destroy stream");
        CheckAcl(aclrtResetDevice(device_), "aclrtResetDevice");
        CheckAcl(aclFinalize(), "aclFinalize");
    }

private:
    int device_;
    aclrtStream stream_ = nullptr;
    aclrtEvent startEvent_ = nullptr;
    aclrtEvent stopEvent_ = nullptr;
    void* dx_ = nullptr;
    void* dr_ = nullptr;
    void* dg_ = nullptr;
    void* db_ = nullptr;
    void* dout_ = nullptr;
    std::vector<float> x_;
    std::vector<float> residual_;
    std::vector<float> output_;
    std::vector<float> gamma_;
    std::vector<float> bias_;
};

static void WriteMetadata(std::ostream& out, const Options& options,
                          const Shape& shape)
{
    out << "route=DTYPE-SPECIAL-X\n"
        << "revision=V001\n"
        << "mode=" << options.mode << "\n"
        << "implementation=" << options.implementation << "\n"
        << "shape_index=" << shape.index << "\n"
        << "shape=" << ShapeText(shape) << "\n"
        << "rows=" << kRows << "\n"
        << "epsilon=" << std::setprecision(9) << kEpsilon << "\n"
        << "available_core_num=8\n"
        << "device=" << options.device << "\n"
        << "owner=" << options.owner << "\n"
        << "lease_id=" << options.leaseId << "\n"
        << "preflight_utc=" << options.preflightUtc << "\n"
        << "runner_sha256=" << options.runnerSha << "\n"
        << "parent_source_sha256=" << kParentSha << "\n"
        << "candidate_source_sha256=" << kCandidateSha << "\n";
}

static std::vector<Sample> RunBlock(Runtime& runtime, RunKernel kernel,
                                    const Shape& shape, const std::string& role,
                                    int pairIndex, const std::string& order,
                                    int sampleCount, std::ostream& raw)
{
    std::vector<Sample> samples;
    samples.reserve(sampleCount);
    for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex) {
        const Sample sample = runtime.TimedLaunch(kernel, shape);
        samples.push_back(sample);
        raw << shape.index << '\t' << role << '\t' << pairIndex << '\t'
            << order << '\t' << sampleIndex << '\t'
            << std::fixed << std::setprecision(6) << sample.deviceUs << '\t'
            << sample.wallUs << '\n';
        raw.flush();
    }
    return samples;
}

static void WriteStats(std::ostream& jitter, const Shape& shape,
                       const std::string& role, int pairIndex,
                       const std::string& order, const std::vector<Sample>& samples)
{
    const Stats stats = CalculateStats(samples);
    jitter << "block\t" << shape.index << '\t' << role << '\t' << pairIndex << '\t'
           << order << '\t' << samples.size() << '\t'
           << std::fixed << std::setprecision(6)
           << stats.median << '\t' << stats.mean << '\t' << stats.stdev << '\t'
           << stats.cv << '\t' << stats.min << '\t' << stats.max << '\t'
           << stats.maxMin << '\t' << stats.mad << '\t' << stats.p10 << '\t'
           << stats.p90 << '\t' << stats.spread << '\n';
    jitter.flush();
}

static std::string ReadField(const std::string& path, const std::string& field)
{
    std::ifstream input(path.c_str());
    if (!input) Fail("cannot open qualification file: " + path);
    const std::string prefix = field + "=";
    std::string line;
    while (std::getline(input, line)) {
        if (line.compare(0, prefix.size(), prefix) == 0) return line.substr(prefix.size());
    }
    return "";
}

static void ValidateQualification(const Options& options)
{
    const std::string path = options.qualificationFile;
    if (ReadField(path, "route") != "DTYPE-SPECIAL-X" ||
        ReadField(path, "revision") != "V001" ||
        ReadField(path, "mode") != "noise-floor" ||
        ReadField(path, "implementation") != "parent" ||
        ReadField(path, "qualification") != "PASS" ||
        ReadField(path, "shape_index") != std::to_string(options.shapeIndex) ||
        ReadField(path, "runner_sha256") != options.runnerSha ||
        ReadField(path, "parent_source_sha256") != kParentSha ||
        ReadField(path, "candidate_source_sha256") != kCandidateSha) {
        Fail("paired mode requires a PASS parent noise-floor record for this shape and runner");
    }
}

static void RunCorrectness(Runtime& runtime, const Options& options)
{
    const std::string path = options.outputPrefix + ".correctness.tsv";
    if (PathExists(path)) Fail("refusing to overwrite existing correctness evidence: " + path);
    std::ofstream result(path.c_str());
    if (!result) Fail("cannot create correctness output: " + path);
    result << "shape_index\tshape\timplementation\tstatus\tfailures\tmax_abs\n";
    bool passed = true;
    for (int shapeIndex = 0; shapeIndex < 24; ++shapeIndex) {
        const Shape shape = GetShape(shapeIndex);
        runtime.CopyInputs(shape);
        const RunKernel kernel = SelectKernel(options.implementation);
        runtime.Launch(kernel, shape);
        // Correctness reads are outside any performance sample.
        runtime.Synchronize("correctness synchronize");
        runtime.CopyOutput(shape);
        float maxAbs = 0.0f;
        size_t failures = 0;
        for (int64_t row = 0; row < kRows; ++row) {
            float squareSum = 0.0f;
            for (int64_t col = 0; col < shape.width; ++col) {
                const size_t index = static_cast<size_t>(row * shape.width + col);
                const float value = runtime.InputX(index) + runtime.InputResidual(index);
                squareSum += value * value;
            }
            const float invRms = 1.0f / std::sqrt(
                squareSum / static_cast<float>(shape.width) + kEpsilon);
            for (int64_t col = 0; col < shape.width; ++col) {
                const size_t index = static_cast<size_t>(row * shape.width + col);
                const float value = runtime.InputX(index) + runtime.InputResidual(index);
                const float expected = value * invRms * runtime.Gamma(col) + runtime.Bias(col);
                const float error = std::fabs(runtime.Output(index) - expected);
                maxAbs = std::max(maxAbs, error);
                if (error > 1.0e-4f + 1.0e-4f * std::fabs(expected)) ++failures;
            }
        }
        passed = passed && failures == 0;
        result << shape.index << '\t' << ShapeText(shape) << '\t'
               << options.implementation << '\t' << (failures == 0 ? "PASS" : "FAIL")
               << '\t' << failures << '\t' << std::setprecision(9) << maxAbs << '\n';
        result.flush();
        std::printf("shape_index=%d shape=%s implementation=%s correctness=%s failures=%zu max_abs=%.9g\n",
                    shape.index, ShapeText(shape).c_str(), options.implementation.c_str(),
                    failures == 0 ? "PASS" : "FAIL", failures, maxAbs);
    }
    if (!passed) Fail("correctness failed; see retained correctness evidence");
}

static void RunNoiseFloor(Runtime& runtime, const Options& options,
                          std::ostream& raw, std::ostream& jitter)
{
    const Shape shape = GetShape(options.shapeIndex);
    const RunKernel kernel = SelectKernel(options.implementation);
    runtime.CopyInputs(shape);
    runtime.Warmup(kernel, shape, options.warmup);
    std::vector<double> blockMedians;
    bool blockPass = true;
    for (int block = 0; block < options.blocks; ++block) {
        const std::vector<Sample> samples = RunBlock(
            runtime, kernel, shape, options.implementation, block, "SAME",
            options.samples, raw);
        const Stats stats = CalculateStats(samples);
        blockMedians.push_back(stats.median);
        const bool pass = stats.mad / stats.median <= 0.10;
        blockPass = blockPass && pass;
        WriteStats(jitter, shape, options.implementation, block, "SAME", samples);
        std::printf("block=%d implementation=%s median_us=%.6f mad_over_median=%.6f verdict=%s\n",
                    block, options.implementation.c_str(), stats.median,
                    stats.mad / stats.median, pass ? "PASS" : "NEEDS_VALIDATION");
    }
    const double medianOfBlocks = Median(blockMedians);
    const double maxDrift = std::fabs(blockMedians[0] - blockMedians[1]) / medianOfBlocks;
    const bool parentQualified = options.implementation == "parent" && blockPass && maxDrift <= 0.10;
    jitter << "qualification=" << (options.implementation != "parent" ? "NOT_PARENT_QUALIFICATION" :
                  parentQualified ? "PASS" : "NEEDS_VALIDATION") << '\n'
           << "block_median_drift=" << std::fixed << std::setprecision(6) << maxDrift << '\n';
    jitter.flush();
    std::printf("shape_index=%d implementation=%s block_median_drift=%.6f qualification=%s\n",
                shape.index, options.implementation.c_str(), maxDrift,
                options.implementation != "parent" ? "NOT_PARENT_QUALIFICATION" :
                parentQualified ? "PASS" : "NEEDS_VALIDATION");
}

static void RunPaired(Runtime& runtime, const Options& options,
                      std::ostream& raw, std::ostream& jitter)
{
    const Shape shape = GetShape(options.shapeIndex);
    runtime.CopyInputs(shape);
    for (int i = 0; i < options.warmup; ++i) {
        const RunKernel first = (i % 2 == 0) ? dtype_parent::dtype_run_kernel_parent
                                             : dtype_candidate::dtype_run_kernel_candidate;
        const RunKernel second = (i % 2 == 0) ? dtype_candidate::dtype_run_kernel_candidate
                                              : dtype_parent::dtype_run_kernel_parent;
        runtime.Launch(first, shape);
        runtime.Synchronize("paired parent/candidate warmup sync");
        runtime.Launch(second, shape);
        runtime.Synchronize("paired candidate/parent warmup sync");
    }

    std::ofstream pairOutput((options.outputPrefix + ".pairs.tsv").c_str());
    if (!pairOutput) Fail("cannot create paired summary output");
    pairOutput << "pair\torder\tparent_median_us\tcandidate_median_us\tdelta_pct_candidate_vs_parent\n";
    for (int pair = 0; pair < options.pairs; ++pair) {
        const bool parentFirst = pair % 2 == 0;
        const std::string order = parentFirst ? "PC" : "CP";
        const std::vector<Sample> parentSamples = parentFirst
            ? RunBlock(runtime, dtype_parent::dtype_run_kernel_parent, shape, "parent", pair, order, options.samples, raw)
            : std::vector<Sample>();
        const std::vector<Sample> candidateSamples = parentFirst
            ? RunBlock(runtime, dtype_candidate::dtype_run_kernel_candidate, shape, "candidate", pair, order, options.samples, raw)
            : std::vector<Sample>();
        const std::vector<Sample> reverseCandidateSamples = parentFirst
            ? std::vector<Sample>()
            : RunBlock(runtime, dtype_candidate::dtype_run_kernel_candidate, shape, "candidate", pair, order, options.samples, raw);
        const std::vector<Sample> reverseParentSamples = parentFirst
            ? std::vector<Sample>()
            : RunBlock(runtime, dtype_parent::dtype_run_kernel_parent, shape, "parent", pair, order, options.samples, raw);
        const std::vector<Sample>& p = parentFirst ? parentSamples : reverseParentSamples;
        const std::vector<Sample>& c = parentFirst ? candidateSamples : reverseCandidateSamples;
        WriteStats(jitter, shape, "parent", pair, order, p);
        WriteStats(jitter, shape, "candidate", pair, order, c);
        const double parentMedian = CalculateStats(p).median;
        const double candidateMedian = CalculateStats(c).median;
        const double deltaPct = (candidateMedian / parentMedian - 1.0) * 100.0;
        pairOutput << pair << '\t' << order << '\t' << std::fixed << std::setprecision(6)
                   << parentMedian << '\t' << candidateMedian << '\t' << deltaPct << '\n';
        pairOutput.flush();
        std::printf("pair=%d order=%s parent_median_us=%.6f candidate_median_us=%.6f delta_pct=%.4f\n",
                    pair, order.c_str(), parentMedian, candidateMedian, deltaPct);
    }
}

int main(int argc, char** argv)
{
    const Options options = ParseOptions(argc, argv);
    ValidateOptions(options);
    const std::string rawPath = options.outputPrefix + ".raw.tsv";
    const std::string jitterPath = options.outputPrefix + ".jitter.txt";
    const std::string correctnessPath = options.outputPrefix + ".correctness.tsv";
    const std::string pairsPath = options.outputPrefix + ".pairs.tsv";
    if ((options.mode == "correctness" && PathExists(correctnessPath)) ||
        (options.mode != "correctness" && (PathExists(rawPath) || PathExists(jitterPath))) ||
        (options.mode == "paired" && PathExists(pairsPath))) {
        Fail("refusing to overwrite existing evidence; choose a new output prefix");
    }
    if (options.mode == "paired") ValidateQualification(options);

    std::printf("route=DTYPE-SPECIAL-X revision=V001 mode=%s device=%d owner=%s lease_id=%s\n",
                options.mode.c_str(), options.device, options.owner.c_str(), options.leaseId.c_str());
    WriteMetadata(std::cout, options, GetShape(options.shapeIndex >= 0 ? options.shapeIndex : 0));
    Runtime runtime(options.device);
    if (options.mode == "correctness") {
        RunCorrectness(runtime, options);
    } else {
        const Shape shape = GetShape(options.shapeIndex);
        std::ofstream raw(rawPath.c_str());
        std::ofstream jitter(jitterPath.c_str());
        if (!raw || !jitter) Fail("cannot create raw/jitter output files");
        WriteMetadata(jitter, options, shape);
        raw << "shape_index\trole\tpair\torder\tsample\tdevice_us\twall_us\n";
        jitter << "block_header\tshape_index\trole\tpair\torder\tsamples\tmedian_device_us\tmean_device_us\tstdev_device_us\tcv_device\tmin_device_us\tmax_device_us\tmax_min\tmad_device_us\tp10_device_us\tp90_device_us\tabsolute_spread_us\n";
        raw.flush();
        jitter.flush();
        if (options.mode == "noise-floor") RunNoiseFloor(runtime, options, raw, jitter);
        else RunPaired(runtime, options, raw, jitter);
    }
    runtime.Close();
    return 0;
}
