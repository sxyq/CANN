{
    int64_t shape_x[3] = {2, 3, 128};
    TensorInfo tx{shape_x, 3, 1};
    TensorInfo t1 = tx;
    TensorInfo t2 = tx;
    TensorInfo t3 = tx;
    TensorInfo t4 = tx;
    TensorGroupInfo gx{&tx, 1};
    TensorGroupInfo gr{&t1, 1};
    TensorGroupInfo gg{&t2, 1};
