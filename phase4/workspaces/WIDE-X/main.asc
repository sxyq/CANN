#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) \
    do { \
        aclError _ret = (expr); \
        if (_ret != 0) { \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); \
            return 1; \
        } \
    } while (0)
#define FILE_CHECK(expr) \
    do { \
        if (!(expr)) { \
            fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); \
            return 1; \
        } \
    } while (0)

#include "submission.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    // Rank-3 FP16 wide-D smoke case: 2 x 3 x 2048
    int64_t x_0_shape[] = {2, 3, 2048};
    TensorInfo x_tensors[] = {{x_0_shape, 3, 1}};
    TensorGroupInfo info_x = {x_tensors, 1};
    int64_t residual_0_shape[] = {2, 3, 2048};
    TensorInfo residual_tensors[] = {{residual_0_shape, 3, 1}};
    TensorGroupInfo info_residual = {residual_tensors, 1};
    int64_t gamma_0_shape[] = {2048};
    TensorInfo gamma_tensors[] = {{gamma_0_shape, 1, 1}};
    TensorGroupInfo info_gamma = {gamma_tensors, 1};
    int64_t bias_0_shape[] = {2048};
    TensorInfo bias_tensors[] = {{bias_0_shape, 1, 1}};
    TensorGroupInfo info_bias = {bias_tensors, 1};
    int64_t output_0_shape[] = {2, 3, 2048};
    TensorInfo output_tensors[] = {{output_0_shape, 3, 1}};
    TensorGroupInfo info_output = {output_tensors, 1};

    float epsilon = 1e-5f;
    const size_t xyBytes = 2ULL * 3ULL * 2048ULL * sizeof(uint16_t);
    const size_t gbBytes = 2048ULL * sizeof(uint16_t);

    uint8_t *inputHost_x = nullptr, *inputDevice_x = nullptr;
    uint8_t *inputHost_residual = nullptr, *inputDevice_residual = nullptr;
    uint8_t *inputHost_gamma = nullptr, *inputDevice_gamma = nullptr;
    uint8_t *inputHost_bias = nullptr, *inputDevice_bias = nullptr;
    uint8_t *outputHost_output = nullptr, *outputDevice_output = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x, xyBytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x, xyBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x.bin", xyBytes, inputHost_x, xyBytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_x, xyBytes, inputHost_x, xyBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_residual, xyBytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_residual, xyBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/residual.bin", xyBytes, inputHost_residual, xyBytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_residual, xyBytes, inputHost_residual, xyBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_gamma, gbBytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_gamma, gbBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/gamma.bin", gbBytes, inputHost_gamma, gbBytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_gamma, gbBytes, inputHost_gamma, gbBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_bias, gbBytes));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_bias, gbBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/bias.bin", gbBytes, inputHost_bias, gbBytes));
    ACL_CHECK(aclrtMemcpy(inputDevice_bias, gbBytes, inputHost_bias, gbBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_output, xyBytes));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_output, xyBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_x, info_x, (GM_ADDR)inputDevice_residual, info_residual,
        (GM_ADDR)inputDevice_gamma, info_gamma, (GM_ADDR)inputDevice_bias, info_bias,
        (GM_ADDR)outputDevice_output, info_output, availableCoreNum, stream, epsilon);
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 3000);
    if (sync_ret_ != 0) {
        fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_);
        return 1;
    }

    ACL_CHECK(aclrtMemcpy(outputHost_output, xyBytes, outputDevice_output, xyBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/output.bin", outputHost_output, xyBytes));

    if (inputDevice_x) aclrtFree(inputDevice_x);
    if (inputHost_x) aclrtFreeHost(inputHost_x);
    if (inputDevice_residual) aclrtFree(inputDevice_residual);
    if (inputHost_residual) aclrtFreeHost(inputHost_residual);
    if (inputDevice_gamma) aclrtFree(inputDevice_gamma);
    if (inputHost_gamma) aclrtFreeHost(inputHost_gamma);
    if (inputDevice_bias) aclrtFree(inputDevice_bias);
    if (inputHost_bias) aclrtFreeHost(inputHost_bias);
    if (outputDevice_output) aclrtFree(outputDevice_output);
    if (outputHost_output) aclrtFreeHost(outputHost_output);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
