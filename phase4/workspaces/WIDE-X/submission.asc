#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

// WIDE-X V002 — Hierarchical UB Reduction (RE-hardened)
// Row-owned cores (no D-slice / no SyncAll). Near-full u residency when UB allows.
// V002 change: GetValue reference sumsq for tiny/medium D; hierarchical leaf ReduceSum
// only on wide D with explicit int32_t counts and 8B-aligned leaf dest. Full TQue free.

namespace wide_x_v002 {

constexpr uint32_t kReduceTmpBytes = 8 * 1024;
constexpr uint32_t kStripeFp32 = 1024;
constexpr uint32_t kStripeHalf = 1536;
constexpr uint32_t kLeaf = 256;
// Below this width, use scalar GetValue sumsq (T02-tiny safe).
constexpr uint32_t kHierMinD = 512;
// Keep every Level-2 vector op well under repeat/mask limits (FP32 breaks near 256).
constexpr uint32_t kVecChunk = 64;

__aicore__ inline uint32_t Align32(uint32_t bytes)
{
    return (bytes + 31U) & ~31U;
}

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline uint8_t RightPadBytes(uint32_t bytes)
{
    uint32_t rem = bytes % 32U;
    return rem == 0U ? static_cast<uint8_t>(0) : static_cast<uint8_t>(32U - rem);
}

template <typename T>
__aicore__ inline void CopyInPad(AscendC::LocalTensor<T> dst, const AscendC::GlobalTensor<T>& src,
    uint32_t len)
{
    const uint32_t bytes = len * static_cast<uint32_t>(sizeof(T));
    const uint8_t rpad = RightPadBytes(bytes);
    AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
    AscendC::DataCopyPadExtParams<T> padParams{rpad != 0, 0, rpad, 0};
    AscendC::DataCopyPad(dst, src, copyParams, padParams);
}

template <typename T>
__aicore__ inline void CopyOutPad(const AscendC::GlobalTensor<T>& dst, AscendC::LocalTensor<T> src,
    uint32_t len)
{
    const uint32_t bytes = len * static_cast<uint32_t>(sizeof(T));
    AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
    AscendC::DataCopyPad(dst, src, copyParams);
}

template <typename T>
class HierUbKernel {
public:
    __aicore__ inline HierUbKernel(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
        uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores)
    {
        rows_ = rows;
        d_ = d;
        epsilon_ = epsilon;
        invD_ = invD;
        usedCores_ = usedCores == 0 ? 1U : usedCores;
        stripe_ = (sizeof(T) == 4) ? kStripeFp32 : kStripeHalf;
        if (stripe_ > d_) {
            stripe_ = d_;
        }
        if (stripe_ == 0) {
            stripe_ = 1;
        }

        const uint32_t block = AscendC::GetBlockIdx();
        const uint32_t base = rows_ / usedCores_;
        const uint32_t extra = rows_ % usedCores_;
        firstRow_ = block * base + (block < extra ? block : extra);
        rowsThisCore_ = base + (block < extra ? 1U : 0U);

        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), static_cast<uint64_t>(rows_) * d_);
        res_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual), static_cast<uint64_t>(rows_) * d_);
        gam_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma), d_);
        bias_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias), d_);
        out_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), static_cast<uint64_t>(rows_) * d_);

        const uint32_t uElems = d_ + 32U;
        const uint32_t tileElems = stripe_ + 32U;
        const uint32_t inElems = stripe_ + 32U;
        const uint32_t uBytes = Align32(uElems * static_cast<uint32_t>(sizeof(float)));
        const uint32_t tileBytes = Align32(tileElems * static_cast<uint32_t>(sizeof(float)));
        const uint32_t inBytes = Align32(inElems * static_cast<uint32_t>(sizeof(T)));
        const uint32_t fixed = tileBytes * 3U + kReduceTmpBytes + 256U + inBytes * 2U;
        resident_ = (static_cast<uint64_t>(uBytes) + fixed) <= (176U * 1024U);

        pipe_->InitBuffer(xQue_, 1, inBytes);
        pipe_->InitBuffer(rQue_, 1, inBytes);
        pipe_->InitBuffer(gQue_, 1, inBytes);
        pipe_->InitBuffer(bQue_, 1, inBytes);
        pipe_->InitBuffer(yQue_, 1, inBytes);
        pipe_->InitBuffer(uBuf_, resident_ ? uBytes : tileBytes);
        pipe_->InitBuffer(workA_, tileBytes);
        pipe_->InitBuffer(workB_, tileBytes);
        pipe_->InitBuffer(workC_, tileBytes);
        // Dedicated 8B-aligned ReduceSum dest + separate 8KiB tmp (judge ABI).
        pipe_->InitBuffer(leafBuf_, 32);
        pipe_->InitBuffer(reduceTmp_, kReduceTmpBytes);
        pipe_->InitBuffer(scalarBuf_, 64);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t r = 0; r < rowsThisCore_; ++r) {
            ProcessRow((firstRow_ + r) * d_);
        }
    }

private:
    __aicore__ inline void AddUStripe(AscendC::LocalTensor<float> uSeg, uint32_t rowOff, uint32_t colOff,
        uint32_t len)
    {
        for (uint32_t off = 0; off < len; off += kVecChunk) {
            const uint32_t n32 = MinU32(kVecChunk, len - off);
            const int32_t n = static_cast<int32_t>(n32);
            AscendC::LocalTensor<T> xLocal = xQue_.AllocTensor<T>();
            AscendC::LocalTensor<T> rLocal = rQue_.AllocTensor<T>();
            CopyInPad<T>(xLocal, x_[rowOff + colOff + off], n32);
            CopyInPad<T>(rLocal, res_[rowOff + colOff + off], n32);
            xQue_.EnQue(xLocal);
            rQue_.EnQue(rLocal);
            xLocal = xQue_.DeQue<T>();
            rLocal = rQue_.DeQue<T>();
            if constexpr (sizeof(T) == 4) {
                AscendC::LocalTensor<float> xF = xLocal;
                AscendC::LocalTensor<float> rF = rLocal;
                AscendC::Add<float>(uSeg[off], xF, rF, n);
            } else {
                AscendC::LocalTensor<float> xF = workB_.Get<float>();
                AscendC::LocalTensor<float> rF = workC_.Get<float>();
                AscendC::Cast<float, T>(xF, xLocal, AscendC::RoundMode::CAST_NONE, n);
                AscendC::Cast<float, T>(rF, rLocal, AscendC::RoundMode::CAST_NONE, n);
                AscendC::Add<float>(uSeg[off], xF, rF, n);
            }
            xQue_.FreeTensor(xLocal);
            rQue_.FreeTensor(rLocal);
        }
    }

    __aicore__ inline void SyncVToS()
    {
        const auto ev = GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(ev);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(ev);
    }

    __aicore__ inline void SyncMte2ToV()
    {
        const auto ev = GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE2_V);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ev);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ev);
    }

    // Hierarchical UB sumsq: 64-wide leaf ReduceSum (8B-aligned dest) -> running Add.
    // No GetValue over D (breaks on wide FP32 / some multi-row). T02-tiny safe (single leaf).
    __aicore__ inline float SumSqChunked(AscendC::LocalTensor<float> uLocal, uint32_t rowOff)
    {
        AscendC::LocalTensor<float> reduceTmp = reduceTmp_.Get<float>();
        AscendC::LocalTensor<float> acc = scalarBuf_.Get<float>();
        AscendC::LocalTensor<float> leaf = leafBuf_.Get<float>();
        AscendC::LocalTensor<float> sq = workA_.Get<float>();
        const int32_t one = 1;

        AscendC::Duplicate<float>(acc, 0.0f, one);
        for (uint32_t colOff = 0; colOff < d_; colOff += kVecChunk) {
            const uint32_t len = MinU32(kVecChunk, d_ - colOff);
            const int32_t n = static_cast<int32_t>(len);
            if (!resident_) {
                AddUStripe(uLocal, rowOff, colOff, len);
            }
            AscendC::LocalTensor<float> uSeg = resident_ ? uLocal[colOff] : uLocal;
            AscendC::Mul<float>(sq, uSeg, uSeg, n);
            AscendC::ReduceSum<float, true>(leaf, sq, reduceTmp, n);
            AscendC::Add<float>(acc, acc, leaf, one);
        }
        SyncVToS();
        return acc.GetValue(0);
    }

    __aicore__ inline float SumSq(AscendC::LocalTensor<float> uLocal, uint32_t rowOff)
    {
        return SumSqChunked(uLocal, rowOff);
    }

    __aicore__ inline float InvRms(float sumSq)
    {
        const int32_t one = 1;
        AscendC::LocalTensor<float> s = scalarBuf_.Get<float>();
        AscendC::LocalTensor<float> tmp = workC_.Get<float>();
        AscendC::LocalTensor<float> oneT = leafBuf_.Get<float>();
        const float mean = sumSq * invD_ + epsilon_;
        s.SetValue(0, mean);
        oneT.SetValue(0, 1.0f);
        AscendC::Sqrt<float>(tmp, s, one);
        AscendC::Div<float>(s, oneT, tmp, one);
        // Newton polish for 1/sqrt(mean): y <- y * (1.5 - 0.5 * mean * y * y)
        AscendC::Mul<float>(tmp, s, s, one);
        AscendC::Muls<float>(tmp, tmp, mean, one);
        AscendC::Muls<float>(tmp, tmp, -0.5f, one);
        AscendC::Adds<float>(tmp, tmp, 1.5f, one);
        AscendC::Mul<float>(s, s, tmp, one);
        SyncVToS();
        return s.GetValue(0);
    }

    __aicore__ inline void Epilogue(AscendC::LocalTensor<float> uLocal, uint32_t rowOff, float invRms)
    {
        for (uint32_t colOff = 0; colOff < d_; colOff += stripe_) {
            const uint32_t len = MinU32(stripe_, d_ - colOff);
            if (!resident_) {
                AddUStripe(uLocal, rowOff, colOff, len);
            }
            AscendC::LocalTensor<float> uSeg = resident_ ? uLocal[colOff] : uLocal;
            AscendC::LocalTensor<float> y = workA_.Get<float>();
            for (uint32_t off = 0; off < len; off += kVecChunk) {
                const uint32_t n32 = MinU32(kVecChunk, len - off);
                const int32_t nc = static_cast<int32_t>(n32);
                AscendC::Muls<float>(y[off], uSeg[off], invRms, nc);
            }

            AscendC::LocalTensor<T> gIn = gQue_.AllocTensor<T>();
            AscendC::LocalTensor<T> bIn = bQue_.AllocTensor<T>();
            CopyInPad<T>(gIn, gam_[colOff], len);
            CopyInPad<T>(bIn, bias_[colOff], len);
            gQue_.EnQue(gIn);
            bQue_.EnQue(bIn);
            gIn = gQue_.DeQue<T>();
            bIn = bQue_.DeQue<T>();

            if constexpr (sizeof(T) == 4) {
                AscendC::LocalTensor<float> gF = gIn;
                AscendC::LocalTensor<float> bF = bIn;
                for (uint32_t off = 0; off < len; off += kVecChunk) {
                    const uint32_t n32 = MinU32(kVecChunk, len - off);
                    const int32_t nc = static_cast<int32_t>(n32);
                    AscendC::Mul<float>(y[off], y[off], gF[off], nc);
                    AscendC::Add<float>(y[off], y[off], bF[off], nc);
                    // Fold y back into resident u so the row can be stored once.
                    if (resident_) {
                        AscendC::Adds<float>(uSeg[off], y[off], 0.0f, nc);
                    }
                }
                if (!resident_) {
                    CopyOutPad<T>(out_[rowOff + colOff], y, len);
                }
            } else {
                AscendC::LocalTensor<float> gF = workB_.Get<float>();
                AscendC::LocalTensor<float> bF = workC_.Get<float>();
                AscendC::LocalTensor<T> yOut = yQue_.AllocTensor<T>();
                for (uint32_t off = 0; off < len; off += kVecChunk) {
                    const uint32_t n32 = MinU32(kVecChunk, len - off);
                    const int32_t nc = static_cast<int32_t>(n32);
                    AscendC::Cast<float, T>(gF[off], gIn[off], AscendC::RoundMode::CAST_NONE, nc);
                    AscendC::Cast<float, T>(bF[off], bIn[off], AscendC::RoundMode::CAST_NONE, nc);
                    AscendC::Mul<float>(y[off], y[off], gF[off], nc);
                    AscendC::Add<float>(y[off], y[off], bF[off], nc);
                    AscendC::Cast<T, float>(yOut[off], y[off], AscendC::RoundMode::CAST_ROUND, nc);
                }
                yQue_.EnQue(yOut);
                yOut = yQue_.DeQue<T>();
                CopyOutPad<T>(out_[rowOff + colOff], yOut, len);
                yQue_.FreeTensor(yOut);
            }
            gQue_.FreeTensor(gIn);
            bQue_.FreeTensor(bIn);
        }
        if constexpr (sizeof(T) == 4) {
            if (resident_) {
                SyncVToS();
                CopyOutPad<T>(out_[rowOff], uBuf_.Get<float>(), d_);
            }
        }
    }

    __aicore__ inline void ProcessRow(uint32_t rowOff)
    {
        AscendC::LocalTensor<float> uLocal = uBuf_.Get<float>();
        if (resident_) {
            for (uint32_t colOff = 0; colOff < d_; colOff += stripe_) {
                const uint32_t len = MinU32(stripe_, d_ - colOff);
                AddUStripe(uLocal[colOff], rowOff, colOff, len);
            }
        }
        const float sumSq = SumSq(uLocal, rowOff);
        const float invRms = InvRms(sumSq);
        Epilogue(uLocal, rowOff, invRms);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> x_, res_, gam_, bias_, out_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQue_, rQue_, gQue_, bQue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> yQue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> uBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workA_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workB_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workC_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> leafBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceTmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scalarBuf_;
    uint32_t rows_{0};
    uint32_t d_{0};
    float epsilon_{1e-5f};
    float invD_{1.f};
    uint32_t usedCores_{1};
    uint32_t stripe_{256};
    uint32_t firstRow_{0};
    uint32_t rowsThisCore_{0};
    bool resident_{true};
};

template <typename T>
__aicore__ inline void RunHierUb(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores)
{
    AscendC::TPipe pipe;
    HierUbKernel<T> op(&pipe);
    op.Init(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores);
    op.Process();
}

}  // namespace wide_x_v002

extern "C" __global__ __vector__ void wide_x_hier_ub(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias,
    GM_ADDR output, uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores, int32_t dtype)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        return;
    }
    if (rows == 0 || d == 0 || usedCores == 0 || AscendC::GetBlockIdx() >= usedCores) {
        return;
    }
    if (dtype == 0) {
        wide_x_v002::RunHierUb<float>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores);
    } else if (dtype == 1) {
        wide_x_v002::RunHierUb<half>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores);
    } else if (dtype == 2) {
        wide_x_v002::RunHierUb<bfloat16_t>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores);
    }
}

#ifndef WIDE_X_DEVICE_ONLY
namespace wide_x_v002 {
namespace {

inline bool GroupPresent(const TensorGroupInfo& g)
{
    return g.tensors != nullptr && g.numTensors > 0 && g.tensors[0].shape != nullptr && g.tensors[0].numDims > 0;
}

inline void ShapeRD(const TensorGroupInfo& g, uint32_t& rows, uint32_t& d)
{
    const TensorInfo& t = g.tensors[0];
    d = static_cast<uint32_t>(t.shape[t.numDims - 1]);
    uint64_t r = 1;
    for (int64_t i = 0; i < t.numDims - 1; ++i) {
        r *= static_cast<uint64_t>(t.shape[i]);
    }
    rows = static_cast<uint32_t>(r);
}

}  // namespace
}  // namespace wide_x_v002

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
    const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma, GM_ADDR bias,
    const TensorGroupInfo& info_bias, GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        return;
    }
    if (!wide_x_v002::GroupPresent(info_x) || !wide_x_v002::GroupPresent(info_residual) ||
        !wide_x_v002::GroupPresent(info_gamma) || !wide_x_v002::GroupPresent(info_bias) ||
        !wide_x_v002::GroupPresent(info_output)) {
        return;
    }
    uint32_t rows = 0;
    uint32_t d = 0;
    wide_x_v002::ShapeRD(info_x, rows, d);
    if (rows == 0 || d == 0 || availableCoreNum <= 0) {
        return;
    }
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype < 0 || dtype > 2) {
        return;
    }
    uint32_t usedCores = rows;
    if (static_cast<int64_t>(usedCores) > availableCoreNum) {
        usedCores = static_cast<uint32_t>(availableCoreNum);
    }
    if (usedCores == 0) {
        return;
    }
    const float invD = 1.0f / static_cast<float>(d);
    wide_x_hier_ub<<<usedCores, nullptr, stream>>>(x, residual, gamma, bias, output, rows, d, epsilon, invD,
        usedCores, dtype);
}
#endif  // WIDE_X_DEVICE_ONLY
