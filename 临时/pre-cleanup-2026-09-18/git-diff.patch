+
+    if (rowWidth > UINT64_MAX / elementBytes) {
+        return;
+    }
+
+    const uint64_t rowBytes = rowWidth * elementBytes;
+
+    uint64_t rowGroup = 1ULL;
+    if (rowWidth <= 8192ULL) {
