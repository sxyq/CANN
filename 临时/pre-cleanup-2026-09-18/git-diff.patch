+---
+
+# B. R030-V001-WIDE-LOWP-PARAM-BATCH2
+
+这条只改**宽行低精度参数复用**：
+
+```text
+FP16/BF16
+D > 4096
+localRows >= 2
+
+gamma/bias tile
+只搬一次 + 只转 FP32 一次
+        ↓
+同时给 row0 + row1 使用
+```
+
+RMS 仍然每行单独按 Parent 算。
+
+```cpp
+#include <cmath>
+#include <cstdint>
+#include "kernel_operator.h"
+
+/*
+ * AddRmsNormBias - R030-V001-WIDE-LOWP-PARAM-BATCH2
+ *
+ * Parent: MIX-R014-R002-R019-V001
+ * Status: candidate / not yet CANN-compiled or online tested here
+ *
+ * Single new mechanism:
+ *   - for FP16/BF16 fallback rows with D > 4096 and at least two local rows,
+ *     process rows in pairs during the output pass.
+ *   - gamma/bias are loaded and converted to FP32 once per 4096-element
+ *     parameter tile, then reused for both rows.
+ *
+ * RMS math remains identical to the parent and is computed independently
+ * for each row before the paired output pass.
+ *
+ * No reduction algorithm, normalization formula, row ownership, or final
+ * rounding change.
+ *
+ * Core properties:
+ *   - kTileElems = 8192
+ *   - FP32 intermediates
+ *   - ReduceSum unchanged
+ *   - UB layout unchanged
+ *   - row/core scheduling unchanged
+ */
+
+template <typename T>
+class AddRmsNormBiasKernel {
+public:
+    static constexpr int32_t kTileElems = 8192;
+    static constexpr int32_t kParamCacheOffset = 4096;
+    static constexpr uint64_t kParamCacheMaxWidth = 4096ULL;
+    static constexpr int32_t kScalarElems = 16;
+    static constexpr int32_t kWideParamBatchTileElems = 4096;
+
+    __aicore__ inline void Init(
+        GM_ADDR x,
+        GM_ADDR residual,
+        GM_ADDR gamma,
+        GM_ADDR bias,
+        GM_ADDR output)
+    {
+        xGm_.SetGlobalBuffer((__gm__ T *)x);
+        residualGm_.SetGlobalBuffer((__gm__ T *)residual);
+        gammaGm_.SetGlobalBuffer((__gm__ T *)gamma);
+        biasGm_.SetGlobalBuffer((__gm__ T *)bias);
+        outputGm_.SetGlobalBuffer((__gm__ T *)output);
+
+        tpipe.InitBuffer(
+            xBuf_,
+            kTileElems * sizeof(T));
+
+        tpipe.InitBuffer(
+            residualBuf_,
+            kTileElems * sizeof(T));
+
+        tpipe.InitBuffer(
+            xFp32Buf_,
+            kTileElems * sizeof(float));
+
+        tpipe.InitBuffer(
+            residualFp32Buf_,
+            kTileElems * sizeof(float));
+
+        tpipe.InitBuffer(
+            yFp32Buf_,
+            kTileElems * sizeof(float));
+
+        tpipe.InitBuffer(
+            sumBuf_,
+            kScalarElems * sizeof(float));
+
+        if constexpr (
+            !AscendC::IsSameType<T, float>::value) {
+
+            tpipe.InitBuffer(
+                gammaFp32Buf_,
+                kParamCacheOffset * sizeof(float));
+
+            tpipe.InitBuffer(
+                biasFp32Buf_,
+                kParamCacheOffset * sizeof(float));
+        }
+    }
+
+    __aicore__ inline void Process(
+        uint64_t rowCount,
+        uint64_t rowWidth,
+        uint64_t rowGroup,
+        uint64_t groupCount,
+        uint32_t blockCount,
+        float invRowWidth,
+        float epsilon)
+    {
+        const uint64_t blockIdx =
+            static_cast<uint64_t>(
+                AscendC::GetBlockIdx());
+
+        const uint64_t baseGroups =
+            groupCount /
+            static_cast<uint64_t>(
+                blockCount);
+
+        const uint64_t extraGroups =
+            groupCount %
+            static_cast<uint64_t>(
+                blockCount);
+
+        const uint64_t beginGroup =
+            blockIdx * baseGroups +
+            (blockIdx < extraGroups
+                ? blockIdx
+                : extraGroups);
+
+        const uint64_t localGroups =
+            baseGroups +
+            (blockIdx < extraGroups
+                ? 1ULL
+                : 0ULL);
+
+        const uint64_t endGroup =
+            beginGroup + localGroups;
+
+        const uint64_t beginRow =
+            beginGroup * rowGroup;
+
+        uint64_t endRow =
+            endGroup * rowGroup;
+
+        if (endRow > rowCount) {
+            endRow = rowCount;
+        }
+
+        const uint64_t localRows =
+            endRow > beginRow
+                ? endRow - beginRow
+                : 0ULL;
+
+        /*
+         * R030-V001:
+         * low-precision wide pairwise parameter reuse.
+         */
+        if constexpr (
+            !AscendC::IsSameType<T, float>::value) {
+
+            if (rowWidth > kParamCacheMaxWidth &&
+                localRows >= 2ULL) {
+
+                uint64_t row = beginRow;
+
+                for (;
+                     row + 1ULL < endRow;
+                     row += 2ULL) {
+
+                    ProcessWideLowPrecisionParamBatch2(
+                        row,
+                        row + 1ULL,
+                        rowWidth,
+                        invRowWidth,
+                        epsilon);
+                }
+
+                if (row < endRow) {
+                    ProcessRow(
+                        row,
+                        rowWidth,
+                        invRowWidth,
+                        epsilon);
+                }
+
+                return;
+            }
+        }
+
+        const bool useParamCache =
+            rowWidth <= kParamCacheMaxWidth &&
+            localRows > 1ULL;
+
+        if (useParamCache) {
+
+            PrepareParameterCache(
+                rowWidth);
+
+            for (uint64_t row = beginRow;
+                 row < endRow;
+                 ++row) {
+
+                ProcessCachedParamsRetainedYRow(
+                    row,
+                    rowWidth,
+                    invRowWidth,
+                    epsilon);
+            }
+
+        } else {
+
+            for (uint64_t row = beginRow;
+                 row < endRow;
+                 ++row) {
+
+                ProcessRow(
+                    row,
+                    rowWidth,
+                    invRowWidth,
+                    epsilon);
+            }
+        }
+    }
+
+private:
+
+    __aicore__ inline int32_t TileLength(
+        uint64_t remain) const
+    {
+        return static_cast<int32_t>(
+            remain >
+                    static_cast<uint64_t>(
+                        kTileElems)
+                ? kTileElems
+                : remain);
+    }
+
+    __aicore__ inline void Load(
+        const AscendC::LocalTensor<T>& dst,
+        const AscendC::GlobalTensor<T>& src,
+        uint64_t offset,
+        int32_t count)
+    {
+        const AscendC::DataCopyExtParams
+            copyParams(
+                1,
+                static_cast<uint32_t>(
+                    count *
+                    static_cast<int32_t>(
+                        sizeof(T))),
+                0,
+                0,
+                0);
+
+        const AscendC::
+            DataCopyPadExtParams<T>
+                padParams;
+
+        AscendC::DataCopyPad(
+            dst,
+            src[offset],
+            copyParams,
+            padParams);
+    }
+
+    __aicore__ inline void Store(
+        const AscendC::GlobalTensor<T>& dst,
+        uint64_t offset,
+        const AscendC::LocalTensor<T>& src,
+        int32_t count)
+    {
+        const AscendC::DataCopyExtParams
+            copyParams(
+                1,
+                static_cast<uint32_t>(
+                    count *
+                    static_cast<int32_t>(
+                        sizeof(T))),
+                0,
+                0,
+                0);
+
+        AscendC::DataCopyPad(
+            dst[offset],
+            src,
+            copyParams);
+    }
+
+    __aicore__ inline void ToFloat(
+        const AscendC::LocalTensor<float>& dst,
+        const AscendC::LocalTensor<T>& src,
+        int32_t count)
+    {
+        if constexpr (
+            AscendC::IsSameType<
+                T,
+                float>::value) {
+
+            AscendC::Adds(
+                dst,
+                src,
+                0.0f,
+                count);
+
+        } else {
+
+            AscendC::Cast(
+                dst,
+                src,
+                AscendC::RoundMode::
+                    CAST_NONE,
+                count);
+        }
+    }
+
+    __aicore__ inline void SyncMTE2ToV()
+    {
+        AscendC::SetFlag<
+            AscendC::HardEvent::MTE2_V>(0);
+
+        AscendC::WaitFlag<
+            AscendC::HardEvent::MTE2_V>(0);
+    }
+
+    __aicore__ inline void SyncVToMTE2()
+    {
+        AscendC::SetFlag<
+            AscendC::HardEvent::V_MTE2>(0);
+
+        AscendC::WaitFlag<
+            AscendC::HardEvent::V_MTE2>(0);
+    }
+
+    __aicore__ inline void SyncVToMTE3()
+    {
+        AscendC::SetFlag<
+            AscendC::HardEvent::V_MTE3>(0);
+
+        AscendC::WaitFlag<
+            AscendC::HardEvent::V_MTE3>(0);
+    }
+
+    __aicore__ inline void SyncMTE3ToV()
+    {
+        AscendC::SetFlag<
+            AscendC::HardEvent::MTE3_V>(0);
+
+        AscendC::WaitFlag<
+            AscendC::HardEvent::MTE3_V>(0);
+    }
+
+    __aicore__ inline void SyncVToS()
+    {
+        AscendC::SetFlag<
+            AscendC::HardEvent::V_S>(0);
+
+        AscendC::WaitFlag<
+            AscendC::HardEvent::V_S>(0);
+    }
+
+    __aicore__ inline void SyncSToV()
+    {
+        AscendC::SetFlag<
+            AscendC::HardEvent::S_V>(0);
+
+        AscendC::WaitFlag<
+            AscendC::HardEvent::S_V>(0);
+    }
+
+    /*
+     * Parent RMS calculation extracted as a helper.
+     */
+    __aicore__ inline float ComputeInvRmsForRow(
+        uint64_t row,
+        uint64_t rowWidth,
+        float invRowWidth,
+        float epsilon)
+    {
+        const uint64_t rowOffset =
+            row * rowWidth;
+
+        AscendC::LocalTensor<T> xLocal =
+            xBuf_.Get<T>();
+
+        AscendC::LocalTensor<T> residualLocal =
+            residualBuf_.Get<T>();
+
+        AscendC::LocalTensor<float> xFp32 =
+            xFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> residualFp32 =
+            residualFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> yFp32 =
+            yFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> sumSlots =
+            sumBuf_.Get<float>();
+
+        AscendC::LocalTensor<float> partial =
+            sumSlots;
+
+        AscendC::LocalTensor<float> rms =
+            sumSlots[8];
+
+        AscendC::Duplicate(
+            rms,
+            0.0f,
+            1);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        for (uint64_t col = 0;
+             col < rowWidth;
+             col += kTileElems) {
+
+            const int32_t valid =
+                TileLength(
+                    rowWidth - col);
+
+            Load(
+                xLocal,
+                xGm_,
+                rowOffset + col,
+                valid);
+
+            Load(
+                residualLocal,
+                residualGm_,
+                rowOffset + col,
+                valid);
+
+            SyncMTE2ToV();
+
+            ToFloat(
+                xFp32,
+                xLocal,
+                valid);
+
+            ToFloat(
+                residualFp32,
+                residualLocal,
+                valid);
+
+            AscendC::PipeBarrier<PIPE_V>();
+
+            AscendC::Add(
+                yFp32,
+                xFp32,
+                residualFp32,
+                valid);
+
+            AscendC::PipeBarrier<PIPE_V>();
+
+            AscendC::Mul(
+                xFp32,
+                yFp32,
+                yFp32,
+                valid);
+
+            AscendC::PipeBarrier<PIPE_V>();
+
+            AscendC::ReduceSum(
+                partial,
+                xFp32,
+                residualFp32,
+                valid);
+
+            AscendC::PipeBarrier<PIPE_V>();
+
+            AscendC::Add(
+                rms,
+                rms,
+                partial,
+                1);
+
+            AscendC::PipeBarrier<PIPE_V>();
+
+            SyncVToMTE2();
+        }
+
+        AscendC::Muls(
+            rms,
+            rms,
+            invRowWidth,
+            1);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        AscendC::Adds(
+            rms,
+            rms,
+            epsilon,
+            1);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        AscendC::Sqrt(
+            rms,
+            rms,
+            1);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        SyncVToS();
+
+        const float invRms =
+            1.0f /
+            rms.GetValue(0);
+
+        SyncSToV();
+
+        return invRms;
+    }
+
+    __aicore__ inline void
+    ProcessWideLowPrecisionOutputTile(
+        uint64_t row,
+        uint64_t rowWidth,
+        uint64_t col,
+        int32_t valid,
+        float invRms)
+    {
+        const uint64_t rowOffset =
+            row * rowWidth;
+
+        AscendC::LocalTensor<T> xLocal =
+            xBuf_.Get<T>();
+
+        AscendC::LocalTensor<T> residualLocal =
+            residualBuf_.Get<T>();
+
+        AscendC::LocalTensor<float> xFp32 =
+            xFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> residualFp32 =
+            residualFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> yFp32 =
+            yFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> gammaFp32 =
+            gammaFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> biasFp32 =
+            biasFp32Buf_.Get<float>();
+
+        Load(
+            xLocal,
+            xGm_,
+            rowOffset + col,
+            valid);
+
+        Load(
+            residualLocal,
+            residualGm_,
+            rowOffset + col,
+            valid);
+
+        SyncMTE2ToV();
+
+        ToFloat(
+            xFp32,
+            xLocal,
+            valid);
+
+        ToFloat(
+            residualFp32,
+            residualLocal,
+            valid);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        AscendC::Add(
+            yFp32,
+            xFp32,
+            residualFp32,
+            valid);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        AscendC::Muls(
+            yFp32,
+            yFp32,
+            invRms,
+            valid);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        AscendC::Mul(
+            yFp32,
+            yFp32,
+            gammaFp32,
+            valid);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        AscendC::Add(
+            yFp32,
+            yFp32,
+            biasFp32,
+            valid);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        AscendC::Cast(
+            xLocal,
+            yFp32,
+            AscendC::RoundMode::
+                CAST_RINT,
+            valid);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        SyncVToMTE3();
+
+        Store(
+            outputGm_,
+            rowOffset + col,
+            xLocal,
+            valid);
+
+        SyncMTE3ToV();
+        SyncVToMTE2();
+    }
+
+    __aicore__ inline void
+    ProcessWideLowPrecisionParamBatch2(
+        uint64_t row0,
+        uint64_t row1,
+        uint64_t rowWidth,
+        float invRowWidth,
+        float epsilon)
+    {
+        const float invRms0 =
+            ComputeInvRmsForRow(
+                row0,
+                rowWidth,
+                invRowWidth,
+                epsilon);
+
+        const float invRms1 =
+            ComputeInvRmsForRow(
+                row1,
+                rowWidth,
+                invRowWidth,
+                epsilon);
+
+        AscendC::LocalTensor<T> gammaLocal =
+            xBuf_.Get<T>();
+
+        AscendC::LocalTensor<T> biasLocal =
+            residualBuf_.Get<T>();
+
+        AscendC::LocalTensor<float> gammaFp32 =
+            gammaFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> biasFp32 =
+            biasFp32Buf_.Get<float>();
+
+        for (uint64_t col = 0;
+             col < rowWidth;
+             col +=
+                 static_cast<uint64_t>(
+                     kWideParamBatchTileElems)) {
+
+            const uint64_t remain =
+                rowWidth - col;
+
+            const int32_t valid =
+                static_cast<int32_t>(
+                    remain >
+                            static_cast<uint64_t>(
+                                kWideParamBatchTileElems)
+                        ? kWideParamBatchTileElems
+                        : remain);
+
+            /*
+             * Parameter GM load only once for two rows.
+             */
+            Load(
+                gammaLocal,
+                gammaGm_,
+                col,
+                valid);
+
+            Load(
+                biasLocal,
+                biasGm_,
+                col,
+                valid);
+
+            SyncMTE2ToV();
+
+            ToFloat(
+                gammaFp32,
+                gammaLocal,
+                valid);
+
+            ToFloat(
+                biasFp32,
+                biasLocal,
+                valid);
+
+            AscendC::PipeBarrier<PIPE_V>();
+
+            SyncVToMTE2();
+
+            ProcessWideLowPrecisionOutputTile(
+                row0,
+                rowWidth,
+                col,
+                valid,
+                invRms0);
+
+            ProcessWideLowPrecisionOutputTile(
+                row1,
+                rowWidth,
+                col,
+                valid,
+                invRms1);
+        }
+    }
+
+    __aicore__ inline void PrepareParameterCache(
+        uint64_t rowWidth)
+    {
+        const int32_t valid =
+            static_cast<int32_t>(
+                rowWidth);
+
+        AscendC::LocalTensor<T> xLocal =
+            xBuf_.Get<T>();
+
+        AscendC::LocalTensor<T> residualLocal =
+            residualBuf_.Get<T>();
+
+        AscendC::LocalTensor<T> gammaCached =
+            xLocal[kParamCacheOffset];
+
+        AscendC::LocalTensor<T> biasCached =
+            residualLocal[kParamCacheOffset];
+
+        Load(
+            gammaCached,
+            gammaGm_,
+            0,
+            valid);
+
+        Load(
+            biasCached,
+            biasGm_,
+            0,
+            valid);
+
+        SyncMTE2ToV();
+
+        if constexpr (
+            !AscendC::IsSameType<T, float>::value) {
+
+            AscendC::LocalTensor<float> gammaFp32 =
+                gammaFp32Buf_.Get<float>();
+
+            AscendC::LocalTensor<float> biasFp32 =
+                biasFp32Buf_.Get<float>();
+
+            ToFloat(
+                gammaFp32,
+                gammaCached,
+                valid);
+
+            ToFloat(
+                biasFp32,
+                biasCached,
+                valid);
+
+            AscendC::PipeBarrier<PIPE_V>();
+
+            SyncVToMTE2();
+        }
+    }
+
+    __aicore__ inline void
+    ProcessCachedParamsRetainedYRow(
+        uint64_t row,
+        uint64_t rowWidth,
+        float invRowWidth,
+        float epsilon)
+    {
+        const uint64_t rowOffset =
+            row * rowWidth;
+
+        const int32_t valid =
+            static_cast<int32_t>(
+                rowWidth);
+
+        AscendC::LocalTensor<T> xLocal =
+            xBuf_.Get<T>();
+
+        AscendC::LocalTensor<T> residualLocal =
+            residualBuf_.Get<T>();
+
+        AscendC::LocalTensor<T> gammaCached =
+            xLocal[kParamCacheOffset];
+
+        AscendC::LocalTensor<T> biasCached =
+            residualLocal[kParamCacheOffset];
+
+        AscendC::LocalTensor<float> xFp32 =
+            xFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> residualFp32 =
+            residualFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> yFp32 =
+            yFp32Buf_.Get<float>();
+
+        AscendC::LocalTensor<float> sumSlots =
+            sumBuf_.Get<float>();
+
+        AscendC::LocalTensor<float> partial =
+            sumSlots;
+
+        AscendC::LocalTensor<float> rms =
+            sumSlots[8];
+
+        AscendC::Duplicate(
+            rms,
+            0.0f,
+            1);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        Load(
+            xLocal,
+            xGm_,
+            rowOffset,
+            valid);
+
+        Load(
+            residualLocal,
+            residualGm_,
+            rowOffset,
+            valid);
+
+        SyncMTE2ToV();
+
+        ToFloat(
+            xFp32,
+            xLocal,
+            valid);
+
+        ToFloat(
+            residualFp32,
+            residualLocal,
+            valid);
+
+        AscendC::PipeBarrier<PIPE_V>();
+
+        AscendC::Add(
+            yFp32,
