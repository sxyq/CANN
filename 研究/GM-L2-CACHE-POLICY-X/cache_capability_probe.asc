#include <cstdint>

using aclrtStream = void*;

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

// Compile the unchanged frozen direct-invocation parent in the same translation
// unit as the cache APIs; this probe does not alter or launch the parent kernel.
#include "../../归档/历史工作区/R31B/R31B-V011-LP-ROW-PIPELINE_kernel.asc"

template <typename T>
__aicore__ inline void CacheCapabilityProbe(GM_ADDR address)
{
    AscendC::GlobalTensor<T> gm;
    gm.SetGlobalBuffer((__gm__ T*)address);
    gm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    gm.template SetL2CacheHint<AscendC::CacheRwMode::READ>(AscendC::CacheMode::CACHE_MODE_NORMAL);

    AscendC::GlobalTensor<uint64_t> preload;
    preload.SetGlobalBuffer((__gm__ uint64_t*)address);
    AscendC::DataCachePreload(preload, static_cast<int64_t>(0));
}

__global__ __vector__ void cache_capability_probe(GM_ADDR address)
{
    CacheCapabilityProbe<float>(address);
}

int main()
{
    return 0;
}
