const suite = scorer.namespace.frozenSuite(parseTsv(suiteBytes));
const anchorPath = "本地实验/MAIN2-CANONICAL-V1/versions/R31B__V011/measurements.tsv";
const anchorRows = parseTsv(gitShow(anchorPath));
const anchorRoot = "本地实验/MAIN2-CANONICAL-V1/versions/R31B__V011/";
for (const row of anchorRows) {
