const harnessBytes = gitShow("工具/main2-canonical-harness/runner_ref.inc");
if (digest(harnessBytes) !== input.harness_sha256) throw new Error("PUBLISHED_HARNESS_SHA_MISMATCH");
const decode = value => Buffer.isBuffer(value) ? value.toString("utf8") : String(value);
const parseTsv = value => {
  const lines = decode(value).split(/\r?\n/).filter(line => line.length > 0);
  if (!lines.length) return [];
  const header = lines[0].split("\t");
  return lines.slice(1).map(line => {
    const columns = line.split("\t"), row = {};
    header.forEach((name, index) => row[name] = columns[index] ?? "");
    return row;
  });
};
const gitObjectPattern = /^gitobj:\/\/([0-9a-f]{40})\/(.+)$/;
const contentCache = new Map();
const content = file => {
  if (contentCache.has(file)) return contentCache.get(file);
  const match = gitObjectPattern.exec(file);
  const bytes = match
    ? execFileSync("git", ["show", `${match[1]}:${match[2]}`], {cwd: root})
    : fs.readFileSync(file);
  contentCache.set(file, bytes);
  return bytes;
};
const parseStats = file => {
  const result = {};
  for (const line of decode(content(file)).split(/\r?\n/)) {
    const v = line.split("\t");
    if (v.length === 2) result[v[0]] = v[1];
