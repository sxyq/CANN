def add_pipeline_options(parser: argparse.ArgumentParser, resume: bool) -> None:
    parser.add_argument("--checkpoint", required=True)
    parser.add_argument("--source", default=os.environ.get("W5CTL_SOURCE"))
    parser.add_argument("--artifact", default=os.environ.get("W5CTL_ARTIFACT"))
    parser.add_argument("--expected-source-sha", default=os.environ.get("W5CTL_SOURCE_SHA256"))
    parser.add_argument("--expected-artifact-sha", default=os.environ.get("W5CTL_ARTIFACT_SHA256"))
    parser.add_argument("--raw", default=os.environ.get("W5CTL_RAW_PATH"))
    parser.add_argument("--stages")
    parser.add_argument("--backend-workdir", default=os.environ.get("W5CTL_BACKEND_WORKDIR"))
    parser.add_argument("--min-pairs", type=int, default=3)
    parser.add_argument("--max-cv", type=float, default=0.20)
    for stage in ("build", "correctness", "local"):
        env_name = f"W5CTL_{stage.upper()}_BACKEND"
        parser.add_argument(f"--{stage}-backend", dest=f"{stage}_backend", default=os.environ.get(env_name))
        parser.add_argument(f"--{stage}-arg", dest=f"{stage}_arg", action="append", default=[])
        parser.add_argument(f"--{stage}-log", dest=f"{stage}_log")
    parser.add_argument("--record-backend", default=os.environ.get("W5CTL_RECORD_BACKEND"))
    parser.add_argument("--record-arg", action="append", default=[])
    parser.add_argument("--record-workdir", default=os.environ.get("W5CTL_RECORD_WORKDIR"))
    parser.add_argument("--record-log")
    parser.add_argument("--record-evidence", action="append", default=[])
    if resume:
        parser.add_argument("--from-stage", choices=STAGES)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="w5ctl")
    sub = parser.add_subparsers(dest="command", required=True)

    doctor = sub.add_parser("doctor", help="read-only route and backend audit")
    doctor.add_argument("--dry-run", action="store_true", help="explicitly select read-only mode")
    doctor.add_argument("--repo-root")
    doctor.add_argument("--expected-branch", default=os.environ.get("W5CTL_EXPECTED_BRANCH", EXPECTED_BRANCH))
    doctor.add_argument("--source")

    for name, env_name in (
        ("build", "W5CTL_BUILD_BACKEND"),
        ("correctness", "W5CTL_CORRECTNESS_BACKEND"),
    ):
        stage = sub.add_parser(name, help=f"delegate {name} to an existing backend")
        add_identity_options(stage)
        add_backend_options(stage, env_name)

    local = sub.add_parser("local", help="delegate local measurement and validate fixed raw statistics")
    add_identity_options(local)
    add_backend_options(local, "W5CTL_LOCAL_BACKEND")
    local.add_argument("--raw", default=os.environ.get("W5CTL_RAW_PATH"))
    local.add_argument("--stats-only", action="store_true")
    local.add_argument("--min-pairs", type=int, default=3)
    local.add_argument("--max-cv", type=float, default=0.20)

    record = sub.add_parser("record", help="delegate evidence recording; never commits by itself")
    add_identity_options(record)
    record.add_argument("--evidence", action="append", default=[])
    record.add_argument("--backend", default=os.environ.get("W5CTL_RECORD_BACKEND"))
    record.add_argument("--backend-arg", action="append", default=[])
    record.add_argument("--backend-workdir", default=os.environ.get("W5CTL_RECORD_WORKDIR"))
    record.add_argument("--log")

    dedup = sub.add_parser("dedup", help="compare meaningful patch changes only")
    dedup.add_argument("--parent-patch", required=True)
    dedup.add_argument("--candidate-patch", required=True)
    dedup.add_argument("--common", action="append", default=[])
    dedup.add_argument("--champion-scaffold", action="append", default=[])
    dedup.add_argument("--abi-scaffold", action="append", default=[])
    dedup.add_argument("--min-lines", type=int, default=1)
    dedup.add_argument("--duplicate-threshold", type=float, default=PATCH_SIMILARITY_GATE)
    dedup.add_argument("--mechanism-threshold", type=float, default=0.70)

    cycle = sub.add_parser("cycle", help="idempotent build/correctness/local orchestration")
    add_pipeline_options(cycle, resume=False)

    resume = sub.add_parser("resume", help="resume an explicit checkpoint without rerunning passed stages")
    add_pipeline_options(resume, resume=True)

    report = sub.add_parser("report", help="read a checkpoint and emit a structured receipt")
    report.add_argument("--checkpoint", required=True)
    return parser


def local_command(args: argparse.Namespace) -> int:
    isolation_error = require_current_worktree()
    if isolation_error:
        print_stats(blocked_stats("NOT_RUN", isolation_error))
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", isolation_error)
        return EXIT_NOT_RUN
    if args.stats_only:
        raw, raw_scope_error = scoped_path(args.raw, "raw")
        if raw_scope_error:
            stats = blocked_stats("NOT_RUN", raw_scope_error)
            emit("STATS_ONLY", "YES")
            print_stats(stats)
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", raw_scope_error)
            return EXIT_NOT_RUN
        stats = analyze_raw(raw, args.min_pairs, args.max_cv)
        emit("STATS_ONLY", "YES")
        print_stats(stats)
        return 0 if stats["status"] == "ACCEPTED" else EXIT_STATS_REJECTED
    return identity_stage(
        "local",
        args.backend,
        args.backend_arg,
        args.backend_workdir,
        args.log,
        args.source,
        args.artifact,
        args.expected_source_sha,
        args.expected_artifact_sha,
        args.raw,
        args.min_pairs,
        args.max_cv,
    ).rc


def dispatch(args: argparse.Namespace) -> int:
    if args.command == "doctor":
        return doctor_command(args)
    if args.command == "build":
        return identity_stage(
            "build",
            args.backend,
            args.backend_arg,
            args.backend_workdir,
            args.log,
            args.source,
            args.artifact,
            args.expected_source_sha,
            args.expected_artifact_sha,
            None,
        ).rc
    if args.command == "correctness":
        return identity_stage(
            "correctness",
            args.backend,
            args.backend_arg,
            args.backend_workdir,
            args.log,
            args.source,
            args.artifact,
            args.expected_source_sha,
            args.expected_artifact_sha,
            None,
        ).rc
    if args.command == "local":
        return local_command(args)
    if args.command == "record":
        return record_command(args)
    if args.command == "dedup":
        return dedup_command(args)
    if args.command == "cycle":
        return pipeline_command(args, resume=False)
    if args.command == "resume":
        return pipeline_command(args, resume=True)
    if args.command == "report":
        return report_command(args)
    raise UsageError(f"unknown command: {args.command}")


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
        return dispatch(args)
    except UsageError as exc:
        print(f"ERROR={exc}", file=sys.stderr)
        return EXIT_USAGE
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
