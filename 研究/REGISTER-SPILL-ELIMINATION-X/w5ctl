def clean_patch_lines(path: Path) -> List[str]:
    lines: List[str] = []
    raw_lines = path.read_text(errors="replace").splitlines()
    unified = any(
        line.startswith(("diff ", "@@ ", "@@@", "--- ", "+++ ")) for line in raw_lines
    )
    for raw in raw_lines:
        if raw.startswith(("diff ", "index ", "+++ ", "--- ", "@@ ", "@@@", "\\")):
            continue
        if unified and not raw.startswith(("+", "-")):
            continue
        if raw.startswith(("+", "-")):
            raw = raw[1:]
        normalized = " ".join(raw.strip().split())
        if normalized:
            lines.append(normalized)
    return lines


def mechanism_tokens(lines: Iterable[str]) -> Counter:
    tokens = Counter()
    for line in lines:
        for token in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", line.lower()):
            if token not in GENERIC_TOKENS and len(token) > 1:
                tokens[token] += 1
    return tokens


def dedup_insufficient(reason: str) -> int:
    emit("PATCH_SIMILARITY", "NONE")
    emit("MECHANISM_OVERLAP", "NONE")
    emit("PATCH_SIMILARITY_GATE", fmt_number(PATCH_SIMILARITY_GATE))
    emit("PATCH_SIMILARITY_GATE_STATUS", "NOT_EVALUATED")
    emit("MECHANISM_OVERLAP_GATE", "NONE")
    emit("MECHANISM_OVERLAP_GATE_STATUS", "NOT_EVALUATED")
    emit("MECHANISM_ORTHOGONALITY", "UNPROVEN")
    emit("MECHANISM_REVIEW", "NOT_EVALUATED")
    emit("DEDUP_STATUS", "SIMILARITY_INSUFFICIENT_DATA")
    emit("BLOCKER", reason)
    return EXIT_NOT_RUN


def dedup_command(args: argparse.Namespace) -> int:
    isolation_error = require_current_worktree()
    if isolation_error:
        return dedup_insufficient(isolation_error)
    parent, parent_scope_error = scoped_path(args.parent_patch, "parent-patch")
    candidate, candidate_scope_error = scoped_path(args.candidate_patch, "candidate-patch")
    if parent_scope_error or candidate_scope_error:
        return dedup_insufficient(parent_scope_error or candidate_scope_error)
    if parent is None or candidate is None or not parent.is_file() or not candidate.is_file():
        return dedup_insufficient("PATCH_INPUT_MISSING")
    try:
        parent_lines = clean_patch_lines(parent)
        candidate_lines = clean_patch_lines(candidate)
        common: Counter = Counter()
        common_inputs = list(args.common or [])
        common_inputs.extend(args.champion_scaffold or [])
        common_inputs.extend(args.abi_scaffold or [])
        for raw_common in common_inputs:
            common_path, common_scope_error = scoped_path(raw_common, "common-patch")
            if common_scope_error:
                return dedup_insufficient(common_scope_error)
            if common_path is None or not common_path.is_file():
                return dedup_insufficient(f"COMMON_INPUT_MISSING:{raw_common}")
            common.update(clean_patch_lines(common_path))
        parent_counter = Counter(parent_lines)
        candidate_counter = Counter(candidate_lines)
        if common:
            parent_counter -= common
            candidate_counter -= common
        parent_lines = list(parent_counter.elements())
        candidate_lines = list(candidate_counter.elements())
    except OSError as exc:
        return dedup_insufficient(f"PATCH_READ_FAILED:{exc}")
    emit("COMMON_EXCLUDED_LINE_COUNT", sum(common.values()))
    if len(parent_lines) < args.min_lines or len(candidate_lines) < args.min_lines:
        return dedup_insufficient("MEANINGFUL_PATCH_LINES_BELOW_MINIMUM")
    overlap_lines = sum((Counter(parent_lines) & Counter(candidate_lines)).values())
    patch_similarity = (2.0 * overlap_lines) / (len(parent_lines) + len(candidate_lines))
    emit("PATCH_SIMILARITY", fmt_number(patch_similarity))
    emit("PATCH_SIMILARITY_GATE", fmt_number(PATCH_SIMILARITY_GATE))
    if patch_similarity > PATCH_SIMILARITY_GATE:
        emit("PATCH_SIMILARITY_GATE_STATUS", "BLOCKED")
        emit("DEDUP_STATUS", "BLOCKED_PATCH_SIMILARITY")
        emit("BLOCKER", f"PATCH_SIMILARITY={patch_similarity:.6f}>GATE={PATCH_SIMILARITY_GATE:.6f}")
        return EXIT_NOT_RUN
    emit("PATCH_SIMILARITY_GATE_STATUS", "PASS")
    parent_tokens = mechanism_tokens(parent_lines)
    candidate_tokens = mechanism_tokens(candidate_lines)
    token_union = set(parent_tokens) | set(candidate_tokens)
    if not token_union:
        emit("MECHANISM_OVERLAP", "NONE")
        emit("MECHANISM_OVERLAP_GATE", fmt_number(args.mechanism_threshold))
        emit("MECHANISM_OVERLAP_GATE_STATUS", "NOT_EVALUATED")
        emit("MECHANISM_ORTHOGONALITY", "UNPROVEN")
        emit("MECHANISM_REVIEW", "NOT_EVALUATED")
        emit("DEDUP_STATUS", "SIMILARITY_INSUFFICIENT_DATA")
        emit("BLOCKER", "MECHANISM_TOKENS_EMPTY")
        return EXIT_NOT_RUN
    token_overlap = len(set(parent_tokens) & set(candidate_tokens)) / len(token_union)
    emit("MECHANISM_OVERLAP", fmt_number(token_overlap))
    emit("MECHANISM_OVERLAP_REVIEW_THRESHOLD", fmt_number(args.mechanism_threshold))
    emit("MECHANISM_OVERLAP_GATE_STATUS", "SIGNAL_ONLY_NOT_A_BLOCKER")
    emit("MECHANISM_ORTHOGONALITY", "UNPROVEN")
    if token_overlap > 0.0:
        emit("MECHANISM_REVIEW", "MAIN_READ_ONLY_REVIEW_SIGNAL")
        emit("MECHANISM_REVIEW_SIGNAL", "NONZERO_TOKEN_OVERLAP")
        emit("DEDUP_STATUS", "PATCH_GATE_PASS_MECHANISM_REVIEW_SIGNAL")
        emit("DEDUP_METHOD", "normalized-change-lines-with-explicit-common-exclusion")
        return 0
    emit("MECHANISM_REVIEW", "NO_TOKEN_OVERLAP_SIGNAL")
    emit("MECHANISM_REVIEW_SIGNAL", "NONE")
    emit("DEDUP_STATUS", "DISTINCT")
    emit("DEDUP_METHOD", "normalized-change-lines-with-explicit-common-exclusion")
    return 0


def record_command(args: argparse.Namespace) -> int:
    isolation_error = require_current_worktree()
    if isolation_error:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", isolation_error)
        return EXIT_NOT_RUN
    workdir, workdir_error = scoped_path(
        getattr(args, "backend_workdir", getattr(args, "workdir", None)),
        "backend-workdir",
    )
    if workdir_error:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", workdir_error)
        return EXIT_NOT_RUN
    _, log_error = scoped_path(getattr(args, "log", None), "log")
    if log_error:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", log_error)
        return EXIT_NOT_RUN
    manifest, manifest_error = scoped_path(getattr(args, "manifest", None), "manifest")
    if manifest_error or manifest is None:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", manifest_error or "RECORD_MANIFEST_NOT_SET")
        return EXIT_NOT_RUN
    try:
        manifest.relative_to(ROUTE_ROOT)
    except ValueError:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", f"OUT_OF_SCOPE:manifest:{manifest}:expected={ROUTE_ROOT}")
        return EXIT_NOT_RUN
    source, source_sha, source_error = verify_file(
        args.source, "source", args.expected_source_sha, required=True
    )
    artifact, artifact_sha, artifact_error, artifact_identity = verify_artifact_reference(
        args.artifact,
        args.expected_artifact_sha,
        getattr(args, "artifact_receipt", None),
    )
    canonical_path = getattr(args, "canonical_measurements", None)
    raw_arg = args.raw or canonical_path
    if canonical_path and args.raw and resolve_path(args.raw) != resolve_path(canonical_path):
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", "CANONICAL_MEASUREMENTS_MUST_BE_LOCAL_RAW_INDEX")
        return EXIT_NOT_RUN
    raw, raw_sha, raw_error = verify_file(raw_arg, "raw", required=True)
    if source_error or artifact_error or raw_error:
        emit("STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", source_error or artifact_error or raw_error)
        return EXIT_IDENTITY
    stage_evidence: Dict[str, Dict[str, Any]] = {}
    for stage, receipt_raw in (
        ("build", getattr(args, "build_receipt", None)),
        ("correctness", getattr(args, "correctness_receipt", None)),
    ):
        if receipt_raw:
            receipt, receipt_error = verify_stage_receipt(
                receipt_raw, stage, source_sha, artifact_sha
            )
            if receipt_error or receipt is None:
                emit("STATUS", "BLOCKED")
                emit("IDENTITY_STATUS", "FAIL")
                emit("BLOCKER", receipt_error or f"{stage.upper()}_RECEIPT_INVALID")
                return EXIT_IDENTITY
            stage_evidence[stage] = receipt
    canonical: Optional[Dict[str, Any]] = None
    if canonical_path:
        canonical, canonical_error = canonical_local_score(
            canonical_path, source_sha or "", artifact_sha or "",
            getattr(args, "canonical_purpose", "route-kernel"),
            getattr(args, "canonical_revision", None),
            getattr(args, "expected_parent_artifact_sha", None),
        )
        if canonical_error or canonical is None:
            emit("STATUS", "NOT_COMPUTABLE")
            emit("CANONICAL_SCORE_STATUS", "NOT_COMPUTABLE")
            emit("CANONICAL_SCORE_REASON", canonical_error or "CANONICAL_SCORE_NOT_COMPUTABLE")
            emit("FULL_LOCAL_SCORE", "NOT_COMPUTABLE")
            return EXIT_STATS_REJECTED
    if not args.evidence and not canonical:
        emit("STATUS", "NOT_RUN")
        emit("BLOCKER", "EVIDENCE_PATH_NOT_SET")
        return EXIT_NOT_RUN
    assert source is not None and source_sha is not None
    assert artifact is not None and artifact_sha is not None
    assert raw is not None and raw_sha is not None
    evidence_specs = list(args.evidence or [])
    if canonical_path:
        evidence_specs.append(canonical_path)
    if canonical:
        evidence_specs.extend(
            item["path"] for item in canonical.get("raw_identities", [])
            if not item["path"].startswith("gitobj://")
        )
    evidence_paths: List[Path] = []
    evidence_digests: List[str] = []
    seen_evidence = set()
    for raw_evidence in evidence_specs:
        path, digest, error = verify_file(raw_evidence, "evidence", required=True)
        if error:
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", error)
            return EXIT_IDENTITY
        assert path is not None and digest is not None
        if path in seen_evidence:
            continue
        seen_evidence.add(path)
        evidence_paths.append(path)
        evidence_digests.append(digest)
        emit("EVIDENCE_PATH", path)
        emit("EVIDENCE_SHA256", digest)
    if canonical:
        local_result = canonical_local_result(canonical)
    else:
        local_result = analyze_raw(raw, getattr(args, "min_pairs", 3), getattr(args, "max_cv", 0.20))
    backend, backend_error = resolve_backend(args.backend)
    if args.backend and backend_error:
        initial_backend_status = "CONFIGURATION_ERROR"
        initial_integration_status = "BACKEND_CONFIGURATION_ERROR"
    elif backend is not None:
        initial_backend_status = "PENDING"
        initial_integration_status = "PENDING"
    else:
        initial_backend_status = "NOT_REQUESTED" if args.backend == "" else "NOT_CONFIGURED"
        initial_integration_status = initial_backend_status
    manifest_payload: Dict[str, Any] = {
        "schema": 1,
        "route": ROUTE,
        "stage": "record",
        "repo_root": str(EXPECTED_REPO_ROOT),
        "expected_branch": EXPECTED_BRANCH,
        "source": {"path": str(source), "sha256": source_sha},
        "artifact": {
            "path": str(artifact),
            "sha256": artifact_sha,
            **(artifact_identity or {}),
        },
        "raw": {"path": str(raw), "sha256": raw_sha},
        "evidence": [
            {"path": str(path), "sha256": digest}
            for path, digest in zip(evidence_paths, evidence_digests)
        ],
        "stage_evidence": stage_evidence,
        "local_result": local_result,
        "backend": str(backend) if backend else None,
        "backend_error": backend_error,
        "record_status": "PASS",
        "backend_status": initial_backend_status,
        "backend_rc": None,
        "integration_status": initial_integration_status,
        "revision_created": False,
        "runner_created": False,
        "online": "NOT_SUBMITTED",
        "recorded_utc": now_utc(),
    }
    if canonical:
        print_canonical_stats(local_result)
    existing_manifest: Optional[Dict[str, Any]] = None
    if manifest.exists():
        try:
            existing_manifest = json.loads(manifest.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", f"RECORD_MANIFEST_READ_FAILED:{exc}")
            return EXIT_NOT_RUN
        if not isinstance(existing_manifest, dict) or existing_manifest.get("schema") != 1:
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", "RECORD_MANIFEST_SCHEMA_MISMATCH")
            return EXIT_NOT_RUN
        if not same_record_identity(existing_manifest, manifest_payload):
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", f"RECORD_MANIFEST_IDENTITY_CONFLICT:{manifest}")
            return EXIT_NOT_RUN
        prior_backend_status = existing_manifest.get("backend_status")
        if prior_backend_status is None:
            # Read legacy manifests written before local Record and backend
            # publication were separated.
            prior_status = existing_manifest.get("record_status")
            if prior_status == "FAILED":
                prior_backend_status = "FAILED"
            elif prior_status == "PASS" and existing_manifest.get("integration_status") == "PASS":
                prior_backend_status = "PASS"
            else:
                prior_backend_status = "NOT_CONFIGURED"
        if prior_backend_status in {"PASS", "FAILED"}:
            try:
                prior_rc = int(existing_manifest.get("backend_rc", 0 if prior_backend_status == "PASS" else EXIT_NOT_RUN))
            except (TypeError, ValueError):
                emit("STATUS", "BLOCKED")
                emit("BLOCKER", "RECORD_MANIFEST_BACKEND_RC_INVALID")
                return EXIT_NOT_RUN
            if (prior_backend_status == "PASS" and prior_rc != 0) or (prior_backend_status == "FAILED" and prior_rc == 0):
                emit("STATUS", "BLOCKED")
                emit("BLOCKER", "RECORD_MANIFEST_STATUS_RC_CONFLICT")
                return EXIT_NOT_RUN
            emit("SOURCE_SHA256", source_sha)
            emit("ARTIFACT_SHA256", artifact_sha)
            emit("RAW_SHA256", raw_sha)
            emit("RECORD_MANIFEST", manifest)
            emit("RECORD_MANIFEST_STATUS", "RECORD_MANIFEST_REUSED")
            emit("RECORD_STATUS", "PASS")
            emit("BACKEND_STATUS", prior_backend_status)
            emit("BACKEND_RC", prior_rc)
            emit("INTEGRATION_STATUS", existing_manifest.get("integration_status", "UNKNOWN"))
            emit("IDEMPOTENT_NOOP", "YES")
            if prior_backend_status == "FAILED":
                emit("STATUS", "PASS")
                return prior_rc
            emit("STATUS", "PASS")
            return 0
    ok, manifest_status = save_manifest_once(manifest, manifest_payload)
    if not ok:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", manifest_status)
        return EXIT_NOT_RUN
    if backend is None and not args.backend:
        persisted = existing_manifest or manifest_payload
        backend_status = persisted.get("backend_status", initial_backend_status)
        emit("SOURCE_SHA256", source_sha)
        emit("ARTIFACT_SHA256", artifact_sha)
        emit("RAW_SHA256", raw_sha)
        emit("RECORD_MANIFEST", manifest)
        emit("RECORD_MANIFEST_STATUS", manifest_status)
        emit("RECORD_STATUS", "PASS")
        emit("BACKEND_STATUS", backend_status)
        emit("BACKEND_RC", persisted.get("backend_rc") if persisted.get("backend_rc") is not None else "NONE")
        emit("INTEGRATION_STATUS", persisted.get("integration_status", initial_integration_status))
        if manifest_status == "RECORD_MANIFEST_REUSED":
            emit("IDEMPOTENT_NOOP", "YES")
        emit("STATUS", "PASS")
        return 0
    if backend_error and args.backend:
        manifest_payload["backend_status"] = "CONFIGURATION_ERROR"
        manifest_payload["integration_status"] = "BACKEND_CONFIGURATION_ERROR"
        manifest_payload["backend_error"] = backend_error
        manifest_payload["backend_rc"] = None
        write_error = write_manifest_atomic(manifest, manifest_payload)
        if write_error:
            emit("STATUS", "PASS")
            emit("RECORD_STATUS", "PASS")
            emit("BACKEND_STATUS", "CONFIGURATION_ERROR")
            emit("BACKEND_ERROR", backend_error)
            emit("BLOCKER", write_error)
            return EXIT_NOT_RUN
        emit("RECORD_MANIFEST", manifest)
        emit("RECORD_MANIFEST_STATUS", manifest_status)
        emit("RECORD_STATUS", "PASS")
        emit("BACKEND_STATUS", "CONFIGURATION_ERROR")
        emit("BACKEND_RC", "NONE")
        emit("BACKEND_ERROR", backend_error)
        emit("INTEGRATION_STATUS", "BACKEND_CONFIGURATION_ERROR")
        emit("STATUS", "PASS")
        return EXIT_NOT_RUN
    command = backend_command(backend, args.backend_arg or [])
    emit("BACKEND_COMMAND", shlex.join(command))
    env = os.environ.copy()
    env.update({"W5CTL_ROUTE": ROUTE, "W5CTL_STAGE": "record"})
    env["W5CTL_EVIDENCE_PATHS"] = os.pathsep.join(str(path) for path in evidence_paths)
    env["W5CTL_SOURCE"] = str(source)
    env["W5CTL_SOURCE_SHA256"] = source_sha
    env["W5CTL_ARTIFACT"] = str(artifact)
    env["W5CTL_ARTIFACT_SHA256"] = artifact_sha
    env["W5CTL_RAW_PATH"] = str(raw)
    env["W5CTL_RAW_SHA256"] = raw_sha
    if canonical:
        env["W5CTL_CANONICAL_LOCAL_SCORE"] = canonical["reported_score"]
        env["W5CTL_CANONICAL_QUALITY"] = canonical["quality"]
        env["W5CTL_CANONICAL_SCORE_SCOPE"] = canonical["score_scope"]
    try:
        completed = subprocess.run(
            command, cwd=str(workdir) if workdir else None, env=env,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
    except OSError as exc:
        manifest_payload["backend_status"] = "FAILED"
        manifest_payload["integration_status"] = "BACKEND_FAILED"
        manifest_payload["backend_rc"] = EXIT_NOT_RUN
        manifest_payload["backend_error"] = f"BACKEND_EXEC_FAILED:{exc}"
        write_manifest_atomic(manifest, manifest_payload)
        emit("RECORD_MANIFEST", manifest)
        emit("RECORD_STATUS", "PASS")
        emit("BACKEND_STATUS", "FAILED")
        emit("BACKEND_RC", EXIT_NOT_RUN)
        emit("STATUS", "PASS")
        emit("BLOCKER", manifest_payload["backend_error"])
        return EXIT_NOT_RUN
    print_backend_output(completed.stdout, completed.stderr)
    actual_rc = normalize_rc(completed.returncode)
    log_written = write_log(args.log, completed.stdout, completed.stderr)
    emit("BACKEND_RC", actual_rc)
    if log_written:
        emit("OUTPUT_LOG", log_written)
    manifest_payload["record_status"] = "PASS"
    manifest_payload["backend_status"] = "PASS" if actual_rc == 0 else "FAILED"
    manifest_payload["integration_status"] = "PASS" if actual_rc == 0 else "BACKEND_FAILED"
    manifest_payload["backend_rc"] = actual_rc
    ok, manifest_status = save_manifest_once(manifest, manifest_payload)
    if not ok:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", manifest_status)
        return EXIT_NOT_RUN
    emit("RECORD_MANIFEST", manifest)
    emit("RECORD_MANIFEST_STATUS", manifest_status)
    emit("RECORD_STATUS", "PASS")
    emit("BACKEND_STATUS", manifest_payload["backend_status"])
    if actual_rc != 0:
        emit("STATUS", "PASS")
        return actual_rc
    emit("INTEGRATION_STATUS", "PASS")
    emit("STATUS", "PASS")
    return 0


def git_output(repo_root: Path, *arguments: str) -> Tuple[int, str]:
    try:
        completed = subprocess.run(
            ["git", *arguments],
            cwd=str(repo_root),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            text=True,
        )
    except OSError as exc:
        return EXIT_NOT_RUN, str(exc)
    return normalize_rc(completed.returncode), completed.stdout.rstrip("\r\n")


def doctor_command(args: argparse.Namespace) -> int:
    assert EXPECTED_REPO_ROOT is not None
    assert EXPECTED_BRANCH is not None
    assert ROUTE is not None
    assert ROUTE_ROOT is not None
    rc, actual_root, branch, context_error = current_git_context()
    if context_error or actual_root is None or branch is None:
        emit("DOCTOR_STATUS", "BLOCKED")
        emit("BLOCKER", context_error or "WORKTREE_ISOLATION:GIT_CONTEXT_UNAVAILABLE")
        return EXIT_NOT_RUN
    emit("REPO_ROOT", actual_root)
    root_ok = actual_root == EXPECTED_REPO_ROOT
    emit("REPO_ROOT_CHECK", "PASS" if root_ok else "FAIL")
    emit("BRANCH", branch)
    emit("EXPECTED_BRANCH", EXPECTED_BRANCH)
    emit("ROUTE", ROUTE)
    emit("ROUTE_ROOT", ROUTE_ROOT)
    branch_ok = branch == EXPECTED_BRANCH
    emit("BRANCH_CHECK", "PASS" if branch_ok else "FAIL")
    status_rc, status = git_output(actual_root, "-c", "core.quotePath=false", "status", "--short")
    changed = [line[3:] for line in status.splitlines() if len(line) >= 3]
    route_relative = ROUTE_ROOT.relative_to(EXPECTED_REPO_ROOT)
    route_prefix = "" if str(route_relative) == "." else str(route_relative) + "/"
    out_of_scope = [path for path in changed if route_prefix and not path.startswith(route_prefix)]
    emit("WORKTREE_CHANGED_COUNT", len(changed))
    emit("WORKTREE_SCOPE", "PASS" if not out_of_scope else "FAIL")
    if out_of_scope:
        emit("OUT_OF_SCOPE_CHANGES", ";".join(out_of_scope))
    if args.source:
        champion_path, champion_sha, champion_error = verify_file(args.source, "champion", required=True)
        champion_ok = champion_error is None
        if champion_error:
            emit("CHAMPION_CHECK", "FAIL")
            emit("CHAMPION_BLOCKER", champion_error)
        else:
            emit("CHAMPION_CHECK", "PASS")
            emit("CHAMPION_SHA256", champion_sha)
    else:
        champion_ok = False
        emit("CHAMPION_CHECK", "NOT_CONFIGURED")
        emit("CHAMPION_SHA256", "NONE")
    backend_fields = {
        "BUILD_BACKEND": os.environ.get("W5CTL_BUILD_BACKEND"),
        "CORRECTNESS_BACKEND": os.environ.get("W5CTL_CORRECTNESS_BACKEND"),
        "LOCAL_BACKEND": os.environ.get("W5CTL_LOCAL_BACKEND"),
        "RECORD_BACKEND": os.environ.get("W5CTL_RECORD_BACKEND"),
    }
    missing: List[str] = []
    for label, value in backend_fields.items():
        _, backend_error = resolve_backend(value)
        state = "READY" if value and not backend_error else "NOT_CONFIGURED"
        emit(label, state)
        if state != "READY":
            missing.append(label)
    emit("NO_SECOND_RUNNER", "YES")
    emit("NO_SECOND_SCORER", "YES")
    emit("REVISION_AUTOCREATE", "DISABLED")
    emit("ONLINE", "NOT_SUBMITTED")
    blocked = not (root_ok and branch_ok and status_rc == 0 and not out_of_scope and champion_ok)
    emit("EXECUTION_READINESS", "BLOCKED" if missing or blocked else "READY")
    emit("DOCTOR_STATUS", "PASS" if not blocked else "BLOCKED")
    if missing:
        emit("BACKEND_BLOCKER", "MISSING=" + ",".join(missing))
    return 0 if not blocked else EXIT_NOT_RUN


def checkpoint_path(args: argparse.Namespace) -> Optional[Path]:
    path, scope_error = scoped_path(args.checkpoint, "checkpoint")
    if scope_error:
        emit("CYCLE_STATUS", "BLOCKED")
        emit("BLOCKER", scope_error)
        return None
    if path is None:
        emit("CYCLE_STATUS", "BLOCKED")
        emit("BLOCKER", "CHECKPOINT_NOT_SET")
    return path


def parse_stage_order(raw: Optional[str]) -> List[str]:
    if not raw:
        return ["build", "correctness", "local"]
    stages = [part.strip() for part in raw.split(",") if part.strip()]
    if not stages or any(stage not in STAGES for stage in stages) or len(set(stages)) != len(stages):
        raise UsageError(f"invalid stage order: {raw}")
    indices = [STAGES.index(stage) for stage in stages]
    if indices != sorted(indices):
        raise UsageError("stage order must be build,correctness,local,record")
    return stages


def default_pipeline_stages(args: argparse.Namespace) -> List[str]:
    """A manifest request makes Record part of the default end-to-end cycle."""
    return ["build", "correctness", "local", "record"] if args.record_manifest else [
        "build", "correctness", "local"
    ]


def load_checkpoint(path: Path) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
    if not path.exists():
        return None, None
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return None, f"CHECKPOINT_READ_FAILED:{exc}"
    if not isinstance(payload, dict) or payload.get("schema") != 1 or payload.get("route") != ROUTE:
        return None, "CHECKPOINT_SCHEMA_OR_ROUTE_MISMATCH"
    if payload.get("repo_root") != str(EXPECTED_REPO_ROOT):
        return None, "CHECKPOINT_REPO_ROOT_MISMATCH"
    if payload.get("expected_branch") != EXPECTED_BRANCH:
        return None, "CHECKPOINT_EXPECTED_BRANCH_MISMATCH"
    return payload, None


def save_checkpoint(path: Path, payload: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(payload, stream, indent=2, sort_keys=True)
            stream.write("\n")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def same_record_identity(existing: Dict[str, Any], requested: Dict[str, Any]) -> bool:
    """Compare immutable evidence identity, excluding timestamps and backend outcome."""
    identity_fields = (
        "schema",
        "route",
        "stage",
        "repo_root",
        "expected_branch",
        "source",
        "artifact",
        "raw",
        "evidence",
        "stage_evidence",
        "local_result",
        "revision_created",
        "runner_created",
        "online",
    )
    return all(existing.get(field) == requested.get(field) for field in identity_fields)


def write_manifest_atomic(path: Path, payload: Dict[str, Any]) -> Optional[str]:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
        try:
            with os.fdopen(fd, "w") as stream:
                json.dump(payload, stream, indent=2, sort_keys=True)
                stream.write("\n")
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    except OSError as exc:
        return f"RECORD_MANIFEST_WRITE_FAILED:{exc}"
    return None


def save_manifest_once(path: Path, payload: Dict[str, Any]) -> Tuple[bool, Optional[str]]:
    """Persist/reuse an identity-bound local record and separate backend state."""
    if path.exists():
        try:
            existing = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            return False, f"RECORD_MANIFEST_READ_FAILED:{exc}"
        if not isinstance(existing, dict) or not same_record_identity(existing, payload):
            return False, f"RECORD_MANIFEST_IDENTITY_CONFLICT:{path}"
        existing_backend = existing.get("backend_status")
        requested_backend = payload.get("backend_status")
        if existing_backend is None:
            old_status = existing.get("record_status")
            if old_status == "FAILED":
                existing_backend = "FAILED"
            elif old_status == "PASS" and existing.get("integration_status") == "PASS":
                existing_backend = "PASS"
            else:
                existing_backend = "NOT_CONFIGURED"
        if existing_backend in {"PASS", "FAILED"}:
            return True, "RECORD_MANIFEST_REUSED"
        if existing_backend == requested_backend:
            return True, "RECORD_MANIFEST_REUSED"
        allowed_transitions = {
            "NOT_CONFIGURED": {"PENDING", "CONFIGURATION_ERROR"},
            "NOT_REQUESTED": {"PENDING", "CONFIGURATION_ERROR"},
            "CONFIGURATION_ERROR": {"PENDING", "CONFIGURATION_ERROR"},
            "PENDING": {"PASS", "FAILED", "CONFIGURATION_ERROR"},
        }
        if requested_backend not in allowed_transitions.get(existing_backend, set()):
            return False, f"RECORD_MANIFEST_BACKEND_STATE_CONFLICT:{existing_backend}->{requested_backend}"
        error = write_manifest_atomic(path, payload)
        return (False, error) if error else (True, "RECORD_MANIFEST_FINALIZED")
    error = write_manifest_atomic(path, payload)
    if error:
        return False, error
    return True, "RECORD_MANIFEST_WRITTEN"


def checkpoint_identity(
    args: argparse.Namespace,
    payload: Dict[str, Any],
) -> Tuple[Optional[Path], Optional[str], Optional[Path], Optional[str], Optional[Dict[str, str]], Optional[str]]:
    source_raw = args.source or payload.get("identity", {}).get("source_path")
    artifact_raw = args.artifact or payload.get("identity", {}).get("artifact_path")
    source, source_sha, source_error = verify_file(
        source_raw,
        "source",
        args.expected_source_sha or payload.get("identity", {}).get("source_sha256"),
        required=True,
    )
    if source_error:
        return source, source_sha, None, None, None, source_error
    stored = payload.get("identity", {})
    artifact_raw = args.artifact or stored.get("artifact_path")
    artifact_receipt_raw = getattr(args, "artifact_receipt", None) or stored.get("artifact_receipt_path")
    artifact, artifact_sha, artifact_error, artifact_identity = verify_artifact_reference(
        artifact_raw,
        args.expected_artifact_sha or stored.get("artifact_sha256"),
        artifact_receipt_raw,
    )
    if artifact_error and not artifact_error.startswith("ARTIFACT_MISSING:"):
        return source, source_sha, artifact, artifact_sha, artifact_identity, artifact_error
    if stored.get("source_path") and str(source) != stored["source_path"]:
        return source, source_sha, artifact, artifact_sha, artifact_identity, "CHECKPOINT_SOURCE_PATH_CHANGED"
    if stored.get("source_sha256") and source_sha != stored["source_sha256"]:
        return source, source_sha, artifact, artifact_sha, artifact_identity, "CHECKPOINT_SOURCE_SHA_CHANGED"
    stored_artifact = stored.get("artifact_path")
    if stored_artifact and artifact and str(artifact) != stored_artifact:
        return source, source_sha, artifact, artifact_sha, artifact_identity, "CHECKPOINT_ARTIFACT_PATH_CHANGED"
    if stored.get("artifact_sha256") and artifact_sha != stored["artifact_sha256"]:
        return source, source_sha, artifact, artifact_sha, artifact_identity, "CHECKPOINT_ARTIFACT_SHA_CHANGED"
    return source, source_sha, artifact, artifact_sha, artifact_identity, None


def stage_options(args: argparse.Namespace, stage: str) -> Dict[str, Any]:
    return {
        "backend": getattr(args, f"{stage}_backend"),
        "backend_arg": getattr(args, f"{stage}_arg") or [],
        "log": getattr(args, f"{stage}_log"),
    }


def run_record_from_pipeline(
    args: argparse.Namespace,
    payload: Dict[str, Any],
    source: Path,
    artifact: Path,
) -> Outcome:
    evidence = args.record_evidence or []
    if not evidence and not args.canonical_measurements:
        emit("STATUS", "NOT_RUN")
        emit("BLOCKER", "RECORD_EVIDENCE_NOT_SET")
        return Outcome("NOT_RUN", EXIT_NOT_RUN, reason="RECORD_EVIDENCE_NOT_SET")
    local_stage = payload.get("stages", {}).get("local", {})
    raw_path = args.raw or args.canonical_measurements or local_stage.get("raw_path")
    manifest = args.record_manifest
    if not raw_path or not manifest:
        emit("STATUS", "NOT_RUN")
        emit("BLOCKER", "RECORD_RAW_AND_MANIFEST_REQUIRED")
        return Outcome("INTEGRATION_INCOMPLETE", EXIT_NOT_RUN, reason="RECORD_RAW_AND_MANIFEST_REQUIRED")
    proxy = argparse.Namespace(
        evidence=evidence,
        backend=args.record_backend,
        backend_arg=args.record_arg or [],
        backend_workdir=args.record_workdir,
        log=args.record_log,
        source=str(source),
        artifact=str(artifact),
        artifact_receipt=(
            getattr(args, "artifact_receipt", None)
            or payload.get("identity", {}).get("artifact_receipt_path")
        ),
        build_receipt=getattr(args, "build_receipt", None),
        correctness_receipt=getattr(args, "correctness_receipt", None),
        raw=raw_path,
        manifest=manifest,
        expected_source_sha=payload.get("identity", {}).get("source_sha256"),
        expected_artifact_sha=payload.get("identity", {}).get("artifact_sha256"),
        canonical_measurements=args.canonical_measurements,
        canonical_purpose=args.canonical_purpose,
        canonical_revision=args.canonical_revision,
        expected_parent_artifact_sha=args.expected_parent_artifact_sha,
        min_pairs=args.min_pairs,
        max_cv=args.max_cv,
    )
    record_rc = record_command(proxy)
    details: Dict[str, Any] = {}
    manifest_path = resolve_path(manifest)
    if manifest_path and manifest_path.is_file():
        try:
            details["record"] = json.loads(manifest_path.read_text())
        except (OSError, json.JSONDecodeError):
            pass
    record_payload = details.get("record", {})
    local_record_pass = record_payload.get("record_status") == "PASS"
    status = "PASS" if local_record_pass else "INTEGRATION_INCOMPLETE"
    backend_status = record_payload.get("backend_status", "UNKNOWN")
    return Outcome(
        status,
        record_rc,
        raw_sha=details.get("record", {}).get("raw", {}).get("sha256"),
        reason=("RECORD_BACKEND_" + str(backend_status)) if backend_status not in {"PASS", "NOT_CONFIGURED", "NOT_REQUESTED"} else None,
        details={**details, "stage_status": status},
    )


def pipeline_command(args: argparse.Namespace, resume: bool) -> int:
    isolation_error = require_current_worktree()
    if isolation_error:
        emit("CYCLE_STATUS", "BLOCKED")
        emit("BLOCKER", isolation_error)
        return EXIT_NOT_RUN
    path = checkpoint_path(args)
    if path is None:
        return EXIT_NOT_RUN
    existing, error = load_checkpoint(path)
    if error:
        emit("CYCLE_STATUS", "BLOCKED")
        emit("BLOCKER", error)
        return EXIT_NOT_RUN
    if resume and existing is None:
        emit("CYCLE_STATUS", "BLOCKED")
        emit("BLOCKER", "CHECKPOINT_NOT_FOUND")
        return EXIT_NOT_RUN
    try:
        requested_stages = parse_stage_order(args.stages) if args.stages else None
    except UsageError as exc:
        emit("CYCLE_STATUS", "BLOCKED")
        emit("BLOCKER", str(exc))
        return EXIT_USAGE
    defaults = default_pipeline_stages(args)
    if existing:
        stages = existing.get("stage_order", requested_stages or defaults)
        if requested_stages and stages != requested_stages:
            emit("CYCLE_STATUS", "BLOCKED")
            emit("BLOCKER", "CHECKPOINT_STAGE_ORDER_CHANGED")
            return EXIT_NOT_RUN
        if args.record_manifest and not requested_stages and "record" not in stages:
            emit("CYCLE_STATUS", "BLOCKED")
            emit("E2E_STATUS", "INCOMPLETE")
            emit("BLOCKER", "CHECKPOINT_MISSING_RECORD_STAGE_USE_EXPLICIT_STAGES")
            return EXIT_NOT_RUN
        payload = existing
    else:
        stages = requested_stages or defaults
        payload = {
            "schema": 1,
            "route": ROUTE,
            "repo_root": str(EXPECTED_REPO_ROOT),
            "expected_branch": EXPECTED_BRANCH,
            "created_utc": now_utc(),
            "stage_order": stages,
            "identity": {},
            "stages": {},
            "record_manifest": None,
            "revision_created": False,
            "runner_created": False,
            "online": "NOT_SUBMITTED",
        }
    source, source_sha, artifact, artifact_sha, artifact_identity, identity_error = checkpoint_identity(args, payload)
    if identity_error:
        emit("CYCLE_STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", identity_error)
        return EXIT_IDENTITY
    assert source is not None and source_sha is not None and artifact is not None
    payload["identity"].update({
        "source_path": str(source),
        "source_sha256": source_sha,
        "artifact_path": str(artifact),
        "artifact_sha256": artifact_sha,
    })
    if artifact_identity and artifact_identity.get("identity_mode") == "PUBLIC_BUILD_RECEIPT":
        payload["identity"]["artifact_identity_mode"] = artifact_identity["identity_mode"]
        payload["identity"]["artifact_receipt_path"] = str(artifact)
        payload["identity"]["artifact_receipt_sha256"] = artifact_identity.get("receipt_sha256")
    payload["updated_utc"] = now_utc()
    save_checkpoint(path, payload)
    start_stage = args.from_stage if resume else None
    if start_stage and start_stage not in stages:
        emit("CYCLE_STATUS", "BLOCKED")
        emit("BLOCKER", f"FROM_STAGE_NOT_IN_CHECKPOINT:{start_stage}")
        return EXIT_USAGE
    if start_stage:
        for prior in stages[: stages.index(start_stage)]:
            prior_status = payload.get("stages", {}).get(prior, {}).get("status")
            if prior_status not in TERMINAL_STAGE_STATUSES:
                emit("CYCLE_STATUS", "BLOCKED")
                emit("BLOCKER", f"PRIOR_STAGE_NOT_COMPLETE:{prior}")
                return EXIT_NOT_RUN
    did_work = False
    for stage in stages:
        stage_record = payload.setdefault("stages", {}).get(stage, {})
        force_stage = bool(resume and start_stage == stage)
        if stage_record.get("status") in TERMINAL_STAGE_STATUSES and not force_stage:
            if stage == "local":
                raw_path, _, raw_error = verify_file(
                    args.raw or stage_record.get("raw_path"),
                    "raw",
                    stage_record.get("raw_sha256"),
                    required=True,
                )
                if raw_error or raw_path is None:
                    emit("CYCLE_STATUS", "BLOCKED")
                    emit("IDENTITY_STATUS", "FAIL")
                    emit("BLOCKER", raw_error or "RAW_SAMPLES_MISSING")
                    return EXIT_IDENTITY
            emit("STAGE", stage)
            emit("STAGE_STATUS", "SKIPPED_CHECKPOINT_" + stage_record["status"])
            continue
        if existing and not resume and stage_record:
            emit("CYCLE_STATUS", "BLOCKED")
            emit("BLOCKER", f"CHECKPOINT_REQUIRES_RESUME:{stage}")
            return EXIT_NOT_RUN
        did_work = True
        opts = stage_options(args, stage) if stage != "record" else None
        if stage == "record":
            outcome = run_record_from_pipeline(args, payload, source, artifact)
        else:
            raw_arg = args.raw or args.canonical_measurements or stage_record.get("raw_path")
            outcome = identity_stage(
                stage,
                opts["backend"],
                opts["backend_arg"],
                args.backend_workdir,
                opts["log"],
                str(source),
                str(artifact),
                args.expected_source_sha,
                args.expected_artifact_sha,
                raw_arg,
                args.min_pairs,
                args.max_cv,
                args.canonical_measurements,
                args.canonical_purpose,
                args.canonical_revision,
                args.expected_parent_artifact_sha,
                getattr(args, "artifact_receipt", None),
            )
        stage_status = outcome.details.get("stage_status", outcome.status)
        stage_payload: Dict[str, Any] = {
            "status": stage_status,
            "return_code": outcome.rc,
            "reason": outcome.reason,
            "source_sha256": outcome.source_sha,
            "artifact_sha256": outcome.artifact_sha,
            "raw_sha256": outcome.raw_sha,
            "raw_path": str(resolve_path(args.raw or args.canonical_measurements or stage_record.get("raw_path")))
            if stage == "local" and (args.raw or args.canonical_measurements or stage_record.get("raw_path")) else None,
            "result": outcome.details.get("local") if stage == "local" else None,
            "record": outcome.details.get("record") if stage == "record" else None,
            "finished_utc": now_utc(),
        }
        payload["stages"][stage] = stage_payload
        if stage == "local" and outcome.details.get("local"):
            payload["identity"]["raw_path"] = stage_payload["raw_path"]
            payload["identity"]["raw_sha256"] = outcome.details["local"].get("raw_sha")
        if stage == "record":
            payload["record_manifest"] = str(resolve_path(args.record_manifest)) if args.record_manifest else None
            if outcome.details.get("record"):
                payload["evidence"] = outcome.details["record"].get("evidence", [])
        if outcome.artifact_sha:
            payload["identity"]["artifact_sha256"] = outcome.artifact_sha
        payload["updated_utc"] = now_utc()
        save_checkpoint(path, payload)
        emit("CHECKPOINT", path)
        if outcome.rc != 0:
            if stage == "local" and stage_status in {"REJECTED", "UNCLASSIFIED"}:
                continue
            if stage == "record" and stage_status == "PASS":
                emit("RECORD_BACKEND_FAILURE_RECORDED", "YES")
                continue
            emit("CURRENT_STAGE", stage)
            emit("NEXT_ACTION", "resume --from-stage " + stage)
            return outcome.rc
    all_pass = all(payload.get("stages", {}).get(stage, {}).get("status") == "PASS" for stage in stages)
    payload["status"] = "PASS" if all_pass else "INCOMPLETE"
    e2e_complete = (
        "record" in stages
        and payload.get("record_manifest")
        and payload.get("stages", {}).get("record", {}).get("status") == "PASS"
    )
    payload["e2e_status"] = "PASS" if e2e_complete else "INCOMPLETE"
    payload["updated_utc"] = now_utc()
    save_checkpoint(path, payload)
    emit("CHECKPOINT", path)
    emit("CYCLE_STATUS", "PASS" if all_pass else "INCOMPLETE")
    emit("E2E_STATUS", payload["e2e_status"])
    emit("CURRENT_STAGE", stages[-1] if stages else "NONE")
    emit("NEXT_ACTION", "report --checkpoint " + str(path))
    if not did_work:
        emit("IDEMPOTENT_NOOP", "YES")
    emit("REVISION_CREATED", "NO")
    emit("RUNNER_CREATED", "NO")
    emit("ONLINE", "NOT_SUBMITTED")
    return 0 if all_pass else EXIT_NOT_RUN


def report_manifest_command(path: Path) -> int:
    manifest_path, manifest_sha, manifest_error = verify_file(
        str(path), "manifest", required=True
    )
    if manifest_error or manifest_path is None or manifest_sha is None:
        emit("REPORT_STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", manifest_error or "RECORD_MANIFEST_NOT_FOUND")
        return EXIT_IDENTITY
    try:
        payload = json.loads(manifest_path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        emit("REPORT_STATUS", "NOT_RUN")
        emit("BLOCKER", f"RECORD_MANIFEST_READ_FAILED:{exc}")
        return EXIT_NOT_RUN
    if not isinstance(payload, dict) or payload.get("schema") != 1 or payload.get("stage") != "record":
        emit("REPORT_STATUS", "BLOCKED")
        emit("BLOCKER", "RECORD_MANIFEST_SCHEMA_MISMATCH")
        return EXIT_NOT_RUN
    if payload.get("route") != ROUTE:
        emit("REPORT_STATUS", "BLOCKED")
        emit("BLOCKER", "RECORD_MANIFEST_ROUTE_MISMATCH")
        return EXIT_NOT_RUN
    if payload.get("repo_root") != str(EXPECTED_REPO_ROOT):
        emit("REPORT_STATUS", "BLOCKED")
        emit("BLOCKER", "RECORD_MANIFEST_REPO_ROOT_MISMATCH")
        return EXIT_NOT_RUN
    if payload.get("expected_branch") != EXPECTED_BRANCH:
        emit("REPORT_STATUS", "BLOCKED")
        emit("BLOCKER", "RECORD_MANIFEST_EXPECTED_BRANCH_MISMATCH")
        return EXIT_NOT_RUN

    artifact_item = payload.get("artifact")
    identities = [
        ("source", payload.get("source")),
        ("raw", payload.get("raw")),
    ]
    evidence = payload.get("evidence")
    if not isinstance(evidence, list) or not evidence:
        emit("REPORT_STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", "RECORD_MANIFEST_EVIDENCE_MISSING")
        return EXIT_IDENTITY
    identities.extend((f"evidence_{index}", item) for index, item in enumerate(evidence))

    resolved: Dict[str, Tuple[Path, str]] = {}
    if not isinstance(artifact_item, dict) or not isinstance(artifact_item.get("path"), str) or not isinstance(artifact_item.get("sha256"), str):
        emit("REPORT_STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", "RECORD_MANIFEST_IDENTITY_MALFORMED:artifact")
        return EXIT_IDENTITY
    for label, item in identities:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str) or not isinstance(item.get("sha256"), str):
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", f"RECORD_MANIFEST_IDENTITY_MALFORMED:{label}")
            return EXIT_IDENTITY
        identity_scoped, identity_scope_error = scoped_path(item["path"], label)
        if identity_scope_error or identity_scoped is None:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", identity_scope_error or f"RECORD_MANIFEST_IDENTITY_INVALID:{label}")
            return EXIT_IDENTITY
        try:
            identity_scoped.relative_to(ROUTE_ROOT)
        except ValueError:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", f"OUT_OF_SCOPE:{label}:{identity_scoped}:expected={ROUTE_ROOT}")
            return EXIT_IDENTITY
        identity_path, digest, identity_error = verify_file(
            str(identity_scoped), label, item["sha256"], required=True
        )
        if identity_error or identity_path is None or digest is None:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", identity_error or f"RECORD_MANIFEST_IDENTITY_INVALID:{label}")
            return EXIT_IDENTITY
        resolved[label] = (identity_path, digest)

    artifact_identity_mode = artifact_item.get("identity_mode", "LOCAL_FILE_SHA256")
    if artifact_identity_mode == "PUBLIC_BUILD_RECEIPT":
        artifact_path, artifact_sha, artifact_error, artifact_meta = verify_artifact_reference(
            None, artifact_item["sha256"], artifact_item["path"]
        )
        if artifact_error or artifact_path is None or artifact_sha is None or artifact_meta is None:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", artifact_error or "RECORD_MANIFEST_ARTIFACT_RECEIPT_INVALID")
            return EXIT_IDENTITY
        if artifact_item.get("receipt_sha256") != artifact_meta.get("receipt_sha256"):
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", "RECORD_MANIFEST_ARTIFACT_RECEIPT_SHA_MISMATCH")
            return EXIT_IDENTITY
        resolved["artifact"] = (artifact_path, artifact_sha)
    else:
        artifact_path, artifact_scope_error = scoped_path(artifact_item["path"], "artifact")
        if artifact_scope_error or artifact_path is None:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", artifact_scope_error or "RECORD_MANIFEST_IDENTITY_INVALID:artifact")
            return EXIT_IDENTITY
        try:
            artifact_path.relative_to(ROUTE_ROOT)
        except ValueError:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", f"OUT_OF_SCOPE:artifact:{artifact_path}:expected={ROUTE_ROOT}")
            return EXIT_IDENTITY
        artifact_path, artifact_sha, artifact_error = verify_file(
            str(artifact_path), "artifact", artifact_item["sha256"], required=True
        )
        if artifact_error or artifact_path is None or artifact_sha is None:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", artifact_error or "RECORD_MANIFEST_IDENTITY_INVALID:artifact")
            return EXIT_IDENTITY
        resolved["artifact"] = (artifact_path, artifact_sha)

    stage_evidence = payload.get("stage_evidence") or {}
    if not isinstance(stage_evidence, dict):
        emit("REPORT_STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", "RECORD_MANIFEST_STAGE_EVIDENCE_INVALID")
        return EXIT_IDENTITY
    for stage in ("build", "correctness"):
        item = stage_evidence.get(stage)
        if item is None:
            emit(stage.upper() + "_STATUS", "NOT_INCLUDED_IN_MANIFEST")
            continue
        if not isinstance(item, dict) or not isinstance(item.get("path"), str) or not isinstance(item.get("sha256"), str):
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", f"RECORD_MANIFEST_STAGE_EVIDENCE_MALFORMED:{stage}")
            return EXIT_IDENTITY
        verified, stage_error = verify_stage_receipt(
            item["path"], stage, resolved["source"][1], resolved["artifact"][1]
        )
        if stage_error or verified is None:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", stage_error or f"RECORD_MANIFEST_STAGE_EVIDENCE_INVALID:{stage}")
            return EXIT_IDENTITY
        if verified["sha256"] != item["sha256"]:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", f"RECORD_MANIFEST_STAGE_EVIDENCE_SHA_MISMATCH:{stage}")
            return EXIT_IDENTITY
        emit(stage.upper() + "_STATUS", "PASS")

    local = payload.get("local_result")
    if not isinstance(local, dict):
        local = {}
    source_path, source_sha = resolved["source"]
    artifact_path, artifact_sha = resolved["artifact"]
    raw_path, raw_sha = resolved["raw"]
    integration_status = payload.get("integration_status", "UNKNOWN")
    full_score = local.get("full_local_score", "NOT_COMPUTABLE")
    canonical = local.get("canonical")
    if isinstance(canonical, dict):
        recomputed, canonical_error = canonical_local_score(
            canonical.get("measurements_path"), source_sha, artifact_sha,
            canonical.get("score_scope", ""), canonical.get("subject_revision"),
            canonical.get("parent_artifact_sha256"),
        )
        if canonical_error or recomputed is None:
            emit("REPORT_STATUS", "BLOCKED")
            emit("IDENTITY_STATUS", "FAIL")
            emit("BLOCKER", canonical_error or "CANONICAL_SCORE_REVALIDATION_FAILED")
            return EXIT_IDENTITY
        for key in (
            "reported_score", "quality", "local_status", "reliable", "promotion_eligible",
            "raw_manifest_sha256", "parent_artifact_sha256", "measurements_sha256",
            "scorer_commit", "scorer_sha256", "suite_sha256", "harness_sha256",
        ):
            if recomputed.get(key) != canonical.get(key):
                emit("REPORT_STATUS", "BLOCKED")
                emit("IDENTITY_STATUS", "FAIL")
                emit("BLOCKER", f"CANONICAL_SCORE_MANIFEST_MISMATCH:{key}")
                return EXIT_IDENTITY
        full_score = canonical.get("full_local_score", "NOT_COMPUTABLE")

    emit("ROUTE", payload.get("route"))
    emit("RECORD_MANIFEST", manifest_path)
    emit("RECORD_MANIFEST_SHA256", manifest_sha)
    emit("RECORD_MANIFEST_STATUS", "IDENTITY_VERIFIED")
    emit("IDENTITY_STATUS", "PASS")
    emit("SOURCE_PATH", source_path)
    emit("SOURCE_SHA256", source_sha)
    emit("ARTIFACT_PATH", artifact_path)
    emit("ARTIFACT_SHA256", artifact_sha)
    emit("RAW_PATH", raw_path)
    emit("RAW_SHA256", raw_sha)
    emit("EVIDENCE_COUNT", len(evidence))
    for index, _ in enumerate(evidence):
        evidence_path, evidence_sha = resolved[f"evidence_{index}"]
        emit("EVIDENCE_PATH", evidence_path)
        emit("EVIDENCE_SHA256", evidence_sha)
    emit("LOCAL_STATUS", local.get("status", "NOT_RUN"))
    emit("LOCAL_MEASUREMENT_QUALITY", local.get("status", "NOT_RUN"))
    emit("LOCAL_QUALITY_CLASSIFICATION", local.get("quality_classification", "UNKNOWN"))
    emit("MEDIAN_PARENT_US", fmt_number(local.get("parent_median")))
    emit("MEDIAN_CANDIDATE_US", fmt_number(local.get("candidate_median")))
    emit("MEDIAN_RATIO_DELTA", fmt_number(local.get("ratio_delta")))
    emit("PAIRED_MEDIAN_DELTA_US", fmt_number(local.get("paired_delta")))
    emit("PAIRED_MEDIAN_PERCENT_DELTA", fmt_number(local.get("paired_percent_delta")))
    emit("RAW_SAMPLE_COUNT", local.get("raw_count", 0))
    emit("RAW_PAIR_COUNT", local.get("pair_count", 0))
    emit("MEASUREMENT_QUALITY", local.get("quality_classification", "UNKNOWN"))
    emit("NOISE_STATUS", local.get("noise_status", "UNKNOWN"))
    emit("SHAPE_LOCAL_VERDICT", local.get("shape_local_verdict", "NOT_RUN"))
    emit("SHAPE_CANDIDATE_MEDIAN_US", fmt_number(local.get("shape_candidate_median_us")))
    emit("SHAPE_PAIRED_DELTA_US", fmt_number(local.get("shape_paired_delta_us")))
    emit("SHAPE_PAIRED_PERCENT_DELTA", fmt_number(local.get("shape_paired_percent_delta")))
    emit("FULL_LOCAL_SCORE", full_score)
    emit("PROMOTION_ELIGIBLE", "YES" if local.get("promotion_eligible") else "NO")
    if isinstance(canonical, dict):
        print_canonical_stats(local)
        emit("CANONICAL_SUBJECT_REVISION", canonical.get("subject_revision", "NONE"))
        emit("CANONICAL_SCORE_SCOPE", canonical.get("score_scope", "UNKNOWN"))
        emit("CANONICAL_LOCAL_SCORE", canonical.get("reported_score", "NOT_COMPUTABLE"))
        emit("CANONICAL_QUALITY", canonical.get("quality", "UNKNOWN"))
        emit("CANONICAL_RELIABLE", "YES" if canonical.get("reliable") else "NO")
        emit("CANONICAL_CORE_CASES_COMPLETE", canonical.get("core_cases_complete", "NOT_COMPUTABLE"))
        emit("CANONICAL_SCORE_REVALIDATION", "PASS_READ_ONLY")
    emit("LOCAL_REASON", local.get("reason", "NONE"))
    record_status = payload.get("record_status", "UNKNOWN")
    backend_status = payload.get("backend_status")
    if backend_status is None:
        if payload.get("integration_status") == "PASS":
            backend_status = "PASS"
        elif record_status == "FAILED":
            backend_status = "FAILED"
        elif payload.get("integration_status") == "INTEGRATION_INCOMPLETE":
            backend_status = "NOT_CONFIGURED"
        else:
            backend_status = "UNKNOWN"
    emit("RECORD_STATUS", record_status)
    emit("BACKEND_STATUS", backend_status)
    emit("BACKEND_RC", payload.get("backend_rc") if payload.get("backend_rc") is not None else "NONE")
    emit("RECORD_INTEGRATION_STATUS", integration_status)
    emit("REVISION_CREATED", "YES" if payload.get("revision_created") else "NO")
    emit("RUNNER_CREATED", "YES" if payload.get("runner_created") else "NO")
    emit("ONLINE", payload.get("online", "NOT_SUBMITTED"))
    complete_score = (
        isinstance(canonical, dict)
        and canonical.get("core_cases_complete") == "4/4"
        and canonical.get("reported_score") not in (None, "", "NOT_COMPUTABLE")
    )
    emit("LOCAL_SCORE_COMPLETENESS", "COMPLETE" if complete_score else "INCOMPLETE")
    local_record_persisted = record_status in {"PASS", "FAILED", "LOCAL_MANIFEST_WRITTEN"}
    report_status = "PASS" if local_record_persisted else "INCOMPLETE"
    emit("REPORT_STATUS", report_status)
    return 0


def report_route_summary_command() -> int:
    assert ROUTE_ROOT is not None
    summaries: Dict[str, Dict[str, Any]] = {}
    invalid: List[Tuple[str, str]] = []
    seen_paths = set()
    for candidate_path in sorted(ROUTE_ROOT.rglob("*.json")):
        try:
            resolved_path = candidate_path.resolve(strict=True)
            resolved_path.relative_to(ROUTE_ROOT)
        except (OSError, ValueError):
            continue
        if resolved_path in seen_paths or not resolved_path.is_file():
            continue
        seen_paths.add(resolved_path)
        try:
            payload = json.loads(resolved_path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if (
            not isinstance(payload, dict)
            or payload.get("schema") != 1
            or payload.get("stage") != "record"
            or payload.get("route") != ROUTE
        ):
            continue
        local = payload.get("local_result")
        canonical = local.get("canonical") if isinstance(local, dict) else None
        if not isinstance(canonical, dict) or canonical.get("score_scope") != "route-kernel":
            continue
        captured = io.StringIO()
        with contextlib.redirect_stdout(captured):
            result = report_manifest_command(resolved_path)
        values: Dict[str, str] = {}
        for line in captured.getvalue().splitlines():
            key, separator, value = line.partition("=")
            if separator:
                values[key] = value
        if result != 0 or values.get("REPORT_STATUS") != "PASS":
            invalid.append((str(resolved_path.relative_to(ROUTE_ROOT)), values.get("BLOCKER", "MANIFEST_NOT_VERIFIED")))
            continue
        revision = values.get("CANONICAL_SUBJECT_REVISION", "").strip()
        score = values.get("CANONICAL_LOCAL_SCORE", "NOT_COMPUTABLE")
        quality = values.get("CANONICAL_QUALITY", "UNKNOWN")
        reliable = values.get("CANONICAL_RELIABLE") == "YES"
        if (
            not revision
            or values.get("CANONICAL_CORE_CASES_COMPLETE") != "4/4"
            or score in {"", "NOT_COMPUTABLE"}
        ):
            invalid.append((str(resolved_path.relative_to(ROUTE_ROOT)), "CANONICAL_SCORE_INCOMPLETE"))
            continue
        entry = {
            "revision": revision,
            "score": score,
            "quality": quality,
            "reliable": reliable,
            "recorded_utc": str(payload.get("recorded_utc", "")),
            "manifest": str(resolved_path),
        }
        current = summaries.get(revision)
        if current is None or (entry["recorded_utc"], entry["manifest"]) > (
            current["recorded_utc"], current["manifest"]
        ):
            summaries[revision] = entry

    ordered = sorted(
        summaries.values(),
        key=lambda item: (item["recorded_utc"], item["revision"]),
    )
    emit("ROUTE", ROUTE)
    emit("ROUTE_ROOT", ROUTE_ROOT)
    emit("KERNEL_REVISION_COUNT", len(ordered))
    if not ordered:
        emit("KERNEL_REVISIONS", "NONE" if not invalid else "UNVERIFIED")
        emit("LATEST_REVISION", "NONE" if not invalid else "UNVERIFIED")
        emit("LATEST_SCORE", "NONE")
        emit("LATEST_QUALITY", "NONE")
    else:
        emit("KERNEL_REVISIONS", ",".join(item["revision"] for item in ordered))
        for item in ordered:
            emit("KERNEL_REVISION", item["revision"])
            emit("REVISION_SCORE", item["score"])
            emit("REVISION_QUALITY", item["quality"])
            emit("REVISION_RELIABLE", "YES" if item["reliable"] else "NO")
            emit("REVISION_MANIFEST", item["manifest"])
        latest = ordered[-1]
        emit("LATEST_REVISION", latest["revision"])
        emit("LATEST_SCORE", latest["score"])
        emit("LATEST_QUALITY", latest["quality"])
    reliable_entries = [item for item in ordered if item["reliable"]]
    if reliable_entries:
        best = max(reliable_entries, key=lambda item: (float(item["score"]), item["revision"]))
        emit("BEST_LOCAL_REVISION", best["revision"])
        emit("BEST_LOCAL_SCORE", best["score"])
        emit("BEST_LOCAL_QUALITY", best["quality"])
        emit("BEST_LOCAL_MANIFEST", best["manifest"])
    else:
        emit("BEST_LOCAL_REVISION", "NONE")
        emit("BEST_LOCAL_SCORE", "NONE")
        emit("BEST_LOCAL_QUALITY", "NONE")
        emit("BEST_LOCAL_MANIFEST", "NONE")
    emit("UNVERIFIED_KERNEL_MANIFEST_COUNT", len(invalid))
    for path, reason in invalid:
        emit("UNVERIFIED_KERNEL_MANIFEST", f"{path}:{reason}")
    emit("SUMMARY_SCOPE", "ROUTE_ROOT_ONLY")
    emit("SCOREBOARD_WRITTEN", "NO")
    emit("REPORT_STATUS", "PASS" if not invalid else "PARTIAL")
    return 0


def report_command(args: argparse.Namespace) -> int:
    isolation_error = require_current_worktree()
    if isolation_error:
        emit("REPORT_STATUS", "BLOCKED")
        emit("BLOCKER", isolation_error)
        return EXIT_NOT_RUN
    if getattr(args, "route_summary", False):
        return report_route_summary_command()
    if args.manifest:
        path, scope_error = scoped_path(args.manifest, "manifest")
        if scope_error:
            emit("REPORT_STATUS", "BLOCKED")
            emit("BLOCKER", scope_error)
            return EXIT_NOT_RUN
        if path is None:
            emit("REPORT_STATUS", "NOT_RUN")
            emit("BLOCKER", "RECORD_MANIFEST_NOT_SET")
            return EXIT_NOT_RUN
        try:
            path.relative_to(ROUTE_ROOT)
        except ValueError:
            emit("REPORT_STATUS", "BLOCKED")
            emit("BLOCKER", f"OUT_OF_SCOPE:manifest:{path}:expected={ROUTE_ROOT}")
            return EXIT_NOT_RUN
        return report_manifest_command(path)

    path, scope_error = scoped_path(args.checkpoint, "checkpoint")
    if scope_error:
        emit("REPORT_STATUS", "BLOCKED")
        emit("BLOCKER", scope_error)
        return EXIT_NOT_RUN
    if path is None:
        emit("REPORT_STATUS", "NOT_RUN")
        emit("BLOCKER", "CHECKPOINT_NOT_SET")
        return EXIT_NOT_RUN
    payload, error = load_checkpoint(path)
    if error or payload is None:
        emit("REPORT_STATUS", "NOT_RUN")
        emit("BLOCKER", error or "CHECKPOINT_NOT_FOUND")
        return EXIT_NOT_RUN
    emit("ROUTE", payload.get("route"))
    emit("CHECKPOINT", path)
    emit("CHECKPOINT_STATUS", payload.get("status", "INCOMPLETE"))
    identity = payload.get("identity", {})
    emit("SOURCE_PATH", identity.get("source_path", "NONE"))
    emit("SOURCE_SHA256", identity.get("source_sha256", "NONE"))
    emit("ARTIFACT_PATH", identity.get("artifact_path", "NONE"))
    emit("ARTIFACT_SHA256", identity.get("artifact_sha256", "NONE"))
    stages = payload.get("stage_order", [])
    for stage in stages:
        stage_payload = payload.get("stages", {}).get(stage, {})
        emit(stage.upper() + "_STATUS", stage_payload.get("status", "NOT_RUN"))
        emit(stage.upper() + "_RETURN_CODE", stage_payload.get("return_code", "NONE"))
        emit(stage.upper() + "_REASON", stage_payload.get("reason", "NONE"))
        if stage == "local":
            local = stage_payload.get("result") or {}
            canonical = local.get("canonical")
            if isinstance(canonical, dict):
                source, source_sha, source_error = verify_file(
                    identity.get("source_path"), "source", identity.get("source_sha256"), required=True
                )
                artifact, artifact_sha, artifact_error = verify_file(
                    identity.get("artifact_path"), "artifact", identity.get("artifact_sha256"), required=True
                )
                if source_error or artifact_error or source_sha is None or artifact_sha is None:
                    emit("REPORT_STATUS", "BLOCKED")
                    emit("IDENTITY_STATUS", "FAIL")
                    emit("BLOCKER", source_error or artifact_error or "CHECKPOINT_CANONICAL_IDENTITY_INVALID")
                    return EXIT_IDENTITY
                recomputed, canonical_error = canonical_local_score(
                    canonical.get("measurements_path"), source_sha, artifact_sha,
                    canonical.get("score_scope", ""), canonical.get("subject_revision"),
                    canonical.get("parent_artifact_sha256"),
                )
                if canonical_error or recomputed is None or any(
                    recomputed.get(key) != canonical.get(key)
                    for key in ("reported_score", "quality", "local_status", "raw_manifest_sha256", "parent_artifact_sha256")
                ):
                    emit("REPORT_STATUS", "BLOCKED")
                    emit("IDENTITY_STATUS", "FAIL")
                    emit("BLOCKER", canonical_error or "CHECKPOINT_CANONICAL_SCORE_MISMATCH")
                    return EXIT_IDENTITY
            emit("LOCAL_MEASUREMENT_QUALITY", local.get("status", "NOT_RUN"))
            emit("LOCAL_QUALITY_CLASSIFICATION", local.get("quality_classification", "UNKNOWN"))
            emit("LOCAL_MEDIAN_PARENT_US", fmt_number(local.get("parent_median")))
            emit("LOCAL_MEDIAN_CANDIDATE_US", fmt_number(local.get("candidate_median")))
            emit("LOCAL_MEDIAN_RATIO_DELTA", fmt_number(local.get("ratio_delta")))
            emit("LOCAL_PAIRED_MEDIAN_DELTA_US", fmt_number(local.get("paired_delta")))
            emit("LOCAL_PAIRED_MEDIAN_PERCENT_DELTA", fmt_number(local.get("paired_percent_delta")))
            emit("LOCAL_RAW_SAMPLE_COUNT", local.get("raw_count", 0))
            emit("LOCAL_RAW_PAIR_COUNT", local.get("pair_count", 0))
            emit("LOCAL_NOISE_STATUS", local.get("noise_status", "UNKNOWN"))
            emit("SHAPE_LOCAL_VERDICT", local.get("shape_local_verdict", "NOT_RUN"))
            emit("SHAPE_CANDIDATE_MEDIAN_US", fmt_number(local.get("shape_candidate_median_us")))
            emit("SHAPE_PAIRED_DELTA_US", fmt_number(local.get("shape_paired_delta_us")))
            emit("SHAPE_PAIRED_PERCENT_DELTA", fmt_number(local.get("shape_paired_percent_delta")))
            emit("FULL_LOCAL_SCORE", local.get("full_local_score", "NOT_COMPUTABLE"))
            emit("LOCAL_PROMOTION_ELIGIBLE", "YES" if local.get("promotion_eligible") else "NO")
            emit("LOCAL_RAW_SHA256", local.get("raw_sha", stage_payload.get("raw_sha256", "NONE")))
            if isinstance(canonical, dict):
                print_canonical_stats(local)
                emit("CANONICAL_SCORE_REVALIDATION", "PASS_READ_ONLY")
        if stage == "record":
            record = stage_payload.get("record") or {}
            emit("RECORD_MANIFEST", payload.get("record_manifest", "NONE"))
            emit("RECORD_STATUS", record.get("record_status", stage_payload.get("status", "NOT_RUN")))
            emit("BACKEND_STATUS", record.get("backend_status", "UNKNOWN"))
            emit("BACKEND_RC", record.get("backend_rc") if record.get("backend_rc") is not None else "NONE")
            emit("RECORD_INTEGRATION_STATUS", record.get("integration_status", "UNKNOWN"))
            emit("RECORD_EVIDENCE_COUNT", len(record.get("evidence", [])))
    emit("REVISION_CREATED", "YES" if payload.get("revision_created") else "NO")
    emit("RUNNER_CREATED", "YES" if payload.get("runner_created") else "NO")
    emit("ONLINE", payload.get("online", "NOT_SUBMITTED"))
    e2e_complete = (
        "record" in stages
        and payload.get("record_manifest")
        and payload.get("stages", {}).get("record", {}).get("status") == "PASS"
    )
    emit("E2E_STATUS", "PASS" if e2e_complete else "INCOMPLETE")
    report_status = "PASS" if payload.get("status") == "PASS" else "INCOMPLETE"
    emit("REPORT_STATUS", report_status)
    return 0


def add_backend_options(parser: argparse.ArgumentParser, env_name: str) -> None:
    parser.add_argument("--backend", default=os.environ.get(env_name))
    parser.add_argument("--backend-arg", action="append", default=[])
    parser.add_argument("--backend-workdir", default=os.environ.get("W5CTL_BACKEND_WORKDIR"))
    parser.add_argument("--log")


def add_scope_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--repo-root", default=os.environ.get("W5CTL_REPO_ROOT"))
    parser.add_argument("--expected-branch", default=os.environ.get("W5CTL_EXPECTED_BRANCH"))
    parser.add_argument("--route", default=os.environ.get("W5CTL_ROUTE"))
    parser.add_argument("--route-root", default=os.environ.get("W5CTL_ROUTE_ROOT"))


def add_identity_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--source", default=os.environ.get("W5CTL_SOURCE"))
    parser.add_argument("--artifact", default=os.environ.get("W5CTL_ARTIFACT"))
    parser.add_argument("--artifact-receipt", default=os.environ.get("W5CTL_ARTIFACT_RECEIPT"))
    parser.add_argument("--expected-source-sha", default=os.environ.get("W5CTL_SOURCE_SHA256"))
    parser.add_argument("--expected-artifact-sha", default=os.environ.get("W5CTL_ARTIFACT_SHA256"))


def add_canonical_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--canonical-measurements", default=os.environ.get("W5CTL_CANONICAL_MEASUREMENTS"))
    parser.add_argument(
        "--canonical-purpose",
        choices=("route-kernel", "historical-tool-validation"),
        default=os.environ.get("W5CTL_CANONICAL_PURPOSE", "route-kernel"),
    )
    parser.add_argument("--canonical-revision", default=os.environ.get("W5CTL_CANONICAL_REVISION"))
    parser.add_argument(
        "--expected-parent-artifact-sha",
        default=os.environ.get("W5CTL_CANONICAL_PARENT_ARTIFACT_SHA256"),
    )


def add_pipeline_options(parser: argparse.ArgumentParser, resume: bool) -> None:
    parser.add_argument("--checkpoint", required=True)
    parser.add_argument("--source", default=os.environ.get("W5CTL_SOURCE"))
    parser.add_argument("--artifact", default=os.environ.get("W5CTL_ARTIFACT"))
    parser.add_argument("--artifact-receipt", default=os.environ.get("W5CTL_ARTIFACT_RECEIPT"))
    parser.add_argument("--expected-source-sha", default=os.environ.get("W5CTL_SOURCE_SHA256"))
    parser.add_argument("--expected-artifact-sha", default=os.environ.get("W5CTL_ARTIFACT_SHA256"))
    parser.add_argument("--raw", default=os.environ.get("W5CTL_RAW_PATH"))
    add_canonical_options(parser)
    parser.add_argument("--stages")
    parser.add_argument("--backend-workdir", default=os.environ.get("W5CTL_BACKEND_WORKDIR"))
    parser.add_argument("--min-pairs", type=int, default=3)
    parser.add_argument("--max-cv", type=float, default=0.20)
    for stage in ("build", "correctness", "local"):
        env_name = f"W5CTL_{stage.upper()}_BACKEND"
        parser.add_argument(f"--{stage}-backend", dest=f"{stage}_backend", default=os.environ.get(env_name))
        parser.add_argument(f"--{stage}-arg", dest=f"{stage}_arg", action="append", default=[])
        parser.add_argument(f"--{stage}-log", dest=f"{stage}_log")
    parser.add_argument("--record-backend", default=os.environ.get("W5CTL_RECORD_BACKEND"))
    parser.add_argument("--record-arg", action="append", default=[])
    parser.add_argument("--record-workdir", default=os.environ.get("W5CTL_RECORD_WORKDIR"))
    parser.add_argument("--record-log")
    parser.add_argument("--record-evidence", action="append", default=[])
    parser.add_argument("--record-manifest", default=os.environ.get("W5CTL_RECORD_MANIFEST"))
    parser.add_argument("--build-receipt", default=os.environ.get("W5CTL_BUILD_RECEIPT"))
    parser.add_argument("--correctness-receipt", default=os.environ.get("W5CTL_CORRECTNESS_RECEIPT"))
    if resume:
        parser.add_argument("--from-stage", choices=STAGES)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="w5ctl")
    sub = parser.add_subparsers(dest="command", required=True)

    doctor = sub.add_parser("doctor", help="read-only route and backend audit")
    add_scope_options(doctor)
    doctor.add_argument("--dry-run", action="store_true", help="explicitly select read-only mode")
    doctor.add_argument("--source", default=os.environ.get("W5CTL_CHAMPION_SOURCE"))

    for name, env_name in (
        ("build", "W5CTL_BUILD_BACKEND"),
        ("correctness", "W5CTL_CORRECTNESS_BACKEND"),
    ):
        stage = sub.add_parser(name, help=f"delegate {name} to an existing backend")
        add_scope_options(stage)
        add_identity_options(stage)
        add_backend_options(stage, env_name)

    local = sub.add_parser("local", help="delegate local measurement and validate fixed raw statistics")
    add_scope_options(local)
    add_identity_options(local)
    add_backend_options(local, "W5CTL_LOCAL_BACKEND")
    local.add_argument("--raw", default=os.environ.get("W5CTL_RAW_PATH"))
    add_canonical_options(local)
    local.add_argument("--stats-only", action="store_true")
    local.add_argument("--min-pairs", type=int, default=3)
    local.add_argument("--max-cv", type=float, default=0.20)

    record = sub.add_parser("record", help="delegate evidence recording; never commits by itself")
    add_scope_options(record)
    add_identity_options(record)
    record.add_argument("--evidence", action="append", default=[])
    record.add_argument("--raw", default=os.environ.get("W5CTL_RAW_PATH"))
    add_canonical_options(record)
    record.add_argument("--manifest", required=True)
    record.add_argument("--backend", default=os.environ.get("W5CTL_RECORD_BACKEND"))
    record.add_argument("--backend-arg", action="append", default=[])
    record.add_argument("--backend-workdir", default=os.environ.get("W5CTL_RECORD_WORKDIR"))
    record.add_argument("--log")
    record.add_argument("--build-receipt", default=os.environ.get("W5CTL_BUILD_RECEIPT"))
    record.add_argument("--correctness-receipt", default=os.environ.get("W5CTL_CORRECTNESS_RECEIPT"))

    dedup = sub.add_parser("dedup", help="compare meaningful patch changes only")
    add_scope_options(dedup)
    dedup.add_argument("--parent-patch", required=True)
    dedup.add_argument("--candidate-patch", required=True)
    dedup.add_argument("--common", action="append", default=[])
    dedup.add_argument("--champion-scaffold", action="append", default=[])
    dedup.add_argument("--abi-scaffold", action="append", default=[])
    dedup.add_argument("--min-lines", type=int, default=1)
    dedup.add_argument("--mechanism-threshold", type=float, default=0.70)

    cycle = sub.add_parser("cycle", help="idempotent build/correctness/local orchestration")
    add_scope_options(cycle)
    add_pipeline_options(cycle, resume=False)

    resume = sub.add_parser("resume", help="resume an explicit checkpoint without rerunning passed stages")
    add_scope_options(resume)
    add_pipeline_options(resume, resume=True)

    report = sub.add_parser("report", help="read a checkpoint or record manifest and emit a structured receipt")
    add_scope_options(report)
    report_input = report.add_mutually_exclusive_group(required=True)
    report_input.add_argument("--checkpoint")
    report_input.add_argument("--manifest")
    report_input.add_argument("--route-summary", action="store_true")
    return parser


def local_command(args: argparse.Namespace) -> int:
    isolation_error = require_current_worktree()
    if isolation_error:
        print_stats(blocked_stats("NOT_RUN", isolation_error))
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", isolation_error)
        return EXIT_NOT_RUN
    if args.stats_only:
        if args.canonical_measurements:
            if args.raw and resolve_path(args.raw) != resolve_path(args.canonical_measurements):
                emit("STATS_ONLY", "YES")
                emit("CANONICAL_SCORE_STATUS", "NOT_COMPUTABLE")
                emit("BLOCKER", "CANONICAL_MEASUREMENTS_MUST_BE_LOCAL_RAW_INDEX")
                emit("FULL_LOCAL_SCORE", "NOT_COMPUTABLE")
                return EXIT_NOT_RUN
            source, source_sha, source_error = verify_file(
                args.source, "source", args.expected_source_sha, required=True
            )
            artifact, artifact_sha, artifact_error, artifact_identity = verify_artifact_reference(
                args.artifact,
                args.expected_artifact_sha,
                getattr(args, "artifact_receipt", None),
            )
            if source_error or artifact_error or source is None or artifact is None:
                emit("STATS_ONLY", "YES")
                emit("IDENTITY_STATUS", "FAIL")
                emit("CANONICAL_SCORE_STATUS", "NOT_COMPUTABLE")
                emit("BLOCKER", source_error or artifact_error or "CANONICAL_IDENTITY_MISSING")
                emit("FULL_LOCAL_SCORE", "NOT_COMPUTABLE")
                return EXIT_IDENTITY
            canonical, canonical_error = canonical_local_score(
                args.canonical_measurements, source_sha or "", artifact_sha or "",
                args.canonical_purpose, args.canonical_revision,
                args.expected_parent_artifact_sha,
            )
            emit("STATS_ONLY", "YES")
            if canonical_error or canonical is None:
                stats = blocked_stats("NOT_COMPUTABLE", canonical_error or "CANONICAL_SCORE_NOT_COMPUTABLE")
                print_stats(stats)
                emit("CANONICAL_SCORE_STATUS", "NOT_COMPUTABLE")
                emit("CANONICAL_SCORE_REASON", canonical_error or "CANONICAL_SCORE_NOT_COMPUTABLE")
                return EXIT_STATS_REJECTED
            local = canonical_local_result(canonical)
            print_stats(local)
            print_canonical_stats(local)
            emit("CANONICAL_AGGREGATION", "PASS_READ_ONLY")
            return 0
        raw, raw_scope_error = scoped_path(args.raw, "raw")
        if raw_scope_error:
            stats = blocked_stats("NOT_RUN", raw_scope_error)
            emit("STATS_ONLY", "YES")
            print_stats(stats)
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", raw_scope_error)
            return EXIT_NOT_RUN
        stats = analyze_raw(raw, args.min_pairs, args.max_cv)
        emit("STATS_ONLY", "YES")
        print_stats(stats)
        return 0 if stats["status"] == "ACCEPTED" else EXIT_STATS_REJECTED
    return identity_stage(
        "local",
        args.backend,
        args.backend_arg,
        args.backend_workdir,
        args.log,
        args.source,
        args.artifact,
        args.expected_source_sha,
        args.expected_artifact_sha,
        args.raw,
        args.min_pairs,
        args.max_cv,
        args.canonical_measurements,
        args.canonical_purpose,
        args.canonical_revision,
        args.expected_parent_artifact_sha,
        getattr(args, "artifact_receipt", None),
    ).rc


def dispatch(args: argparse.Namespace) -> int:
    if args.command == "doctor":
        return doctor_command(args)
    if args.command == "build":
        return identity_stage(
            "build",
            args.backend,
            args.backend_arg,
            args.backend_workdir,
            args.log,
            args.source,
            args.artifact,
            args.expected_source_sha,
            args.expected_artifact_sha,
            None,
            artifact_receipt_raw=getattr(args, "artifact_receipt", None),
        ).rc
    if args.command == "correctness":
        return identity_stage(
            "correctness",
            args.backend,
            args.backend_arg,
            args.backend_workdir,
            args.log,
            args.source,
            args.artifact,
            args.expected_source_sha,
            args.expected_artifact_sha,
            None,
            artifact_receipt_raw=getattr(args, "artifact_receipt", None),
        ).rc
    if args.command == "local":
        return local_command(args)
    if args.command == "record":
        return record_command(args)
    if args.command == "dedup":
        return dedup_command(args)
    if args.command == "cycle":
        return pipeline_command(args, resume=False)
    if args.command == "resume":
        return pipeline_command(args, resume=True)
    if args.command == "report":
        return report_command(args)
    raise UsageError(f"unknown command: {args.command}")


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
        invocation_error = configure_invocation(args)
        if invocation_error:
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", invocation_error)
            return EXIT_NOT_RUN
        return dispatch(args)
    except UsageError as exc:
        print(f"ERROR={exc}", file=sys.stderr)
        return EXIT_USAGE
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
