def resolve_path(raw: Optional[str]) -> Optional[Path]:
    if not raw:
        return None
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.resolve()


def scoped_path(raw: Optional[str], label: str) -> Tuple[Optional[Path], Optional[str]]:
    path = resolve_path(raw)
    if path is None:
        return None, None
    if EXPECTED_REPO_ROOT is None:
        return path, "WORKTREE_ISOLATION:INVOCATION_SCOPE_NOT_CONFIGURED"
    try:
        path.relative_to(EXPECTED_REPO_ROOT)
    except ValueError:
        return path, f"OUT_OF_SCOPE:{label}:{path}:expected={EXPECTED_REPO_ROOT}"
    return path, None


def current_git_context() -> Tuple[int, Optional[Path], Optional[str], Optional[str]]:
    start = Path.cwd().resolve()
    root_rc, root_text = git_output(start, "rev-parse", "--show-toplevel")
    if root_rc != 0:
        return root_rc, None, None, f"WORKTREE_ISOLATION:GIT_ROOT_FAILED:{root_text}"
    branch_rc, branch = git_output(start, "branch", "--show-current")
    if branch_rc != 0:
        return branch_rc, Path(root_text).resolve(), None, f"WORKTREE_ISOLATION:GIT_BRANCH_FAILED:{branch}"
    return 0, Path(root_text).resolve(), branch, None


def configure_invocation(args: argparse.Namespace) -> Optional[str]:
    global EXPECTED_REPO_ROOT, EXPECTED_BRANCH, ROUTE, ROUTE_ROOT

    current_rc, current_root, _, current_error = current_git_context()
    if current_error or current_rc != 0 or current_root is None:
        return current_error or "WORKTREE_ISOLATION:GIT_CONTEXT_UNAVAILABLE"

    raw_repo_root = getattr(args, "repo_root", None) or os.environ.get("W5CTL_REPO_ROOT")
    repo_root = resolve_path(raw_repo_root) if raw_repo_root else current_root
    if repo_root is None or not repo_root.is_dir():
        return f"WORKTREE_ISOLATION:REPO_ROOT_NOT_DIRECTORY:{repo_root}"

    expected_branch = (
        getattr(args, "expected_branch", None)
        or os.environ.get("W5CTL_EXPECTED_BRANCH")
        or ""
    ).strip()
    if not expected_branch:
        return "WORKTREE_ISOLATION:EXPECTED_BRANCH_REQUIRED"

    route = (getattr(args, "route", None) or os.environ.get("W5CTL_ROUTE") or "").strip()
    if not route:
        return "WORKTREE_ISOLATION:ROUTE_REQUIRED"

    raw_route_root = getattr(args, "route_root", None) or os.environ.get("W5CTL_ROUTE_ROOT")
    route_root = resolve_path(raw_route_root) if raw_route_root else repo_root
    if route_root is None or not route_root.is_dir():
        return f"WORKTREE_ISOLATION:ROUTE_ROOT_NOT_DIRECTORY:{route_root}"
    try:
        route_root.relative_to(repo_root)
    except ValueError:
        return f"OUT_OF_SCOPE:route-root:{route_root}:expected={repo_root}"

    EXPECTED_REPO_ROOT = repo_root
    EXPECTED_BRANCH = expected_branch
    ROUTE = route
    ROUTE_ROOT = route_root
    return None


def require_current_worktree() -> Optional[str]:
    if EXPECTED_REPO_ROOT is None or not EXPECTED_BRANCH or not ROUTE or ROUTE_ROOT is None:
        return "WORKTREE_ISOLATION:INVOCATION_SCOPE_NOT_CONFIGURED"
    rc, root, branch, error = current_git_context()
    if error:
        return error
    if rc != 0 or root != EXPECTED_REPO_ROOT:
        return f"WORKTREE_ISOLATION:root={root}:expected={EXPECTED_REPO_ROOT}"
    if branch != EXPECTED_BRANCH:
        return f"WORKTREE_ISOLATION:branch={branch}:expected={EXPECTED_BRANCH}"
    return None


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def verify_file(
    raw_path: Optional[str],
    label: str,
    expected_sha: Optional[str] = None,
    required: bool = True,
) -> Tuple[Optional[Path], Optional[str], Optional[str]]:
    path, scope_error = scoped_path(raw_path, label)
    if scope_error:
        return path, None, scope_error
    if path is None:
        return None, None, f"{label.upper()}_NOT_SET" if required else None
    if not path.is_file():
        return path, None, f"{label.upper()}_MISSING:{path}"
    try:
        digest = sha256_file(path)
    except OSError as exc:
        return path, None, f"{label.upper()}_READ_FAILED:{exc}"
    if expected_sha and digest.lower() != expected_sha.lower():
        return path, digest, f"{label.upper()}_SHA_MISMATCH:expected={expected_sha}:actual={digest}"
    return path, digest, None


def read_pinned_public_object(raw_path: Optional[str]) -> Tuple[Optional[str], Optional[bytes], Optional[str]]:
    if not raw_path:
        return None, None, "PUBLIC_GIT_OBJECT_NOT_SET"
    uri_match = re.fullmatch(r"gitobj://([0-9a-f]{40})/(.+)", raw_path)
    if uri_match:
        commit, object_path = uri_match.groups()
    elif raw_path.startswith(PUBLIC_CANONICAL_SOURCE_ROOT + PUBLIC_CANONICAL_ROOT_MARKER):
        commit = CANONICAL_PUBLIC_COMMIT
        marker_index = raw_path.rfind(PUBLIC_CANONICAL_ROOT_MARKER)
        object_path = raw_path[marker_index + 1:]
    else:
        return None, None, f"PUBLIC_GIT_OBJECT_PATH_INVALID:{raw_path}"
    allowed = (
        "本地实验/MAIN2-CANONICAL-V1/versions/",
        "本地实验/MAIN2-CANONICAL-V1/builds/VECTOR-MATH-X__V003/",
    )
    if (
        commit != CANONICAL_PUBLIC_COMMIT
        or not object_path.startswith(allowed)
        or ".." in Path(object_path).parts
        or object_path.startswith("/")
    ):
        return None, None, f"PUBLIC_GIT_OBJECT_OUT_OF_SCOPE:{raw_path}"
    try:
        completed = subprocess.run(
            ["git", "show", f"{commit}:{object_path}"],
            cwd=str(EXPECTED_REPO_ROOT), stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, check=False,
        )
    except OSError as exc:
        return None, None, f"PUBLIC_GIT_OBJECT_READ_FAILED:{exc}"
    if completed.returncode != 0:
        return None, None, f"PUBLIC_GIT_OBJECT_UNAVAILABLE:{object_path}"
    return f"gitobj://{commit}/{object_path}", completed.stdout, None


def verify_identity_reference(
    raw_path: Optional[str],
    label: str,
    expected_sha: Optional[str] = None,
    allow_public: bool = False,
) -> Tuple[Optional[Any], Optional[str], Optional[str]]:
    if allow_public and raw_path and (raw_path.startswith("gitobj://") or raw_path.startswith(PUBLIC_CANONICAL_SOURCE_ROOT + PUBLIC_CANONICAL_ROOT_MARKER)):
        canonical_ref, contents, error = read_pinned_public_object(raw_path)
        if error or canonical_ref is None or contents is None:
            return raw_path, None, error
        digest = hashlib.sha256(contents).hexdigest()
        if expected_sha and digest.lower() != expected_sha.lower():
            return canonical_ref, digest, f"{label.upper()}_SHA_MISMATCH:expected={expected_sha}:actual={digest}"
        return canonical_ref, digest, None
    path, digest, error = verify_file(raw_path, label, expected_sha, required=True)
    if error:
        return path, digest, error
    if path is not None:
        try:
            path.relative_to(ROUTE_ROOT)
        except (AttributeError, ValueError):
            return path, digest, f"OUT_OF_SCOPE:{label}:{path}:expected={ROUTE_ROOT}"
    return path, digest, None


def verify_stage_receipt(
    raw_path: Optional[str],
    stage: str,
    expected_source_sha: Optional[str] = None,
    expected_artifact_sha: Optional[str] = None,
) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
    path, digest, error = verify_file(raw_path, f"{stage}-receipt", required=True)
    if error or path is None or digest is None:
        return None, error or f"{stage.upper()}_RECEIPT_NOT_SET"
    try:
        path.relative_to(ROUTE_ROOT)
        payload = json.loads(path.read_text())
    except (AttributeError, ValueError):
        return None, f"OUT_OF_SCOPE:{stage}-receipt:{path}:expected={ROUTE_ROOT}"
    except (OSError, json.JSONDecodeError) as exc:
        return None, f"{stage.upper()}_RECEIPT_READ_FAILED:{exc}"
    if not isinstance(payload, dict):
        return None, f"{stage.upper()}_RECEIPT_SCHEMA_INVALID"
    if stage == "build":
        status = payload.get("BUILD_STATUS")
        rc = payload.get("BUILD_RC")
        receipt_source = payload.get("SOURCE_SHA")
        receipt_artifact = payload.get("EXE_SHA")
        if status != "PASS" or str(rc) != "0":
            return None, f"BUILD_RECEIPT_NOT_PASS:status={status}:rc={rc}"
        if expected_source_sha and receipt_source != expected_source_sha:
            return None, f"BUILD_RECEIPT_SOURCE_SHA_MISMATCH:expected={expected_source_sha}:actual={receipt_source}"
        if expected_artifact_sha and receipt_artifact != expected_artifact_sha:
            return None, f"BUILD_RECEIPT_ARTIFACT_SHA_MISMATCH:expected={expected_artifact_sha}:actual={receipt_artifact}"
    elif stage == "correctness":
        status = payload.get("CORRECTNESS_STATUS")
        try:
            pass_count = int(payload.get("PASS_COUNT", -1))
            case_count = int(payload.get("CASE_COUNT", -1))
        except (TypeError, ValueError):
            return None, "CORRECTNESS_RECEIPT_COUNTS_INVALID"
        if status != "PASS" or pass_count != case_count or case_count <= 0:
            return None, f"CORRECTNESS_RECEIPT_NOT_PASS:status={status}:pass={pass_count}:cases={case_count}"
        cells = payload.get("CELLS", [])
        if not isinstance(cells, list) or any(
            cell.get("RC") not in (0, "0") or cell.get("BAD") not in (0, "0", 0.0)
            for cell in cells if isinstance(cell, dict)
        ):
            return None, "CORRECTNESS_RECEIPT_CELL_FAILURE"
    else:
        return None, f"STAGE_RECEIPT_STAGE_INVALID:{stage}"
    return {
        "path": str(path),
        "sha256": digest,
        "status": "PASS",
        "return_code": 0,
        "payload": payload,
    }, None


def verify_artifact_reference(
    raw_path: Optional[str],
    expected_sha: Optional[str] = None,
    receipt_raw: Optional[str] = None,
) -> Tuple[Optional[Path], Optional[str], Optional[str], Optional[Dict[str, str]]]:
    """Verify a local artifact or a published build receipt's EXE_SHA.

    The receipt mode never pretends the executable bytes are local. It binds
    the recorded executable identity to a route-owned/public build.json.
    """
    if receipt_raw and raw_path:
        raw_resolved = resolve_path(raw_path)
        receipt_resolved = resolve_path(receipt_raw)
        if raw_path != receipt_raw and raw_resolved != receipt_resolved:
            return raw_resolved, None, "ARTIFACT_AND_RECEIPT_PATH_MISMATCH", None
    if not receipt_raw:
        path, digest, error = verify_file(raw_path, "artifact", expected_sha, required=True)
        return path, digest, error, ({"identity_mode": "LOCAL_FILE_SHA256"} if not error else None)
    public_reference = receipt_raw.startswith("gitobj://") or receipt_raw.startswith(
        PUBLIC_CANONICAL_SOURCE_ROOT + PUBLIC_CANONICAL_ROOT_MARKER
    )
    if public_reference:
        receipt_uri, receipt_bytes, receipt_error = read_pinned_public_object(receipt_raw)
        receipt = receipt_uri
        receipt_sha = hashlib.sha256(receipt_bytes).hexdigest() if receipt_bytes is not None else None
        if receipt_error is None and not receipt_uri.endswith("/build.json"):
            receipt_error = "ARTIFACT_RECEIPT_PATH_INVALID:EXPECTED_BUILD_JSON"
    else:
        receipt, receipt_sha, receipt_error = verify_file(receipt_raw, "artifact-receipt", required=True)
        if receipt_error is None and receipt is not None:
            try:
                receipt.relative_to(ROUTE_ROOT)
            except (AttributeError, ValueError):
                receipt_error = f"OUT_OF_SCOPE:artifact-receipt:{receipt}:expected={ROUTE_ROOT}"
    if receipt_error or receipt is None or receipt_sha is None:
        return receipt, None, receipt_error, None
    try:
        receipt_content = receipt_bytes if public_reference else receipt.read_bytes()
        payload = json.loads(receipt_content)
        artifact_sha = str(payload.get("EXE_SHA", "")).strip()
    except (OSError, json.JSONDecodeError) as exc:
        return receipt, None, f"ARTIFACT_RECEIPT_READ_FAILED:{exc}", None
    if not re.fullmatch(r"[0-9a-fA-F]{64}", artifact_sha):
        return receipt, None, "ARTIFACT_RECEIPT_EXE_SHA_MISSING", None
    if expected_sha and artifact_sha.lower() != expected_sha.lower():
        return receipt, artifact_sha, f"ARTIFACT_SHA_MISMATCH:expected={expected_sha}:actual={artifact_sha}", None
    return receipt, artifact_sha, None, {
        "identity_mode": "PUBLIC_BUILD_RECEIPT",
        "receipt_sha256": receipt_sha,
    }


def resolve_backend(raw: Optional[str]) -> Tuple[Optional[Path], Optional[str]]:
    if not raw:
        return None, "BACKEND_NOT_CONFIGURED"
    if "/" in raw or raw.startswith("."):
        path = resolve_path(raw)
    else:
        found = shutil.which(raw)
        path = Path(found).resolve() if found else None
    if path is None:
        return None, f"BACKEND_NOT_FOUND:{raw}"
    try:
        path.relative_to(EXPECTED_REPO_ROOT)
    except ValueError:
        return path, f"OUT_OF_SCOPE:backend:{path}:expected={EXPECTED_REPO_ROOT}"
    if not path.is_file():
        return path, f"BACKEND_NOT_FILE:{path}"
    if not os.access(path, os.X_OK) and path.suffix.lower() not in SHELL_BACKEND_SUFFIXES:
        return path, f"BACKEND_NOT_EXECUTABLE:{path}"
    return path, None


def backend_command(backend: Path, backend_args: Sequence[str]) -> List[str]:
    if not os.access(backend, os.X_OK) and backend.suffix.lower() in SHELL_BACKEND_SUFFIXES:
        return ["/bin/bash", str(backend), *backend_args]
    return [str(backend), *backend_args]


def write_log(path: Optional[str], stdout: bytes, stderr: bytes) -> Optional[str]:
    if not path:
        return None
    target, scope_error = scoped_path(path, "log")
    if scope_error:
        emit("LOG_STATUS", "BLOCKED")
        emit("LOG_BLOCKER", scope_error)
        return None
    if target is None:
        return None
    if target.exists():
        emit("LOG_STATUS", "EXISTING_UNCHANGED")
        emit("LOG_BLOCKER", f"LOG_NOT_OVERWRITTEN:{target}")
        return None
    target.parent.mkdir(parents=True, exist_ok=True)
    payload = b"[stdout]\n" + stdout + b"\n[stderr]\n" + stderr
    target.write_bytes(payload)
    return str(target)


def backend_env(
    stage: str,
    source: Optional[Path],
    artifact: Optional[Path],
    source_sha: Optional[str],
    artifact_sha: Optional[str],
    raw: Optional[Path],
    canonical_measurements: Optional[Path] = None,
) -> Dict[str, str]:
    env = os.environ.copy()
    env["W5CTL_ROUTE"] = ROUTE
    env["W5CTL_STAGE"] = stage
    if source:
        env["W5CTL_SOURCE"] = str(source)
    if artifact:
        env["W5CTL_ARTIFACT"] = str(artifact)
    if source_sha:
        env["W5CTL_SOURCE_SHA256"] = source_sha
    if artifact_sha:
        env["W5CTL_ARTIFACT_SHA256"] = artifact_sha
    if raw:
        env["W5CTL_RAW_PATH"] = str(raw)
    if canonical_measurements:
        env["W5CTL_CANONICAL_MEASUREMENTS"] = str(canonical_measurements)
    return env


def print_backend_output(stdout: bytes, stderr: bytes) -> None:
    if stdout:
        sys.stdout.write(stdout.decode(errors="replace"))
        if not stdout.endswith(b"\n"):
            sys.stdout.write("\n")
    if stderr:
        sys.stdout.write(stderr.decode(errors="replace"))
        if not stderr.endswith(b"\n"):
            sys.stdout.write("\n")
    sys.stdout.flush()


def execute_backend(
    stage: str,
    backend_raw: Optional[str],
    backend_args: Sequence[str],
    workdir_raw: Optional[str],
    log_path: Optional[str],
    source: Optional[Path],
    artifact: Optional[Path],
    source_sha: Optional[str],
    artifact_sha: Optional[str],
    raw: Optional[Path],
    canonical_measurements: Optional[Path] = None,
) -> Outcome:
    backend, error = resolve_backend(backend_raw)
    if error:
        emit("STATUS", "NOT_RUN")
        emit("BACKEND_STATUS", "NOT_CONFIGURED")
        emit("BLOCKER", error)
        return Outcome("NOT_RUN", EXIT_NOT_RUN, source_sha, artifact_sha, reason=error)
    assert backend is not None
    cwd, cwd_error = scoped_path(workdir_raw, "backend-workdir")
    if cwd_error:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", cwd_error)
        return Outcome("BLOCKED", EXIT_NOT_RUN, source_sha, artifact_sha, reason=cwd_error)
    _, log_error = scoped_path(log_path, "log")
    if log_error:
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", log_error)
        return Outcome("BLOCKED", EXIT_NOT_RUN, source_sha, artifact_sha, reason=log_error)
    if cwd is not None and not cwd.is_dir():
        reason = f"BACKEND_WORKDIR_MISSING:{cwd}"
        emit("STATUS", "NOT_RUN")
        emit("BLOCKER", reason)
        return Outcome("NOT_RUN", EXIT_NOT_RUN, source_sha, artifact_sha, reason=reason)
    command = backend_command(backend, backend_args)
    emit("BACKEND_COMMAND", shlex.join(command))
    try:
        completed = subprocess.run(
            command,
            cwd=str(cwd) if cwd else None,
            env=backend_env(stage, source, artifact, source_sha, artifact_sha, raw, canonical_measurements),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        reason = f"BACKEND_EXEC_FAILED:{exc}"
        emit("STATUS", "NOT_RUN")
        emit("BLOCKER", reason)
        return Outcome("NOT_RUN", EXIT_NOT_RUN, source_sha, artifact_sha, reason=reason)
    print_backend_output(completed.stdout, completed.stderr)
    actual_rc = normalize_rc(completed.returncode)
    log_written = write_log(log_path, completed.stdout, completed.stderr)
    emit("BACKEND_RC", actual_rc)
    if log_written:
        emit("OUTPUT_LOG", log_written)
    if actual_rc != 0:
        emit("STATUS", "FAILED")
        emit("BLOCKER", f"BACKEND_RC={actual_rc}")
        return Outcome("FAILED", actual_rc, source_sha, artifact_sha, reason=f"BACKEND_RC={actual_rc}")
    return Outcome("PASS", 0, source_sha, artifact_sha)


def identity_stage(
    stage: str,
    backend_raw: Optional[str],
    backend_args: Sequence[str],
    workdir_raw: Optional[str],
    log_path: Optional[str],
    source_raw: Optional[str],
    artifact_raw: Optional[str],
    expected_source_sha: Optional[str],
    expected_artifact_sha: Optional[str],
    raw_raw: Optional[str],
    min_pairs: int = 3,
    max_cv: float = 0.20,
    canonical_measurements_raw: Optional[str] = None,
    canonical_purpose: str = "route-kernel",
    canonical_revision: Optional[str] = None,
    expected_parent_artifact_sha: Optional[str] = None,
    artifact_receipt_raw: Optional[str] = None,
) -> Outcome:
    isolation_error = require_current_worktree()
    if isolation_error:
        if stage == "local":
            print_stats(blocked_stats("NOT_RUN", isolation_error))
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", isolation_error)
        return Outcome("BLOCKED", EXIT_NOT_RUN, reason=isolation_error)
    source, source_sha, source_error = verify_file(
        source_raw, "source", expected_source_sha, required=True
    )
    if source_error:
        if stage == "local":
            print_stats(blocked_stats("NOT_RUN", source_error))
        emit("STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", source_error)
        return Outcome("BLOCKED", EXIT_IDENTITY, source_sha, reason=source_error)
    artifact, artifact_sha_before, artifact_error, artifact_identity = verify_artifact_reference(
        artifact_raw,
        expected_artifact_sha if stage != "build" else None,
        artifact_receipt_raw,
    )
    if artifact_error and (stage != "build" or not artifact_error.startswith("ARTIFACT_MISSING:")):
        if stage == "local":
            print_stats(blocked_stats("NOT_RUN", artifact_error))
        emit("STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", artifact_error)
        return Outcome("BLOCKED", EXIT_IDENTITY, source_sha, artifact_sha_before, reason=artifact_error)
    if artifact is None:
        if stage == "local":
            print_stats(blocked_stats("NOT_RUN", "ARTIFACT_NOT_SET"))
        emit("STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", "ARTIFACT_NOT_SET")
        return Outcome("BLOCKED", EXIT_IDENTITY, source_sha, reason="ARTIFACT_NOT_SET")
    if source is not None:
        emit("SOURCE_SHA256", source_sha)
    if artifact_sha_before:
        emit("ARTIFACT_SHA256_BEFORE", artifact_sha_before)
    if canonical_measurements_raw:
        canonical_path, canonical_scope_error = scoped_path(canonical_measurements_raw, "canonical-measurements")
        if canonical_scope_error:
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", canonical_scope_error)
            return Outcome("BLOCKED", EXIT_NOT_RUN, source_sha, artifact_sha_before, reason=canonical_scope_error)
        if raw_raw and resolve_path(raw_raw) != canonical_path:
            emit("STATUS", "BLOCKED")
            emit("BLOCKER", "CANONICAL_MEASUREMENTS_MUST_BE_LOCAL_RAW_INDEX")
            return Outcome("BLOCKED", EXIT_NOT_RUN, source_sha, artifact_sha_before, reason="CANONICAL_MEASUREMENTS_MUST_BE_LOCAL_RAW_INDEX")
        raw_raw = str(canonical_path) if canonical_path else raw_raw
    else:
        canonical_path = None
    raw, raw_scope_error = scoped_path(raw_raw, "raw")
    if raw_scope_error:
        if stage == "local":
            print_stats(blocked_stats("NOT_RUN", raw_scope_error))
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", raw_scope_error)
        return Outcome("BLOCKED", EXIT_NOT_RUN, source_sha, artifact_sha_before, reason=raw_scope_error)
    if stage == "local" and raw is None:
        print_stats(blocked_stats("NOT_RUN", "RAW_SAMPLE_PATH_NOT_SET"))
        emit("STATUS", "BLOCKED")
        emit("BLOCKER", "RAW_SAMPLE_PATH_NOT_SET")
        return Outcome("BLOCKED", EXIT_NOT_RUN, source_sha, artifact_sha_before, reason="RAW_SAMPLE_PATH_NOT_SET")
    delegated = execute_backend(
        stage,
        backend_raw,
        backend_args,
        workdir_raw,
        log_path,
        source,
        artifact,
        source_sha,
        artifact_sha_before,
        raw,
        canonical_path,
    )
    if delegated.status != "PASS":
        if stage == "local":
            delegated_status = "BACKEND_FAILED" if delegated.status == "FAILED" else "NOT_RUN"
            print_stats(blocked_stats(delegated_status, delegated.reason or delegated.status))
        return delegated
    source_after, source_sha_after, source_after_error = verify_file(
        str(source), "source", expected_source_sha, required=True
    )
    artifact_after, artifact_sha_after, artifact_after_error, artifact_identity_after = verify_artifact_reference(
        str(artifact),
        expected_artifact_sha,
        str(artifact) if artifact_identity and artifact_identity.get("identity_mode") == "PUBLIC_BUILD_RECEIPT" else None,
    )
    if source_after_error or artifact_after_error or source_sha_after != source_sha or artifact_after is None:
        reason = source_after_error or artifact_after_error or "ARTIFACT_MISSING_AFTER_BACKEND"
        if stage == "local":
            print_stats(blocked_stats("IDENTITY_FAILED", reason))
        emit("STATUS", "BLOCKED")
        emit("IDENTITY_STATUS", "FAIL")
        emit("BLOCKER", reason)
        return Outcome("BLOCKED", EXIT_IDENTITY, source_sha_after, artifact_sha_after, reason=reason)
    emit("SOURCE_SHA256_AFTER", source_sha_after)
    emit("ARTIFACT_SHA256", artifact_sha_after)
    if stage == "local":
        if canonical_path:
            canonical, canonical_error = canonical_local_score(
                str(canonical_path), source_sha_after or "", artifact_sha_after or "",
                canonical_purpose, canonical_revision, expected_parent_artifact_sha,
            )
            if canonical_error or canonical is None:
                local = blocked_stats("NOT_COMPUTABLE", canonical_error or "CANONICAL_SCORE_NOT_COMPUTABLE")
                local["raw_sha"] = sha256_file(canonical_path) if canonical_path.is_file() else None
                local["reason"] = canonical_error or "CANONICAL_SCORE_NOT_COMPUTABLE"
                print_stats(local)
                emit("CANONICAL_SCORE_STATUS", "NOT_COMPUTABLE")
                emit("CANONICAL_SCORE_REASON", local["reason"])
                emit("STATUS", "NOT_COMPUTABLE")
                return Outcome(
                    "NOT_COMPUTABLE", EXIT_STATS_REJECTED, source_sha_after, artifact_sha_after,
                    local.get("raw_sha"), local["reason"], details={"local": local, "stage_status": "NOT_COMPUTABLE"},
                )
            local = canonical_local_result(canonical)
            print_stats(local)
            print_canonical_stats(local)
            emit("IDENTITY_STATUS", "PASS")
            emit("LOCAL_SCORE_RESULT", "COMPUTABLE")
            emit("STATUS", "PASS")
            return Outcome(
                "PASS", 0, source_sha_after, artifact_sha_after, canonical["measurements_sha256"],
                details={
                    "local": local,
                    "stage_status": "PASS",
                    "artifact_identity": artifact_identity_after or artifact_identity,
                },
            )
        stats = analyze_raw(raw, min_pairs, max_cv)
        print_stats(stats)
        if stats["status"] != "ACCEPTED":
            emit("IDENTITY_STATUS", "PASS")
            emit("STATUS", "REJECTED")
            stage_status = "UNCLASSIFIED" if stats["status"] == "UNCLASSIFIED" else "REJECTED"
            return Outcome(
                stage_status,
                EXIT_STATS_REJECTED,
                source_sha_after,
                artifact_sha_after,
                stats.get("raw_sha"),
                stats["status"],
                details={"local": stats, "stage_status": stage_status},
            )
    emit("IDENTITY_STATUS", "PASS")
    emit("STATUS", "PASS")
    details: Dict[str, Any] = {}
    if stage == "local":
        details = {"local": stats, "stage_status": "PASS"}
    return Outcome(
        "PASS", 0, source_sha_after, artifact_sha_after,
        stats.get("raw_sha") if stage == "local" else None,
        details={**details, "artifact_identity": artifact_identity_after or artifact_identity},
    )


def field(row: Dict[str, Any], *names: str) -> Any:
    lowered = {str(key).strip().lower(): value for key, value in row.items()}
    for name in names:
        if name.lower() in lowered:
            return lowered[name.lower()]
    return None


def bool_value(value: Any) -> bool:
    return str(value).strip().lower() in {"1", "true", "yes", "y", "contaminated", "polluted"}


def normalize_variant(value: Any) -> Optional[str]:
    if value is None:
        return None
    token = str(value).strip().lower()
    if token in {"parent", "p", "baseline", "control"}:
        return "parent"
    if token in {"candidate", "cand", "c", "v001", "variant"}:
        return "candidate"
    return None


def load_raw_rows(path: Path) -> List[Dict[str, Any]]:
    if path.suffix.lower() == ".json":
        payload = json.loads(path.read_text())
        if isinstance(payload, dict):
            payload = payload.get("samples", payload.get("rows"))
        if not isinstance(payload, list):
            raise ValueError("JSON raw input must be a list or contain samples/rows")
        return [item for item in payload if isinstance(item, dict)]
    with path.open(newline="") as stream:
        lines = stream.readlines()
        sample = "".join(lines[:8])
        first_data_line = next(
            (index for index, line in enumerate(lines) if line.strip()), None
        )
        if (
            first_data_line is not None
            and lines[first_data_line].lstrip().startswith("# LOCAL_PROXY_ONLY ")
        ):
            header_index = next(
                (
                    index
                    for index in range(first_data_line + 1, len(lines))
                    if lines[index].strip() and not lines[index].lstrip().startswith("#")
                ),
                None,
            )
            if header_index is None:
                raise ValueError("Crossrow runner raw is missing its TSV header")
            return list(csv.DictReader(lines[header_index:], delimiter="\t"))
        delimiter = "\t" if "\t" in sample.splitlines()[0] else ","
        return list(csv.DictReader(lines, delimiter=delimiter))


def parse_raw(path: Path) -> Tuple[List[Dict[str, Any]], bool, Optional[str]]:
    try:
        rows = load_raw_rows(path)
    except (OSError, ValueError, IndexError, csv.Error) as exc:
        return [], False, f"RAW_READ_OR_PARSE_FAILED:{exc}"
    records: List[Dict[str, Any]] = []
    contaminated = False
    seen: set = set()
    crossrow_runner_schema = bool(rows) and (
        field(rows[0], "sample") is not None
        and field(rows[0], "order") is not None
        and field(rows[0], "parent_device_us") is not None
        and field(rows[0], "candidate_device_us") is not None
    )
    if crossrow_runner_schema:
        for number, row in enumerate(rows, 1):
            pair = field(row, "sample")
            order = str(field(row, "order") or "").strip().upper()
            if pair is None or order not in {"PC", "CP"}:
                return records, contaminated, f"CROSSROW_RAW_ROW_INVALID:{number}"
            for variant in ("parent", "candidate"):
                raw_latency = field(row, f"{variant}_device_us")
                if raw_latency is None:
                    return records, contaminated, f"CROSSROW_RAW_LATENCY_MISSING:{number}:{variant}"
                try:
                    latency = float(str(raw_latency).strip())
                except ValueError:
                    return records, contaminated, f"CROSSROW_RAW_LATENCY_INVALID:{number}:{variant}"
                if not math.isfinite(latency) or latency <= 0:
                    return records, contaminated, f"CROSSROW_RAW_LATENCY_INVALID:{number}:{variant}"
                key = (str(pair).strip(), variant)
                if key in seen:
                    return records, contaminated, f"RAW_DUPLICATE_PAIR_VARIANT:{pair}:{variant}"
                seen.add(key)
                records.append(
                    {
                        "pair": str(pair).strip(),
                        "variant": variant,
                        "latency": latency,
                        "contaminated": False,
                        "unclassified": True,
                    }
                )
        return records, contaminated, None

    for number, row in enumerate(rows, 1):
        pair = field(row, "pair", "sample", "id", "index")
        variant = normalize_variant(field(row, "variant", "mode", "side"))
        raw_latency = field(row, "latency_us", "device_us", "median_us", "time_us")
        quality = field(row, "quality", "measurement_quality", "load_quality", "noise_status")
        if pair is None or variant is None or raw_latency is None:
            return records, contaminated, f"RAW_ROW_INVALID:{number}"
        try:
            latency = float(str(raw_latency).strip())
        except ValueError:
            return records, contaminated, f"RAW_LATENCY_INVALID:{number}"
        if not math.isfinite(latency):
            return records, contaminated, f"RAW_LATENCY_INVALID:{number}"
        if variant == "parent" and latency <= 0:
            return records, contaminated, f"RAW_PARENT_LATENCY_NONPOSITIVE:{number}"
        if latency <= 0:
            return records, contaminated, f"RAW_LATENCY_INVALID:{number}"
        if quality is None or not str(quality).strip():
            return records, contaminated, f"RAW_QUALITY_MISSING:{number}"
        key = (str(pair).strip(), variant)
        if key in seen:
            return records, contaminated, f"RAW_DUPLICATE_PAIR_VARIANT:{pair}:{variant}"
        seen.add(key)
        quality_token = str(quality).strip().upper() if quality is not None else ""
        row_contaminated = bool_value(field(row, "contaminated", "polluted", "reject"))
        if quality_token in BAD_QUALITY or (quality_token and quality_token not in GOOD_QUALITY):
            row_contaminated = True
        contaminated = contaminated or row_contaminated
        records.append(
            {
                "pair": str(pair).strip(),
                "variant": variant,
                "latency": latency,
                "contaminated": row_contaminated,
                "unclassified": False,
            }
        )
    return records, contaminated, None


def coefficient_of_variation(values: Sequence[float]) -> float:
    if len(values) < 2:
        return 0.0
    mean = statistics.fmean(values)
    if mean == 0:
        return math.inf
    return statistics.pstdev(values) / abs(mean)


def analyze_raw(path: Optional[Path], min_pairs: int, max_cv: float) -> Dict[str, Any]:
    result: Dict[str, Any] = {
        "status": "RAW_PARSE_ERROR",
        "parent_median": None,
        "candidate_median": None,
        "ratio_delta": None,
        "paired_delta": None,
        "paired_percent_delta": None,
        "raw_count": 0,
        "pair_count": 0,
        "quality_classification": "UNKNOWN",
        "promotion_eligible": False,
        "shape_local_verdict": "NOT_RUN",
        "shape_candidate_median_us": None,
        "shape_paired_delta_us": None,
        "shape_paired_percent_delta": None,
        "full_local_score": "NOT_COMPUTABLE",
        "noise_status": "UNKNOWN",
        "raw_sha": None,
        "reason": "RAW_SAMPLE_PATH_NOT_SET",
    }
    if path is None or not path.is_file():
        result["status"] = "NOT_RUN"
        result["reason"] = "RAW_SAMPLES_MISSING"
        return result
    try:
        result["raw_sha"] = sha256_file(path)
    except OSError as exc:
        result["reason"] = f"RAW_READ_FAILED:{exc}"
        return result
    records, contaminated, error = parse_raw(path)
    result["raw_count"] = len(records)
    unclassified = any(record.get("unclassified", False) for record in records)
    result["quality_classification"] = "UNCLASSIFIED" if unclassified else "EXPLICIT"
    if error:
        result["reason"] = error
        return result
    if contaminated:
        result["status"] = "REJECTED_CONTAMINATION"
        result["noise_status"] = "CONTAMINATED"
        result["reason"] = "STRUCTURED_CONTAMINATION_FLAG"
        return result
    values = {"parent": [], "candidate": []}
    pairs: Dict[str, Dict[str, float]] = {}
    for record in records:
        values[record["variant"]].append(record["latency"])
        pairs.setdefault(record["pair"], {})[record["variant"]] = record["latency"]
    if values["parent"]:
        result["parent_median"] = statistics.median(values["parent"])
    if values["candidate"]:
        result["candidate_median"] = statistics.median(values["candidate"])
    complete = [
        (pair["parent"], pair["candidate"])
        for pair in pairs.values()
        if "parent" in pair and "candidate" in pair
    ]
    result["pair_count"] = len(complete)
    unpaired = [pair for pair in pairs.values() if set(pair) != {"parent", "candidate"}]
    if unpaired:
        result["status"] = "UNPAIRED_DATA"
        result["noise_status"] = "INCOMPLETE_PAIRS"
        result["reason"] = f"UNPAIRED_ROWS={len(unpaired)}"
        return result
    if result["parent_median"] is None or result["parent_median"] <= 0:
        result["status"] = "INVALID_PARENT_LATENCY"
        result["noise_status"] = "INVALID_INPUT"
        result["reason"] = "PARENT_MEDIAN_MUST_BE_POSITIVE"
        return result
    if result["parent_median"] is not None and result["candidate_median"] is not None:
        result["ratio_delta"] = result["candidate_median"] / result["parent_median"] - 1.0
    if complete:
        result["paired_delta"] = statistics.median([candidate - parent for parent, candidate in complete])
        result["paired_percent_delta"] = statistics.median(
            [(candidate - parent) / parent for parent, candidate in complete]
        )
    result["shape_candidate_median_us"] = result["candidate_median"]
    result["shape_paired_delta_us"] = result["paired_delta"]
    result["shape_paired_percent_delta"] = result["paired_percent_delta"]
    if len(complete) < min_pairs or not values["parent"] or not values["candidate"]:
        result["status"] = "INSUFFICIENT_DATA"
        result["shape_local_verdict"] = "SHAPE_INSUFFICIENT_DATA"
        result["noise_status"] = "INSUFFICIENT_DATA"
        result["reason"] = f"COMPLETE_PAIRS={len(complete)}<MIN_PAIRS={min_pairs}"
        return result
    cvs = [coefficient_of_variation(values["parent"]), coefficient_of_variation(values["candidate"])]
    if max(cvs) > max_cv:
        result["noise_status"] = "NOISY"
        cv_reason = f"MAX_CV={max(cvs):.6f}>MAX_CV={max_cv:.6f}"
        if unclassified:
            result["status"] = "UNCLASSIFIED"
            result["shape_local_verdict"] = "SHAPE_UNCLASSIFIED_NO_PROMOTION"
            result["reason"] = f"{cv_reason};RAW_QUALITY_PROVENANCE_MISSING"
        else:
            result["status"] = "NOISY"
            result["shape_local_verdict"] = "SHAPE_NOISY_REJECTED"
            result["reason"] = cv_reason
        return result
    if unclassified:
        result["status"] = "UNCLASSIFIED"
        result["shape_local_verdict"] = "SHAPE_UNCLASSIFIED_NO_PROMOTION"
        result["noise_status"] = "STABLE_NUMERICALLY_ONLY"
        result["reason"] = "RAW_QUALITY_PROVENANCE_MISSING"
        return result
    result["status"] = "ACCEPTED"
    result["shape_local_verdict"] = "SHAPE_NUMERICALLY_STABLE"
    result["promotion_eligible"] = False
    result["noise_status"] = "STABLE"
    result["reason"] = "MEASURED_PAIRS_ACCEPTED"
    return result


def canonical_reference_identity(raw_path: str, purpose: str) -> Tuple[Optional[Dict[str, str]], Optional[str]]:
    public_marker = PUBLIC_CANONICAL_ROOT_MARKER
    public_index = raw_path.rfind(public_marker)
    if public_index >= 0 and not raw_path.startswith("gitobj://"):
        if not raw_path.startswith(PUBLIC_CANONICAL_SOURCE_ROOT + public_marker):
            return None, f"CANONICAL_PUBLIC_EXTERNAL_FILE_REJECTED:{raw_path}"
        object_path = raw_path[public_index + 1:]
        if purpose != "historical-tool-validation" or not object_path.startswith("本地实验/MAIN2-CANONICAL-V1/"):
            return None, f"CANONICAL_PUBLIC_PATH_OUT_OF_SCOPE:{raw_path}"
        if ".." in Path(object_path).parts:
            return None, f"CANONICAL_PUBLIC_PATH_OUT_OF_SCOPE:{raw_path}"
        raw_path = f"gitobj://{CANONICAL_PUBLIC_COMMIT}/{object_path}"
    match = re.fullmatch(r"gitobj://([0-9a-f]{40})/(.+)", raw_path)
    if match:
        commit, object_path = match.groups()
        allowed_prefixes = (
            "本地实验/MAIN2-CANONICAL-V1/versions/R31B__V011/measurement/",
            "本地实验/MAIN2-CANONICAL-V1/versions/",
        )
        if purpose != "historical-tool-validation" or commit != CANONICAL_PUBLIC_COMMIT or not object_path.startswith(allowed_prefixes):
            return None, f"CANONICAL_RAW_GIT_OBJECT_OUT_OF_SCOPE:{raw_path}"
        completed = subprocess.run(
            ["git", "show", f"{commit}:{object_path}"],
            cwd=str(EXPECTED_REPO_ROOT), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            check=False,
        )
        if completed.returncode != 0:
            return None, f"CANONICAL_RAW_GIT_OBJECT_UNAVAILABLE:{object_path}"
        return {"path": raw_path, "sha256": hashlib.sha256(completed.stdout).hexdigest()}, None

    path, digest, error = verify_file(raw_path, "canonical-raw", required=True)
    if error or path is None or digest is None:
        return None, error or "CANONICAL_RAW_IDENTITY_INVALID"
    try:
        path.relative_to(ROUTE_ROOT)
    except ValueError:
        return None, f"OUT_OF_SCOPE:canonical-raw:{path}:expected={ROUTE_ROOT}"
    return {"path": str(path), "sha256": digest}, None


def canonical_local_score(
    measurements_raw: Optional[str],
    source_sha: str,
    artifact_sha: str,
    purpose: str,
    expected_revision: Optional[str],
    expected_parent_artifact_sha: Optional[str] = None,
) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
    """Delegate four-Core aggregation to the pinned published MAIN2 scorer."""
    if purpose not in {"route-kernel", "historical-tool-validation"}:
        return None, f"CANONICAL_SCORE_PURPOSE_INVALID:{purpose}"
    measurements, measurements_sha, error = verify_identity_reference(
        measurements_raw,
        "canonical-measurements",
        allow_public=(purpose == "historical-tool-validation"),
    )
    if error or measurements is None or measurements_sha is None:
        return None, error or "CANONICAL_MEASUREMENTS_NOT_SET"
    measurements_git_object: Optional[str] = None
    if isinstance(measurements, str) and measurements.startswith("gitobj://"):
        measurements_git_object = measurements
        _, measurement_bytes, measurement_error = read_pinned_public_object(measurements)
        if measurement_error or measurement_bytes is None:
            return None, measurement_error or "CANONICAL_MEASUREMENTS_UNAVAILABLE"
    else:
        try:
            measurements.relative_to(ROUTE_ROOT)
            measurement_bytes = measurements.read_bytes()
        except (AttributeError, OSError, ValueError) as exc:
            return None, f"OUT_OF_SCOPE:canonical-measurements:{measurements}:expected={ROUTE_ROOT}:{exc}"
    try:
        rows = list(csv.DictReader(io.StringIO(measurement_bytes.decode("utf-8")), delimiter="\t"))
    except (UnicodeDecodeError, csv.Error) as exc:
        return None, f"CANONICAL_MEASUREMENTS_READ_FAILED:{exc}"
    if not rows:
        return None, "CANONICAL_MEASUREMENTS_EMPTY"

    subject_routes = {row.get("ROUTE", "").strip() for row in rows if row.get("CASE_ID") in CANONICAL_CORE_CASES}
    subject_revisions = {row.get("REVISION", "").strip() for row in rows if row.get("CASE_ID") in CANONICAL_CORE_CASES}
    if len(subject_routes) != 1 or "" in subject_routes or len(subject_revisions) != 1 or "" in subject_revisions:
        return None, "CANONICAL_SUBJECT_IDENTITY_INCOMPLETE"
    subject_route, subject_revision = next(iter(subject_routes)), next(iter(subject_revisions))
    if expected_revision and subject_revision != expected_revision:
        return None, "CANONICAL_REVISION_MISMATCH"
    if not expected_revision:
        return None, "CANONICAL_REVISION_REQUIRED"
    if purpose == "route-kernel" and subject_route != ROUTE:
        return None, "CANONICAL_ROUTE_MISMATCH"

    raw_identities: Dict[str, Dict[str, str]] = {}
    selected_rows = [row for row in rows if row.get("CASE_ID") in CANONICAL_CORE_CASES]
    run_keys = set()
    parent_artifact_sha: Optional[str] = None
    for row in selected_rows:
        case_id = row.get("CASE_ID", "")
        side = row.get("SIDE", "").lower()
        if side not in {"candidate", "parent"}:
            return None, f"CANONICAL_SIDE_INVALID:{case_id}:{side}"
        if row.get("SCORER_VERSION") != CANONICAL_SCORER_VERSION or row.get("SUITE_VERSION") != CANONICAL_SUITE_VERSION:
            return None, f"CANONICAL_VERSION_MISMATCH:{case_id}"
        if row.get("ROUTE") != subject_route or row.get("REVISION") != subject_revision:
            return None, f"CANONICAL_SUBJECT_MIXED:{case_id}"
        expected_row_source = source_sha if side == "candidate" else CANONICAL_BASE_SOURCE_SHA256
        if row.get("SOURCE_SHA") != expected_row_source:
            return None, f"CANONICAL_SOURCE_SHA_MISMATCH:{case_id}:{side}"
        if side == "candidate" and row.get("EXE_SHA") != artifact_sha:
            return None, f"CANONICAL_ARTIFACT_SHA_MISMATCH:{case_id}"
        if side == "parent":
            current_parent_artifact = row.get("EXE_SHA", "").strip()
            if not current_parent_artifact:
                return None, f"CANONICAL_PARENT_ARTIFACT_SHA_MISSING:{case_id}"
            if parent_artifact_sha is None:
                parent_artifact_sha = current_parent_artifact
            elif current_parent_artifact != parent_artifact_sha:
                return None, f"CANONICAL_PARENT_ARTIFACT_SHA_MIXED:{case_id}"
        if row.get("HARNESS_SHA") != CANONICAL_HARNESS_SHA256:
            return None, f"CANONICAL_HARNESS_SHA_MISMATCH:{case_id}"
        try:
            valid = row.get("VALID_RUN") == "YES" and int(row.get("RC", "-1")) == 0 and float(row.get("BAD", "nan")) == 0
            run = int(row.get("RUN", "0"))
        except (TypeError, ValueError):
            valid, run = False, 0
        if not valid or run not in {1, 2, 3}:
            return None, f"CANONICAL_RUN_INVALID:{case_id}:{side}:{row.get('RUN')}"
        key = (case_id, side, run)
        if key in run_keys:
            return None, f"CANONICAL_RUN_DUPLICATE:{case_id}:{side}:{run}"
        run_keys.add(key)
        for path_field in ("RAW_PATH", "STATS_PATH"):
            raw_file = row.get(path_field, "").strip()
            if not raw_file:
                return None, f"CANONICAL_{path_field}_MISSING:{case_id}:{side}:{run}"
            identity, identity_error = canonical_reference_identity(raw_file, purpose)
            if identity_error or identity is None:
                return None, identity_error or f"CANONICAL_{path_field}_INVALID:{case_id}:{side}:{run}"
            raw_identities[raw_file] = identity

    expected_keys = {
        (case_id, side, run)
        for case_id in CANONICAL_CORE_CASES
        for side in ("candidate", "parent")
        for run in (1, 2, 3)
    }
    if run_keys != expected_keys:
        missing = sorted(expected_keys - run_keys)
        extra = sorted(run_keys - expected_keys)
        return None, f"CANONICAL_CORE_INCOMPLETE:missing={missing}:extra={extra}"
    if purpose == "route-kernel" and parent_artifact_sha != CANONICAL_PARENT_ARTIFACT_SHA256:
        return None, "CANONICAL_PARENT_ARTIFACT_SHA_PIN_MISMATCH"
    if expected_parent_artifact_sha and parent_artifact_sha != expected_parent_artifact_sha:
        return None, "CANONICAL_PARENT_ARTIFACT_SHA_MISMATCH"
    for case_id in CANONICAL_CORE_CASES:
        case_rows = [row for row in selected_rows if row.get("CASE_ID") == case_id]
        try:
            sequence = [(row.get("SIDE", "").lower(), int(row.get("RUN", "0"))) for row in case_rows]
            attempts = {
                int(row["RUN"]): int(row["ATTEMPT"])
                for row in case_rows
                if row.get("ATTEMPT", "").strip()
            }
        except (KeyError, TypeError, ValueError):
            return None, f"CANONICAL_PAIR_ORDER_METADATA_INVALID:{case_id}"
        expected_sequence = [
            ("parent", 1), ("candidate", 1),
            ("candidate", 2), ("parent", 2),
            ("parent", 3), ("candidate", 3),
        ]
        if sequence != expected_sequence:
            return None, f"CANONICAL_PC_CP_ORDER_INVALID:{case_id}"
        if set(attempts) != {1, 2, 3} or not (attempts[1] < attempts[2] < attempts[3]):
            return None, f"CANONICAL_ATTEMPT_ORDER_INVALID:{case_id}"
        for run in (1, 2, 3):
            pair_attempts = {
                int(row["ATTEMPT"])
                for row in case_rows
                if int(row["RUN"]) == run
            }
            if len(pair_attempts) != 1:
                return None, f"CANONICAL_PAIR_ATTEMPT_MISMATCH:{case_id}:{run}"
        for run in (1, 2, 3):
            candidate = next(row for row in selected_rows if row.get("CASE_ID") == case_id and row.get("SIDE", "").lower() == "candidate" and row.get("RUN") == str(run))
            parent = next(row for row in selected_rows if row.get("CASE_ID") == case_id and row.get("SIDE", "").lower() == "parent" and row.get("RUN") == str(run))
            if candidate.get("DEVICE") != parent.get("DEVICE"):
                return None, f"CANONICAL_PAIRED_DEVICE_MISMATCH:{case_id}:{run}"

    payload = {
        "commit": CANONICAL_PUBLIC_COMMIT,
        "repo_root": str(EXPECTED_REPO_ROOT),
        "scorer_sha256": CANONICAL_SCORER_SHA256,
        "suite_sha256": CANONICAL_SUITE_SHA256,
        "harness_sha256": CANONICAL_HARNESS_SHA256,
        "base_sha": CANONICAL_BASE_SOURCE_SHA256,
        "scorer_version": CANONICAL_SCORER_VERSION,
        "suite_version": CANONICAL_SUITE_VERSION,
        "measurements_path": str(measurements),
        "measurements_git_object": measurements_git_object,
        "source_sha": source_sha,
    }
    node = shutil.which("node")
    if not node:
        return None, "CANONICAL_SCORER_NODE_UNAVAILABLE"
    try:
        completed = subprocess.run(
            [node, "--no-warnings", "--experimental-vm-modules", "--input-type=module", "-e", CANONICAL_SCORER_BRIDGE],
            cwd=str(EXPECTED_REPO_ROOT), input=json.dumps(payload), text=True,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, f"CANONICAL_SCORER_EXEC_FAILED:{exc}"
    if completed.returncode != 0:
        message = completed.stderr.strip().splitlines()[-1] if completed.stderr.strip() else "NO_STDERR"
        return None, f"CANONICAL_SCORER_RC={completed.returncode}:{message}"
    try:
        scored = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        return None, f"CANONICAL_SCORER_OUTPUT_INVALID:{exc}"
    if scored.get("core_cases_complete") != "4/4" or not math.isfinite(float(scored.get("score", "nan"))):
        return None, "CANONICAL_SCORER_CORE_VECTOR_INVALID"

    reported_score = float(scored["score"])
    raw_manifest_bytes = json.dumps(
        [{"path": item["path"], "sha256": item["sha256"]} for item in (raw_identities[key] for key in sorted(raw_identities))],
        sort_keys=True, separators=(",", ":"),
    ).encode()
    return {
        "score_status": "COMPUTABLE",
        "score_scope": purpose,
        "subject_route": subject_route,
        "subject_revision": subject_revision,
        "full_local_score": f"{reported_score:.6f}" if purpose == "route-kernel" else "NOT_COMPUTABLE",
        "reported_score": f"{reported_score:.6f}",
        "delta_vs_anchor": f"{float(scored['delta']):.6f}",
        "quality": scored["quality"],
        "local_status": scored["status"],
        "fragile": bool(scored["fragile"]),
        "reliable": bool(scored["reliable"]),
        "scorer_promotion_signal": bool(scored["reliable"]),
        "paired_score": None if scored.get("paired_score") is None else f"{float(scored['paired_score']):.6f}",
        "core_gain_count": int(scored["core_gain_count"]),
        "core_cases_complete": "4/4",
        "core_cases": sorted(CANONICAL_CORE_CASES),
        "scorer_version": CANONICAL_SCORER_VERSION,
        "scorer_commit": CANONICAL_PUBLIC_COMMIT,
        "scorer_sha256": CANONICAL_SCORER_SHA256,
        "suite_version": CANONICAL_SUITE_VERSION,
        "suite_sha256": CANONICAL_SUITE_SHA256,
        "harness_sha256": CANONICAL_HARNESS_SHA256,
        "anchor_source_sha256": CANONICAL_BASE_SOURCE_SHA256,
        "parent_source_sha256": CANONICAL_BASE_SOURCE_SHA256,
        "parent_artifact_sha256": parent_artifact_sha,
        "anchor_commit": CANONICAL_PUBLIC_COMMIT,
        "measurements_path": str(measurements),
        "measurements_sha256": measurements_sha,
        "raw_file_count": len(raw_identities),
        "raw_identities": [raw_identities[key] for key in sorted(raw_identities)],
        "raw_manifest_sha256": hashlib.sha256(raw_manifest_bytes).hexdigest(),
        "case_summaries": scored.get("cells", []),
        "promotion_eligible": bool(scored["reliable"]) if purpose == "route-kernel" else False,
    }, None


