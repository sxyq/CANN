+    __aicore__ inline void ApplyScaleFold(const AscendC::LocalTensor<float>& valueTile,
+                                          const AscendC::LocalTensor<float>& scaleTile,
+                                          const AscendC::LocalTensor<float>& gammaSlice,
+                                          const AscendC::LocalTensor<float>& biasSlice,
