python3 - <<'PY'
from pathlib import Path
import re
source=Path('线上结果/R31B/V011/submission.asc').read_text()
def mask_comment(m):
    return ''.join('\n' if c=='\n' else ' ' for c in m.group())
clean=re.sub(r'/\*.*?\*/|//[^\n]*', mask_comment, source, flags=re.S)
methods={}
pattern=r'__aicore__\s+inline\s+(?:void|int32_t|float)\s+(\w+)\s*\([^)]*\)\s*(?:const\s*)?\{'
for m in re.finditer(pattern,clean):
    begin=m.end()-1
    depth=1
    end=begin+1
    while depth:
        depth += (clean[end]=='{')-(clean[end]=='}')
        end+=1
    methods[m.group(1)]=(begin,end)
def line(pos):
    return clean.count('\n',0,pos)+1
edges={name:sorted(set(re.findall(r'\b(\w+)\s*\(',clean[a+1:b-1])) & methods.keys()) for name,(a,b) in methods.items()}
reachable=set()
pending=['Init','Process']
while pending:
    name=pending.pop()
    if name not in reachable:
        reachable.add(name)
        pending.extend(edges[name])
print('SOURCE=712e47230287182bc65ab433a3ce714e6fdafd9f:线上结果/R31B/V011/submission.asc')
print('MODE=LEXICAL_SOURCE_AUDIT; DOES_NOT_MODEL_COMPILER_OR_DEVICE_EXECUTION')
print('METHOD_COUNT='+str(len(methods)))
print('SYNTACTICALLY_REACHABLE='+str(len(reachable)))
for name in ['Init','Process','ProcessWideFp32','ProcessWideLowPrecision','ProcessNarrowMidOverlap']:
    a,b=methods[name]
    print(f'CALLS {name} L{line(a)}-L{line(b)}: '+','.join(edges[name]))
print('UNREACHABLE_METHODS_FROM_ENTRY='+','.join(sorted(set(methods)-reachable)))
print('INITBUFFER_SITES')
init_a,init_b=methods['Init']
for m in re.finditer(r'pipe_\.InitBuffer\((\w+),([^;]+)\);',clean[init_a:init_b]):
    print(f'L{line(init_a+m.start())}: {m.group(1)} SIZE='+re.sub(r'\s+',' ',m.group(2)).strip())
print('REACHABLE_TBUF_GET_CONSUMERS; branch predicates require the accompanying study')
for buf in re.findall(r'TBuf<[^;\n]+>\s+(\w+);',clean):
    refs=[]
    for name in sorted(reachable,key=lambda n:methods[n][0]):
        a,b=methods[name]
        hits=[str(line(a+m.start())) for m in re.finditer(r'\b'+re.escape(buf)+r'\.Get',clean[a:b])]
        if hits:
            refs.append(name+':'+','.join(hits))
    print(buf+' -> '+'; '.join(refs))
print('SCALAR_FIELD_OCCURRENCES')
for field in ['widePath_','wideFp32FullYPath_','wideFullYRows_','wideFullYTileElems_']:
    for i,ln in enumerate(clean.splitlines(),1):
        if re.search(r'\b'+field+r'\b',ln):
            print(f'{field} L{i}: '+ln.strip())
flag_lines=[ln.strip() for ln in clean.splitlines() if 'wideFp32FullYPath_' in ln]
assert flag_lines==['wideFp32FullYPath_ = false;','wideFp32FullYPath_ = true;','bool wideFp32FullYPath_;']
assert 'rowCount' not in clean[init_a:init_b] and 'blockCount' not in clean[init_a:init_b]
assert 'gammaFp32Buf_' not in clean[slice(*methods['ProcessNarrowMidOverlap'])]
assert 'biasFp32Buf_' not in clean[slice(*methods['ProcessNarrowMidOverlap'])]
assert not re.search(r'\.(EnQue|DeQue|AllocTensor|FreeTensor|Destroy|Reset)\s*[<(]',clean)
assert edges['ProcessWideFp32']==['ProcessWideFp32FullCacheRows']
assert len(re.findall(r'pipe_\.InitBuffer\(',clean[init_a:init_b]))==34
print('SOURCE_ASSERTIONS=PASS')
print('NEW_PERFORMANCE_REVISIONS=0; COMPILER_ELIMINATION_CONFIRMED=NONE; DEVICE_OPERATION=NONE')
PY
