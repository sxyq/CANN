import csv,io,re,subprocess
from pathlib import Path
for ref in ['m1/r31a-exploit','m1/r31b-exploit']:
    raw=subprocess.check_output(['git','show',ref+':技术路线/全版本记录.tsv'],text=True)
    print('HISTORY_MECHANISMS '+ref)
    for row in csv.DictReader(io.StringIO(raw),delimiter='\t'):
        if row['ROUTE'] in ['R31','R031','R31A','R31B','MIX-A','STORE-EPILOGUE-X','EPILOGUE-ARITH-CHAMPION-X','EPILOGUE-FUSE-X']:
            if ref.endswith('r31a-exploit') and row['ROUTE']=='R31B':
                continue
            if ref.endswith('r31b-exploit') and row['ROUTE']!='R31B':
                continue
            print(row['ROUTE'],row['REVISION'],row.get('HYPOTHESIS',''),sep='\t')
roots=['归档/历史工作区/R31A','归档/历史工作区/R31B','归档/历史工作区/MIX-A','归档/历史工作区/STORE-EPILOGUE-X','归档/phase3-before-reset-20260920/旧探索源码/deep-exploration/MULTIMODE-R031-RECONSTRUCTION','线上结果/EPILOGUE-ARITH-CHAMPION-X','线上结果/STORE-EPILOGUE-X','线上结果/R31A','线上结果/R31B']
files=subprocess.check_output(['rg','--files',*roots],text=True).splitlines()
count=0
flagfiles=0
flagreadfiles=[]
for name in sorted(files):
    p=Path(name)
    if p.suffix!='.asc' and p.name!='kernel.txt':
        continue
    txt=p.read_text()
    txt=re.sub(r'/\*.*?\*/|//[^\n]*','',txt,flags=re.S)
    if 'class AddRmsNormBiasKernel' not in txt and 'class MultiModeKernel' not in txt:
        continue
    count+=1
    refs=[ln.strip() for ln in txt.splitlines() if re.search(r'\bwideFp32FullYPath_\b',ln)]
    nonstores=[ln for ln in refs if not re.match(r'(bool wideFp32FullYPath_;|wideFp32FullYPath_\s*=)',ln)]
    if refs:
        flagfiles+=1
        print('FLAG_SOURCE',name,'occurrences='+str(len(refs)),'non_store='+str(len(nonstores)),sep='\t')
        if nonstores:
            flagreadfiles.append(name)
print(f'HISTORY_SOURCE_COPIES={count}; WITH_FIELD={flagfiles}; WITH_FIELD_READS={len(flagreadfiles)}')
print('SOURCE_COPIES_ARE_NOT_REVISION_COUNTS')
print('W3_REUSED=R12@e697ddf3/R05@1a31a3b5 Init comparisons: R2 V001-V040; R4 V001-V031; R5 V001-V028')
print('W4_REUSED=R03@712e4723; R05@1a31a3b5; R12@e697ddf3; R09@ec24f3ac; their cited R01/R02/R08/R10/R11 evidence')
