#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { return 1; } } while(0)

#include "kernel.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t xShape[] = {1, 64};
    TensorInfo xTensor[] = {{xShape, 2, 1}};
    TensorGroupInfo infoX = {xTensor, 1};
    int64_t residualShape[] = {1, 64};
    TensorInfo residualTensor[] = {{residualShape, 2, 1}};
    TensorGroupInfo infoResidual = {residualTensor, 1};
    int64_t gammaShape[] = {64};
    TensorInfo gammaTensor[] = {{gammaShape, 1, 1}};
    TensorGroupInfo infoGamma = {gammaTensor, 1};
    int64_t biasShape[] = {64};
    TensorInfo biasTensor[] = {{biasShape, 1, 1}};
    TensorGroupInfo infoBias = {biasTensor, 1};
    int64_t outputShape[] = {1, 64};
    TensorInfo outputTensor[] = {{outputShape, 2, 1}};
    TensorGroupInfo infoOutput = {outputTensor, 1};

    run_kernel(nullptr, infoX, nullptr, infoResidual, nullptr, infoGamma, nullptr, infoBias,
               nullptr, infoOutput, availableCoreNum, stream, 1e-5f);
    return 0;
}
