#include <cstdint>
#include <cstdio>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/add_rms_norm_bias_tiling.h"
#include "data_utils.h"
#include "../op_kernel/add_rms_norm_bias_kernel.asc"

struct ArgInfo {
    const char* fileName;
    size_t length;
};

static void KernelCall(uint32_t blockNum, aclrtStream stream,
                       const std::vector<ArgInfo>& inputs,
                       const ArgInfo& output,
                       const AddRmsNormBiasTilingData& tiling)
{
    std::vector<uint8_t*> hostIn(inputs.size());
    std::vector<uint8_t*> devIn(inputs.size());
    uint8_t* hostOut = nullptr;
    uint8_t* devOut = nullptr;
    uint8_t* devTiling = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&devTiling), sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputs.size(); ++i) {
        aclrtMallocHost(reinterpret_cast<void**>(&hostIn[i]), inputs[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&devIn[i]), inputs[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputs[i].fileName, inputs[i].length, hostIn[i], inputs[i].length);
        aclrtMemcpy(devIn[i], inputs[i].length, hostIn[i], inputs[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }
    aclrtMallocHost(reinterpret_cast<void**>(&hostOut), output.length);
    aclrtMalloc(reinterpret_cast<void**>(&devOut), output.length, ACL_MEM_MALLOC_HUGE_FIRST);

    add_rms_norm_bias_kernel<<<blockNum, nullptr, stream>>>(
        devIn[0], devIn[1], devIn[2], devIn[3], devOut, devTiling);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(hostOut, output.length, devOut, output.length, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(output.fileName, hostOut, output.length);
    aclrtFree(devOut);
    aclrtFreeHost(hostOut);
    aclrtFree(devTiling);
    for (size_t i = 0; i < inputs.size(); ++i) {
        aclrtFree(devIn[i]);
        aclrtFreeHost(hostIn[i]);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    const int32_t deviceId = 0;
    int32_t ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        return ret;
    }

    int64_t coreCount = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount);
    if (ret != ACL_SUCCESS || coreCount <= 0) {
        aclrtResetDevice(deviceId);
        return ret == ACL_SUCCESS ? ACL_ERROR_INVALID_PARAM : ret;
    }

    const uint32_t outer = 8;
    const uint32_t dim = 4096;
    const uint32_t alignedDim = ((dim + 7) / 8) * 8;
    const uint32_t rowsPerBlock = 1;
    const uint32_t blockNum = (outer + rowsPerBlock - 1) / rowsPerBlock;
    AddRmsNormBiasTilingData tiling{blockNum, outer, dim, alignedDim, rowsPerBlock, outer - (blockNum - 1) * rowsPerBlock, RNB_EPSILON};
    const size_t rowBytes = static_cast<size_t>(dim) * sizeof(float);
    const size_t inputBytes = static_cast<size_t>(outer) * rowBytes;
    const size_t vectorBytes = rowBytes;

    std::vector<ArgInfo> inputs = {
        {"./input/input_x.bin", inputBytes},
        {"./input/input_residual.bin", inputBytes},
        {"./input/input_gamma.bin", vectorBytes},
        {"./input/input_bias.bin", vectorBytes},
    };
    ArgInfo output{"./output/output.bin", inputBytes};
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    KernelCall(blockNum, stream, inputs, output, tiling);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
