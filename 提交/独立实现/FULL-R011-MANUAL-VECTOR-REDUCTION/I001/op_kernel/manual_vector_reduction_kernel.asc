// [MODIFY] Kernel 类 - 封装 NPU 上的计算逻辑
class KernelManualVectorReduction {
public:
    __aicore__ inline KernelManualVectorReduction(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    // [MODIFY] 根据你的算子修改 Init 参数和 Global Tensor
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                GM_ADDR bias, GM_ADDR y,
                                const __gm__ ManualVectorReductionTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->rowsPerCore * tiling->lastDim;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailRowsLastCore * tiling->lastDim;
            tileNum = (total + (TILE_LENGTH - 1))/ TILE_LENGTH;
            tailTileElementNum = tileNum == 0 ? 0 : total - TILE_LENGTH * (tileNum - 1);
        }

        uint64_t rowOffset = static_cast<uint64_t>(blockIdx) * tiling->rowsPerCore;
        uint64_t elementOffset = rowOffset * tiling->lastDim;
        xGm.SetGlobalBuffer((__gm__ float *)x + elementOffset, total);
        residualGm.SetGlobalBuffer((__gm__ float *)residual + elementOffset, total);
        gammaGm.SetGlobalBuffer((__gm__ float *)gamma, tiling->lastDim);
        biasGm.SetGlobalBuffer((__gm__ float *)bias, tiling->lastDim);
        yGm.SetGlobalBuffer((__gm__ float *)y + elementOffset, total);

        // [MODIFY] 根据你的算子计算逻辑，调整UB Buffer初始化
        pipe_->InitBuffer(xBuf_, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(residualBuf_, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(gammaBuf_, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(biasBuf_, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(workBuf_, TILE_LENGTH * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
        AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
        AscendC::LocalTensor<float> gammaLocal = gammaBuf_.Get<float>();
        AscendC::LocalTensor<float> biasLocal = biasBuf_.Get<float>();
        AscendC::LocalTensor<float> workLocal = workBuf_.Get<float>();

        uint32_t rows = (AscendC::GetBlockIdx() == tiling->blockNum - 1)
            ? tiling->tailRowsLastCore : tiling->rowsPerCore;
        for (uint32_t row = 0; row < rows; ++row) {
            uint64_t rowOffset = static_cast<uint64_t>(row) * tiling->lastDim;
            float sum = 0.0f;
            uint32_t offset = 0;
            while (offset < tiling->lastDim) {
                uint32_t count = tiling->lastDim - offset;
                if (count > TILE_LENGTH) {
                    count = TILE_LENGTH;
                }
                int32_t chunkCount = static_cast<int32_t>(count);
                AscendC::DataCopyPad(xLocal, xGm[rowOffset + offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::DataCopyPad(residualLocal, residualGm[rowOffset + offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::Add(xLocal, xLocal, residualLocal, chunkCount);
                AscendC::Mul(workLocal, xLocal, xLocal, chunkCount);
                uint32_t active = count;
                while (active > 1) {
                    uint32_t half = active >> 1;
                    AscendC::Add(workLocal, workLocal, workLocal[half], half);
                    if (active & 1U) {
                        AscendC::Adds(workLocal[half], workLocal[active - 1], 0.0f, 1);
                    }
                    active = half + (active & 1U);
                }
                sum += workLocal.GetValue(0);
                offset += count;
            }

            AscendC::Adds(workLocal, workLocal, sum / tiling->lastDim + tiling->epsilon, 1);
            AscendC::Sqrt(workLocal, workLocal, 1);
            float invNorm = 1.0f / workLocal.GetValue(0);

            offset = 0;
            while (offset < tiling->lastDim) {
                uint32_t count = tiling->lastDim - offset;
                if (count > TILE_LENGTH) {
                    count = TILE_LENGTH;
                }
                int32_t chunkCount = static_cast<int32_t>(count);
                AscendC::DataCopyPad(xLocal, xGm[rowOffset + offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::DataCopyPad(residualLocal, residualGm[rowOffset + offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::DataCopyPad(gammaLocal, gammaGm[offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::DataCopyPad(biasLocal, biasGm[offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::Add(xLocal, xLocal, residualLocal, chunkCount);
                AscendC::Muls(xLocal, xLocal, invNorm, chunkCount);
                AscendC::Mul(xLocal, xLocal, gammaLocal, chunkCount);
                AscendC::Add(xLocal, xLocal, biasLocal, chunkCount);
                AscendC::DataCopyPad(yGm[rowOffset + offset], xLocal,
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
                offset += count;
            }
        }
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ ManualVectorReductionTilingData* tiling;

    // [MODIFY] 根据你的输入/输出数量调整
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> residualGm;
    AscendC::GlobalTensor<float> gammaGm;
    AscendC::GlobalTensor<float> biasGm;
    AscendC::GlobalTensor<float> yGm;

    AscendC::TBuf<AscendC::TPosition::VECCALC> xBuf_, residualBuf_, gammaBuf_, biasBuf_, workBuf_;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// [MODIFY] 核函数入口 - manual_vector_reduction → <your_op>（保持 _kernel 后缀）
extern "C" __global__ __vector__ void manual_vector_reduction_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR y, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelManualVectorReduction op(&pipe);
    op.Init(x, residual, gamma, bias, y, (__gm__ ManualVectorReductionTilingData*)tiling);
    op.Process();
}
