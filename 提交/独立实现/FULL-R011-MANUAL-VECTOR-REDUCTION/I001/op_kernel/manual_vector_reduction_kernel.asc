// [MODIFY] Kernel 类 - 封装 NPU 上的计算逻辑
class KernelManualVectorReduction {
public:
    __aicore__ inline KernelManualVectorReduction(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
