    AscendC::GlobalTensor<float> gammaGm;
    AscendC::GlobalTensor<float> biasGm;
    AscendC::GlobalTensor<float> yGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// [MODIFY] 核函数入口 - manual_vector_reduction → <your_op>（保持 _kernel 后缀）
extern "C" __global__ __vector__ void manual_vector_reduction_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR y, GM_ADDR tiling)
{
