#include <stdint.h>
#include "kernel_operator.h"

// Direct-invocation submission entry for FULL-R011.
// The reduction is a manual vector pairwise accumulation; no ReduceSum path is used.
namespace {

constexpr uint32_t kTileLength = 4096;

struct ManualVectorReductionTilingData {
    uint32_t blockNum;
    uint32_t outer;
    uint32_t lastDim;
    uint32_t rowsPerCore;
    uint32_t tailRowsLastCore;
    float epsilon;
};

class KernelManualVectorReduction {
public:
    __aicore__ inline explicit KernelManualVectorReduction(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                GM_ADDR bias, GM_ADDR y,
                                const __gm__ ManualVectorReductionTilingData* tiling)
    {
        tiling_ = tiling;
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t rows = blockIdx == tiling_->blockNum - 1
            ? tiling_->tailRowsLastCore : tiling_->rowsPerCore;
        const uint64_t rowBase = static_cast<uint64_t>(blockIdx) * tiling_->rowsPerCore;
        const uint64_t elementBase = rowBase * tiling_->lastDim;
        total_ = rows * tiling_->lastDim;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x) + elementBase, total_);
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(residual) + elementBase, total_);
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(gamma), tiling_->lastDim);
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias), tiling_->lastDim);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y) + elementBase, total_);

        pipe_->InitBuffer(xBuf_, kTileLength * sizeof(float));
        pipe_->InitBuffer(residualBuf_, kTileLength * sizeof(float));
        pipe_->InitBuffer(gammaBuf_, kTileLength * sizeof(float));
        pipe_->InitBuffer(biasBuf_, kTileLength * sizeof(float));
        pipe_->InitBuffer(workBuf_, kTileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
        AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
        AscendC::LocalTensor<float> gammaLocal = gammaBuf_.Get<float>();
        AscendC::LocalTensor<float> biasLocal = biasBuf_.Get<float>();
        AscendC::LocalTensor<float> workLocal = workBuf_.Get<float>();
        const uint32_t rows = (AscendC::GetBlockIdx() == tiling_->blockNum - 1)
            ? tiling_->tailRowsLastCore : tiling_->rowsPerCore;

        for (uint32_t row = 0; row < rows; ++row) {
            const uint64_t rowOffset = static_cast<uint64_t>(row) * tiling_->lastDim;
            float sum = 0.0f;
            uint32_t offset = 0;
            while (offset < tiling_->lastDim) {
                uint32_t count = tiling_->lastDim - offset;
                if (count > kTileLength) count = kTileLength;
                const int32_t n = static_cast<int32_t>(count);
                AscendC::DataCopyPad(xLocal, xGm_[rowOffset + offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::DataCopyPad(residualLocal, residualGm_[rowOffset + offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::Add(xLocal, xLocal, residualLocal, n);
                AscendC::Mul(workLocal, xLocal, xLocal, n);
                uint32_t active = count;
                while (active > 1) {
                    const uint32_t half = active >> 1;
                    AscendC::Add(workLocal, workLocal, workLocal[half], static_cast<int32_t>(half));
                    if (active & 1U) {
                        AscendC::Adds(workLocal[half], workLocal[active - 1], 0.0f, 1);
                    }
                    active = half + (active & 1U);
                }
                sum += workLocal.GetValue(0);
                offset += count;
            }

            AscendC::Adds(workLocal, workLocal,
                          sum / tiling_->lastDim + tiling_->epsilon, 1);
            AscendC::Sqrt(workLocal, workLocal, 1);
            const float invNorm = 1.0f / workLocal.GetValue(0);

            offset = 0;
            while (offset < tiling_->lastDim) {
                uint32_t count = tiling_->lastDim - offset;
                if (count > kTileLength) count = kTileLength;
                const int32_t n = static_cast<int32_t>(count);
                AscendC::DataCopyPad(xLocal, xGm_[rowOffset + offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::DataCopyPad(residualLocal, residualGm_[rowOffset + offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::DataCopyPad(gammaLocal, gammaGm_[offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::DataCopyPad(biasLocal, biasGm_[offset],
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
                    {false, 0, 0, 0});
                AscendC::Add(xLocal, xLocal, residualLocal, n);
                AscendC::Muls(xLocal, xLocal, invNorm, n);
                AscendC::Mul(xLocal, xLocal, gammaLocal, n);
                AscendC::Add(xLocal, xLocal, biasLocal, n);
                AscendC::DataCopyPad(yGm_[rowOffset + offset], xLocal,
                    {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
                offset += count;
            }
        }
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ ManualVectorReductionTilingData* tiling_;
    AscendC::GlobalTensor<float> xGm_;
    AscendC::GlobalTensor<float> residualGm_;
    AscendC::GlobalTensor<float> gammaGm_;
    AscendC::GlobalTensor<float> biasGm_;
    AscendC::GlobalTensor<float> yGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> residualBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> biasBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> workBuf_;
    uint32_t total_;
};

extern "C" __global__ __vector__ void manual_vector_reduction_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR y, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelManualVectorReduction op(&pipe);
    op.Init(x, residual, gamma, bias, y,
            reinterpret_cast<const __gm__ ManualVectorReductionTilingData*>(tiling));
    op.Process();
}

}  // namespace

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    (void)info_residual;
    (void)info_gamma;
    (void)info_bias;
    (void)info_output;
    const TensorInfo& xInfo = info_x.tensors[0];
    uint64_t outer = 1;
    const int64_t lastDim64 = xInfo.shape[xInfo.numDims - 1];
    for (int64_t i = 0; i + 1 < xInfo.numDims; ++i) {
        outer *= static_cast<uint64_t>(xInfo.shape[i]);
    }
    const uint32_t lastDim = static_cast<uint32_t>(lastDim64);
    const uint32_t outer32 = static_cast<uint32_t>(outer);
    const uint32_t coreCount = availableCoreNum > 0
        ? static_cast<uint32_t>(availableCoreNum) : 1U;
    const uint32_t blockNum = outer32 < coreCount ? outer32 : coreCount;
    const uint32_t rowsPerCore = (outer32 + blockNum - 1) / blockNum;

    ManualVectorReductionTilingData tiling{
        blockNum,
        outer32,
        lastDim,
        rowsPerCore,
        outer32 - rowsPerCore * (blockNum - 1),
        epsilon
    };
    manual_vector_reduction_kernel<<<blockNum, nullptr, stream>>>(
        x, residual, gamma, bias, output,
        (GM_ADDR)(&tiling));
}
