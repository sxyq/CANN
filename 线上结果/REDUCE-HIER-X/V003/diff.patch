+    // H3: pairwise-add fold of `count` FP32 values at `buf` down to at most
+    // kReduceSpan elements, using only 32B-aligned Add operands.  All Adds
+    // in the fold run back-to-back on the V pipe (in-order RAW is safe) with
+    // NO per-level PipeBarrier; the caller issues one PipeBarrier before the
+    // short-span ReduceSum.  Returns the resulting element count.
+    __aicore__ inline int32_t FoldToReduceSpan(AscendC::LocalTensor<float> buf,
+                                              int32_t count)
+    {
+        int32_t n = count;
+        while (n > kReduceSpan && (n & 1) == 0) {
+            const int32_t half = n >> 1;
+            AscendC::Add(buf, buf, buf[half], half);
+            n = half;
+        }
+        return n;
+    }
