#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <string>

#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#define ACL_CHECK(expr) do { \
    aclError _ret = (expr); \
    if (_ret != 0) { \
        const char* _msg = aclGetRecentErrMsg(); \
        std::fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d, msg=%s\n", \
                     #expr, __FILE__, __LINE__, _ret, _msg ? _msg : ""); \
        return 1; \
    } \
} while (0)

#include "kernel.asc"

static uint64_t ReadPositive(const char* name, uint64_t fallback)
{
    const char* value = std::getenv(name);
    if (value == nullptr || *value == '\0') {
        return fallback;
    }
    char* end = nullptr;
    const unsigned long long parsed = std::strtoull(value, &end, 10);
    if (end == value || *end != '\0' || parsed == 0) {
        return fallback;
    }
    return static_cast<uint64_t>(parsed);
}

static int32_t ReadDtype()
{
    const char* value = std::getenv("PROBE_DTYPE");
    if (value == nullptr) {
        return 1;
    }
    if (std::strcmp(value, "0") == 0 || std::strcmp(value, "fp32") == 0) {
        return 0;
    }
    if (std::strcmp(value, "2") == 0 || std::strcmp(value, "bf16") == 0) {
        return 2;
    }
    return 1;
}

int main()
{
    const uint64_t width = ReadPositive("PROBE_D", 64);
    const uint64_t rows = ReadPositive("PROBE_ROWS", 1);
    const uint64_t rank = ReadPositive("PROBE_RANK", 2);
    const int32_t dtype = ReadDtype();
    const int32_t deviceId = static_cast<int32_t>(ReadPositive("PROBE_DEVICE", 5));
    const uint64_t elementBytes = dtype == 0 ? sizeof(float) : sizeof(uint16_t);
    if (width > std::numeric_limits<uint64_t>::max() / rows ||
        width * rows > std::numeric_limits<size_t>::max() / elementBytes ||
        width > std::numeric_limits<size_t>::max() / elementBytes) {
        std::fprintf(stderr, "[ERROR] probe size overflow\n");
        return 1;
    }
    const size_t rowElements = static_cast<size_t>(width);
    const size_t totalElements = static_cast<size_t>(width * rows);
    const size_t rowBytes = rowElements * elementBytes;
    const size_t totalBytes = totalElements * elementBytes;

    int64_t shape[4] = {1, 1, 1, 1};
    int64_t numDims = 2;
    if (rank <= 2) {
        shape[0] = static_cast<int64_t>(rows);
        shape[1] = static_cast<int64_t>(width);
        numDims = 2;
    } else if (rank == 3) {
        shape[0] = 1;
        shape[1] = static_cast<int64_t>(rows);
        shape[2] = static_cast<int64_t>(width);
        numDims = 3;
    } else {
        shape[0] = 1;
        shape[1] = 1;
        shape[2] = static_cast<int64_t>(rows);
        shape[3] = static_cast<int64_t>(width);
        numDims = 4;
    }
    int64_t parameterShape[] = {static_cast<int64_t>(width)};
    TensorInfo xTensor[] = {{shape, numDims, dtype}};
    TensorInfo residualTensor[] = {{shape, numDims, dtype}};
    TensorInfo gammaTensor[] = {{parameterShape, 1, dtype}};
    TensorInfo biasTensor[] = {{parameterShape, 1, dtype}};
    TensorInfo outputTensor[] = {{shape, numDims, dtype}};
    TensorGroupInfo infoX = {xTensor, 1};
    TensorGroupInfo infoResidual = {residualTensor, 1};
    TensorGroupInfo infoGamma = {gammaTensor, 1};
    TensorGroupInfo infoBias = {biasTensor, 1};
    TensorGroupInfo infoOutput = {outputTensor, 1};

    std::fprintf(stdout, "PROBE width=%llu rows=%llu rank=%llu dtype=%d device=%d bytes=%zu\n",
                 static_cast<unsigned long long>(width),
                 static_cast<unsigned long long>(rows),
                 static_cast<unsigned long long>(rank), dtype, deviceId, totalBytes);

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    int64_t availableCoreNum = 0;
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    uint8_t* hostX = nullptr;
    uint8_t* deviceX = nullptr;
    uint8_t* hostResidual = nullptr;
    uint8_t* deviceResidual = nullptr;
    uint8_t* hostGamma = nullptr;
    uint8_t* deviceGamma = nullptr;
    uint8_t* hostBias = nullptr;
    uint8_t* deviceBias = nullptr;
    uint8_t* hostOutput = nullptr;
    uint8_t* deviceOutput = nullptr;

    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void**>(&hostX), totalBytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&deviceX), totalBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void**>(&hostResidual), totalBytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&deviceResidual), totalBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void**>(&hostGamma), rowBytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&deviceGamma), rowBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void**>(&hostBias), rowBytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&deviceBias), rowBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void**>(&hostOutput), totalBytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&deviceOutput), totalBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    if (!ReadFile("./input/x.bin", totalBytes, hostX, totalBytes) ||
        !ReadFile("./input/residual.bin", totalBytes, hostResidual, totalBytes) ||
        !ReadFile("./input/gamma.bin", rowBytes, hostGamma, rowBytes) ||
        !ReadFile("./input/bias.bin", rowBytes, hostBias, rowBytes)) {
        std::fprintf(stderr, "[ERROR] probe input size or file mismatch\n");
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(deviceX, totalBytes, hostX, totalBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(deviceResidual, totalBytes, hostResidual, totalBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(deviceGamma, rowBytes, hostGamma, rowBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(deviceBias, rowBytes, hostBias, rowBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    run_kernel((GM_ADDR)deviceX, infoX,
               (GM_ADDR)deviceResidual, infoResidual,
               (GM_ADDR)deviceGamma, infoGamma,
               (GM_ADDR)deviceBias, infoBias,
               (GM_ADDR)deviceOutput, infoOutput,
               availableCoreNum, stream, 1e-5f);
    const aclError syncRet = aclrtSynchronizeStreamWithTimeout(stream, 10000);
    if (syncRet != 0) {
        const char* msg = aclGetRecentErrMsg();
        std::fprintf(stderr, "SYNC_RET=%d MSG=%s CORES=%lld\n",
                     syncRet, msg ? msg : "", static_cast<long long>(availableCoreNum));
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(hostOutput, totalBytes, deviceOutput, totalBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!WriteFile("./output/output.bin", hostOutput, totalBytes)) {
        std::fprintf(stderr, "[ERROR] output write failed\n");
        return 1;
    }

    std::fprintf(stdout, "PROBE_STATUS=0 CORES=%lld\n", static_cast<long long>(availableCoreNum));
    aclrtFree(deviceX);
    aclrtFreeHost(hostX);
    aclrtFree(deviceResidual);
    aclrtFreeHost(hostResidual);
    aclrtFree(deviceGamma);
    aclrtFreeHost(hostGamma);
    aclrtFree(deviceBias);
    aclrtFreeHost(hostBias);
    aclrtFree(deviceOutput);
    aclrtFreeHost(hostOutput);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
