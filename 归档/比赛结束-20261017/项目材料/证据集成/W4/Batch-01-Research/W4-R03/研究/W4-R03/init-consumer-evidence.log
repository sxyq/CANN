141: __aicore__ inline void TPipe::AllocAddrs(TBufType* ptr, const First& addr, const Rest&... addrs)
142: {
143:     static_assert(Std::is_tuple_v<First> && Std::tuple_size_v<First> == 2,
144:             "input Addrs must be Std::tuple type and tuple_size must be 2");
145:     constexpr bool useAltBufId = T::config.consumerSize > 1;
146:     ptr->state = TBufState::FREE;
147:     ptr->freeBufEvt = T::freeBufEvt;
148:     if constexpr (T::queDepth == 0) {
149:         ptr->enQueEvtID = AllocEventID<T::enQueEvt>();
150:         ptr->freeBufEvtID = AllocEventID<T::freeBufEvt>();
151:         SetFlag<T::freeBufEvt>(ptr->freeBufEvtID);
152:     } else {
153:         ptr->enQueEvtID = INVALID_TEVENTID;
154:         ptr->freeBufEvtID = INVALID_TEVENTID;
155:     }
156:     // process specifically for better static_assert message
157:     if constexpr ((Std::tuple_size_v<First>) > 1) {
158:         ptr->address = Std::get<0>(addr);
159:         ptr->dataLen = Std::get<1>(addr);
160:     }
161: 
162: #ifdef ASCENDC_CPU_DEBUG
163:     int32_t maxLen = ptr->address + ptr->dataLen;
164:     Hardware pool = GetBufferPos(T::srcPosition, T::dstPosition);
165:     int32_t currentPoolSize = ConstDefiner::Instance().bufferInitLen.at(pool);
166:     ASCENDC_ASSERT(maxLen <= currentPoolSize, {
167:         KERNEL_LOG(KERNEL_ERROR, "current buffer access buffer at %d, exceed limits %d", maxLen, currentPoolSize);
168:     });
169: #endif
170:     ptr->usertag = -1;
171:     if constexpr (sizeof...(addrs) > 0) {
172:         AllocAddrs<T>(++ptr, addrs...);
173:     }
174: }
