529: {
530:     auto ptr = this->g_tpipeImpl.buf_;
531:     for (uint8_t i = 0; i < this->g_tpipeImpl.curBufSize_; i++, ptr++) {
532:         if (ptr->freeBufEvtID != INVALID_TEVENTID && ptr->state == TBufState::FREE) {
533:             WaitFlagImpl(ptr->freeBufEvt, ptr->freeBufEvtID);
