338:     this->g_tpipeImpl.curBufSize_ += bufHandleSize;
339:     // total buffer num created by InitBuffer must be <= 64
340:     ASCENDC_DEBUG_ASSERT((this->g_tpipeImpl.curBufSize_ <= QBUF_MAX_LEN && this->g_tpipeImpl.curBufSize_ > 0),
