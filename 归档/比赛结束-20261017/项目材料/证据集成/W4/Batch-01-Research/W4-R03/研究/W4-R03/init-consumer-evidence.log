491: __aicore__ inline void TPipe::Destroy()
492: {
493:     g_tpipeImpl.isDestroy = true;
494:     auto ptr = this->g_tpipeImpl.buf_;
495:     for (uint8_t i = 0; i < this->g_tpipeImpl.curBufSize_; i++, ptr++) {
496:         if (ptr->freeBufEvtID != INVALID_TEVENTID && ptr->state == TBufState::FREE) {
497:             WaitFlagImpl(ptr->freeBufEvt, ptr->freeBufEvtID);
498:             ptr->freeBufEvtID = INVALID_TEVENTID;
499:         }
500:     }
501:     // for matmul macro, release M_MTE1 0 1 event id.
502: #if __NPU_ARCH__ == 2201
503:     if ASCEND_IS_AIC {
504:         WaitFlag<HardEvent::M_MTE1>(0);
505:         ReleaseEventID<HardEvent::M_MTE1>(0);
506:         WaitFlag<HardEvent::M_MTE1>(1);
507:         ReleaseEventID<HardEvent::M_MTE1>(1);
508:         // For Bias
509:         WaitFlag<HardEvent::M_MTE1>(2);
510:         ReleaseEventID<HardEvent::M_MTE1>(2);
511:     }
512: #elif __NPU_ARCH__ == 3002 || (__NPU_ARCH__ == 5102)
513:     WaitFlag<HardEvent::M_MTE1>(0);
514:     ReleaseEventID<HardEvent::M_MTE1>(0);
515:     WaitFlag<HardEvent::M_MTE1>(1);
516:     ReleaseEventID<HardEvent::M_MTE1>(1);
517:     WaitFlag<HardEvent::M_MTE1>(2);
518:     ReleaseEventID<HardEvent::M_MTE1>(2);
519: #endif
520: #ifndef __ASCENDC_ENABLE_SUPER_KERNEL__
521:     pipe_barrier(PIPE_ALL);
522: #endif
523: #if __NPU_ARCH__ == 2002
524:     dcci((__gm__ int64_t*)0, cache_line_t::ENTIRE_DATA_CACHE);
525: #endif
526: }
