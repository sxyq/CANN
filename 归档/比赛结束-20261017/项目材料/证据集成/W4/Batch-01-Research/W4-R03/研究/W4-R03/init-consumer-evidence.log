904:         int32_t* p = reinterpret_cast<int32_t*>(ptr);
905:         for (uint64_t i = 0; i < bufferInitLen.at(hard) / sizeof(int32_t); i++) {
906:             p[i] = e();
907:         }
908:     }
909:     bufPool->phySpace = bufferInitLen.at(hard);
910:     bufPool->absAddr = ptr;
911:     return;
912: }
913: #endif
