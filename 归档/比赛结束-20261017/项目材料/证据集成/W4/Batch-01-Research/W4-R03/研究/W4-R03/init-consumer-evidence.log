19: // begin impl of tbuf
20: template <TPosition pos>
21: template <typename T>
22: __aicore__ inline __sync_alias__ LocalTensor<T> TBuf<pos>::Get(uint32_t len)
23: {
24:     using PrimType = PrimT<T>;
25:     uint32_t dataLen;
26:     if constexpr (IsSameType<PrimType, int4b_t>::value) {
27:         dataLen = len / INT4_TWO;
28: #if (__NPU_ARCH__ == 5102)
29:     } else if constexpr (IsSameType<T, int2b_t>::value) {
30:         dataLen = len / INT2_FOUR;
31: #endif
32:     } else {
33:         dataLen = len * sizeof(PrimType);
34:     }
35: #if defined(ASCENDC_CPU_DEBUG) && ASCENDC_CPU_DEBUG == 1
36:     ASCENDC_ASSERT((len > 0), { KERNEL_LOG(KERNEL_ERROR, "buffer length is %u, which should be larger than 0", len); });
37:     ASCENDC_DEBUG_ASSERT((dataLen % ONE_BLK_SIZE == 0), "buffer length is %u, which should be times of 32 Bytes \n",
38:         len);
39:     ASCENDC_ASSERT((dataLen <= bufLen),
40:                    { KERNEL_LOG(KERNEL_ERROR, "len is %u, max buffer len is %u", dataLen, bufLen); });
41: #endif
42:     auto ptr = this->bufStart;
43:     ptr->dataLen = dataLen;
44:     TBuffAddr addr;
45:     addr.logicPos = static_cast<uint8_t>(pos);
46:     addr.bufferHandle = reinterpret_cast<TBufHandle>(ptr);
47:     addr.bufferAddr = ptr->address;
48:     addr.dataLen = ptr->dataLen;
49: #if defined(ASCENDC_CPU_DEBUG) && ASCENDC_CPU_DEBUG == 1
50:     auto absAddr = GetTPipePtr()->g_tpipeImpl.bufPoolBaseAddr_[static_cast<uint8_t>(GetPhyType(pos))].absAddr;
51:     addr.absAddr = absAddr + addr.bufferAddr;
52:     AscendCBufGet(addr.logicPos, static_cast<uint8_t>(GetPhyType(pos)), reinterpret_cast<uint64_t>(addr.absAddr), len);
53:     if (this->bufPoolHandle != 0U) {
54:         AscendCUpdateTbufPoolStatus(this->bufPoolHandle, false);
55:         AscendCTBufPoolResetCheck(static_cast<uint8_t>(GetPhyType(pos)),
56:             reinterpret_cast<uint64_t>(absAddr + ptr->address),
57:             static_cast<uint64_t>(ptr->dataLen),
58:             this->bufPoolHandle);
59:     }
60: #endif
61:     LocalTensor<T> output;
62:     output.SetAddr(addr);
63:     return output;
64: }
65: 
66: template <TPosition pos> template <typename T> __aicore__ inline __sync_alias__ LocalTensor<T> TBuf<pos>::Get()
67: {
68:     using PrimType = PrimT<T>;
69:     if constexpr (IsSameType<PrimType, int4b_t>::value) {
70:         return Get<T>(bufLen * INT4_TWO);
71: #if (__NPU_ARCH__ == 5102)
72:     } else if constexpr (IsSameType<T, int2b_t>::value) {
73:         return Get<T>(bufLen * INT2_FOUR);
74: #endif
75:     } else {
76:         return Get<T>(bufLen / sizeof(PrimType));
77:     }
78: }
