289: template <TPosition pos> __aicore__ inline bool TPipe::InitBuffer(TBuf<pos>& buf, uint32_t len)
290: {
291:     constexpr auto pool = GetPhyType(pos);
292: #if defined(ASCENDC_CPU_DEBUG) && ASCENDC_CPU_DEBUG == 1
293:     auto bufferInitLen = ConstDefiner::Instance().bufferInitLen;
294:     auto currentPoolSize = bufferInitLen.at(pool);
