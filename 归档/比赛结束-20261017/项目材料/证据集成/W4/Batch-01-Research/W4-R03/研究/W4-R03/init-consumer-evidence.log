318:     auto ptr = buf.bufStart;
319: #if defined(ASCENDC_CPU_DEBUG) && ASCENDC_CPU_DEBUG == 1
320:     ASCENDC_ASSERT((len <= currentPoolSize),
321:                    { KERNEL_LOG(KERNEL_ERROR, "len is %u, exceed limits %u", len, currentPoolSize); });
322:     auto absAddr = GetBaseAddr(static_cast<int8_t>(pos));
323:     AscendCBufInit(static_cast<uint8_t>(pos), 1, 1, reinterpret_cast<uint64_t>(curPoolAddr + absAddr), len);
324: #endif
325:     for (uint8_t i = 0; i < bufHandleSize; i++, ptr++) {
326:         ptr->state = TBufState::FREE;
327:         ptr->enQueEvtID = INVALID_TEVENTID;
328:         ptr->freeBufEvtID = INVALID_TEVENTID;
329:         ptr->address = curPoolAddr;
330:         ptr->dataLen = len;
331:         ptr->usertag = -1;
332:         curPoolAddr += len;
