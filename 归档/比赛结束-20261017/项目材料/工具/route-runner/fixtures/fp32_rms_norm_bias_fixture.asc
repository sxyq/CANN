#include "kernel_operator.h"
#include "local_abi_shim.h"

#include <cmath>
#include <cstdint>

namespace {

constexpr int32_t kFp32 = 0;
constexpr uint32_t kTile = 256;

bool ReadShape(const TensorGroupInfo& group, int32_t dtype, int64_t& rows, int64_t& width)
{
    if (group.tensors == nullptr || group.numTensors != 1) return false;
    const TensorInfo& info = group.tensors[0];
    if (info.shape == nullptr || info.numDims != 2 || info.dtype != dtype) return false;
    rows = info.shape[0];
    width = info.shape[1];
    return rows > 0 && width > 0 && width % 8 == 0;
}

bool ReadVector(const TensorGroupInfo& group, int32_t dtype, int64_t width)
{
    if (group.tensors == nullptr || group.numTensors != 1) return false;
    const TensorInfo& info = group.tensors[0];
    return info.shape != nullptr && info.numDims == 1 && info.shape[0] == width && info.dtype == dtype;
}

bool SameShape(const TensorGroupInfo& lhs, const TensorGroupInfo& rhs)
{
    if (lhs.tensors == nullptr || rhs.tensors == nullptr || lhs.numTensors != 1 || rhs.numTensors != 1) return false;
    const TensorInfo& a = lhs.tensors[0];
    const TensorInfo& b = rhs.tensors[0];
    if (a.shape == nullptr || b.shape == nullptr || a.numDims != b.numDims || a.dtype != b.dtype) return false;
    for (int64_t i = 0; i < a.numDims; ++i) {
        if (a.shape[i] != b.shape[i]) return false;
    }
    return true;
}

class FixtureKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias,
                                GM_ADDR output, int64_t rows, int64_t width, float epsilon)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x));
        residual_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(residual));
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(gamma));
        bias_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bias));
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
        rows_ = rows;
        width_ = width;
        epsilon_ = epsilon;
        pipe_.InitBuffer(xQueue_, 1, kTile * sizeof(float));
        pipe_.InitBuffer(residualQueue_, 1, kTile * sizeof(float));
        pipe_.InitBuffer(gammaQueue_, 1, kTile * sizeof(float));
        pipe_.InitBuffer(biasQueue_, 1, kTile * sizeof(float));
        pipe_.InitBuffer(outputQueue_, 1, kTile * sizeof(float));
        pipe_.InitBuffer(scalar_, 2 * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        const int64_t row = AscendC::GetBlockIdx();
        const int64_t stride = AscendC::GetBlockNum();
        for (int64_t r = row; r < rows_; r += stride) {
            float squareSum = 0.0f;
            for (int64_t start = 0; start < width_; start += kTile) {
                const uint32_t count = static_cast<uint32_t>(width_ - start < kTile ? width_ - start : kTile);
                auto x = Load(xQueue_, x_[r * width_ + start], count);
                auto residual = Load(residualQueue_, residual_[r * width_ + start], count);
                for (uint32_t i = 0; i < count; ++i) {
                    const float value = x.GetValue(i) + residual.GetValue(i);
                    squareSum += value * value;
                }
                xQueue_.FreeTensor(x);
                residualQueue_.FreeTensor(residual);
            }

            auto rmsInput = scalar_.Get<float>();
            auto rmsOutput = scalar_.Get<float>();
            rmsInput.SetValue(0, squareSum / static_cast<float>(width_) + epsilon_);
            AscendC::Sqrt(rmsOutput, rmsInput, 1);
            const float invRms = 1.0f / rmsOutput.GetValue(0);

            for (int64_t start = 0; start < width_; start += kTile) {
                const uint32_t count = static_cast<uint32_t>(width_ - start < kTile ? width_ - start : kTile);
                auto x = Load(xQueue_, x_[r * width_ + start], count);
                auto residual = Load(residualQueue_, residual_[r * width_ + start], count);
                auto gamma = Load(gammaQueue_, gamma_[start], count);
                auto bias = Load(biasQueue_, bias_[start], count);
                auto output = outputQueue_.AllocTensor<float>();
                for (uint32_t i = 0; i < count; ++i) {
                    const float value = (x.GetValue(i) + residual.GetValue(i)) * invRms *
                                        gamma.GetValue(i) + bias.GetValue(i);
                    output.SetValue(i, value);
                }
                outputQueue_.EnQue(output);
                auto ready = outputQueue_.DeQue<float>();
                AscendC::DataCopyPad(output_[r * width_ + start], ready,
                    {1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0});
                outputQueue_.FreeTensor(ready);
                xQueue_.FreeTensor(x);
                residualQueue_.FreeTensor(residual);
                gammaQueue_.FreeTensor(gamma);
                biasQueue_.FreeTensor(bias);
            }
        }
    }

private:
    __aicore__ inline AscendC::LocalTensor<float> Load(
        AscendC::TQue<AscendC::TPosition::VECIN, 1>& queue,
        AscendC::GlobalTensor<float> source, uint32_t count)
    {
        auto value = queue.AllocTensor<float>();
        AscendC::DataCopyPad(value, source,
            {1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0},
            {false, 0, 0, 0.0f});
        queue.EnQue(value);
        return queue.DeQue<float>();
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_, residualQueue_, gammaQueue_, biasQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scalar_;
    AscendC::GlobalTensor<float> x_, residual_, gamma_, bias_, output_;
    int64_t rows_;
    int64_t width_;
    float epsilon_;
};

__aicore__ inline void RunFixture(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias,
                                  GM_ADDR output, int64_t rows, int64_t width, float epsilon)
{
    FixtureKernel kernel;
    kernel.Init(x, residual, gamma, bias, output, rows, width, epsilon);
    kernel.Process();
}

}  // namespace

extern "C" __global__ __vector__ void tooling_fixture_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t width, float epsilon)
{
    RunFixture(x, residual, gamma, bias, output, rows, width, epsilon);
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    int64_t rows = 0;
    int64_t width = 0;
    if (availableCoreNum <= 0 || !std::isfinite(epsilon) || epsilon < 0.0f ||
        !ReadShape(info_x, kFp32, rows, width) || !SameShape(info_x, info_residual) ||
        !SameShape(info_x, info_output) || !ReadVector(info_gamma, kFp32, width) ||
        !ReadVector(info_bias, kFp32, width)) return;
    const uint32_t blocks = static_cast<uint32_t>(rows < availableCoreNum ? rows : availableCoreNum);
    tooling_fixture_kernel<<<blocks, nullptr, stream>>>(x, residual, gamma, bias, output, rows, width, epsilon);
}
