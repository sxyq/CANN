#include <cstdint>
#include <cstdio>
#include "local_types.h"
#include "../submission.asc"

int main()
{
    int64_t shape[2] = {2, 64};
    TensorInfo tx{shape, 2, 0};
    TensorInfo tr{shape, 2, 0};
    TensorInfo tg{shape + 1, 1, 0};
    TensorInfo tb{shape + 1, 1, 0};
    TensorInfo to{shape, 2, 0};
    TensorGroupInfo gx{&tx, 1};
    TensorGroupInfo gr{&tr, 1};
    TensorGroupInfo gg{&tg, 1};
    TensorGroupInfo gb{&tb, 1};
    TensorGroupInfo go{&to, 1};
    run_kernel(nullptr, gx, nullptr, gr, nullptr, gg, nullptr, gb, nullptr, go,
               1, nullptr, 1.0e-5f);
    std::puts("DTYPE-LOWP-FASTPATH-X V001 full-link smoke");
    return 0;
}
