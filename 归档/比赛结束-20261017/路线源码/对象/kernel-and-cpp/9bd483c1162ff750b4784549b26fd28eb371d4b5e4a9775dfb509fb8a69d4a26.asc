#include <acl/acl.h>
#include <algorithm>
#include <cerrno>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <iomanip>
#include <limits>
#include <string>
#include <sys/stat.h>
#include <vector>

#include "local_types.h"
#include "kernel_operator.h"

namespace mix_a_v003 {
#define run_kernel run_kernel_v003
#include "MIX-A-V003-submission.asc"
#undef run_kernel
}

namespace mix_a_v007 {
#define run_kernel run_kernel_v007
#include "MIX-A-V007-submission.asc"
#undef run_kernel
}

namespace {
constexpr float kEpsilon = 1.0e-5f;
constexpr int kMinWarmups = 10;
constexpr int kMinSamples = 21;

enum class Variant { V003, V007 };

using KernelFn = void (*)(
    GM_ADDR, const TensorGroupInfo&, GM_ADDR, const TensorGroupInfo&,
    GM_ADDR, const TensorGroupInfo&, GM_ADDR, const TensorGroupInfo&,
    GM_ADDR, const TensorGroupInfo&, int64_t, aclrtStream, float);

KernelFn KernelFor(Variant variant)
{
    return variant == Variant::V003 ? mix_a_v003::run_kernel_v003 : mix_a_v007::run_kernel_v007;
}

const char* VariantName(Variant variant)
{
    return variant == Variant::V003 ? "V003" : "V007";
}

bool ParseInt(const char* text, int64_t* value)
{
    errno = 0;
    char* end = nullptr;
    const long long parsed = std::strtoll(text, &end, 10);
    if (errno != 0 || end == text || *end != '\0') {
        return false;
    }
    *value = static_cast<int64_t>(parsed);
    return true;
}

float InputValue(int64_t index, int multiplier, int offset)
{
    return static_cast<float>((index * multiplier + offset) % 997) / 498.0f - 1.0f;
}

uint16_t FloatToHalfBits(float value)
{
    const aclFloat16 halfValue = aclFloatToFloat16(value);
    uint16_t bits = 0;
    std::memcpy(&bits, &halfValue, sizeof(bits));
    return bits;
}

float HalfBitsToFloat(uint16_t bits)
{
    aclFloat16 halfValue;
    std::memcpy(&halfValue, &bits, sizeof(bits));
    return aclFloat16ToFloat(halfValue);
}

uint16_t FloatToBf16Bits(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    bits += 0x7fffU + ((bits >> 16) & 1U);
    return static_cast<uint16_t>(bits >> 16);
}

float Bf16BitsToFloat(uint16_t bits)
{
    const uint32_t wide = static_cast<uint32_t>(bits) << 16;
    float value = 0.0f;
    std::memcpy(&value, &wide, sizeof(value));
    return value;
}

void StoreValue(std::vector<uint8_t>& data, size_t index, int dtype, float value)
{
    if (dtype == 0) {
        std::memcpy(data.data() + index * sizeof(float), &value, sizeof(value));
        return;
    }
    const uint16_t bits = dtype == 1 ? FloatToHalfBits(value) : FloatToBf16Bits(value);
    std::memcpy(data.data() + index * sizeof(bits), &bits, sizeof(bits));
}

float LoadValue(const std::vector<uint8_t>& data, size_t index, int dtype)
{
    if (dtype == 0) {
        float value = 0.0f;
        std::memcpy(&value, data.data() + index * sizeof(value), sizeof(value));
        return value;
    }
    uint16_t bits = 0;
    std::memcpy(&bits, data.data() + index * sizeof(bits), sizeof(bits));
    return dtype == 1 ? HalfBitsToFloat(bits) : Bf16BitsToFloat(bits);
}

bool PathExists(const std::string& path)
{
    struct stat info {};
    return ::stat(path.c_str(), &info) == 0;
}

bool CheckAcl(aclError result, const char* expression, int line)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL failure %s=%d at line %d\n", expression, result, line);
    return false;
}

#define ACL_RUN(expression) \
    do { \
        if (!CheckAcl((expression), #expression, __LINE__)) return false; \
    } while (0)

struct Sample {
    int index;
    int pair;
    Variant variant;
    const char* order;
    double deviceUs;
    double wallUs;
};

struct SeriesStats {
    double median;
    double mean;
    double stdev;
    double cv;
    double min;
    double max;
    double maxMin;
    double mad;
    double p10;
    double p90;
    double spread;
};

double MedianSorted(const std::vector<double>& sorted)
{
    const size_t middle = sorted.size() / 2;
    if (sorted.size() % 2 != 0) {
        return sorted[middle];
    }
    return (sorted[middle - 1] + sorted[middle]) * 0.5;
}

double PercentileSorted(const std::vector<double>& sorted, double fraction)
{
    const double position = fraction * static_cast<double>(sorted.size() - 1);
    const size_t lower = static_cast<size_t>(position);
    const size_t upper = std::min(lower + 1, sorted.size() - 1);
    const double weight = position - static_cast<double>(lower);
    return sorted[lower] * (1.0 - weight) + sorted[upper] * weight;
}

SeriesStats Summarize(const std::vector<double>& values)
{
    std::vector<double> sorted = values;
    std::sort(sorted.begin(), sorted.end());
    double sum = 0.0;
    for (double value : values) {
        sum += value;
    }
    const double mean = sum / static_cast<double>(values.size());
    double squares = 0.0;
    for (double value : values) {
        const double delta = value - mean;
        squares += delta * delta;
    }
    const double stdev = std::sqrt(squares / static_cast<double>(values.size() - 1));
    std::vector<double> deviations;
    deviations.reserve(values.size());
    const double median = MedianSorted(sorted);
    for (double value : values) {
        deviations.push_back(std::fabs(value - median));
    }
    std::sort(deviations.begin(), deviations.end());
    return {
        median,
        mean,
        stdev,
        mean == 0.0 ? 0.0 : stdev / std::fabs(mean),
        sorted.front(),
        sorted.back(),
        sorted.front() == 0.0 ? 0.0 : sorted.back() / sorted.front(),
        MedianSorted(deviations),
        PercentileSorted(sorted, 0.10),
        PercentileSorted(sorted, 0.90),
        sorted.back() - sorted.front()
    };
}

void WriteStats(std::ofstream& out, const char* variant, const char* metric,
                const std::vector<double>& values)
{
    const SeriesStats stats = Summarize(values);
    out << variant << '\t' << metric << '\t' << values.size() << '\t'
        << stats.median << '\t' << stats.mean << '\t' << stats.stdev << '\t' << stats.cv << '\t'
        << stats.min << '\t' << stats.max << '\t' << stats.maxMin << '\t'
        << stats.mad << '\t' << stats.p10 << '\t' << stats.p90 << '\t'
        << stats.spread << '\n';
}

class Probe {
public:
    Probe(int64_t rows, int64_t width, int dtype)
        : rows_(rows), width_(width), dtype_(dtype), elements_(static_cast<size_t>(rows * width)),
          dataBytes_(elements_ * (dtype == 0 ? sizeof(float) : sizeof(uint16_t))),
          paramBytes_(static_cast<size_t>(width) * (dtype == 0 ? sizeof(float) : sizeof(uint16_t)))
    {
        hostX_.resize(dataBytes_);
        hostResidual_.resize(dataBytes_);
        hostGamma_.resize(paramBytes_);
        hostBias_.resize(paramBytes_);
        hostOutputV003_.resize(dataBytes_);
        hostOutputV007_.resize(dataBytes_);
        decodedV003_.resize(elements_);
        decodedV007_.resize(elements_);
        xyShape_[0] = rows_;
        xyShape_[1] = width_;
        paramShape_[0] = width_;
        xTensor_[0] = {xyShape_, 2, dtype_};
        residualTensor_[0] = {xyShape_, 2, dtype_};
        gammaTensor_[0] = {paramShape_, 1, dtype_};
        biasTensor_[0] = {paramShape_, 1, dtype_};
        outputTensor_[0] = {xyShape_, 2, dtype_};
        infoX_ = {xTensor_, 1};
        infoResidual_ = {residualTensor_, 1};
        infoGamma_ = {gammaTensor_, 1};
        infoBias_ = {biasTensor_, 1};
        infoOutput_ = {outputTensor_, 1};
    }

    ~Probe()
    {
        if (startEvent_ != nullptr) aclrtDestroyEvent(startEvent_);
        if (stopEvent_ != nullptr) aclrtDestroyEvent(stopEvent_);
        if (deviceX_ != nullptr) aclrtFree(deviceX_);
        if (deviceResidual_ != nullptr) aclrtFree(deviceResidual_);
        if (deviceGamma_ != nullptr) aclrtFree(deviceGamma_);
        if (deviceBias_ != nullptr) aclrtFree(deviceBias_);
        if (deviceOutputV003_ != nullptr) aclrtFree(deviceOutputV003_);
        if (deviceOutputV007_ != nullptr) aclrtFree(deviceOutputV007_);
        if (stream_ != nullptr) aclrtDestroyStream(stream_);
        if (initialized_) aclFinalize();
    }

    bool Initialize(int deviceId)
    {
        for (size_t i = 0; i < elements_; ++i) {
            StoreValue(hostX_, i, dtype_, InputValue(static_cast<int64_t>(i), 37, 11));
            StoreValue(hostResidual_, i, dtype_, InputValue(static_cast<int64_t>(i), 17, 3));
        }
        for (int64_t i = 0; i < width_; ++i) {
            StoreValue(hostGamma_, static_cast<size_t>(i), dtype_,
                       0.75f + static_cast<float>((i * 13) % 100) / 200.0f);
            StoreValue(hostBias_, static_cast<size_t>(i), dtype_,
                       static_cast<float>((i * 7) % 100) / 400.0f - 0.125f);
        }

        ACL_RUN(aclInit(nullptr));
        initialized_ = true;
        ACL_RUN(aclrtSetDevice(deviceId));
        ACL_RUN(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum_));
        ACL_RUN(aclrtCreateStream(&stream_));
        ACL_RUN(aclrtMalloc(&deviceX_, dataBytes_, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_RUN(aclrtMalloc(&deviceResidual_, dataBytes_, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_RUN(aclrtMalloc(&deviceGamma_, paramBytes_, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_RUN(aclrtMalloc(&deviceBias_, paramBytes_, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_RUN(aclrtMalloc(&deviceOutputV003_, dataBytes_, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_RUN(aclrtMalloc(&deviceOutputV007_, dataBytes_, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_RUN(aclrtMemcpy(deviceX_, dataBytes_, hostX_.data(), dataBytes_, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_RUN(aclrtMemcpy(deviceResidual_, dataBytes_, hostResidual_.data(), dataBytes_, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_RUN(aclrtMemcpy(deviceGamma_, paramBytes_, hostGamma_.data(), paramBytes_, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_RUN(aclrtMemcpy(deviceBias_, paramBytes_, hostBias_.data(), paramBytes_, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_RUN(aclrtSynchronizeStream(stream_));
        ACL_RUN(aclrtCreateEvent(&startEvent_));
        ACL_RUN(aclrtCreateEvent(&stopEvent_));
        return true;
    }

    bool Warmup(Variant variant)
    {
        Launch(variant);
        return CheckAcl(aclrtSynchronizeStream(stream_), "aclrtSynchronizeStream(warmup)", __LINE__);
    }

    bool Measure(Variant variant, int index, int pair, const char* order, Sample* sample)
    {
        float elapsedMs = 0.0f;
        if (eventUsed_) {
            if (!CheckAcl(aclrtResetEvent(startEvent_, stream_), "aclrtResetEvent(start)", __LINE__)) return false;
            if (!CheckAcl(aclrtResetEvent(stopEvent_, stream_), "aclrtResetEvent(stop)", __LINE__)) return false;
        }
        const auto wallStart = std::chrono::steady_clock::now();
        if (!CheckAcl(aclrtRecordEvent(startEvent_, stream_), "aclrtRecordEvent(start)", __LINE__)) return false;
        Launch(variant);
        if (!CheckAcl(aclrtRecordEvent(stopEvent_, stream_), "aclrtRecordEvent(stop)", __LINE__)) return false;
        if (!CheckAcl(aclrtSynchronizeEvent(stopEvent_), "aclrtSynchronizeEvent(stop)", __LINE__)) return false;
        const auto wallStop = std::chrono::steady_clock::now();
        if (!CheckAcl(aclrtEventElapsedTime(&elapsedMs, startEvent_, stopEvent_),
                      "aclrtEventElapsedTime", __LINE__)) return false;
        sample->index = index;
        sample->pair = pair;
        sample->variant = variant;
        sample->order = order;
        sample->deviceUs = static_cast<double>(elapsedMs) * 1000.0;
        sample->wallUs = std::chrono::duration<double, std::micro>(wallStop - wallStart).count();
        eventUsed_ = true;
        return std::isfinite(sample->deviceUs) && sample->deviceUs > 0.0 &&
               std::isfinite(sample->wallUs) && sample->wallUs > 0.0;
    }

    bool ReadOutputs(bool paired, Variant variant)
    {
        ACL_RUN(aclrtSynchronizeStream(stream_));
        if (paired || variant == Variant::V003) {
            ACL_RUN(aclrtMemcpy(hostOutputV003_.data(), dataBytes_, deviceOutputV003_, dataBytes_, ACL_MEMCPY_DEVICE_TO_HOST));
        }
        if (paired || variant == Variant::V007) {
            ACL_RUN(aclrtMemcpy(hostOutputV007_.data(), dataBytes_, deviceOutputV007_, dataBytes_, ACL_MEMCPY_DEVICE_TO_HOST));
        }
        return true;
    }

    bool Verify(Variant variant, float* maxAbs, int* bad)
    {
        const std::vector<uint8_t>& output = variant == Variant::V003 ? hostOutputV003_ : hostOutputV007_;
        std::vector<float>& decoded = variant == Variant::V003 ? decodedV003_ : decodedV007_;
        *maxAbs = 0.0f;
        *bad = 0;
        for (int64_t row = 0; row < rows_; ++row) {
            float sum = 0.0f;
            for (int64_t col = 0; col < width_; ++col) {
                const size_t i = static_cast<size_t>(row * width_ + col);
                float value = LoadValue(hostX_, i, dtype_) + LoadValue(hostResidual_, i, dtype_);
                if (dtype_ == 1) value = HalfBitsToFloat(FloatToHalfBits(value));
                sum += value * value;
            }
            const float invRms = 1.0f / std::sqrt(sum / static_cast<float>(width_) + kEpsilon);
            for (int64_t col = 0; col < width_; ++col) {
                const size_t i = static_cast<size_t>(row * width_ + col);
                float value = LoadValue(hostX_, i, dtype_) + LoadValue(hostResidual_, i, dtype_);
                if (dtype_ == 1) value = HalfBitsToFloat(FloatToHalfBits(value));
                float expected = value * invRms * LoadValue(hostGamma_, static_cast<size_t>(col), dtype_) +
                                 LoadValue(hostBias_, static_cast<size_t>(col), dtype_);
                if (dtype_ == 1) {
                    expected = HalfBitsToFloat(FloatToHalfBits(
                        HalfBitsToFloat(FloatToHalfBits(value * invRms)) *
                        LoadValue(hostGamma_, static_cast<size_t>(col), dtype_)));
                    expected = HalfBitsToFloat(FloatToHalfBits(
                        expected + LoadValue(hostBias_, static_cast<size_t>(col), dtype_)));
                } else if (dtype_ == 2) {
                    expected = Bf16BitsToFloat(FloatToBf16Bits(expected));
                }
                const float actual = LoadValue(output, i, dtype_);
                decoded[i] = actual;
                const float error = std::fabs(actual - expected);
                *maxAbs = std::max(*maxAbs, error);
                const float tolerance = dtype_ == 0 ? 1.0e-4f : (dtype_ == 1 ? 1.0e-3f : 2.0e-2f);
                if (!std::isfinite(actual) || error > tolerance + tolerance * std::fabs(expected)) ++*bad;
            }
        }
        return true;
    }

    double PairMaxAbs() const
    {
        double maxAbs = 0.0;
        for (size_t i = 0; i < elements_; ++i) {
            maxAbs = std::max(maxAbs, std::fabs(static_cast<double>(decodedV003_[i]) - decodedV007_[i]));
        }
        return maxAbs;
    }

    int PairDifferentCount() const
    {
        int count = 0;
        for (size_t i = 0; i < elements_; ++i) {
            if (decodedV003_[i] != decodedV007_[i]) ++count;
        }
        return count;
    }

    bool WriteOutput(Variant variant, const std::string& path)
    {
        const std::vector<float>& decoded = variant == Variant::V003 ? decodedV003_ : decodedV007_;
        std::ofstream output(path, std::ios::binary | std::ios::trunc);
        output.write(reinterpret_cast<const char*>(decoded.data()),
                     static_cast<std::streamsize>(decoded.size() * sizeof(float)));
        return output.good();
    }

private:
    void Launch(Variant variant)
    {
        GM_ADDR output = (GM_ADDR)(variant == Variant::V003 ? deviceOutputV003_ : deviceOutputV007_);
        KernelFor(variant)((GM_ADDR)deviceX_, infoX_,
                           (GM_ADDR)deviceResidual_, infoResidual_,
                           (GM_ADDR)deviceGamma_, infoGamma_,
                           (GM_ADDR)deviceBias_, infoBias_, output, infoOutput_,
                           availableCoreNum_, stream_, kEpsilon);
    }

    int64_t rows_;
    int64_t width_;
    int dtype_;
    size_t elements_;
    size_t dataBytes_;
    size_t paramBytes_;
    bool initialized_ = false;
    int64_t availableCoreNum_ = 0;
    aclrtStream stream_ = nullptr;
    aclrtEvent startEvent_ = nullptr;
    aclrtEvent stopEvent_ = nullptr;
    bool eventUsed_ = false;
    void* deviceX_ = nullptr;
    void* deviceResidual_ = nullptr;
    void* deviceGamma_ = nullptr;
    void* deviceBias_ = nullptr;
    void* deviceOutputV003_ = nullptr;
    void* deviceOutputV007_ = nullptr;
    int64_t xyShape_[2]{};
    int64_t paramShape_[1]{};
    TensorInfo xTensor_[1]{};
    TensorInfo residualTensor_[1]{};
    TensorInfo gammaTensor_[1]{};
    TensorInfo biasTensor_[1]{};
    TensorInfo outputTensor_[1]{};
    TensorGroupInfo infoX_{};
    TensorGroupInfo infoResidual_{};
    TensorGroupInfo infoGamma_{};
    TensorGroupInfo infoBias_{};
    TensorGroupInfo infoOutput_{};
    std::vector<uint8_t> hostX_;
    std::vector<uint8_t> hostResidual_;
    std::vector<uint8_t> hostGamma_;
    std::vector<uint8_t> hostBias_;
    std::vector<uint8_t> hostOutputV003_;
    std::vector<uint8_t> hostOutputV007_;
    std::vector<float> decodedV003_;
    std::vector<float> decodedV007_;
};

bool CheckOutputPaths(const std::string& prefix, bool paired)
{
    std::vector<std::string> paths = {prefix + ".samples.tsv", prefix + ".summary.tsv"};
    if (paired) {
        paths.push_back(prefix + ".v003-output.bin");
        paths.push_back(prefix + ".v007-output.bin");
    } else {
        paths.push_back(prefix + ".output.bin");
    }
    for (const std::string& path : paths) {
        if (PathExists(path)) {
            std::fprintf(stderr, "refusing to overwrite %s\n", path.c_str());
            return false;
        }
    }
    return true;
}

bool WriteSampleFiles(const std::string& prefix, const std::vector<Sample>& samples,
                      bool paired, Variant noiseVariant, int deviceId,
                      int64_t rows, int64_t width, int dtype, int warmups)
{
    std::ofstream sampleOut(prefix + ".samples.tsv", std::ios::out | std::ios::trunc);
    std::ofstream summaryOut(prefix + ".summary.tsv", std::ios::out | std::ios::trunc);
    if (!sampleOut || !summaryOut) {
        std::fprintf(stderr, "cannot create output files for %s\n", prefix.c_str());
        return false;
    }
    sampleOut << std::setprecision(10);
    summaryOut << std::setprecision(10);
    sampleOut << "# device=" << deviceId << " rows=" << rows << " width=" << width
              << " dtype=" << dtype << " warmups_per_variant=" << warmups << '\n'
              << "sample\tpair\torder\tvariant\tdevice_us\twall_us\n";
    std::vector<double> v003Device, v003Wall, v007Device, v007Wall;
    v003Device.reserve(samples.size());
    v003Wall.reserve(samples.size());
    v007Device.reserve(samples.size());
    v007Wall.reserve(samples.size());
    for (const Sample& sample : samples) {
        sampleOut << sample.index << '\t' << sample.pair << '\t' << sample.order << '\t'
                  << VariantName(sample.variant) << '\t' << sample.deviceUs << '\t'
                  << sample.wallUs << '\n';
        std::vector<double>& device = sample.variant == Variant::V003 ? v003Device : v007Device;
        std::vector<double>& wall = sample.variant == Variant::V003 ? v003Wall : v007Wall;
        device.push_back(sample.deviceUs);
        wall.push_back(sample.wallUs);
    }
    sampleOut.flush();
    if (!sampleOut.good()) return false;

    summaryOut << "# device=" << deviceId << " rows=" << rows << " width=" << width
               << " dtype=" << dtype << " warmups_per_variant=" << warmups << '\n'
               << "variant\tmetric\tcount\tmedian\tmean\tstdev\tcv\tmin\tmax\tmax_min\tmad\tp10\tp90\tabs_spread\n";
    if (paired) {
        WriteStats(summaryOut, "V003", "device_us", v003Device);
        WriteStats(summaryOut, "V003", "wall_us", v003Wall);
        WriteStats(summaryOut, "V007", "device_us", v007Device);
        WriteStats(summaryOut, "V007", "wall_us", v007Wall);
    } else {
        const std::vector<double>& device = noiseVariant == Variant::V003 ? v003Device : v007Device;
        const std::vector<double>& wall = noiseVariant == Variant::V003 ? v003Wall : v007Wall;
        WriteStats(summaryOut, VariantName(noiseVariant), "device_us", device);
        WriteStats(summaryOut, VariantName(noiseVariant), "wall_us", wall);
    }
    summaryOut.flush();
    return summaryOut.good();
}

void PrintUsage(const char* program)
{
    std::fprintf(stderr,
        "Usage:\n"
        "  %s noise-floor <v003|v007> <device> <rows> <width> <dtype> <prefix> [warmups=10] [samples=31]\n"
        "  %s paired <device> <rows> <width> <dtype> <prefix> [warmups=10] [pairs=21]\n"
        "dtype: 0=FP32, 1=FP16, 2=BF16; event duration is primary, wall duration is diagnostic.\n",
        program, program);
}

bool ParseShape(int64_t device, int64_t rows, int64_t width, int64_t dtype,
                int64_t warmups, int64_t samples)
{
    if (device < 0 || rows < 1 || width < 129 || width > 4096 || dtype < 0 || dtype > 2 ||
        warmups < kMinWarmups || samples < kMinSamples ||
        rows > std::numeric_limits<int64_t>::max() / width) {
        return false;
    }
    const size_t elementBytes = dtype == 0 ? sizeof(float) : sizeof(uint16_t);
    const size_t elements = static_cast<size_t>(rows) * static_cast<size_t>(width);
    return elements <= std::numeric_limits<size_t>::max() / elementBytes;
}

bool ParseVariant(const char* text, Variant* variant)
{
    if (std::strcmp(text, "v003") == 0) {
        *variant = Variant::V003;
        return true;
    }
    if (std::strcmp(text, "v007") == 0) {
        *variant = Variant::V007;
        return true;
    }
    return false;
}

int RunNoiseFloor(int argc, char** argv)
{
    if (argc < 8 || argc > 10) return 2;
    Variant variant;
    int64_t device, rows, width, dtype, warmups = 10, samplesCount = 31;
    if (!ParseVariant(argv[2], &variant) || !ParseInt(argv[3], &device) ||
        !ParseInt(argv[4], &rows) || !ParseInt(argv[5], &width) ||
        !ParseInt(argv[6], &dtype) || (argc >= 9 && !ParseInt(argv[8], &warmups)) ||
        (argc >= 10 && !ParseInt(argv[9], &samplesCount)) ||
        !ParseShape(device, rows, width, dtype, warmups, samplesCount) ||
        warmups > std::numeric_limits<int>::max() ||
        samplesCount > std::numeric_limits<int>::max()) {
        return 2;
    }
    const std::string prefix = argv[7];
    if (prefix.empty()) return 2;
    if (!CheckOutputPaths(prefix, false)) return 2;

    Probe probe(rows, width, static_cast<int>(dtype));
    if (!probe.Initialize(static_cast<int>(device))) return 1;
    for (int64_t i = 0; i < warmups; ++i) {
        if (!probe.Warmup(variant)) return 1;
    }

    std::vector<Sample> samples;
    samples.reserve(static_cast<size_t>(samplesCount));
    for (int64_t i = 0; i < samplesCount; ++i) {
        Sample sample{};
        if (!probe.Measure(variant, static_cast<int>(i + 1), 0, "SAME", &sample)) return 1;
        samples.push_back(sample);
    }
    if (!probe.ReadOutputs(false, variant)) return 1;
    float v003MaxAbs = 0.0f, v007MaxAbs = 0.0f;
    int v003Bad = 0, v007Bad = 0;
    if (!probe.Verify(variant, variant == Variant::V003 ? &v003MaxAbs : &v007MaxAbs,
                      variant == Variant::V003 ? &v003Bad : &v007Bad)) return 1;
    if (!probe.WriteOutput(variant, prefix + ".output.bin")) return 1;
    if (!WriteSampleFiles(prefix, samples, false, variant, static_cast<int>(device), rows, width,
                          static_cast<int>(dtype), static_cast<int>(warmups))) return 1;
    std::printf("mode=noise-floor variant=%s device=%lld rows=%lld width=%lld dtype=%lld warmups=%lld samples=%lld correctness_bad=%d\n",
                VariantName(variant), static_cast<long long>(device), static_cast<long long>(rows),
                static_cast<long long>(width), static_cast<long long>(dtype),
                static_cast<long long>(warmups), static_cast<long long>(samplesCount),
                variant == Variant::V003 ? v003Bad : v007Bad);
    return variant == Variant::V003 ? (v003Bad == 0 ? 0 : 3) : (v007Bad == 0 ? 0 : 3);
}

int RunPaired(int argc, char** argv)
{
    if (argc < 7 || argc > 9) return 2;
    int64_t device, rows, width, dtype, warmups = 10, pairs = 21;
    if (!ParseInt(argv[2], &device) || !ParseInt(argv[3], &rows) ||
        !ParseInt(argv[4], &width) || !ParseInt(argv[5], &dtype) ||
        (argc >= 8 && !ParseInt(argv[7], &warmups)) ||
        (argc >= 9 && !ParseInt(argv[8], &pairs)) ||
        !ParseShape(device, rows, width, dtype, warmups, pairs) ||
        warmups > std::numeric_limits<int>::max() ||
        pairs > std::numeric_limits<int>::max() / 2) {
        return 2;
    }
    const std::string prefix = argv[6];
    if (prefix.empty()) return 2;
    if (!CheckOutputPaths(prefix, true)) return 2;

    Probe probe(rows, width, static_cast<int>(dtype));
    if (!probe.Initialize(static_cast<int>(device))) return 1;
    for (int64_t i = 0; i < warmups; ++i) {
        const Variant first = i % 2 == 0 ? Variant::V003 : Variant::V007;
        const Variant second = first == Variant::V003 ? Variant::V007 : Variant::V003;
        if (!probe.Warmup(first) || !probe.Warmup(second)) return 1;
    }

    std::vector<Sample> samples;
    samples.reserve(static_cast<size_t>(pairs) * 2);
    int v003Index = 0, v007Index = 0;
    for (int64_t pair = 1; pair <= pairs; ++pair) {
        const Variant first = pair % 2 == 1 ? Variant::V003 : Variant::V007;
        const Variant second = first == Variant::V003 ? Variant::V007 : Variant::V003;
        const char* order = first == Variant::V003 ? "V003_THEN_V007" : "V007_THEN_V003";
        for (Variant variant : {first, second}) {
            Sample sample{};
            const int index = variant == Variant::V003 ? ++v003Index : ++v007Index;
            if (!probe.Measure(variant, index, static_cast<int>(pair), order, &sample)) return 1;
            samples.push_back(sample);
        }
    }

    if (!probe.ReadOutputs(true, Variant::V003)) return 1;
    float v003MaxAbs = 0.0f, v007MaxAbs = 0.0f;
    int v003Bad = 0, v007Bad = 0;
    if (!probe.Verify(Variant::V003, &v003MaxAbs, &v003Bad) ||
        !probe.Verify(Variant::V007, &v007MaxAbs, &v007Bad)) return 1;
    const double pairMaxAbs = probe.PairMaxAbs();
    const int pairDifferentCount = probe.PairDifferentCount();
    if (!probe.WriteOutput(Variant::V003, prefix + ".v003-output.bin") ||
        !probe.WriteOutput(Variant::V007, prefix + ".v007-output.bin")) return 1;
    if (!WriteSampleFiles(prefix, samples, true, Variant::V003, static_cast<int>(device), rows, width,
                          static_cast<int>(dtype), static_cast<int>(warmups))) return 1;
    std::printf("mode=paired device=%lld rows=%lld width=%lld dtype=%lld warmups_per_variant=%lld pairs=%lld v003_bad=%d v007_bad=%d pair_max_abs=%.9g pair_different_elements=%d\n",
                static_cast<long long>(device), static_cast<long long>(rows), static_cast<long long>(width),
                static_cast<long long>(dtype), static_cast<long long>(warmups), static_cast<long long>(pairs),
                v003Bad, v007Bad, pairMaxAbs, pairDifferentCount);
    return v003Bad == 0 && v007Bad == 0 ? 0 : 3;
}
}

int main(int argc, char** argv)
{
    if (argc >= 2 && std::strcmp(argv[1], "noise-floor") == 0) {
        const int result = RunNoiseFloor(argc, argv);
        if (result == 2) PrintUsage(argv[0]);
        return result;
    }
    if (argc >= 2 && std::strcmp(argv[1], "paired") == 0) {
        const int result = RunPaired(argc, argv);
        if (result == 2) PrintUsage(argv[0]);
        return result;
    }
    PrintUsage(argv[0]);
    return argc == 2 && std::strcmp(argv[1], "--help") == 0 ? 0 : 2;
}
