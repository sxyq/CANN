#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
/*
 * R031-V001-FULL-MULTIMODE-REWRITE
 *
 * Clean-slate architecture reset.
 * This version does NOT inherit the previous R029/R016/R030 implementation.
 * It uses a multi-mode runtime dispatcher with separate small-row, wide-row,
 * dtype-specific cached-row, parameter-reuse, batching and pipelined paths.
 *
 * Purpose: test whether a large architectural reset can close the multi-x
 * gap to TBest that local branch tuning could not address.
 */

/*
 * AddRmsNormBias Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * The Host-side metadata is used only by run_kernel.  The device code receives
 * the flattened row count (M) and the last dimension (D), so rank 2/3/4 inputs
 * all use the same implementation.
 */

/*
 * Correctness-first implementation.
 *
 * A row is owned by exactly one vector core.  This keeps the RMS reduction
 * deterministic and avoids a workspace or cross-core synchronization.  All
 * arithmetic, including the reduction, is FP32; T is used only for GM loads
 * and the final store.  DataCopyPad transfers exactly the valid byte count,
 * so a tile at the end of a non-aligned row never reads into the next row.
 */
template <typename T>
class AddRmsNormBiasKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                GM_ADDR bias, GM_ADDR output, uint64_t rowWidth,
                                uint64_t rowCount, uint32_t blockCount)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        residualGm_.SetGlobalBuffer((__gm__ T *)residual);
        gammaGm_.SetGlobalBuffer((__gm__ T *)gamma);
        biasGm_.SetGlobalBuffer((__gm__ T *)bias);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);

        widePath_ = false;
        wideFp32BatchPath_ = false;
        wideFp32CachedRowPath_ = false;
        wideFp16CachedRowPath_ = false;
        wideBf16CachedRowPath_ = false;
        if (rowWidth > static_cast<uint64_t>(kCacheElems)) {
            widePath_ = true;
            pipe_.InitBuffer(reduceFp32Buf_, kWidePartialElems * sizeof(float));
            if constexpr (AscendC::IsSameType<T, float>::value) {
                // Once every core owns multiple rows, cache one 8192-channel
                // gamma/bias tile and consume it across a row batch.  The
                // smaller data tile leaves room for a second input/output
                // triplet, so MTE2/V/MTE3 can overlap adjacent rows.
                wideFp32BatchPath_ = rowCount / static_cast<uint64_t>(blockCount) >= 2;
                if (wideFp32BatchPath_) {
                    pipe_.InitBuffer(xBuf_, kWideFp32BatchTileElems * sizeof(float));
                    pipe_.InitBuffer(residualBuf_, kWideFp32BatchTileElems * sizeof(float));
                    pipe_.InitBuffer(valueFp32Buf_, kWideFp32BatchTileElems * sizeof(float));
                    pipe_.InitBuffer(gammaBuf_, kWideFp32BatchTileElems * sizeof(float));
                    pipe_.InitBuffer(biasBuf_, kWideFp32BatchTileElems * sizeof(float));
                    pipe_.InitBuffer(xFp32Buf_, kWideFp32BatchTileElems * sizeof(float));
                    pipe_.InitBuffer(residualFp32Buf_, kWideFp32BatchTileElems * sizeof(float));
                    pipe_.InitBuffer(outputBuf_, kWideFp32BatchTileElems * sizeof(float));
                } else if (rowWidth <= static_cast<uint64_t>(kWideFp32CachedRowMaxWidth)) {
                    // A core with fewer than two rows cannot reuse channel
                    // parameters. Keep its complete x + residual row instead
                    // and eliminate the second input read in the output pass.
                    wideFp32CachedRowPath_ = true;
                    pipe_.InitBuffer(xBuf_, kWideFp32CachedTileElems * sizeof(float));
                    pipe_.InitBuffer(residualBuf_, kWideFp32CachedTileElems * sizeof(float));
                    pipe_.InitBuffer(valueFp32Buf_, rowWidth * sizeof(float));
                } else {
                    // A single-row launch gains no parameter reuse, so use the
                    // larger streaming tile to minimize its loop overhead.
                    pipe_.InitBuffer(xBuf_, kWideFp32TileElems * sizeof(float));
                    pipe_.InitBuffer(residualBuf_, kWideFp32TileElems * sizeof(float));
                    pipe_.InitBuffer(valueFp32Buf_, kWideFp32TileElems * sizeof(float));
                }
            } else {
                if constexpr (std::is_same<T, half>::value) {
                    // With one row per core, retain the native FP16 sum and
                    // reuse x/residual storage for gamma/bias in pass two.
                    wideFp16CachedRowPath_ = rowCount <= static_cast<uint64_t>(blockCount);
                } else {
                    // BF16 keeps its first pass in FP32. A compact FP16 copy
                    // may still avoid the second pair of GM input reads when
                    // no cross-row parameter reuse is available.
                    wideBf16CachedRowPath_ = rowCount <= static_cast<uint64_t>(blockCount);
                }
                if (wideFp16CachedRowPath_ || wideBf16CachedRowPath_) {
                    pipe_.InitBuffer(xBuf_, kWideFp16CachedTileElems * sizeof(T));
                    pipe_.InitBuffer(residualBuf_, kWideFp16CachedTileElems * sizeof(T));
                    pipe_.InitBuffer(outputBuf_, rowWidth * sizeof(T));
                    pipe_.InitBuffer(valueFp32Buf_, kWideFp16CachedTileElems * sizeof(float));
                    pipe_.InitBuffer(xFp32Buf_, kWideFp16CachedTileElems * sizeof(float));
                    pipe_.InitBuffer(residualFp32Buf_, kWideFp16CachedTileElems * sizeof(float));
                } else {
                    pipe_.InitBuffer(xBuf_, kWideTileElems * sizeof(T));
                    pipe_.InitBuffer(residualBuf_, kWideTileElems * sizeof(T));
                    pipe_.InitBuffer(outputBuf_, kWideTileElems * sizeof(T));
                    // Wide low-precision rows process a small row batch in the
                    // output pass. These two tiles hold one channel block while
                    // every row in the batch consumes it.
                    pipe_.InitBuffer(gammaBuf_, kWideTileElems * sizeof(T));
                    pipe_.InitBuffer(biasBuf_, kWideTileElems * sizeof(T));
                    pipe_.InitBuffer(valueFp32Buf_, kWideTileElems * sizeof(float));
                    pipe_.InitBuffer(xFp32Buf_, kWideTileElems * sizeof(float));
                    pipe_.InitBuffer(residualFp32Buf_, kWideTileElems * sizeof(float));
                }
            }
            return;
        }

        pipe_.InitBuffer(xBuf_, kTileElems * sizeof(T));
        pipe_.InitBuffer(residualBuf_, kTileElems * sizeof(T));
        if constexpr (AscendC::IsSameType<T, float>::value) {
            // FP32 uses its original parameter type directly, so retain the
            // full channel vectors in UB for every row on this core.
            pipe_.InitBuffer(gammaBuf_, kCacheElems * sizeof(T));
            pipe_.InitBuffer(biasBuf_, kCacheElems * sizeof(T));
        } else if constexpr (std::is_same<T, half>::value) {
            // FP16 uses native channel multiplication/addition in the output
            // pass, so retain the original parameter vectors once per core.
            pipe_.InitBuffer(gammaBuf_, kCacheElems * sizeof(T));
            pipe_.InitBuffer(biasBuf_, kCacheElems * sizeof(T));
            const int32_t fp16OutputElems =
                (rowWidth == static_cast<uint64_t>(kTileElems) ||
                 rowWidth == static_cast<uint64_t>(kCacheElems))
                ? kCacheElems : kTileElems;
            pipe_.InitBuffer(outputBuf_, fp16OutputElems * sizeof(T));
        } else {
            // BF16 widens the channel parameters once into FP32.  Only one
            // 4096-element staging tile of each source type is needed;
            // gammaBuf_ is reused as the final output tile later.
            pipe_.InitBuffer(gammaBuf_, kTileElems * sizeof(T));
            pipe_.InitBuffer(biasBuf_, kTileElems * sizeof(T));
        }

        pipe_.InitBuffer(xFp32Buf_, kTileElems * sizeof(float));
        pipe_.InitBuffer(residualFp32Buf_, kTileElems * sizeof(float));
        // valueFp32Buf_ holds a cached x + residual row when D fits.  This
        // removes the second x/residual GM read without increasing the
        // working set of the wide-row fallback.
        pipe_.InitBuffer(valueFp32Buf_, kCacheElems * sizeof(float));
        // ReduceSum needs an independent FP32 work area.  One full tile is
        // sufficient for its intermediate reduction tree on this target.
        pipe_.InitBuffer(reduceFp32Buf_, kTileElems * sizeof(float));
        // BF16 channel parameters are reused for many rows.  Staging them a
        // tile at a time leaves enough UB for their full FP32 D=8192 copies,
        // eliminating repeated output-pass casts.
        if constexpr (!AscendC::IsSameType<T, float>::value && !std::is_same<T, half>::value) {
            pipe_.InitBuffer(gammaFp32Buf_, kCacheElems * sizeof(float));
            pipe_.InitBuffer(biasFp32Buf_, kCacheElems * sizeof(float));
        }
    }

    __aicore__ inline void Process(uint64_t rowCount, uint64_t rowWidth,
                                   uint32_t blockCount, float invRowWidth,
                                   float epsilon)
    {
        if (widePath_) {
            if constexpr (AscendC::IsSameType<T, float>::value) {
                ProcessWideFp32(rowCount, rowWidth, blockCount, invRowWidth, epsilon);
            } else {
                ProcessWideLowPrecision(rowCount, rowWidth, blockCount, invRowWidth, epsilon);
            }
            return;
        }
        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t baseRows = rowCount / blockCount;
        const uint64_t extraRows = rowCount % blockCount;
        const uint64_t beginRow = blockIdx * baseRows +
                                  (blockIdx < extraRows ? blockIdx : extraRows);
        const uint64_t localRows = baseRows + (blockIdx < extraRows ? 1 : 0);
        if constexpr (AscendC::IsSameType<T, float>::value) {
            if (rowWidth == static_cast<uint64_t>(kCacheElems) && localRows > 1) {
                ProcessFp32FullRowOutputPipelined(beginRow, localRows, invRowWidth, epsilon);
                return;
            }
            // For aligned small rows, x/residual for a short row group are
            // contiguous in GM.  One batch DMA and vector add/square remove
            // most of the per-row launch overhead before the independent
            // reductions below.
            if (rowWidth <= static_cast<uint64_t>(kSmallFp32ContiguousMaxWidth) &&
                (rowWidth % kSmallFp32ScalarStride) == 0 && localRows > 1) {
                ProcessSmallFp32ContiguousBatched(beginRow, localRows, rowWidth,
                                                   invRowWidth, epsilon);
                return;
            }
            // Small FP32 rows fit several complete y vectors in the existing
            // cache.  Process a short row batch so the V/S handoffs for the
            // RMS denominator are paid once per batch rather than per row.
            if (rowWidth <= static_cast<uint64_t>(kSmallFp32BatchMaxWidth) &&
                (rowWidth % kSmallFp32ScalarStride) == 0 && localRows > 1) {
                ProcessSmallFp32Batched(beginRow, localRows, rowWidth, invRowWidth, epsilon);
                return;
            }
        }
        if constexpr (std::is_same<T, half>::value) {
            if (rowWidth == static_cast<uint64_t>(kTileElems) && localRows > 1) {
                ProcessFp16FullTileBatchedOutputPipelined(beginRow, localRows,
                                                          invRowWidth, epsilon);
                return;
            }
            if (rowWidth == static_cast<uint64_t>(kCacheElems) && localRows > 1) {
                ProcessFp16FullRowOutputPipelined(beginRow, localRows, invRowWidth, epsilon);
                return;
            }
        }
        if constexpr (!AscendC::IsSameType<T, float>::value && !std::is_same<T, half>::value) {
            if (rowWidth == static_cast<uint64_t>(kTileElems) && localRows > 1) {
                ProcessBf16FullTileBatchedOutputPipelined(beginRow, localRows,
                                                          invRowWidth, epsilon);
                return;
            }
            if (rowWidth == static_cast<uint64_t>(kCacheElems) && localRows > 1) {
                ProcessBf16FullRowOutputPipelined(beginRow, localRows, invRowWidth, epsilon);
                return;
            }
        }
        if constexpr (!AscendC::IsSameType<T, float>::value) {
            // FP16/BF16 rows have a 16-element alignment here, allowing
            // contiguous row groups to use one input and one output DMA while
            // retaining the established per-row reduction arithmetic.
            if (rowWidth <= static_cast<uint64_t>(kSmallLowPrecisionContiguousMaxWidth) &&
                (rowWidth % kSmallLowPrecisionAlignment) == 0 && localRows > 1) {
                ProcessSmallLowPrecisionContiguousBatched(beginRow, localRows, rowWidth,
                                                          invRowWidth, epsilon);
                return;
            }
        }
        const bool cacheRow = rowWidth <= static_cast<uint64_t>(kCacheElems);
        // A one-row core gains nothing from preloading channel parameters;
        // cores with several rows reuse the same GM loads for all their rows.
        const bool cacheParams = cacheRow && localRows > 1;
        const bool cacheParamFp32 = cacheParams && !AscendC::IsSameType<T, float>::value &&
                                    !std::is_same<T, half>::value;

        if (cacheParams) {
            if constexpr (AscendC::IsSameType<T, float>::value) {
                AscendC::LocalTensor<T> gammaLocal = gammaBuf_.Get<T>();
                AscendC::LocalTensor<T> biasLocal = biasBuf_.Get<T>();
                for (uint64_t col = 0; col < rowWidth; col += kTileElems) {
                    const int32_t valid = TileLength(rowWidth - col);
                    Load(gammaLocal[col], gammaGm_, col, valid);
                    Load(biasLocal[col], biasGm_, col, valid);
                }
            } else if constexpr (std::is_same<T, half>::value) {
                AscendC::LocalTensor<T> gammaLocal = gammaBuf_.Get<T>();
                AscendC::LocalTensor<T> biasLocal = biasBuf_.Get<T>();
                for (uint64_t col = 0; col < rowWidth; col += kTileElems) {
                    const int32_t valid = TileLength(rowWidth - col);
                    Load(gammaLocal[col], gammaGm_, col, valid);
                    Load(biasLocal[col], biasGm_, col, valid);
                }
            } else {
                AscendC::LocalTensor<T> gammaStage = gammaBuf_.Get<T>();
                AscendC::LocalTensor<T> biasStage = biasBuf_.Get<T>();
                AscendC::LocalTensor<float> gammaFp32 = gammaFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> biasFp32 = biasFp32Buf_.Get<float>();
                for (uint64_t col = 0; col < rowWidth; col += kTileElems) {
                    const int32_t valid = TileLength(rowWidth - col);
                    Load(gammaStage, gammaGm_, col, valid);
                    Load(biasStage, biasGm_, col, valid);
                    SyncMTE2ToV();
                    ToFloat(gammaFp32[col], gammaStage, valid);
                    ToFloat(biasFp32[col], biasStage, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    SyncVToMTE2();
                }
            }
        }

        for (uint64_t row = beginRow; row < beginRow + localRows; ++row) {
            const uint64_t rowOffset = row * rowWidth;
            // For cached rows, the preceding row starts the next row's first
            // x/residual copy after it has finished using these tile buffers.
            const bool hasPrefetchedFirstTile = cacheRow && row != beginRow;
            // D is at most 32768 for this operator, so one FP32 slot per
            // 1024-element tile fits easily in reduceFp32Buf_.  Keeping these
            // partial sums in UB avoids a scalar read for every tile.
            const int32_t tileCount = static_cast<int32_t>(
                (rowWidth + static_cast<uint64_t>(kTileElems) - 1) /
                static_cast<uint64_t>(kTileElems));
            int32_t tileIndex = 0;

            // First pass: y = x + residual and sum(y^2).  For widths that fit
            // in UB, keep y at its row offset for the output pass.
            for (uint64_t col = 0; col < rowWidth; col += kTileElems) {
                const int32_t valid = TileLength(rowWidth - col);
                AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
                if (col != 0 || !hasPrefetchedFirstTile) {
                    Load(xLocal, xGm_, rowOffset + col, valid);
                    Load(residualLocal, residualGm_, rowOffset + col, valid);
                }
                SyncMTE2ToV();

                AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueFp32 = valueFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> reduceFp32 = reduceFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueTile = cacheRow ? valueFp32[col] : valueFp32;
                if constexpr (AscendC::IsSameType<T, float>::value) {
                    AscendC::Add(valueTile, xLocal, residualLocal, valid);
                } else if constexpr (std::is_same<T, half>::value) {
                    // Vector add natively supports FP16.  The subsequent
                    // widening conversion removes one FP32 source/add path.
                    AscendC::Add(xLocal, xLocal, residualLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    ToFloat(valueTile, xLocal, valid);
                } else {
                    ToFloat(xFp32, xLocal, valid);
                    ToFloat(residualFp32, residualLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(valueTile, xFp32, residualFp32, valid);
                }
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(xFp32, valueTile, valueTile, valid);
                AscendC::PipeBarrier<PIPE_V>();
                // ReduceSum performs its internal V/S handoff.  Store one tile
                // sum and defer the only scalar read until after the row-level
                // reduction below.
                AscendC::ReduceSum(reduceFp32[tileIndex], xFp32, residualFp32, valid);
                ++tileIndex;
                SyncVToMTE2();
            }

            // The output path below uses the cached y row, not xLocal or
            // residualLocal.  Its MTE2 copy can therefore overlap the current
            // row's scalar/vector tail and is consumed at the next iteration.
            if (cacheRow && row + 1 < beginRow + localRows) {
                const int32_t nextValid = TileLength(rowWidth);
                AscendC::LocalTensor<T> nextXLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> nextResidualLocal = residualBuf_.Get<T>();
                const uint64_t nextOffset = (row + 1) * rowWidth;
                Load(nextXLocal, xGm_, nextOffset, nextValid);
                Load(nextResidualLocal, residualGm_, nextOffset, nextValid);
            }

            // Scalar device math is not available for this Vector Core target,
            // so calculate the row denominator through one-element FP32 vector
            // operations and bring only the final reciprocal back to Scalar.
            AscendC::LocalTensor<float> scalarLocal = residualFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceFp32 = reduceFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
            AscendC::ReduceSum(scalarLocal, reduceFp32, xFp32, tileCount);
            SyncVToS();
            const float squareSum = scalarLocal.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            SyncSToV();
            AscendC::Duplicate(xFp32, meanSquare, 1);
            AscendC::Sqrt(xFp32, xFp32, 1);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            const float invRms = 1.0f / xFp32.GetValue(0);
            SyncSToV();

            // Second pass: y * inv_rms * gamma + bias.
            for (uint64_t col = 0; col < rowWidth; col += kTileElems) {
                const int32_t valid = TileLength(rowWidth - col);
                AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
                AscendC::LocalTensor<T> gammaLocal = gammaBuf_.Get<T>();
                AscendC::LocalTensor<T> biasLocal = biasBuf_.Get<T>();
                AscendC::LocalTensor<T> outputLocal;
                if constexpr (std::is_same<T, half>::value) {
                    outputLocal = outputBuf_.Get<T>();
                } else if constexpr (!AscendC::IsSameType<T, float>::value) {
                    // With one local row gamma is still the source of the
                    // uncached parameter conversion; xBuf_ has no prefetched
                    // successor in that case and is the safe output staging.
                    outputLocal = cacheParams ? gammaBuf_.Get<T>() : xBuf_.Get<T>();
                }
                if (!cacheRow) {
                    Load(xLocal, xGm_, rowOffset + col, valid);
                    Load(residualLocal, residualGm_, rowOffset + col, valid);
                }
                if (!cacheParams) {
                    Load(gammaLocal, gammaGm_, col, valid);
                    Load(biasLocal, biasGm_, col, valid);
                }
                if (!cacheRow || !cacheParams) {
                    SyncMTE2ToV();
                }

                AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueFp32 = valueFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueTile = cacheRow ? valueFp32[col] : valueFp32;
                if (!cacheRow) {
                    if constexpr (AscendC::IsSameType<T, float>::value) {
                        AscendC::Add(valueTile, xLocal, residualLocal, valid);
                    } else {
                        ToFloat(xFp32, xLocal, valid);
                        ToFloat(residualFp32, residualLocal, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(valueTile, xFp32, residualFp32, valid);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                }

                if constexpr (!AscendC::IsSameType<T, float>::value && !std::is_same<T, half>::value) {
                    // xFp32/residualFp32 are no longer needed for y, so reuse
                    // them for uncached per-channel gamma and bias values.
                    if (!cacheParamFp32) {
                        if (cacheParams) {
                            ToFloat(xFp32, gammaLocal[col], valid);
                            ToFloat(residualFp32, biasLocal[col], valid);
                        } else {
                            ToFloat(xFp32, gammaLocal, valid);
                            ToFloat(residualFp32, biasLocal, valid);
                        }
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                }
                AscendC::Muls(valueTile, valueTile, invRms, valid);
                AscendC::PipeBarrier<PIPE_V>();
                if constexpr (AscendC::IsSameType<T, float>::value) {
                    if (cacheParams) {
                        AscendC::Mul(valueTile, valueTile, gammaLocal[col], valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(valueTile, valueTile, biasLocal[col], valid);
                    } else {
                        AscendC::Mul(valueTile, valueTile, gammaLocal, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(valueTile, valueTile, biasLocal, valid);
                    }
                } else if constexpr (std::is_same<T, half>::value) {
                    FromFloat(outputLocal, valueTile, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (cacheParams) {
                        AscendC::Mul(outputLocal, outputLocal, gammaLocal[col], valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(outputLocal, outputLocal, biasLocal[col], valid);
                    } else {
                        AscendC::Mul(outputLocal, outputLocal, gammaLocal, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(outputLocal, outputLocal, biasLocal, valid);
                    }
                } else if (cacheParamFp32) {
                    AscendC::LocalTensor<float> gammaFp32 = gammaFp32Buf_.Get<float>();
                    AscendC::LocalTensor<float> biasFp32 = biasFp32Buf_.Get<float>();
                    AscendC::Mul(valueTile, valueTile, gammaFp32[col], valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(valueTile, valueTile, biasFp32[col], valid);
                } else {
                    AscendC::Mul(valueTile, valueTile, xFp32, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(valueTile, valueTile, residualFp32, valid);
                }
                AscendC::PipeBarrier<PIPE_V>();
                if constexpr (AscendC::IsSameType<T, float>::value) {
                    if (!cacheRow || !cacheParams) {
                        SyncVToMTE2();
                    }
                    SyncVToMTE3();
                    Store(outputGm_, rowOffset + col, valueTile, valid);
                    SyncMTE3ToV();
                } else if constexpr (std::is_same<T, half>::value) {
                    if (!cacheRow || !cacheParams) {
                        SyncVToMTE2();
                    }
                    SyncVToMTE3();
                    Store(outputGm_, rowOffset + col, outputLocal, valid);
                    SyncMTE3ToV();
                } else {
                    FromFloat(outputLocal, valueTile, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (!cacheRow || !cacheParams) {
                        SyncVToMTE2();
                    }
                    SyncVToMTE3();
                    Store(outputGm_, rowOffset + col, outputLocal, valid);
                    SyncMTE3ToV();
                }
            }
        }
    }

    __aicore__ inline void ProcessBf16FullTileBatchedOutputPipelined(
        uint64_t beginRow, uint64_t localRows, float invRowWidth, float epsilon)
    {
        constexpr int32_t width = kTileElems;
        constexpr int32_t batchLimit = kCacheElems / kTileElems;
        // Once the FP32 parameter cache is populated, these native staging
        // buffers become the two alternating BF16 output slots.
        AscendC::LocalTensor<T> gammaStage = gammaBuf_.Get<T>();
        AscendC::LocalTensor<T> biasStage = biasBuf_.Get<T>();
        AscendC::LocalTensor<float> gammaFp32 = gammaFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> biasFp32 = biasFp32Buf_.Get<float>();
        Load(gammaStage, gammaGm_, 0, width);
        Load(biasStage, biasGm_, 0, width);
        SyncMTE2ToV();
        ToFloat(gammaFp32, gammaStage, width);
        ToFloat(biasFp32, biasStage, width);
        AscendC::PipeBarrier<PIPE_V>();
        SyncVToMTE2();

        const AscendC::TEventID outputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        const AscendC::TEventID outputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        bool firstOutputNeedsRelease = false;
        bool secondOutputNeedsRelease = false;

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += batchLimit) {
            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(batchLimit) ? remainingRows : batchLimit);
            float invRmsValues[batchLimit];
            float meanSquares[batchLimit];
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();

            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t rowOffset =
                    (batchBegin + static_cast<uint64_t>(batchRow)) * width;
                AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
                AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueRow = valueLocal[batchRow * width];
                Load(xLocal, xGm_, rowOffset, width);
                Load(residualLocal, residualGm_, rowOffset, width);
                SyncMTE2ToV();
                ToFloat(xFp32, xLocal, width);
                ToFloat(residualFp32, residualLocal, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueRow, xFp32, residualFp32, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(xFp32, valueRow, valueRow, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[batchRow * kSmallFp32ScalarStride], xFp32,
                                   residualFp32, width);
                SyncVToMTE2();
            }

            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                meanSquares[batchRow] =
                    reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride) * invRowWidth + epsilon;
            }
            SyncSToV();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                AscendC::LocalTensor<float> scalarSlot =
                    reduceLocal[batchRow * kSmallFp32ScalarStride];
                AscendC::Duplicate(scalarSlot, meanSquares[batchRow], 1);
                AscendC::Sqrt(scalarSlot, scalarSlot, 1);
            }
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                invRmsValues[batchRow] =
                    1.0f / reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride);
            }
            SyncSToV();

            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const bool useFirst = (batchRow & 1) == 0;
                const AscendC::TEventID outputReady =
                    useFirst ? outputReadyFirst : outputReadySecond;
                const AscendC::TEventID outputRelease =
                    useFirst ? outputReleaseFirst : outputReleaseSecond;
                if (useFirst ? firstOutputNeedsRelease : secondOutputNeedsRelease) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                    if (useFirst) {
                        firstOutputNeedsRelease = false;
                    } else {
                        secondOutputNeedsRelease = false;
                    }
                }
                AscendC::LocalTensor<float> valueRow = valueLocal[batchRow * width];
                AscendC::LocalTensor<T> outputRow = useFirst ? gammaStage : biasStage;
                AscendC::Muls(valueRow, valueRow, invRmsValues[batchRow], width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(valueRow, valueRow, gammaFp32, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueRow, valueRow, biasFp32, width);
                AscendC::PipeBarrier<PIPE_V>();
                FromFloat(outputRow, valueRow, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                Store(outputGm_, (batchBegin + static_cast<uint64_t>(batchRow)) * width,
                      outputRow, width);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                if (useFirst) {
                    firstOutputNeedsRelease = true;
                } else {
                    secondOutputNeedsRelease = true;
                }
            }
        }

        if (firstOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        }
        if (secondOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
        }
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
    }

    __aicore__ inline void ProcessFp16FullTileBatchedOutputPipelined(
        uint64_t beginRow, uint64_t localRows, float invRowWidth, float epsilon)
    {
        constexpr int32_t width = kTileElems;
        constexpr int32_t batchLimit = kCacheElems / kTileElems;
        AscendC::LocalTensor<T> gammaLocal = gammaBuf_.Get<T>();
        AscendC::LocalTensor<T> biasLocal = biasBuf_.Get<T>();
        Load(gammaLocal, gammaGm_, 0, width);
        Load(biasLocal, biasGm_, 0, width);

        const AscendC::TEventID outputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        const AscendC::TEventID outputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        bool firstOutputNeedsRelease = false;
        bool secondOutputNeedsRelease = false;

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += batchLimit) {
            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(batchLimit) ? remainingRows : batchLimit);
            float invRmsValues[batchLimit];
            float meanSquares[batchLimit];
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();

            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t rowOffset =
                    (batchBegin + static_cast<uint64_t>(batchRow)) * width;
                AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
                AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueRow = valueLocal[batchRow * width];
                Load(xLocal, xGm_, rowOffset, width);
                Load(residualLocal, residualGm_, rowOffset, width);
                SyncMTE2ToV();
                AscendC::Add(xLocal, xLocal, residualLocal, width);
                AscendC::PipeBarrier<PIPE_V>();
                ToFloat(valueRow, xLocal, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(xFp32, valueRow, valueRow, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[batchRow * kSmallFp32ScalarStride], xFp32,
                                   residualFp32, width);
                SyncVToMTE2();
            }

            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                meanSquares[batchRow] =
                    reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride) * invRowWidth + epsilon;
            }
            SyncSToV();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                AscendC::LocalTensor<float> scalarSlot =
                    reduceLocal[batchRow * kSmallFp32ScalarStride];
                AscendC::Duplicate(scalarSlot, meanSquares[batchRow], 1);
                AscendC::Sqrt(scalarSlot, scalarSlot, 1);
            }
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                invRmsValues[batchRow] =
                    1.0f / reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride);
            }
            SyncSToV();

            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const bool useFirst = (batchRow & 1) == 0;
                const AscendC::TEventID outputReady =
                    useFirst ? outputReadyFirst : outputReadySecond;
                const AscendC::TEventID outputRelease =
                    useFirst ? outputReleaseFirst : outputReleaseSecond;
                if (useFirst ? firstOutputNeedsRelease : secondOutputNeedsRelease) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                    if (useFirst) {
                        firstOutputNeedsRelease = false;
                    } else {
                        secondOutputNeedsRelease = false;
                    }
                }
                AscendC::LocalTensor<float> valueRow = valueLocal[batchRow * width];
                AscendC::LocalTensor<T> outputRow = outputBuf_.Get<T>()[batchRow * width];
                AscendC::Muls(valueRow, valueRow, invRmsValues[batchRow], width);
                AscendC::PipeBarrier<PIPE_V>();
                FromFloat(outputRow, valueRow, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(outputRow, outputRow, gammaLocal, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(outputRow, outputRow, biasLocal, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                Store(outputGm_, (batchBegin + static_cast<uint64_t>(batchRow)) * width,
                      outputRow, width);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                if (useFirst) {
                    firstOutputNeedsRelease = true;
                } else {
                    secondOutputNeedsRelease = true;
                }
            }
        }

        if (firstOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        }
        if (secondOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
        }
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
    }

    __aicore__ inline void ProcessBf16FullRowOutputPipelined(uint64_t beginRow,
                                                              uint64_t localRows,
                                                              float invRowWidth,
                                                              float epsilon)
    {
        // Cache the promoted parameters before reusing their native staging
        // buffers as the two alternating output tiles.
        AscendC::LocalTensor<T> gammaStage = gammaBuf_.Get<T>();
        AscendC::LocalTensor<T> biasStage = biasBuf_.Get<T>();
        AscendC::LocalTensor<float> gammaFp32 = gammaFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> biasFp32 = biasFp32Buf_.Get<float>();
        for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
            Load(gammaStage, gammaGm_, col, kTileElems);
            Load(biasStage, biasGm_, col, kTileElems);
            SyncMTE2ToV();
            ToFloat(gammaFp32[col], gammaStage, kTileElems);
            ToFloat(biasFp32[col], biasStage, kTileElems);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToMTE2();
        }

        const AscendC::TEventID outputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        const AscendC::TEventID outputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        bool firstOutputNeedsRelease = false;
        bool secondOutputNeedsRelease = false;

        for (uint64_t row = beginRow; row < beginRow + localRows; ++row) {
            const uint64_t rowOffset = row * static_cast<uint64_t>(kCacheElems);
            const bool hasPrefetchedFirstTile = row != beginRow;
            AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
            AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
            AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();

            for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
                if (col != 0 || !hasPrefetchedFirstTile) {
                    Load(xLocal, xGm_, rowOffset + col, kTileElems);
                    Load(residualLocal, residualGm_, rowOffset + col, kTileElems);
                }
                SyncMTE2ToV();
                AscendC::LocalTensor<float> valueTile = valueLocal[col];
                ToFloat(xFp32, xLocal, kTileElems);
                ToFloat(residualFp32, residualLocal, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueTile, xFp32, residualFp32, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(xFp32, valueTile, valueTile, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[col / kTileElems], xFp32, residualFp32,
                                   kTileElems);
                SyncVToMTE2();
            }

            if (row + 1 < beginRow + localRows) {
                const uint64_t nextOffset = rowOffset + kCacheElems;
                Load(xLocal, xGm_, nextOffset, kTileElems);
                Load(residualLocal, residualGm_, nextOffset, kTileElems);
            }

            AscendC::ReduceSum(residualFp32, reduceLocal, xFp32,
                               kCacheElems / kTileElems);
            SyncVToS();
            const float squareSum = residualFp32.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            SyncSToV();
            AscendC::Duplicate(xFp32, meanSquare, 1);
            AscendC::Sqrt(xFp32, xFp32, 1);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            const float invRms = 1.0f / xFp32.GetValue(0);
            SyncSToV();

            for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
                const bool useFirst = col == 0;
                const AscendC::TEventID outputReady =
                    useFirst ? outputReadyFirst : outputReadySecond;
                const AscendC::TEventID outputRelease =
                    useFirst ? outputReleaseFirst : outputReleaseSecond;
                if (useFirst ? firstOutputNeedsRelease : secondOutputNeedsRelease) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                    if (useFirst) {
                        firstOutputNeedsRelease = false;
                    } else {
                        secondOutputNeedsRelease = false;
                    }
                }
                AscendC::LocalTensor<float> valueTile = valueLocal[col];
                AscendC::LocalTensor<T> outputTile = useFirst ? gammaStage : biasStage;
                AscendC::Muls(valueTile, valueTile, invRms, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(valueTile, valueTile, gammaFp32[col], kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueTile, valueTile, biasFp32[col], kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                FromFloat(outputTile, valueTile, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                Store(outputGm_, rowOffset + col, outputTile, kTileElems);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                if (useFirst) {
                    firstOutputNeedsRelease = true;
                } else {
                    secondOutputNeedsRelease = true;
                }
            }
        }

        if (firstOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        }
        if (secondOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
        }
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
    }

    __aicore__ inline void ProcessFp16FullRowOutputPipelined(uint64_t beginRow,
                                                              uint64_t localRows,
                                                              float invRowWidth,
                                                              float epsilon)
    {
        AscendC::LocalTensor<T> gammaLocal = gammaBuf_.Get<T>();
        AscendC::LocalTensor<T> biasLocal = biasBuf_.Get<T>();
        for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
            Load(gammaLocal[col], gammaGm_, col, kTileElems);
            Load(biasLocal[col], biasGm_, col, kTileElems);
        }

        const AscendC::TEventID outputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        const AscendC::TEventID outputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        bool firstOutputNeedsRelease = false;
        bool secondOutputNeedsRelease = false;

        for (uint64_t row = beginRow; row < beginRow + localRows; ++row) {
            const uint64_t rowOffset = row * static_cast<uint64_t>(kCacheElems);
            const bool hasPrefetchedFirstTile = row != beginRow;
            AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
            AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
            AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();

            for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
                if (col != 0 || !hasPrefetchedFirstTile) {
                    Load(xLocal, xGm_, rowOffset + col, kTileElems);
                    Load(residualLocal, residualGm_, rowOffset + col, kTileElems);
                }
                SyncMTE2ToV();
                AscendC::LocalTensor<float> valueTile = valueLocal[col];
                AscendC::Add(xLocal, xLocal, residualLocal, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                ToFloat(valueTile, xLocal, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(xFp32, valueTile, valueTile, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[col / kTileElems], xFp32, residualFp32,
                                   kTileElems);
                SyncVToMTE2();
            }

            if (row + 1 < beginRow + localRows) {
                const uint64_t nextOffset = rowOffset + kCacheElems;
                Load(xLocal, xGm_, nextOffset, kTileElems);
                Load(residualLocal, residualGm_, nextOffset, kTileElems);
            }

            AscendC::ReduceSum(residualFp32, reduceLocal, xFp32,
                               kCacheElems / kTileElems);
            SyncVToS();
            const float squareSum = residualFp32.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            SyncSToV();
            AscendC::Duplicate(xFp32, meanSquare, 1);
            AscendC::Sqrt(xFp32, xFp32, 1);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            const float invRms = 1.0f / xFp32.GetValue(0);
            SyncSToV();

            for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
                const bool useFirst = col == 0;
                const AscendC::TEventID outputReady =
                    useFirst ? outputReadyFirst : outputReadySecond;
                const AscendC::TEventID outputRelease =
                    useFirst ? outputReleaseFirst : outputReleaseSecond;
                if (useFirst ? firstOutputNeedsRelease : secondOutputNeedsRelease) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                    if (useFirst) {
                        firstOutputNeedsRelease = false;
                    } else {
                        secondOutputNeedsRelease = false;
                    }
                }
                AscendC::LocalTensor<float> valueTile = valueLocal[col];
                AscendC::LocalTensor<T> outputTile = outputBuf_.Get<T>()[col];
                AscendC::Muls(valueTile, valueTile, invRms, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                FromFloat(outputTile, valueTile, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(outputTile, outputTile, gammaLocal[col], kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(outputTile, outputTile, biasLocal[col], kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                Store(outputGm_, rowOffset + col, outputTile, kTileElems);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                if (useFirst) {
                    firstOutputNeedsRelease = true;
                } else {
                    secondOutputNeedsRelease = true;
                }
            }
        }

        if (firstOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        }
        if (secondOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
        }
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
    }

    __aicore__ inline void ProcessFp32FullRowOutputPipelined(uint64_t beginRow,
                                                              uint64_t localRows,
                                                              float invRowWidth,
                                                              float epsilon)
    {
        AscendC::LocalTensor<float> gammaLocal = gammaBuf_.Get<float>();
        AscendC::LocalTensor<float> biasLocal = biasBuf_.Get<float>();
        for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
            Load(gammaLocal[col], gammaGm_, col, kTileElems);
            Load(biasLocal[col], biasGm_, col, kTileElems);
        }

        const AscendC::TEventID outputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        const AscendC::TEventID outputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        bool firstOutputNeedsRelease = false;
        bool secondOutputNeedsRelease = false;

        for (uint64_t row = beginRow; row < beginRow + localRows; ++row) {
            // valueFp32Buf_ holds both output tiles.  Do not overwrite either
            // tile until the preceding row's asynchronous MTE3 copy is done.
            if (firstOutputNeedsRelease) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
                firstOutputNeedsRelease = false;
            }
            if (secondOutputNeedsRelease) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
                secondOutputNeedsRelease = false;
            }

            const uint64_t rowOffset = row * static_cast<uint64_t>(kCacheElems);
            const bool hasPrefetchedFirstTile = row != beginRow;
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();

            for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
                AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
                AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
                if (col != 0 || !hasPrefetchedFirstTile) {
                    Load(xLocal, xGm_, rowOffset + col, kTileElems);
                    Load(residualLocal, residualGm_, rowOffset + col, kTileElems);
                }
                SyncMTE2ToV();
                AscendC::LocalTensor<float> valueTile = valueLocal[col];
                AscendC::Add(valueTile, xLocal, residualLocal, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(xFp32, valueTile, valueTile, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[col / kTileElems], xFp32, residualFp32,
                                   kTileElems);
                SyncVToMTE2();
            }

            if (row + 1 < beginRow + localRows) {
                AscendC::LocalTensor<float> nextXLocal = xBuf_.Get<float>();
                AscendC::LocalTensor<float> nextResidualLocal = residualBuf_.Get<float>();
                const uint64_t nextOffset = rowOffset + kCacheElems;
                Load(nextXLocal, xGm_, nextOffset, kTileElems);
                Load(nextResidualLocal, residualGm_, nextOffset, kTileElems);
            }

            AscendC::ReduceSum(residualFp32, reduceLocal, xFp32,
                               kCacheElems / kTileElems);
            SyncVToS();
            const float squareSum = residualFp32.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            SyncSToV();
            AscendC::Duplicate(xFp32, meanSquare, 1);
            AscendC::Sqrt(xFp32, xFp32, 1);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            const float invRms = 1.0f / xFp32.GetValue(0);
            SyncSToV();

            for (int32_t col = 0; col < kCacheElems; col += kTileElems) {
                const bool useFirst = col == 0;
                AscendC::LocalTensor<float> valueTile = valueLocal[col];
                const AscendC::TEventID outputReady =
                    useFirst ? outputReadyFirst : outputReadySecond;
                const AscendC::TEventID outputRelease =
                    useFirst ? outputReleaseFirst : outputReleaseSecond;
                AscendC::Muls(valueTile, valueTile, invRms, kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(valueTile, valueTile, gammaLocal[col], kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueTile, valueTile, biasLocal[col], kTileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                Store(outputGm_, rowOffset + col, valueTile, kTileElems);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                if (useFirst) {
                    firstOutputNeedsRelease = true;
                } else {
                    secondOutputNeedsRelease = true;
                }
            }
        }

        if (firstOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        }
        if (secondOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
        }
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
    }

private:
    static constexpr int32_t kTileElems = 4096;
    static constexpr int32_t kParamFp32CacheElems = 4096;
    static constexpr int32_t kSmallFp32BatchRows = 4;
    static constexpr int32_t kSmallFp32BatchMaxWidth = 4096;
    static constexpr int32_t kSmallFp32ScalarStride = 8;
    static constexpr int32_t kSmallFp32ContiguousBatchRows = 8;
    static constexpr int32_t kSmallFp32ContiguousMaxWidth = 2048;
    static constexpr int32_t kSmallLowPrecisionContiguousBatchRows = 8;
    static constexpr int32_t kSmallLowPrecisionContiguousMaxWidth = 2048;
    static constexpr int32_t kSmallLowPrecisionAlignment = 16;
    static constexpr int32_t kFp16RepeatMaxWidth = 192;
    static constexpr int32_t kFp32RepeatMaxWidth = 192;
    static constexpr int32_t kWideTileElems = 8192;
    static constexpr int32_t kWideFp32TileElems = 12288;
    // Keep the eight FP32 batch buffers under the 184 KiB candidate UB budget
    // while preserving a 32-element vector alignment for the batch pipeline.
    static constexpr int32_t kWideFp32BatchTileElems = 5760;
    static constexpr int32_t kWideFp32CachedTileElems = 7680;
    static constexpr int32_t kWideFp32CachedRowMaxWidth = 32768;
    static constexpr int32_t kWideFp16CachedTileElems = 7680;
    static constexpr int32_t kWideFp16BatchOutputTileElems = 4096;
    static constexpr int32_t kWidePartialElems = 8;
    static constexpr int32_t kWideBatchRows = 8;
    static constexpr int32_t kWideFp32BatchRows = 8;
    // 910B3 has 192 KB UB with an 8 KB system reservation.  FP32 avoids the
    // redundant output staging buffer above, leaving enough room for three
    // 8192-element caches as well as the five 4096-element work buffers.
    static constexpr int32_t kCacheElems = 8192;
    __aicore__ inline int32_t TileLength(uint64_t remaining) const
    {
        return static_cast<int32_t>(remaining < static_cast<uint64_t>(kTileElems) ? remaining : kTileElems);
    }

    __aicore__ inline int32_t WideTileLength(uint64_t remaining) const
    {
        return static_cast<int32_t>(remaining < static_cast<uint64_t>(kWideTileElems) ? remaining : kWideTileElems);
    }

    __aicore__ inline int32_t WideFp32TileLength(uint64_t remaining) const
    {
        return static_cast<int32_t>(remaining < static_cast<uint64_t>(kWideFp32TileElems) ?
            remaining : kWideFp32TileElems);
    }

    __aicore__ inline int32_t WideFp32BatchTileLength(uint64_t remaining) const
    {
        return static_cast<int32_t>(remaining < static_cast<uint64_t>(kWideFp32BatchTileElems) ?
            remaining : kWideFp32BatchTileElems);
    }

    __aicore__ inline int32_t WideFp32CachedTileLength(uint64_t remaining) const
    {
        return static_cast<int32_t>(remaining < static_cast<uint64_t>(kWideFp32CachedTileElems) ?
            remaining : kWideFp32CachedTileElems);
    }

    __aicore__ inline int32_t WideFp16CachedTileLength(uint64_t remaining) const
    {
        return static_cast<int32_t>(remaining < static_cast<uint64_t>(kWideFp16CachedTileElems) ?
            remaining : kWideFp16CachedTileElems);
    }

    __aicore__ inline int32_t WideFp16BatchOutputTileLength(uint64_t remaining) const
    {
        return static_cast<int32_t>(remaining < static_cast<uint64_t>(kWideFp16BatchOutputTileElems) ?
            remaining : kWideFp16BatchOutputTileElems);
    }

    __aicore__ inline void ProcessSmallFp32Batched(uint64_t beginRow, uint64_t localRows,
                                                    uint64_t rowWidth, float invRowWidth,
                                                    float epsilon)
    {
        if (rowWidth == static_cast<uint64_t>(kTileElems)) {
            ProcessSmallFp32FullTileBatched(beginRow, localRows, invRowWidth, epsilon);
            return;
        }
        AscendC::LocalTensor<float> gammaLocal = gammaBuf_.Get<float>();
        AscendC::LocalTensor<float> biasLocal = biasBuf_.Get<float>();
        Load(gammaLocal, gammaGm_, 0, static_cast<int32_t>(rowWidth));
        Load(biasLocal, biasGm_, 0, static_cast<int32_t>(rowWidth));
        const int32_t rowsByValueCache = static_cast<int32_t>(
            static_cast<uint64_t>(kCacheElems) / rowWidth);
        const int32_t batchLimit = rowsByValueCache < kSmallFp32BatchRows
            ? rowsByValueCache : kSmallFp32BatchRows;

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += batchLimit) {
            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(batchLimit) ? remainingRows : batchLimit);
            float invRmsValues[kSmallFp32BatchRows];
            float meanSquares[kSmallFp32BatchRows];
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();

            // Keep y for every row in the batch.  x/residual can then be
            // reused as the square and reduction work buffers immediately.
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t rowOffset =
                    (batchBegin + static_cast<uint64_t>(batchRow)) * rowWidth;
                AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
                AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
                AscendC::LocalTensor<float> valueRow = valueLocal[batchRow * rowWidth];
                Load(xLocal, xGm_, rowOffset, static_cast<int32_t>(rowWidth));
                Load(residualLocal, residualGm_, rowOffset, static_cast<int32_t>(rowWidth));
                SyncMTE2ToV();
                AscendC::Add(valueRow, xLocal, residualLocal, static_cast<int32_t>(rowWidth));
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(xLocal, valueRow, valueRow, static_cast<int32_t>(rowWidth));
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[batchRow * kSmallFp32ScalarStride], xLocal, residualLocal,
                                   static_cast<int32_t>(rowWidth));
                SyncVToMTE2();
            }

            // The scalar formula is unchanged.  Only the independent rows'
            // V/S transfers and one-element square roots are grouped.
            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                meanSquares[batchRow] =
                    reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride) * invRowWidth + epsilon;
            }
            SyncSToV();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                AscendC::LocalTensor<float> scalarSlot =
                    reduceLocal[batchRow * kSmallFp32ScalarStride];
                AscendC::Duplicate(scalarSlot, meanSquares[batchRow], 1);
                AscendC::Sqrt(scalarSlot, scalarSlot, 1);
            }
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                invRmsValues[batchRow] =
                    1.0f / reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride);
            }
            SyncSToV();

            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                AscendC::LocalTensor<float> valueRow = valueLocal[batchRow * rowWidth];
                AscendC::Muls(valueRow, valueRow, invRmsValues[batchRow],
                              static_cast<int32_t>(rowWidth));
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(valueRow, valueRow, gammaLocal, static_cast<int32_t>(rowWidth));
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueRow, valueRow, biasLocal, static_cast<int32_t>(rowWidth));
                AscendC::PipeBarrier<PIPE_V>();
            }
            SyncVToMTE3();
            Store(outputGm_, batchBegin * rowWidth, valueLocal,
                  batchRows * static_cast<int32_t>(rowWidth));
            SyncMTE3ToV();
        }
    }

    __aicore__ inline void ProcessSmallFp32FullTileBatched(uint64_t beginRow,
                                                            uint64_t localRows,
                                                            float invRowWidth,
                                                            float epsilon)
    {
        constexpr int32_t width = kTileElems;
        constexpr int32_t batchLimit = kCacheElems / kTileElems;
        AscendC::LocalTensor<float> gammaLocal = gammaBuf_.Get<float>();
        AscendC::LocalTensor<float> biasLocal = biasBuf_.Get<float>();
        Load(gammaLocal, gammaGm_, 0, width);
        Load(biasLocal, biasGm_, 0, width);

        const AscendC::TEventID outputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        const AscendC::TEventID outputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        bool firstOutputNeedsRelease = false;
        bool secondOutputNeedsRelease = false;

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += batchLimit) {
            if (firstOutputNeedsRelease) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
                firstOutputNeedsRelease = false;
            }
            if (secondOutputNeedsRelease) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
                secondOutputNeedsRelease = false;
            }

            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(batchLimit) ? remainingRows : batchLimit);
            float invRmsValues[batchLimit];
            float meanSquares[batchLimit];
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();

            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t rowOffset =
                    (batchBegin + static_cast<uint64_t>(batchRow)) * width;
                AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
                AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
                AscendC::LocalTensor<float> valueRow = valueLocal[batchRow * width];
                Load(xLocal, xGm_, rowOffset, width);
                Load(residualLocal, residualGm_, rowOffset, width);
                SyncMTE2ToV();
                AscendC::Add(valueRow, xLocal, residualLocal, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(xLocal, valueRow, valueRow, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[batchRow * kSmallFp32ScalarStride], xLocal,
                                   residualLocal, width);
                SyncVToMTE2();
            }

            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                meanSquares[batchRow] =
                    reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride) * invRowWidth + epsilon;
            }
            SyncSToV();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                AscendC::LocalTensor<float> scalarSlot =
                    reduceLocal[batchRow * kSmallFp32ScalarStride];
                AscendC::Duplicate(scalarSlot, meanSquares[batchRow], 1);
                AscendC::Sqrt(scalarSlot, scalarSlot, 1);
            }
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                invRmsValues[batchRow] =
                    1.0f / reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride);
            }
            SyncSToV();

            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const bool useFirst = (batchRow & 1) == 0;
                AscendC::LocalTensor<float> valueRow = valueLocal[batchRow * width];
                const AscendC::TEventID outputReady =
                    useFirst ? outputReadyFirst : outputReadySecond;
                const AscendC::TEventID outputRelease =
                    useFirst ? outputReleaseFirst : outputReleaseSecond;
                AscendC::Muls(valueRow, valueRow, invRmsValues[batchRow], width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(valueRow, valueRow, gammaLocal, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueRow, valueRow, biasLocal, width);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                Store(outputGm_, (batchBegin + static_cast<uint64_t>(batchRow)) * width,
                      valueRow, width);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                if (useFirst) {
                    firstOutputNeedsRelease = true;
                } else {
                    secondOutputNeedsRelease = true;
                }
            }
        }

        if (firstOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        }
        if (secondOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
        }
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
    }

    __aicore__ inline void ProcessSmallFp32ContiguousBatched(
        uint64_t beginRow, uint64_t localRows, uint64_t rowWidth, float invRowWidth,
        float epsilon)
    {
        AscendC::LocalTensor<float> gammaLocal = gammaBuf_.Get<float>();
        AscendC::LocalTensor<float> biasLocal = biasBuf_.Get<float>();
        Load(gammaLocal, gammaGm_, 0, static_cast<int32_t>(rowWidth));
        Load(biasLocal, biasGm_, 0, static_cast<int32_t>(rowWidth));
        const int32_t rowsByInputBuffer = static_cast<int32_t>(
            static_cast<uint64_t>(kTileElems) / rowWidth);
        const int32_t batchLimit = rowsByInputBuffer < kSmallFp32ContiguousBatchRows
            ? rowsByInputBuffer : kSmallFp32ContiguousBatchRows;

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += batchLimit) {
            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(batchLimit) ? remainingRows : batchLimit);
            const int32_t totalElems = batchRows * static_cast<int32_t>(rowWidth);
            float invRmsValues[kSmallFp32ContiguousBatchRows];
            float meanSquares[kSmallFp32ContiguousBatchRows];
            AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
            AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            const uint64_t batchOffset = batchBegin * rowWidth;

            Load(xLocal, xGm_, batchOffset, totalElems);
            Load(residualLocal, residualGm_, batchOffset, totalElems);
            SyncMTE2ToV();
            AscendC::Add(valueLocal, xLocal, residualLocal, totalElems);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(xLocal, valueLocal, valueLocal, totalElems);
            AscendC::PipeBarrier<PIPE_V>();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t valueOffset = static_cast<uint64_t>(batchRow) * rowWidth;
                AscendC::ReduceSum(reduceLocal[batchRow * kSmallFp32ScalarStride],
                                   xLocal[valueOffset], residualLocal[valueOffset],
                                   static_cast<int32_t>(rowWidth));
            }
            SyncVToMTE2();

            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                meanSquares[batchRow] =
                    reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride) * invRowWidth + epsilon;
            }
            SyncSToV();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                AscendC::LocalTensor<float> scalarSlot =
                    reduceLocal[batchRow * kSmallFp32ScalarStride];
                AscendC::Duplicate(scalarSlot, meanSquares[batchRow], 1);
                AscendC::Sqrt(scalarSlot, scalarSlot, 1);
            }
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                invRmsValues[batchRow] =
                    1.0f / reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride);
            }
            SyncSToV();

            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                AscendC::LocalTensor<float> valueRow =
                    valueLocal[static_cast<uint64_t>(batchRow) * rowWidth];
                AscendC::Muls(valueRow, valueRow, invRmsValues[batchRow],
                              static_cast<int32_t>(rowWidth));
                AscendC::PipeBarrier<PIPE_V>();
            }
            if (rowWidth <= static_cast<uint64_t>(kFp32RepeatMaxWidth)) {
                ApplyFp32GammaBiasBatch(valueLocal, gammaLocal, biasLocal,
                                        static_cast<int32_t>(rowWidth), batchRows);
            } else {
                for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                    AscendC::LocalTensor<float> valueRow =
                        valueLocal[static_cast<uint64_t>(batchRow) * rowWidth];
                    AscendC::Mul(valueRow, valueRow, gammaLocal, static_cast<int32_t>(rowWidth));
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(valueRow, valueRow, biasLocal, static_cast<int32_t>(rowWidth));
                    AscendC::PipeBarrier<PIPE_V>();
                }
            }
            SyncVToMTE3();
            Store(outputGm_, batchBegin * rowWidth, valueLocal,
                  batchRows * static_cast<int32_t>(rowWidth));
            SyncMTE3ToV();
        }
    }

    __aicore__ inline void ProcessSmallLowPrecisionContiguousBatched(
        uint64_t beginRow, uint64_t localRows, uint64_t rowWidth, float invRowWidth,
        float epsilon)
    {
        const int32_t width = static_cast<int32_t>(rowWidth);
        const int32_t rowsByInputBuffer = static_cast<int32_t>(
            static_cast<uint64_t>(kTileElems) / rowWidth);
        const int32_t batchLimit = rowsByInputBuffer < kSmallLowPrecisionContiguousBatchRows
            ? rowsByInputBuffer : kSmallLowPrecisionContiguousBatchRows;
        AscendC::LocalTensor<T> gammaLocal = gammaBuf_.Get<T>();
        AscendC::LocalTensor<T> biasLocal = biasBuf_.Get<T>();
        AscendC::LocalTensor<float> gammaFp32;
        AscendC::LocalTensor<float> biasFp32;

        Load(gammaLocal, gammaGm_, 0, width);
        Load(biasLocal, biasGm_, 0, width);
        if constexpr (!std::is_same<T, half>::value) {
            gammaFp32 = gammaFp32Buf_.Get<float>();
            biasFp32 = biasFp32Buf_.Get<float>();
            SyncMTE2ToV();
            ToFloat(gammaFp32, gammaLocal, width);
            ToFloat(biasFp32, biasLocal, width);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToMTE2();
        }

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += batchLimit) {
            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(batchLimit) ? remainingRows : batchLimit);
            const int32_t totalElems = batchRows * width;
            float invRmsValues[kSmallLowPrecisionContiguousBatchRows];
            float meanSquares[kSmallLowPrecisionContiguousBatchRows];
            AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
            AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
            AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            const uint64_t batchOffset = batchBegin * rowWidth;

            Load(xLocal, xGm_, batchOffset, totalElems);
            Load(residualLocal, residualGm_, batchOffset, totalElems);
            SyncMTE2ToV();
            if constexpr (std::is_same<T, half>::value) {
                AscendC::Add(xLocal, xLocal, residualLocal, totalElems);
                AscendC::PipeBarrier<PIPE_V>();
                ToFloat(valueLocal, xLocal, totalElems);
            } else {
                ToFloat(xFp32, xLocal, totalElems);
                ToFloat(residualFp32, residualLocal, totalElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueLocal, xFp32, residualFp32, totalElems);
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(xFp32, valueLocal, valueLocal, totalElems);
            AscendC::PipeBarrier<PIPE_V>();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t valueOffset = static_cast<uint64_t>(batchRow) * rowWidth;
                AscendC::ReduceSum(reduceLocal[batchRow * kSmallFp32ScalarStride],
                                   xFp32[valueOffset], residualFp32[valueOffset], width);
            }
            SyncVToMTE2();

            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                meanSquares[batchRow] =
                    reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride) * invRowWidth + epsilon;
            }
            SyncSToV();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                AscendC::LocalTensor<float> scalarSlot =
                    reduceLocal[batchRow * kSmallFp32ScalarStride];
                AscendC::Duplicate(scalarSlot, meanSquares[batchRow], 1);
                AscendC::Sqrt(scalarSlot, scalarSlot, 1);
            }
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                invRmsValues[batchRow] =
                    1.0f / reduceLocal.GetValue(batchRow * kSmallFp32ScalarStride);
            }
            SyncSToV();

            if constexpr (std::is_same<T, half>::value) {
                AscendC::LocalTensor<T> outputLocal = outputBuf_.Get<T>();
                for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                    const uint64_t valueOffset = static_cast<uint64_t>(batchRow) * rowWidth;
                    AscendC::LocalTensor<float> valueRow = valueLocal[valueOffset];
                    AscendC::Muls(valueRow, valueRow, invRmsValues[batchRow], width);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                FromFloat(outputLocal, valueLocal, totalElems);
                AscendC::PipeBarrier<PIPE_V>();
                if (width <= kFp16RepeatMaxWidth) {
                    ApplyFp16GammaBiasBatch(outputLocal, gammaLocal, biasLocal, width, batchRows);
                } else {
                    for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                        const uint64_t valueOffset = static_cast<uint64_t>(batchRow) * rowWidth;
                        AscendC::LocalTensor<T> outputRow = outputLocal[valueOffset];
                        AscendC::Mul(outputRow, outputRow, gammaLocal, width);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(outputRow, outputRow, biasLocal, width);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                }
                SyncVToMTE3();
                Store(outputGm_, batchOffset, outputLocal, totalElems);
                SyncMTE3ToV();
            } else {
                // gammaBuf_ was only a staging buffer for the cached FP32
                // parameters, so it is now safe to reuse as the packed output.
                AscendC::LocalTensor<T> outputLocal = gammaBuf_.Get<T>();
                for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                    const uint64_t valueOffset = static_cast<uint64_t>(batchRow) * rowWidth;
                    AscendC::LocalTensor<float> valueRow = valueLocal[valueOffset];
                    AscendC::Muls(valueRow, valueRow, invRmsValues[batchRow], width);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                if (width <= kFp32RepeatMaxWidth) {
                    ApplyFp32GammaBiasBatch(valueLocal, gammaFp32, biasFp32, width, batchRows);
                } else {
                    for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                        const uint64_t valueOffset = static_cast<uint64_t>(batchRow) * rowWidth;
                        AscendC::LocalTensor<float> valueRow = valueLocal[valueOffset];
                        AscendC::Mul(valueRow, valueRow, gammaFp32, width);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(valueRow, valueRow, biasFp32, width);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                }
                FromFloat(outputLocal, valueLocal, totalElems);
                AscendC::PipeBarrier<PIPE_V>();
                SyncVToMTE3();
                Store(outputGm_, batchOffset, outputLocal, totalElems);
                SyncMTE3ToV();
            }
        }
    }

    __aicore__ inline void ApplyFp16GammaBiasBatch(
        const AscendC::LocalTensor<half>& outputLocal,
        const AscendC::LocalTensor<half>& gammaLocal,
        const AscendC::LocalTensor<half>& biasLocal, int32_t width, int32_t batchRows)
    {
        // A 16-bit vector repeat holds 128 elements.  The per-row stride is
        // measured in 32-byte blocks, and the source parameter repeat stride
        // of zero broadcasts one gamma/bias row to every output row.
        const uint8_t rowStride = static_cast<uint8_t>(width / kSmallLowPrecisionAlignment);
        for (int32_t col = 0; col < width; col += 128) {
            const int32_t valid = width - col < 128 ? width - col : 128;
            AscendC::Mul(outputLocal[col], outputLocal[col], gammaLocal[col], valid,
                         static_cast<uint8_t>(batchRows),
                         {1, 1, 1, rowStride, rowStride, 0});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(outputLocal[col], outputLocal[col], biasLocal[col], valid,
                         static_cast<uint8_t>(batchRows),
                         {1, 1, 1, rowStride, rowStride, 0});
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void ApplyFp32GammaBiasBatch(
        const AscendC::LocalTensor<float>& valueLocal,
        const AscendC::LocalTensor<float>& gammaLocal,
        const AscendC::LocalTensor<float>& biasLocal, int32_t width, int32_t batchRows)
    {
        const uint8_t rowStride = static_cast<uint8_t>(width / kSmallFp32ScalarStride);
        for (int32_t col = 0; col < width; col += 64) {
            const int32_t valid = width - col < 64 ? width - col : 64;
            AscendC::Mul(valueLocal[col], valueLocal[col], gammaLocal[col], valid,
                         static_cast<uint8_t>(batchRows),
                         {1, 1, 1, rowStride, rowStride, 0});
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(valueLocal[col], valueLocal[col], biasLocal[col], valid,
                         static_cast<uint8_t>(batchRows),
                         {1, 1, 1, rowStride, rowStride, 0});
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void ProcessWideFp32(uint64_t rowCount, uint64_t rowWidth,
                                           uint32_t blockCount, float invRowWidth,
                                           float epsilon)
    {
        if (wideFp32BatchPath_) {
            ProcessWideFp32Batched(rowCount, rowWidth, blockCount, invRowWidth, epsilon);
            return;
        }
        if (wideFp32CachedRowPath_) {
            ProcessWideFp32CachedRows(rowCount, rowWidth, blockCount, invRowWidth, epsilon);
            return;
        }
        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t baseRows = rowCount / blockCount;
        const uint64_t extraRows = rowCount % blockCount;
        const uint64_t beginRow = blockIdx * baseRows +
                                  (blockIdx < extraRows ? blockIdx : extraRows);
        const uint64_t localRows = baseRows + (blockIdx < extraRows ? 1 : 0);
        const int32_t tileCount = static_cast<int32_t>(
            (rowWidth + static_cast<uint64_t>(kWideFp32TileElems) - 1) /
            static_cast<uint64_t>(kWideFp32TileElems));

        for (uint64_t row = beginRow; row < beginRow + localRows; ++row) {
            const uint64_t rowOffset = row * rowWidth;
            int32_t tileIndex = 0;
            for (uint64_t col = 0; col < rowWidth; col += kWideFp32TileElems) {
                const int32_t valid = WideFp32TileLength(rowWidth - col);
                AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
                AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
                AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
                Load(xLocal, xGm_, rowOffset + col, valid);
                Load(residualLocal, residualGm_, rowOffset + col, valid);
                SyncMTE2ToV();
                AscendC::Add(valueLocal, xLocal, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                // residualLocal and xLocal are dead after the add, so use them
                // as the square buffer and reduction workspace respectively.
                AscendC::Mul(residualLocal, valueLocal, valueLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[tileIndex], residualLocal, xLocal, valid);
                ++tileIndex;
                SyncVToMTE2();
            }

            AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
            AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            AscendC::ReduceSum(residualLocal, reduceLocal, xLocal, tileCount);
            SyncVToS();
            const float squareSum = residualLocal.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            SyncSToV();
            AscendC::Duplicate(xLocal, meanSquare, 1);
            AscendC::Sqrt(xLocal, xLocal, 1);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            const float invRms = 1.0f / xLocal.GetValue(0);
            SyncSToV();

            // The reduction used x/residual UB; release those two buffers
            // before the first output-pass MTE2 copy overwrites them.
            SyncVToMTE2();

            for (uint64_t col = 0; col < rowWidth; col += kWideFp32TileElems) {
                const int32_t valid = WideFp32TileLength(rowWidth - col);
                AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
                AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
                AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
                Load(xLocal, xGm_, rowOffset + col, valid);
                Load(residualLocal, residualGm_, rowOffset + col, valid);
                SyncMTE2ToV();
                AscendC::Add(valueLocal, xLocal, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Muls(valueLocal, valueLocal, invRms, valid);
                AscendC::PipeBarrier<PIPE_V>();

                // x/residual no longer participate in the output computation;
                // refill their buffers with the two channel parameters.
                SyncVToMTE2();
                Load(xLocal, gammaGm_, col, valid);
                Load(residualLocal, biasGm_, col, valid);
                SyncMTE2ToV();
                AscendC::Mul(valueLocal, valueLocal, xLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueLocal, valueLocal, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                SyncVToMTE2();
                SyncVToMTE3();
                Store(outputGm_, rowOffset + col, valueLocal, valid);
                SyncMTE3ToV();
            }
        }
    }

    __aicore__ inline void ProcessWideFp32CachedRows(uint64_t rowCount, uint64_t rowWidth,
                                                      uint32_t blockCount, float invRowWidth,
                                                      float epsilon)
    {
        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t baseRows = rowCount / blockCount;
        const uint64_t extraRows = rowCount % blockCount;
        const uint64_t beginRow = blockIdx * baseRows +
                                  (blockIdx < extraRows ? blockIdx : extraRows);
        const uint64_t localRows = baseRows + (blockIdx < extraRows ? 1 : 0);
        const int32_t tileCount = static_cast<int32_t>(
            (rowWidth + static_cast<uint64_t>(kWideFp32CachedTileElems) - 1) /
            static_cast<uint64_t>(kWideFp32CachedTileElems));

        for (uint64_t row = beginRow; row < beginRow + localRows; ++row) {
            const uint64_t rowOffset = row * rowWidth;
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            int32_t tileIndex = 0;
            for (uint64_t col = 0; col < rowWidth; col += kWideFp32CachedTileElems) {
                const int32_t valid = WideFp32CachedTileLength(rowWidth - col);
                AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
                AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
                AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
                Load(xLocal, xGm_, rowOffset + col, valid);
                Load(residualLocal, residualGm_, rowOffset + col, valid);
                SyncMTE2ToV();
                AscendC::Add(valueLocal[col], xLocal, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(residualLocal, valueLocal[col], valueLocal[col], valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[tileIndex], residualLocal, xLocal, valid);
                ++tileIndex;
                SyncVToMTE2();
            }

            AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
            AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            AscendC::ReduceSum(residualLocal, reduceLocal, xLocal, tileCount);
            SyncVToS();
            const float squareSum = residualLocal.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            SyncSToV();
            AscendC::Duplicate(xLocal, meanSquare, 1);
            AscendC::Sqrt(xLocal, xLocal, 1);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            const float invRms = 1.0f / xLocal.GetValue(0);
            SyncSToV();
            SyncVToMTE2();

            for (uint64_t col = 0; col < rowWidth; col += kWideFp32CachedTileElems) {
                const int32_t valid = WideFp32CachedTileLength(rowWidth - col);
                AscendC::LocalTensor<float> gammaLocal = xBuf_.Get<float>();
                AscendC::LocalTensor<float> biasLocal = residualBuf_.Get<float>();
                Load(gammaLocal, gammaGm_, col, valid);
                Load(biasLocal, biasGm_, col, valid);
                SyncMTE2ToV();
                AscendC::Muls(valueLocal[col], valueLocal[col], invRms, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(valueLocal[col], valueLocal[col], gammaLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueLocal[col], valueLocal[col], biasLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                SyncVToMTE2();
                SyncVToMTE3();
                Store(outputGm_, rowOffset + col, valueLocal[col], valid);
                SyncMTE3ToV();
            }
        }
    }

    __aicore__ inline float ComputeWideFp32InvRms(uint64_t rowOffset,
                                                   uint64_t rowWidth,
                                                   int32_t tileCount,
                                                   float invRowWidth,
                                                   float epsilon)
    {
        int32_t tileIndex = 0;
        for (uint64_t col = 0; col < rowWidth; col += kWideTileElems) {
            const int32_t valid = WideTileLength(rowWidth - col);
            AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
            AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            Load(xLocal, xGm_, rowOffset + col, valid);
            Load(residualLocal, residualGm_, rowOffset + col, valid);
            SyncMTE2ToV();
            AscendC::Add(valueLocal, xLocal, residualLocal, valid);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(residualLocal, valueLocal, valueLocal, valid);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceSum(reduceLocal[tileIndex], residualLocal, xLocal, valid);
            ++tileIndex;
            SyncVToMTE2();
        }

        AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
        AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
        AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
        AscendC::ReduceSum(residualLocal, reduceLocal, xLocal, tileCount);
        SyncVToS();
        const float squareSum = residualLocal.GetValue(0);
        const float meanSquare = squareSum * invRowWidth + epsilon;
        SyncSToV();
        AscendC::Duplicate(xLocal, meanSquare, 1);
        AscendC::Sqrt(xLocal, xLocal, 1);
        AscendC::PipeBarrier<PIPE_V>();
        SyncVToS();
        const float invRms = 1.0f / xLocal.GetValue(0);
        SyncSToV();
        SyncVToMTE2();
        return invRms;
    }

    __aicore__ inline float ComputeWideFp32InvRmsPipelined(uint64_t rowOffset,
                                                            uint64_t rowWidth,
                                                            int32_t tileCount,
                                                            float invRowWidth,
                                                            float epsilon)
    {
        // The parameter buffers are idle during the RMS pass.  Borrow them
        // as a second input tile so MTE2 can fetch tile n + 1 while V squares
        // and reduces tile n.  Each buffer is released before it is refilled.
        const AscendC::TEventID readyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE2_V>();
        const AscendC::TEventID readySecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE2_V>();
        const AscendC::TEventID releaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE2>();
        const AscendC::TEventID releaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE2>();

        AscendC::LocalTensor<float> firstX = xBuf_.Get<float>();
        AscendC::LocalTensor<float> firstResidual = residualBuf_.Get<float>();
        AscendC::LocalTensor<float> secondX = gammaBuf_.Get<float>();
        AscendC::LocalTensor<float> secondResidual = biasBuf_.Get<float>();
        AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();

        const int32_t firstValid = WideFp32BatchTileLength(rowWidth);
        Load(firstX, xGm_, rowOffset, firstValid);
        Load(firstResidual, residualGm_, rowOffset, firstValid);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(readyFirst);

        bool firstNeedsRelease = false;
        bool secondNeedsRelease = false;
        for (int32_t tileIndex = 0; tileIndex < tileCount; ++tileIndex) {
            const bool useFirst = (tileIndex & 1) == 0;
            const uint64_t col = static_cast<uint64_t>(tileIndex) * kWideFp32BatchTileElems;
            const int32_t valid = WideFp32BatchTileLength(rowWidth - col);
            AscendC::LocalTensor<float> xLocal = useFirst ? firstX : secondX;
            AscendC::LocalTensor<float> residualLocal =
                useFirst ? firstResidual : secondResidual;
            const AscendC::TEventID readyEvent = useFirst ? readyFirst : readySecond;
            const AscendC::TEventID releaseEvent = useFirst ? releaseFirst : releaseSecond;

            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(readyEvent);
            AscendC::Add(valueLocal, xLocal, residualLocal, valid);
            AscendC::PipeBarrier<PIPE_V>();

            if (tileIndex + 1 < tileCount) {
                const bool refillFirst = !useFirst;
                const uint64_t nextCol = col + kWideFp32BatchTileElems;
                const int32_t nextValid = WideFp32BatchTileLength(rowWidth - nextCol);
                if (refillFirst) {
                    if (firstNeedsRelease) {
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(releaseFirst);
                        firstNeedsRelease = false;
                    }
                    Load(firstX, xGm_, rowOffset + nextCol, nextValid);
                    Load(firstResidual, residualGm_, rowOffset + nextCol, nextValid);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(readyFirst);
                } else {
                    if (secondNeedsRelease) {
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(releaseSecond);
                        secondNeedsRelease = false;
                    }
                    Load(secondX, xGm_, rowOffset + nextCol, nextValid);
                    Load(secondResidual, residualGm_, rowOffset + nextCol, nextValid);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(readySecond);
                }
            }

            AscendC::Mul(residualLocal, valueLocal, valueLocal, valid);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceSum(reduceLocal[tileIndex], residualLocal, xLocal, valid);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(releaseEvent);
            if (useFirst) {
                firstNeedsRelease = true;
            } else {
                secondNeedsRelease = true;
            }
        }

        // The following parameter/output pass reuses both staging pairs.
        // Drain only flags still outstanding; a refilled pair has already
        // consumed its prior release flag above.
        if (firstNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(releaseFirst);
        }
        if (secondNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(releaseSecond);
        }

        AscendC::LocalTensor<float> xLocal = xBuf_.Get<float>();
        AscendC::LocalTensor<float> residualLocal = residualBuf_.Get<float>();
        AscendC::ReduceSum(residualLocal, reduceLocal, xLocal, tileCount);
        SyncVToS();
        const float squareSum = residualLocal.GetValue(0);
        const float meanSquare = squareSum * invRowWidth + epsilon;
        SyncSToV();
        AscendC::Duplicate(xLocal, meanSquare, 1);
        AscendC::Sqrt(xLocal, xLocal, 1);
        AscendC::PipeBarrier<PIPE_V>();
        SyncVToS();
        const float invRms = 1.0f / xLocal.GetValue(0);
        SyncSToV();

        pipe_.ReleaseEventID<AscendC::HardEvent::MTE2_V>(readyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE2_V>(readySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE2>(releaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE2>(releaseSecond);
        return invRms;
    }

    __aicore__ inline void ProcessWideFp32Batched(uint64_t rowCount, uint64_t rowWidth,
                                                   uint32_t blockCount, float invRowWidth,
                                                   float epsilon)
    {
        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t baseRows = rowCount / blockCount;
        const uint64_t extraRows = rowCount % blockCount;
        const uint64_t beginRow = blockIdx * baseRows +
                                  (blockIdx < extraRows ? blockIdx : extraRows);
        const uint64_t localRows = baseRows + (blockIdx < extraRows ? 1 : 0);
        const int32_t tileCount = static_cast<int32_t>(
            (rowWidth + static_cast<uint64_t>(kWideFp32BatchTileElems) - 1) /
            static_cast<uint64_t>(kWideFp32BatchTileElems));

        const AscendC::TEventID inputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE2_V>();
        const AscendC::TEventID inputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE2_V>();
        const AscendC::TEventID inputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE2>();
        const AscendC::TEventID inputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE2>();
        const AscendC::TEventID outputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        const AscendC::TEventID outputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        bool firstInputNeedsRelease = false;
        bool secondInputNeedsRelease = false;
        bool firstOutputNeedsRelease = false;
        bool secondOutputNeedsRelease = false;

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += kWideFp32BatchRows) {
            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(kWideFp32BatchRows) ? remainingRows : kWideFp32BatchRows);
            float invRmsValues[kWideFp32BatchRows];
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t rowOffset = (batchBegin + static_cast<uint64_t>(batchRow)) * rowWidth;
                invRmsValues[batchRow] = ComputeWideFp32InvRmsPipelined(
                    rowOffset, rowWidth, tileCount, invRowWidth, epsilon);
            }

            for (uint64_t col = 0; col < rowWidth; col += kWideFp32BatchTileElems) {
                const int32_t valid = WideFp32BatchTileLength(rowWidth - col);
                AscendC::LocalTensor<float> gammaLocal = gammaBuf_.Get<float>();
                AscendC::LocalTensor<float> biasLocal = biasBuf_.Get<float>();
                AscendC::LocalTensor<float> firstX = xBuf_.Get<float>();
                AscendC::LocalTensor<float> firstResidual = residualBuf_.Get<float>();
                AscendC::LocalTensor<float> firstValue = valueFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> secondX = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> secondResidual = residualFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> secondValue = outputBuf_.Get<float>();

                if (firstInputNeedsRelease) {
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseFirst);
                    firstInputNeedsRelease = false;
                }
                Load(gammaLocal, gammaGm_, col, valid);
                Load(biasLocal, biasGm_, col, valid);
                Load(firstX, xGm_, batchBegin * rowWidth + col, valid);
                Load(firstResidual, residualGm_, batchBegin * rowWidth + col, valid);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReadyFirst);

                for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                    const uint64_t rowOffset =
                        (batchBegin + static_cast<uint64_t>(batchRow)) * rowWidth;
                    const bool useFirst = (batchRow & 1) == 0;
                    AscendC::LocalTensor<float> xLocal = useFirst ? firstX : secondX;
                    AscendC::LocalTensor<float> residualLocal =
                        useFirst ? firstResidual : secondResidual;
                    AscendC::LocalTensor<float> valueLocal = useFirst ? firstValue : secondValue;
                    const AscendC::TEventID inputReady =
                        useFirst ? inputReadyFirst : inputReadySecond;
                    const AscendC::TEventID inputRelease =
                        useFirst ? inputReleaseFirst : inputReleaseSecond;
                    const AscendC::TEventID outputReady =
                        useFirst ? outputReadyFirst : outputReadySecond;
                    const AscendC::TEventID outputRelease =
                        useFirst ? outputReleaseFirst : outputReleaseSecond;

                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);
                    if (useFirst ? firstOutputNeedsRelease : secondOutputNeedsRelease) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                        if (useFirst) {
                            firstOutputNeedsRelease = false;
                        } else {
                            secondOutputNeedsRelease = false;
                        }
                    }
                    AscendC::Add(valueLocal, xLocal, residualLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputRelease);
                    if (useFirst) {
                        firstInputNeedsRelease = true;
                    } else {
                        secondInputNeedsRelease = true;
                    }

                    if (batchRow + 1 < batchRows) {
                        const bool refillFirst = !useFirst;
                        const uint64_t nextRowOffset = rowOffset + rowWidth;
                        if (refillFirst) {
                            if (firstInputNeedsRelease) {
                                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseFirst);
                                firstInputNeedsRelease = false;
                            }
                            Load(firstX, xGm_, nextRowOffset + col, valid);
                            Load(firstResidual, residualGm_, nextRowOffset + col, valid);
                            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReadyFirst);
                        } else {
                            if (secondInputNeedsRelease) {
                                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseSecond);
                                secondInputNeedsRelease = false;
                            }
                            Load(secondX, xGm_, nextRowOffset + col, valid);
                            Load(secondResidual, residualGm_, nextRowOffset + col, valid);
                            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReadySecond);
                        }
                    }

                    AscendC::Muls(valueLocal, valueLocal, invRmsValues[batchRow], valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(valueLocal, valueLocal, gammaLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(valueLocal, valueLocal, biasLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                    Store(outputGm_, rowOffset + col, valueLocal, valid);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                    if (useFirst) {
                        firstOutputNeedsRelease = true;
                    } else {
                        secondOutputNeedsRelease = true;
                    }
                }

                // gamma/bias are reused for the following channel tile only
                // after the last vector instruction above has consumed them.
                SyncVToMTE2();
            }
        }

        if (firstInputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseFirst);
        }
        if (secondInputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseSecond);
        }
        if (firstOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        }
        if (secondOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
        }
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputReleaseSecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
    }

    __aicore__ inline float ComputeWideLowPrecisionInvRms(uint64_t rowOffset,
                                                           uint64_t rowWidth,
                                                           int32_t tileCount,
                                                           float invRowWidth,
                                                           float epsilon)
    {
        int32_t tileIndex = 0;
        for (uint64_t col = 0; col < rowWidth; col += kWideTileElems) {
            const int32_t valid = WideTileLength(rowWidth - col);
            AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
            AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
            AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            Load(xLocal, xGm_, rowOffset + col, valid);
            Load(residualLocal, residualGm_, rowOffset + col, valid);
            SyncMTE2ToV();
            if constexpr (std::is_same<T, half>::value) {
                AscendC::Add(xLocal, xLocal, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                ToFloat(valueLocal, xLocal, valid);
            } else {
                ToFloat(xFp32, xLocal, valid);
                ToFloat(residualFp32, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueLocal, xFp32, residualFp32, valid);
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(residualFp32, valueLocal, valueLocal, valid);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceSum(reduceLocal[tileIndex], residualFp32, xFp32, valid);
            ++tileIndex;
            SyncVToMTE2();
        }

        AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
        AscendC::ReduceSum(residualFp32, reduceLocal, xFp32, tileCount);
        SyncVToS();
        const float squareSum = residualFp32.GetValue(0);
        const float meanSquare = squareSum * invRowWidth + epsilon;
        SyncSToV();
        AscendC::Duplicate(xFp32, meanSquare, 1);
        AscendC::Sqrt(xFp32, xFp32, 1);
        AscendC::PipeBarrier<PIPE_V>();
        SyncVToS();
        const float invRms = 1.0f / xFp32.GetValue(0);
        SyncSToV();
        return invRms;
    }

    __aicore__ inline float ComputeWideLowPrecisionInvRmsPipelined(
        uint64_t rowOffset, uint64_t rowWidth, int32_t tileCount, float invRowWidth,
        float epsilon)
    {
        // gamma/bias are not needed until the output pass.  Use their UB
        // allocation as a second native-input pair while reducing this row.
        const AscendC::TEventID readyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE2_V>();
        const AscendC::TEventID readySecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE2_V>();
        const AscendC::TEventID releaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE2>();
        const AscendC::TEventID releaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE2>();

        AscendC::LocalTensor<T> firstX = xBuf_.Get<T>();
        AscendC::LocalTensor<T> firstResidual = residualBuf_.Get<T>();
        AscendC::LocalTensor<T> secondX = gammaBuf_.Get<T>();
        AscendC::LocalTensor<T> secondResidual = biasBuf_.Get<T>();
        AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();

        const int32_t firstValid = WideTileLength(rowWidth);
        Load(firstX, xGm_, rowOffset, firstValid);
        Load(firstResidual, residualGm_, rowOffset, firstValid);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(readyFirst);

        bool firstNeedsRelease = false;
        bool secondNeedsRelease = false;
        for (int32_t tileIndex = 0; tileIndex < tileCount; ++tileIndex) {
            const bool useFirst = (tileIndex & 1) == 0;
            const uint64_t col = static_cast<uint64_t>(tileIndex) * kWideTileElems;
            const int32_t valid = WideTileLength(rowWidth - col);
            AscendC::LocalTensor<T> xLocal = useFirst ? firstX : secondX;
            AscendC::LocalTensor<T> residualLocal =
                useFirst ? firstResidual : secondResidual;
            const AscendC::TEventID readyEvent = useFirst ? readyFirst : readySecond;
            const AscendC::TEventID releaseEvent = useFirst ? releaseFirst : releaseSecond;

            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(readyEvent);
            if constexpr (std::is_same<T, half>::value) {
                AscendC::Add(xLocal, xLocal, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                ToFloat(valueLocal, xLocal, valid);
            } else {
                ToFloat(xFp32, xLocal, valid);
                ToFloat(residualFp32, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueLocal, xFp32, residualFp32, valid);
            }
            AscendC::PipeBarrier<PIPE_V>();

            if (tileIndex + 1 < tileCount) {
                const bool refillFirst = !useFirst;
                const uint64_t nextCol = col + kWideTileElems;
                const int32_t nextValid = WideTileLength(rowWidth - nextCol);
                if (refillFirst) {
                    if (firstNeedsRelease) {
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(releaseFirst);
                        firstNeedsRelease = false;
                    }
                    Load(firstX, xGm_, rowOffset + nextCol, nextValid);
                    Load(firstResidual, residualGm_, rowOffset + nextCol, nextValid);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(readyFirst);
                } else {
                    if (secondNeedsRelease) {
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(releaseSecond);
                        secondNeedsRelease = false;
                    }
                    Load(secondX, xGm_, rowOffset + nextCol, nextValid);
                    Load(secondResidual, residualGm_, rowOffset + nextCol, nextValid);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(readySecond);
                }
            }

            AscendC::Mul(residualFp32, valueLocal, valueLocal, valid);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceSum(reduceLocal[tileIndex], residualFp32, xFp32, valid);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(releaseEvent);
            if (useFirst) {
                firstNeedsRelease = true;
            } else {
                secondNeedsRelease = true;
            }
        }

        if (firstNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(releaseFirst);
        }
        if (secondNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(releaseSecond);
        }

        AscendC::ReduceSum(residualFp32, reduceLocal, xFp32, tileCount);
        SyncVToS();
        const float squareSum = residualFp32.GetValue(0);
        const float meanSquare = squareSum * invRowWidth + epsilon;
        SyncSToV();
        AscendC::Duplicate(xFp32, meanSquare, 1);
        AscendC::Sqrt(xFp32, xFp32, 1);
        AscendC::PipeBarrier<PIPE_V>();
        SyncVToS();
        const float invRms = 1.0f / xFp32.GetValue(0);
        SyncSToV();

        pipe_.ReleaseEventID<AscendC::HardEvent::MTE2_V>(readyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE2_V>(readySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE2>(releaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE2>(releaseSecond);
        return invRms;
    }

    __aicore__ inline void ProcessWideFp16CachedRows(uint64_t rowCount, uint64_t rowWidth,
                                                      uint32_t blockCount, float invRowWidth,
                                                      float epsilon)
    {
        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t baseRows = rowCount / blockCount;
        const uint64_t extraRows = rowCount % blockCount;
        const uint64_t beginRow = blockIdx * baseRows +
                                  (blockIdx < extraRows ? blockIdx : extraRows);
        const uint64_t localRows = baseRows + (blockIdx < extraRows ? 1 : 0);
        const int32_t tileCount = static_cast<int32_t>(
            (rowWidth + static_cast<uint64_t>(kWideFp16CachedTileElems) - 1) /
            static_cast<uint64_t>(kWideFp16CachedTileElems));

        for (uint64_t row = beginRow; row < beginRow + localRows; ++row) {
            const uint64_t rowOffset = row * rowWidth;
            AscendC::LocalTensor<T> outputLocal = outputBuf_.Get<T>();
            int32_t tileIndex = 0;
            for (uint64_t col = 0; col < rowWidth; col += kWideFp16CachedTileElems) {
                const int32_t valid = WideFp16CachedTileLength(rowWidth - col);
                AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
                AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
                Load(xLocal, xGm_, rowOffset + col, valid);
                Load(residualLocal, residualGm_, rowOffset + col, valid);
                SyncMTE2ToV();
                AscendC::Add(outputLocal[col], xLocal, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                ToFloat(valueLocal, outputLocal[col], valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(residualFp32, valueLocal, valueLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[tileIndex], residualFp32, xFp32, valid);
                ++tileIndex;
                SyncVToMTE2();
            }

            AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            AscendC::ReduceSum(residualFp32, reduceLocal, xFp32, tileCount);
            SyncVToS();
            const float squareSum = residualFp32.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            SyncSToV();
            AscendC::Duplicate(xFp32, meanSquare, 1);
            AscendC::Sqrt(xFp32, xFp32, 1);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            const float invRms = 1.0f / xFp32.GetValue(0);
            SyncSToV();
            SyncVToMTE2();

            for (uint64_t col = 0; col < rowWidth; col += kWideFp16CachedTileElems) {
                const int32_t valid = WideFp16CachedTileLength(rowWidth - col);
                AscendC::LocalTensor<T> gammaLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> biasLocal = residualBuf_.Get<T>();
                AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
                Load(gammaLocal, gammaGm_, col, valid);
                Load(biasLocal, biasGm_, col, valid);
                SyncMTE2ToV();
                ToFloat(valueLocal, outputLocal[col], valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Muls(valueLocal, valueLocal, invRms, valid);
                AscendC::PipeBarrier<PIPE_V>();
                FromFloat(outputLocal[col], valueLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(outputLocal[col], outputLocal[col], gammaLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(outputLocal[col], outputLocal[col], biasLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                SyncVToMTE2();
                SyncVToMTE3();
                Store(outputGm_, rowOffset + col, outputLocal[col], valid);
                SyncMTE3ToV();
            }
        }
    }

    __aicore__ inline void ProcessWideBf16CachedRows(uint64_t rowCount, uint64_t rowWidth,
                                                      uint32_t blockCount, float invRowWidth,
                                                      float epsilon)
    {
        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t baseRows = rowCount / blockCount;
        const uint64_t extraRows = rowCount % blockCount;
        const uint64_t beginRow = blockIdx * baseRows +
                                  (blockIdx < extraRows ? blockIdx : extraRows);
        const uint64_t localRows = baseRows + (blockIdx < extraRows ? 1 : 0);
        const int32_t tileCount = static_cast<int32_t>(
            (rowWidth + static_cast<uint64_t>(kWideFp16CachedTileElems) - 1) /
            static_cast<uint64_t>(kWideFp16CachedTileElems));

        for (uint64_t row = beginRow; row < beginRow + localRows; ++row) {
            const uint64_t rowOffset = row * rowWidth;
            // FP16 retains more mantissa than BF16 while consuming the same
            // 16-bit cache footprint. The cache is overwritten by final BF16
            // output only after its tile has been widened back to FP32.
            AscendC::LocalTensor<half> cachedValue = outputBuf_.Get<half>();
            AscendC::LocalTensor<T> outputLocal = outputBuf_.Get<T>();
            int32_t tileIndex = 0;
            for (uint64_t col = 0; col < rowWidth; col += kWideFp16CachedTileElems) {
                const int32_t valid = WideFp16CachedTileLength(rowWidth - col);
                AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
                AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
                Load(xLocal, xGm_, rowOffset + col, valid);
                Load(residualLocal, residualGm_, rowOffset + col, valid);
                SyncMTE2ToV();
                ToFloat(xFp32, xLocal, valid);
                ToFloat(residualFp32, residualLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueLocal, xFp32, residualFp32, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Cast(cachedValue[col], valueLocal, AscendC::RoundMode::CAST_ROUND, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(residualFp32, valueLocal, valueLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduceLocal[tileIndex], residualFp32, xFp32, valid);
                ++tileIndex;
                SyncVToMTE2();
            }

            AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
            AscendC::LocalTensor<float> reduceLocal = reduceFp32Buf_.Get<float>();
            AscendC::ReduceSum(residualFp32, reduceLocal, xFp32, tileCount);
            SyncVToS();
            const float squareSum = residualFp32.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            SyncSToV();
            AscendC::Duplicate(xFp32, meanSquare, 1);
            AscendC::Sqrt(xFp32, xFp32, 1);
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToS();
            const float invRms = 1.0f / xFp32.GetValue(0);
            SyncSToV();
            SyncVToMTE2();

            for (uint64_t col = 0; col < rowWidth; col += kWideFp16CachedTileElems) {
                const int32_t valid = WideFp16CachedTileLength(rowWidth - col);
                AscendC::LocalTensor<T> gammaLocal = xBuf_.Get<T>();
                AscendC::LocalTensor<T> biasLocal = residualBuf_.Get<T>();
                AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
                Load(gammaLocal, gammaGm_, col, valid);
                Load(biasLocal, biasGm_, col, valid);
                SyncMTE2ToV();
                AscendC::Cast(valueLocal, cachedValue[col], AscendC::RoundMode::CAST_NONE, valid);
                ToFloat(xFp32, gammaLocal, valid);
                ToFloat(residualFp32, biasLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Muls(valueLocal, valueLocal, invRms, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(valueLocal, valueLocal, xFp32, valid);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(valueLocal, valueLocal, residualFp32, valid);
                AscendC::PipeBarrier<PIPE_V>();
                FromFloat(outputLocal[col], valueLocal, valid);
                AscendC::PipeBarrier<PIPE_V>();
                SyncVToMTE2();
                SyncVToMTE3();
                Store(outputGm_, rowOffset + col, outputLocal[col], valid);
                SyncMTE3ToV();
            }
        }
    }

    __aicore__ inline void ProcessWideFp16BatchedOutputPipelined(
        uint64_t rowCount, uint64_t rowWidth, uint32_t blockCount, float invRowWidth,
        float epsilon)
    {
        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t baseRows = rowCount / blockCount;
        const uint64_t extraRows = rowCount % blockCount;
        const uint64_t beginRow = blockIdx * baseRows +
                                  (blockIdx < extraRows ? blockIdx : extraRows);
        const uint64_t localRows = baseRows + (blockIdx < extraRows ? 1 : 0);
        const int32_t reduceTileCount = static_cast<int32_t>(
            (rowWidth + static_cast<uint64_t>(kWideTileElems) - 1) /
            static_cast<uint64_t>(kWideTileElems));

        const AscendC::TEventID inputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE2_V>();
        const AscendC::TEventID inputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE2_V>();
        const AscendC::TEventID inputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE2>();
        const AscendC::TEventID inputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE2>();
        const AscendC::TEventID outputReadyFirst =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReadySecond =
            pipe_.AllocEventID<AscendC::HardEvent::V_MTE3>();
        const AscendC::TEventID outputReleaseFirst =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        const AscendC::TEventID outputReleaseSecond =
            pipe_.AllocEventID<AscendC::HardEvent::MTE3_V>();
        bool firstInputNeedsRelease = false;
        bool secondInputNeedsRelease = false;
        bool firstOutputNeedsRelease = false;
        bool secondOutputNeedsRelease = false;

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += kWideBatchRows) {
            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(kWideBatchRows) ? remainingRows : kWideBatchRows);
            float invRmsValues[kWideBatchRows];
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t rowOffset =
                    (batchBegin + static_cast<uint64_t>(batchRow)) * rowWidth;
                invRmsValues[batchRow] = ComputeWideLowPrecisionInvRmsPipelined(
                    rowOffset, rowWidth, reduceTileCount, invRowWidth, epsilon);
            }

            for (uint64_t col = 0; col < rowWidth; col += kWideFp16BatchOutputTileElems) {
                const int32_t valid = WideFp16BatchOutputTileLength(rowWidth - col);
                AscendC::LocalTensor<T> gammaLocal = gammaBuf_.Get<T>();
                AscendC::LocalTensor<T> biasLocal = biasBuf_.Get<T>();
                AscendC::LocalTensor<T> firstX = xBuf_.Get<T>();
                AscendC::LocalTensor<T> firstResidual = residualBuf_.Get<T>();
                AscendC::LocalTensor<T> secondX =
                    gammaLocal[kWideFp16BatchOutputTileElems];
                AscendC::LocalTensor<T> secondResidual =
                    biasLocal[kWideFp16BatchOutputTileElems];
                AscendC::LocalTensor<float> firstValue = valueFp32Buf_.Get<float>();
                AscendC::LocalTensor<float> secondValue = xFp32Buf_.Get<float>();
                AscendC::LocalTensor<T> firstOutput = outputBuf_.Get<T>();
                AscendC::LocalTensor<T> secondOutput =
                    firstOutput[kWideFp16BatchOutputTileElems];

                if (firstInputNeedsRelease) {
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseFirst);
                    firstInputNeedsRelease = false;
                }
                Load(gammaLocal, gammaGm_, col, valid);
                Load(biasLocal, biasGm_, col, valid);
                Load(firstX, xGm_, batchBegin * rowWidth + col, valid);
                Load(firstResidual, residualGm_, batchBegin * rowWidth + col, valid);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReadyFirst);

                for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                    const uint64_t rowOffset =
                        (batchBegin + static_cast<uint64_t>(batchRow)) * rowWidth;
                    const bool useFirst = (batchRow & 1) == 0;
                    AscendC::LocalTensor<T> xLocal = useFirst ? firstX : secondX;
                    AscendC::LocalTensor<T> residualLocal =
                        useFirst ? firstResidual : secondResidual;
                    AscendC::LocalTensor<float> valueLocal =
                        useFirst ? firstValue : secondValue;
                    AscendC::LocalTensor<T> outputLocal =
                        useFirst ? firstOutput : secondOutput;
                    const AscendC::TEventID inputReady =
                        useFirst ? inputReadyFirst : inputReadySecond;
                    const AscendC::TEventID inputRelease =
                        useFirst ? inputReleaseFirst : inputReleaseSecond;
                    const AscendC::TEventID outputReady =
                        useFirst ? outputReadyFirst : outputReadySecond;
                    const AscendC::TEventID outputRelease =
                        useFirst ? outputReleaseFirst : outputReleaseSecond;

                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);
                    AscendC::Add(xLocal, xLocal, residualLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    ToFloat(valueLocal, xLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputRelease);
                    if (useFirst) {
                        firstInputNeedsRelease = true;
                    } else {
                        secondInputNeedsRelease = true;
                    }

                    if (batchRow + 1 < batchRows) {
                        const bool refillFirst = !useFirst;
                        const uint64_t nextRowOffset = rowOffset + rowWidth;
                        if (refillFirst) {
                            if (firstInputNeedsRelease) {
                                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseFirst);
                                firstInputNeedsRelease = false;
                            }
                            Load(firstX, xGm_, nextRowOffset + col, valid);
                            Load(firstResidual, residualGm_, nextRowOffset + col, valid);
                            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReadyFirst);
                        } else {
                            if (secondInputNeedsRelease) {
                                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseSecond);
                                secondInputNeedsRelease = false;
                            }
                            Load(secondX, xGm_, nextRowOffset + col, valid);
                            Load(secondResidual, residualGm_, nextRowOffset + col, valid);
                            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReadySecond);
                        }
                    }

                    AscendC::Muls(valueLocal, valueLocal, invRmsValues[batchRow], valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (useFirst ? firstOutputNeedsRelease : secondOutputNeedsRelease) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                        if (useFirst) {
                            firstOutputNeedsRelease = false;
                        } else {
                            secondOutputNeedsRelease = false;
                        }
                    }
                    FromFloat(outputLocal, valueLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(outputLocal, outputLocal, gammaLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(outputLocal, outputLocal, biasLocal, valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
                    Store(outputGm_, rowOffset + col, outputLocal, valid);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputRelease);
                    if (useFirst) {
                        firstOutputNeedsRelease = true;
                    } else {
                        secondOutputNeedsRelease = true;
                    }
                }

                SyncVToMTE2();
            }
        }

        if (firstInputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseFirst);
        }
        if (secondInputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReleaseSecond);
        }
        if (firstOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        }
        if (secondOutputNeedsRelease) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
        }
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputReleaseSecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadyFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::V_MTE3>(outputReadySecond);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseFirst);
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputReleaseSecond);
    }

    __aicore__ inline void ProcessWideLowPrecision(uint64_t rowCount, uint64_t rowWidth,
                                                    uint32_t blockCount, float invRowWidth,
                                                    float epsilon)
    {
        if constexpr (std::is_same<T, half>::value) {
            if (wideFp16CachedRowPath_) {
                ProcessWideFp16CachedRows(rowCount, rowWidth, blockCount, invRowWidth, epsilon);
                return;
            }
            if (rowCount / static_cast<uint64_t>(blockCount) >= 2) {
                ProcessWideFp16BatchedOutputPipelined(
                    rowCount, rowWidth, blockCount, invRowWidth, epsilon);
                return;
            }
        } else {
            if (wideBf16CachedRowPath_) {
                ProcessWideBf16CachedRows(rowCount, rowWidth, blockCount, invRowWidth, epsilon);
                return;
            }
        }
        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t baseRows = rowCount / blockCount;
        const uint64_t extraRows = rowCount % blockCount;
        const uint64_t beginRow = blockIdx * baseRows +
                                  (blockIdx < extraRows ? blockIdx : extraRows);
        const uint64_t localRows = baseRows + (blockIdx < extraRows ? 1 : 0);
        const int32_t tileCount = static_cast<int32_t>(
            (rowWidth + static_cast<uint64_t>(kWideTileElems) - 1) /
            static_cast<uint64_t>(kWideTileElems));

        for (uint64_t batchBegin = beginRow; batchBegin < beginRow + localRows;
             batchBegin += kWideBatchRows) {
            const uint64_t remainingRows = beginRow + localRows - batchBegin;
            const int32_t batchRows = static_cast<int32_t>(
                remainingRows < static_cast<uint64_t>(kWideBatchRows) ? remainingRows : kWideBatchRows);
            float invRmsValues[kWideBatchRows];
            for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                const uint64_t rowOffset = (batchBegin + static_cast<uint64_t>(batchRow)) * rowWidth;
                invRmsValues[batchRow] = ComputeWideLowPrecisionInvRmsPipelined(
                    rowOffset, rowWidth, tileCount, invRowWidth, epsilon);
            }

            // gamma and bias depend only on the channel.  Cache one tile,
            // then consume it for all rows in this batch before advancing.
            for (uint64_t col = 0; col < rowWidth; col += kWideTileElems) {
                const int32_t valid = WideTileLength(rowWidth - col);
                AscendC::LocalTensor<T> gammaLocal = gammaBuf_.Get<T>();
                AscendC::LocalTensor<T> biasLocal = biasBuf_.Get<T>();
                Load(gammaLocal, gammaGm_, col, valid);
                Load(biasLocal, biasGm_, col, valid);

                for (int32_t batchRow = 0; batchRow < batchRows; ++batchRow) {
                    const uint64_t rowOffset =
                        (batchBegin + static_cast<uint64_t>(batchRow)) * rowWidth;
                    AscendC::LocalTensor<T> xLocal = xBuf_.Get<T>();
                    AscendC::LocalTensor<T> residualLocal = residualBuf_.Get<T>();
                    AscendC::LocalTensor<T> outputLocal = outputBuf_.Get<T>();
                    AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
                    AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
                    AscendC::LocalTensor<float> valueLocal = valueFp32Buf_.Get<float>();
                    Load(xLocal, xGm_, rowOffset + col, valid);
                    Load(residualLocal, residualGm_, rowOffset + col, valid);
                    SyncMTE2ToV();
                    if constexpr (std::is_same<T, half>::value) {
                        AscendC::Add(xLocal, xLocal, residualLocal, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        ToFloat(valueLocal, xLocal, valid);
                    } else {
                        ToFloat(xFp32, xLocal, valid);
                        ToFloat(residualFp32, residualLocal, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(valueLocal, xFp32, residualFp32, valid);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Muls(valueLocal, valueLocal, invRmsValues[batchRow], valid);
                    AscendC::PipeBarrier<PIPE_V>();
                    if constexpr (std::is_same<T, half>::value) {
                        FromFloat(outputLocal, valueLocal, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Mul(outputLocal, outputLocal, gammaLocal, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(outputLocal, outputLocal, biasLocal, valid);
                    } else {
                        ToFloat(xFp32, gammaLocal, valid);
                        ToFloat(residualFp32, biasLocal, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Mul(valueLocal, valueLocal, xFp32, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(valueLocal, valueLocal, residualFp32, valid);
                        AscendC::PipeBarrier<PIPE_V>();
                        FromFloat(outputLocal, valueLocal, valid);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    SyncVToMTE2();
                    SyncVToMTE3();
                    Store(outputGm_, rowOffset + col, outputLocal, valid);
                    SyncMTE3ToV();
                }
            }
        }
    }

    __aicore__ inline void Load(const AscendC::LocalTensor<T>& dst,
                                const AscendC::GlobalTensor<T>& src,
                                uint64_t offset, int32_t count)
    {
        const AscendC::DataCopyExtParams copyParams(
            1, static_cast<uint32_t>(count * static_cast<int32_t>(sizeof(T))), 0, 0, 0);
        const AscendC::DataCopyPadExtParams<T> padParams;
        AscendC::DataCopyPad(dst, src[offset], copyParams, padParams);
    }

    __aicore__ inline void Store(const AscendC::GlobalTensor<T>& dst, uint64_t offset,
                                 const AscendC::LocalTensor<T>& src, int32_t count)
    {
        const AscendC::DataCopyExtParams copyParams(
            1, static_cast<uint32_t>(count * static_cast<int32_t>(sizeof(T))), 0, 0, 0);
        AscendC::DataCopyPad(dst[offset], src, copyParams);
    }

    __aicore__ inline void ToFloat(const AscendC::LocalTensor<float>& dst,
                                   const AscendC::LocalTensor<T>& src, int32_t count)
    {
        if constexpr (AscendC::IsSameType<T, float>::value) {
            // AscendC has no useful FP32->FP32 Cast; an add-zero is an exact
            // vector copy and keeps the generic path uniform.
            AscendC::Adds(dst, src, 0.0f, count);
        } else {
            AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
        }
    }

    __aicore__ inline void FromFloat(const AscendC::LocalTensor<T>& dst,
                                     const AscendC::LocalTensor<float>& src, int32_t count)
    {
        if constexpr (AscendC::IsSameType<T, float>::value) {
            AscendC::Adds(dst, src, 0.0f, count);
        } else {
            // CAST_ROUND matches the round-to-nearest conversion used by the
            // reference implementation when it restores FP16/BF16 output.
            AscendC::Cast(dst, src, AscendC::RoundMode::CAST_ROUND, count);
        }
    }

    __aicore__ inline void SyncMTE2ToV()
    {
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
    }

    __aicore__ inline void SyncVToMTE2()
    {
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
    }

    __aicore__ inline void SyncVToMTE3()
    {
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
    }

    __aicore__ inline void SyncMTE3ToV()
    {
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
    }

    __aicore__ inline void SyncVToS()
    {
        AscendC::SetFlag<AscendC::HardEvent::V_S>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(0);
    }

    __aicore__ inline void SyncSToV()
    {
        AscendC::SetFlag<AscendC::HardEvent::S_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(0);
    }

    AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> residualBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> biasBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> outputBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> residualFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> valueFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> biasFp32Buf_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> residualGm_;
    AscendC::GlobalTensor<T> gammaGm_;
    AscendC::GlobalTensor<T> biasGm_;
    AscendC::GlobalTensor<T> outputGm_;
    bool widePath_;
    bool wideFp32BatchPath_;
    bool wideFp32CachedRowPath_;
    bool wideFp16CachedRowPath_;
    bool wideBf16CachedRowPath_;
};

template <typename T>
__global__ __vector__ void add_rms_norm_bias_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rowCount, uint64_t rowWidth, uint32_t blockCount, float invRowWidth, float epsilon)
{
    AddRmsNormBiasKernel<T> op;
    op.Init(x, residual, gamma, bias, output, rowWidth, rowCount, blockCount);
    op.Process(rowCount, rowWidth, blockCount, invRowWidth, epsilon);
}

#if !defined(ASCENDC_CPU_DEBUG)
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual, const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma, GM_ADDR bias, const TensorGroupInfo& info_bias, GM_ADDR output, const TensorGroupInfo& info_output, int64_t availableCoreNum, aclrtStream stream,
    float epsilon)
{
    // Metadata pointers are Host pointers.  Do all validation before launch so
    // malformed metadata cannot produce a device-side out-of-bounds access.
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr ||
        info_x.tensors == nullptr || info_residual.tensors == nullptr ||
        info_gamma.tensors == nullptr || info_bias.tensors == nullptr ||
        info_output.tensors == nullptr || info_x.numTensors < 1 ||
        info_residual.numTensors < 1 || info_gamma.numTensors < 1 ||
        info_bias.numTensors < 1 || info_output.numTensors < 1) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    const TensorInfo& residualInfo = info_residual.tensors[0];
    const TensorInfo& gammaInfo = info_gamma.tensors[0];
    const TensorInfo& biasInfo = info_bias.tensors[0];
    const TensorInfo& outputInfo = info_output.tensors[0];
    if (xInfo.shape == nullptr || residualInfo.shape == nullptr || gammaInfo.shape == nullptr ||
        biasInfo.shape == nullptr || outputInfo.shape == nullptr || xInfo.numDims < 1 ||
        residualInfo.numDims != xInfo.numDims || outputInfo.numDims != xInfo.numDims ||
        gammaInfo.numDims != 1 || biasInfo.numDims != 1 || xInfo.dtype != residualInfo.dtype ||
        xInfo.dtype != gammaInfo.dtype || xInfo.dtype != biasInfo.dtype || xInfo.dtype != outputInfo.dtype) {
        return;
    }

    const int64_t widthSigned = xInfo.shape[xInfo.numDims - 1];
    if (widthSigned <= 0 || gammaInfo.shape[0] != widthSigned || biasInfo.shape[0] != widthSigned) {
        return;
    }

    // Flatten all leading dimensions into rows, checking dimensions and the
    // multiplication before using the result for a device address calculation.
    uint64_t rowCount = 1;
    for (int64_t dim = 0; dim < xInfo.numDims - 1; ++dim) {
        const int64_t extent = xInfo.shape[dim];
        if (extent <= 0 || residualInfo.shape[dim] != extent || outputInfo.shape[dim] != extent ||
            rowCount > UINT64_MAX / static_cast<uint64_t>(extent)) {
            return;
        }
        rowCount *= static_cast<uint64_t>(extent);
    }
    if (residualInfo.shape[xInfo.numDims - 1] != widthSigned ||
        outputInfo.shape[xInfo.numDims - 1] != widthSigned || rowCount == 0) {
        return;
    }

    const uint64_t rowWidth = static_cast<uint64_t>(widthSigned);
    if (rowCount > UINT64_MAX / rowWidth) {
        return;
    }

    uint64_t requestedBlocks = availableCoreNum > 0 ? static_cast<uint64_t>(availableCoreNum) : 1;
    if (requestedBlocks > rowCount) {
        requestedBlocks = rowCount;
    }
    // Kernel launch dimensions are uint32_t in the direct-call ABI.
    if (requestedBlocks > UINT32_MAX) {
        requestedBlocks = UINT32_MAX;
    }
    const uint32_t blockCount = static_cast<uint32_t>(requestedBlocks);
    const float invRowWidth = 1.0f / static_cast<float>(widthSigned);

    if (xInfo.dtype == 0) {
        add_rms_norm_bias_custom<float><<<blockCount, nullptr, stream>>>(
            x, residual, gamma, bias, output, rowCount, rowWidth, blockCount, invRowWidth, epsilon);
    } else if (xInfo.dtype == 1) {
        add_rms_norm_bias_custom<half><<<blockCount, nullptr, stream>>>(
            x, residual, gamma, bias, output, rowCount, rowWidth, blockCount, invRowWidth, epsilon);
    } else if (xInfo.dtype == 2) {
        add_rms_norm_bias_custom<bfloat16_t><<<blockCount, nullptr, stream>>>(
            x, residual, gamma, bias, output, rowCount, rowWidth, blockCount, invRowWidth, epsilon);
    }
}
#endif  // !defined(ASCENDC_CPU_DEBUG)
