#include <cmath>
#include "kernel_operator.h"

// REDUCE-X V002: reduction-centric AddRmsNormBias.
// V001 root cause: Brcb writes 8 x 32B = 256B per repeat but scratch was 32B,
// corrupting adjacent UB (100% WA + T03 RE). V002 sizes Brcb workspace to 64
// floats, aligns ReduceSum dst to 8B, and keeps a GetValue golden path.

using AscendC::TPipe;
using AscendC::TBuf;
using AscendC::LocalTensor;
using AscendC::GlobalTensor;
using AscendC::DataCopyExtParams;
using AscendC::DataCopyPadExtParams;
using AscendC::ReduceSum;
using AscendC::Rsqrt;
using AscendC::Brcb;
using AscendC::BrcbRepeatParams;
using AscendC::Muls;
using AscendC::Adds;
using AscendC::Add;
using AscendC::Mul;
using AscendC::Cast;
using AscendC::SetFlag;
using AscendC::WaitFlag;
using AscendC::HardEvent;
using AscendC::GetBlockIdx;
using AscendC::GetBlockNum;
using AscendC::PipeBarrier;

static constexpr int32_t kDtypeF32 = 0;
static constexpr int32_t kDtypeF16 = 1;
static constexpr int32_t kDtypeBF16 = 2;
static constexpr int32_t kReduceTmpBytes = 8 * 1024;
static constexpr int32_t kWorkFloats = 64;   // Brcb one-repeat dest
static constexpr int32_t kVecLocalBudget = 184 * 1024;
static constexpr int32_t kEventV2S = static_cast<int32_t>(EVENT_ID0);
static constexpr int32_t kFallbackTile = 2048;

static inline int32_t NormalizeDtype(int32_t raw)
{
    if (raw == 27) {
        return kDtypeBF16;
    }
    return raw;
}

__aicore__ inline int32_t AlignBytes32(int64_t bytes)
{
    return static_cast<int32_t>((bytes + 31) / 32 * 32);
}

// work[0..63] is the Brcb one-repeat destination (MUST be 256B).
// sumLocal[0] holds sum(u*u). Result inv in inv8[0..7].
__aicore__ inline void BuildInvFromSum(
    LocalTensor<float>& work,
    LocalTensor<float>& inv8,
    LocalTensor<float>& sumLocal,
    float invD,
    float eps)
{
    BrcbRepeatParams bp;
    bp.dstBlkStride = 1;
    bp.dstRepStride = 8;
    Brcb(work, sumLocal, 1, bp);          // work[0..7] = sum[0]
    Muls(work, work, invD, 8);
    Adds(work, work, eps, 8);
    Rsqrt(inv8, work, 8);                 // inv8[0..7] = 1/rms
}

// Zero-VS scale: inv8[0..7] identical. 0 GetValue.
__aicore__ inline void ScaleByInv(
    LocalTensor<float>& uLocal,
    LocalTensor<float>& inv8,
    int32_t count)
{
    for (int32_t off = 0; off < count; off += 8) {
        int32_t n = count - off;
        if (n > 8) {
            n = 8;
        }
        Mul(uLocal[off], uLocal[off], inv8, n);
    }
}

// Golden path: shared safe idiom. 1 GetValue per row.
__aicore__ inline float ReduceSumGetValue(
    LocalTensor<float>& sumLocal,
    LocalTensor<float>& srcLocal,
    LocalTensor<float>& tmpLocal,
    int32_t count)
{
    ReduceSum<float, true>(sumLocal, srcLocal, tmpLocal, count);
    SetFlag<HardEvent::V_S>(kEventV2S);
    WaitFlag<HardEvent::V_S>(kEventV2S);
    return sumLocal.GetValue(0);
}

template <typename T>
__aicore__ inline void CopyInPad(
    LocalTensor<T>& dst,
    GlobalTensor<T>& srcGm,
    int64_t gmOffset,
    int32_t validCount)
{
    const uint32_t byteLen = static_cast<uint32_t>(validCount) * static_cast<uint32_t>(sizeof(T));
    DataCopyExtParams cp(1, byteLen, 0, 0, 0);
    DataCopyPadExtParams<T> pad(true, 0, 0, static_cast<T>(0));
    AscendC::DataCopyPad(dst, srcGm[static_cast<uint32_t>(gmOffset)], cp, pad);
}

template <typename T>
__aicore__ inline void CopyOutPad(
    GlobalTensor<T>& dstGm,
    LocalTensor<T>& src,
    int64_t gmOffset,
    int32_t validCount)
{
    const uint32_t byteLen = static_cast<uint32_t>(validCount) * static_cast<uint32_t>(sizeof(T));
    DataCopyExtParams cp(1, byteLen, 0, 0, 0);
    AscendC::DataCopyPad(dstGm[static_cast<uint32_t>(gmOffset)], src, cp);
}

template <typename T>
__aicore__ inline void FormU(
    LocalTensor<float>& uLocal,
    LocalTensor<float>& resF,
    LocalTensor<T>& xLocal,
    LocalTensor<T>& resLocal,
    int32_t n)
{
    if constexpr (sizeof(T) == 4) {
        Add(uLocal, xLocal, resLocal, n);
    } else {
        Cast(uLocal, xLocal, AscendC::RoundMode::CAST_NONE, n);
        Cast(resF, resLocal, AscendC::RoundMode::CAST_NONE, n);
        Add(uLocal, uLocal, resF, n);
    }
}

template <typename T>
__aicore__ inline void Epilogue(
    LocalTensor<float>& uLocal,
    LocalTensor<float>& tmpF,
    LocalTensor<T>& gammaLocal,
    LocalTensor<T>& biasLocal,
    LocalTensor<T>& outLocal,
    GlobalTensor<T>& outGm,
    int64_t gmOffset,
    int32_t n)
{
    Cast(tmpF, gammaLocal, AscendC::RoundMode::CAST_NONE, n);
    Mul(uLocal, uLocal, tmpF, n);
    Cast(tmpF, biasLocal, AscendC::RoundMode::CAST_NONE, n);
    Add(uLocal, uLocal, tmpF, n);
    if constexpr (sizeof(T) == 4) {
        CopyOutPad(outGm, uLocal, gmOffset, n);
    } else {
        Cast(outLocal, uLocal, AscendC::RoundMode::CAST_RINT, n);
        CopyOutPad(outGm, outLocal, gmOffset, n);
    }
}

// Two-pass hierarchical row (large D). 0 GetValue per row.
template <typename T>
__aicore__ void ProcessRowTwoPass(
    GlobalTensor<T>& xGm,
    GlobalTensor<T>& resGm,
    GlobalTensor<T>& gammaGm,
    GlobalTensor<T>& biasGm,
    GlobalTensor<T>& outGm,
    LocalTensor<T>& xLocal,
    LocalTensor<T>& resLocal,
    LocalTensor<T>& gammaLocal,
    LocalTensor<T>& biasLocal,
    LocalTensor<T>& outLocal,
    LocalTensor<float>& uLocal,
    LocalTensor<float>& tmpF,
    LocalTensor<float>& sumLocal,
    LocalTensor<float>& work,
    LocalTensor<float>& inv8,
    LocalTensor<float>& tmpLocal,
    int64_t row,
    int32_t D,
    float invD,
    float eps,
    int32_t chunk)
{
    const int64_t base = row * static_cast<int64_t>(D);
    Adds(sumLocal, sumLocal, 0.0f, 1);
    for (int32_t off = 0; off < D; off += chunk) {
        int32_t n = D - off;
        if (n > chunk) {
            n = chunk;
        }
        CopyInPad(xLocal, xGm, base + off, n);
        CopyInPad(resLocal, resGm, base + off, n);
        FormU(uLocal, tmpF, xLocal, resLocal, n);
        Mul(tmpF, uLocal, uLocal, n);
        ReduceSum<float, true>(work, tmpF, tmpLocal, n);
        Add(sumLocal, sumLocal, work, 1);
    }
    BuildInvFromSum(work, inv8, sumLocal, invD, eps);
    for (int32_t off = 0; off < D; off += chunk) {
        int32_t n = D - off;
        if (n > chunk) {
            n = chunk;
        }
        CopyInPad(xLocal, xGm, base + off, n);
        CopyInPad(resLocal, resGm, base + off, n);
        FormU(uLocal, tmpF, xLocal, resLocal, n);
        ScaleByInv(uLocal, inv8, n);
        CopyInPad(gammaLocal, gammaGm, off, n);
        CopyInPad(biasLocal, biasGm, off, n);
        Epilogue(uLocal, tmpF, gammaLocal, biasLocal, outLocal, outGm, base + off, n);
    }
}

// Single-pass batch: multi-row ReduceSum + zero-VS scale. 0 GetValue per row.
// sum slots are 8B-aligned (stride 2 floats).
template <typename T>
__aicore__ void ProcessBatchSinglePass(
    GlobalTensor<T>& xGm,
    GlobalTensor<T>& resGm,
    GlobalTensor<T>& gammaGm,
    GlobalTensor<T>& biasGm,
    GlobalTensor<T>& outGm,
    LocalTensor<T>& xLocal,
    LocalTensor<T>& resLocal,
    LocalTensor<T>& gammaLocal,
    LocalTensor<T>& biasLocal,
    LocalTensor<T>& outLocal,
    LocalTensor<float>& uLocal,
    LocalTensor<float>& uSqLocal,
    LocalTensor<float>& sumLocal,
    LocalTensor<float>& work,
    LocalTensor<float>& inv8,
    LocalTensor<float>& tmpLocal,
    int64_t row0,
    int32_t B,
    int32_t D,
    float invD,
    float eps)
{
    const int32_t uRow = D;
    for (int32_t i = 0; i < B; ++i) {
        const int64_t base = (row0 + i) * static_cast<int64_t>(D);
        CopyInPad(xLocal, xGm, base, D);
        CopyInPad(resLocal, resGm, base, D);
        LocalTensor<float> uRowT = uLocal[i * uRow];
        LocalTensor<float> resF = uSqLocal[i * uRow];
        FormU(uRowT, resF, xLocal, resLocal, D);
    }
    // Multi-row ReduceSum into 8B-aligned slots sumLocal[2*i]
    for (int32_t i = 0; i < B; ++i) {
        LocalTensor<float> uRowT = uLocal[i * uRow];
        LocalTensor<float> sq = uSqLocal[i * uRow];
        Mul(sq, uRowT, uRowT, D);
        ReduceSum<float, true>(sumLocal[i * 2], sq, tmpLocal, D);
    }
    for (int32_t i = 0; i < B; ++i) {
        LocalTensor<float> uRowT = uLocal[i * uRow];
        LocalTensor<float> sum1 = sumLocal[i * 2];
        LocalTensor<float> tmp1 = uSqLocal[i * uRow];
        BuildInvFromSum(work, inv8, sum1, invD, eps);
        ScaleByInv(uRowT, inv8, D);
        const int64_t base = (row0 + i) * static_cast<int64_t>(D);
        CopyInPad(gammaLocal, gammaGm, 0, D);
        CopyInPad(biasLocal, biasGm, 0, D);
        Epilogue(uRowT, tmp1, gammaLocal, biasLocal, outLocal, outGm, base, D);
    }
}

// Golden batch: multi-row ReduceSum (aligned) + one SyncVToS + B GetValue + Muls.
// Numerics reference. V/S: 1 sync per batch + 1 GetValue per row.
template <typename T>
__aicore__ void ProcessBatchGolden(
    GlobalTensor<T>& xGm,
    GlobalTensor<T>& resGm,
    GlobalTensor<T>& gammaGm,
    GlobalTensor<T>& biasGm,
    GlobalTensor<T>& outGm,
    LocalTensor<T>& xLocal,
    LocalTensor<T>& resLocal,
    LocalTensor<T>& gammaLocal,
    LocalTensor<T>& biasLocal,
    LocalTensor<T>& outLocal,
    LocalTensor<float>& uLocal,
    LocalTensor<float>& uSqLocal,
    LocalTensor<float>& sumLocal,
    LocalTensor<float>& work,
    LocalTensor<float>& tmpLocal,
    int64_t row0,
    int32_t B,
    int32_t D,
    float invD,
    float eps)
{
    const int32_t uRow = D;
    for (int32_t i = 0; i < B; ++i) {
        const int64_t base = (row0 + i) * static_cast<int64_t>(D);
        CopyInPad(xLocal, xGm, base, D);
        CopyInPad(resLocal, resGm, base, D);
        LocalTensor<float> uRowT = uLocal[i * uRow];
        LocalTensor<float> resF = uSqLocal[i * uRow];
        FormU(uRowT, resF, xLocal, resLocal, D);
    }
    for (int32_t i = 0; i < B; ++i) {
        LocalTensor<float> uRowT = uLocal[i * uRow];
        LocalTensor<float> sq = uSqLocal[i * uRow];
        Mul(sq, uRowT, uRowT, D);
        ReduceSum<float, true>(sumLocal[i * 2], sq, tmpLocal, D);
    }
    SetFlag<HardEvent::V_S>(kEventV2S);
    WaitFlag<HardEvent::V_S>(kEventV2S);
    for (int32_t i = 0; i < B; ++i) {
        LocalTensor<float> uRowT = uLocal[i * uRow];
        LocalTensor<float> tmp1 = uSqLocal[i * uRow];
        const float sumVal = sumLocal[i * 2].GetValue(0);
        const float inv = 1.0f / std::sqrt(sumVal * invD + eps);
        Muls(uRowT, uRowT, inv, D);
        const int64_t base = (row0 + i) * static_cast<int64_t>(D);
        CopyInPad(gammaLocal, gammaGm, 0, D);
        CopyInPad(biasLocal, biasGm, 0, D);
        Epilogue(uRowT, tmp1, gammaLocal, biasLocal, outLocal, outGm, base, D);
    }
}

// Fallback golden single-row (full domain coverage).
template <typename T>
__aicore__ void ProcessRowFallback(
    GlobalTensor<T>& xGm,
    GlobalTensor<T>& resGm,
    GlobalTensor<T>& gammaGm,
    GlobalTensor<T>& biasGm,
    GlobalTensor<T>& outGm,
    LocalTensor<T>& xLocal,
    LocalTensor<T>& resLocal,
    LocalTensor<T>& gammaLocal,
    LocalTensor<T>& biasLocal,
    LocalTensor<T>& outLocal,
    LocalTensor<float>& uLocal,
    LocalTensor<float>& tmpF,
    LocalTensor<float>& sumLocal,
    LocalTensor<float>& work,
    LocalTensor<float>& tmpLocal,
    int64_t row,
    int32_t D,
    float invD,
    float eps)
{
    const int64_t base = row * static_cast<int64_t>(D);
    Adds(sumLocal, sumLocal, 0.0f, 1);
    for (int32_t off = 0; off < D; off += kFallbackTile) {
        int32_t n = D - off;
        if (n > kFallbackTile) {
            n = kFallbackTile;
        }
        CopyInPad(xLocal, xGm, base + off, n);
        CopyInPad(resLocal, resGm, base + off, n);
        FormU(uLocal, tmpF, xLocal, resLocal, n);
        Mul(tmpF, uLocal, uLocal, n);
        ReduceSum<float, true>(work, tmpF, tmpLocal, n);
        Add(sumLocal, sumLocal, work, 1);
    }
    SetFlag<HardEvent::V_S>(kEventV2S);
    WaitFlag<HardEvent::V_S>(kEventV2S);
    const float sumVal = sumLocal.GetValue(0);
    const float inv = 1.0f / std::sqrt(sumVal * invD + eps);
    for (int32_t off = 0; off < D; off += kFallbackTile) {
        int32_t n = D - off;
        if (n > kFallbackTile) {
            n = kFallbackTile;
        }
        CopyInPad(xLocal, xGm, base + off, n);
        CopyInPad(resLocal, resGm, base + off, n);
        FormU(uLocal, tmpF, xLocal, resLocal, n);
        Muls(uLocal, uLocal, inv, n);
        CopyInPad(gammaLocal, gammaGm, off, n);
        CopyInPad(biasLocal, biasGm, off, n);
        Epilogue(uLocal, tmpF, gammaLocal, biasLocal, outLocal, outGm, base + off, n);
    }
}

template <typename T>
__aicore__ void ReducexKernelImpl(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t dim, float epsilon, int64_t availableCoreNum)
{
    GlobalTensor<T> xGm, resGm, gammaGm, biasGm, outGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
    resGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual));
    gammaGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
    biasGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias));
    outGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output));

    const int32_t D = static_cast<int32_t>(dim);
    const float invD = 1.0f / static_cast<float>(D);
    const int32_t tBytes = static_cast<int32_t>(sizeof(T));

    int64_t coreNum = GetBlockNum();
    if (coreNum <= 0) {
        coreNum = 1;
    }
    if (availableCoreNum > 0 && availableCoreNum < coreNum) {
        coreNum = availableCoreNum;
    }
    const int64_t coreId = GetBlockIdx();
    const int64_t per = (rows + coreNum - 1) / coreNum;
    const int64_t row0 = coreId * per;
    int64_t row1 = row0 + per;
    if (row1 > rows) {
        row1 = rows;
    }
    if (row0 >= row1) {
        return;
    }

    const int32_t oneNative = AlignBytes32(static_cast<int64_t>(D) * tBytes);
    const int32_t oneFloat = AlignBytes32(static_cast<int64_t>(D) * 4);
    // 5 native + 2 float per row + 8KiB tmp + 512B work + 256B sum
    const int32_t overhead = kReduceTmpBytes + kWorkFloats * 4 + 512;
    const int32_t oneRowBytes = 5 * oneNative + 2 * oneFloat + overhead;
    int32_t B = 1;
    if (oneRowBytes > 0 && oneRowBytes <= kVecLocalBudget) {
        B = kVecLocalBudget / oneRowBytes;
    }
    if (B < 1) {
        B = 1;
    }
    int64_t rowsLeft = row1 - row0;
    if (static_cast<int64_t>(B) > rowsLeft) {
        B = static_cast<int32_t>(rowsLeft);
    }
    const int32_t chunk = (D > 8192) ? 8192 : D;
    const bool wide = (D > 8192);
    if (wide) {
        B = 1;
    }

    TPipe pipe;
    TBuf bX, bRes, bGamma, bBias, bOut, bU, bUSq, bSum, bWork, bInv, bTmp;
    pipe.InitBuffer(bX, static_cast<uint32_t>(oneNative));
    pipe.InitBuffer(bRes, static_cast<uint32_t>(oneNative));
    pipe.InitBuffer(bGamma, static_cast<uint32_t>(oneNative));
    pipe.InitBuffer(bBias, static_cast<uint32_t>(oneNative));
    pipe.InitBuffer(bOut, static_cast<uint32_t>(oneNative));
    pipe.InitBuffer(bU, static_cast<uint32_t>(oneFloat * B));
    pipe.InitBuffer(bUSq, static_cast<uint32_t>(oneFloat * B));
    // sum slots: stride 2 floats for 8B alignment, plus spare
    pipe.InitBuffer(bSum, static_cast<uint32_t>(AlignBytes32((2 * B + 4) * 4)));
    // Brcb one-repeat dest is 8 blocks x 32B = 256B = 64 floats
    pipe.InitBuffer(bWork, static_cast<uint32_t>(kWorkFloats * 4));
    pipe.InitBuffer(bInv, static_cast<uint32_t>(64));
    pipe.InitBuffer(bTmp, static_cast<uint32_t>(kReduceTmpBytes));

    LocalTensor<T> xLocal = bX.Get<T>();
    LocalTensor<T> resLocal = bRes.Get<T>();
    LocalTensor<T> gammaLocal = bGamma.Get<T>();
    LocalTensor<T> biasLocal = bBias.Get<T>();
    LocalTensor<T> outLocal = bOut.Get<T>();
    LocalTensor<float> uLocal = bU.Get<float>();
    LocalTensor<float> uSqLocal = bUSq.Get<float>();
    LocalTensor<float> sumLocal = bSum.Get<float>();
    LocalTensor<float> work = bWork.Get<float>();
    LocalTensor<float> inv8 = bInv.Get<float>();
    LocalTensor<float> tmpLocal = bTmp.Get<float>();

    if (wide) {
        for (int64_t r = row0; r < row1; ++r) {
            ProcessRowTwoPass<T>(
                xGm, resGm, gammaGm, biasGm, outGm,
                xLocal, resLocal, gammaLocal, biasLocal, outLocal,
                uLocal, uSqLocal, sumLocal, work, inv8, tmpLocal,
                r, D, invD, epsilon, chunk);
        }
        return;
    }

    // Golden scale for tiny rows (T01/T02/T03 class) to lock numerics.
    // Zero-VS batch for the rest of the hot path.
    const bool useGolden = (D <= 256) || (B <= 2 && D <= 1024);

    int64_t r = row0;
    while (r < row1) {
        int32_t cur = B;
        if (r + cur > row1) {
            cur = static_cast<int32_t>(row1 - r);
        }
        if (useGolden) {
            if (cur == 1) {
                ProcessRowFallback<T>(
                    xGm, resGm, gammaGm, biasGm, outGm,
                    xLocal, resLocal, gammaLocal, biasLocal, outLocal,
                    uLocal, uSqLocal, sumLocal, work, tmpLocal,
                    r, D, invD, epsilon);
            } else {
                ProcessBatchGolden<T>(
                    xGm, resGm, gammaGm, biasGm, outGm,
                    xLocal, resLocal, gammaLocal, biasLocal, outLocal,
                    uLocal, uSqLocal, sumLocal, work, tmpLocal,
                    r, cur, D, invD, epsilon);
            }
        } else {
            ProcessBatchSinglePass<T>(
                xGm, resGm, gammaGm, biasGm, outGm,
                xLocal, resLocal, gammaLocal, biasLocal, outLocal,
                uLocal, uSqLocal, sumLocal, work, inv8, tmpLocal,
                r, cur, D, invD, epsilon);
        }
        r += cur;
    }
}

__global__ __vector__ void reduce_x_fp32(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t dim, float epsilon, int64_t availableCoreNum)
{
    ReducexKernelImpl<float>(x, residual, gamma, bias, output, rows, dim, epsilon, availableCoreNum);
}

__global__ __vector__ void reduce_x_fp16(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t dim, float epsilon, int64_t availableCoreNum)
{
    ReducexKernelImpl<half>(x, residual, gamma, bias, output, rows, dim, epsilon, availableCoreNum);
}

__global__ __vector__ void reduce_x_bf16(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, int64_t dim, float epsilon, int64_t availableCoreNum)
{
    ReducexKernelImpl<bfloat16_t>(x, residual, gamma, bias, output, rows, dim, epsilon, availableCoreNum);
}

static inline int64_t FlattenRows(const TensorGroupInfo& g)
{
    if (g.numTensors <= 0 || g.tensors == nullptr) {
        return 0;
    }
    const TensorInfo& t = g.tensors[0];
    if (t.shape == nullptr || t.numDims < 2) {
        return 0;
    }
    int64_t rows = 1;
    for (int64_t i = 0; i < t.numDims - 1; ++i) {
        if (t.shape[i] <= 0) {
            return 0;
        }
        rows *= t.shape[i];
    }
    return rows;
}

static inline int64_t LastDim(const TensorGroupInfo& g)
{
    if (g.numTensors <= 0 || g.tensors == nullptr) {
        return 0;
    }
    const TensorInfo& t = g.tensors[0];
    if (t.shape == nullptr || t.numDims < 2) {
        return 0;
    }
    return t.shape[t.numDims - 1];
}

static inline int32_t GroupDtype(const TensorGroupInfo& g)
{
    if (g.numTensors <= 0 || g.tensors == nullptr) {
        return kDtypeF32;
    }
    return NormalizeDtype(g.tensors[0].dtype);
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum,
    aclrtStream stream,
    float epsilon)
{
    (void)info_residual;
    (void)info_gamma;
    (void)info_bias;
    (void)info_output;
    const int64_t rows = FlattenRows(info_x);
    const int64_t dim = LastDim(info_x);
    if (rows <= 0 || dim <= 0) {
        return;
    }
    int64_t coreNum = availableCoreNum > 0 ? availableCoreNum : 1;
    if (coreNum > rows) {
        coreNum = rows;
    }
    if (coreNum < 1) {
        coreNum = 1;
    }
    const int32_t dtype = GroupDtype(info_x);
    if (dtype == kDtypeF16) {
        reduce_x_fp16<<<coreNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, epsilon, coreNum);
    } else if (dtype == kDtypeBF16) {
        reduce_x_bf16<<<coreNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, epsilon, coreNum);
    } else {
        reduce_x_fp32<<<coreNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, epsilon, coreNum);
    }
}
