#include <acl/acl.h>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <algorithm>
#include <vector>

#include "row_copy_tiling.h"
#include "row_copy_kernel.asc"

namespace {

bool CheckAcl(aclError status, const char *operation)
{
    if (status == ACL_SUCCESS) return true;
    fprintf(stderr, "%s failed: %d\n", operation, (int)status);
    return false;
}

bool ParseU32(const char *text, uint32_t *value)
{
    char *end = nullptr;
    const unsigned long parsed = strtoul(text, &end, 10);
    if (text[0] == '\0' || end == text || *end != '\0' || parsed > UINT32_MAX) return false;
    *value = static_cast<uint32_t>(parsed);
    return true;
}

bool ValidateShape(uint32_t rows, uint32_t cols)
{
    return rows > 1 && cols >= kMinCols && cols <= kMaxCols && cols % 8 == 0;
}

uint64_t Median(std::vector<uint64_t> values)
{
    std::sort(values.begin(), values.end());
    const size_t middle = values.size() / 2;
    if (values.size() % 2 != 0) return values[middle];
    return (values[middle - 1] + values[middle]) / 2;
}

int DeviceEventBench(uint32_t rows, uint32_t cols, int deviceId,
                     uint32_t warmupLaunches, uint32_t repeats,
                     uint32_t launchesPerSample)
{
    if (!ValidateShape(rows, cols) || repeats == 0 || launchesPerSample == 0) {
        fprintf(stderr, "invalid shape or event benchmark count\n");
        return 2;
    }

    const size_t count = static_cast<size_t>(rows) * cols;
    const size_t bytes = count * sizeof(float);
    float *input = static_cast<float *>(malloc(bytes));
    float *output = static_cast<float *>(calloc(count, sizeof(float)));
    if (!input || !output) {
        free(input);
        free(output);
        return 1;
    }
    for (size_t i = 0; i < count; ++i) input[i] = static_cast<float>((i * 17 + 23) % 1009) / 31.0f;
    const RowCopyTiling tiling{rows, cols};

    bool initialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    void *inputDev = nullptr;
    void *outputDev = nullptr;
    void *tilingDev = nullptr;
    const uint32_t grid = (rows + kRowsPerBlock - 1) / kRowsPerBlock;
    std::vector<uint64_t> elapsedNs;
    int result = 1;

    if (!CheckAcl(aclInit(nullptr), "aclInit")) goto cleanup;
    initialized = true;
    if (!CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) goto cleanup;
    deviceSet = true;
    if (!CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) goto cleanup;
    if (!CheckAcl(aclrtMalloc(&inputDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(input)")) goto cleanup;
    if (!CheckAcl(aclrtMalloc(&outputDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(output)")) goto cleanup;
    if (!CheckAcl(aclrtMalloc(&tilingDev, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(tiling)")) goto cleanup;
    if (!CheckAcl(aclrtMemcpy(inputDev, bytes, input, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy input")) goto cleanup;
    if (!CheckAcl(aclrtMemcpy(tilingDev, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "copy tiling")) goto cleanup;

    printf("DEVICE_EVENT_CONFIG device=%d rows=%u D=%u warmup_launches=%u repeats=%u launches_per_sample=%u input_formula=(i*17+23)%%1009/31.0 timed_region=stream_events_around_kernel_launch_batch\n",
           deviceId, rows, cols, warmupLaunches, repeats, launchesPerSample);
    for (uint32_t i = 0; i < warmupLaunches; ++i) {
        row_copy_kernel<<<grid, nullptr, stream>>>((GM_ADDR)inputDev, (GM_ADDR)outputDev, (GM_ADDR)tilingDev);
    }
    if (!CheckAcl(aclrtSynchronizeStream(stream), "warmup synchronize")) goto cleanup;

    elapsedNs.reserve(repeats);
    for (uint32_t sample = 0; sample < repeats; ++sample) {
        aclrtEvent startEvent = nullptr;
        aclrtEvent stopEvent = nullptr;
        if (!CheckAcl(aclrtCreateEvent(&startEvent), "aclrtCreateEvent(start)")) goto cleanup;
        if (!CheckAcl(aclrtCreateEvent(&stopEvent), "aclrtCreateEvent(stop)")) {
            aclrtDestroyEvent(startEvent);
            goto cleanup;
        }
        bool sampleOk = CheckAcl(aclrtRecordEvent(startEvent, stream), "aclrtRecordEvent(start)");
        if (sampleOk) {
            for (uint32_t launch = 0; launch < launchesPerSample; ++launch) {
                row_copy_kernel<<<grid, nullptr, stream>>>((GM_ADDR)inputDev, (GM_ADDR)outputDev, (GM_ADDR)tilingDev);
            }
            sampleOk = CheckAcl(aclrtRecordEvent(stopEvent, stream), "aclrtRecordEvent(stop)");
        }
        if (sampleOk) sampleOk = CheckAcl(aclrtSynchronizeEvent(stopEvent), "aclrtSynchronizeEvent(stop)");
        float elapsedMs = 0.0f;
        if (sampleOk) sampleOk = CheckAcl(aclrtEventElapsedTime(&elapsedMs, startEvent, stopEvent), "aclrtEventElapsedTime");
        aclrtDestroyEvent(stopEvent);
        aclrtDestroyEvent(startEvent);
        if (!sampleOk) goto cleanup;

        const uint64_t sampleNs = static_cast<uint64_t>(llround(static_cast<double>(elapsedMs) * 1000000.0));
        elapsedNs.push_back(sampleNs);
        printf("DEVICE_EVENT_SAMPLE sample=%u total_ns=%llu launches=%u ns_per_launch=%.3f\n",
               sample + 1, static_cast<unsigned long long>(sampleNs), launchesPerSample,
               static_cast<double>(sampleNs) / launchesPerSample);
    }

    {
        const uint64_t medianNs = Median(elapsedNs);
        const auto bounds = std::minmax_element(elapsedNs.begin(), elapsedNs.end());
        const uint64_t jitterNs = *bounds.second - *bounds.first;
        printf("DEVICE_EVENT_SUMMARY median_total_ns=%llu median_ns_per_launch=%.3f jitter_range_total_ns=%llu jitter_range_ns_per_launch=%.3f repeats=%u launches_per_sample=%u\n",
               static_cast<unsigned long long>(medianNs),
               static_cast<double>(medianNs) / launchesPerSample,
               static_cast<unsigned long long>(jitterNs),
               static_cast<double>(jitterNs) / launchesPerSample,
               repeats, launchesPerSample);
    }

    if (!CheckAcl(aclrtMemcpy(output, bytes, outputDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy output")) goto cleanup;
    if (memcmp(input, output, bytes) != 0) {
        fprintf(stderr, "CORRECTNESS FAIL rows=%u D=%u\n", rows, cols);
        size_t reported = 0;
        for (size_t i = 0; i < count; ++i) {
            if (input[i] != output[i]) {
                fprintf(stderr, "MISMATCH index=%zu expected=%g actual=%g\n",
                        i, static_cast<double>(input[i]), static_cast<double>(output[i]));
                if (++reported == 8) break;
            }
        }
        result = 3;
        goto cleanup;
    }

    printf("NPU_EVENT_PROBE PASS device=%d rows=%u D=%u exact=1\n", deviceId, rows, cols);
    result = 0;

cleanup:
    if (stream) aclrtSynchronizeStream(stream);
    if (tilingDev) aclrtFree(tilingDev);
    if (outputDev) aclrtFree(outputDev);
    if (inputDev) aclrtFree(inputDev);
    if (stream) aclrtDestroyStream(stream);
    if (deviceSet) aclrtResetDevice(deviceId);
    if (initialized) aclFinalize();
    free(input);
    free(output);
    return result;
}

}  // namespace

int main(int argc, char **argv)
{
    uint32_t rows = 0, cols = 0, deviceId = 0, warmupLaunches = 0, repeats = 0, launchesPerSample = 0;
    if (argc == 8 && strcmp(argv[1], "--device-event-bench") == 0 &&
        ParseU32(argv[2], &rows) && ParseU32(argv[3], &cols) &&
        ParseU32(argv[4], &deviceId) && deviceId <= 7 &&
        ParseU32(argv[5], &warmupLaunches) && ParseU32(argv[6], &repeats) &&
        ParseU32(argv[7], &launchesPerSample)) {
        return DeviceEventBench(rows, cols, static_cast<int>(deviceId), warmupLaunches, repeats, launchesPerSample);
    }
    fprintf(stderr, "usage: %s --device-event-bench R D DEVICE WARMUP_LAUNCHES REPEATS LAUNCHES_PER_SAMPLE\n", argv[0]);
    return 64;
}
