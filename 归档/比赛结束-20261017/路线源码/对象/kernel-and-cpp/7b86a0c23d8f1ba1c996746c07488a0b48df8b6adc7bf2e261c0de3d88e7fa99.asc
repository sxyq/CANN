// SEQ-FUSE-2 S3 tail-cost micro-probe — mechanism bound only, NOT a performance revision.
// Measures per-row denominator-tail cost for three forms in one kernel loop so
// launch overhead is amortized and the difference is attributable to the tail:
//   variant 0 = PARENT: 2 V/S round-trips + scalar mul/add/div + Muls apply
//   variant 1 = FORM_B: pure-V chain + 1 pull + Muls apply
//   variant 2 = FORM_A: pure-V chain + 0-pull broadcast apply (SEQ-FUSE-2 V003)
// usage: tail_probe <variant> <iters> [deviceId] [valid]
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
#include <acl/acl.h>
#include <cstdio>
#include <cstdlib>
#include <cstring>

__global__ __vector__ void tail_probe_kernel(GM_ADDR outGmAddr, uint32_t variant,
                                             uint32_t iters, float invRowWidth,
                                             float epsilon, int32_t valid)
{
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tileBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> onesBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf;
    pipe.InitBuffer(tileBuf, 256 * sizeof(float));
    pipe.InitBuffer(reduceBuf, 64 * sizeof(float));
    pipe.InitBuffer(scratchBuf, 64 * sizeof(float));
    pipe.InitBuffer(onesBuf, 8 * sizeof(float));
    pipe.InitBuffer(accBuf, 8 * sizeof(float));

    AscendC::GlobalTensor<float> outGm;
    outGm.SetGlobalBuffer((__gm__ float*)outGmAddr);

    AscendC::LocalTensor<float> tile = tileBuf.Get<float>();
    AscendC::LocalTensor<float> reduceDest = reduceBuf.Get<float>();
    AscendC::LocalTensor<float> scratch = scratchBuf.Get<float>();
    AscendC::LocalTensor<float> ones8 = onesBuf.Get<float>();
    AscendC::LocalTensor<float> acc = accBuf.Get<float>();
    AscendC::Duplicate(acc, 0.0f, 8);
    // scratch layout: [0:64] Brcb dest (64 floats), [0:8] also used as meanSq8
    AscendC::LocalTensor<float> meanSq8 = scratch;
    AscendC::LocalTensor<float> invRms8 = scratch[8];

    AscendC::Duplicate(ones8, 1.0f, 8);
    AscendC::Duplicate(tile, 1.0f, valid);

    for (uint32_t i = 0; i < iters; ++i) {
        // Common seed step (identical in all variants): place squareSum at
        // reduceDest[0], value varies per iteration so the chain cannot be hoisted.
        const int32_t phase = static_cast<int32_t>(i & 7u);
        const float squareSumSeed = 4.0f + static_cast<float>(phase) * 0.125f;
        AscendC::Duplicate(reduceDest, squareSumSeed, 1);

        if (variant == 4) {
            // FLOOR: apply only (scalar Muls), no tail work at all.
            AscendC::Muls(tile, tile, 1.0000001f, valid);
        } else if (variant == 3) {
            // RT-ONLY: two V/S round-trips + scalar ops, no V-chain, to price
            // the handoffs the hypothesis aimed to remove.
            AscendC::SetFlag<AscendC::HardEvent::V_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(0);
            const float squareSum = reduceDest.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            AscendC::SetFlag<AscendC::HardEvent::S_V>(0);
            AscendC::WaitFlag<AscendC::HardEvent::S_V>(0);
            AscendC::Duplicate(scratch, meanSquare, 1);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::SetFlag<AscendC::HardEvent::V_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(0);
            const float invRms = 1.0f / scratch.GetValue(0);
            AscendC::SetFlag<AscendC::HardEvent::S_V>(0);
            AscendC::WaitFlag<AscendC::HardEvent::S_V>(0);
            AscendC::Muls(tile, tile, invRms, valid);
        } else if (variant == 0) {
            // PARENT tail: two V/S round-trips + scalar mul/add/div + Muls apply.
            AscendC::SetFlag<AscendC::HardEvent::V_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(0);
            const float squareSum = reduceDest.GetValue(0);
            const float meanSquare = squareSum * invRowWidth + epsilon;
            AscendC::SetFlag<AscendC::HardEvent::S_V>(0);
            AscendC::WaitFlag<AscendC::HardEvent::S_V>(0);
            AscendC::Duplicate(scratch, meanSquare, 1);
            AscendC::Sqrt(scratch, scratch, 1);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::SetFlag<AscendC::HardEvent::V_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(0);
            const float invRms = 1.0f / scratch.GetValue(0);
            AscendC::SetFlag<AscendC::HardEvent::S_V>(0);
            AscendC::WaitFlag<AscendC::HardEvent::S_V>(0);
            AscendC::Muls(tile, tile, invRms, valid);
        } else {
            // Pure-V chain (both Form A and Form B): Brcb + Muls/Adds/Sqrt + Div.
            AscendC::Brcb(meanSq8, reduceDest, 1, AscendC::BrcbRepeatParams(1, 8));
            AscendC::Muls(meanSq8, meanSq8, invRowWidth, 8);
            AscendC::Adds(meanSq8, meanSq8, epsilon, 8);
            AscendC::Sqrt(meanSq8, meanSq8, 8);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(invRms8, ones8, meanSq8, 8);
            AscendC::PipeBarrier<PIPE_V>();
            if (variant == 1) {
                // FORM_B apply: single pull + scalar Muls.
                AscendC::SetFlag<AscendC::HardEvent::V_S>(0);
                AscendC::WaitFlag<AscendC::HardEvent::V_S>(0);
                const float invRms = invRms8.GetValue(0);
                AscendC::SetFlag<AscendC::HardEvent::S_V>(0);
                AscendC::WaitFlag<AscendC::HardEvent::S_V>(0);
                AscendC::Muls(tile, tile, invRms, valid);
            } else {
                // FORM_A apply (V003): Level-0 Mul, src1 block/repeat stride 0.
                const AscendC::BinaryRepeatParams params(1, 1, 0, 8, 8, 0);
                int32_t done = 0;
                while (done < valid) {
                    const int32_t remain = valid - done;
                    const int32_t reps = remain / 64;
                    if (reps > 0) {
                        const uint8_t r = static_cast<uint8_t>(reps > 255 ? 255 : reps);
                        AscendC::Mul<float, true>(tile[done], tile[done], invRms8,
                                                  static_cast<uint64_t>(64), r, params);
                        done += static_cast<int32_t>(r) * 64;
                    } else {
                        AscendC::Mul<float, true>(tile[done], tile[done], invRms8,
                                                  static_cast<uint64_t>(remain),
                                                  static_cast<uint8_t>(1), params);
                        done += remain;
                    }
                }
            }
        }
        // UB-side accumulation keeps the loop free of extra V/S pulls so the
        // measured delta is attributable to the tail + apply only.
        AscendC::Add(acc, acc, tile, 1);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::DataCopy(outGm[0], acc, 8);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
}

extern "C" void run_tail_probe(GM_ADDR out, uint32_t variant, uint32_t iters,
                               float invRowWidth, float epsilon, int32_t valid,
                               aclrtStream stream)
{
    tail_probe_kernel<<<1, nullptr, stream>>>(out, variant, iters, invRowWidth,
                                              epsilon, valid);
}

static bool CheckAcl(aclError s, const char* op)
{
    if (s == ACL_SUCCESS) return true;
    std::fprintf(stderr, "ACL_FAIL %s=%d\n", op, (int)s);
    return false;
}

int main(int argc, char** argv)
{
    if (argc < 3) {
        std::fprintf(stderr, "usage: %s variant iters [deviceId] [valid]\n", argv[0]);
        return 2;
    }
    const int variant = std::atoi(argv[1]);
    const int iters = std::atoi(argv[2]);
    const int deviceId = argc > 3 ? std::atoi(argv[3]) : 5;
    const int valid = argc > 4 ? std::atoi(argv[4]) : 256;
    if (variant < 0 || variant > 4 || iters < 1 || valid < 8 || valid > 256) {
        std::fprintf(stderr, "bad args\n");
        return 2;
    }

    if (!CheckAcl(aclInit(nullptr), "aclInit")) return 1;
    if (!CheckAcl(aclrtSetDevice(deviceId), "setDevice")) return 1;
    aclrtStream stream = nullptr;
    if (!CheckAcl(aclrtCreateStream(&stream), "stream")) return 1;
    void* outD = nullptr;
    if (!CheckAcl(aclrtMalloc(&outD, sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc")) return 1;

    const float invRowWidth = 1.0f / 256.0f;
    const float epsilon = 1.0e-5f;

    // Warmup (untimed).
    for (int i = 0; i < 3; ++i) {
        run_tail_probe((GM_ADDR)outD, variant, 100, invRowWidth, epsilon, valid, stream);
    }
    if (!CheckAcl(aclrtSynchronizeStream(stream), "warmup sync")) return 1;

    aclrtEvent evStart = nullptr, evStop = nullptr;
    if (!CheckAcl(aclrtCreateEvent(&evStart), "evStart")) return 1;
    if (!CheckAcl(aclrtCreateEvent(&evStop), "evStop")) return 1;

    // 5 timed reps of the whole loop; report each + median.
    double reps_us[5] = {0};
    for (int rep = 0; rep < 5; ++rep) {
        if (!CheckAcl(aclrtRecordEvent(evStart, stream), "rec start")) return 1;
        run_tail_probe((GM_ADDR)outD, variant, iters, invRowWidth, epsilon, valid, stream);
        if (!CheckAcl(aclrtRecordEvent(evStop, stream), "rec stop")) return 1;
        if (!CheckAcl(aclrtSynchronizeEvent(evStop), "sync ev")) return 1;
        float ms = 0.0f;
        if (!CheckAcl(aclrtEventElapsedTime(&ms, evStart, evStop), "elapsed")) return 1;
        reps_us[rep] = static_cast<double>(ms) * 1000.0;
        std::printf("REP variant=%d rep=%d iters=%d valid=%d total_us=%.3f us_per_row=%.6f\n",
                    variant, rep, iters, valid, reps_us[rep], reps_us[rep] / iters);
    }

    double sorted[5];
    std::memcpy(sorted, reps_us, sizeof(sorted));
    for (int a = 0; a < 5; ++a)
        for (int b = a + 1; b < 5; ++b)
            if (sorted[b] < sorted[a]) { double t = sorted[a]; sorted[a] = sorted[b]; sorted[b] = t; }
    const double med = sorted[2];
    std::printf("RESULT variant=%d median_total_us=%.3f median_us_per_row=%.6f\n",
                variant, med, med / iters);
    std::fflush(stdout);

    aclrtFree(outD);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
