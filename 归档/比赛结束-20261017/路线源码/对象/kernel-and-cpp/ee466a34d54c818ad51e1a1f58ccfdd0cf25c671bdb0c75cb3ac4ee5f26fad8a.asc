#include <acl/acl.h>
#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <numeric>
#include <vector>
#include "kernel_operator.h"

struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};

namespace parent_kernel {
#define run_kernel sync_parent_run_kernel
#include "../parent.asc"
#undef run_kernel
}

namespace candidate_kernel {
#define run_kernel sync_candidate_run_kernel
#include "../submission.asc"
#undef run_kernel
}

namespace {

struct Case { int rows; int width; };

struct DeviceEvents {
    aclrtEvent start = nullptr;
    aclrtEvent stop = nullptr;
    bool recorded = false;
};

struct Timing {
    double deviceUs;
    double wallUs;
};

struct Summary {
    double median;
    double mean;
    double stdev;
    double cv;
    double minimum;
    double maximum;
    double mad;
    double p10;
    double p90;
};

using KernelFunction = decltype(&parent_kernel::sync_parent_run_kernel);

void CheckAcl(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL_FAIL operation=%s status=%d\n", operation,
                     static_cast<int>(status));
        std::exit(2);
    }
}

double Quantile(const std::vector<double>& sorted, double fraction)
{
    const double position = fraction * static_cast<double>(sorted.size() - 1);
    const size_t lower = static_cast<size_t>(position);
    const size_t upper = std::min(lower + 1, sorted.size() - 1);
    const double weight = position - static_cast<double>(lower);
    return sorted[lower] * (1.0 - weight) + sorted[upper] * weight;
}

Summary Summarize(const std::vector<double>& values)
{
    std::vector<double> sorted = values;
    std::sort(sorted.begin(), sorted.end());
    const double median = Quantile(sorted, 0.5);
    const double mean = std::accumulate(values.begin(), values.end(), 0.0) /
                        static_cast<double>(values.size());
    double variance = 0.0;
    std::vector<double> deviations;
    deviations.reserve(values.size());
    for (double value : values) {
        const double delta = value - mean;
        variance += delta * delta;
        deviations.push_back(std::fabs(value - median));
    }
    std::sort(deviations.begin(), deviations.end());
    const double stdev = values.size() > 1
        ? std::sqrt(variance / static_cast<double>(values.size() - 1)) : 0.0;
    return {median, mean, stdev, mean == 0.0 ? 0.0 : stdev / mean,
            sorted.front(), sorted.back(), Quantile(deviations, 0.5),
            Quantile(sorted, 0.10), Quantile(sorted, 0.90)};
}

void PrintSummary(const char* name, const char* metric, const char* binary,
                  const std::vector<double>& values)
{
    const Summary s = Summarize(values);
    std::printf("LOCAL_STATS case=%s metric=%s binary=%s n=%zu median=%.4f mean=%.4f stdev=%.4f cv=%.5f min=%.4f max=%.4f mad=%.4f p10=%.4f p90=%.4f\n",
                name, metric, binary, values.size(), s.median, s.mean, s.stdev,
                s.cv, s.minimum, s.maximum, s.mad, s.p10, s.p90);
}

Timing Measure(KernelFunction kernel, void* output, void* dx, void* dr, void* dg, void* db,
               const TensorGroupInfo& dataGroup, const TensorGroupInfo& paramGroup,
               aclrtStream stream, DeviceEvents& events)
{
    if (events.recorded) {
        CheckAcl(aclrtResetEvent(events.start, stream), "reset_start_event");
        CheckAcl(aclrtResetEvent(events.stop, stream), "reset_stop_event");
    }
    const auto wallStart = std::chrono::steady_clock::now();
    CheckAcl(aclrtRecordEvent(events.start, stream), "record_start_event");
    kernel(static_cast<uint8_t*>(dx), dataGroup, static_cast<uint8_t*>(dr), dataGroup,
           static_cast<uint8_t*>(dg), paramGroup, static_cast<uint8_t*>(db), paramGroup,
           static_cast<uint8_t*>(output), dataGroup, 8, stream, 1.0e-5f);
    CheckAcl(aclrtRecordEvent(events.stop, stream), "record_stop_event");
    CheckAcl(aclrtSynchronizeEvent(events.stop), "sync_stop_event");
    const auto wallStop = std::chrono::steady_clock::now();
    events.recorded = true;
    float elapsedMs = 0.0f;
    CheckAcl(aclrtEventElapsedTime(&elapsedMs, events.start, events.stop), "event_elapsed");
    return {static_cast<double>(elapsedMs) * 1000.0,
            std::chrono::duration<double, std::micro>(wallStop - wallStart).count()};
}

double GElementsPerSecond(double deviceUs, size_t elementCount)
{
    return deviceUs <= 0.0 ? 0.0
                           : static_cast<double>(elementCount) / deviceUs / 1000.0;
}

uint16_t ToHalf(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const uint32_t sign = (bits >> 16) & 0x8000u;
    const uint32_t exponent = (bits >> 23) & 0xffu;
    uint32_t mantissa = bits & 0x7fffffu;
    if (exponent == 0xffu) {
        return static_cast<uint16_t>(sign | 0x7c00u | (mantissa ? 0x0200u : 0u));
    }
    int32_t halfExponent = static_cast<int32_t>(exponent) - 112;
    if (halfExponent >= 31) return static_cast<uint16_t>(sign | 0x7c00u);
    if (halfExponent <= 0) {
        if (halfExponent < -10) return static_cast<uint16_t>(sign);
        mantissa |= 0x800000u;
        const int32_t shift = 14 - halfExponent;
        const uint32_t round = (1u << (shift - 1)) - 1u + ((mantissa >> shift) & 1u);
        return static_cast<uint16_t>(sign | ((mantissa + round) >> shift));
    }
    mantissa += 0xfffu + ((mantissa >> 13) & 1u);
    if (mantissa & 0x800000u) {
        mantissa = 0;
        ++halfExponent;
        if (halfExponent >= 31) return static_cast<uint16_t>(sign | 0x7c00u);
    }
    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(halfExponent) << 10) |
                                 (mantissa >> 13));
}

uint16_t ToBFloat16(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    bits += 0x7fffu + ((bits >> 16) & 1u);
    return static_cast<uint16_t>(bits >> 16);
}

uint16_t Encode(float value, int32_t dtype)
{
    return dtype == 2 ? ToBFloat16(value) : ToHalf(value);
}

const char* DtypeName(int32_t dtype)
{
    return dtype == 2 ? "bf16" : "fp16";
}

void RunCase(const Case& testCase, aclrtStream stream, int device, int32_t dtype)
{
    const size_t count = static_cast<size_t>(testCase.rows) * testCase.width;
    const size_t dataBytes = count * sizeof(uint16_t);
    const size_t paramBytes = static_cast<size_t>(testCase.width) * sizeof(uint16_t);
    std::vector<uint16_t> x(count), residual(count), gamma(testCase.width), bias(testCase.width);
    std::vector<uint16_t> parentOutput(count), candidateOutput(count);
    for (size_t i = 0; i < count; ++i) {
        const float xv = 0.19f * std::sin(static_cast<float>((i * 17) % 997) * 0.013f);
        const float rv = 0.11f * std::cos(static_cast<float>((i * 29) % 991) * 0.017f);
        x[i] = Encode(xv, dtype);
        residual[i] = Encode(rv, dtype);
    }
    for (int col = 0; col < testCase.width; ++col) {
        gamma[col] = Encode(0.85f + static_cast<float>(col % 23) * 0.002f, dtype);
        bias[col] = Encode(-0.025f + static_cast<float>(col % 19) * 0.001f, dtype);
    }

    void *dx = nullptr, *dr = nullptr, *dg = nullptr, *db = nullptr;
    void *dp = nullptr, *dc = nullptr;
    CheckAcl(aclrtMalloc(&dx, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc_x");
    CheckAcl(aclrtMalloc(&dr, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc_residual");
    CheckAcl(aclrtMalloc(&dg, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc_gamma");
    CheckAcl(aclrtMalloc(&db, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc_bias");
    CheckAcl(aclrtMalloc(&dp, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc_parent_output");
    CheckAcl(aclrtMalloc(&dc, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc_candidate_output");
    CheckAcl(aclrtMemcpy(dx, dataBytes, x.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy_x");
    CheckAcl(aclrtMemcpy(dr, dataBytes, residual.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy_residual");
    CheckAcl(aclrtMemcpy(dg, paramBytes, gamma.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy_gamma");
    CheckAcl(aclrtMemcpy(db, paramBytes, bias.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy_bias");

    const int64_t dataShape[] = {testCase.rows, testCase.width};
    const int64_t paramShape[] = {testCase.width};
    const TensorInfo dataInfo{dataShape, 2, dtype};
    const TensorInfo paramInfo{paramShape, 1, dtype};
    const TensorGroupInfo dataGroup{&dataInfo, 1};
    const TensorGroupInfo paramGroup{&paramInfo, 1};
    parent_kernel::sync_parent_run_kernel(
        static_cast<uint8_t*>(dx), dataGroup, static_cast<uint8_t*>(dr), dataGroup,
        static_cast<uint8_t*>(dg), paramGroup, static_cast<uint8_t*>(db), paramGroup,
        static_cast<uint8_t*>(dp), dataGroup,
        8, stream, 1.0e-5f);
    CheckAcl(aclrtSynchronizeStream(stream), "sync_parent");
    candidate_kernel::sync_candidate_run_kernel(
        static_cast<uint8_t*>(dx), dataGroup, static_cast<uint8_t*>(dr), dataGroup,
        static_cast<uint8_t*>(dg), paramGroup, static_cast<uint8_t*>(db), paramGroup,
        static_cast<uint8_t*>(dc), dataGroup,
        8, stream, 1.0e-5f);
    CheckAcl(aclrtSynchronizeStream(stream), "sync_candidate");
    CheckAcl(aclrtMemcpy(parentOutput.data(), dataBytes, dp, dataBytes,
                         ACL_MEMCPY_DEVICE_TO_HOST), "read_parent");
    CheckAcl(aclrtMemcpy(candidateOutput.data(), dataBytes, dc, dataBytes,
                         ACL_MEMCPY_DEVICE_TO_HOST), "read_candidate");

    size_t mismatchCount = 0;
    for (size_t i = 0; i < count; ++i) {
        if (parentOutput[i] != candidateOutput[i]) ++mismatchCount;
    }
    const char* result = mismatchCount == 0 ? "PASS" : "FAIL";
    std::printf("CORRECTNESS device=%d dtype=%s rows=%d width=%d parent_candidate_bit_mismatch=%zu result=%s\n",
                device, DtypeName(dtype), testCase.rows, testCase.width, mismatchCount, result);

    CheckAcl(aclrtFree(dc), "free_candidate_output");
    CheckAcl(aclrtFree(dp), "free_parent_output");
    CheckAcl(aclrtFree(db), "free_bias");
    CheckAcl(aclrtFree(dg), "free_gamma");
    CheckAcl(aclrtFree(dr), "free_residual");
    CheckAcl(aclrtFree(dx), "free_x");
    if (mismatchCount != 0) std::exit(3);
}

void RunSameBinaryQualification(aclrtStream stream, int device, bool candidateBinary,
                                int32_t dtype)
{
    constexpr int rows = 128;
    constexpr int width = 256;
    constexpr int warmup = 60;
    constexpr int pairs = 31;
    const size_t count = static_cast<size_t>(rows) * width;
    const size_t dataBytes = count * sizeof(uint16_t);
    const size_t paramBytes = static_cast<size_t>(width) * sizeof(uint16_t);
    std::vector<uint16_t> x(count), residual(count), gamma(width), bias(width);
    for (size_t i = 0; i < count; ++i) {
        x[i] = Encode(0.19f * std::sin(static_cast<float>((i * 17) % 997) * 0.013f), dtype);
        residual[i] = Encode(0.11f * std::cos(static_cast<float>((i * 29) % 991) * 0.017f), dtype);
    }
    for (int col = 0; col < width; ++col) {
        gamma[col] = Encode(0.85f + static_cast<float>(col % 23) * 0.002f, dtype);
        bias[col] = Encode(-0.025f + static_cast<float>(col % 19) * 0.001f, dtype);
    }
    void *dx = nullptr, *dr = nullptr, *dg = nullptr, *db = nullptr;
    void *firstOutput = nullptr, *secondOutput = nullptr;
    CheckAcl(aclrtMalloc(&dx, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "qual_malloc_x");
    CheckAcl(aclrtMalloc(&dr, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "qual_malloc_residual");
    CheckAcl(aclrtMalloc(&dg, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST), "qual_malloc_gamma");
    CheckAcl(aclrtMalloc(&db, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST), "qual_malloc_bias");
    CheckAcl(aclrtMalloc(&firstOutput, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "qual_malloc_first_output");
    CheckAcl(aclrtMalloc(&secondOutput, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "qual_malloc_second_output");
    CheckAcl(aclrtMemcpy(dx, dataBytes, x.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "qual_copy_x");
    CheckAcl(aclrtMemcpy(dr, dataBytes, residual.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "qual_copy_residual");
    CheckAcl(aclrtMemcpy(dg, paramBytes, gamma.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "qual_copy_gamma");
    CheckAcl(aclrtMemcpy(db, paramBytes, bias.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "qual_copy_bias");

    const int64_t dataShape[] = {rows, width};
    const int64_t paramShape[] = {width};
    const TensorInfo dataInfo{dataShape, 2, dtype};
    const TensorInfo paramInfo{paramShape, 1, dtype};
    const TensorGroupInfo dataGroup{&dataInfo, 1};
    const TensorGroupInfo paramGroup{&paramInfo, 1};
    const KernelFunction kernel = candidateBinary
        ? candidate_kernel::sync_candidate_run_kernel
        : parent_kernel::sync_parent_run_kernel;
    const char* binaryName = candidateBinary ? "CANDIDATE_V077" : "PARENT_R31B_V011";
    const char* dtypeName = DtypeName(dtype);
    for (int i = 0; i < warmup; ++i) {
        kernel(static_cast<uint8_t*>(dx), dataGroup, static_cast<uint8_t*>(dr), dataGroup,
               static_cast<uint8_t*>(dg), paramGroup, static_cast<uint8_t*>(db), paramGroup,
               static_cast<uint8_t*>(firstOutput), dataGroup, 8, stream, 1.0e-5f);
        CheckAcl(aclrtSynchronizeStream(stream), "qual_warmup_sync");
    }

    DeviceEvents events;
    CheckAcl(aclrtCreateEvent(&events.start), "qual_create_start_event");
    CheckAcl(aclrtCreateEvent(&events.stop), "qual_create_stop_event");
    std::vector<double> firstDevice, secondDevice, deltas, firstWall, secondWall;
    std::vector<double> firstThroughput, secondThroughput;
    firstDevice.reserve(pairs);
    secondDevice.reserve(pairs);
    deltas.reserve(pairs);
    firstWall.reserve(pairs);
    secondWall.reserve(pairs);
    firstThroughput.reserve(pairs);
    secondThroughput.reserve(pairs);
    for (int pair = 0; pair < pairs; ++pair) {
        const bool firstOutputA = (pair % 2) == 0;
        Timing first = Measure(kernel, firstOutputA ? firstOutput : secondOutput,
                               dx, dr, dg, db, dataGroup, paramGroup, stream, events);
        Timing second = Measure(kernel, firstOutputA ? secondOutput : firstOutput,
                                dx, dr, dg, db, dataGroup, paramGroup, stream, events);
        const double delta = second.deviceUs - first.deviceUs;
        firstDevice.push_back(first.deviceUs);
        secondDevice.push_back(second.deviceUs);
        deltas.push_back(delta);
        firstWall.push_back(first.wallUs);
        secondWall.push_back(second.wallUs);
        firstThroughput.push_back(GElementsPerSecond(first.deviceUs, count));
        secondThroughput.push_back(GElementsPerSecond(second.deviceUs, count));
        std::printf("SAME_BINARY_SAMPLE binary=%s case=%s-128x256 pair=%02d order=%s first_device_us=%.4f second_device_us=%.4f first_gelem_s=%.6f second_gelem_s=%.6f first_wall_us=%.4f second_wall_us=%.4f second_minus_first_us=%.4f\n",
                    binaryName, dtypeName, pair + 1, firstOutputA ? "A,B" : "B,A",
                    first.deviceUs, second.deviceUs,
                    firstThroughput.back(), secondThroughput.back(),
                    first.wallUs, second.wallUs, delta);
    }
    PrintSummary(binaryName, "device_us", "same_binary_first", firstDevice);
    PrintSummary(binaryName, "device_us", "same_binary_second", secondDevice);
    PrintSummary(binaryName, "paired_delta_us", "same_binary_second_minus_first", deltas);
    PrintSummary(binaryName, "gelem_s", "same_binary_first", firstThroughput);
    PrintSummary(binaryName, "gelem_s", "same_binary_second", secondThroughput);
    PrintSummary(binaryName, "wall_us", "same_binary_first", firstWall);
    PrintSummary(binaryName, "wall_us", "same_binary_second", secondWall);
    const Summary firstStats = Summarize(firstDevice);
    const Summary secondStats = Summarize(secondDevice);
    const double medianMean = (firstStats.median + secondStats.median) / 2.0;
    const double medianDrift = medianMean == 0.0 ? 0.0
        : std::fabs(firstStats.median - secondStats.median) / medianMean;
    std::printf("SAME_BINARY_QUALIFICATION binary=%s case=%s-128x256 samples=%d first_mad_over_median=%.6f second_mad_over_median=%.6f median_drift_fraction=%.6f\n",
                binaryName, dtypeName, pairs,
                firstStats.median == 0.0 ? 0.0 : firstStats.mad / firstStats.median,
                secondStats.median == 0.0 ? 0.0 : secondStats.mad / secondStats.median,
                medianDrift);
    CheckAcl(aclrtDestroyEvent(events.stop), "qual_destroy_stop_event");
    CheckAcl(aclrtDestroyEvent(events.start), "qual_destroy_start_event");
    CheckAcl(aclrtFree(secondOutput), "qual_free_second_output");
    CheckAcl(aclrtFree(firstOutput), "qual_free_first_output");
    CheckAcl(aclrtFree(db), "qual_free_bias");
    CheckAcl(aclrtFree(dg), "qual_free_gamma");
    CheckAcl(aclrtFree(dr), "qual_free_residual");
    CheckAcl(aclrtFree(dx), "qual_free_x");
    std::printf("SAME_BINARY_SUMMARY binary=%s device=%d shape=128x256 dtype=%s samples=%d\n",
                binaryName, device, dtypeName, pairs);
}

void RunLocalCase(aclrtStream stream, int device, int32_t dtype)
{
    constexpr int rows = 128;
    constexpr int width = 256;
    constexpr int warmup = 60;
    constexpr int pairs = 31;
    const size_t count = static_cast<size_t>(rows) * width;
    const size_t dataBytes = count * sizeof(uint16_t);
    const size_t paramBytes = static_cast<size_t>(width) * sizeof(uint16_t);
    std::vector<uint16_t> x(count), residual(count), gamma(width), bias(width);
    for (size_t i = 0; i < count; ++i) {
        x[i] = Encode(0.19f * std::sin(static_cast<float>((i * 17) % 997) * 0.013f), dtype);
        residual[i] = Encode(0.11f * std::cos(static_cast<float>((i * 29) % 991) * 0.017f), dtype);
    }
    for (int col = 0; col < width; ++col) {
        gamma[col] = Encode(0.85f + static_cast<float>(col % 23) * 0.002f, dtype);
        bias[col] = Encode(-0.025f + static_cast<float>(col % 19) * 0.001f, dtype);
    }
    void *dx = nullptr, *dr = nullptr, *dg = nullptr, *db = nullptr;
    void *dp = nullptr, *dc = nullptr;
    CheckAcl(aclrtMalloc(&dx, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "local_malloc_x");
    CheckAcl(aclrtMalloc(&dr, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "local_malloc_residual");
    CheckAcl(aclrtMalloc(&dg, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST), "local_malloc_gamma");
    CheckAcl(aclrtMalloc(&db, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST), "local_malloc_bias");
    CheckAcl(aclrtMalloc(&dp, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "local_malloc_parent");
    CheckAcl(aclrtMalloc(&dc, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "local_malloc_candidate");
    CheckAcl(aclrtMemcpy(dx, dataBytes, x.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "local_copy_x");
    CheckAcl(aclrtMemcpy(dr, dataBytes, residual.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "local_copy_residual");
    CheckAcl(aclrtMemcpy(dg, paramBytes, gamma.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "local_copy_gamma");
    CheckAcl(aclrtMemcpy(db, paramBytes, bias.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "local_copy_bias");
    const int64_t dataShape[] = {rows, width};
    const int64_t paramShape[] = {width};
    const TensorInfo dataInfo{dataShape, 2, dtype};
    const TensorInfo paramInfo{paramShape, 1, dtype};
    const TensorGroupInfo dataGroup{&dataInfo, 1};
    const TensorGroupInfo paramGroup{&paramInfo, 1};
    for (int i = 0; i < warmup; ++i) {
        parent_kernel::sync_parent_run_kernel(
            static_cast<uint8_t*>(dx), dataGroup, static_cast<uint8_t*>(dr), dataGroup,
            static_cast<uint8_t*>(dg), paramGroup, static_cast<uint8_t*>(db), paramGroup,
            static_cast<uint8_t*>(dp), dataGroup, 8, stream, 1.0e-5f);
        CheckAcl(aclrtSynchronizeStream(stream), "local_parent_warmup");
        candidate_kernel::sync_candidate_run_kernel(
            static_cast<uint8_t*>(dx), dataGroup, static_cast<uint8_t*>(dr), dataGroup,
            static_cast<uint8_t*>(dg), paramGroup, static_cast<uint8_t*>(db), paramGroup,
            static_cast<uint8_t*>(dc), dataGroup, 8, stream, 1.0e-5f);
        CheckAcl(aclrtSynchronizeStream(stream), "local_candidate_warmup");
    }
    DeviceEvents events;
    CheckAcl(aclrtCreateEvent(&events.start), "local_create_start_event");
    CheckAcl(aclrtCreateEvent(&events.stop), "local_create_stop_event");
    std::vector<double> parentDevice, candidateDevice, deltas, parentWall, candidateWall;
    std::vector<double> parentThroughput, candidateThroughput;
    parentDevice.reserve(pairs);
    candidateDevice.reserve(pairs);
    deltas.reserve(pairs);
    parentWall.reserve(pairs);
    candidateWall.reserve(pairs);
    parentThroughput.reserve(pairs);
    candidateThroughput.reserve(pairs);
    for (int pair = 0; pair < pairs; ++pair) {
        const bool parentFirst = (pair % 2) == 0;
        Timing parent{}, candidate{};
        if (parentFirst) {
            parent = Measure(parent_kernel::sync_parent_run_kernel, dp, dx, dr, dg, db,
                             dataGroup, paramGroup, stream, events);
            candidate = Measure(candidate_kernel::sync_candidate_run_kernel, dc, dx, dr, dg, db,
                                dataGroup, paramGroup, stream, events);
        } else {
            candidate = Measure(candidate_kernel::sync_candidate_run_kernel, dc, dx, dr, dg, db,
                                dataGroup, paramGroup, stream, events);
            parent = Measure(parent_kernel::sync_parent_run_kernel, dp, dx, dr, dg, db,
                             dataGroup, paramGroup, stream, events);
        }
        parentDevice.push_back(parent.deviceUs);
        candidateDevice.push_back(candidate.deviceUs);
        parentWall.push_back(parent.wallUs);
        candidateWall.push_back(candidate.wallUs);
        deltas.push_back(candidate.deviceUs - parent.deviceUs);
        parentThroughput.push_back(GElementsPerSecond(parent.deviceUs, count));
        candidateThroughput.push_back(GElementsPerSecond(candidate.deviceUs, count));
        std::printf("LOCAL_SAMPLE case=%s-128x256 pair=%02d order=%s parent_device_us=%.4f candidate_device_us=%.4f parent_gelem_s=%.6f candidate_gelem_s=%.6f parent_wall_us=%.4f candidate_wall_us=%.4f paired_delta_us=%.4f\n",
                    DtypeName(dtype), pair + 1, parentFirst ? "P,C" : "C,P", parent.deviceUs,
                    candidate.deviceUs, parentThroughput.back(), candidateThroughput.back(),
                    parent.wallUs, candidate.wallUs,
                    candidate.deviceUs - parent.deviceUs);
    }
    PrintSummary("bf16-128x256", "device_us", "PARENT_R31B_V011", parentDevice);
    PrintSummary("bf16-128x256", "device_us", "CANDIDATE_V077", candidateDevice);
    PrintSummary("bf16-128x256", "wall_us", "PARENT_R31B_V011", parentWall);
    PrintSummary("bf16-128x256", "wall_us", "CANDIDATE_V077", candidateWall);
    PrintSummary("bf16-128x256", "gelem_s", "PARENT_R31B_V011", parentThroughput);
    PrintSummary("bf16-128x256", "gelem_s", "CANDIDATE_V077", candidateThroughput);
    PrintSummary("bf16-128x256", "paired_delta_us", "CANDIDATE_MINUS_PARENT", deltas);
    const Summary parentStats = Summarize(parentDevice);
    const Summary candidateStats = Summarize(candidateDevice);
    const Summary deltaStats = Summarize(deltas);
    const double score = parentStats.median == 0.0
        ? 0.0 : -100.0 * deltaStats.median / parentStats.median;
    std::printf("LOCAL_RESULT route=SYNC-BARRIER-ELISION-X revision=V077 device=%d shape=128x256 dtype=bf16 samples=%d parent_median_us=%.4f candidate_median_us=%.4f parent_median_gelem_s=%.6f candidate_median_gelem_s=%.6f local_delta_us=%.4f local_score_percent=%.6f candidate_minus_parent_percent=%.6f\n",
                device, pairs, parentStats.median, candidateStats.median,
                GElementsPerSecond(parentStats.median, count),
                GElementsPerSecond(candidateStats.median, count),
                deltaStats.median, score,
                parentStats.median == 0.0 ? 0.0 : 100.0 * deltaStats.median / parentStats.median);
    CheckAcl(aclrtDestroyEvent(events.stop), "local_destroy_stop_event");
    CheckAcl(aclrtDestroyEvent(events.start), "local_destroy_start_event");
    CheckAcl(aclrtFree(dc), "local_free_candidate");
    CheckAcl(aclrtFree(dp), "local_free_parent");
    CheckAcl(aclrtFree(db), "local_free_bias");
    CheckAcl(aclrtFree(dg), "local_free_gamma");
    CheckAcl(aclrtFree(dr), "local_free_residual");
    CheckAcl(aclrtFree(dx), "local_free_x");
}

}  // namespace

int main(int argc, char** argv)
{
    const int device = argc > 1 ? std::atoi(argv[1]) : 3;
    const char* mode = argc > 2 ? argv[2] : "";
    const int32_t dtype = argc > 3 && std::strcmp(argv[3], "--bf16") == 0 ? 2 : 1;
    CheckAcl(aclInit(nullptr), "aclInit");
    CheckAcl(aclrtSetDevice(device), "aclrtSetDevice");
    aclrtStream stream = nullptr;
    CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
    if (std::strcmp(mode, "--local") == 0) {
        RunLocalCase(stream, device, dtype);
    } else if (std::strcmp(mode, "--same-parent") == 0) {
        RunSameBinaryQualification(stream, device, false, dtype);
    } else if (std::strcmp(mode, "--same-candidate") == 0) {
        RunSameBinaryQualification(stream, device, true, dtype);
    } else {
        const Case cases[] = {{8, 128}, {8, 256}, {8, 1024}, {8, 2048}, {8, 4096}, {16, 2064}, {128, 128}, {128, 256}};
        for (const Case& testCase : cases) RunCase(testCase, stream, device, 1);
        RunCase({128, 256}, stream, device, 2);
        std::printf("CORRECTNESS_SUMMARY result=PASS cases=9\n");
    }
    CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
    CheckAcl(aclFinalize(), "aclFinalize");
    return 0;
}
