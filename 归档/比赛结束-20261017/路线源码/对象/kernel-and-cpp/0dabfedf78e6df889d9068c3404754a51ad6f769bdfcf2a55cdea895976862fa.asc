// I001 V001 — Wide-D AddRmsNormBias
// Architecture: retained-y row path + large-tile two-pass streaming + low-sync D-stripe.
// Submission file: do NOT redefine TensorInfo / TensorGroupInfo.
// dtype encoding: 0=FP32, 1=FP16, 2=BF16

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {

constexpr int32_t kMaxTile = 2048;
constexpr int32_t kVecCores = 40;
constexpr int64_t kRetainBytesBudget = 150 * 1024;

#define I001_CEIL_DIV(a, b) (((a) + (b) - 1) / (b))

inline void ShapeFromInfo(const TensorGroupInfo* info, int64_t& rows, int64_t& cols, int32_t& dtype)
{
    const TensorInfo& t = info->tensors[0];
    cols = t.shape[t.numDims - 1];
    rows = 1;
    for (int64_t i = 0; i < t.numDims - 1; ++i) {
        rows *= t.shape[i];
    }
    dtype = t.dtype;
}

template <typename T>
__aicore__ inline void LoadTile(
    AscendC::GlobalTensor<T>& gm, AscendC::LocalTensor<T>& ub, int64_t colBase, int32_t n)
{
    AscendC::DataCopyExtParams cp(1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
    AscendC::DataCopyPad(ub, gm[colBase], cp, pad);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T>
__aicore__ inline void StoreTile(
    AscendC::GlobalTensor<T>& gm, AscendC::LocalTensor<T>& ub, int64_t colBase, int32_t n)
{
    AscendC::DataCopyExtParams cp(1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0);
    AscendC::DataCopyPad(gm[colBase], ub, cp);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// u = x + residual, accumulate sum(u*u) into *ss, optionally keep u in uKeep.
template <typename T>
__aicore__ inline void AccSqSum(
    AscendC::GlobalTensor<T>& xGm, AscendC::GlobalTensor<T>& rGm,
    AscendC::LocalTensor<T>& xU, AscendC::LocalTensor<T>& rU,
    AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
    AscendC::LocalTensor<float>& reduceTmp,
    AscendC::LocalTensor<float>& uKeep, bool keepU,
    int64_t dataOff, int64_t keepOff, int32_t n, float& ss)
{
    LoadTile(xGm, xU, dataOff, n);
    LoadTile(rGm, rU, dataOff, n);

    if constexpr (AscendC::IsSameType<T, float>::value) {
        AscendC::Add(fA, xU, rU, n);
        AscendC::Mul(fB, fA, fA, n);
    } else {
        AscendC::Cast(fA, xU, AscendC::RoundMode::CAST_NONE, n);
        AscendC::Cast(fB, rU, AscendC::RoundMode::CAST_NONE, n);
        AscendC::Add(fA, fA, fB, n);
        AscendC::Mul(fB, fA, fA, n);
    }
    if (keepU) {
        AscendC::LocalTensor<float> uTile = uKeep[keepOff];
        AscendC::Adds(uTile, fA, 0.0f, n);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::ReduceSum(reduceTmp, fB, reduceTmp[16], n);
    AscendC::PipeBarrier<PIPE_ALL>();
    ss += reduceTmp.GetValue(0);
}

template <typename T>
__aicore__ inline void ApplyNormTile(
    AscendC::GlobalTensor<T>& gGm, AscendC::GlobalTensor<T>& bGm, AscendC::GlobalTensor<T>& oGm,
    AscendC::LocalTensor<T>& gU, AscendC::LocalTensor<T>& bU,
    AscendC::LocalTensor<T>& xU,
    AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
    AscendC::LocalTensor<float>& uKeep, bool fromKeep,
    int64_t dataOff, int64_t paramOff, int64_t keepOff, int32_t n, float invRms,
    AscendC::GlobalTensor<T>& xGm, AscendC::GlobalTensor<T>& rGm,
    AscendC::LocalTensor<T>& rU)
{
    if (fromKeep) {
        AscendC::LocalTensor<float> uTile = uKeep[keepOff];
        AscendC::Muls(fA, uTile, invRms, n);
    } else {
        LoadTile(xGm, xU, dataOff, n);
        LoadTile(rGm, rU, dataOff, n);
        if constexpr (AscendC::IsSameType<T, float>::value) {
            AscendC::Add(fA, xU, rU, n);
        } else {
            AscendC::Cast(fA, xU, AscendC::RoundMode::CAST_NONE, n);
            AscendC::Cast(fB, rU, AscendC::RoundMode::CAST_NONE, n);
            AscendC::Add(fA, fA, fB, n);
        }
        AscendC::Muls(fA, fA, invRms, n);
    }

    LoadTile(gGm, gU, paramOff, n);
    LoadTile(bGm, bU, paramOff, n);
    if constexpr (AscendC::IsSameType<T, float>::value) {
        AscendC::Mul(fA, fA, gU, n);
        AscendC::Add(fA, fA, bU, n);
        AscendC::Adds(xU, fA, 0.0f, n);
        StoreTile(oGm, xU, dataOff, n);
    } else {
        AscendC::Cast(fB, gU, AscendC::RoundMode::CAST_NONE, n);
        AscendC::Mul(fA, fA, fB, n);
        AscendC::Cast(fB, bU, AscendC::RoundMode::CAST_NONE, n);
        AscendC::Add(fA, fA, fB, n);
        AscendC::Cast(xU, fA, AscendC::RoundMode::CAST_RINT, n);
        AscendC::PipeBarrier<PIPE_ALL>();
        StoreTile(oGm, xU, dataOff, n);
    }
}

template <typename T>
class WideRowKernel {
public:
    __aicore__ inline void Init(
        __gm__ uint8_t* x, __gm__ uint8_t* r, __gm__ uint8_t* g, __gm__ uint8_t* b, __gm__ uint8_t* o,
        int64_t rows, int64_t cols, float eps, int32_t tile, int32_t mode)
    {
        rows_ = rows;
        D_ = cols;
        eps_ = eps;
        tile_ = tile;
        mode_ = mode;
        xGm_.SetGlobalBuffer((__gm__ T*)x, rows * cols);
        rGm_.SetGlobalBuffer((__gm__ T*)r, rows * cols);
        gGm_.SetGlobalBuffer((__gm__ T*)g, cols);
        bGm_.SetGlobalBuffer((__gm__ T*)b, cols);
        oGm_.SetGlobalBuffer((__gm__ T*)o, rows * cols);

        int64_t tAlign = tile_;
        if (tAlign < 32) {
            tAlign = 32;
        }
        uint32_t tBytes = static_cast<uint32_t>(tAlign * sizeof(T));
        uint32_t fBytes = static_cast<uint32_t>(tAlign * sizeof(float));
        pipe_.InitBuffer(xQ_, 1, tBytes);
        pipe_.InitBuffer(rQ_, 1, tBytes);
        pipe_.InitBuffer(gQ_, 1, tBytes);
        pipe_.InitBuffer(bQ_, 1, tBytes);
        pipe_.InitBuffer(fA_, fBytes);
        pipe_.InitBuffer(fB_, fBytes);
        pipe_.InitBuffer(rtmp_, 128);
        uint32_t uBytes = (mode_ == 1) ? static_cast<uint32_t>(D_ * sizeof(float)) : fBytes;
        pipe_.InitBuffer(uBuf_, uBytes);
    }

    __aicore__ inline void ProcessRowRange()
    {
        int64_t blk = AscendC::GetBlockIdx();
        int64_t nb = AscendC::GetBlockNum();
        int64_t per = I001_CEIL_DIV(rows_, nb);
        int64_t r0 = blk * per;
        int64_t r1 = r0 + per;
        if (r1 > rows_) {
            r1 = rows_;
        }
        AscendC::LocalTensor<T> xU = xQ_.AllocTensor<T>();
        AscendC::LocalTensor<T> rU = rQ_.AllocTensor<T>();
        AscendC::LocalTensor<T> gU = gQ_.AllocTensor<T>();
        AscendC::LocalTensor<T> bU = bQ_.AllocTensor<T>();
        AscendC::LocalTensor<float> fA = fA_.Get<float>();
        AscendC::LocalTensor<float> fB = fB_.Get<float>();
        AscendC::LocalTensor<float> rtmp = rtmp_.Get<float>();
        AscendC::LocalTensor<float> uKeep = uBuf_.Get<float>();

        for (int64_t row = r0; row < r1; ++row) {
            int64_t base = row * D_;
            ProcessOneRow(base, xU, rU, gU, bU, fA, fB, rtmp, uKeep);
        }
        xQ_.FreeTensor(xU);
        rQ_.FreeTensor(rU);
        gQ_.FreeTensor(gU);
        bQ_.FreeTensor(bU);
    }

    // Low-sync D-stripe: 2 SyncAll for all rows.
    __aicore__ inline void ProcessDStripe(__gm__ float* ws)
    {
        int64_t blk = AscendC::GetBlockIdx();
        int64_t nb = AscendC::GetBlockNum();
        AscendC::GlobalTensor<float> wsGm;
        wsGm.SetGlobalBuffer(ws, nb * rows_ + rows_ + 8);

        int64_t stripe = I001_CEIL_DIV(D_, nb);
        int64_t d0 = blk * stripe;
        int64_t d1 = d0 + stripe;
        if (d1 > D_) {
            d1 = D_;
        }

        AscendC::LocalTensor<T> xU = xQ_.AllocTensor<T>();
        AscendC::LocalTensor<T> rU = rQ_.AllocTensor<T>();
        AscendC::LocalTensor<T> gU = gQ_.AllocTensor<T>();
        AscendC::LocalTensor<T> bU = bQ_.AllocTensor<T>();
        AscendC::LocalTensor<float> fA = fA_.Get<float>();
        AscendC::LocalTensor<float> fB = fB_.Get<float>();
        AscendC::LocalTensor<float> rtmp = rtmp_.Get<float>();
        AscendC::LocalTensor<float> uKeep = uBuf_.Get<float>();

        for (int64_t row = 0; row < rows_; ++row) {
            float ss = 0.0f;
            if (d0 < d1) {
                int64_t base = row * D_;
                for (int64_t d = d0; d < d1; d += tile_) {
                    int32_t n = static_cast<int32_t>((d1 - d) < tile_ ? (d1 - d) : tile_);
                    AccSqSum(xGm_, rGm_, xU, rU, fA, fB, rtmp, uKeep, false, base + d, d, n, ss);
                }
            }
            wsGm.SetValue(blk * rows_ + row, ss);
        }

        AscendC::SyncAll();

        if (blk == 0) {
            for (int64_t row = 0; row < rows_; ++row) {
                float total = 0.0f;
                for (int64_t k = 0; k < nb; ++k) {
                    total += wsGm.GetValue(k * rows_ + row);
                }
                wsGm.SetValue(nb * rows_ + row, total);
            }
        }

        AscendC::SyncAll();

        for (int64_t row = 0; row < rows_; ++row) {
            float ss = wsGm.GetValue(nb * rows_ + row);
            float invRms = InvRmsFromSs(ss, fA, fB);
            if (d0 >= d1) {
                continue;
            }
            int64_t base = row * D_;
            for (int64_t d = d0; d < d1; d += tile_) {
                int32_t n = static_cast<int32_t>((d1 - d) < tile_ ? (d1 - d) : tile_);
                ApplyNormTile(gGm_, bGm_, oGm_, gU, bU, xU, fA, fB, uKeep, false, base + d, d, d, n, invRms, xGm_, rGm_, rU);
            }
        }

        xQ_.FreeTensor(xU);
        rQ_.FreeTensor(rU);
        gQ_.FreeTensor(gU);
        bQ_.FreeTensor(bU);
    }

private:
    __aicore__ inline float InvRmsFromSs(float ss, AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB)
    {
        float mean = ss / static_cast<float>(D_);
        float var = mean + eps_;
        if (!(var > 0.0f)) {
            var = 0.0f;
        }
        fB.SetValue(0, var);
        AscendC::Sqrt(fA, fB, 1);
        AscendC::PipeBarrier<PIPE_ALL>();
        float denom = fA.GetValue(0);
        return (denom > 0.0f) ? (1.0f / denom) : 0.0f;
    }

    __aicore__ inline void ProcessOneRow(
        int64_t base,
        AscendC::LocalTensor<T>& xU, AscendC::LocalTensor<T>& rU,
        AscendC::LocalTensor<T>& gU, AscendC::LocalTensor<T>& bU,
        AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
        AscendC::LocalTensor<float>& rtmp, AscendC::LocalTensor<float>& uKeep)
    {
        const bool keep = (mode_ == 1);
        float ss = 0.0f;
        for (int64_t d = 0; d < D_; d += tile_) {
            int32_t n = static_cast<int32_t>((D_ - d) < tile_ ? (D_ - d) : tile_);
            AccSqSum(xGm_, rGm_, xU, rU, fA, fB, rtmp, uKeep, keep, base + d, d, n, ss);
        }
        float invRms = InvRmsFromSs(ss, fA, fB);
        for (int64_t d = 0; d < D_; d += tile_) {
            int32_t n = static_cast<int32_t>((D_ - d) < tile_ ? (D_ - d) : tile_);
            ApplyNormTile(gGm_, bGm_, oGm_, gU, bU, xU, fA, fB, uKeep, keep, base + d, d, d, n, invRms, xGm_, rGm_, rU);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQ_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> rQ_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> gQ_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> bQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fA_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fB_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rtmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> uBuf_;
    AscendC::GlobalTensor<T> xGm_, rGm_, gGm_, bGm_, oGm_;
    int64_t rows_ = 0;
    int64_t D_ = 0;
    float eps_ = 1e-5f;
    int32_t tile_ = 1024;
    int32_t mode_ = 0;
};

template <typename T>
__aicore__ inline void LaunchBody(
    __gm__ uint8_t* x, __gm__ uint8_t* r, __gm__ uint8_t* g, __gm__ uint8_t* b, __gm__ uint8_t* o,
    __gm__ float* ws, int64_t rows, int64_t cols, float eps, int32_t tile, int32_t mode)
{
    WideRowKernel<T> op;
    op.Init(x, r, g, b, o, rows, cols, eps, tile, mode);
    if (mode == 2) {
        op.ProcessDStripe(ws);
    } else {
        op.ProcessRowRange();
    }
}

} // namespace

extern "C" __global__ __vector__ void i001_add_rms_norm_bias_f32(
    __gm__ uint8_t* x, __gm__ uint8_t* r, __gm__ uint8_t* g, __gm__ uint8_t* b, __gm__ uint8_t* o,
    __gm__ float* ws, int64_t rows, int64_t cols, float eps, int32_t tile, int32_t mode)
{
    LaunchBody<float>(x, r, g, b, o, ws, rows, cols, eps, tile, mode);
}

extern "C" __global__ __vector__ void i001_add_rms_norm_bias_f16(
    __gm__ uint8_t* x, __gm__ uint8_t* r, __gm__ uint8_t* g, __gm__ uint8_t* b, __gm__ uint8_t* o,
    __gm__ float* ws, int64_t rows, int64_t cols, float eps, int32_t tile, int32_t mode)
{
    LaunchBody<half>(x, r, g, b, o, ws, rows, cols, eps, tile, mode);
}

extern "C" __global__ __vector__ void i001_add_rms_norm_bias_bf16(
    __gm__ uint8_t* x, __gm__ uint8_t* r, __gm__ uint8_t* g, __gm__ uint8_t* b, __gm__ uint8_t* o,
    __gm__ float* ws, int64_t rows, int64_t cols, float eps, int32_t tile, int32_t mode)
{
    LaunchBody<bfloat16_t>(x, r, g, b, o, ws, rows, cols, eps, tile, mode);
}

static float*& WsPtr()
{
    static float* p = nullptr;
    return p;
}

static int64_t& WsFloats()
{
    static int64_t n = 0;
    return n;
}

static void EnsureWs(int64_t need)
{
    int64_t cap = need < 1024 ? 1024 : need;
    if (WsPtr() != nullptr && WsFloats() >= cap) {
        aclrtMemset(WsPtr(), static_cast<size_t>(WsFloats()) * sizeof(float), 0,
                    static_cast<size_t>(WsFloats()) * sizeof(float));
        return;
    }
    if (WsPtr() != nullptr) {
        aclrtFree(WsPtr());
        WsPtr() = nullptr;
        WsFloats() = 0;
    }
    size_t bytes = static_cast<size_t>(cap) * sizeof(float);
    void* p = nullptr;
    if (aclrtMalloc(&p, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_ERROR_NONE || p == nullptr) {
        return;
    }
    WsPtr() = static_cast<float*>(p);
    WsFloats() = cap;
    aclrtMemset(WsPtr(), bytes, 0, bytes);
}

// Entry required by the judge. Types TensorInfo / TensorGroupInfo are predefined.
extern "C" void run_kernel(
    void* x, TensorGroupInfo* x_info,
    void* residual, TensorGroupInfo* residual_info,
    void* gamma, TensorGroupInfo* gamma_info,
    void* bias, TensorGroupInfo* bias_info,
    void* output, TensorGroupInfo* output_info,
    int availableCoreNum, void* stream, float epsilon)
{
    (void)residual_info;
    (void)gamma_info;
    (void)bias_info;
    (void)output_info;

    int64_t rows = 0;
    int64_t cols = 0;
    int32_t dtype = 0;
    ShapeFromInfo(x_info, rows, cols, dtype);
    if (rows <= 0 || cols <= 0) {
        return;
    }

    int32_t tile = kMaxTile;
    if (static_cast<int64_t>(tile) > cols) {
        tile = static_cast<int32_t>(cols);
    }

    int32_t esz = (dtype == 0) ? 4 : 2;
    int64_t retainNeed = cols * 4 + 4 * tile * static_cast<int64_t>(esz) + 2 * tile * 4 + 256;
    bool canRetain = retainNeed <= kRetainBytesBudget;

    int cores = availableCoreNum > 0 ? availableCoreNum : 1;
    if (cores > kVecCores) {
        cores = kVecCores;
    }

    int32_t mode = 0;
    if (canRetain) {
        mode = 1;
    }

    if (!canRetain && rows <= 8 && cols >= 4096) {
        mode = 2;
        int want = static_cast<int>(I001_CEIL_DIV(cols, 512));
        if (want < 1) {
            want = 1;
        }
        if (cores > want) {
            cores = want;
        }
        if (cores > kVecCores) {
            cores = kVecCores;
        }
        if (cores < 1) {
            cores = 1;
        }
        EnsureWs(static_cast<int64_t>(cores) * rows + rows + 8);
    } else {
        int64_t rowCap = rows < cores ? rows : cores;
        if (rowCap < 1) {
            rowCap = 1;
        }
        cores = static_cast<int>(rowCap);
    }

    aclrtStream s = static_cast<aclrtStream>(stream);
    __gm__ float* ws = (mode == 2) ? WsPtr() : nullptr;

    if (dtype == 0) {
        i001_add_rms_norm_bias_f32<<<cores, 0, s>>>(
            (__gm__ uint8_t*)(x), (__gm__ uint8_t*)(residual),
            (__gm__ uint8_t*)(gamma), (__gm__ uint8_t*)(bias),
            (__gm__ uint8_t*)(output), ws, rows, cols, epsilon, tile, mode);
    } else if (dtype == 1) {
        i001_add_rms_norm_bias_f16<<<cores, 0, s>>>(
            (__gm__ uint8_t*)(x), (__gm__ uint8_t*)(residual),
            (__gm__ uint8_t*)(gamma), (__gm__ uint8_t*)(bias),
            (__gm__ uint8_t*)(output), ws, rows, cols, epsilon, tile, mode);
    } else if (dtype == 2) {
        i001_add_rms_norm_bias_bf16<<<cores, 0, s>>>(
            (__gm__ uint8_t*)(x), (__gm__ uint8_t*)(residual),
            (__gm__ uint8_t*)(gamma), (__gm__ uint8_t*)(bias),
            (__gm__ uint8_t*)(output), ws, rows, cols, epsilon, tile, mode);
    }
}
