#include <acl/acl.h>
#include <algorithm>
#include <cerrno>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fcntl.h>
#include <fstream>
#include <string>
#include <unistd.h>
#include <vector>

#include "local_types.h"
#include "parent_timing_submission.asc"
#include "candidate_timing_submission.asc"

#ifndef TINY_TOOLCHAIN_LABEL
#define TINY_TOOLCHAIN_LABEL "CANN_8.5.0.alpha002_Bisheng_15.0.5_Ascend910B3_dav-2201"
#endif

namespace {
constexpr int64_t kExpectedA = 40;
constexpr int64_t kRows = 20;
constexpr int64_t kWidth = 256;
constexpr int kWarmup = 45;
constexpr int kSamples = 21;
constexpr int kBlocks = 4;
constexpr float kEpsilon = 1.0e-5f;

struct Sample {
    double deviceUs;
    double wallUs;
};

struct Stats {
    double median = 0.0;
    double mean = 0.0;
    double stdev = 0.0;
    double mad = 0.0;
    double p10 = 0.0;
    double p90 = 0.0;
    double min = 0.0;
    double max = 0.0;
    double cv = 0.0;
    double maxMin = 0.0;
};

struct PairSample {
    int block;
    int pair;
    bool parentFirst;
    Sample parent;
    Sample candidate;
};

bool CheckAcl(aclError code, const char* expression, int line)
{
    if (code == ACL_SUCCESS) return true;
    std::fprintf(stderr, "ACL failure %s=%d at line %d\n", expression, code, line);
    return false;
}

#define ACL_OK(expr) CheckAcl((expr), #expr, __LINE__)

bool ReserveNewOutput(const std::string& path)
{
    const int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0644);
    if (fd < 0) {
        std::fprintf(stderr, "refusing existing/uncreatable output path=%s errno=%d (%s)\n",
                     path.c_str(), errno, std::strerror(errno));
        return false;
    }
    if (close(fd) != 0) {
        std::fprintf(stderr, "cannot close reserved output path=%s errno=%d (%s)\n",
                     path.c_str(), errno, std::strerror(errno));
        return false;
    }
    return true;
}

float InputValue(int64_t index, int multiplier, int offset)
{
    return static_cast<float>((index * multiplier + offset) % 997) / 498.0f - 1.0f;
}

double Median(std::vector<double> values)
{
    if (values.empty()) return 0.0;
    std::sort(values.begin(), values.end());
    const size_t n = values.size();
    return n % 2 ? values[n / 2] : (values[n / 2 - 1] + values[n / 2]) * 0.5;
}

double Percentile(const std::vector<double>& sorted, double p)
{
    if (sorted.empty()) return 0.0;
    if (sorted.size() == 1) return sorted[0];
    const double at = p * static_cast<double>(sorted.size() - 1);
    const size_t lo = static_cast<size_t>(at);
    const size_t hi = std::min(lo + 1, sorted.size() - 1);
    const double fraction = at - static_cast<double>(lo);
    return sorted[lo] * (1.0 - fraction) + sorted[hi] * fraction;
}

Stats Summarize(const std::vector<double>& input)
{
    Stats result;
    if (input.empty()) return result;
    result.min = input[0];
    result.max = input[0];
    for (double value : input) {
        result.mean += value;
        result.min = std::min(result.min, value);
        result.max = std::max(result.max, value);
    }
    result.mean /= static_cast<double>(input.size());
    double variance = 0.0;
    for (double value : input) variance += (value - result.mean) * (value - result.mean);
    result.stdev = std::sqrt(variance / static_cast<double>(input.size()));
    result.cv = result.mean > 0.0 ? result.stdev / result.mean : 0.0;
    result.median = Median(input);
    std::vector<double> deviations;
    deviations.reserve(input.size());
    for (double value : input) deviations.push_back(std::fabs(value - result.median));
    result.mad = Median(deviations);
    std::vector<double> sorted = input;
    std::sort(sorted.begin(), sorted.end());
    result.p10 = Percentile(sorted, 0.10);
    result.p90 = Percentile(sorted, 0.90);
    result.maxMin = result.min > 0.0 ? result.max / result.min : 0.0;
    return result;
}

void WriteStats(std::ofstream& out, const std::string& tag, const Stats& s, size_t n)
{
    out << tag << "\tn\t" << n << '\n'
        << tag << "\tmedian_us\t" << s.median << '\n'
        << tag << "\tmean_us\t" << s.mean << '\n'
        << tag << "\tstdev_us\t" << s.stdev << '\n'
        << tag << "\tMAD_us\t" << s.mad << '\n'
        << tag << "\tMAD_over_median\t" << (s.median > 0.0 ? s.mad / s.median : 0.0) << '\n'
        << tag << "\tp10_us\t" << s.p10 << '\n'
        << tag << "\tp90_us\t" << s.p90 << '\n'
        << tag << "\tmin_us\t" << s.min << '\n'
        << tag << "\tmax_us\t" << s.max << '\n'
        << tag << "\tCV\t" << s.cv << '\n'
        << tag << "\tmax_min\t" << s.maxMin << '\n';
}

void Launch(bool candidate, int64_t cap, aclrtStream stream,
            void* x, const TensorGroupInfo& infoX,
            void* residual, const TensorGroupInfo& infoResidual,
            void* gamma, const TensorGroupInfo& infoGamma,
            void* bias, const TensorGroupInfo& infoBias,
            void* output, const TensorGroupInfo& infoOutput)
{
    if (candidate) {
        run_candidate_kernel((GM_ADDR)x, infoX, (GM_ADDR)residual, infoResidual,
                             (GM_ADDR)gamma, infoGamma, (GM_ADDR)bias, infoBias,
                             (GM_ADDR)output, infoOutput, cap, stream, kEpsilon);
    } else {
        run_parent_kernel((GM_ADDR)x, infoX, (GM_ADDR)residual, infoResidual,
                          (GM_ADDR)gamma, infoGamma, (GM_ADDR)bias, infoBias,
                          (GM_ADDR)output, infoOutput, cap, stream, kEpsilon);
    }
}

bool Measure(bool candidate, int64_t cap, aclrtStream stream,
             aclrtEvent startEvent, aclrtEvent stopEvent,
             void* x, const TensorGroupInfo& infoX,
             void* residual, const TensorGroupInfo& infoResidual,
             void* gamma, const TensorGroupInfo& infoGamma,
             void* bias, const TensorGroupInfo& infoBias,
             void* output, const TensorGroupInfo& infoOutput,
             Sample& sample)
{
    const auto wallStart = std::chrono::steady_clock::now();
    if (!ACL_OK(aclrtRecordEvent(startEvent, stream))) return false;
    Launch(candidate, cap, stream, x, infoX, residual, infoResidual,
           gamma, infoGamma, bias, infoBias, output, infoOutput);
    if (!ACL_OK(aclrtRecordEvent(stopEvent, stream)) ||
        !ACL_OK(aclrtSynchronizeEvent(stopEvent))) return false;
    float elapsedMs = 0.0f;
    if (!ACL_OK(aclrtEventElapsedTime(&elapsedMs, startEvent, stopEvent)) ||
        !ACL_OK(aclrtSynchronizeStream(stream))) return false;
    const auto wallStop = std::chrono::steady_clock::now();
    sample.deviceUs = static_cast<double>(elapsedMs) * 1000.0;
    sample.wallUs = std::chrono::duration<double, std::micro>(wallStop - wallStart).count();
    return true;
}

bool CheckGolden(bool candidate, int64_t cap, aclrtStream stream,
                 void* x, const TensorGroupInfo& infoX,
                 void* residual, const TensorGroupInfo& infoResidual,
                 void* gamma, const TensorGroupInfo& infoGamma,
                 void* bias, const TensorGroupInfo& infoBias,
                 void* output, const TensorGroupInfo& infoOutput,
                 const std::vector<float>& hostX,
                 const std::vector<float>& hostResidual,
                 const std::vector<float>& hostGamma,
                 const std::vector<float>& hostBias,
                 std::vector<float>& hostOutput,
                 const char* label)
{
    Launch(candidate, cap, stream, x, infoX, residual, infoResidual,
           gamma, infoGamma, bias, infoBias, output, infoOutput);
    if (!ACL_OK(aclrtSynchronizeStream(stream))) return false;
    const size_t bytes = hostOutput.size() * sizeof(float);
    if (!ACL_OK(aclrtMemcpy(hostOutput.data(), bytes, output, bytes, ACL_MEMCPY_DEVICE_TO_HOST)))
        return false;

    float maxAbs = 0.0f;
    int bad = 0;
    for (int64_t row = 0; row < kRows; ++row) {
        float sum = 0.0f;
        for (int64_t col = 0; col < kWidth; ++col) {
            const size_t i = static_cast<size_t>(row * kWidth + col);
            const float value = hostX[i] + hostResidual[i];
            sum += value * value;
        }
        const float invRms = 1.0f / std::sqrt(sum / static_cast<float>(kWidth) + kEpsilon);
        for (int64_t col = 0; col < kWidth; ++col) {
            const size_t i = static_cast<size_t>(row * kWidth + col);
            const float value = hostX[i] + hostResidual[i];
            const float expected = value * invRms * hostGamma[static_cast<size_t>(col)] +
                                   hostBias[static_cast<size_t>(col)];
            const float error = std::fabs(hostOutput[i] - expected);
            maxAbs = std::max(maxAbs, error);
            if (!std::isfinite(hostOutput[i]) ||
                error > 1.0e-4f + 1.0e-4f * std::fabs(expected)) ++bad;
        }
    }
    std::printf("POST_TIMING_GOLDEN label=%s max_abs=%.9g bad=%d\n", label, maxAbs, bad);
    return bad == 0;
}

bool Warmup(bool paired, int64_t cap, aclrtStream stream,
            void* x, const TensorGroupInfo& infoX,
            void* residual, const TensorGroupInfo& infoResidual,
            void* gamma, const TensorGroupInfo& infoGamma,
            void* bias, const TensorGroupInfo& infoBias,
            void* output, const TensorGroupInfo& infoOutput)
{
    for (int i = 0; i < kWarmup; ++i) {
        Launch(false, cap, stream, x, infoX, residual, infoResidual,
               gamma, infoGamma, bias, infoBias, output, infoOutput);
        if (!ACL_OK(aclrtSynchronizeStream(stream))) return false;
        if (paired) {
            Launch(true, cap, stream, x, infoX, residual, infoResidual,
                   gamma, infoGamma, bias, infoBias, output, infoOutput);
            if (!ACL_OK(aclrtSynchronizeStream(stream))) return false;
        }
    }
    return true;
}

} // namespace

void WriteRaw(std::ofstream& out, const char* phase, int64_t cap,
              int block, int pair, const char* order, const char* variant,
              int sampleIndex, const Sample& sample)
{
    out << phase << '\t' << cap << '\t' << block << '\t' << pair << '\t'
        << order << '\t' << variant << '\t' << sampleIndex << '\t'
        << sample.deviceUs << '\t' << sample.wallUs << '\n';
}

int main(int argc, char** argv)
{
    if (argc != 5) {
        std::fprintf(stderr, "usage: %s device_id cap precheck|same-parent|paired output_prefix\n", argv[0]);
        return 2;
    }
    const int deviceId = std::atoi(argv[1]);
    const int64_t cap = std::strtoll(argv[2], nullptr, 10);
    const std::string mode(argv[3]);
    const std::string prefix(argv[4]);
    if ((cap != 40 && cap != 19) ||
        (mode != "precheck" && mode != "same-parent" && mode != "paired")) {
        std::fprintf(stderr, "invalid cap or mode\n");
        return 2;
    }
    const std::string rawPath = prefix + "-raw.tsv";
    const std::string statsPath = prefix + "-stats.tsv";
    if (!ReserveNewOutput(rawPath) || !ReserveNewOutput(statsPath)) return 5;
    std::ofstream raw(rawPath, std::ios::out | std::ios::app);
    std::ofstream statsFile(statsPath, std::ios::out | std::ios::app);
    if (!raw || !statsFile) {
        std::fprintf(stderr, "cannot open new output prefix=%s\n", prefix.c_str());
        return 5;
    }

    if (!ACL_OK(aclInit(nullptr)) || !ACL_OK(aclrtSetDevice(deviceId))) return 1;
    int64_t availableCoreNum = 0;
    if (!ACL_OK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum)))
        return 1;
    const int64_t m = std::max<int64_t>(2, availableCoreNum / 2);
    const int64_t b = m - 1;
    const int64_t blockCount = std::min(cap, kRows);
    if (availableCoreNum != kExpectedA || m != kRows ||
        (cap != availableCoreNum && cap != b)) {
        std::fprintf(stderr, "PROXY_IDENTITY_MISMATCH expected_A/M/B=40/20/19 actual=%lld/%lld/%lld cap=%lld\n",
                     static_cast<long long>(availableCoreNum), static_cast<long long>(m),
                     static_cast<long long>(b), static_cast<long long>(cap));
        aclFinalize();
        return 4;
    }

    const bool equalOwnership = kRows == blockCount;
    const char* ownershipPath = equalOwnership ? "H2_FASTFORM" : "PARENT_FORMULA_FALLBACK";
    const char* perBlockPath = equalOwnership
        ? "20xFP32_NARROW_MID_OVERLAP"
        : "1xFP32_SMALL_CONTIG_BATCHED+18xFP32_NARROW_MID_OVERLAP";
    std::printf("TINY_V001_EVENT_RUNNER mode=%s device=%d toolchain=%s "
                "shape=[20,256] dtype=FP32 A=%lld M=%lld B=%lld cap=%lld blockCount=%lld "
                "ownership=%s per_block_dispatch=%s warmup_per_variant=%d samples=%d blocks=%d\n",
                mode.c_str(), deviceId, TINY_TOOLCHAIN_LABEL,
                static_cast<long long>(availableCoreNum), static_cast<long long>(m),
                static_cast<long long>(b), static_cast<long long>(cap),
                static_cast<long long>(blockCount), ownershipPath, perBlockPath,
                kWarmup, kSamples, mode == "paired" ? kBlocks : (mode == "same-parent" ? 2 : 1));

    aclrtStream stream = nullptr;
    if (!ACL_OK(aclrtCreateStream(&stream))) return 1;
    int64_t xyShape[] = {kRows, kWidth};
    int64_t parameterShape[] = {kWidth};
    TensorInfo xTensor[] = {{xyShape, 2, 0}}, residualTensor[] = {{xyShape, 2, 0}};
    TensorInfo gammaTensor[] = {{parameterShape, 1, 0}}, biasTensor[] = {{parameterShape, 1, 0}};
    TensorInfo outputTensor[] = {{xyShape, 2, 0}};
    TensorGroupInfo infoX = {xTensor, 1}, infoResidual = {residualTensor, 1};
    TensorGroupInfo infoGamma = {gammaTensor, 1}, infoBias = {biasTensor, 1};
    TensorGroupInfo infoOutput = {outputTensor, 1};

    const size_t elements = static_cast<size_t>(kRows * kWidth);
    const size_t dataBytes = elements * sizeof(float);
    const size_t parameterBytes = static_cast<size_t>(kWidth) * sizeof(float);
    std::vector<float> hostX(elements), hostResidual(elements), hostGamma(kWidth),
                       hostBias(kWidth), hostOutput(elements);
    for (size_t i = 0; i < elements; ++i) {
        hostX[i] = InputValue(static_cast<int64_t>(i), 37, 11);
        hostResidual[i] = InputValue(static_cast<int64_t>(i), 17, 3);
    }
    for (int64_t col = 0; col < kWidth; ++col) {
        hostGamma[static_cast<size_t>(col)] =
            0.75f + static_cast<float>((col * 13) % 100) / 200.0f;
        hostBias[static_cast<size_t>(col)] =
            static_cast<float>((col * 7) % 100) / 400.0f - 0.125f;
    }

    void *deviceX = nullptr, *deviceResidual = nullptr, *deviceGamma = nullptr;
    void *deviceBias = nullptr, *deviceOutput = nullptr;
    if (!ACL_OK(aclrtMalloc(&deviceX, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !ACL_OK(aclrtMalloc(&deviceResidual, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !ACL_OK(aclrtMalloc(&deviceGamma, parameterBytes, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !ACL_OK(aclrtMalloc(&deviceBias, parameterBytes, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !ACL_OK(aclrtMalloc(&deviceOutput, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST))) return 1;
    if (!ACL_OK(aclrtMemcpy(deviceX, dataBytes, hostX.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE)) ||
        !ACL_OK(aclrtMemcpy(deviceResidual, dataBytes, hostResidual.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE)) ||
        !ACL_OK(aclrtMemcpy(deviceGamma, parameterBytes, hostGamma.data(), parameterBytes, ACL_MEMCPY_HOST_TO_DEVICE)) ||
        !ACL_OK(aclrtMemcpy(deviceBias, parameterBytes, hostBias.data(), parameterBytes, ACL_MEMCPY_HOST_TO_DEVICE))) return 1;

    aclrtEvent startEvent = nullptr, stopEvent = nullptr;
    if (!ACL_OK(aclrtCreateEvent(&startEvent)) || !ACL_OK(aclrtCreateEvent(&stopEvent))) return 1;
    if (!Warmup(mode == "paired", cap, stream, deviceX, infoX,
                deviceResidual, infoResidual, deviceGamma, infoGamma,
                deviceBias, infoBias, deviceOutput, infoOutput)) return 1;

    raw << "phase\tcap\tblock\tpair\torder\tvariant\tsample\tdevice_event_us\thost_wall_us\n";
    statsFile << "mode\t" << mode << "\ncap\t" << cap << "\n"
              << "A\t" << availableCoreNum << "\nM\t" << m << "\nB\t" << b << "\n"
              << "shape\t20x256\ndtype\tFP32\nmethod\tDEVICE_EVENT_PRIMARY+HOST_WALL_SECONDARY\n"
              << "toolchain\t" << TINY_TOOLCHAIN_LABEL << "\nownership_branch\t"
              << ownershipPath << "\nper_block_dispatch\t" << perBlockPath << "\n"
              << "warmup_per_variant\t" << kWarmup << "\nsamples_per_block\t" << kSamples << "\n";

    int status = 0;
    if (mode == "precheck" || mode == "same-parent") {
        const int blockCountToRun = mode == "precheck" ? 1 : 2;
        std::vector<std::vector<double>> deviceBlocks(blockCountToRun), wallBlocks(blockCountToRun);
        for (int block = 0; block < blockCountToRun; ++block) {
            for (int sampleIndex = 0; sampleIndex < kSamples; ++sampleIndex) {
                Sample sample{};
                if (!Measure(false, cap, stream, startEvent, stopEvent,
                             deviceX, infoX, deviceResidual, infoResidual,
                             deviceGamma, infoGamma, deviceBias, infoBias,
                             deviceOutput, infoOutput, sample)) { status = 1; break; }
                deviceBlocks[block].push_back(sample.deviceUs);
                wallBlocks[block].push_back(sample.wallUs);
                WriteRaw(raw, mode.c_str(), cap, block + 1, 0, "P", "PARENT",
                         sampleIndex + 1, sample);
            }
            raw.flush();
            if (status != 0) break;
            WriteStats(statsFile, "BLOCK" + std::to_string(block + 1) + "_DEVICE",
                       Summarize(deviceBlocks[block]), deviceBlocks[block].size());
            WriteStats(statsFile, "BLOCK" + std::to_string(block + 1) + "_WALL",
                       Summarize(wallBlocks[block]), wallBlocks[block].size());
        }
        std::vector<double> allDevice, allWall;
        for (const auto& block : deviceBlocks)
            allDevice.insert(allDevice.end(), block.begin(), block.end());
        for (const auto& block : wallBlocks)
            allWall.insert(allWall.end(), block.begin(), block.end());
        WriteStats(statsFile, "ALL_DEVICE", Summarize(allDevice), allDevice.size());
        WriteStats(statsFile, "ALL_WALL", Summarize(allWall), allWall.size());
        if (mode == "same-parent" && deviceBlocks.size() == 2 &&
            deviceBlocks[0].size() == kSamples && deviceBlocks[1].size() == kSamples) {
            std::vector<double> values = deviceBlocks[0];
            values.insert(values.end(), deviceBlocks[1].begin(), deviceBlocks[1].end());
            const double median = Median(values);
            const double madRatio = median > 0.0 ? Summarize(values).mad / median : 0.0;
            const double drift = median > 0.0
                ? std::fabs(Median(deviceBlocks[0]) - Median(deviceBlocks[1])) / median : 0.0;
            statsFile << "same_binary_mad_over_median\t" << madRatio << "\n"
                      << "same_binary_block_drift\t" << drift << "\n"
                      << "same_binary_pass\t" << ((madRatio <= 0.10 && drift <= 0.10) ? "PASS" : "FAIL") << "\n";
        }
    } else {
        std::vector<PairSample> pairs;
        pairs.reserve(kBlocks * kSamples);
        for (int block = 0; block < kBlocks; ++block) {
            const bool parentFirst = (block % 2) == 0;
            for (int pairIndex = 0; pairIndex < kSamples; ++pairIndex) {
                Sample p{}, c{};
                const bool ok = parentFirst
                    ? (Measure(false, cap, stream, startEvent, stopEvent, deviceX, infoX,
                               deviceResidual, infoResidual, deviceGamma, infoGamma,
                               deviceBias, infoBias, deviceOutput, infoOutput, p) &&
                       Measure(true, cap, stream, startEvent, stopEvent, deviceX, infoX,
                               deviceResidual, infoResidual, deviceGamma, infoGamma,
                               deviceBias, infoBias, deviceOutput, infoOutput, c))
                    : (Measure(true, cap, stream, startEvent, stopEvent, deviceX, infoX,
                               deviceResidual, infoResidual, deviceGamma, infoGamma,
                               deviceBias, infoBias, deviceOutput, infoOutput, c) &&
                       Measure(false, cap, stream, startEvent, stopEvent, deviceX, infoX,
                               deviceResidual, infoResidual, deviceGamma, infoGamma,
                               deviceBias, infoBias, deviceOutput, infoOutput, p));
                if (!ok) { status = 1; break; }
                pairs.push_back({block + 1, pairIndex + 1, parentFirst, p, c});
            }
            if (status != 0) break;
            for (const auto& pair : pairs) {
                if (pair.block != block + 1) continue;
                const char* order = pair.parentFirst ? "P/C" : "C/P";
                WriteRaw(raw, "paired", cap, pair.block, pair.pair, order,
                         "PARENT", pair.pair, pair.parent);
                WriteRaw(raw, "paired", cap, pair.block, pair.pair, order,
                         "CANDIDATE", pair.pair, pair.candidate);
            }
            raw.flush();
        }

        std::vector<double> parentAll, candidateAll, parentWallAll, candidateWallAll;
        std::vector<double> pairDeltas, pairDeltaUs;
        for (int block = 1; block <= kBlocks; ++block) {
            std::vector<double> pValues, cValues, pWall, cWall;
            for (const auto& pair : pairs) {
                if (pair.block != block) continue;
                pValues.push_back(pair.parent.deviceUs);
                cValues.push_back(pair.candidate.deviceUs);
                pWall.push_back(pair.parent.wallUs);
                cWall.push_back(pair.candidate.wallUs);
            }
            if (pValues.size() != kSamples || cValues.size() != kSamples) continue;
            parentAll.insert(parentAll.end(), pValues.begin(), pValues.end());
            candidateAll.insert(candidateAll.end(), cValues.begin(), cValues.end());
            parentWallAll.insert(parentWallAll.end(), pWall.begin(), pWall.end());
            candidateWallAll.insert(candidateWallAll.end(), cWall.begin(), cWall.end());
            const double pMedian = Median(pValues), cMedian = Median(cValues);
            const double delta = pMedian > 0.0 ? cMedian / pMedian - 1.0 : 0.0;
            pairDeltas.push_back(delta);
            pairDeltaUs.push_back(cMedian - pMedian);
            statsFile << "PAIR_BLOCK_" << block << "_parent_median_us\t" << pMedian << "\n"
                      << "PAIR_BLOCK_" << block << "_candidate_median_us\t" << cMedian << "\n"
                      << "PAIR_BLOCK_" << block << "_delta_us\t" << cMedian - pMedian << "\n"
                      << "PAIR_BLOCK_" << block << "_delta_pct\t" << delta << "\n";
            WriteStats(statsFile, "PAIR_BLOCK_" + std::to_string(block) + "_P_DEVICE",
                       Summarize(pValues), pValues.size());
            WriteStats(statsFile, "PAIR_BLOCK_" + std::to_string(block) + "_C_DEVICE",
                       Summarize(cValues), cValues.size());
            WriteStats(statsFile, "PAIR_BLOCK_" + std::to_string(block) + "_P_WALL",
                       Summarize(pWall), pWall.size());
            WriteStats(statsFile, "PAIR_BLOCK_" + std::to_string(block) + "_C_WALL",
                       Summarize(cWall), cWall.size());
        }
        WriteStats(statsFile, "ALL_P_DEVICE", Summarize(parentAll), parentAll.size());
        WriteStats(statsFile, "ALL_C_DEVICE", Summarize(candidateAll), candidateAll.size());
        WriteStats(statsFile, "ALL_P_WALL", Summarize(parentWallAll), parentWallAll.size());
        WriteStats(statsFile, "ALL_C_WALL", Summarize(candidateWallAll), candidateWallAll.size());
        const double pairedMedian = Median(pairDeltas);
        const double pairedMedianUs = Median(pairDeltaUs);
        int negative = 0, positive = 0;
        for (double delta : pairDeltas) {
            if (delta < 0.0) ++negative;
            if (delta > 0.0) ++positive;
        }
        statsFile << "paired_delta_median_us\t" << pairedMedianUs << "\n"
                  << "paired_delta_median_pct\t" << pairedMedian << "\n"
                  << "paired_blocks_negative\t" << negative << "\n"
                  << "paired_blocks_positive\t" << positive << "\n"
                  << "paired_blocks_total\t" << pairDeltas.size() << "\n";
    }

    if (status == 0) {
        const bool parentOk = CheckGolden(false, cap, stream, deviceX, infoX,
            deviceResidual, infoResidual, deviceGamma, infoGamma, deviceBias, infoBias,
            deviceOutput, infoOutput, hostX, hostResidual, hostGamma, hostBias,
            hostOutput, "PARENT");
        bool candidateOk = true;
        if (mode == "paired") {
            candidateOk = CheckGolden(true, cap, stream, deviceX, infoX,
                deviceResidual, infoResidual, deviceGamma, infoGamma, deviceBias, infoBias,
                deviceOutput, infoOutput, hostX, hostResidual, hostGamma, hostBias,
                hostOutput, "CANDIDATE");
        }
        statsFile << "post_timing_parent_golden\t" << (parentOk ? "PASS" : "FAIL") << "\n"
                  << "post_timing_candidate_golden\t"
                  << (mode != "paired" ? "NOT_RUN" : (candidateOk ? "PASS" : "FAIL")) << "\n";
        if (!parentOk || !candidateOk) status = 3;
    }

    ACL_OK(aclrtDestroyEvent(startEvent));
    ACL_OK(aclrtDestroyEvent(stopEvent));
    ACL_OK(aclrtFree(deviceX));
    ACL_OK(aclrtFree(deviceResidual));
    ACL_OK(aclrtFree(deviceGamma));
    ACL_OK(aclrtFree(deviceBias));
    ACL_OK(aclrtFree(deviceOutput));
    ACL_OK(aclrtDestroyStream(stream));
    ACL_OK(aclFinalize());
    std::printf("TINY_V001_EVENT_RUNNER_RC=%d mode=%s cap=%lld\n", status, mode.c_str(),
                static_cast<long long>(cap));
    return status;
}
