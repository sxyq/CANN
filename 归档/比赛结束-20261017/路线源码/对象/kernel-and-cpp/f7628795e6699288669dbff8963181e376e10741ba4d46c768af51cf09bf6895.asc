static bool ReadShape(const TensorGroupInfo& group, int32_t dtype,
                      int64_t& rows, int64_t& width)
{
    if (group.tensors == nullptr || group.numTensors != 1) return false;
    const TensorInfo& info = group.tensors[0];
    if (info.shape == nullptr || info.numDims < 2 || info.numDims > 4 || info.dtype != dtype) return false;
    width = info.shape[info.numDims - 1];
    rows = 1;
    if (width < 64 || width > 32768) return false;
    for (int64_t i = 0; i < info.numDims; ++i) {
        if (info.shape[i] <= 0) return false;
        if (i + 1 < info.numDims) {
            if (rows > INT64_MAX / info.shape[i]) return false;
            rows *= info.shape[i];
        }
    }
    return true;
}

static bool ReadVector(const TensorGroupInfo& group, int32_t dtype, int64_t width)
{
    if (group.tensors == nullptr || group.numTensors != 1) return false;
    const TensorInfo& info = group.tensors[0];
    return info.shape != nullptr && info.numDims == 1 && info.shape[0] == width && info.dtype == dtype;
}

static bool SameShape(const TensorGroupInfo& a, const TensorGroupInfo& b)
{
    if (a.tensors == nullptr || b.tensors == nullptr || a.numTensors != 1 || b.numTensors != 1) return false;
    const TensorInfo& lhs = a.tensors[0];
    const TensorInfo& rhs = b.tensors[0];
    if (lhs.numDims != rhs.numDims || lhs.shape == nullptr || rhs.shape == nullptr || lhs.dtype != rhs.dtype) return false;
    for (int64_t i = 0; i < lhs.numDims; ++i) if (lhs.shape[i] != rhs.shape[i]) return false;
    return true;
}

#ifndef FRESH4_HOST_PROBE

namespace {
constexpr int32_t kFp32 = 0;
constexpr int32_t kFp16 = 1;
constexpr int32_t kBf16 = 2;
constexpr uint32_t kWideTile = 4096;
constexpr uint32_t kFallbackTile = 512;

template <typename T, uint32_t TILE>
class AddRmsNormBiasKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                GM_ADDR bias, GM_ADDR output, int64_t rows,
                                int64_t width, float epsilon)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        residual_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual));
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
        bias_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias));
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output));
        rows_ = rows;
        width_ = width;
        epsilon_ = epsilon;
        pipe_.InitBuffer(xQueue_, 1, TILE * sizeof(float));
        pipe_.InitBuffer(rQueue_, 1, TILE * sizeof(float));
        pipe_.InitBuffer(gQueue_, 1, TILE * sizeof(float));
        pipe_.InitBuffer(bQueue_, 1, TILE * sizeof(float));
        pipe_.InitBuffer(outQueue_, 1, TILE * sizeof(T));
        pipe_.InitBuffer(tmp_, TILE == kFallbackTile ? 8192U : TILE * sizeof(float));
        pipe_.InitBuffer(reduceTmp_, TILE * sizeof(float));
        pipe_.InitBuffer(reduceScalar_, 32);
        pipe_.InitBuffer(xFloat_, TILE * sizeof(float));
        pipe_.InitBuffer(rFloat_, TILE * sizeof(float));
        pipe_.InitBuffer(gFloat_, TILE * sizeof(float));
        pipe_.InitBuffer(bFloat_, TILE * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        const int64_t row = AscendC::GetBlockIdx();
        const int64_t stride = AscendC::GetBlockNum();
        for (int64_t r = row; r < rows_; r += stride) {
            float sum = 0.0f;
            for (int64_t start = 0; start < width_; start += TILE) {
                const uint32_t count = static_cast<uint32_t>(width_ - start < TILE ? width_ - start : TILE);
                auto x = LoadInput(xQueue_, x_[r * width_ + start], count);
                auto residual = LoadInput(rQueue_, residual_[r * width_ + start], count);
                auto xf = ToFloat(x, xFloat_.Get<float>(), count);
                auto rf = ToFloat(residual, rFloat_.Get<float>(), count);
                auto work = tmp_.Get<float>();
                AscendC::Add(work, xf, rf, count);
                AscendC::Mul(work, work, work, count);
                auto scalar = reduceScalar_.Get<float>();
                AscendC::ReduceSum<float, true>(scalar, work, reduceTmp_.Get<float>(), static_cast<int32_t>(count));
                sum += scalar.GetValue(0);
                xQueue_.FreeTensor(x);
                rQueue_.FreeTensor(residual);
            }
            auto rmsInput = tmp_.Get<float>();
            auto rmsOutput = reduceScalar_.Get<float>();
            rmsInput.SetValue(0, sum / static_cast<float>(width_) + epsilon_);
            AscendC::Sqrt(rmsOutput, rmsInput, 1);
            const float invRms = 1.0f / rmsOutput.GetValue(0);
            for (int64_t start = 0; start < width_; start += TILE) {
                const uint32_t count = static_cast<uint32_t>(width_ - start < TILE ? width_ - start : TILE);
                auto x = LoadInput(xQueue_, x_[r * width_ + start], count);
                auto residual = LoadInput(rQueue_, residual_[r * width_ + start], count);
                auto gamma = LoadInput(gQueue_, gamma_[start], count);
                auto bias = LoadInput(bQueue_, bias_[start], count);
                auto out = outQueue_.AllocTensor<T>();
                auto work = tmp_.Get<float>();
                auto xf = ToFloat(x, xFloat_.Get<float>(), count);
                auto rf = ToFloat(residual, rFloat_.Get<float>(), count);
                auto gf = ToFloat(gamma, gFloat_.Get<float>(), count);
                auto bf = ToFloat(bias, bFloat_.Get<float>(), count);
                AscendC::Add(work, xf, rf, count);
                AscendC::Muls(work, work, invRms, count);
                AscendC::Mul(work, work, gf, count);
                AscendC::Add(work, work, bf, count);
                if constexpr (sizeof(T) == sizeof(float)) {
                    const uint32_t copyCount = (count + 7U) & ~7U;
                    AscendC::DataCopy(out, work, copyCount);
                } else {
                    AscendC::Cast<T, float>(out, work, AscendC::RoundMode::CAST_RINT, count);
                }
                outQueue_.EnQue(out);
                auto ready = outQueue_.DeQue<T>();
                AscendC::DataCopyPad(output_[r * width_ + start], ready,
                    {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0});
                outQueue_.FreeTensor(ready);
                xQueue_.FreeTensor(x);
                rQueue_.FreeTensor(residual);
                gQueue_.FreeTensor(gamma);
                bQueue_.FreeTensor(bias);
            }
        }
    }

private:
    __aicore__ inline AscendC::LocalTensor<T> LoadInput(
        AscendC::TQue<AscendC::TPosition::VECIN, 1>& queue,
        AscendC::GlobalTensor<T> source, uint32_t count)
    {
        auto raw = queue.AllocTensor<T>();
        AscendC::DataCopyPad(raw, source,
            {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0},
            {false, 0, 0, static_cast<T>(0)});
        queue.EnQue(raw);
        return queue.DeQue<T>();
    }

    __aicore__ inline AscendC::LocalTensor<float> ToFloat(
        AscendC::LocalTensor<T> source, AscendC::LocalTensor<float> destination,
        uint32_t count)
    {
        if constexpr (sizeof(T) == sizeof(float)) {
            return source.template ReinterpretCast<float>();
        } else {
            AscendC::Cast<float, T>(destination, source, AscendC::RoundMode::CAST_NONE, count);
            return destination;
        }
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_, rQueue_, gQueue_, bQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, reduceTmp_, reduceScalar_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xFloat_, rFloat_, gFloat_, bFloat_;
    AscendC::GlobalTensor<T> x_, residual_, gamma_, bias_, output_;
    int64_t rows_;
    int64_t width_;
    float epsilon_;
};

template <typename T, uint32_t TILE>
__aicore__ inline void RunTyped(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                GM_ADDR bias, GM_ADDR output, int64_t rows,
                                int64_t width, float epsilon)
{
    AddRmsNormBiasKernel<T, TILE> op;
    op.Init(x, residual, gamma, bias, output, rows, width, epsilon);
    op.Process();
}

template <uint32_t TILE>
__aicore__ inline void DispatchType(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                    GM_ADDR bias, GM_ADDR output, int32_t dtype,
                                    int64_t rows, int64_t width, float epsilon)
{
    if (dtype == kFp32) {
        RunTyped<float, TILE>(x, residual, gamma, bias, output, rows, width, epsilon);
    } else if (dtype == kFp16) {
        RunTyped<half, TILE>(x, residual, gamma, bias, output, rows, width, epsilon);
    } else {
        RunTyped<bfloat16_t, TILE>(x, residual, gamma, bias, output, rows, width, epsilon);
    }
}
}  // namespace

extern "C" __global__ __vector__ void wide_x_fresh4_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int32_t dtype, int64_t rows, int64_t width, float epsilon, uint32_t widePath)
{
    if (widePath != 0) {
        DispatchType<kWideTile>(x, residual, gamma, bias, output, dtype, rows, width, epsilon);
    } else {
        DispatchType<kFallbackTile>(x, residual, gamma, bias, output, dtype, rows, width, epsilon);
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    if (availableCoreNum <= 0 || !std::isfinite(epsilon) || epsilon < 0.0f) return;
    if (info_x.tensors == nullptr || info_x.numTensors != 1) return;
    const TensorInfo& xi = info_x.tensors[0];
    int64_t rows = 0, width = 0, tmpRows = 0, tmpWidth = 0;
    if (!ReadShape(info_x, xi.dtype, rows, width) ||
        !SameShape(info_x, info_residual) || !SameShape(info_x, info_output) ||
        !ReadVector(info_gamma, xi.dtype, width) || !ReadVector(info_bias, xi.dtype, width)) return;
    const uint32_t blocks = static_cast<uint32_t>(rows < availableCoreNum ? rows : availableCoreNum);
    const uint32_t widePath = width >= 16384 && width <= 32768;
    wide_x_fresh4_kernel<<<blocks, nullptr, stream>>>(x, residual, gamma, bias, output,
                                                      xi.dtype, rows, width, epsilon, widePath);
}

#else

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream, float epsilon)
{
    int64_t rows = 0, width = 0, otherRows = 0, otherWidth = 0;
    if (availableCoreNum <= 0 || !std::isfinite(epsilon) || epsilon < 0.0f) return;
    if (!ReadShape(info_x, info_x.tensors ? info_x.tensors[0].dtype : -1, rows, width) ||
        !SameShape(info_x, info_residual) || !SameShape(info_x, info_output) ||
        !ReadVector(info_gamma, info_x.tensors[0].dtype, width) ||
        !ReadVector(info_bias, info_x.tensors[0].dtype, width)) return;

    const float* xData = static_cast<const float*>(x);
    const float* residualData = static_cast<const float*>(residual);
    const float* gammaData = static_cast<const float*>(gamma);
    const float* biasData = static_cast<const float*>(bias);
    float* outputData = static_cast<float*>(output);
    for (int64_t r = 0; r < rows; ++r) {
        double squareSum = 0.0;
        for (int64_t j = 0; j < width; ++j) {
            const float u = xData[r * width + j] + residualData[r * width + j];
            squareSum += static_cast<double>(u) * u;
        }
        const float invRms = 1.0f / std::sqrt(static_cast<float>(squareSum / width) + epsilon);
        for (int64_t j = 0; j < width; ++j) {
            const float u = xData[r * width + j] + residualData[r * width + j];
            outputData[r * width + j] = u * invRms * gammaData[j] + biasData[j];
        }
    }
}

#endif
