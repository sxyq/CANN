// REDUCE-INVSCALE-X full-link smoke host.
#include <cstdint>
#include <cstdio>
#include <cmath>
#include "local_types.h"

#include "submission.asc"

int main()
{
    // Shape-only smoke: rank-2 FP32, R=2, D=64. Link coverage only.
    int64_t shape_x[2] = {2, 64};
    TensorInfo tx;
    tx.shape = shape_x;
    tx.numDims = 2;
    tx.dtype = 0;
    TensorInfo t1 = tx;
    TensorInfo t2 = tx;
    TensorInfo t3 = tx;
    TensorInfo t4 = tx;
    TensorGroupInfo gx;
    gx.tensors = &tx;
    gx.numTensors = 1;
    TensorGroupInfo gr = gx; gr.tensors = &t1;
    TensorGroupInfo gg = gx; gg.tensors = &t2;
    TensorGroupInfo gb = gx; gb.tensors = &t3;
    TensorGroupInfo go = gx; go.tensors = &t4;

    float eps = 1e-5f;
    run_kernel(nullptr, gx, nullptr, gr, nullptr, gg, nullptr, gb, nullptr, go,
               1, nullptr, eps);
    std::printf("REDUCE-INVSCALE-X full-link smoke ok\n");
    return 0;
}
