#include "judge_types.hpp"
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include "kernel_operator.h"
#define private public
#define run_kernel r05_address_unused_run_kernel
#include "submission.asc"
#undef run_kernel
#undef private

__global__ __vector__ void r05_capture_addresses(GM_ADDR output, uint64_t width)
{
    AddRmsNormBiasKernel<float> op;
    op.Init(output,output,output,output,output,width,16,16);
    auto dest=op.reduceFp32Buf_.Get<uint32_t>();
    for(int i=0;i<16;++i) dest.SetValue(i,0);
    dest.SetValue(0,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.xBuf_.Get<float>().GetPhyAddr())));
    dest.SetValue(1,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.residualBuf_.Get<float>().GetPhyAddr())));
    dest.SetValue(2,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.gammaBuf_.Get<float>().GetPhyAddr())));
    dest.SetValue(3,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.biasBuf_.Get<float>().GetPhyAddr())));
    dest.SetValue(4,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.xFp32Buf_.Get<float>().GetPhyAddr())));
    dest.SetValue(5,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.residualFp32Buf_.Get<float>().GetPhyAddr())));
    dest.SetValue(6,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.valueFp32Buf_.Get<float>().GetPhyAddr())));
    dest.SetValue(7,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.reduceFp32Buf_.Get<float>().GetPhyAddr())));
    dest.SetValue(8,static_cast<uint32_t>(reinterpret_cast<uintptr_t>(op.gammaBuf_.Get<float>()[64].GetPhyAddr())));
    dest.SetValue(9,static_cast<uint32_t>(width));
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::GlobalTensor<uint32_t> target;
    target.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(output),16);
    AscendC::DataCopyPad(target,dest,AscendC::DataCopyExtParams{1,64,0,0,0});
    AscendC::PipeBarrier<PIPE_ALL>();
}

void RequireAddress(aclError rc,const char* operation)
{
    if(rc!=ACL_SUCCESS) { std::fprintf(stderr,"ACL_FAILURE %s %d\n",operation,rc); std::exit(2); }
}
int main()
{
    RequireAddress(aclInit(nullptr),"init"); RequireAddress(aclrtSetDevice(2),"device");
    size_t freeBytes=0,totalBytes=0;
    RequireAddress(aclrtGetMemInfo(ACL_HBM_MEM,&freeBytes,&totalBytes),"memory");
    std::printf("DEVICE=2 FREE_HBM_MIB=%.6f PROBE=Parent_Init_LocalTensor_addresses NO_TIMING=YES\n",freeBytes/1048576.);
    if(freeBytes<100ull*1024*1024) return 4;
    aclrtStream stream=nullptr; void* output=nullptr;
    RequireAddress(aclrtCreateStream(&stream),"stream");
    RequireAddress(aclrtMalloc(&output,64,ACL_MEM_MALLOC_HUGE_FIRST),"allocate");
    const uint32_t widths[]={129,2048,2056,4096};
    const uint32_t expected[]={0,16384,32768,65536,98304,114688,131072,163840,33024};
    bool pass=true;
    for(uint32_t width:widths) {
        uint32_t values[16]{};
        r05_capture_addresses<<<1,nullptr,stream>>>(static_cast<uint8_t*>(output),width);
        RequireAddress(aclrtSynchronizeStream(stream),"synchronize");
        RequireAddress(aclrtMemcpy(values,64,output,64,ACL_MEMCPY_DEVICE_TO_HOST),"read addresses");
        std::printf("D=%u",width);
        for(int i=0;i<10;++i) std::printf(" addr%d=0x%x",i,values[i]);
        std::printf("\n");
        for(int i=0;i<9;++i) pass=pass && values[i]==expected[i];
        pass=pass && values[9]==width;
    }
    RequireAddress(aclrtFree(output),"free"); RequireAddress(aclrtDestroyStream(stream),"destroy stream");
    RequireAddress(aclrtResetDevice(2),"release context"); RequireAddress(aclFinalize(),"finalize");
    std::printf("ADDRESS_MODEL_MATCH=%s RUNNING_DEVICE_OPERATION=NONE\n",pass?"PASS":"FAIL");
    return pass?0:3;
}
