#include <acl/acl.h>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <limits>
#include <random>
#include <vector>

#include "../op_kernel/epi_x_fresh_tiling.h"
#include "../op_kernel/epi_x_fresh_kernel.asc"

namespace {

struct DeviceTensor {
    void* ptr = nullptr;
    size_t bytes = 0;
};

uint16_t FloatToHalfBits(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const uint32_t sign = (bits >> 16) & 0x8000u;
    const uint32_t exponent = (bits >> 23) & 0xffu;
    const uint32_t mantissa = bits & 0x7fffffu;
    if (exponent == 0xffu) {
        return static_cast<uint16_t>(sign | 0x7c00u | (mantissa ? 0x0200u : 0));
    }
    const int32_t halfExponent = static_cast<int32_t>(exponent) - 127 + 15;
    if (halfExponent >= 31) {
        return static_cast<uint16_t>(sign | 0x7c00u);
    }
    if (halfExponent <= 0) {
        if (halfExponent < -10) {
            return static_cast<uint16_t>(sign);
        }
        const uint32_t shifted = (mantissa | 0x800000u) >> static_cast<uint32_t>(14 - halfExponent);
        return static_cast<uint16_t>(sign | shifted);
    }
    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(halfExponent) << 10) |
        ((mantissa + 0x1000u) >> 13));
}

float HalfBitsToFloat(uint16_t value)
{
    const uint32_t sign = (static_cast<uint32_t>(value & 0x8000u)) << 16;
    const uint32_t exponent = (value >> 10) & 0x1fu;
    const uint32_t mantissa = value & 0x03ffu;
    uint32_t bits = sign;
    if (exponent == 0) {
        if (mantissa != 0) {
            uint32_t m = mantissa;
            int32_t e = -1;
            while ((m & 0x0400u) == 0) {
                m <<= 1;
                --e;
            }
            m &= 0x03ffu;
            bits |= static_cast<uint32_t>(e + 127) << 23;
            bits |= m << 13;
        }
    } else if (exponent == 0x1fu) {
        bits |= 0x7f800000u | (mantissa << 13);
    } else {
        bits |= (exponent + 112u) << 23 | (mantissa << 13);
    }
    float result = 0.0f;
    std::memcpy(&result, &bits, sizeof(result));
    return result;
}

void Encode(const std::vector<float>& values, uint32_t dtype, std::vector<uint8_t>& bytes)
{
    if (dtype == 2) {
        bytes.resize(values.size() * sizeof(float));
        std::memcpy(bytes.data(), values.data(), bytes.size());
        return;
    }
    bytes.resize(values.size() * sizeof(uint16_t));
    auto* dst = reinterpret_cast<uint16_t*>(bytes.data());
    for (size_t i = 0; i < values.size(); ++i) {
        const uint32_t bits = [&]() {
            uint32_t b = 0;
            std::memcpy(&b, &values[i], sizeof(b));
            return b;
        }();
        dst[i] = dtype == 0 ? FloatToHalfBits(values[i]) : static_cast<uint16_t>(bits >> 16);
    }
}

float DecodeOne(const uint8_t* bytes, size_t index, uint32_t dtype)
{
    if (dtype == 2) {
        return reinterpret_cast<const float*>(bytes)[index];
    }
    const uint16_t value = reinterpret_cast<const uint16_t*>(bytes)[index];
    if (dtype == 0) {
        return HalfBitsToFloat(value);
    }
    const uint32_t bits = static_cast<uint32_t>(value) << 16;
    float result = 0.0f;
    std::memcpy(&result, &bits, sizeof(result));
    return result;
}

void Release(DeviceTensor& tensor)
{
    if (tensor.ptr != nullptr) {
        aclrtFree(tensor.ptr);
        tensor.ptr = nullptr;
    }
}

}  // namespace

extern "C" int32_t run_kernel(uint32_t rows, uint32_t d, uint32_t dtype, float epsilon,
    void* x, void* residual, void* gamma, void* bias, void* output, aclrtStream stream)
{
    EpiXFreshTilingData hostTiling{};
    hostTiling.rows = rows;
    hostTiling.d = d;
    hostTiling.blockNum = rows < 40 ? rows : 40;
    hostTiling.rowsPerBlock = (rows + hostTiling.blockNum - 1) / hostTiling.blockNum;
    hostTiling.dtype = dtype;
    hostTiling.invD = 1.0f / static_cast<float>(d);
    hostTiling.epsilon = epsilon;

    void* tilingDevice = nullptr;
    aclError ret = aclrtMalloc(&tilingDevice, sizeof(hostTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        return ret;
    }
    ret = aclrtMemcpy(tilingDevice, sizeof(hostTiling), &hostTiling, sizeof(hostTiling),
        ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret == ACL_SUCCESS) {
        epi_x_fresh_kernel<<<hostTiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t*>(x), static_cast<uint8_t*>(residual),
            static_cast<uint8_t*>(gamma), static_cast<uint8_t*>(bias),
            static_cast<uint8_t*>(output), static_cast<uint8_t*>(tilingDevice));
        ret = aclrtSynchronizeStream(stream);
    }
    aclrtFree(tilingDevice);
    return ret;
}

bool CheckProbe(uint32_t rows, uint32_t d, uint32_t dtype, float epsilon, bool special)
{
    const size_t elements = static_cast<size_t>(rows) * d;
    std::vector<float> x(elements), residual(elements), gamma(d), bias(d);
    std::mt19937 gen(17 + dtype + d);
    std::uniform_real_distribution<float> dist(-1.5f, 1.5f);
    for (auto& value : x) value = dist(gen);
    for (auto& value : residual) value = dist(gen);
    for (auto& value : gamma) value = 0.5f + dist(gen) * 0.2f;
    for (auto& value : bias) value = dist(gen) * 0.1f;
    if (special) {
        x[0] = std::numeric_limits<float>::infinity();
        residual[0] = 0.0f;
        gamma[0] = 1.0f;
        bias[0] = 0.0f;
    }

    std::vector<uint8_t> xBytes, residualBytes, gammaBytes, biasBytes;
    Encode(x, dtype, xBytes);
    Encode(residual, dtype, residualBytes);
    Encode(gamma, dtype, gammaBytes);
    Encode(bias, dtype, biasBytes);
    std::vector<uint8_t> outputBytes(xBytes.size(), 0);
    DeviceTensor xDevice, residualDevice, gammaDevice, biasDevice, outputDevice;
    const size_t rowBytes = d * (dtype == 2 ? sizeof(float) : sizeof(uint16_t));
    const size_t paramBytes = d * (dtype == 2 ? sizeof(float) : sizeof(uint16_t));
    const size_t outputBytesSize = elements * (dtype == 2 ? sizeof(float) : sizeof(uint16_t));
    const auto allocate = [](DeviceTensor& tensor, size_t bytes) {
        tensor.bytes = bytes;
        return aclrtMalloc(&tensor.ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    };
    if (allocate(xDevice, rowBytes * rows) != ACL_SUCCESS ||
        allocate(residualDevice, rowBytes * rows) != ACL_SUCCESS ||
        allocate(gammaDevice, paramBytes) != ACL_SUCCESS ||
        allocate(biasDevice, paramBytes) != ACL_SUCCESS ||
        allocate(outputDevice, outputBytesSize) != ACL_SUCCESS) {
        Release(xDevice); Release(residualDevice); Release(gammaDevice);
        Release(biasDevice); Release(outputDevice);
        return false;
    }
    aclrtMemcpy(xDevice.ptr, xBytes.size(), xBytes.data(), xBytes.size(), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(residualDevice.ptr, residualBytes.size(), residualBytes.data(), residualBytes.size(),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(gammaDevice.ptr, gammaBytes.size(), gammaBytes.data(), gammaBytes.size(),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(biasDevice.ptr, biasBytes.size(), biasBytes.data(), biasBytes.size(),
        ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    const aclError launchRet = run_kernel(rows, d, dtype, epsilon, xDevice.ptr, residualDevice.ptr,
        gammaDevice.ptr, biasDevice.ptr, outputDevice.ptr, stream);
    const aclError copyRet = launchRet == ACL_SUCCESS
        ? aclrtMemcpy(outputBytes.data(), outputBytes.size(), outputDevice.ptr, outputBytes.size(),
            ACL_MEMCPY_DEVICE_TO_HOST)
        : launchRet;

    double maxError = 0.0;
    size_t failures = 0;
    for (uint32_t row = 0; row < rows; ++row) {
        float sum = 0.0f;
        for (uint32_t col = 0; col < d; ++col) {
            const size_t index = static_cast<size_t>(row) * d + col;
            const float u = DecodeOne(xBytes.data(), index, dtype) +
                DecodeOne(residualBytes.data(), index, dtype);
            sum += u * u;
        }
        const float inv = 1.0f / std::sqrt(sum / static_cast<float>(d) + epsilon);
        for (uint32_t col = 0; col < d; ++col) {
            const size_t index = static_cast<size_t>(row) * d + col;
            const float u = DecodeOne(xBytes.data(), index, dtype) +
                DecodeOne(residualBytes.data(), index, dtype);
            const float expected = u * inv * DecodeOne(gammaBytes.data(), col, dtype) +
                DecodeOne(biasBytes.data(), col, dtype);
            const float actual = DecodeOne(outputBytes.data(), index, dtype);
            const bool bothNan = std::isnan(expected) && std::isnan(actual);
            const bool bothInf = std::isinf(expected) && std::isinf(actual) &&
                std::signbit(expected) == std::signbit(actual);
            if (bothNan || bothInf) continue;
            const double error = std::fabs(static_cast<double>(actual) - expected);
            const double scale = std::max(1.0, std::fabs(static_cast<double>(expected)));
            maxError = std::max(maxError, error);
            const double tolerance = dtype == 2 ? 3e-4 * scale :
                (dtype == 0 ? 3e-2 * scale : 8e-2 * scale);
            if (!std::isfinite(actual) || error > tolerance) ++failures;
        }
    }

    aclrtDestroyStream(stream);
    Release(xDevice); Release(residualDevice); Release(gammaDevice);
    Release(biasDevice); Release(outputDevice);
    std::printf("probe rows=%u d=%u dtype=%u ret=%d max_error=%.8g failures=%zu\n",
        rows, d, dtype, copyRet, maxError, failures);
    return copyRet == ACL_SUCCESS && failures == 0;
}

int32_t main()
{
    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(0) != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL initialization failed\n");
        return 1;
    }
    const bool wideFp32Ok = CheckProbe(3, 8193, 2, 1e-5f, false);
    aclrtResetDevice(0);
    aclFinalize();
    return wideFp32Ok ? 0 : 2;
}
