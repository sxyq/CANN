#include <acl/acl.h>
#include "runner_source_paths.h"

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <thread>
#include <vector>

#ifndef MODE_PARENT_SOURCE_PATH
#error MODE_PARENT_SOURCE_PATH is required
#endif
#ifndef MODE_PARENT_SOURCE_SHA
#error MODE_PARENT_SOURCE_SHA is required
#endif
#ifndef MODE_PARENT_TILING_PATH
#error MODE_PARENT_TILING_PATH is required
#endif
#ifndef MODE_PARENT_TILING_SHA
#error MODE_PARENT_TILING_SHA is required
#endif
#ifndef MODE_CANDIDATE_SOURCE_PATH
#error MODE_CANDIDATE_SOURCE_PATH is required
#endif
#ifndef MODE_CANDIDATE_SOURCE_SHA
#error MODE_CANDIDATE_SOURCE_SHA is required
#endif
#ifndef MODE_CANDIDATE_TILING_PATH
#error MODE_CANDIDATE_TILING_PATH is required
#endif
#ifndef MODE_CANDIDATE_TILING_SHA
#error MODE_CANDIDATE_TILING_SHA is required
#endif

extern "C" void mode_r015c_parent_launch(uint32_t grid, void *input,
                                           void *output, void *tiling,
                                           aclrtStream stream);
extern "C" void mode_r015c_candidate_launch(uint32_t grid, void *input,
                                              void *output, void *tiling,
                                              aclrtStream stream);

namespace {

constexpr uint32_t kMinCols = 256;
constexpr uint32_t kMaxCols = 8192;
constexpr uint32_t kParentRowsPerBlock = 2;
constexpr uint32_t kCandidateRowsPerBlock = 1;
constexpr double kMaxMadRatio = 0.10;
constexpr double kMaxBlockDrift = 0.10;

struct RowCopyTiling {
    uint32_t rows;
    uint32_t cols;
};

enum class KernelRole { Parent, Candidate };

struct SampleSet {
    std::vector<double> deviceUs;
    std::vector<double> wallUs;
};

struct Distribution {
    double median;
    double mean;
    double stdev;
    double cv;
    double mad;
    double madRatio;
    double p10;
    double p90;
    double minimum;
    double maximum;
    double maxMin;
    double spread;
};

struct DeviceState {
    bool initialized = false;
    bool deviceSet = false;
    int32_t activeDevice = -1;
    aclrtStream stream = nullptr;
    aclrtEvent startEvent = nullptr;
    aclrtEvent stopEvent = nullptr;
    void *input = nullptr;
    void *output = nullptr;
    void *tiling = nullptr;

    ~DeviceState()
    {
        if (stream) aclrtSynchronizeStream(stream);
        if (stopEvent) aclrtDestroyEvent(stopEvent);
        if (startEvent) aclrtDestroyEvent(startEvent);
        if (tiling) aclrtFree(tiling);
        if (output) aclrtFree(output);
        if (input) aclrtFree(input);
        if (stream) aclrtDestroyStream(stream);
        if (deviceSet) aclrtResetDevice(activeDevice);
        if (initialized) aclFinalize();
    }
};

bool AclSuccess(aclError status, const char *operation)
{
    if (status == ACL_SUCCESS) return true;
    fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(status));
    return false;
}

bool ParseU32(const char *text, uint32_t *value)
{
    if (!text || !*text) return false;
    for (const char *cursor = text; *cursor; ++cursor) {
        if (*cursor < '0' || *cursor > '9') return false;
    }
    char *end = nullptr;
    const unsigned long parsed = strtoul(text, &end, 10);
    if (end == text || *end != '\0' || parsed > UINT32_MAX) return false;
    *value = static_cast<uint32_t>(parsed);
    return true;
}

bool ValidLeaseId(const char *value)
{
    if (!value || !*value || strlen(value) > 80) return false;
    for (const char *cursor = value; *cursor; ++cursor) {
        const char ch = *cursor;
        if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
              (ch >= '0' && ch <= '9') || ch == '.' || ch == '_' || ch == '-')) {
            return false;
        }
    }
    return true;
}

bool ValidShape(uint32_t rows, uint32_t cols)
{
    return rows > 1 && cols >= kMinCols && cols <= kMaxCols && cols % 8 == 0;
}

bool ValidRunCounts(uint32_t warmups, uint32_t samples, uint32_t pairs)
{
    return warmups >= 10 && samples >= 21 && pairs >= 4;
}

const char *RoleName(KernelRole role)
{
    return role == KernelRole::Parent ? "parent" : "candidate";
}

uint32_t RowsPerBlock(KernelRole role)
{
    return role == KernelRole::Parent ? kParentRowsPerBlock : kCandidateRowsPerBlock;
}

uint32_t GridSize(KernelRole role, uint32_t rows)
{
    const uint32_t rowsPerBlock = RowsPerBlock(role);
    return (rows + rowsPerBlock - 1) / rowsPerBlock;
}

void Launch(KernelRole role, uint32_t rows, uint32_t cols, DeviceState &state)
{
    const uint32_t grid = GridSize(role, rows);
    if (role == KernelRole::Parent) {
        mode_r015c_parent_launch(grid, state.input, state.output, state.tiling,
                                 state.stream);
    } else {
        mode_r015c_candidate_launch(grid, state.input, state.output,
                                    state.tiling, state.stream);
    }
    (void)cols;
}

bool PrepareDevice(DeviceState *state, uint32_t device, uint32_t rows, uint32_t cols)
{
    const size_t count = static_cast<size_t>(rows) * cols;
    const size_t bytes = count * sizeof(float);
    std::vector<float> hostInput(count);
    for (size_t i = 0; i < count; ++i) {
        hostInput[i] = static_cast<float>((i * 17 + 23) % 1009) / 31.0f;
    }
    const RowCopyTiling hostTiling{rows, cols};

    if (!AclSuccess(aclInit(nullptr), "aclInit")) return false;
    state->initialized = true;
    if (!AclSuccess(aclrtSetDevice(static_cast<int32_t>(device)), "aclrtSetDevice")) return false;
    state->deviceSet = true;
    state->activeDevice = static_cast<int32_t>(device);
    if (!AclSuccess(aclrtCreateStream(&state->stream), "aclrtCreateStream")) return false;
    if (!AclSuccess(aclrtMalloc(&state->input, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(input)")) return false;
    if (!AclSuccess(aclrtMalloc(&state->output, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(output)")) return false;
    if (!AclSuccess(aclrtMalloc(&state->tiling, sizeof(hostTiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(tiling)")) return false;
    if (!AclSuccess(aclrtMemcpy(state->input, bytes, hostInput.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy input")) return false;
    if (!AclSuccess(aclrtMemcpy(state->tiling, sizeof(hostTiling), &hostTiling, sizeof(hostTiling), ACL_MEMCPY_HOST_TO_DEVICE), "copy tiling")) return false;
    if (!AclSuccess(aclrtCreateEvent(&state->startEvent), "aclrtCreateEvent(start)")) return false;
    if (!AclSuccess(aclrtCreateEvent(&state->stopEvent), "aclrtCreateEvent(stop)")) return false;
    printf("RUNTIME_PREP device=%u rows=%u D=%u allocation=ONCE h2d=BEFORE_WARMUP d2h=NOT_RUN\n",
           device, rows, cols);
    return true;
}

bool Warmup(DeviceState &state, KernelRole role, uint32_t rows, uint32_t cols, uint32_t count)
{
    for (uint32_t i = 0; i < count; ++i) {
        Launch(role, rows, cols, state);
        if (!AclSuccess(aclrtSynchronizeStream(state.stream), "warmup synchronize")) return false;
    }
    printf("WARMUP_DONE role=%s count=%u sync_each=YES\n", RoleName(role), count);
    return true;
}

bool TimedSample(DeviceState &state, KernelRole role, uint32_t rows, uint32_t cols,
                 double *deviceUs, double *wallUs)
{
    if (!AclSuccess(aclrtRecordEvent(state.startEvent, state.stream), "record start event")) return false;
    const auto wallStart = std::chrono::steady_clock::now();
    Launch(role, rows, cols, state);
    if (!AclSuccess(aclrtRecordEvent(state.stopEvent, state.stream), "record stop event")) return false;
    if (!AclSuccess(aclrtSynchronizeStream(state.stream), "sample synchronize")) return false;
    const auto wallStop = std::chrono::steady_clock::now();
    float elapsedMs = 0.0f;
    if (!AclSuccess(aclrtEventElapsedTime(&elapsedMs, state.startEvent, state.stopEvent), "event elapsed time")) return false;
    *deviceUs = static_cast<double>(elapsedMs) * 1000.0;
    *wallUs = std::chrono::duration<double, std::micro>(wallStop - wallStart).count();
    return true;
}

bool CollectBlock(DeviceState &state, KernelRole role, uint32_t rows, uint32_t cols,
                  uint32_t sampleCount, const char *phase, uint32_t block, SampleSet *samples)
{
    samples->deviceUs.reserve(sampleCount);
    samples->wallUs.reserve(sampleCount);
    for (uint32_t i = 0; i < sampleCount; ++i) {
        double deviceUs = 0.0;
        double wallUs = 0.0;
        if (!TimedSample(state, role, rows, cols, &deviceUs, &wallUs)) return false;
        samples->deviceUs.push_back(deviceUs);
        samples->wallUs.push_back(wallUs);
        printf("RAW_SAMPLE phase=%s role=%s block=%u sample=%u device_us=%.6f wall_us=%.3f\n",
               phase, RoleName(role), block, i + 1, deviceUs, wallUs);
    }
    return true;
}

double Median(std::vector<double> values)
{
    std::sort(values.begin(), values.end());
    const size_t middle = values.size() / 2;
    if (values.size() % 2) return values[middle];
    return (values[middle - 1] + values[middle]) / 2.0;
}

double NearestRank(const std::vector<double> &sorted, double q)
{
    const size_t index = static_cast<size_t>(std::ceil(q * sorted.size())) - 1;
    return sorted[std::min(index, sorted.size() - 1)];
}

Distribution Summarize(const std::vector<double> &values)
{
    std::vector<double> sorted = values;
    std::sort(sorted.begin(), sorted.end());
    const double median = Median(values);
    double mean = 0.0;
    for (double value : values) mean += value;
    mean /= values.size();
    double sumSquares = 0.0;
    std::vector<double> deviations;
    deviations.reserve(values.size());
    for (double value : values) {
        const double centered = value - mean;
        sumSquares += centered * centered;
        deviations.push_back(std::fabs(value - median));
    }
    const double stdev = values.size() > 1 ? std::sqrt(sumSquares / (values.size() - 1)) : 0.0;
    const double mad = Median(deviations);
    const double minimum = sorted.front();
    const double maximum = sorted.back();
    return {median, mean, stdev, mean == 0.0 ? 0.0 : stdev / mean,
            mad, median == 0.0 ? 0.0 : mad / median,
            NearestRank(sorted, 0.10), NearestRank(sorted, 0.90),
            minimum, maximum, minimum == 0.0 ? 0.0 : maximum / minimum,
            maximum - minimum};
}

void PrintDistribution(const char *phase, const char *role, uint32_t block,
                       const SampleSet &samples)
{
    const Distribution device = Summarize(samples.deviceUs);
    const Distribution wall = Summarize(samples.wallUs);
    printf("BLOCK_SUMMARY phase=%s role=%s block=%u n=%zu device_median_us=%.6f device_mean_us=%.6f device_stdev_us=%.6f device_cv=%.6f device_mad_us=%.6f device_mad_median=%.6f device_p10_us=%.6f device_p90_us=%.6f device_min_us=%.6f device_max_us=%.6f device_max_min=%.6f device_spread_us=%.6f wall_median_us=%.3f wall_mad_median=%.6f\n",
           phase, role, block, samples.deviceUs.size(), device.median, device.mean,
           device.stdev, device.cv, device.mad, device.madRatio, device.p10,
           device.p90, device.minimum, device.maximum, device.maxMin, device.spread,
           wall.median, wall.madRatio);
}

void Append(std::vector<double> *target, const std::vector<double> &source)
{
    target->insert(target->end(), source.begin(), source.end());
}

void PrintIdentity()
{
    printf("ROUTE=MODE-X-R015C\n");
    printf("PARENT_REVISION=R015C-r3\nPARENT_SOURCE_PATH=%s\nPARENT_SOURCE_SHA256=%s\n",
           MODE_PARENT_SOURCE_PATH, MODE_PARENT_SOURCE_SHA);
    printf("PARENT_TILING_PATH=%s\nPARENT_TILING_SHA256=%s\nPARENT_ROWS_PER_BLOCK=%u\n",
           MODE_PARENT_TILING_PATH, MODE_PARENT_TILING_SHA, kParentRowsPerBlock);
    printf("CANDIDATE_REVISION=R015C-r4\nCANDIDATE_SOURCE_PATH=%s\nCANDIDATE_SOURCE_SHA256=%s\n",
           MODE_CANDIDATE_SOURCE_PATH, MODE_CANDIDATE_SOURCE_SHA);
    printf("CANDIDATE_TILING_PATH=%s\nCANDIDATE_TILING_SHA256=%s\nCANDIDATE_ROWS_PER_BLOCK=%u\n",
           MODE_CANDIDATE_TILING_PATH, MODE_CANDIDATE_TILING_SHA, kCandidateRowsPerBlock);
    printf("PROCESS_MODEL=SINGLE_PROCESS_SHARED_ACL_CONTEXT\nNPU_ACCESS=NONE\n");
}

void PrintPlan(uint32_t device, uint32_t rows, uint32_t cols,
               uint32_t warmups, uint32_t samples, uint32_t pairs)
{
    printf("MODE=HOST_ONLY_PLAN device=%u rows=%u D=%u warmups_per_kernel=%u samples_per_block=%u pairs=%u\n",
           device, rows, cols, warmups, samples, pairs);
    printf("QUALIFICATION=parent_same_binary blocks=2 samples_per_block=%u max_mad_median=%.2f max_block_drift=%.2f\n",
           samples, kMaxMadRatio, kMaxBlockDrift);
    printf("PAIR_ORDER=PC,CP alternating_pairs=%u\n", pairs);
    printf("EXECUTION=NOT_RUN NPU_ACCESS=NONE TIMING=NOT_RUN\n");
}

int RunSequence(const char *lease, uint32_t device, uint32_t rows, uint32_t cols,
                uint32_t warmups, uint32_t samples, uint32_t pairs)
{
    printf("MODE=LEASED_SEQUENCE route=MODE-X-R015C lease=%s device=%u rows=%u D=%u warmups=%u samples_per_block=%u pairs=%u order=PC_CP_ALTERNATING\n",
           lease, device, rows, cols, warmups, samples, pairs);
    DeviceState state;
    if (!PrepareDevice(&state, device, rows, cols)) return 1;
    if (!Warmup(state, KernelRole::Parent, rows, cols, warmups)) return 1;

    SampleSet parentA;
    SampleSet parentB;
    if (!CollectBlock(state, KernelRole::Parent, rows, cols, samples, "QUALIFICATION", 1, &parentA)) return 1;
    PrintDistribution("QUALIFICATION", "parent", 1, parentA);
    std::this_thread::sleep_for(std::chrono::seconds(1));
    if (!CollectBlock(state, KernelRole::Parent, rows, cols, samples, "QUALIFICATION", 2, &parentB)) return 1;
    PrintDistribution("QUALIFICATION", "parent", 2, parentB);

    std::vector<double> fullParent;
    Append(&fullParent, parentA.deviceUs);
    Append(&fullParent, parentB.deviceUs);
    const Distribution full = Summarize(fullParent);
    const double blockDrift = std::fabs(Median(parentA.deviceUs) - Median(parentB.deviceUs)) / full.median;
    const bool qualified = full.madRatio <= kMaxMadRatio && blockDrift <= kMaxBlockDrift;
    printf("SHAPE_QUALIFICATION status=%s samples=%zu full_device_mad_median=%.6f block_median_drift=%.6f parent_full_median_us=%.6f\n",
           qualified ? "PASS" : "FAIL", fullParent.size(), full.madRatio,
           blockDrift, full.median);
    if (!qualified) {
        printf("PAIRS_SKIPPED reason=SHAPE_QUALIFICATION_NOT_PASS\n");
        return 4;
    }

    for (uint32_t i = 0; i < warmups; ++i) {
        Launch(KernelRole::Parent, rows, cols, state);
        if (!AclSuccess(aclrtSynchronizeStream(state.stream), "paired parent warmup synchronize")) return 1;
        Launch(KernelRole::Candidate, rows, cols, state);
        if (!AclSuccess(aclrtSynchronizeStream(state.stream), "paired candidate warmup synchronize")) return 1;
    }
    printf("PAIRED_WARMUP_DONE parent=%u candidate=%u sync_each=YES\n", warmups, warmups);

    for (uint32_t pair = 1; pair <= pairs; ++pair) {
        const bool parentFirst = pair % 2 == 1;
        SampleSet parent;
        SampleSet candidate;
        const char *order = parentFirst ? "PC" : "CP";
        if (parentFirst) {
            if (!CollectBlock(state, KernelRole::Parent, rows, cols, samples, "PAIRED", pair, &parent)) return 1;
            PrintDistribution("PAIRED", "parent", pair, parent);
            if (!CollectBlock(state, KernelRole::Candidate, rows, cols, samples, "PAIRED", pair, &candidate)) return 1;
            PrintDistribution("PAIRED", "candidate", pair, candidate);
        } else {
            if (!CollectBlock(state, KernelRole::Candidate, rows, cols, samples, "PAIRED", pair, &candidate)) return 1;
            PrintDistribution("PAIRED", "candidate", pair, candidate);
            if (!CollectBlock(state, KernelRole::Parent, rows, cols, samples, "PAIRED", pair, &parent)) return 1;
            PrintDistribution("PAIRED", "parent", pair, parent);
        }
        const double parentMedian = Median(parent.deviceUs);
        const double candidateMedian = Median(candidate.deviceUs);
        printf("PAIR_RESULT pair=%u order=%s parent_median_us=%.6f candidate_median_us=%.6f delta_candidate_minus_parent_us=%.6f delta_percent=%.6f\n",
               pair, order, parentMedian, candidateMedian, candidateMedian - parentMedian,
               parentMedian == 0.0 ? 0.0 : 100.0 * (candidateMedian - parentMedian) / parentMedian);
    }
    printf("SEQUENCE_COMPLETE qualification=PASS pairs=%u\n", pairs);
    return 0;
}

void Usage(const char *program)
{
    fprintf(stderr,
            "usage:\n  %s --identity\n  %s --plan DEVICE R D WARMUPS SAMPLES PAIRS\n  %s --run MAIN1_LEASE DEVICE R D WARMUPS SAMPLES PAIRS\n",
            program, program, program);
    fprintf(stderr, "\nrun requires WARMUPS>=10, SAMPLES>=21, PAIRS>=4 and first qualifies the r3 parent shape.\n");
}

bool ParseShapeArgs(char **argv, uint32_t offset, uint32_t *device, uint32_t *rows,
                    uint32_t *cols, uint32_t *warmups, uint32_t *samples, uint32_t *pairs)
{
    return ParseU32(argv[offset], device) && *device <= 7 &&
           ParseU32(argv[offset + 1], rows) && ParseU32(argv[offset + 2], cols) &&
           ParseU32(argv[offset + 3], warmups) && ParseU32(argv[offset + 4], samples) &&
           ParseU32(argv[offset + 5], pairs) && ValidShape(*rows, *cols) &&
           ValidRunCounts(*warmups, *samples, *pairs);
}

}  // namespace

int main(int argc, char **argv)
{
    if (argc == 2 && strcmp(argv[1], "--identity") == 0) {
        PrintIdentity();
        return 0;
    }

    uint32_t device = 0, rows = 0, cols = 0, warmups = 0, samples = 0, pairs = 0;
    if (argc == 8 && strcmp(argv[1], "--plan") == 0) {
        if (!ParseShapeArgs(argv, 2, &device, &rows, &cols, &warmups, &samples, &pairs)) {
            fprintf(stderr, "invalid shape, device, or count; required warmups>=10, samples>=21, pairs>=4\n");
            Usage(argv[0]);
            return 64;
        }
        PrintPlan(device, rows, cols, warmups, samples, pairs);
        return 0;
    }

    if (argc == 9 && strcmp(argv[1], "--run") == 0) {
        if (!ValidLeaseId(argv[2]) ||
            !ParseShapeArgs(argv, 3, &device, &rows, &cols, &warmups, &samples, &pairs)) {
            fprintf(stderr, "invalid lease, shape, device, or count; required warmups>=10, samples>=21, pairs>=4\n");
            Usage(argv[0]);
            return 64;
        }
        return RunSequence(argv[2], device, rows, cols, warmups, samples, pairs);
    }

    Usage(argv[0]);
    return 64;
}
