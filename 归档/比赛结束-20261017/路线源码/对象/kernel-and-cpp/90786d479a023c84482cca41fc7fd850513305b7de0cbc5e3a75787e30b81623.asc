#include "kernel_operator.h"
#include "add_rms_norm_bias_tiling.h"

namespace {

template <typename T>
class AddRmsNormBiasKernel {
public:
    __aicore__ inline AddRmsNormBiasKernel(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
        GM_ADDR bias, GM_ADDR output, const __gm__ AddRmsNormBiasTilingData *tiling)
    {
        tiling_ = tiling;
        const uint32_t block = AscendC::GetBlockIdx();
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + tiling->firstRow * tiling->d,
            tiling->rowsThisCore * tiling->d);
        residual_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(residual) + tiling->firstRow * tiling->d,
            tiling->rowsThisCore * tiling->d);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(output) + tiling->firstRow * tiling->d,
            tiling->rowsThisCore * tiling->d);
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gamma), tiling->d);
        bias_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bias), tiling->d);

        // Four input/output queues are double buffered. FP32 work buffers are
        // reused between the statistic and output passes.
        const uint32_t chunk = tiling->chunkElements;
        pipe_->InitBuffer(xQueue_, kA001DoubleBuffer, chunk * sizeof(T));
        pipe_->InitBuffer(residualQueue_, kA001DoubleBuffer, chunk * sizeof(T));
        pipe_->InitBuffer(gammaQueue_, kA001DoubleBuffer, chunk * sizeof(T));
        pipe_->InitBuffer(biasQueue_, kA001DoubleBuffer, chunk * sizeof(T));
        pipe_->InitBuffer(outputQueue_, kA001DoubleBuffer, chunk * sizeof(T));
        pipe_->InitBuffer(xFloat_, chunk * sizeof(float));
        pipe_->InitBuffer(residualFloat_, chunk * sizeof(float));
        pipe_->InitBuffer(gammaFloat_, chunk * sizeof(float));
        pipe_->InitBuffer(biasFloat_, chunk * sizeof(float));
        pipe_->InitBuffer(uFloat_, chunk * sizeof(float));
        pipe_->InitBuffer(squareFloat_, chunk * sizeof(float));
        pipe_->InitBuffer(outputFloat_, chunk * sizeof(float));
        pipe_->InitBuffer(reduceTmp_, chunk * sizeof(float));
        pipe_->InitBuffer(sum_, 32);
        pipe_->InitBuffer(rms_, 32);
    }

    __aicore__ inline void Process()
    {
        // The hot path keeps the row owner and parameter stripe resident for a
        // complete row. Larger rows use the same row ownership with streamed
        // chunks; no D slice is assigned to another core.
        for (uint64_t row = 0; row < tiling_->rowsThisCore; ++row) {
            const uint64_t rowOffset = row * tiling_->d;
            if (tiling_->d <= kA001HotPathD) {
                ProcessRow(rowOffset, true);
            } else {
                ProcessRow(rowOffset, false);
            }
        }
    }

private:
    __aicore__ inline void CopyIn(AscendC::LocalTensor<T> dst,
        const AscendC::GlobalTensor<T> &src, uint64_t offset, uint32_t count)
    {
        AscendC::DataCopyPad(dst, src[offset],
            {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0},
            {false, 0, 0, 0});
    }

    __aicore__ inline void ToFloat(AscendC::LocalTensor<float> dst,
        AscendC::LocalTensor<T> src, uint32_t count)
    {
        if constexpr (AscendC::Std::is_same_v<T, float>) {
            AscendC::DataCopy<float>(dst, src,
                {1, static_cast<uint16_t>((count + 7) / 8), 0, 0});
        } else {
            AscendC::Cast<float, T>(dst, src, AscendC::RoundMode::CAST_NONE, count);
        }
    }

    __aicore__ inline void FromFloat(AscendC::LocalTensor<T> dst,
        AscendC::LocalTensor<float> src, uint32_t count)
    {
        if constexpr (AscendC::Std::is_same_v<T, float>) {
            AscendC::DataCopy<float>(dst, src,
                {1, static_cast<uint16_t>((count + 7) / 8), 0, 0});
        } else {
            AscendC::Cast<T, float>(dst, src, AscendC::RoundMode::CAST_ROUND, count);
        }
    }

    __aicore__ inline void LoadFloatParams(AscendC::LocalTensor<float> gamma,
        AscendC::LocalTensor<float> bias, uint64_t column, uint32_t count)
    {
        auto gammaIn = gammaQueue_.AllocTensor<T>();
        auto biasIn = biasQueue_.AllocTensor<T>();
        CopyIn(gammaIn, gamma_, column, count);
        CopyIn(biasIn, bias_, column, count);
        gammaQueue_.EnQue(gammaIn);
        biasQueue_.EnQue(biasIn);
        auto gammaSrc = gammaQueue_.DeQue<T>();
        auto biasSrc = biasQueue_.DeQue<T>();
        ToFloat(gamma, gammaSrc, count);
        ToFloat(bias, biasSrc, count);
        gammaQueue_.FreeTensor(gammaSrc);
        biasQueue_.FreeTensor(biasSrc);
    }

    __aicore__ inline void LoadU(AscendC::LocalTensor<float> u, uint64_t rowOffset,
        uint64_t column, uint32_t count)
    {
        auto xIn = xQueue_.AllocTensor<T>();
        auto residualIn = residualQueue_.AllocTensor<T>();
        CopyIn(xIn, x_, rowOffset + column, count);
        CopyIn(residualIn, residual_, rowOffset + column, count);
        xQueue_.EnQue(xIn);
        residualQueue_.EnQue(residualIn);
        auto xSrc = xQueue_.DeQue<T>();
        auto residualSrc = residualQueue_.DeQue<T>();
        auto xFloat = xFloat_.Get<float>();
        auto residualFloat = residualFloat_.Get<float>();
        ToFloat(xFloat, xSrc, count);
        ToFloat(residualFloat, residualSrc, count);
        AscendC::Add(u, xFloat, residualFloat, count);
        xQueue_.FreeTensor(xSrc);
        residualQueue_.FreeTensor(residualSrc);
    }

    __aicore__ inline void Accumulate(AscendC::LocalTensor<float> sum,
        AscendC::LocalTensor<float> u, uint32_t count)
    {
        auto square = squareFloat_.Get<float>();
        auto reduceTmp = reduceTmp_.Get<float>();
        auto part = rms_.Get<float>();
        AscendC::Duplicate(part, 0.0f, 8);
        AscendC::Mul(square, u, u, count);
        AscendC::ReduceSum<float, true>(part, square, reduceTmp, count);
        AscendC::Add(sum, sum, part, 8);
    }

    __aicore__ inline void ProcessRow(uint64_t rowOffset, bool hotPath)
    {
        const uint32_t chunk = hotPath ? static_cast<uint32_t>(tiling_->d)
            : tiling_->chunkElements;
        auto sum = sum_.Get<float>();
        auto rms = rms_.Get<float>();
        AscendC::Duplicate(sum, 0.0f, 8);

        for (uint64_t column = 0; column < tiling_->d; column += chunk) {
            const uint32_t count = static_cast<uint32_t>(
                (column + chunk <= tiling_->d) ? chunk : tiling_->d - column);
            auto u = uFloat_.Get<float>();
            LoadU(u, rowOffset, column, count);
            Accumulate(sum, u, count);
        }

        const float invD = tiling_->invD;
        const float epsilon = tiling_->epsilon;
        AscendC::Muls(sum, sum, invD, 8);
        AscendC::Adds(sum, sum, epsilon, 8);
        AscendC::Sqrt(rms, sum, 8);
        AscendC::Muls(rms, rms, 1.0f, 8);

        for (uint64_t column = 0; column < tiling_->d; column += chunk) {
            const uint32_t count = static_cast<uint32_t>(
                (column + chunk <= tiling_->d) ? chunk : tiling_->d - column);
            auto u = uFloat_.Get<float>();
            auto gamma = gammaFloat_.Get<float>();
            auto bias = biasFloat_.Get<float>();
            auto outFloat = outputFloat_.Get<float>();
            LoadU(u, rowOffset, column, count);
            LoadFloatParams(gamma, bias, column, count);
            AscendC::Muls(outFloat, u, 1.0f, count);
            AscendC::Muls(outFloat, outFloat, 1.0f / rms.GetValue(0), count);
            AscendC::Mul(outFloat, outFloat, gamma, count);
            AscendC::Add(outFloat, outFloat, bias, count);
            auto outputLocal = outputQueue_.AllocTensor<T>();
            FromFloat(outputLocal, outFloat, count);
            outputQueue_.EnQue(outputLocal);
            auto outputReady = outputQueue_.DeQue<T>();
            AscendC::DataCopyPad(output_[rowOffset + column], outputReady,
                {1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0});
            outputQueue_.FreeTensor(outputReady);
        }
    }

    AscendC::TPipe *pipe_;
    const __gm__ AddRmsNormBiasTilingData *tiling_;
    AscendC::GlobalTensor<T> x_, residual_, gamma_, bias_, output_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_, residualQueue_, gammaQueue_, biasQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xFloat_, residualFloat_, gammaFloat_, biasFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> uFloat_, squareFloat_, outputFloat_, reduceTmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sum_, rms_;
};

}  // namespace

extern "C" __global__ __aicore__ void add_rms_norm_bias_fp16(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    AddRmsNormBiasKernel<half> op(&pipe);
    op.Init(x, residual, gamma, bias, output,
        reinterpret_cast<const __gm__ AddRmsNormBiasTilingData *>(tiling));
    op.Process();
}

extern "C" __global__ __aicore__ void add_rms_norm_bias_bf16(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    AddRmsNormBiasKernel<bfloat16_t> op(&pipe);
    op.Init(x, residual, gamma, bias, output,
        reinterpret_cast<const __gm__ AddRmsNormBiasTilingData *>(tiling));
    op.Process();
}

extern "C" __global__ __aicore__ void add_rms_norm_bias_fp32(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    AddRmsNormBiasKernel<float> op(&pipe);
    op.Init(x, residual, gamma, bias, output,
        reinterpret_cast<const __gm__ AddRmsNormBiasTilingData *>(tiling));
    op.Process();
}
