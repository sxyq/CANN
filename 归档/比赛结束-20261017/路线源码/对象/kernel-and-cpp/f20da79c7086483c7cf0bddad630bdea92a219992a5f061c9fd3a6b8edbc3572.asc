// ASYNC-TRIPLE-X SEED (route seed / R013-derived baseline)
// Donor: R013 DOUBLE-BUFFER PIPELINE kernel (MTE2 prefetch N+1 + Vector compute N).
// MTE3 store remains same-iteration after compute — NOT scheduled as stage N-1.
// SINGLE_HYPOTHESIS for V001 is recorded in PRECODE.md; this file is the Direct Parent.
#include "kernel_operator.h"

#include <stdint.h>

namespace async_triple_x_seed {

constexpr uint32_t kTileLength = 1024;
constexpr uint32_t kDoubleBuffer = 2;
constexpr uint32_t kBlockBytes = 32;
constexpr uint32_t kFp32ScalarCount = kBlockBytes / sizeof(float);
constexpr uint32_t kReduceTmpBytes = 32 * 1024;

struct RmsNormBiasTiling {
    uint64_t outer;
    uint64_t width;
    uint32_t blockNum;
    float epsilon;
    float invWidth;
};

__aicore__ inline void ToFp32(const AscendC::LocalTensor<float>& dst,
    const AscendC::LocalTensor<float>& src, uint32_t count)
{
    // Local DataCopy blockLen is in 32B blocks (8 floats), not bytes.
    AscendC::DataCopyParams params{1, static_cast<uint16_t>((count + 7) / 8), 0, 0};
    AscendC::DataCopy(dst, src, params);
}

__aicore__ inline void ToFp32(const AscendC::LocalTensor<float>& dst,
    const AscendC::LocalTensor<half>& src, uint32_t count)
{
    AscendC::Cast<float, half>(dst, src, AscendC::RoundMode::CAST_NONE, count);
}

__aicore__ inline void ToFp32(const AscendC::LocalTensor<float>& dst,
    const AscendC::LocalTensor<bfloat16_t>& src, uint32_t count)
{
    AscendC::Cast<float, bfloat16_t>(dst, src, AscendC::RoundMode::CAST_NONE, count);
}

__aicore__ inline void FromFp32(const AscendC::LocalTensor<float>& dst,
    const AscendC::LocalTensor<float>& src, uint32_t count)
{
    AscendC::DataCopyParams params{1, static_cast<uint16_t>((count + 7) / 8), 0, 0};
    AscendC::DataCopy(dst, src, params);
}

__aicore__ inline void FromFp32(const AscendC::LocalTensor<half>& dst,
    const AscendC::LocalTensor<float>& src, uint32_t count)
{
    AscendC::Cast<half, float>(dst, src, AscendC::RoundMode::CAST_ROUND, count);
}

__aicore__ inline void FromFp32(const AscendC::LocalTensor<bfloat16_t>& dst,
    const AscendC::LocalTensor<float>& src, uint32_t count)
{
    AscendC::Cast<bfloat16_t, float>(dst, src, AscendC::RoundMode::CAST_ROUND, count);
}

template <typename T>
class KernelRmsNormBias {
public:
    __aicore__ inline KernelRmsNormBias(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
        GM_ADDR bias, GM_ADDR output, const __gm__ RmsNormBiasTiling* tiling)
    {
        tiling_ = tiling;
        width_ = tiling_->width;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual));
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output));

        pipe_->InitBuffer(xQueue_, kDoubleBuffer, kTileLength * sizeof(T));
        pipe_->InitBuffer(residualQueue_, kDoubleBuffer, kTileLength * sizeof(T));
        pipe_->InitBuffer(paramQueue_, kDoubleBuffer, 2 * kTileLength * sizeof(T));
        pipe_->InitBuffer(outputQueue_, kDoubleBuffer, kTileLength * sizeof(T));

        pipe_->InitBuffer(xFp32Buf_, kTileLength * sizeof(float));
        pipe_->InitBuffer(residualFp32Buf_, kTileLength * sizeof(float));
        pipe_->InitBuffer(gammaFp32Buf_, kTileLength * sizeof(float));
        pipe_->InitBuffer(biasFp32Buf_, kTileLength * sizeof(float));
        pipe_->InitBuffer(reduceResultBuf_, kFp32ScalarCount * sizeof(float));
        pipe_->InitBuffer(reduceTmpBuf_, kReduceTmpBytes);
        pipe_->InitBuffer(sumSquaresBuf_, kFp32ScalarCount * sizeof(float));
        pipe_->InitBuffer(normScalarBuf_, kFp32ScalarCount * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t blockNum = tiling_->blockNum;
        for (uint64_t row = blockIdx; row < tiling_->outer; row += blockNum) {
            ProcessRow(row);
        }
    }

private:
    __aicore__ inline uint32_t AlignCount(uint32_t count) const
    {
        const uint32_t elemsPerBlock = kBlockBytes / sizeof(T);
        return (count + elemsPerBlock - 1) / elemsPerBlock * elemsPerBlock;
    }

    __aicore__ inline AscendC::DataCopyExtParams MakeCopyParams(uint32_t count) const
    {
        return AscendC::DataCopyExtParams{
            1,
            static_cast<uint32_t>(count * sizeof(T)),
            0,
            0,
            0};
    }

    __aicore__ inline AscendC::DataCopyPadExtParams<T> MakePadParams(
        uint32_t count, uint32_t alignedCount) const
    {
        return AscendC::DataCopyPadExtParams<T>{
            true,
            0,
            static_cast<uint8_t>(alignedCount - count),
            static_cast<T>(0)};
    }

    __aicore__ inline void CopyInData(uint64_t row, uint64_t tileOffset, uint32_t count)
    {
        const uint32_t alignedCount = AlignCount(count);
        const uint64_t gmOffset = row * width_ + tileOffset;
        const auto copyParams = MakeCopyParams(count);
        const auto padParams = MakePadParams(count, alignedCount);

        AscendC::LocalTensor<T> xLocal = xQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> residualLocal = residualQueue_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[gmOffset], copyParams, padParams);
        AscendC::DataCopyPad(residualLocal, residualGm_[gmOffset], copyParams, padParams);
        xQueue_.EnQue(xLocal);
        residualQueue_.EnQue(residualLocal);
    }

    __aicore__ inline void CopyInOutputData(uint64_t row, uint64_t tileOffset, uint32_t count)
    {
        const uint32_t alignedCount = AlignCount(count);
        const auto copyParams = MakeCopyParams(count);
        const auto padParams = MakePadParams(count, alignedCount);
        const uint64_t rowOffset = row * width_;

        AscendC::LocalTensor<T> xLocal = xQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> residualLocal = residualQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> paramLocal = paramQueue_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[rowOffset + tileOffset], copyParams, padParams);
        AscendC::DataCopyPad(residualLocal, residualGm_[rowOffset + tileOffset], copyParams, padParams);
        AscendC::DataCopyPad(paramLocal, gammaGm_[tileOffset], copyParams, padParams);
        AscendC::DataCopyPad(paramLocal[alignedCount], biasGm_[tileOffset], copyParams, padParams);
        xQueue_.EnQue(xLocal);
        residualQueue_.EnQue(residualLocal);
        paramQueue_.EnQue(paramLocal);
    }

    __aicore__ inline void AccumulateTile(uint32_t count)
    {
        const uint32_t alignedCount = AlignCount(count);
        AscendC::LocalTensor<T> xLocal = xQueue_.DeQue<T>();
        AscendC::LocalTensor<T> residualLocal = residualQueue_.DeQue<T>();

        AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> reduceResult = reduceResultBuf_.Get<float>();
        AscendC::LocalTensor<float> reduceTmp = reduceTmpBuf_.Get<float>();

        ToFp32(xFp32, xLocal, alignedCount);
        ToFp32(residualFp32, residualLocal, alignedCount);
        AscendC::Add<float>(xFp32, xFp32, residualFp32, alignedCount);
        AscendC::Mul<float>(residualFp32, xFp32, xFp32, alignedCount);
        AscendC::Duplicate(reduceResult, 0.0f, kFp32ScalarCount);
        AscendC::ReduceSum<float, true>(reduceResult, residualFp32, reduceTmp,
            static_cast<int32_t>(alignedCount));
        AscendC::LocalTensor<float> sumSquares = sumSquaresBuf_.Get<float>();
        AscendC::Add<float>(sumSquares, sumSquares, reduceResult, kFp32ScalarCount);

        xQueue_.FreeTensor(xLocal);
        residualQueue_.FreeTensor(residualLocal);
    }

    __aicore__ inline void ComputeOutputTile(uint32_t count, float inverseRms)
    {
        const uint32_t alignedCount = AlignCount(count);
        AscendC::LocalTensor<T> xLocal = xQueue_.DeQue<T>();
        AscendC::LocalTensor<T> residualLocal = residualQueue_.DeQue<T>();
        AscendC::LocalTensor<T> paramLocal = paramQueue_.DeQue<T>();
        AscendC::LocalTensor<T> outputLocal = outputQueue_.AllocTensor<T>();

        AscendC::LocalTensor<float> xFp32 = xFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> residualFp32 = residualFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> gammaFp32 = gammaFp32Buf_.Get<float>();
        AscendC::LocalTensor<float> biasFp32 = biasFp32Buf_.Get<float>();

        ToFp32(xFp32, xLocal, alignedCount);
        ToFp32(residualFp32, residualLocal, alignedCount);
        ToFp32(gammaFp32, paramLocal, alignedCount);
        ToFp32(biasFp32, paramLocal[alignedCount], alignedCount);
        AscendC::Add<float>(xFp32, xFp32, residualFp32, alignedCount);
        AscendC::Muls<float>(xFp32, xFp32, inverseRms, alignedCount);
        AscendC::Mul<float>(xFp32, xFp32, gammaFp32, alignedCount);
        AscendC::Add<float>(xFp32, xFp32, biasFp32, alignedCount);
        FromFp32(outputLocal, xFp32, alignedCount);
        outputQueue_.EnQue(outputLocal);

        xQueue_.FreeTensor(xLocal);
        residualQueue_.FreeTensor(residualLocal);
        paramQueue_.FreeTensor(paramLocal);
    }

    __aicore__ inline void CopyOut(uint64_t row, uint64_t tileOffset, uint32_t count)
    {
        AscendC::LocalTensor<T> outputLocal = outputQueue_.DeQue<T>();
        const auto copyParams = MakeCopyParams(count);
        const uint64_t gmOffset = row * width_ + tileOffset;
        AscendC::DataCopyPad(outputGm_[gmOffset], outputLocal, copyParams);
        outputQueue_.FreeTensor(outputLocal);
    }

    __aicore__ inline float FinishRms()
    {
        AscendC::LocalTensor<float> sumSquares = sumSquaresBuf_.Get<float>();
        AscendC::LocalTensor<float> scalar = normScalarBuf_.Get<float>();
        const float invWidth = tiling_->invWidth;
        const float epsilon = tiling_->epsilon;
        AscendC::Muls(sumSquares, sumSquares, invWidth, kFp32ScalarCount);
        AscendC::Adds(sumSquares, sumSquares, epsilon, kFp32ScalarCount);
        AscendC::Sqrt<float>(sumSquares, sumSquares, kFp32ScalarCount);
        AscendC::Duplicate(scalar, 1.0f, kFp32ScalarCount);
        AscendC::Div<float>(scalar, scalar, sumSquares, kFp32ScalarCount);
        return scalar.GetValue(0);
    }

    __aicore__ inline void ProcessRow(uint64_t row)
    {
        const uint64_t tileCount = (width_ + kTileLength - 1) / kTileLength;
        AscendC::LocalTensor<float> sumSquares = sumSquaresBuf_.Get<float>();
        AscendC::Duplicate(sumSquares, 0.0f, kFp32ScalarCount);

        CopyInData(row, 0, static_cast<uint32_t>((width_ < kTileLength) ? width_ : kTileLength));
        for (uint64_t tile = 0; tile < tileCount; ++tile) {
            const uint64_t tileOffset = tile * kTileLength;
            const uint32_t count = static_cast<uint32_t>(
                ((width_ - tileOffset) < kTileLength) ? (width_ - tileOffset) : kTileLength);
            if (tile + 1 < tileCount) {
                const uint64_t nextOffset = (tile + 1) * kTileLength;
                const uint32_t nextCount = static_cast<uint32_t>(
                    ((width_ - nextOffset) < kTileLength) ? (width_ - nextOffset) : kTileLength);
                CopyInData(row, nextOffset, nextCount);
            }
            AccumulateTile(count);
        }

        const float inverseRms = FinishRms();
        CopyInOutputData(row, 0, static_cast<uint32_t>((width_ < kTileLength) ? width_ : kTileLength));
        for (uint64_t tile = 0; tile < tileCount; ++tile) {
            const uint64_t tileOffset = tile * kTileLength;
            const uint32_t count = static_cast<uint32_t>(
                ((width_ - tileOffset) < kTileLength) ? (width_ - tileOffset) : kTileLength);
            if (tile + 1 < tileCount) {
                const uint64_t nextOffset = (tile + 1) * kTileLength;
                const uint32_t nextCount = static_cast<uint32_t>(
                    ((width_ - nextOffset) < kTileLength) ? (width_ - nextOffset) : kTileLength);
                CopyInOutputData(row, nextOffset, nextCount);
            }
            ComputeOutputTile(count, inverseRms);
            CopyOut(row, tileOffset, count);
        }
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ RmsNormBiasTiling* tiling_;
    uint64_t width_;

    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> residualGm_;
    AscendC::GlobalTensor<T> gammaGm_;
    AscendC::GlobalTensor<T> biasGm_;
    AscendC::GlobalTensor<T> outputGm_;

    AscendC::TQue<AscendC::TPosition::VECIN, 2> xQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> residualQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> paramQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outputQueue_;

    AscendC::TBuf<AscendC::TPosition::VECCALC> xFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> residualFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> biasFp32Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceResultBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceTmpBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumSquaresBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> normScalarBuf_;
};

template <typename T>
__aicore__ inline void RmsNormBiasKernel(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
    GM_ADDR bias, GM_ADDR output, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelRmsNormBias<T> op(&pipe);
    op.Init(x, residual, gamma, bias, output,
        reinterpret_cast<const __gm__ RmsNormBiasTiling*>(tiling));
    op.Process();
}

}  // namespace async_triple_x_seed

extern "C" __global__ __vector__ void async_triple_x_seed_fp16_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, GM_ADDR tiling)
{
    async_triple_x_seed::RmsNormBiasKernel<half>(x, residual, gamma, bias, output, tiling);
}

extern "C" __global__ __vector__ void async_triple_x_seed_bf16_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, GM_ADDR tiling)
{
    async_triple_x_seed::RmsNormBiasKernel<bfloat16_t>(x, residual, gamma, bias, output, tiling);
}

extern "C" __global__ __vector__ void async_triple_x_seed_fp32_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output, GM_ADDR tiling)
{
    async_triple_x_seed::RmsNormBiasKernel<float>(x, residual, gamma, bias, output, tiling);
}

static inline bool GetTensorShape(const TensorGroupInfo& group, uint64_t& outer, uint64_t& width)
{
    if (group.tensors == nullptr || group.numTensors != 1) {
        return false;
    }
    const TensorInfo& tensor = group.tensors[0];
    if (tensor.shape == nullptr || tensor.numDims <= 0) {
        return false;
    }
    width = static_cast<uint64_t>(tensor.shape[tensor.numDims - 1]);
    if (width == 0) {
        return false;
    }
    outer = 1;
    for (int64_t i = 0; i + 1 < tensor.numDims; ++i) {
        if (tensor.shape[i] <= 0) {
            return false;
        }
        outer *= static_cast<uint64_t>(tensor.shape[i]);
    }
    return true;
}

static inline bool GetVectorShape(const TensorGroupInfo& group, uint64_t expectedWidth, int32_t expectedDtype)
{
    if (group.tensors == nullptr || group.numTensors != 1) {
        return false;
    }
    const TensorInfo& tensor = group.tensors[0];
    return tensor.shape != nullptr && tensor.numDims == 1 &&
        tensor.shape[0] == static_cast<int64_t>(expectedWidth) && tensor.dtype == expectedDtype;
}

static inline bool SameShapeAndDtype(const TensorGroupInfo& lhs, const TensorGroupInfo& rhs)
{
    if (lhs.tensors == nullptr || rhs.tensors == nullptr || lhs.numTensors != 1 || rhs.numTensors != 1) {
        return false;
    }
    const TensorInfo& a = lhs.tensors[0];
    const TensorInfo& b = rhs.tensors[0];
    if (a.numDims != b.numDims || a.dtype != b.dtype || a.shape == nullptr || b.shape == nullptr) {
        return false;
    }
    for (int64_t i = 0; i < a.numDims; ++i) {
        if (a.shape[i] != b.shape[i]) {
            return false;
        }
    }
    return true;
}

void run_kernel(GM_ADDR x, TensorGroupInfo info_x, GM_ADDR residual, TensorGroupInfo info_residual,
    GM_ADDR gamma, TensorGroupInfo info_gamma, GM_ADDR bias, TensorGroupInfo info_bias,
    GM_ADDR output, TensorGroupInfo info_output, int64_t availableCoreNum,
    aclrtStream stream, float epsilon)
{
    uint64_t outer = 0;
    uint64_t width = 0;
    if (!GetTensorShape(info_x, outer, width) ||
        !SameShapeAndDtype(info_x, info_residual) ||
        !SameShapeAndDtype(info_x, info_output) ||
        availableCoreNum <= 0) {
        return;
    }

    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype != 0 && dtype != 1 && dtype != 2) {
        return;
    }
    if (!GetVectorShape(info_gamma, width, dtype) || !GetVectorShape(info_bias, width, dtype)) {
        return;
    }

    uint64_t dataOuter = 0;
    uint64_t dataWidth = 0;
    if (!GetTensorShape(info_x, dataOuter, dataWidth)) {
        return;
    }
    outer = dataOuter;
    width = dataWidth;

    async_triple_x_seed::RmsNormBiasTiling tilingHost{
        outer,
        width,
        static_cast<uint32_t>((outer < static_cast<uint64_t>(availableCoreNum))
            ? outer : static_cast<uint64_t>(availableCoreNum)),
        epsilon,
        1.0f / static_cast<float>(width)};
    if (tilingHost.blockNum == 0) {
        return;
    }

    uint8_t* tilingDevice = nullptr;
    if (aclrtMalloc(reinterpret_cast<void**>(&tilingDevice), sizeof(async_triple_x_seed::RmsNormBiasTiling),
        ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return;
    }
    if (aclrtMemcpy(tilingDevice, sizeof(async_triple_x_seed::RmsNormBiasTiling), &tilingHost,
        sizeof(async_triple_x_seed::RmsNormBiasTiling), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        aclrtFree(tilingDevice);
        return;
    }

    const uint32_t blockNum = tilingHost.blockNum;
    if (dtype == 0) {
        async_triple_x_seed_fp32_kernel<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, tilingDevice);
    } else if (dtype == 1) {
        async_triple_x_seed_fp16_kernel<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, tilingDevice);
    } else {
        async_triple_x_seed_bf16_kernel<<<blockNum, nullptr, stream>>>(
            x, residual, gamma, bias, output, tilingDevice);
    }
    aclrtSynchronizeStream(stream);
    aclrtFree(tilingDevice);
}
