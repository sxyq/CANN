CANDIDATE_SOURCE=/home/data4t2/lelinfeng/cann/server_runs/C2C-V2-N04/V019/Candidate.asc
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
/*
 * R31B-V019-LP-ROW-PIPELINE
 *
 * V019 keeps V018's x-first/residual-second submission and split completion
 * events, but releases slot C and submits the next batch's input immediately
 * after the current tile's Vector-to-MTE2 handoff and before its output Store.
 * The next batch still waits on the residual event; the final A/B parameter
 * sequence remains unchanged.  V012's
 * inter-phase parameter prefetch and V010/V011 output and parameter slots
 * remain intact.
 * For D in (128, 4096] that miss the aligned multi-row specials,
 * ProcessNarrowMidOverlap issues x/residual and gamma/bias as two parallel
 * MTE2 groups so the param DMA overlaps pass-1 compute and the V/S tail.
 * Math order is unchanged.  Wide paths and tiny-D generic stay V006.
 *
 * Purpose: test whether moving the existing slot-C input prefetch across the
 * current output Store boundary overlaps MTE2 input DMA with MTE3 output,
 * without changing V018's x/residual order or completion event semantics.
 */
CMAKE_BINDING
string(JOIN " " R31B_PAIRED_COMPILE_INCLUDES_STR ${R31B_PAIRED_COMPILE_INCLUDES})
set(CMAKE_ASC_COMPILE_OBJECT
    "<CMAKE_ASC_COMPILER> ${CMAKE_COMPILE_AS_ASC_FLAG} <DEFINES> <INCLUDES> ${R31B_PAIRED_COMPILE_INCLUDES_STR} --cce-aicore-arch=dav-c220 -Xaicore-start -O3 -std=c++17 -Xaicore-end -Xhost-start ${R31B_PAIRED_COMPILE_INCLUDES_STR} -fPIC -O2 -std=c++17 -Xhost-end <FLAGS> -o <OBJECT> -c -x asc <SOURCE>")

set(R31B_V011_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../../../../线上结果/R31B/V011")
set(R31B_V019_CANDIDATE_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../V019")

add_executable(paired_runner_v016 paired_runner_v016.asc)
target_include_directories(paired_runner_v016 PRIVATE
    ${CMAKE_CURRENT_LIST_DIR}
    ${R31B_V011_SOURCE_DIR}
    ${R31B_V019_CANDIDATE_SOURCE_DIR}
    /usr/include/c++/11
    /usr/include/aarch64-linux-gnu/c++/11
    ${ASCEND_CANN_PACKAGE_PATH}/aarch64-linux/include
    ${ASCEND_CANN_PACKAGE_PATH}/aarch64-linux/ascendc/include
    ${ASCEND_CANN_PACKAGE_PATH}/aarch64-linux/ascendc/include/basic_api/impl
    ${ASCEND_CANN_PACKAGE_PATH}/aarch64-linux/asc/include/basic_api
    ${ASCEND_CANN_PACKAGE_PATH}/aarch64-linux/asc/include
    ${ASCEND_CANN_PACKAGE_PATH}/aarch64-linux/asc
    ${ASCEND_CANN_PACKAGE_PATH}/aarch64-linux/asc/include/interface
    /usr/include/aarch64-linux-gnu)
target_compile_options(paired_runner_v016 PRIVATE
    $<$<COMPILE_LANGUAGE:ASC>:--npu-arch=dav-2201>)
target_compile_definitions(paired_runner_v016 PRIVATE N04_DMA_PIPELINE_OVERLAP_X)
target_link_directories(paired_runner_v016 PRIVATE
