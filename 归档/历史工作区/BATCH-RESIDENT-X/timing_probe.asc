#include <acl/acl.h>
#include <algorithm>
#include <array>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <vector>

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "submission_v001.asc"

static bool CheckAcl(aclError status, const char* op)
{
    if (status == ACL_SUCCESS) return true;
    std::fprintf(stderr, "ACL_FAIL %s=%d\n", op, (int)status);
    return false;
}

int main(int argc, char** argv)
{
    if (argc != 6) {
        std::fprintf(stderr, "usage: %s device rows width dtype out_prefix\n", argv[0]);
        return 2;
    }
    const int deviceId = std::atoi(argv[1]);
    const int64_t rows = std::strtoll(argv[2], nullptr, 10);
    const int64_t width = std::strtoll(argv[3], nullptr, 10);
    const int dtype = std::atoi(argv[4]);
    const char* prefix = argv[5];
    constexpr int kWarmups = 5;
    constexpr int kRepeats = 21;
    constexpr float kEpsilon = 1.0e-5f;

    const size_t n = static_cast<size_t>(rows * width);
    const size_t elemBytes = dtype == 0 ? 4u : 2u;
    const size_t dataBytes = n * elemBytes;
    const size_t paramBytes = static_cast<size_t>(width) * elemBytes;

    std::vector<uint8_t> hostX(dataBytes), hostR(dataBytes), hostG(paramBytes), hostB(paramBytes), hostO(dataBytes, 0);
    auto toLow = [&](float v) -> uint16_t {
        if (dtype == 1) {
            aclFloat16 h = aclFloatToFloat16(v);
            uint16_t b = 0; std::memcpy(&b, &h, 2); return b;
        }
        uint32_t bits = 0; std::memcpy(&bits, &v, 4);
        bits += 0x7fffU + ((bits >> 16) & 1U);
        return static_cast<uint16_t>(bits >> 16);
    };
    auto store = [&](std::vector<uint8_t>& buf, size_t i, float v) {
        if (dtype == 0) std::memcpy(buf.data() + i * 4, &v, 4);
        else { uint16_t b = toLow(v); std::memcpy(buf.data() + i * 2, &b, 2); }
    };
    for (size_t i = 0; i < n; ++i) {
        store(hostX, i, static_cast<float>((i * 3 + 1) % 997) / 498.0f - 1.0f);
        store(hostR, i, static_cast<float>((i * 5 + 7) % 997) / 498.0f - 1.0f);
    }
    for (int64_t i = 0; i < width; ++i) {
        store(hostG, static_cast<size_t>(i), 0.75f + static_cast<float>((i * 13) % 100) / 200.0f);
        store(hostB, static_cast<size_t>(i), static_cast<float>((i * 7) % 100) / 400.0f - 0.125f);
    }

    void *dx = nullptr, *dr = nullptr, *dg = nullptr, *db = nullptr, *do_ = nullptr;
    aclrtStream stream = nullptr;
    if (!CheckAcl(aclInit(nullptr), "aclInit")) return 1;
    if (!CheckAcl(aclrtSetDevice(deviceId), "setDevice")) return 1;
    if (!CheckAcl(aclrtCreateStream(&stream), "stream")) return 1;
    if (!CheckAcl(aclrtMalloc(&dx, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mx")) return 1;
    if (!CheckAcl(aclrtMalloc(&dr, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mr")) return 1;
    if (!CheckAcl(aclrtMalloc(&dg, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mg")) return 1;
    if (!CheckAcl(aclrtMalloc(&db, paramBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mb")) return 1;
    if (!CheckAcl(aclrtMalloc(&do_, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mo")) return 1;
    if (!CheckAcl(aclrtMemcpy(dx, dataBytes, hostX.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "cx")) return 1;
    if (!CheckAcl(aclrtMemcpy(dr, dataBytes, hostR.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "cr")) return 1;
    if (!CheckAcl(aclrtMemcpy(dg, paramBytes, hostG.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "cg")) return 1;
    if (!CheckAcl(aclrtMemcpy(db, paramBytes, hostB.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "cb")) return 1;

    int64_t xyShape[] = {rows, width};
    int64_t pShape[] = {width};
    TensorInfo xT[] = {{xyShape, 2, dtype}};
    TensorInfo rT[] = {{xyShape, 2, dtype}};
    TensorInfo gT[] = {{pShape, 1, dtype}};
    TensorInfo bT[] = {{pShape, 1, dtype}};
    TensorInfo oT[] = {{xyShape, 2, dtype}};
    TensorGroupInfo infoX = {xT, 1}, infoR = {rT, 1}, infoG = {gT, 1}, infoB = {bT, 1}, infoO = {oT, 1};
    int64_t cores = 0;
    CheckAcl(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "cores");
    if (cores <= 0) cores = 40;

    auto launch = [&]() {
        run_kernel((GM_ADDR)dx, infoX, (GM_ADDR)dr, infoR, (GM_ADDR)dg, infoG,
                   (GM_ADDR)db, infoB, (GM_ADDR)do_, infoO, cores, stream, kEpsilon);
    };
    for (int i = 0; i < kWarmups; ++i) {
        launch();
        if (!CheckAcl(aclrtSynchronizeStream(stream), "warmup")) return 1;
    }
    std::array<double, kRepeats> samples{};
    for (int i = 0; i < kRepeats; ++i) {
        const auto t0 = std::chrono::steady_clock::now();
        launch();
        if (!CheckAcl(aclrtSynchronizeStream(stream), "sync")) return 1;
        const auto t1 = std::chrono::steady_clock::now();
        samples[i] = std::chrono::duration<double, std::micro>(t1 - t0).count();
    }
    std::sort(samples.begin(), samples.end());
    const double median = samples[samples.size() / 2];
    char path[512];
    std::snprintf(path, sizeof(path), "%s.tsv", prefix);
    std::ofstream out(path);
    out << "device\tdtype\trows\twidth\twarmups\trepeats\tmedian_us\n"
        << deviceId << '\t' << dtype << '\t' << rows << '\t' << width << '\t'
        << kWarmups << '\t' << kRepeats << '\t' << median << '\n';
    std::printf("TIMING device=%d dtype=%d rows=%lld width=%lld median_us=%.3f\n",
                deviceId, dtype, (long long)rows, (long long)width, median);
    aclrtFree(dx); aclrtFree(dr); aclrtFree(dg); aclrtFree(db); aclrtFree(do_);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
