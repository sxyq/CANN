// REDUCE-X full-link smoke host. Compiles run_kernel + device entries into one binary.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "local_types.h"

#include "submission.asc"

int main()
{
    // Shape-only smoke: rank-3 FP16, R=2, D=64. No device run required for link.
    int64_t shape_x[3] = {1, 2, 64};
    TensorInfo tx;
    tx.shape = shape_x;
    tx.numDims = 3;
    tx.dtype = 1;
    TensorInfo t1 = tx;
    TensorInfo t2 = tx;
    TensorInfo t3 = tx;
    TensorInfo t4 = tx;
    TensorGroupInfo gx;
    gx.tensors = &tx;
    gx.numTensors = 1;
    TensorGroupInfo gr = gx; gr.tensors = &t1;
    TensorGroupInfo gg = gx; gg.tensors = &t2;
    TensorGroupInfo gb = gx; gb.tensors = &t3;
    TensorGroupInfo go = gx; go.tensors = &t4;

    float dummy = 1e-5f;
    run_kernel(nullptr, gx, nullptr, gr, nullptr, gg, nullptr, gb, nullptr, go,
               1, nullptr, dummy);
    std::printf("REDUCE-X full-link smoke ok\n");
    return 0;
}
