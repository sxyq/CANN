#include <cmath>
#include "kernel_operator.h"

// I001 V002 — wide-D AddRmsNormBias
// Do NOT redefine TensorInfo / TensorGroupInfo (judge provides them).
// dtype: 0=FP32, 1=FP16, 2=BF16

template <typename T>
__aicore__ static void LoadU(AscendC::GlobalTensor<T>& gm, AscendC::LocalTensor<T>& ub, int off, int n)
{
    AscendC::DataCopyExtParams cp(1, static_cast<uint32_t>(n * (int)sizeof(T)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<T> pad(false, 0, 0, static_cast<T>(0));
    AscendC::DataCopyPad(ub, gm[off], cp, pad);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T>
__aicore__ static void StoreU(AscendC::GlobalTensor<T>& gm, AscendC::LocalTensor<T>& ub, int off, int n)
{
    AscendC::DataCopyExtParams cp(1, static_cast<uint32_t>(n * (int)sizeof(T)), 0, 0, 0);
    AscendC::DataCopyPad(gm[off], ub, cp);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T>
__aicore__ static void AddToFloat(
    AscendC::LocalTensor<float>& dst, AscendC::LocalTensor<T>& a, AscendC::LocalTensor<T>& b,
    AscendC::LocalTensor<float>& tmp, int n)
{
    if constexpr (sizeof(T) == sizeof(float)) {
        AscendC::Add(dst, a, b, n);
    } else {
        AscendC::Cast(dst, a, AscendC::RoundMode::CAST_NONE, n);
        AscendC::Cast(tmp, b, AscendC::RoundMode::CAST_NONE, n);
        AscendC::Add(dst, dst, tmp, n);
    }
}

template <typename T>
__aicore__ static void StoreFromFloat(
    AscendC::GlobalTensor<T>& gm, AscendC::LocalTensor<float>& f,
    AscendC::LocalTensor<T>& scratch, int off, int n)
{
    if constexpr (sizeof(T) == sizeof(float)) {
        AscendC::LocalTensor<T> out = f.template ReinterpretCast<T>();
        StoreU(gm, out, off, n);
    } else {
        AscendC::Cast(scratch, f, AscendC::RoundMode::CAST_RINT, n);
        AscendC::PipeBarrier<PIPE_ALL>();
        StoreU(gm, scratch, off, n);
    }
}

template <typename T>
__aicore__ static void RowSqSumKeep(
    AscendC::GlobalTensor<T>& xg, AscendC::GlobalTensor<T>& rg,
    AscendC::LocalTensor<T>& xU, AscendC::LocalTensor<T>& rU,
    AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
    AscendC::LocalTensor<float>& uRow, AscendC::LocalTensor<float>& redTmp,
    int base, int D, int tile, int keep, float& ss)
{
    for (int d = 0; d < D; d += tile) {
        int n = (D - d) < tile ? (D - d) : tile;
        LoadU(xg, xU, base + d, n);
        LoadU(rg, rU, base + d, n);
        AddToFloat(fA, xU, rU, fB, n);
        AscendC::Mul(fB, fA, fA, n);
        if (keep) {
            AscendC::LocalTensor<float> uT = uRow[d];
            AscendC::Adds(uT, fA, (float)0, n);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::ReduceSum(redTmp, fB, redTmp[16], n);
        AscendC::PipeBarrier<PIPE_ALL>();
        ss += redTmp.GetValue(0);
    }
}

template <typename T>
__aicore__ static void RowNorm(
    AscendC::GlobalTensor<T>& xg, AscendC::GlobalTensor<T>& rg,
    AscendC::GlobalTensor<T>& gg, AscendC::GlobalTensor<T>& bg, AscendC::GlobalTensor<T>& og,
    AscendC::LocalTensor<T>& xU, AscendC::LocalTensor<T>& rU, AscendC::LocalTensor<T>& sU,
    AscendC::LocalTensor<float>& fA, AscendC::LocalTensor<float>& fB,
    AscendC::LocalTensor<float>& uRow,
    int base, int D, int tile, int keep, float invRms)
{
    for (int d = 0; d < D; d += tile) {
        int n = (D - d) < tile ? (D - d) : tile;
        if (keep) {
            AscendC::LocalTensor<float> uT = uRow[d];
            AscendC::Muls(fA, uT, invRms, n);
        } else {
            LoadU(xg, xU, base + d, n);
            LoadU(rg, rU, base + d, n);
            AddToFloat(fA, xU, rU, fB, n);
            AscendC::Muls(fA, fA, invRms, n);
        }
        LoadU(gg, xU, d, n);
        LoadU(bg, rU, d, n);
        if constexpr (sizeof(T) == sizeof(float)) {
            AscendC::LocalTensor<float> gf = xU.template ReinterpretCast<float>();
            AscendC::LocalTensor<float> bf = rU.template ReinterpretCast<float>();
            AscendC::Mul(fA, fA, gf, n);
            AscendC::Add(fA, fA, bf, n);
        } else {
            AscendC::Cast(fB, xU, AscendC::RoundMode::CAST_NONE, n);
            AscendC::Mul(fA, fA, fB, n);
            AscendC::Cast(fB, rU, AscendC::RoundMode::CAST_NONE, n);
            AscendC::Add(fA, fA, fB, n);
        }
        StoreFromFloat(og, fA, sU, base + d, n);
    }
}

template <typename T>
__aicore__ static void ProcessRows(
    __gm__ uint8_t* x, __gm__ uint8_t* r, __gm__ uint8_t* g, __gm__ uint8_t* b, __gm__ uint8_t* o,
    int64_t rows, int64_t cols, float eps, int tile, int mode)
{
    AscendC::GlobalTensor<T> xg, rg, gg, bg, og;
    xg.SetGlobalBuffer((__gm__ T*)x, rows * cols);
    rg.SetGlobalBuffer((__gm__ T*)r, rows * cols);
    gg.SetGlobalBuffer((__gm__ T*)g, cols);
    bg.SetGlobalBuffer((__gm__ T*)b, cols);
    og.SetGlobalBuffer((__gm__ T*)o, rows * cols);

    int t = tile;
    if (t > (int)cols) {
        t = (int)cols;
    }
    if (t < 32) {
        t = 32;
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx, qr, qs;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bfA, bfB, bu, btmp;
    pipe.InitBuffer(qx, 1, t * (int)sizeof(T));
    pipe.InitBuffer(qr, 1, t * (int)sizeof(T));
    pipe.InitBuffer(qs, 1, t * (int)sizeof(T));
    pipe.InitBuffer(bfA, t * (int)sizeof(float));
    pipe.InitBuffer(bfB, t * (int)sizeof(float));
    pipe.InitBuffer(btmp, 128);
    int uBytes = (mode == 1) ? (int)(cols * (int)sizeof(float)) : t * (int)sizeof(float);
    pipe.InitBuffer(bu, uBytes);

    AscendC::LocalTensor<T> xU = qx.AllocTensor<T>();
    AscendC::LocalTensor<T> rU = qr.AllocTensor<T>();
    AscendC::LocalTensor<T> sU = qs.AllocTensor<T>();
    AscendC::LocalTensor<float> fA = bfA.Get<float>();
    AscendC::LocalTensor<float> fB = bfB.Get<float>();
    AscendC::LocalTensor<float> uRow = bu.Get<float>();
    AscendC::LocalTensor<float> redTmp = btmp.Get<float>();

    int64_t blk = AscendC::GetBlockIdx();
    int64_t nb = AscendC::GetBlockNum();
    int64_t per = (rows + nb - 1) / nb;
    int64_t r0 = blk * per;
    int64_t r1 = r0 + per;
    if (r1 > rows) {
        r1 = rows;
    }

    for (int64_t row = r0; row < r1; ++row) {
        int base = (int)(row * cols);
        int keep = (mode == 1) ? 1 : 0;
        float ss = 0.0f;
        RowSqSumKeep(xg, rg, xU, rU, fA, fB, uRow, redTmp, base, (int)cols, t, keep, ss);
        float mean = ss / (float)cols;
        float var = mean + eps;
        if (!(var > 0.0f)) {
            var = 0.0f;
        }
        fB.SetValue(0, var);
        AscendC::Sqrt(fA, fB, 1);
        AscendC::PipeBarrier<PIPE_ALL>();
        float denom = fA.GetValue(0);
        float invRms = (denom > 0.0f) ? (1.0f / denom) : 0.0f;
        RowNorm(xg, rg, gg, bg, og, xU, rU, sU, fA, fB, uRow, base, (int)cols, t, keep, invRms);
    }

    qx.FreeTensor(xU);
    qr.FreeTensor(rU);
    qs.FreeTensor(sU);
}

extern "C" __global__ __vector__ void i001_add_rms_norm_bias(
    __gm__ uint8_t* x, __gm__ uint8_t* r, __gm__ uint8_t* g, __gm__ uint8_t* b, __gm__ uint8_t* o,
    int64_t rows, int64_t cols, float eps, int32_t dtype, int32_t tile, int32_t mode)
{
    if (dtype == 0) {
        ProcessRows<float>(x, r, g, b, o, rows, cols, eps, tile, mode);
    } else if (dtype == 1) {
        ProcessRows<half>(x, r, g, b, o, rows, cols, eps, tile, mode);
    } else if (dtype == 2) {
        ProcessRows<bfloat16_t>(x, r, g, b, o, rows, cols, eps, tile, mode);
    }
}

extern "C" void run_kernel(
    void* x, TensorGroupInfo* x_info,
    void* residual, TensorGroupInfo* residual_info,
    void* gamma, TensorGroupInfo* gamma_info,
    void* bias, TensorGroupInfo* bias_info,
    void* output, TensorGroupInfo* output_info,
    int availableCoreNum, void* stream, float epsilon)
{
    (void)residual_info;
    (void)gamma_info;
    (void)bias_info;
    (void)output_info;

    const TensorInfo* t = &x_info->tensors[0];
    int64_t cols = t->shape[t->numDims - 1];
    int64_t rows = 1;
    for (int64_t i = 0; i < t->numDims - 1; ++i) {
        rows *= t->shape[i];
    }
    int32_t dtype = t->dtype;
    if (rows <= 0 || cols <= 0) {
        return;
    }

    int32_t tile = 2048;
    if (tile > (int32_t)cols) {
        tile = (int32_t)cols;
    }

    int32_t esz = (dtype == 0) ? 4 : 2;
    int64_t retainNeed = cols * 4 + 4 * tile * esz + 2 * tile * 4 + 256;
    int32_t mode = (retainNeed <= 150 * 1024) ? 1 : 0;

    int cores = availableCoreNum > 0 ? availableCoreNum : 1;
    if (cores > 40) {
        cores = 40;
    }
    if (cores > (int)rows) {
        cores = (int)rows;
    }
    if (cores < 1) {
        cores = 1;
    }

    i001_add_rms_norm_bias<<<cores, 0, stream>>>(
        (uint8_t*)x, (uint8_t*)residual, (uint8_t*)gamma, (uint8_t*)bias, (uint8_t*)output,
        rows, cols, epsilon, dtype, tile, mode);
}
