#include <acl/acl.h>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

#include "local_types.h"
#include "V001/kernel.asc"

static bool ReadExact(const char *path, void *dst, size_t bytes)
{
    FILE *file = std::fopen(path, "rb");
    if (file == nullptr) {
        return false;
    }
    const size_t got = std::fread(dst, 1, bytes, file);
    const bool ok = got == bytes && std::fgetc(file) == EOF;
    std::fclose(file);
    return ok;
}

static bool WriteExact(const char *path, const void *src, size_t bytes)
{
    FILE *file = std::fopen(path, "wb");
    if (file == nullptr) {
        return false;
    }
    const bool ok = std::fwrite(src, 1, bytes, file) == bytes;
    std::fclose(file);
    return ok;
}

int main(int argc, char **argv)
{
    if (argc != 4) {
        std::fprintf(stderr, "usage: %s rows dim dtype\n", argv[0]);
        return 2;
    }
    const int64_t rows = std::atoll(argv[1]);
    const int64_t dim = std::atoll(argv[2]);
    const int32_t dtype = std::atoi(argv[3]);
    if (rows <= 0 || dim <= 0 || (dtype != 0 && dtype != 1 && dtype != 2 && dtype != 27)) {
        return 2;
    }
    const size_t elemBytes = dtype == 0 ? sizeof(float) : sizeof(uint16_t);
    const size_t xyBytes = static_cast<size_t>(rows) * static_cast<size_t>(dim) * elemBytes;
    const size_t gbBytes = static_cast<size_t>(dim) * elemBytes;
    std::vector<uint8_t> x(xyBytes), residual(xyBytes), gamma(gbBytes), bias(gbBytes), output(xyBytes);
    if (!ReadExact("input/x.bin", x.data(), xyBytes) ||
        !ReadExact("input/residual.bin", residual.data(), xyBytes) ||
        !ReadExact("input/gamma.bin", gamma.data(), gbBytes) ||
        !ReadExact("input/bias.bin", bias.data(), gbBytes)) {
        std::fprintf(stderr, "input read failed\n");
        return 1;
    }

    aclError ret = aclInit(nullptr);
    if (ret != ACL_ERROR_NONE) return 1;
    ret = aclrtSetDevice(0);
    if (ret != ACL_ERROR_NONE) return 1;
    int64_t coreCount = 0;
    ret = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount);
    if (ret != ACL_ERROR_NONE) return 1;
    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_ERROR_NONE) return 1;

    const long long xShape[] = {rows, dim};
    const long long gShape[] = {dim};
    TensorInfo xInfo[] = {{xShape, 2, dtype}};
    TensorInfo gInfo[] = {{gShape, 1, dtype}};
    TensorGroupInfo infoX = {xInfo, 1};
    TensorGroupInfo infoG = {gInfo, 1};
    std::vector<uint8_t *> device(5, nullptr);
    const size_t sizes[] = {xyBytes, xyBytes, gbBytes, gbBytes, xyBytes};
    std::vector<uint8_t *> host = {x.data(), residual.data(), gamma.data(), bias.data(), output.data()};
    for (size_t i = 0; i < device.size(); ++i) {
        ret = aclrtMalloc(reinterpret_cast<void **>(&device[i]), sizes[i], ACL_MEM_MALLOC_HUGE_FIRST);
        if (ret != ACL_ERROR_NONE) return 1;
        ret = aclrtMemcpy(device[i], sizes[i], host[i], sizes[i], ACL_MEMCPY_HOST_TO_DEVICE);
        if (ret != ACL_ERROR_NONE) return 1;
    }
    run_kernel((GM_ADDR)device[0], infoX, (GM_ADDR)device[1], infoX,
        (GM_ADDR)device[2], infoG, (GM_ADDR)device[3], infoG,
        (GM_ADDR)device[4], infoX, coreCount, stream, 1e-5f);
    ret = aclrtSynchronizeStreamWithTimeout(stream, 10000);
    if (ret == ACL_ERROR_NONE) {
        ret = aclrtMemcpy(output.data(), xyBytes, device[4], xyBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    if (ret == ACL_ERROR_NONE && !WriteExact("output/output.bin", output.data(), xyBytes)) {
        ret = 1;
    }
    for (uint8_t *ptr : device) {
        if (ptr != nullptr) aclrtFree(ptr);
    }
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (ret != ACL_ERROR_NONE) {
        std::fprintf(stderr, "runtime failed ret=%d\n", ret);
        return 1;
    }
    return 0;
}
