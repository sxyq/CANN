+    // H2 / R011 manual vector reduction tree: reduce `count` FP32 values at
+    // `buf` to 8 packed partial sums at buf[0..8) using pairwise Add halving.
+    // Every Add operand stays on a 32B-aligned float offset (multiple of 8),
+    // matching the alignment the 1-element fold Add requires.  The final
+    // 8-to-1 is done once per row (not per tile) so the per-tile V/S handoff
+    // disappears.  `count` must be > 8; call sites use ReduceSum for <= 8.
+    __aicore__ inline void VectorReduceTo8(AscendC::LocalTensor<float> buf,
+                                          int32_t count)
+    {
+        int32_t n = count;
+        while (n > 1 && (n & (n - 1)) != 0) {
+            int32_t p = 1;
+            while ((p << 1) < n) {
+                p <<= 1;
+            }
+            AscendC::Add(buf, buf, buf[p], n - p);
+            AscendC::PipeBarrier<PIPE_V>();
+            n = p;
+        }
+        while (n > 8) {
+            const int32_t half = n >> 1;
+            AscendC::Add(buf, buf, buf[half], half);
+            AscendC::PipeBarrier<PIPE_V>();
+            n = half;
+        }
     }
 
