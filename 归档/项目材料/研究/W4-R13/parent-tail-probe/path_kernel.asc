#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
#include "abi.h"
using aclrtStream = void*;

// The metadata entry is separate from the unchanged Parent compilation unit.
#define ASCENDC_CPU_DEBUG
#define private public
#include W4_PARENT_SOURCE
#undef private
#undef ASCENDC_CPU_DEBUG

__global__ __vector__ void w4_r13_path_probe(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    GM_ADDR metadata, uint64_t rows, uint64_t width, uint32_t blocks)
{
    AddRmsNormBiasKernel<float> op;
    op.Init(x, residual, gamma, bias, output, width, rows, blocks);
    __gm__ int32_t* values = reinterpret_cast<__gm__ int32_t*>(metadata);
    values[0] = op.widePath_;
    values[1] = op.wideFullYRows_;
    values[2] = op.wideFullYTileElems_;
    values[3] = op.wideFp32FullYPath_;
}

extern "C" void record_parent_path(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    GM_ADDR metadata, uint64_t rows, uint64_t width, uint32_t blocks,
    aclrtStream stream)
{
    w4_r13_path_probe<<<1, nullptr, stream>>>(
        x, residual, gamma, bias, output, metadata, rows, width, blocks);
}
