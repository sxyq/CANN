#include <acl/acl.h>
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "submission.asc"

static bool CheckAcl(aclError status, const char* op)
{
    if (status == ACL_SUCCESS) return true;
    std::fprintf(stderr, "ACL_FAIL %s=%d\n", op, (int)status);
    return false;
}

namespace {

constexpr float kEpsilon = 1.0e-5f;

float InputValue(int64_t index, int mult, int off)
{
    return static_cast<float>((index * mult + off) % 997) / 498.0f - 1.0f;
}

uint16_t FloatToHalfBits(float v)
{
    aclFloat16 h = aclFloatToFloat16(v);
    uint16_t bits = 0;
    std::memcpy(&bits, &h, sizeof(bits));
    return bits;
}

float HalfBitsToFloat(uint16_t bits)
{
    aclFloat16 h;
    std::memcpy(&h, &bits, sizeof(bits));
    return aclFloat16ToFloat(h);
}

uint16_t FloatToBf16Bits(float v)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &v, sizeof(bits));
    bits += 0x7fffU + ((bits >> 16) & 1U);
    return static_cast<uint16_t>(bits >> 16);
}

float Bf16BitsToFloat(uint16_t bits)
{
    uint32_t wide = static_cast<uint32_t>(bits) << 16;
    float v = 0.0f;
    std::memcpy(&v, &wide, sizeof(v));
    return v;
}

void StoreValue(std::vector<uint8_t>& data, size_t idx, int dtype, float v)
{
    if (dtype == 0) {
        std::memcpy(data.data() + idx * sizeof(float), &v, sizeof(v));
        return;
    }
    uint16_t bits = dtype == 1 ? FloatToHalfBits(v) : FloatToBf16Bits(v);
    std::memcpy(data.data() + idx * sizeof(bits), &bits, sizeof(bits));
}

float LoadValue(const std::vector<uint8_t>& data, size_t idx, int dtype)
{
    if (dtype == 0) {
        float v = 0.0f;
        std::memcpy(&v, data.data() + idx * sizeof(float), sizeof(v));
        return v;
    }
    uint16_t bits = 0;
    std::memcpy(&bits, data.data() + idx * sizeof(bits), sizeof(bits));
    return dtype == 1 ? HalfBitsToFloat(bits) : Bf16BitsToFloat(bits);
}

void Golden(const std::vector<float>& x, const std::vector<float>& r,
            const std::vector<float>& g, const std::vector<float>& b,
            std::vector<float>& out, int64_t rows, int64_t d)
{
    out.assign(static_cast<size_t>(rows * d), 0.0f);
    for (int64_t i = 0; i < rows; ++i) {
        double sumSq = 0.0;
        for (int64_t j = 0; j < d; ++j) {
            const float u = x[static_cast<size_t>(i * d + j)] +
                            r[static_cast<size_t>(i * d + j)];
            sumSq += static_cast<double>(u) * static_cast<double>(u);
        }
        const double mean = sumSq / static_cast<double>(d);
        const float rms = static_cast<float>(std::sqrt(mean + kEpsilon));
        const float inv = 1.0f / rms;
        for (int64_t j = 0; j < d; ++j) {
            const float u = x[static_cast<size_t>(i * d + j)] +
                            r[static_cast<size_t>(i * d + j)];
            out[static_cast<size_t>(i * d + j)] =
                u * inv * g[static_cast<size_t>(j)] + b[static_cast<size_t>(j)];
        }
    }
}

struct Shape {
    int64_t rows;
    int64_t d;
    const char* name;
};

bool RunCase(int deviceId, int dtype, int64_t rows, int64_t d, const char* name)
{
    const size_t n = static_cast<size_t>(rows * d);
    const size_t pn = static_cast<size_t>(d);
    const size_t xb = n * (dtype == 0 ? 4u : 2u);
    const size_t pb = pn * (dtype == 0 ? 4u : 2u);

    std::vector<float> xF(n), rF(n), gF(pn), bF(pn);
    for (size_t i = 0; i < n; ++i) {
        xF[i] = InputValue(static_cast<int64_t>(i), 3, 1);
        rF[i] = InputValue(static_cast<int64_t>(i), 5, 7);
    }
    for (size_t i = 0; i < pn; ++i) {
        gF[i] = InputValue(static_cast<int64_t>(i), 11, 3) * 0.1f + 1.0f;
        bF[i] = InputValue(static_cast<int64_t>(i), 13, 5) * 0.05f;
    }

    std::vector<uint8_t> xH(xb), rH(xb), gH(pb), bH(pb), oH(xb, 0);
    for (size_t i = 0; i < n; ++i) {
        StoreValue(xH, i, dtype, xF[i]);
        StoreValue(rH, i, dtype, rF[i]);
    }
    for (size_t i = 0; i < pn; ++i) {
        StoreValue(gH, i, dtype, gF[i]);
        StoreValue(bH, i, dtype, bF[i]);
    }

    std::vector<float> golden;
    Golden(xF, rF, gF, bF, golden, rows, d);

    void *xd = nullptr, *rd = nullptr, *gd = nullptr, *bd = nullptr, *od = nullptr;
    aclrtStream stream = nullptr;
    bool ok = false;
    bool initialized = false, deviceSet = false;

    if (!CheckAcl(aclInit(nullptr), "aclInit")) goto done;
    initialized = true;
    if (!CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) goto done;
    deviceSet = true;
    if (!CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) goto done;
    if (!CheckAcl(aclrtMalloc(&xd, xb, ACL_MEM_MALLOC_HUGE_FIRST), "malloc x")) goto done;
    if (!CheckAcl(aclrtMalloc(&rd, xb, ACL_MEM_MALLOC_HUGE_FIRST), "malloc r")) goto done;
    if (!CheckAcl(aclrtMalloc(&gd, pb, ACL_MEM_MALLOC_HUGE_FIRST), "malloc g")) goto done;
    if (!CheckAcl(aclrtMalloc(&bd, pb, ACL_MEM_MALLOC_HUGE_FIRST), "malloc b")) goto done;
    if (!CheckAcl(aclrtMalloc(&od, xb, ACL_MEM_MALLOC_HUGE_FIRST), "malloc o")) goto done;
    if (!CheckAcl(aclrtMemcpy(xd, xb, xH.data(), xb, ACL_MEMCPY_HOST_TO_DEVICE), "cp x")) goto done;
    if (!CheckAcl(aclrtMemcpy(rd, xb, rH.data(), xb, ACL_MEMCPY_HOST_TO_DEVICE), "cp r")) goto done;
    if (!CheckAcl(aclrtMemcpy(gd, pb, gH.data(), pb, ACL_MEMCPY_HOST_TO_DEVICE), "cp g")) goto done;
    if (!CheckAcl(aclrtMemcpy(bd, pb, bH.data(), pb, ACL_MEMCPY_HOST_TO_DEVICE), "cp b")) goto done;

    {
        int64_t xShape[] = {rows, d};
        TensorInfo xT[] = {{xShape, 2, dtype}};
        TensorGroupInfo infoX = {xT, 1};
        TensorInfo rT[] = {{xShape, 2, dtype}};
        TensorGroupInfo infoR = {rT, 1};
        int64_t gShape[] = {d};
        TensorInfo gT[] = {{gShape, 1, dtype}};
        TensorGroupInfo infoG = {gT, 1};
        TensorInfo bT[] = {{gShape, 1, dtype}};
        TensorGroupInfo infoB = {bT, 1};
        TensorInfo oT[] = {{xShape, 2, dtype}};
        TensorGroupInfo infoO = {oT, 1};

        int64_t cores = 0;
        if (!CheckAcl(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores),
                      "get cores")) goto done;
        if (cores <= 0) cores = 40;

        run_kernel((GM_ADDR)xd, infoX,
                   (GM_ADDR)rd, infoR,
                   (GM_ADDR)gd, infoG,
                   (GM_ADDR)bd, infoB,
                   (GM_ADDR)od, infoO,
                   cores, stream, kEpsilon);
    }

    if (!CheckAcl(aclrtSynchronizeStream(stream), "sync")) goto done;
    if (!CheckAcl(aclrtMemcpy(oH.data(), xb, od, xb, ACL_MEMCPY_DEVICE_TO_HOST), "cp o")) goto done;

    {
        double maxAbs = 0.0;
        size_t bad = 0;
        const float tol = dtype == 0 ? 1e-5f : (dtype == 1 ? 2e-3f : 2e-2f);
        for (size_t i = 0; i < n; ++i) {
            const float got = LoadValue(oH, i, dtype);
            const float exp = golden[i];
            const float diff = std::fabs(got - exp);
            if (!(diff <= tol * (1.0f + std::fabs(exp)))) ++bad;
            if (diff > maxAbs) maxAbs = diff;
        }
        const bool pass = bad == 0;
        std::printf("CASE dtype=%d rows=%lld D=%lld name=%s bad=%zu max_abs=%.6g %s\n",
                    dtype, (long long)rows, (long long)d, name, bad, maxAbs,
                    pass ? "PASS" : "FAIL");
        if (!pass) {
            size_t shown = 0;
            for (size_t i = 0; i < n && shown < 5; ++i) {
                const float got = LoadValue(oH, i, dtype);
                const float exp = golden[i];
                if (std::fabs(got - exp) > tol * (1.0f + std::fabs(exp))) {
                    std::printf("  mismatch i=%zu got=%g exp=%g\n", i, (double)got, (double)exp);
                    ++shown;
                }
            }
        }
        ok = pass;
    }

done:
    if (od) aclrtFree(od);
    if (bd) aclrtFree(bd);
    if (gd) aclrtFree(gd);
    if (rd) aclrtFree(rd);
    if (xd) aclrtFree(xd);
    if (stream) aclrtDestroyStream(stream);
    if (deviceSet) aclrtResetDevice(deviceId);
    if (initialized) aclFinalize();
    return ok;
}

}  // namespace

int main(int argc, char** argv)
{
    int deviceId = 4;
    if (argc >= 2) deviceId = std::atoi(argv[1]);

    // rowGroup = 32/gcd(rowBytes,32) coverage:
    //   FP32 33x100  rowBytes=400  gcd=16 rowGroup=2   (rowGroup>1 unaligned)
    //   FP32 17x256  rowBytes=1024 gcd=32 rowGroup=1   (control, identical split)
    //   FP16 33x100  rowBytes=200  gcd=8  rowGroup=4   (rowGroup>1)
    //   BF16 33x100  rowBytes=200  gcd=8  rowGroup=4   (rowGroup>1)
    //   FP16 17x257  rowBytes=514  gcd=2  rowGroup=16  (rowGroup>1 strong unaligned)
    //   FP32 7x65    rowBytes=260  gcd=4  rowGroup=8   (rowGroup>1, rowCount<rowGroup edge)
    //   FP32 8x256   rowBytes=1024 gcd=32 rowGroup=1   (control multi-row)
    //   FP32 3x65    rowBytes=260  gcd=4  rowGroup=8   (rowCount<rowGroup)
    const Shape shapes[] = {
        {33, 100, "rowGroup2_unaligned_fp32"},
        {17, 256, "rowGroup1_control"},
        {33, 100, "rowGroup4_fp16"},
        {33, 100, "rowGroup4_bf16"},
        {17, 257, "rowGroup16_strong_unaligned"},
        {7, 65, "rowGroup8_edge_rowsLT"},
        {8, 256, "rowGroup1_control_multirow"},
        {3, 65, "rowGroup8_rowsLT"},
    };

    int failures = 0;
    int total = 0;
    const int dtypes[] = {0, 1, 2};
    for (int dt : dtypes) {
        for (const Shape& s : shapes) {
            ++total;
            if (!RunCase(deviceId, dt, s.rows, s.d, s.name)) ++failures;
        }
    }
    std::printf("SUMMARY total=%d failures=%d %s\n", total, failures,
                failures == 0 ? "ALL_PASS" : "HAS_FAIL");
    return failures == 0 ? 0 : 1;
}
