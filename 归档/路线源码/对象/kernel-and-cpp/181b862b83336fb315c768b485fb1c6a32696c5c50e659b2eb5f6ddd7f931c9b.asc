struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};

struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};

namespace w4r08_parent {
#define run_kernel w4r08_parent_run_kernel
#include "parent_submission.asc"
#undef run_kernel
}

namespace w4r08_candidate {
#define run_kernel w4r08_candidate_run_kernel
#include "submission.asc"
#undef run_kernel
}

using RunKernel = void (*)(
    GM_ADDR, const TensorGroupInfo&, GM_ADDR, const TensorGroupInfo&,
    GM_ADDR, const TensorGroupInfo&, GM_ADDR, const TensorGroupInfo&,
    GM_ADDR, const TensorGroupInfo&, int64_t, aclrtStream, float);

static const char* kParentSha =
    "a8c19a1972207acc67e3fb0cd393cc70b0a4b183d1eaf5610edf80c2879b15e3";
static const char* kCandidateSha =
    "dc2cd6b8e24acaa8a56774d2c3fec93a525ee8540d46e35b145dc09ef55333fb";
static const float kEpsilon = 1.0e-5f;
static const int64_t kCoreCount = 8;

struct Options {
    std::string mode;
    std::string implementation;
    std::string leaseId;
    std::string owner;
    std::string preflightUtc;
    std::string runnerSha;
    std::string outputPrefix;
    std::string qualificationFile;
    int device = -1;
    int64_t rows = 0;
    int64_t width = 0;
    int dtype = 0;
    int warmup = 45;
    int samples = 31;
    int blocks = 2;
    int pairs = 21;
};

struct Sample {
    double deviceUs;
    double wallUs;
};

struct Stats {
    double median;
    double mean;
    double stdev;
    double cv;
    double minimum;
    double maximum;
    double maxMin;
    double mad;
    double p10;
    double p90;
    double spread;
};

static void Fail(const std::string& message)
{
    std::fprintf(stderr, "ERROR: %s\n", message.c_str());
    std::exit(2);
}

static void CheckAcl(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        std::fprintf(stderr, "%s failed: %d %s\n", operation, status,
                     aclGetRecentErrMsg() ? aclGetRecentErrMsg() : "");
        std::exit(2);
    }
}

static bool PathExists(const std::string& path)
{
    struct stat status;
    return stat(path.c_str(), &status) == 0;
}

static int ParseInt(const char* value, const char* name)
{
    char* end = nullptr;
    const long parsed = std::strtol(value, &end, 10);
    if (end == value || *end != '\0') {
        Fail(std::string("invalid integer for ") + name);
    }
    return static_cast<int>(parsed);
}

static int64_t ParseInt64(const char* value, const char* name)
{
    char* end = nullptr;
    const long long parsed = std::strtoll(value, &end, 10);
    if (end == value || *end != '\0') {
        Fail(std::string("invalid integer for ") + name);
    }
    return static_cast<int64_t>(parsed);
}

static void PrintUsage(const char* program)
{
    std::printf(
        "Usage: %s --mode correctness|noise-floor|paired --device N "
        "--rows R --width W --dtype 0 --lease-id ID --owner MAIN-1|MAIN-2|W4-R08 "
        "--preflight-utc UTC --runner-sha256 SHA --out-prefix PATH [options]\n"
        "  correctness: all R/W in [1..64]\n"
        "  noise-floor: --implementation parent|candidate [--warmup] [--samples] [--blocks]\n"
        "  paired:      --qualification-file PATH [--warmup] [--samples] [--pairs]\n",
        program);
}

static Options ParseOptions(int argc, char** argv)
{
    Options options;
    for (int i = 1; i < argc; ++i) {
        const std::string key(argv[i]);
        if (key == "--help" || key == "-h") {
            PrintUsage(argv[0]);
            std::exit(0);
        }
        if (i + 1 >= argc) Fail("missing value for " + key);
        const char* value = argv[++i];
        if (key == "--mode") options.mode = value;
        else if (key == "--implementation") options.implementation = value;
        else if (key == "--lease-id") options.leaseId = value;
        else if (key == "--owner") options.owner = value;
        else if (key == "--preflight-utc") options.preflightUtc = value;
        else if (key == "--runner-sha256") options.runnerSha = value;
        else if (key == "--out-prefix") options.outputPrefix = value;
        else if (key == "--qualification-file") options.qualificationFile = value;
        else if (key == "--device") options.device = ParseInt(value, "--device");
        else if (key == "--rows") options.rows = ParseInt64(value, "--rows");
        else if (key == "--width") options.width = ParseInt64(value, "--width");
        else if (key == "--dtype") options.dtype = ParseInt(value, "--dtype");
        else if (key == "--warmup") options.warmup = ParseInt(value, "--warmup");
        else if (key == "--samples") options.samples = ParseInt(value, "--samples");
        else if (key == "--blocks") options.blocks = ParseInt(value, "--blocks");
        else if (key == "--pairs") options.pairs = ParseInt(value, "--pairs");
        else Fail("unknown option " + key);
    }
    return options;
}

static std::time_t ParseUtc(const std::string& text)
{
    std::tm parsed = {};
    std::istringstream input(text);
    input >> std::get_time(&parsed, "%Y-%m-%dT%H:%M:%SZ");
    if (input.fail() || input.peek() != std::char_traits<char>::eof()) {
        Fail("--preflight-utc must use YYYY-MM-DDTHH:MM:SSZ");
    }
    return timegm(&parsed);
}

static void ValidateOptions(const Options& options)
{
    if (options.mode != "correctness" && options.mode != "noise-floor" &&
        options.mode != "paired") {
        Fail("mode must be correctness, noise-floor, or paired");
    }
    if (options.device < 0 || options.leaseId.empty() ||
        (options.owner != "MAIN-1" && options.owner != "MAIN-2" &&
         options.owner != "W4-R08") ||
        options.outputPrefix.empty()) {
        Fail("device, run identity, owner, and output prefix are required");
    }
    if (options.rows < 1 || options.width < 1 || options.dtype != 0) {
        Fail("rows and width must be >= 1 and dtype must be 0 (fp32)");
    }
    const std::time_t preflight = ParseUtc(options.preflightUtc);
    const std::time_t now = std::time(nullptr);
    if (preflight > now + 60 || now - preflight > 300) {
        Fail("preflight timestamp is more than five minutes old or is in the future");
    }
    if (options.mode == "correctness") {
        if (options.implementation != "parent" && options.implementation != "candidate") {
            Fail("correctness requires --implementation parent|candidate");
        }
    } else if (options.mode == "noise-floor") {
        if (options.implementation != "parent" && options.implementation != "candidate") {
            Fail("noise-floor requires --implementation parent|candidate");
        }
        if (options.warmup < 10 || options.samples < 21 || options.blocks < 2) {
            Fail("noise-floor requires warmup >=10, samples >=21, blocks >=2");
        }
    } else if (options.warmup < 10 || options.samples < 21 || options.pairs < 4 ||
               options.qualificationFile.empty()) {
        Fail("paired requires qualification file, warmup >=10, samples >=21, pairs >=4");
    }
}

static std::string ShapeText(const Options& options)
{
    std::ostringstream text;
    text << options.rows << 'x' << options.width;
    return text.str();
}

static std::string DtypeText(int dtype)
{
    return dtype == 0 ? "fp32" : dtype == 1 ? "fp16" : "bf16";
}

static double Quantile(const std::vector<double>& sorted, double fraction)
{
    const size_t rank = static_cast<size_t>(std::ceil(fraction * sorted.size()));
    const size_t index = rank == 0 ? 0 : std::min(rank - 1, sorted.size() - 1);
    return sorted[index];
}

static double Median(std::vector<double> values)
{
    std::sort(values.begin(), values.end());
    const size_t middle = values.size() / 2;
    if (values.size() % 2 != 0) return values[middle];
    return (values[middle - 1] + values[middle]) * 0.5;
}

static Stats CalculateStats(const std::vector<Sample>& samples)
{
    std::vector<double> values;
    values.reserve(samples.size());
    double sum = 0.0;
    double minimum = samples.front().deviceUs;
    double maximum = samples.front().deviceUs;
    for (const Sample& sample : samples) {
        values.push_back(sample.deviceUs);
        sum += sample.deviceUs;
        minimum = std::min(minimum, sample.deviceUs);
        maximum = std::max(maximum, sample.deviceUs);
    }
    std::vector<double> sorted = values;
    std::sort(sorted.begin(), sorted.end());
    const double mean = sum / values.size();
    double variance = 0.0;
    for (double value : values) variance += (value - mean) * (value - mean);
    variance /= values.size();
    const double median = Median(values);
    std::vector<double> deviations;
    deviations.reserve(values.size());
    for (double value : values) deviations.push_back(std::fabs(value - median));
    return {median, mean, std::sqrt(variance), std::sqrt(variance) / mean,
            minimum, maximum, minimum > 0.0 ? maximum / minimum : 0.0,
            Median(deviations), Quantile(sorted, 0.10), Quantile(sorted, 0.90),
            maximum - minimum};
}

static RunKernel SelectKernel(const std::string& implementation)
{
    return implementation == "parent" ? w4r08_parent::w4r08_parent_run_kernel
                                      : w4r08_candidate::w4r08_candidate_run_kernel;
}

class Runtime {
public:
    Runtime(int device, int64_t rows, int64_t width)
        : device_(device), rows_(rows), width_(width)
    {
        const size_t elements = static_cast<size_t>(rows * width);
        x_.resize(elements);
        residual_.resize(elements);
        output_.resize(elements);
        gamma_.resize(static_cast<size_t>(width));
        bias_.resize(static_cast<size_t>(width));
        for (size_t i = 0; i < elements; ++i) {
            x_[i] = 0.19f * std::sin(static_cast<float>((i * 17) % 997) * 0.013f);
            residual_[i] = 0.11f * std::cos(static_cast<float>((i * 29) % 991) * 0.017f);
        }
        for (int64_t col = 0; col < width_; ++col) {
            gamma_[static_cast<size_t>(col)] = 0.85f + static_cast<float>(col % 23) * 0.002f;
            bias_[static_cast<size_t>(col)] = -0.025f + static_cast<float>(col % 19) * 0.001f;
        }

        CheckAcl(aclInit(nullptr), "aclInit");
        CheckAcl(aclrtSetDevice(device_), "aclrtSetDevice");
        CheckAcl(aclrtCreateStream(&stream_), "aclrtCreateStream");
        CheckAcl(aclrtCreateEvent(&startEvent_), "aclrtCreateEvent(start)");
        CheckAcl(aclrtCreateEvent(&stopEvent_), "aclrtCreateEvent(stop)");
        CheckAcl(aclrtMalloc(&dx_, elements * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc x");
        CheckAcl(aclrtMalloc(&dr_, elements * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc residual");
        CheckAcl(aclrtMalloc(&dg_, static_cast<size_t>(width_) * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc gamma");
        CheckAcl(aclrtMalloc(&db_, static_cast<size_t>(width_) * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc bias");
        CheckAcl(aclrtMalloc(&dout_, elements * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST), "malloc output");
        CopyInputs();
    }

    void CopyInputs()
    {
        const size_t elements = static_cast<size_t>(rows_ * width_);
        const size_t dataBytes = elements * sizeof(float);
        const size_t paramBytes = static_cast<size_t>(width_) * sizeof(float);
        CheckAcl(aclrtMemcpy(dx_, dataBytes, x_.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy x");
        CheckAcl(aclrtMemcpy(dr_, dataBytes, residual_.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy residual");
        CheckAcl(aclrtMemcpy(dg_, paramBytes, gamma_.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy gamma");
        CheckAcl(aclrtMemcpy(db_, paramBytes, bias_.data(), paramBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy bias");
    }

    void Launch(RunKernel kernel)
    {
        const int64_t dataShape[2] = {rows_, width_};
        const TensorInfo dataInfo{dataShape, 2, 0};
        const TensorInfo paramInfo{&width_, 1, 0};
        const TensorGroupInfo dataGroup{&dataInfo, 1};
        const TensorGroupInfo paramGroup{&paramInfo, 1};
        kernel((GM_ADDR)dx_, dataGroup,
               (GM_ADDR)dr_, dataGroup,
               (GM_ADDR)dg_, paramGroup,
               (GM_ADDR)db_, paramGroup,
               (GM_ADDR)dout_, dataGroup,
               kCoreCount, stream_, kEpsilon);
    }

    Sample TimedLaunch(RunKernel kernel)
    {
        const auto wallStart = std::chrono::steady_clock::now();
        CheckAcl(aclrtRecordEvent(startEvent_, stream_), "record start event");
        Launch(kernel);
        CheckAcl(aclrtRecordEvent(stopEvent_, stream_), "record stop event");
        CheckAcl(aclrtSynchronizeEvent(stopEvent_), "synchronize stop event");
        const auto wallStop = std::chrono::steady_clock::now();
        float elapsedMs = 0.0f;
        CheckAcl(aclrtEventElapsedTime(&elapsedMs, startEvent_, stopEvent_), "event elapsed time");
        const double wallUs = std::chrono::duration<double, std::micro>(wallStop - wallStart).count();
        return {static_cast<double>(elapsedMs) * 1000.0, wallUs};
    }

    void Synchronize(const char* operation)
    {
        CheckAcl(aclrtSynchronizeStream(stream_), operation);
    }

    void CopyOutput()
    {
        const size_t bytes = static_cast<size_t>(rows_ * width_) * sizeof(float);
        CheckAcl(aclrtMemcpy(output_.data(), bytes, dout_, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy output");
    }

    bool Verify()
    {
        CopyOutput();
        size_t failures = 0;
        float maxAbs = 0.0f;
        for (int64_t row = 0; row < rows_; ++row) {
            float squareSum = 0.0f;
            for (int64_t col = 0; col < width_; ++col) {
                const size_t index = static_cast<size_t>(row * width_ + col);
                const float value = x_[index] + residual_[index];
                squareSum += value * value;
            }
            const float invRms = 1.0f / std::sqrt(squareSum / static_cast<float>(width_) + kEpsilon);
            for (int64_t col = 0; col < width_; ++col) {
                const size_t index = static_cast<size_t>(row * width_ + col);
                const float value = x_[index] + residual_[index];
                const float want = value * invRms * gamma_[static_cast<size_t>(col)] +
                                   bias_[static_cast<size_t>(col)];
                const float error = std::fabs(output_[index] - want);
                maxAbs = std::max(maxAbs, error);
                if (!std::isfinite(output_[index]) ||
                    error > 1.0e-4f + 1.0e-4f * std::fabs(want)) ++failures;
            }
        }
        std::printf("verify rows=%lld width=%lld failures=%zu max_abs=%.9g\n",
                    static_cast<long long>(rows_), static_cast<long long>(width_),
                    failures, maxAbs);
        return failures == 0;
    }

    void Close()
    {
        CheckAcl(aclrtFree(dout_), "free output");
        CheckAcl(aclrtFree(db_), "free bias");
        CheckAcl(aclrtFree(dg_), "free gamma");
        CheckAcl(aclrtFree(dr_), "free residual");
        CheckAcl(aclrtFree(dx_), "free x");
        CheckAcl(aclrtDestroyEvent(stopEvent_), "destroy stop event");
        CheckAcl(aclrtDestroyEvent(startEvent_), "destroy start event");
        CheckAcl(aclrtDestroyStream(stream_), "destroy stream");
        CheckAcl(aclrtResetDevice(device_), "reset device");
        CheckAcl(aclFinalize(), "aclFinalize");
    }

private:
    int device_;
    int64_t rows_;
    int64_t width_;
    aclrtStream stream_ = nullptr;
    aclrtEvent startEvent_ = nullptr;
    aclrtEvent stopEvent_ = nullptr;
    void* dx_ = nullptr;
    void* dr_ = nullptr;
    void* dg_ = nullptr;
    void* db_ = nullptr;
    void* dout_ = nullptr;
    std::vector<float> x_;
    std::vector<float> residual_;
    std::vector<float> output_;
    std::vector<float> gamma_;
    std::vector<float> bias_;
};

static void WriteMetadata(std::ostream& out, const Options& options)
{
    out << "route=W4-R08\n"
        << "revision=V001\n"
        << "mode=" << options.mode << "\n"
        << "implementation=" << options.implementation << "\n"
        << "shape=" << ShapeText(options) << "\n"
        << "rows=" << options.rows << "\n"
        << "width=" << options.width << "\n"
        << "dtype=" << DtypeText(options.dtype) << "\n"
        << "epsilon=" << std::setprecision(9) << kEpsilon << "\n"
        << "available_core_num=" << kCoreCount << "\n"
        << "device=" << options.device << "\n"
        << "owner=" << options.owner << "\n"
        << "lease_id=" << options.leaseId << "\n"
        << "preflight_utc=" << options.preflightUtc << "\n"
        << "runner_sha256=" << options.runnerSha << "\n"
        << "parent_source_sha256=" << kParentSha << "\n"
        << "candidate_source_sha256=" << kCandidateSha << "\n"
        << "batch_n=1\n"
        << "method=DEVICE_EVENT_PRIMARY+HOST_WALL_SECONDARY\n";
}

static std::vector<Sample> RunBlock(Runtime& runtime, RunKernel kernel,
                                    const Options& options, const std::string& role,
                                    int blockIndex, const std::string& order,
                                    int sampleCount, std::ostream& raw)
{
    std::vector<Sample> samples;
    samples.reserve(static_cast<size_t>(sampleCount));
    for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex) {
        const Sample sample = runtime.TimedLaunch(kernel);
        samples.push_back(sample);
        raw << ShapeText(options) << '\t' << role << '\t' << blockIndex << '\t'
            << order << '\t' << sampleIndex << '\t'
            << std::fixed << std::setprecision(6) << sample.deviceUs << '\t'
            << sample.wallUs << '\n';
        raw.flush();
    }
    return samples;
}

static void WriteStats(std::ostream& jitter, const Options& options,
                       const std::string& role, int blockIndex,
                       const std::string& order, const std::vector<Sample>& samples)
{
    const Stats stats = CalculateStats(samples);
    jitter << "block\t" << ShapeText(options) << '\t' << role << '\t' << blockIndex << '\t'
           << order << '\t' << samples.size() << '\t'
           << std::fixed << std::setprecision(6)
           << stats.median << '\t' << stats.mean << '\t' << stats.stdev << '\t'
           << stats.cv << '\t' << stats.minimum << '\t' << stats.maximum << '\t'
           << stats.maxMin << '\t' << stats.mad << '\t' << stats.p10 << '\t'
           << stats.p90 << '\t' << stats.spread << '\t'
           << stats.mad / stats.median << '\n';
    jitter.flush();
}

static std::string ReadField(const std::string& path, const std::string& field)
{
    std::ifstream input(path.c_str());
    if (!input) Fail("cannot open qualification file: " + path);
    const std::string prefix = field + "=";
    std::string line;
    while (std::getline(input, line)) {
        if (line.compare(0, prefix.size(), prefix) == 0) return line.substr(prefix.size());
    }
    return "";
}

static void ValidateQualification(const Options& options)
{
    const std::string path = options.qualificationFile;
    w4r08::QualificationRecord record;
    record.route = ReadField(path, "route");
    record.revision = ReadField(path, "revision");
    record.mode = ReadField(path, "mode");
    record.implementation = ReadField(path, "implementation");
    record.qualification = ReadField(path, "qualification");
    record.shape = ReadField(path, "shape");
    record.dtype = ReadField(path, "dtype");
    record.device = ReadField(path, "device");
    record.owner = ReadField(path, "owner");
    record.leaseId = ReadField(path, "lease_id");
    record.preflightUtc = ReadField(path, "preflight_utc");
    record.runnerSha = ReadField(path, "runner_sha256");
    record.parentSourceSha = ReadField(path, "parent_source_sha256");
    record.candidateSourceSha = ReadField(path, "candidate_source_sha256");

    const w4r08::QualificationExpectation expected{
        ShapeText(options), DtypeText(options.dtype), options.device,
        options.owner, options.leaseId, options.preflightUtc,
        options.runnerSha, kParentSha, kCandidateSha};
    const std::string mismatch =
        w4r08::ValidateQualificationRecord(record, expected);
    if (!mismatch.empty()) Fail(mismatch);
    if (record.qualification != "PASS") {
        std::printf("measurement_status=MEASUREMENT_BLOCKED reason=parent_same_binary_noise\n");
    }
}

static void RunCorrectness(Runtime& runtime, const Options& options)
{
    const RunKernel kernel = SelectKernel(options.implementation);
    runtime.Launch(kernel);
    runtime.Synchronize("correctness synchronize");
    const bool ok = runtime.Verify();
    if (!ok) Fail("correctness failed; see retained correctness evidence");
    std::printf("correctness implementation=%s shape=%s PASS\n",
                options.implementation.c_str(), ShapeText(options).c_str());
}

static void RunNoiseFloor(Runtime& runtime, const Options& options,
                          std::ostream& raw, std::ostream& jitter)
{
    const RunKernel kernel = SelectKernel(options.implementation);
    for (int i = 0; i < options.warmup; ++i) {
        runtime.Launch(kernel);
        runtime.Synchronize("noise-floor warmup synchronize");
    }
    std::vector<double> blockMedians;
    bool blockPass = true;
    for (int block = 0; block < options.blocks; ++block) {
        const std::vector<Sample> samples = RunBlock(
            runtime, kernel, options, options.implementation, block, "SAME",
            options.samples, raw);
        const Stats stats = CalculateStats(samples);
        blockMedians.push_back(stats.median);
        const bool pass = stats.mad / stats.median <= 0.10;
        blockPass = blockPass && pass;
        WriteStats(jitter, options, options.implementation, block, "SAME", samples);
        std::printf("block=%d implementation=%s median_us=%.6f mad_us=%.6f "
                    "mad_over_median=%.6f cv=%.6f p90_us=%.6f verdict=%s\n",
                    block, options.implementation.c_str(), stats.median, stats.mad,
                    stats.mad / stats.median, stats.cv, stats.p90,
                    pass ? "PASS" : "NEEDS_VALIDATION");
        std::fflush(stdout);
    }
    const double medianOfBlocks = Median(blockMedians);
    double maxDrift = 0.0;
    for (size_t i = 1; i < blockMedians.size(); ++i) {
        maxDrift = std::max(maxDrift,
                            std::fabs(blockMedians[i] - blockMedians[0]) / medianOfBlocks);
    }
    const bool qualified = options.implementation == "parent" && blockPass && maxDrift <= 0.10;
    jitter << "qualification=" << (options.implementation != "parent"
                                       ? "NOT_PARENT_QUALIFICATION"
                                       : qualified ? "PASS" : "NEEDS_VALIDATION")
           << '\n'
           << "block_median_drift=" << std::fixed << std::setprecision(6) << maxDrift << '\n';
    jitter.flush();
    std::printf("shape=%s implementation=%s blocks=%d block_median_drift=%.6f "
                "qualification=%s\n",
                ShapeText(options).c_str(), options.implementation.c_str(),
                options.blocks, maxDrift,
                options.implementation != "parent" ? "NOT_PARENT_QUALIFICATION"
                                                   : qualified ? "PASS" : "NEEDS_VALIDATION");
}

static void RunPaired(Runtime& runtime, const Options& options,
                      std::ostream& raw, std::ostream& jitter)
{
    for (int i = 0; i < options.warmup; ++i) {
        const bool parentFirst = (i % 2 == 0);
        const RunKernel first = parentFirst ? w4r08_parent::w4r08_parent_run_kernel
                                           : w4r08_candidate::w4r08_candidate_run_kernel;
        const RunKernel second = parentFirst ? w4r08_candidate::w4r08_candidate_run_kernel
                                            : w4r08_parent::w4r08_parent_run_kernel;
        runtime.Launch(first);
        runtime.Synchronize("paired warmup first sync");
        runtime.Launch(second);
        runtime.Synchronize("paired warmup second sync");
    }

    std::ofstream pairOutput((options.outputPrefix + ".pairs.tsv").c_str());
    if (!pairOutput) Fail("cannot create paired summary output");
    pairOutput << "shape\tpair\torder\tsamples\tparent_median_us\tcandidate_median_us\t"
               << "delta_pct_candidate_vs_parent\tdelta_us\n";
    for (int pair = 0; pair < options.pairs; ++pair) {
        const bool parentFirst = (pair % 2 == 0);
        const std::string order = parentFirst ? "PC" : "CP";
        std::vector<Sample> parentSamples;
        std::vector<Sample> candidateSamples;
        if (parentFirst) {
            parentSamples = RunBlock(runtime, w4r08_parent::w4r08_parent_run_kernel,
                                     options, "parent", pair, order, options.samples, raw);
            candidateSamples = RunBlock(runtime, w4r08_candidate::w4r08_candidate_run_kernel,
                                        options, "candidate", pair, order, options.samples, raw);
        } else {
            candidateSamples = RunBlock(runtime, w4r08_candidate::w4r08_candidate_run_kernel,
                                        options, "candidate", pair, order, options.samples, raw);
            parentSamples = RunBlock(runtime, w4r08_parent::w4r08_parent_run_kernel,
                                     options, "parent", pair, order, options.samples, raw);
        }
        WriteStats(jitter, options, "parent", pair, order, parentSamples);
        WriteStats(jitter, options, "candidate", pair, order, candidateSamples);
        const double parentMedian = CalculateStats(parentSamples).median;
        const double candidateMedian = CalculateStats(candidateSamples).median;
        const double deltaPct = (candidateMedian / parentMedian - 1.0) * 100.0;
        pairOutput << ShapeText(options) << '\t' << pair << '\t' << order << '\t'
                   << options.samples << '\t' << std::fixed << std::setprecision(6)
                   << parentMedian << '\t' << candidateMedian << '\t' << deltaPct << '\t'
                   << (candidateMedian - parentMedian) << '\n';
        pairOutput.flush();
        std::printf("pair=%d order=%s parent_median_us=%.6f candidate_median_us=%.6f "
                    "delta_pct=%.4f\n",
                    pair, order.c_str(), parentMedian, candidateMedian, deltaPct);
        std::fflush(stdout);
    }
}

int main(int argc, char** argv)
{
    const Options options = ParseOptions(argc, argv);
    ValidateOptions(options);
    const std::string rawPath = options.outputPrefix + ".raw.tsv";
    const std::string jitterPath = options.outputPrefix + ".jitter.txt";
    const std::string pairsPath = options.outputPrefix + ".pairs.tsv";
    if ((options.mode == "paired" && PathExists(pairsPath)) ||
        (options.mode != "paired" && (PathExists(rawPath) || PathExists(jitterPath)))) {
        Fail("refusing to overwrite existing evidence; choose a new output prefix");
    }
    if (options.mode == "paired") ValidateQualification(options);

    std::printf("route=W4-R08 revision=V001 mode=%s shape=%s dtype=%s device=%d owner=%s lease_id=%s\n",
                options.mode.c_str(), ShapeText(options).c_str(),
                DtypeText(options.dtype).c_str(), options.device,
                options.owner.c_str(), options.leaseId.c_str());
    WriteMetadata(std::cout, options);
    Runtime runtime(options.device, options.rows, options.width);
    if (options.mode == "correctness") {
        RunCorrectness(runtime, options);
    } else {
        std::ofstream raw(rawPath.c_str());
        std::ofstream jitter(jitterPath.c_str());
        if (!raw || !jitter) Fail("cannot create raw/jitter output files");
        WriteMetadata(jitter, options);
        raw << "shape\trole\tblock\torder\tsample\tdevice_us\twall_us\n";
        jitter << "block_header\tshape\trole\tblock\torder\tsamples\tmedian_device_us\t"
               << "mean_device_us\tstdev_device_us\tcv_device\tmin_device_us\tmax_device_us\t"
               << "max_min\tmad_device_us\tp10_device_us\tp90_device_us\tabsolute_spread_us\t"
               << "mad_over_median\n";
        raw.flush();
        jitter.flush();
        if (options.mode == "noise-floor") RunNoiseFloor(runtime, options, raw, jitter);
        else RunPaired(runtime, options, raw, jitter);
        // Correctness compare happens after the timed loop, never inside it.
        const bool ok = runtime.Verify();
        std::printf("post_timing_verify=%s\n", ok ? "PASS" : "FAIL");
        if (!ok) Fail("post-timing correctness failed");
    }
    runtime.Close();
    return 0;
}
