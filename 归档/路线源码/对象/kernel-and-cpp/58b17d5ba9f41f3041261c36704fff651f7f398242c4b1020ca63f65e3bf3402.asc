#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace f001 {

enum DType : uint32_t {
    kFloat16 = 0,
    kBFloat16 = 1,
    kFloat32 = 2,
};

__aicore__ inline float LoadAsFloat(__gm__ const uint8_t* ptr, uint32_t index, uint32_t dtype)
{
    if (dtype == kFloat16) {
        return static_cast<float>(reinterpret_cast<__gm__ const half*>(ptr)[index]);
    }
    if (dtype == kBFloat16) {
        const uint16_t high_bits = reinterpret_cast<__gm__ const uint16_t*>(ptr)[index];
        const uint32_t bits = static_cast<uint32_t>(high_bits) << 16;
        return AscendC::GetScalarBitcodeValue<uint32_t, float>(bits);
    }
    return reinterpret_cast<__gm__ const float*>(ptr)[index];
}

__aicore__ inline void StoreFromFloat(__gm__ uint8_t* ptr, uint32_t index, uint32_t dtype, float value)
{
    if (dtype == kFloat16) {
        reinterpret_cast<__gm__ half*>(ptr)[index] = static_cast<half>(value);
    } else if (dtype == kBFloat16) {
        const uint32_t bits = AscendC::GetScalarBitcodeValue<float, uint32_t>(value);
        reinterpret_cast<__gm__ uint16_t*>(ptr)[index] = static_cast<uint16_t>(bits >> 16);
    } else {
        reinterpret_cast<__gm__ float*>(ptr)[index] = value;
    }
}

__aicore__ inline void ProcessRow(__gm__ const uint8_t* x_bytes,
    __gm__ const uint8_t* residual_bytes,
    __gm__ const uint8_t* gamma_bytes,
    __gm__ const uint8_t* bias_bytes,
    __gm__ uint8_t* output_bytes,
    uint64_t row,
    uint32_t d,
    uint32_t dtype,
    float epsilon,
    float inverse_d)
{
    const uint64_t offset = row * static_cast<uint64_t>(d);
    float sum_sq = 0.0f;
    for (uint32_t col = 0; col < d; ++col) {
        const float value = LoadAsFloat(x_bytes, static_cast<uint32_t>(offset + col), dtype) +
            LoadAsFloat(residual_bytes, static_cast<uint32_t>(offset + col), dtype);
        sum_sq += value * value;
    }
    const float inv_rms = 1.0f / sqrt(sum_sq * inverse_d + epsilon);
    for (uint32_t col = 0; col < d; ++col) {
        const uint32_t absolute = static_cast<uint32_t>(offset + col);
        const float value = LoadAsFloat(x_bytes, absolute, dtype) +
            LoadAsFloat(residual_bytes, absolute, dtype);
        const float scale = LoadAsFloat(gamma_bytes, col, dtype);
        const float addend = LoadAsFloat(bias_bytes, col, dtype);
        StoreFromFloat(output_bytes, absolute, dtype, value * inv_rms * scale + addend);
    }
}

extern "C" __global__ __aicore__ void add_rms_norm_bias_kernel(
    GM_ADDR x,
    GM_ADDR residual,
    GM_ADDR gamma,
    GM_ADDR bias,
    GM_ADDR output,
    uint64_t rows,
    uint32_t d,
    uint32_t dtype,
    float epsilon,
    float inverse_d,
    uint32_t block_dim)
{
    const uint32_t core = AscendC::GetBlockIdx();
    if (core >= block_dim || d == 0) {
        return;
    }

    __gm__ const uint8_t* x_bytes = reinterpret_cast<__gm__ const uint8_t*>(x);
    __gm__ const uint8_t* residual_bytes = reinterpret_cast<__gm__ const uint8_t*>(residual);
    __gm__ const uint8_t* gamma_bytes = reinterpret_cast<__gm__ const uint8_t*>(gamma);
    __gm__ const uint8_t* bias_bytes = reinterpret_cast<__gm__ const uint8_t*>(bias);
    __gm__ uint8_t* output_bytes = reinterpret_cast<__gm__ uint8_t*>(output);

    const bool hot_path = d >= 64 && d <= 32768 && (d & 15U) == 0;
    if (hot_path) {
        for (uint64_t row = core; row < rows; row += block_dim) {
            ProcessRow(x_bytes, residual_bytes, gamma_bytes, bias_bytes, output_bytes,
                row, d, dtype, epsilon, inverse_d);
        }
        return;
    }

    // Generic path keeps complete-row ownership without relying on D alignment.
    for (uint64_t row = core; row < rows; row += block_dim) {
        ProcessRow(x_bytes, residual_bytes, gamma_bytes, bias_bytes, output_bytes,
            row, d, dtype, epsilon, inverse_d);
    }
}

}  // namespace f001

template <typename T>
auto F001Numel(const T& info, int) -> decltype(static_cast<uint64_t>(info.numel))
{
    return static_cast<uint64_t>(info.numel);
}

template <typename T>
auto F001Numel(const T& info, long) -> decltype(static_cast<uint64_t>(info.elements))
{
    return static_cast<uint64_t>(info.elements);
}

inline uint64_t F001Numel(...)
{
    return 0;
}

template <typename T>
auto F001LastDim(const T& info, int) -> decltype(static_cast<uint32_t>(info.shape.back()))
{
    return static_cast<uint32_t>(info.shape.back());
}

template <typename T>
auto F001LastDim(const T& info, long) -> decltype(static_cast<uint32_t>(info.shape[info.rank - 1]))
{
    return static_cast<uint32_t>(info.shape[info.rank - 1]);
}

template <typename T>
auto F001LastDim(const T& info, short) -> decltype(static_cast<uint32_t>(info.dims[info.rank - 1]))
{
    return static_cast<uint32_t>(info.dims[info.rank - 1]);
}

template <typename T>
auto F001LastDim(const T& info, char) -> decltype(static_cast<uint32_t>(info.d))
{
    return static_cast<uint32_t>(info.d);
}

inline uint32_t F001LastDim(...)
{
    return 0;
}

template <typename T>
auto F001DType(const T& info, int) -> decltype(static_cast<uint32_t>(info.dtype))
{
    return static_cast<uint32_t>(info.dtype);
}

template <typename T>
auto F001DType(const T& info, long) -> decltype(static_cast<uint32_t>(info.data_type))
{
    return static_cast<uint32_t>(info.data_type);
}

inline uint32_t F001DType(...)
{
    return f001::kFloat32;
}

static uint32_t F001KernelDType(uint32_t acl_dtype)
{
    if (acl_dtype == static_cast<uint32_t>(ACL_FLOAT16)) {
        return f001::kFloat16;
    }
    if (acl_dtype == static_cast<uint32_t>(ACL_BF16)) {
        return f001::kBFloat16;
    }
    return f001::kFloat32;
}

// The judge supplies device buffers, TensorInfo values, the physical Vector
// Core count, and its stream. Keep this ABI exact; the judge owns main().
template <typename InfoX, typename InfoR, typename InfoG, typename InfoB, typename InfoO, typename CoreNum, typename Stream>
void run_kernel(GM_ADDR x,
    const InfoX& info_x,
    GM_ADDR residual,
    const InfoR& info_residual,
    GM_ADDR gamma,
    const InfoG& info_gamma,
    GM_ADDR bias,
    const InfoB& info_bias,
    GM_ADDR output,
    const InfoO& info_output,
    CoreNum availableCoreNum,
    Stream stream,
    float epsilon)
{
    (void)info_residual;
    (void)info_bias;
    (void)info_output;
    uint32_t d = F001LastDim(info_gamma, 0);
    if (d == 0) {
        d = static_cast<uint32_t>(F001Numel(info_gamma, 0));
    }
    const uint64_t total = F001Numel(info_x, 0);
    const uint64_t rows = d == 0 ? 0 : total / d;
    const uint32_t dtype = F001KernelDType(F001DType(info_x, 0));
    const uint32_t core_count = static_cast<uint32_t>(availableCoreNum);
    const uint32_t block_dim = static_cast<uint32_t>(std::min<uint64_t>(
        static_cast<uint64_t>(core_count), std::max<uint64_t>(rows, 1)));
    f001::add_rms_norm_bias_kernel<<<block_dim, nullptr, stream>>>(
        x, residual, gamma, bias, output, rows, d, dtype, epsilon,
        d == 0 ? 0.0f : 1.0f / static_cast<float>(d), block_dim);
}
