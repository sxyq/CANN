#include <acl/acl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "../op_kernel/row_copy_tiling.h"
#include "../op_kernel/row_copy_kernel.asc"

namespace {

bool CheckAcl(aclError status, const char *operation)
{
    if (status == ACL_SUCCESS) return true;
    fprintf(stderr, "%s failed: %d\n", operation, (int)status);
    return false;
}

bool ValidateShape(uint32_t rows, uint32_t cols)
{
    return rows > 1 && cols >= kMinCols && cols <= kMaxCols && cols % 8 == 0;
}

int HostProbe()
{
    const RowCopyTiling cases[] = {{2, 256}, {5, 4096}, {3, 8192}};
    for (const auto &shape : cases) {
        if (!ValidateShape(shape.rows, shape.cols)) return 1;
        const size_t count = (size_t)shape.rows * shape.cols;
        float *input = (float *)malloc(count * sizeof(float));
        float *output = (float *)malloc(count * sizeof(float));
        if (!input || !output) return 2;
        for (size_t i = 0; i < count; ++i) input[i] = (float)(i % 251) - 125.0f;
        memcpy(output, input, count * sizeof(float));
        const int equal = memcmp(input, output, count * sizeof(float)) == 0;
        free(input);
        free(output);
        if (!equal) return 3;
        printf("HOST_PROBE PASS rows=%u D=%u contiguous_fp32_abi\n", shape.rows, shape.cols);
    }
    return 0;
}

int DeviceProbe(uint32_t rows, uint32_t cols, int deviceId)
{
    if (!ValidateShape(rows, cols)) {
        fprintf(stderr, "unsupported shape: rows must be >1; D in [256,8192] and divisible by 8\n");
        return 2;
    }

    bool initialized = false, deviceSet = false;
    aclrtStream stream = nullptr;
    void *inputDev = nullptr, *outputDev = nullptr, *tilingDev = nullptr;
    int result = 1;
    const size_t count = (size_t)rows * cols;
    const size_t bytes = count * sizeof(float);
    float *input = (float *)malloc(bytes);
    float *output = (float *)calloc(count, sizeof(float));
    if (!input || !output) {
        free(input);
        free(output);
        return 1;
    }
    for (size_t i = 0; i < count; ++i) input[i] = (float)((i * 17 + 23) % 1009) / 31.0f;
    RowCopyTiling tiling{rows, cols};

    if (!CheckAcl(aclInit(nullptr), "aclInit")) goto cleanup;
    initialized = true;
    if (!CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) goto cleanup;
    deviceSet = true;
    if (!CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) goto cleanup;
    if (!CheckAcl(aclrtMalloc(&inputDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(input)")) goto cleanup;
    if (!CheckAcl(aclrtMalloc(&outputDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(output)")) goto cleanup;
    if (!CheckAcl(aclrtMalloc(&tilingDev, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(tiling)")) goto cleanup;
    if (!CheckAcl(aclrtMemcpy(inputDev, bytes, input, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy input")) goto cleanup;
    if (!CheckAcl(aclrtMemcpy(tilingDev, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "copy tiling")) goto cleanup;

    row_copy_kernel<<<(rows + kRowsPerBlock - 1) / kRowsPerBlock, nullptr, stream>>>(
        (GM_ADDR)inputDev, (GM_ADDR)outputDev, (GM_ADDR)tilingDev);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "kernel synchronize")) goto cleanup;
    if (!CheckAcl(aclrtMemcpy(output, bytes, outputDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy output")) goto cleanup;
    if (memcmp(input, output, bytes) != 0) {
        fprintf(stderr, "CORRECTNESS FAIL rows=%u D=%u\n", rows, cols);
        result = 3;
        goto cleanup;
    }
    printf("NPU_PROBE PASS device=%d rows=%u D=%u elements=%zu exact=1\n",
           deviceId, rows, cols, count);
    result = 0;

cleanup:
    if (tilingDev) aclrtFree(tilingDev);
    if (outputDev) aclrtFree(outputDev);
    if (inputDev) aclrtFree(inputDev);
    if (stream) aclrtDestroyStream(stream);
    if (deviceSet) aclrtResetDevice(deviceId);
    if (initialized) aclFinalize();
    free(input);
    free(output);
    return result;
}

}  // namespace

int main(int argc, char **argv)
{
    if (argc == 2 && strcmp(argv[1], "--host-probe") == 0) return HostProbe();
    if (argc == 5 && strcmp(argv[1], "--device-probe") == 0) {
        return DeviceProbe((uint32_t)strtoul(argv[2], nullptr, 10),
                           (uint32_t)strtoul(argv[3], nullptr, 10),
                           atoi(argv[4]));
    }
    fprintf(stderr, "usage: %s --host-probe | --device-probe R D DEVICE_ID\n", argv[0]);
    return 64;
}
