#define main r14_existing_profile_main
#include "main.asc"
#undef main

#define AddRmsNormBiasKernel R14CandidateAddRmsNormBiasKernel
#define add_rms_norm_bias_custom r14_candidate_add_rms_norm_bias_custom
#define run_kernel r14_candidate_run_kernel
#include "../submission.asc"
#undef run_kernel
#undef add_rms_norm_bias_custom
#undef AddRmsNormBiasKernel

#include <algorithm>
#include <chrono>
#include <cmath>
#include <random>
#include <vector>

struct CandidateProbeEvents {
    aclrtEvent start = nullptr;
    aclrtEvent stop = nullptr;
    bool recorded = false;
    ~CandidateProbeEvents()
    {
        if (stop != nullptr) (void)aclrtDestroyEvent(stop);
        if (start != nullptr) (void)aclrtDestroyEvent(start);
    }
};

int main(int argc, char** argv)
{
    if (argc != 8) {
        fprintf(stderr, "usage: %s device rows width available_cores warmup pairs_per_block blocks\n", argv[0]);
        return 2;
    }
    const int device = atoi(argv[1]);
    const int rows = atoi(argv[2]);
    const int width = atoi(argv[3]);
    const int requestedCores = atoi(argv[4]);
    const int warmup = atoi(argv[5]);
    const int pairs = atoi(argv[6]);
    const int blocks = atoi(argv[7]);
    const bool correctnessOnly = pairs == 0 && blocks == 0;
    if (device < 0 || rows <= 0 || width <= 0 || requestedCores < 0 ||
        warmup < 0 || pairs < 0 || blocks < 0 || ((pairs == 0) != (blocks == 0)) ||
        (!correctnessOnly && (warmup < 10 || pairs < 21 || blocks < 2))) {
        fprintf(stderr, "invalid device, shape, or sample configuration\n");
        return 2;
    }

    Runtime runtime;
    runtime.deviceId = device;
    ACL_REQUIRE(aclInit(nullptr));
    runtime.initialized = true;
    ACL_REQUIRE(aclrtSetDevice(device));
    runtime.deviceSet = true;
    int64_t physicalCores = 0;
    ACL_REQUIRE(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &physicalCores));
    const int64_t availableCores = requestedCores == 0
        ? physicalCores : std::min<int64_t>(requestedCores, physicalCores);
    ACL_REQUIRE(aclrtCreateStream(&runtime.stream));

    const size_t elements = static_cast<size_t>(rows) * width;
    const size_t bytes = elements * sizeof(float);
    const size_t parameterBytes = static_cast<size_t>(width) * sizeof(float);
    std::vector<float> x(elements), residual(elements), gamma(width), bias(width);
    std::vector<float> parentOutput(elements), candidateOutput(elements);
    std::vector<double> reference(elements);
    std::mt19937 generator(314159u + static_cast<uint32_t>(width));
    std::uniform_real_distribution<float> distribution(-0.5f, 0.5f);
    for (float& value : x) value = distribution(generator);
    for (float& value : residual) value = distribution(generator) * 0.25f;
    for (float& value : gamma) value = distribution(generator) + 1.0f;
    for (float& value : bias) value = distribution(generator) * 0.125f;
    for (int row = 0; row < rows; ++row) {
        const size_t offset = static_cast<size_t>(row) * width;
        double sum = 0.0;
        for (int col = 0; col < width; ++col) {
            const double value = static_cast<double>(x[offset + col]) + residual[offset + col];
            sum += value * value;
        }
        const double inverse = 1.0 / std::sqrt(sum / width + 1.0e-5);
        for (int col = 0; col < width; ++col) {
            const double value = static_cast<double>(x[offset + col]) + residual[offset + col];
            reference[offset + col] = value * inverse * gamma[col] + bias[col];
        }
    }

    DeviceBuffer xd, rd, gd, bd, parentDevice, candidateDevice;
    if (!Upload(x.data(), bytes, xd) || !Upload(residual.data(), bytes, rd) ||
        !Upload(gamma.data(), parameterBytes, gd) || !Upload(bias.data(), parameterBytes, bd) ||
        !parentDevice.Allocate(bytes) || !candidateDevice.Allocate(bytes)) {
        fprintf(stderr, "device allocation or input transfer failed\n");
        return 1;
    }
    const int64_t shape[] = {rows, width};
    const int64_t parameterShape[] = {width};
    TensorInfo tensor = {shape, 2, 0};
    TensorInfo parameter = {parameterShape, 1, 0};
    TensorGroupInfo info = {&tensor, 1};
    TensorGroupInfo parameterInfo = {&parameter, 1};
    auto launchParent = [&]() {
        run_kernel((GM_ADDR)xd.ptr, info, (GM_ADDR)rd.ptr, info,
                   (GM_ADDR)gd.ptr, parameterInfo, (GM_ADDR)bd.ptr, parameterInfo,
                   (GM_ADDR)parentDevice.ptr, info, availableCores, runtime.stream, 1.0e-5f);
    };
    auto launchCandidate = [&]() {
        r14_candidate_run_kernel((GM_ADDR)xd.ptr, info, (GM_ADDR)rd.ptr, info,
                                 (GM_ADDR)gd.ptr, parameterInfo, (GM_ADDR)bd.ptr, parameterInfo,
                                 (GM_ADDR)candidateDevice.ptr, info, availableCores,
                                 runtime.stream, 1.0e-5f);
    };
    launchParent();
    launchCandidate();
    ACL_REQUIRE(aclrtSynchronizeStream(runtime.stream));
    ACL_REQUIRE(aclrtMemcpy(parentOutput.data(), bytes, parentDevice.ptr, bytes,
                            ACL_MEMCPY_DEVICE_TO_HOST));
    ACL_REQUIRE(aclrtMemcpy(candidateOutput.data(), bytes, candidateDevice.ptr, bytes,
                            ACL_MEMCPY_DEVICE_TO_HOST));
    size_t parentMismatches = 0;
    size_t candidateMismatches = 0;
    double parentMaxAbs = 0.0;
    double candidateMaxAbs = 0.0;
    for (size_t i = 0; i < elements; ++i) {
        const double parentError = std::abs(static_cast<double>(parentOutput[i]) - reference[i]);
        const double candidateError = std::abs(static_cast<double>(candidateOutput[i]) - reference[i]);
        parentMaxAbs = std::max(parentMaxAbs, parentError);
        candidateMaxAbs = std::max(candidateMaxAbs, candidateError);
        const double tolerance = 2.0e-5 + 1.0e-4 * std::abs(reference[i]);
        if (!std::isfinite(parentOutput[i]) || parentError > tolerance) ++parentMismatches;
        if (!std::isfinite(candidateOutput[i]) || candidateError > tolerance) ++candidateMismatches;
    }
    fprintf(stderr, "CORRECTNESS variant=parent rows=%d width=%d dtype=fp32 device=%d physical_cores=%lld available_cores=%lld block_count=%lld mismatches=%zu max_abs=%.12g reference=cpu_fp64 atol=2e-5 rtol=1e-4 seed=%u\n",
            rows, width, device, static_cast<long long>(physicalCores),
            static_cast<long long>(availableCores), static_cast<long long>(std::min<int64_t>(rows, availableCores)),
            parentMismatches, parentMaxAbs, 314159u + static_cast<uint32_t>(width));
    fprintf(stderr, "CORRECTNESS variant=candidate rows=%d width=%d dtype=fp32 device=%d physical_cores=%lld available_cores=%lld block_count=%lld mismatches=%zu max_abs=%.12g reference=cpu_fp64 atol=2e-5 rtol=1e-4 seed=%u\n",
            rows, width, device, static_cast<long long>(physicalCores),
            static_cast<long long>(availableCores), static_cast<long long>(std::min<int64_t>(rows, availableCores)),
            candidateMismatches, candidateMaxAbs, 314159u + static_cast<uint32_t>(width));
    if (parentMismatches != 0 || candidateMismatches != 0) return 3;
    if (correctnessOnly) {
        fprintf(stderr, "CORRECTNESS_ONLY=PASS\n");
        return 0;
    }

    for (int i = 0; i < warmup; ++i) {
        if ((i & 1) == 0) {
            launchParent();
            launchCandidate();
        } else {
            launchCandidate();
            launchParent();
        }
    }
    ACL_REQUIRE(aclrtSynchronizeStream(runtime.stream));
    CandidateProbeEvents events;
    ACL_REQUIRE(aclrtCreateEvent(&events.start));
    ACL_REQUIRE(aclrtCreateEvent(&events.stop));
    auto measure = [&](auto&& launch, double& deviceUs, double& wallUs) -> int {
        if (events.recorded) {
            ACL_REQUIRE(aclrtResetEvent(events.start, runtime.stream));
            ACL_REQUIRE(aclrtResetEvent(events.stop, runtime.stream));
        }
        const auto begin = std::chrono::steady_clock::now();
        ACL_REQUIRE(aclrtRecordEvent(events.start, runtime.stream));
        launch();
        ACL_REQUIRE(aclrtRecordEvent(events.stop, runtime.stream));
        ACL_REQUIRE(aclrtSynchronizeEvent(events.stop));
        const auto end = std::chrono::steady_clock::now();
        float elapsedMs = 0.0f;
        ACL_REQUIRE(aclrtEventElapsedTime(&elapsedMs, events.start, events.stop));
        events.recorded = true;
        deviceUs = static_cast<double>(elapsedMs) * 1000.0;
        wallUs = std::chrono::duration<double, std::micro>(end - begin).count();
        return 0;
    };
    fprintf(stderr, "PAIRED_BINARY warmup=%d pairs_per_block=%d blocks=%d timing=device_event_primary wall_secondary timed_allocations=0 same_input=1 order=alternating\n",
            warmup, pairs, blocks);
    printf("block\tpair\torder\tparent_us\tcandidate_us\tparent_wall_us\tcandidate_wall_us\n");
    for (int block = 0; block < blocks; ++block) {
        for (int pair = 0; pair < pairs; ++pair) {
            double parentUs = 0.0, candidateUs = 0.0, parentWallUs = 0.0, candidateWallUs = 0.0;
            const bool parentFirst = ((block + pair) & 1) == 0;
            if (parentFirst) {
                if (measure(launchParent, parentUs, parentWallUs) != 0 ||
                    measure(launchCandidate, candidateUs, candidateWallUs) != 0) return 1;
            } else {
                if (measure(launchCandidate, candidateUs, candidateWallUs) != 0 ||
                    measure(launchParent, parentUs, parentWallUs) != 0) return 1;
            }
            printf("%d\t%d\t%s\t%.9f\t%.9f\t%.9f\t%.9f\n", block, pair,
                   parentFirst ? "PARENT-CANDIDATE" : "CANDIDATE-PARENT",
                   parentUs, candidateUs, parentWallUs, candidateWallUs);
        }
    }
    ACL_REQUIRE(aclrtSynchronizeStream(runtime.stream));
    return 0;
}
