#include "kernel_operator.h"
#include "row_copy_tiling.h"

extern "C" __global__ __vector__ void row_copy_kernel(
    GM_ADDR input, GM_ADDR output, GM_ADDR tiling)
{
    const __gm__ RowCopyTiling *shape =
        reinterpret_cast<const __gm__ RowCopyTiling *>(tiling);
    const uint32_t rowStart = AscendC::GetBlockIdx() * kRowsPerBlock;
    if (rowStart >= shape->rows) {
        return;
    }

    const uint32_t rowsThisBlock =
        (shape->rows - rowStart >= kRowsPerBlock) ? kRowsPerBlock : 1;
    const uint32_t rowElements = shape->cols;
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> staging;
    pipe.InitBuffer(staging, kRowsPerBlock * kMaxCols * sizeof(float));
    AscendC::LocalTensor<float> local = staging.Get<float>();

    AscendC::GlobalTensor<float> inputGm;
    AscendC::GlobalTensor<float> outputGm;
    inputGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(input) + rowStart * rowElements);
    outputGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(output) + rowStart * rowElements);

    // dav_c220 reports incorrect data past 256 32-byte blocks in one 2-D row.
    constexpr uint32_t kMaxBlocksPerSegment = 256;
    constexpr uint32_t kMaxElementsPerSegment =
        kMaxBlocksPerSegment * 32 / sizeof(float);
    for (uint32_t row = 0; row < rowsThisBlock; ++row) {
        for (uint32_t col = 0; col < rowElements;) {
            const uint32_t chunkElements =
                (rowElements - col > kMaxElementsPerSegment) ?
                    kMaxElementsPerSegment : (rowElements - col);
            AscendC::DataCopyParams copyParams{
                1,
                static_cast<uint16_t>(chunkElements * sizeof(float) / 32),
                0,
                0};
            AscendC::DataCopy(local, inputGm[row * rowElements + col], copyParams);
            AscendC::PipeBarrier<PIPE_MTE2>();
            AscendC::DataCopy(outputGm[row * rowElements + col], local, copyParams);
            AscendC::PipeBarrier<PIPE_MTE3>();
            col += chunkElements;
        }
    }
}
