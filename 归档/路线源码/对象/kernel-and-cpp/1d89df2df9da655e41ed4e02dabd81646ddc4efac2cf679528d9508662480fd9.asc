#include <acl/acl.h>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <vector>
#include "kernel_operator.h"

struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};

// The original Parent is included without kernel or dispatch edits.
#include "submission.asc"

namespace {
constexpr int kWidth = 64;
constexpr int kWarmup = 60;
constexpr int kBlocks = 2;
constexpr int kPairs = 31;
constexpr int kAvailableCores = 8;
constexpr float kEpsilon = 1.0e-5f;

void RequireAcl(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL_FAILURE operation=%s code=%d\n", operation, status);
        std::exit(2);
    }
}

FILE* OpenOutput(const std::string& path)
{
    FILE* file = std::fopen(path.c_str(), "wx");
    if (!file) {
        std::perror(path.c_str());
        std::exit(2);
    }
    return file;
}

bool ReportMemory(const char* stage)
{
    size_t freeBytes = 0, totalBytes = 0;
    RequireAcl(aclrtGetMemInfo(ACL_HBM_MEM, &freeBytes, &totalBytes), "get HBM memory");
    std::printf("RESOURCE stage=%s free_hbm_mb=%.6f total_hbm_mb=%.6f\n",
                stage, freeBytes / 1048576.0, totalBytes / 1048576.0);
    return freeBytes >= 100ull * 1024 * 1024;
}

struct Sample {
    int ordinal;
    int block;
    int pair;
    int position;
    int side;
    double deviceUs;
    double wallUs;
};
}

int main(int argc, char** argv)
{
    if (argc != 3) {
        std::fprintf(stderr, "usage: r12_parent_probe DEVICE OUTPUT_PREFIX\n");
        return 2;
    }
    const int device = std::stoi(argv[1]);
    const std::string prefix = argv[2];
    FILE* referenceFile = OpenOutput(prefix + ".reference.tsv");
    FILE* rawFile = OpenOutput(prefix + ".raw.tsv");
    std::fprintf(referenceFile, "index\tx\tresidual\tgamma\tbias\treference_fp64\tactual_fp32\tabs_error\ttolerance\tpass\n");
    std::fprintf(rawFile, "launch_ordinal\tblock\tpair\tposition\tside\tdevice_us\twall_us\n");

    std::vector<float> x(kWidth), residual(kWidth), gamma(kWidth), bias(kWidth);
    std::vector<float> output(kWidth, NAN);
    std::vector<double> reference(kWidth);
    // Inputs and shape come from R3 V001 paired_runner.cpp::MakeInput.
    double sumSquares = 0.0;
    for (int i = 0; i < kWidth; ++i) {
        x[i] = 0.19f * std::sin(static_cast<float>((i * 17) % 997) * 0.013f);
        residual[i] = 0.11f * std::cos(static_cast<float>((i * 29) % 991) * 0.017f);
        gamma[i] = 0.85f + static_cast<float>(i % 23) * 0.002f;
        bias[i] = -0.025f + static_cast<float>(i % 19) * 0.001f;
        const double y = static_cast<double>(x[i]) + residual[i];
        sumSquares += y * y;
    }
    const double inverseRms = 1.0 / std::sqrt(sumSquares / kWidth + kEpsilon);
    for (int i = 0; i < kWidth; ++i) {
        reference[i] = (static_cast<double>(x[i]) + residual[i]) * inverseRms * gamma[i] + bias[i];
    }

    RequireAcl(aclInit(nullptr), "init");
    RequireAcl(aclrtSetDevice(device), "set device");
    aclrtStream stream = nullptr;
    RequireAcl(aclrtCreateStream(&stream), "create stream");
    if (!ReportMemory("before_correctness")) {
        std::fprintf(stderr, "RESOURCE_FAILURE free_hbm_below_100_mb\n");
        return 4;
    }
    void* buffers[5] = {};
    const size_t bytes = kWidth * sizeof(float);
    const float* hostInputs[5] = {x.data(), residual.data(), gamma.data(), bias.data(), output.data()};
    for (int i = 0; i < 5; ++i) {
        RequireAcl(aclrtMalloc(&buffers[i], bytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate buffer");
        RequireAcl(aclrtMemcpy(buffers[i], bytes, hostInputs[i], bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy input or NaN sentinel");
    }

    const int64_t dataShape[] = {1, kWidth};
    const int64_t paramShape[] = {kWidth};
    const TensorInfo dataInfo{dataShape, 2, 0};
    const TensorInfo paramInfo{paramShape, 1, 0};
    const TensorGroupInfo dataGroup{&dataInfo, 1};
    const TensorGroupInfo paramGroup{&paramInfo, 1};
    int launchOrdinal = 0;
    auto launch = [&]() {
        run_kernel(static_cast<uint8_t*>(buffers[0]), dataGroup,
                   static_cast<uint8_t*>(buffers[1]), dataGroup,
                   static_cast<uint8_t*>(buffers[2]), paramGroup,
                   static_cast<uint8_t*>(buffers[3]), paramGroup,
                   static_cast<uint8_t*>(buffers[4]), dataGroup,
                   kAvailableCores, stream, kEpsilon);
        ++launchOrdinal;
    };
    std::printf("PROBE shape=1x64 dtype=FP32 epsilon=%.9g availableCoreNum=8 blockCount=1 localRows=1 path=generic_cached_row warmup=60 blocks=2 pairs_per_block=31 batch_n=1\n", kEpsilon);
    launch();
    RequireAcl(aclrtSynchronizeStream(stream), "correctness synchronize");
    RequireAcl(aclrtMemcpy(output.data(), bytes, buffers[4], bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy result");
    size_t failures = 0;
    double maxAbs = 0.0;
    for (int i = 0; i < kWidth; ++i) {
        const double error = std::fabs(static_cast<double>(output[i]) - reference[i]);
        const double tolerance = std::ldexp(1.0, -16) + std::ldexp(1.0, -10) * std::fabs(reference[i]);
        const bool passed = std::isfinite(output[i]) && error <= tolerance && error <= 0.01;
        failures += !passed;
        if (std::isfinite(error) && error > maxAbs) maxAbs = error;
        std::fprintf(referenceFile, "%d\t%.9g\t%.9g\t%.9g\t%.9g\t%.17g\t%.9g\t%.17g\t%.17g\t%d\n",
                     i, x[i], residual[i], gamma[i], bias[i], reference[i], output[i], error, tolerance, passed);
    }
    std::fclose(referenceFile);
    std::printf("CORRECTNESS result=%s reference=CPU_FP64 failures=%zu elements=64 max_abs=%.17g require_all_elements=YES sentinel=NaN launch_ordinal=%d\n",
                failures == 0 ? "PASS" : "FAIL", failures, maxAbs, launchOrdinal);
    std::fflush(stdout);

    int result = failures == 0 ? 0 : 3;
    if (result == 0 && !ReportMemory("before_local")) result = 4;
    if (result == 0) {
        aclrtEvent start = nullptr, stop = nullptr;
        RequireAcl(aclrtCreateEvent(&start), "create start event");
        RequireAcl(aclrtCreateEvent(&stop), "create stop event");
        std::vector<Sample> samples;
        samples.reserve(kBlocks * kPairs * 2);
        for (int i = 0; i < kWarmup; ++i) {
            launch();
            RequireAcl(aclrtSynchronizeStream(stream), "warmup synchronize");
        }
        for (int block = 0; block < kBlocks; ++block) {
            for (int pair = 0; pair < kPairs; ++pair) {
                for (int position = 0; position < 2; ++position) {
                    const int side = ((block + pair) % 2 + position) % 2 + 1;
                    const auto wallStart = std::chrono::steady_clock::now();
                    RequireAcl(aclrtRecordEvent(start, stream), "record start event");
                    launch();
                    RequireAcl(aclrtRecordEvent(stop, stream), "record stop event");
                    RequireAcl(aclrtSynchronizeEvent(stop), "sample synchronize");
                    const auto wallStop = std::chrono::steady_clock::now();
                    float elapsedMs = 0.0f;
                    RequireAcl(aclrtEventElapsedTime(&elapsedMs, start, stop), "event elapsed time");
                    samples.push_back({launchOrdinal, block, pair, position, side,
                                       static_cast<double>(elapsedMs) * 1000.0,
                                       std::chrono::duration<double, std::micro>(wallStop - wallStart).count()});
                }
            }
        }
        for (const Sample& sample : samples) {
            std::fprintf(rawFile, "%d\t%d\t%d\t%d\tP%d\t%.9f\t%.9f\n",
                         sample.ordinal, sample.block, sample.pair, sample.position, sample.side,
                         sample.deviceUs, sample.wallUs);
        }
        RequireAcl(aclrtDestroyEvent(stop), "destroy stop event");
        RequireAcl(aclrtDestroyEvent(start), "destroy start event");
        ReportMemory("after_local");
        std::printf("SAMPLES count=%zu measured_launch_first=62 measured_launch_last=%d same_binary=YES candidate=NONE\n",
                    samples.size(), launchOrdinal);
    }
    std::fclose(rawFile);
    RequireAcl(aclrtSynchronizeStream(stream), "final synchronize");
    for (void* buffer : buffers) RequireAcl(aclrtFree(buffer), "free buffer");
    RequireAcl(aclrtDestroyStream(stream), "destroy stream");
    RequireAcl(aclrtResetDevice(device), "release own device context");
    RequireAcl(aclFinalize(), "finalize");
    std::printf("RUN_COMPLETE result=%d host_launch_calls=%d RUNNING_DEVICE_OPERATION=NONE\n", result, launchOrdinal);
    return result;
}
