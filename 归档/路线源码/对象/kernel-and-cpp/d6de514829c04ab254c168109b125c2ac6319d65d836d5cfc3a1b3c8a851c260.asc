#include <acl/acl.h>
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

#include "local_types.h"
#include "submission.asc"

#ifndef TINY_TOOLCHAIN_LABEL
#define TINY_TOOLCHAIN_LABEL "UNSET_TOOLCHAIN"
#endif

#define ACL_CHECK(expr) do { \
    const aclError result = (expr); \
    if (result != ACL_SUCCESS) { \
        std::fprintf(stderr, "ACL failure %s=%d at %s:%d\n", #expr, result, __FILE__, __LINE__); \
        return 1; \
    } \
} while (0)

namespace {
constexpr int64_t kWidth = 256;
constexpr float kEpsilon = 1.0e-5f;

float InputValue(int64_t index, int multiplier, int offset)
{
    return static_cast<float>((index * multiplier + offset) % 997) / 498.0f - 1.0f;
}

int RunProxyCase(const char* label, int64_t cap, int64_t rows, int64_t runtimeA,
                 aclrtStream stream, const std::vector<float>& hostX,
                 const std::vector<float>& hostResidual,
                 const std::vector<float>& hostGamma,
                 const std::vector<float>& hostBias,
                 std::vector<float>& hostOutput,
                 void* deviceX, void* deviceResidual, void* deviceGamma,
                 void* deviceBias, void* deviceOutput,
                 TensorGroupInfo infoX, TensorGroupInfo infoResidual,
                 TensorGroupInfo infoGamma, TensorGroupInfo infoBias,
                 TensorGroupInfo infoOutput)
{
    const int64_t blockCount = std::min(cap, rows);
    if (cap < 1 || blockCount < 1) {
        std::fprintf(stderr, "invalid PROXY availableCoreNum=%lld\n",
                     static_cast<long long>(cap));
        return 1;
    }

    const bool equalOwnership = rows == blockCount;
    std::printf("PROXY-TINY-V001 label=%s toolchain=%s A=%lld M=%lld B=%lld "
                "availableCoreNum=%lld blockCount=%lld ownership_condition=%s "
                "expected_branch_hit=%s\n",
                label, TINY_TOOLCHAIN_LABEL,
                static_cast<long long>(runtimeA), static_cast<long long>(rows),
                static_cast<long long>(rows - 1), static_cast<long long>(cap),
                static_cast<long long>(blockCount),
                equalOwnership ? "rowCount==blockCount" : "rowCount!=blockCount",
                equalOwnership ? "H2_FASTFORM" : "PARENT_FORMULA_FALLBACK");

    run_kernel((GM_ADDR)deviceX, infoX, (GM_ADDR)deviceResidual, infoResidual,
               (GM_ADDR)deviceGamma, infoGamma, (GM_ADDR)deviceBias, infoBias,
               (GM_ADDR)deviceOutput, infoOutput, cap, stream, kEpsilon);
    const aclError syncResult = aclrtSynchronizeStream(stream);
    if (syncResult != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL failure aclrtSynchronizeStream=%d at %s:%d\n",
                     syncResult, __FILE__, __LINE__);
        return 1;
    }

    const size_t outputBytes = hostOutput.size() * sizeof(float);
    const aclError copyResult = aclrtMemcpy(hostOutput.data(), outputBytes,
                                            deviceOutput, outputBytes,
                                            ACL_MEMCPY_DEVICE_TO_HOST);
    if (copyResult != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL failure aclrtMemcpy(D2H)=%d at %s:%d\n",
                     copyResult, __FILE__, __LINE__);
        return 1;
    }

    float maxAbs = 0.0f;
    int bad = 0;
    for (int64_t row = 0; row < rows; ++row) {
        float sum = 0.0f;
        for (int64_t col = 0; col < kWidth; ++col) {
            const size_t index = static_cast<size_t>(row * kWidth + col);
            const float value = hostX[index] + hostResidual[index];
            sum += value * value;
        }
        const float invRms = 1.0f / std::sqrt(sum / static_cast<float>(kWidth) + kEpsilon);
        for (int64_t col = 0; col < kWidth; ++col) {
            const size_t index = static_cast<size_t>(row * kWidth + col);
            const float value = hostX[index] + hostResidual[index];
            const float expected = value * invRms * hostGamma[static_cast<size_t>(col)] +
                                   hostBias[static_cast<size_t>(col)];
            const float actual = hostOutput[index];
            const float error = std::fabs(actual - expected);
            maxAbs = std::max(maxAbs, error);
            if (!std::isfinite(actual) || error > 1.0e-4f + 1.0e-4f * std::fabs(expected)) {
                ++bad;
            }
        }
    }

    std::printf("PROXY-TINY-V001 result=%s rows=%lld width=%lld dtype=FP32 "
                "availableCoreNum=%lld blockCount=%lld max_abs=%.9g bad=%d\n",
                label, static_cast<long long>(rows), static_cast<long long>(kWidth),
                static_cast<long long>(cap), static_cast<long long>(blockCount),
                maxAbs, bad);
    return bad == 0 ? 0 : 3;
}
}

int main(int argc, char** argv)
{
    if (argc != 2) {
        std::fprintf(stderr, "usage: %s device_id\n", argv[0]);
        return 2;
    }
    const int deviceId = std::atoi(argv[1]);
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));

    int64_t availableCoreNum = 0;
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    const int64_t rows = std::max<int64_t>(2, availableCoreNum / 2);
    const int64_t fallbackCap = rows - 1;
    if (availableCoreNum < 2 || rows > availableCoreNum || fallbackCap < 1) {
        std::fprintf(stderr,
                     "PROXY-TINY-V001 cannot form pair: A=%lld M=%lld B=%lld\n",
                     static_cast<long long>(availableCoreNum),
                     static_cast<long long>(rows), static_cast<long long>(fallbackCap));
        return 2;
    }

    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t xyShape[] = {rows, kWidth};
    int64_t parameterShape[] = {kWidth};
    TensorInfo xTensor[] = {{xyShape, 2, 0}};
    TensorInfo residualTensor[] = {{xyShape, 2, 0}};
    TensorInfo gammaTensor[] = {{parameterShape, 1, 0}};
    TensorInfo biasTensor[] = {{parameterShape, 1, 0}};
    TensorInfo outputTensor[] = {{xyShape, 2, 0}};
    TensorGroupInfo infoX = {xTensor, 1};
    TensorGroupInfo infoResidual = {residualTensor, 1};
    TensorGroupInfo infoGamma = {gammaTensor, 1};
    TensorGroupInfo infoBias = {biasTensor, 1};
    TensorGroupInfo infoOutput = {outputTensor, 1};

    const size_t elementCount = static_cast<size_t>(rows * kWidth);
    const size_t dataBytes = elementCount * sizeof(float);
    const size_t parameterBytes = static_cast<size_t>(kWidth) * sizeof(float);
    std::vector<float> hostX(elementCount), hostResidual(elementCount);
    std::vector<float> hostGamma(kWidth), hostBias(kWidth), hostOutput(elementCount);
    for (size_t i = 0; i < elementCount; ++i) {
        hostX[i] = InputValue(static_cast<int64_t>(i), 37, 11);
        hostResidual[i] = InputValue(static_cast<int64_t>(i), 17, 3);
    }
    for (int64_t col = 0; col < kWidth; ++col) {
        hostGamma[static_cast<size_t>(col)] =
            0.75f + static_cast<float>((col * 13) % 100) / 200.0f;
        hostBias[static_cast<size_t>(col)] =
            static_cast<float>((col * 7) % 100) / 400.0f - 0.125f;
    }

    void *deviceX = nullptr, *deviceResidual = nullptr, *deviceGamma = nullptr;
    void *deviceBias = nullptr, *deviceOutput = nullptr;
    ACL_CHECK(aclrtMalloc(&deviceX, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&deviceResidual, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&deviceGamma, parameterBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&deviceBias, parameterBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&deviceOutput, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(deviceX, dataBytes, hostX.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(deviceResidual, dataBytes, hostResidual.data(), dataBytes,
                          ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(deviceGamma, parameterBytes, hostGamma.data(), parameterBytes,
                          ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(deviceBias, parameterBytes, hostBias.data(), parameterBytes,
                          ACL_MEMCPY_HOST_TO_DEVICE));

    std::printf("PROXY-TINY-V001 setup toolchain=%s device=%d A=%lld M=%lld B=%lld "
                "shape=[%lld,256] dtype=FP32\n",
                TINY_TOOLCHAIN_LABEL, deviceId,
                static_cast<long long>(availableCoreNum), static_cast<long long>(rows),
                static_cast<long long>(fallbackCap), static_cast<long long>(rows));
    int status = RunProxyCase("PROXY-TINY-V001-EQUAL-FASTFORM", availableCoreNum,
                              rows, availableCoreNum, stream, hostX, hostResidual,
                              hostGamma, hostBias, hostOutput, deviceX, deviceResidual,
                              deviceGamma, deviceBias, deviceOutput, infoX, infoResidual,
                              infoGamma, infoBias, infoOutput);
    if (status == 0) {
        status = RunProxyCase("PROXY-TINY-V001-NON-EQUAL-PARENT-FALLBACK", fallbackCap,
                              rows, availableCoreNum, stream, hostX, hostResidual,
                              hostGamma, hostBias, hostOutput, deviceX, deviceResidual,
                              deviceGamma, deviceBias, deviceOutput, infoX, infoResidual,
                              infoGamma, infoBias, infoOutput);
    }

    ACL_CHECK(aclrtFree(deviceX));
    ACL_CHECK(aclrtFree(deviceResidual));
    ACL_CHECK(aclrtFree(deviceGamma));
    ACL_CHECK(aclrtFree(deviceBias));
    ACL_CHECK(aclrtFree(deviceOutput));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(deviceId));
    ACL_CHECK(aclFinalize());
    return status;
}
