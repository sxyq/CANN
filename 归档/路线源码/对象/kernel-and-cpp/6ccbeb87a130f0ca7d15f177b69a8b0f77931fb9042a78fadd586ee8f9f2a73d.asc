#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace f001 {

enum DType : uint32_t {
    kFloat16 = 0,
    kBFloat16 = 1,
    kFloat32 = 2,
};

__aicore__ inline float LoadAsFloat(__gm__ const uint8_t* ptr, uint32_t index, uint32_t dtype)
{
    if (dtype == kFloat16) {
        return static_cast<float>(reinterpret_cast<__gm__ const half*>(ptr)[index]);
    }
    if (dtype == kBFloat16) {
        const uint16_t high_bits = reinterpret_cast<__gm__ const uint16_t*>(ptr)[index];
        const uint32_t bits = static_cast<uint32_t>(high_bits) << 16;
        return AscendC::GetScalarBitcodeValue<uint32_t, float>(bits);
    }
    return reinterpret_cast<__gm__ const float*>(ptr)[index];
}

__aicore__ inline void StoreFromFloat(__gm__ uint8_t* ptr, uint32_t index, uint32_t dtype, float value)
{
    if (dtype == kFloat16) {
        reinterpret_cast<__gm__ half*>(ptr)[index] = static_cast<half>(value);
    } else if (dtype == kBFloat16) {
        const uint32_t bits = AscendC::GetScalarBitcodeValue<float, uint32_t>(value);
        reinterpret_cast<__gm__ uint16_t*>(ptr)[index] = static_cast<uint16_t>(bits >> 16);
    } else {
        reinterpret_cast<__gm__ float*>(ptr)[index] = value;
    }
}

__aicore__ inline void ProcessRow(__gm__ const uint8_t* x_bytes,
    __gm__ const uint8_t* residual_bytes,
    __gm__ const uint8_t* gamma_bytes,
    __gm__ const uint8_t* bias_bytes,
    __gm__ uint8_t* output_bytes,
    uint64_t row,
    uint32_t d,
    uint32_t dtype,
    float epsilon,
    float inverse_d)
{
    const uint64_t offset = row * static_cast<uint64_t>(d);
    float sum_sq = 0.0f;
    for (uint32_t col = 0; col < d; ++col) {
        const float value = LoadAsFloat(x_bytes, static_cast<uint32_t>(offset + col), dtype) +
            LoadAsFloat(residual_bytes, static_cast<uint32_t>(offset + col), dtype);
        sum_sq += value * value;
    }
    const float inv_rms = 1.0f / sqrt(sum_sq * inverse_d + epsilon);
    for (uint32_t col = 0; col < d; ++col) {
        const uint32_t absolute = static_cast<uint32_t>(offset + col);
        const float value = LoadAsFloat(x_bytes, absolute, dtype) +
            LoadAsFloat(residual_bytes, absolute, dtype);
        const float scale = LoadAsFloat(gamma_bytes, col, dtype);
        const float addend = LoadAsFloat(bias_bytes, col, dtype);
        StoreFromFloat(output_bytes, absolute, dtype, value * inv_rms * scale + addend);
    }
}

extern "C" __global__ __aicore__ void add_rms_norm_bias_kernel(
    GM_ADDR x,
    GM_ADDR residual,
    GM_ADDR gamma,
    GM_ADDR bias,
    GM_ADDR output,
    uint64_t rows,
    uint32_t d,
    uint32_t dtype,
    float epsilon,
    float inverse_d,
    uint32_t block_dim)
{
    const uint32_t core = AscendC::GetBlockIdx();
    if (core >= block_dim || d == 0) {
        return;
    }

    __gm__ const uint8_t* x_bytes = reinterpret_cast<__gm__ const uint8_t*>(x);
    __gm__ const uint8_t* residual_bytes = reinterpret_cast<__gm__ const uint8_t*>(residual);
    __gm__ const uint8_t* gamma_bytes = reinterpret_cast<__gm__ const uint8_t*>(gamma);
    __gm__ const uint8_t* bias_bytes = reinterpret_cast<__gm__ const uint8_t*>(bias);
    __gm__ uint8_t* output_bytes = reinterpret_cast<__gm__ uint8_t*>(output);

    const bool hot_path = d >= 64 && d <= 32768 && (d & 15U) == 0;
    if (hot_path) {
        for (uint64_t row = core; row < rows; row += block_dim) {
            ProcessRow(x_bytes, residual_bytes, gamma_bytes, bias_bytes, output_bytes,
                row, d, dtype, epsilon, inverse_d);
        }
        return;
    }

    // Generic path keeps complete-row ownership without relying on D alignment.
    for (uint64_t row = core; row < rows; row += block_dim) {
        ProcessRow(x_bytes, residual_bytes, gamma_bytes, bias_bytes, output_bytes,
            row, d, dtype, epsilon, inverse_d);
    }
}

}  // namespace f001

struct F001Tensor {
    const void* data;
    uint64_t elements;
    uint32_t dtype;
};

static uint32_t QueryVectorCoreCount(int32_t device_id)
{
    int64_t core_count = 1;
    if (aclrtGetDeviceInfo(device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &core_count) != ACL_SUCCESS || core_count < 1) {
        return 1;
    }
    return static_cast<uint32_t>(core_count);
}

static size_t ElementBytes(uint32_t dtype)
{
    return dtype == f001::kFloat32 ? sizeof(float) : sizeof(uint16_t);
}

// Host-side launch helper retained for the npu_kernel_dev source interface.
void run_kernel(const F001Tensor& x,
    const F001Tensor& residual,
    const F001Tensor& gamma,
    const F001Tensor& bias,
    void* output,
    uint64_t rows,
    uint32_t d,
    float epsilon)
{
    const int32_t device_id = 0;
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t x_bytes = x.elements * ElementBytes(x.dtype);
    const size_t residual_bytes = residual.elements * ElementBytes(residual.dtype);
    const size_t gamma_bytes = gamma.elements * ElementBytes(gamma.dtype);
    const size_t bias_bytes = bias.elements * ElementBytes(bias.dtype);
    const size_t output_bytes = rows * static_cast<uint64_t>(d) * ElementBytes(x.dtype);
    uint8_t* x_device = nullptr;
    uint8_t* residual_device = nullptr;
    uint8_t* gamma_device = nullptr;
    uint8_t* bias_device = nullptr;
    uint8_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&x_device), x_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&residual_device), residual_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&gamma_device), gamma_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&bias_device), bias_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(x_device, x_bytes, x.data, x_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(residual_device, residual_bytes, residual.data, residual_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(gamma_device, gamma_bytes, gamma.data, gamma_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_device, bias_bytes, bias.data, bias_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    const uint32_t block_dim = static_cast<uint32_t>(std::min<uint64_t>(
        QueryVectorCoreCount(device_id), std::max<uint64_t>(rows, 1)));
    f001::add_rms_norm_bias_kernel<<<block_dim, nullptr, stream>>>(
        x_device, residual_device, gamma_device, bias_device, output_device,
        rows, d, x.dtype, epsilon, 1.0f / static_cast<float>(d), block_dim);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(x_device);
    aclrtFree(residual_device);
    aclrtFree(gamma_device);
    aclrtFree(bias_device);
    aclrtFree(output_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
}

int main(int argc, char** argv)
{
    (void)argc;
    (void)argv;
    return 0;
}
