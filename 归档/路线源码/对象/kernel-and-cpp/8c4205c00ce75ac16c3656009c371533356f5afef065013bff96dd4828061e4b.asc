// Reuse the supplied Parent, its ABI and resource lifetime helpers unchanged.
#define main r14_existing_profile_main
#include "main.asc"
#undef main

#include <algorithm>
#include <chrono>
#include <cmath>
#include <random>
#include <vector>

struct ProbeEvents {
    aclrtEvent start = nullptr;
    aclrtEvent stop = nullptr;
    bool recorded = false;
    ~ProbeEvents()
    {
        if (stop != nullptr) (void)aclrtDestroyEvent(stop);
        if (start != nullptr) (void)aclrtDestroyEvent(start);
    }
};

int main(int argc, char** argv)
{
    if (argc != 8) {
        fprintf(stderr, "usage: %s device rows width available_cores warmup pairs_per_block blocks\n", argv[0]);
        return 2;
    }
    const int device = atoi(argv[1]);
    const int rows = atoi(argv[2]);
    const int width = atoi(argv[3]);
    const int requestedCores = atoi(argv[4]);
    const int warmup = atoi(argv[5]);
    const int pairs = atoi(argv[6]);
    const int blocks = atoi(argv[7]);
    if (device < 0 || rows <= 0 || width <= 0 || requestedCores < 0 ||
        warmup < 10 || pairs < 21 || blocks < 2) return 2;

    Runtime runtime;
    runtime.deviceId = device;
    ACL_REQUIRE(aclInit(nullptr));
    runtime.initialized = true;
    ACL_REQUIRE(aclrtSetDevice(device));
    runtime.deviceSet = true;
    int64_t physicalCores = 0;
    ACL_REQUIRE(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &physicalCores));
    const int64_t availableCores = requestedCores == 0
        ? physicalCores : std::min<int64_t>(requestedCores, physicalCores);
    ACL_REQUIRE(aclrtCreateStream(&runtime.stream));

    const size_t elements = static_cast<size_t>(rows) * width;
    const size_t bytes = elements * sizeof(float);
    const size_t parameterBytes = static_cast<size_t>(width) * sizeof(float);
    std::vector<float> x(elements), residual(elements), gamma(width), bias(width), output(elements);
    std::vector<double> reference(elements);
    std::mt19937 generator(314159u + static_cast<uint32_t>(width));
    std::uniform_real_distribution<float> distribution(-0.5f, 0.5f);
    for (float& v : x) v = distribution(generator);
    for (float& v : residual) v = distribution(generator) * 0.25f;
    for (float& v : gamma) v = distribution(generator) + 1.0f;
    for (float& v : bias) v = distribution(generator) * 0.125f;
    for (int row = 0; row < rows; ++row) {
        const size_t offset = static_cast<size_t>(row) * width;
        double sum = 0.0;
        for (int col = 0; col < width; ++col) {
            const double y = static_cast<double>(x[offset + col]) + residual[offset + col];
            sum += y * y;
        }
        const double inverse = 1.0 / std::sqrt(sum / width + 1.0e-5);
        for (int col = 0; col < width; ++col) {
            const double y = static_cast<double>(x[offset + col]) + residual[offset + col];
            reference[offset + col] = y * inverse * gamma[col] + bias[col];
        }
    }

    DeviceBuffer xd, rd, gd, bd, od;
    if (!Upload(x.data(), bytes, xd) || !Upload(residual.data(), bytes, rd) ||
        !Upload(gamma.data(), parameterBytes, gd) || !Upload(bias.data(), parameterBytes, bd) ||
        !od.Allocate(bytes)) return 1;
    const int64_t shape[] = {rows, width};
    const int64_t parameterShape[] = {width};
    TensorInfo tensor = {shape, 2, 0};
    TensorInfo parameter = {parameterShape, 1, 0};
    TensorGroupInfo info = {&tensor, 1};
    TensorGroupInfo parameterInfo = {&parameter, 1};
    auto launch = [&]() {
        run_kernel((GM_ADDR)xd.ptr, info, (GM_ADDR)rd.ptr, info,
                   (GM_ADDR)gd.ptr, parameterInfo, (GM_ADDR)bd.ptr, parameterInfo,
                   (GM_ADDR)od.ptr, info, availableCores, runtime.stream, 1.0e-5f);
    };
    launch();
    ACL_REQUIRE(aclrtSynchronizeStream(runtime.stream));
    ACL_REQUIRE(aclrtMemcpy(output.data(), bytes, od.ptr, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    size_t mismatches = 0;
    double maxAbsoluteError = 0.0;
    for (size_t i = 0; i < elements; ++i) {
        const double error = std::abs(static_cast<double>(output[i]) - reference[i]);
        maxAbsoluteError = std::max(maxAbsoluteError, error);
        const double tolerance = 2.0e-5 + 1.0e-4 * std::abs(reference[i]);
        if (!std::isfinite(output[i]) || error > tolerance) ++mismatches;
    }
    fprintf(stderr, "REFERENCE rows=%d width=%d dtype=fp32 device=%d physical_cores=%lld available_cores=%lld block_count=%lld mismatches=%zu max_abs=%.12g reference=cpu_fp64 atol=2e-5 rtol=1e-4 seed=%u\n",
            rows, width, device, static_cast<long long>(physicalCores),
            static_cast<long long>(availableCores), static_cast<long long>(std::min<int64_t>(rows, availableCores)),
            mismatches, maxAbsoluteError, 314159u + static_cast<uint32_t>(width));
    if (mismatches != 0) return 3;

    for (int i = 0; i < warmup; ++i) launch();
    ACL_REQUIRE(aclrtSynchronizeStream(runtime.stream));
    ProbeEvents events;
    ACL_REQUIRE(aclrtCreateEvent(&events.start));
    ACL_REQUIRE(aclrtCreateEvent(&events.stop));
    auto measure = [&](double& deviceUs, double& wallUs) -> int {
        if (events.recorded) {
            ACL_REQUIRE(aclrtResetEvent(events.start, runtime.stream));
            ACL_REQUIRE(aclrtResetEvent(events.stop, runtime.stream));
        }
        const auto begin = std::chrono::steady_clock::now();
        ACL_REQUIRE(aclrtRecordEvent(events.start, runtime.stream));
        launch();
        ACL_REQUIRE(aclrtRecordEvent(events.stop, runtime.stream));
        ACL_REQUIRE(aclrtSynchronizeEvent(events.stop));
        const auto end = std::chrono::steady_clock::now();
        float elapsedMs = 0.0f;
        ACL_REQUIRE(aclrtEventElapsedTime(&elapsedMs, events.start, events.stop));
        events.recorded = true;
        deviceUs = static_cast<double>(elapsedMs) * 1000.0;
        wallUs = std::chrono::duration<double, std::micro>(end - begin).count();
        return 0;
    };
    fprintf(stderr, "SAME_BINARY warmup=%d pairs_per_block=%d blocks=%d timing=device_event_primary wall_secondary=1 timed_allocations=0 kernel_change=NONE\n", warmup, pairs, blocks);
    printf("block\tpair\torder\tp1_us\tp2_us\tp1_wall_us\tp2_wall_us\n");
    for (int block = 0; block < blocks; ++block) {
        for (int pair = 0; pair < pairs; ++pair) {
            double p1 = 0.0, p2 = 0.0, w1 = 0.0, w2 = 0.0;
            const bool p1First = ((block + pair) & 1) == 0;
            if (p1First) {
                if (measure(p1, w1) != 0 || measure(p2, w2) != 0) return 1;
            } else {
                if (measure(p2, w2) != 0 || measure(p1, w1) != 0) return 1;
            }
            printf("%d\t%d\t%s\t%.9f\t%.9f\t%.9f\t%.9f\n", block, pair,
                   p1First ? "P1-P2" : "P2-P1", p1, p2, w1, w2);
        }
    }
    ACL_REQUIRE(aclrtSynchronizeStream(runtime.stream));
    return 0;
}
