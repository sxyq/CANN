@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# EPI-X build on cann-server3 (Ascend910B3 / dav-2201).
+set -eo pipefail
+
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+LOGDIR="${ROOT}/logs"
+BUILD="${ROOT}/build"
+mkdir -p "${LOGDIR}"
+
+TOOLKIT="${TOOLKIT:-/usr/local/Ascend/ascend-toolkit/8.5.0.alpha002}"
+set +u
+source "${TOOLKIT}/bin/setenv.bash" >/dev/null 2>&1 || true
+set -u
+
+export ASCEND_HOME_PATH="${TOOLKIT}"
+export CMAKE_PREFIX_PATH="${TOOLKIT}/aarch64-linux/tikcpp/ascendc_kernel_cmake:${CMAKE_PREFIX_PATH:-}"
+export CPLUS_INCLUDE_PATH="/usr/include/c++/11:/usr/include/aarch64-linux-gnu/c++/11${CPLUS_INCLUDE_PATH:+:$CPLUS_INCLUDE_PATH}"
+export C_INCLUDE_PATH="/usr/include:/usr/include/aarch64-linux-gnu${C_INCLUDE_PATH:+:$C_INCLUDE_PATH}"
+
+REV="${REV:-V001}"
+SRC="${ROOT}/${REV}/kernel.asc"
+STAMP="$(date +%Y%m%d_%H%M%S)"
+
+rm -rf "${BUILD}"
+mkdir -p "${BUILD}"
+cd "${BUILD}"
+
+set +e
+cmake "${ROOT}" -DCMAKE_ASC_ARCHITECTURES=dav-2201 -DSOC_VERSION=Ascend910B3 \
+  -DCMAKE_PREFIX_PATH="${CMAKE_PREFIX_PATH}" -DEPIX_REV="${REV}" \
+  >"${LOGDIR}/cmake_configure_${REV}_${STAMP}.log" 2>&1
+CFG_RC=$?
+cmake --build . --target epix_device -j"$(nproc)" >"${LOGDIR}/device_compile_${REV}_${STAMP}.log" 2>&1
+DEV_RC=$?
+cmake --build . --target epix_submission -j"$(nproc)" >"${LOGDIR}/submission_compile_${REV}_${STAMP}.log" 2>&1
+SUB_RC=$?
+cmake --build . --target epix_full -j"$(nproc)" >"${LOGDIR}/full_link_${REV}_${STAMP}.log" 2>&1
+FULL_RC=$?
+set -e
+
+{
+  echo "EPI-X ${REV} build summary ${STAMP}"
+  echo "SOURCE=${SRC}"
+  echo "has_cmath=$(head -1 "$SRC" | grep -c '#include <cmath>' || true)"
+  echo "has_vector_entry=$(grep -c '__global__ __vector__' "$SRC" || true)"
+  echo "has_run_kernel=$(grep -c 'extern \"C\" void run_kernel' "$SRC" || true)"
+  echo "has_rightPadding=$(grep -c 'rightPadding\|rightPad' "$SRC" || true)"
+  echo "has_reduce_tmp_8k=$(grep -c 'kReduceTmpBytes = 8' "$SRC" || true)"
+  echo "has_duplicate=$(grep -c 'Duplicate' "$SRC" || true)"
+  echo "has_rsqrt=$(grep -c 'Rsqrt' "$SRC" || true)"
+  echo "cmake_configure_rc=${CFG_RC}"
+  echo "device_compile_rc=${DEV_RC}"
+  echo "submission_compile_rc=${SUB_RC}"
+  echo "full_link_rc=${FULL_RC}"
+} | tee "${LOGDIR}/build_summary_${REV}_${STAMP}.log"
+
+if [[ ${DEV_RC} -eq 0 && ${SUB_RC} -eq 0 && ${FULL_RC} -eq 0 ]]; then
+  find "${BUILD}" -type f \( -name '*.o' -o -name '*.d' -o -name '*.obj' \) -delete 2>/dev/null || true
+  echo "CLEANUP=ok"
+else
+  echo "CLEANUP=kept build tree"
+fi
+
+exit $(( CFG_RC != 0 || DEV_RC != 0 || SUB_RC != 0 || FULL_RC != 0 ))
diff --git a/phase4/workspaces/EPI-X/local_full.asc b/phase4/workspaces/EPI-X/local_full.asc
new file mode 100644
index 0000000..35239b7
--- /dev/null
+++ b/phase4/workspaces/EPI-X/local_full.asc
@@ -0,0 +1,104 @@
+#include <acl/acl.h>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#include "local_types.h"
+#include "V001/kernel.asc"
+
+static bool ReadExact(const char *path, void *dst, size_t bytes)
+{
+    FILE *file = std::fopen(path, "rb");
+    if (file == nullptr) {
+        return false;
+    }
+    const size_t got = std::fread(dst, 1, bytes, file);
+    const bool ok = got == bytes && std::fgetc(file) == EOF;
+    std::fclose(file);
+    return ok;
+}
+
+static bool WriteExact(const char *path, const void *src, size_t bytes)
+{
+    FILE *file = std::fopen(path, "wb");
+    if (file == nullptr) {
+        return false;
+    }
+    const bool ok = std::fwrite(src, 1, bytes, file) == bytes;
+    std::fclose(file);
+    return ok;
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 4) {
+        std::fprintf(stderr, "usage: %s rows dim dtype\n", argv[0]);
+        return 2;
+    }
+    const int64_t rows = std::atoll(argv[1]);
+    const int64_t dim = std::atoll(argv[2]);
+    const int32_t dtype = std::atoi(argv[3]);
+    if (rows <= 0 || dim <= 0 || (dtype != 0 && dtype != 1 && dtype != 2 && dtype != 27)) {
+        return 2;
+    }
+    const size_t elemBytes = dtype == 0 ? sizeof(float) : sizeof(uint16_t);
+    const size_t xyBytes = static_cast<size_t>(rows) * static_cast<size_t>(dim) * elemBytes;
+    const size_t gbBytes = static_cast<size_t>(dim) * elemBytes;
+    std::vector<uint8_t> x(xyBytes), residual(xyBytes), gamma(gbBytes), bias(gbBytes), output(xyBytes);
+    if (!ReadExact("input/x.bin", x.data(), xyBytes) ||
+        !ReadExact("input/residual.bin", residual.data(), xyBytes) ||
+        !ReadExact("input/gamma.bin", gamma.data(), gbBytes) ||
+        !ReadExact("input/bias.bin", bias.data(), gbBytes)) {
+        std::fprintf(stderr, "input read failed\n");
+        return 1;
+    }
+
+    aclError ret = aclInit(nullptr);
+    if (ret != ACL_ERROR_NONE) return 1;
+    ret = aclrtSetDevice(0);
+    if (ret != ACL_ERROR_NONE) return 1;
+    int64_t coreCount = 0;
+    ret = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount);
+    if (ret != ACL_ERROR_NONE) return 1;
+    aclrtStream stream = nullptr;
+    ret = aclrtCreateStream(&stream);
+    if (ret != ACL_ERROR_NONE) return 1;
+
+    const long long xShape[] = {rows, dim};
+    const long long gShape[] = {dim};
+    TensorInfo xInfo[] = {{xShape, 2, dtype}};
+    TensorInfo gInfo[] = {{gShape, 1, dtype}};
+    TensorGroupInfo infoX = {xInfo, 1};
+    TensorGroupInfo infoG = {gInfo, 1};
+    std::vector<uint8_t *> device(5, nullptr);
+    const size_t sizes[] = {xyBytes, xyBytes, gbBytes, gbBytes, xyBytes};
+    std::vector<uint8_t *> host = {x.data(), residual.data(), gamma.data(), bias.data(), output.data()};
+    for (size_t i = 0; i < device.size(); ++i) {
+        ret = aclrtMalloc(reinterpret_cast<void **>(&device[i]), sizes[i], ACL_MEM_MALLOC_HUGE_FIRST);
+        if (ret != ACL_ERROR_NONE) return 1;
+        ret = aclrtMemcpy(device[i], sizes[i], host[i], sizes[i], ACL_MEMCPY_HOST_TO_DEVICE);
+        if (ret != ACL_ERROR_NONE) return 1;
+    }
+    run_kernel((GM_ADDR)device[0], infoX, (GM_ADDR)device[1], infoX,
+        (GM_ADDR)device[2], infoG, (GM_ADDR)device[3], infoG,
+        (GM_ADDR)device[4], infoX, coreCount, stream, 1e-5f);
+    ret = aclrtSynchronizeStreamWithTimeout(stream, 10000);
+    if (ret == ACL_ERROR_NONE) {
+        ret = aclrtMemcpy(output.data(), xyBytes, device[4], xyBytes, ACL_MEMCPY_DEVICE_TO_HOST);
+    }
+    if (ret == ACL_ERROR_NONE && !WriteExact("output/output.bin", output.data(), xyBytes)) {
+        ret = 1;
+    }
+    for (uint8_t *ptr : device) {
+        if (ptr != nullptr) aclrtFree(ptr);
+    }
+    aclrtDestroyStream(stream);
+    aclrtResetDevice(0);
+    aclFinalize();
+    if (ret != ACL_ERROR_NONE) {
+        std::fprintf(stderr, "runtime failed ret=%d\n", ret);
+        return 1;
+    }
+    return 0;
+}
diff --git a/phase4/workspaces/EPI-X/local_probe.py b/phase4/workspaces/EPI-X/local_probe.py
new file mode 100644
index 0000000..ad4498b
--- /dev/null
+++ b/phase4/workspaces/EPI-X/local_probe.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+import math
+import os
+import random
+import struct
+import subprocess
+import sys
+
+
+def pack(values, dtype):
+    if dtype == 0:
+        return struct.pack("<%df" % len(values), *values)
+    out = bytearray()
+    for value in values:
+        bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+        if dtype in (2, 27):
+            bits = (bits + 0x7FFF + ((bits >> 16) & 1)) >> 16
+            out += struct.pack("<H", bits & 0xFFFF)
+        else:
+            out += struct.pack("<e", float(value))
+    return bytes(out)
+
+
+def unpack(data, dtype):
+    if dtype == 0:
+        return struct.unpack("<%df" % (len(data) // 4), data)
+    values = []
+    for (half,) in struct.iter_unpack("<H", data):
+        if dtype in (2, 27):
+            values.append(struct.unpack("<f", struct.pack("<I", half << 16))[0])
+        else:
+            values.append(struct.unpack("<e", struct.pack("<H", half))[0])
+    return values
+
+
+def run_case(exe, name, rows, dim, dtype, tolerance):
+    random.seed(1000 + rows * 17 + dim * 3 + dtype)
+    count = rows * dim
+    x = [random.uniform(-2.0, 2.0) for _ in range(count)]
+    residual = [random.uniform(-2.0, 2.0) for _ in range(count)]
+    gamma = [random.uniform(0.8, 1.2) for _ in range(dim)]
+    bias = [random.uniform(-0.3, 0.3) for _ in range(dim)]
+    os.makedirs("input", exist_ok=True)
+    os.makedirs("output", exist_ok=True)
+    for filename, values in (("x.bin", x), ("residual.bin", residual), ("gamma.bin", gamma), ("bias.bin", bias)):
+        with open(os.path.join("input", filename), "wb") as file:
+            file.write(pack(values, dtype))
+    reference = []
+    for row in range(rows):
+        start = row * dim
+        u = [x[start + i] + residual[start + i] for i in range(dim)]
+        inv = 1.0 / math.sqrt(sum(value * value for value in u) / dim + 1e-5)
+        reference.extend(u[i] * inv * gamma[i] + bias[i] for i in range(dim))
+    subprocess.run([exe, str(rows), str(dim), str(dtype)], check=True, timeout=30)
+    with open("output/output.bin", "rb") as file:
+        actual = unpack(file.read(), dtype)
+    expected = unpack(pack(reference, dtype), dtype)
+    errors = [abs(a - b) for a, b in zip(actual, expected)]
+    max_abs = max(errors) if errors else 0.0
+    bad = sum(error > tolerance for error in errors)
+    print("%s rows=%d dim=%d dtype=%d max_abs=%.6g bad=%d" % (name, rows, dim, dtype, max_abs, bad))
+    return bad == 0 and len(actual) == len(expected)
+
+
+def main():
+    exe = sys.argv[1] if len(sys.argv) > 1 else "./epix_full"
+    cases = [
+        ("wide_epilogue", 1, 32768, 1, 0.05),
+        ("adjacent_dtype_f16", 2, 2048, 1, 0.05),
+        ("adjacent_dtype_bf16_27", 2, 2048, 27, 0.12),
+        ("tail_fallback", 3, 511, 0, 0.01),
+        ("tail_fallback_low", 3, 511, 1, 0.05),
+    ]
+    return 0 if all(run_case(exe, *case) for case in cases) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
