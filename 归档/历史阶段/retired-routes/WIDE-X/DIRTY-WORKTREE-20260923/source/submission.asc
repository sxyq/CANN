#include <cmath>
#include "kernel_operator.h"

// WIDE-X V003 — textbook two-pass, GetValue sumsq only. No hierarchical reduce.
// ABI follows known-online-passing H001 style: cmath+kernel_operator only,
// element-unit DataCopyPad rightPadding, CAST_RINT store, GetBlockNum row split.

using namespace AscendC;

namespace {

constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t TILE_HALF = 4096;
constexpr uint32_t TILE_FLOAT = 2048;
constexpr uint32_t SUM_LEN = 16;

template <typename T>
class WideXTwoPass {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
        uint32_t outer, uint32_t dim, float epsilon)
    {
        outer_ = outer;
        dim_ = dim;
        epsilon_ = epsilon;
        tile_len_ = (sizeof(T) == sizeof(float)) ? TILE_FLOAT : TILE_HALF;
        if (tile_len_ > dim_) {
            tile_len_ = dim_;
        }
        if (tile_len_ == 0) {
            tile_len_ = 1;
        }

        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), static_cast<uint64_t>(outer_) * dim_);
        residual_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual), static_cast<uint64_t>(outer_) * dim_);
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma), dim_);
        bias_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias), dim_);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), static_cast<uint64_t>(outer_) * dim_);

        pipe_.InitBuffer(x_queue_, BUFFER_NUM, tile_len_ * sizeof(T));
        pipe_.InitBuffer(residual_queue_, BUFFER_NUM, tile_len_ * sizeof(T));
        pipe_.InitBuffer(gamma_queue_, BUFFER_NUM, tile_len_ * sizeof(T));
        pipe_.InitBuffer(bias_queue_, BUFFER_NUM, tile_len_ * sizeof(T));
        pipe_.InitBuffer(output_queue_, BUFFER_NUM, tile_len_ * sizeof(T));
        pipe_.InitBuffer(x_float_, tile_len_ * sizeof(float));
        pipe_.InitBuffer(residual_float_, tile_len_ * sizeof(float));
        pipe_.InitBuffer(value_float_, tile_len_ * sizeof(float));
        pipe_.InitBuffer(sum_, SUM_LEN * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        const uint32_t block = GetBlockIdx();
        const uint32_t blocks = GetBlockNum() == 0 ? 1U : GetBlockNum();
        const uint32_t each = outer_ / blocks;
        const uint32_t extra = outer_ % blocks;
        const uint32_t first = block * each + (block < extra ? block : extra);
        const uint32_t count = each + (block < extra ? 1U : 0U);
        for (uint32_t row = first; row < first + count; ++row) {
            // Pass 1: textbook GetValue accumulate of u*u (no hierarchical reduce).
            float square_sum = 0.0f;
            uint32_t offset = 0;
            const uint32_t base = row * dim_;
            while (offset < dim_) {
                const uint32_t valid_len = (dim_ - offset < tile_len_) ? (dim_ - offset) : tile_len_;
                square_sum += TileSumSq(base + offset, valid_len);
                offset += valid_len;
            }
            const float rms = sqrtf(square_sum / static_cast<float>(dim_) + epsilon_);
            const float scale = 1.0f / rms;
            // Pass 2: normalize.
            offset = 0;
            while (offset < dim_) {
                const uint32_t valid_len = (dim_ - offset < tile_len_) ? (dim_ - offset) : tile_len_;
                NormalizeTile(base + offset, offset, valid_len, scale);
                offset += valid_len;
            }
        }
    }

private:
    __aicore__ inline uint32_t AlignedLen(uint32_t len) const
    {
        const uint32_t epb = 32U / static_cast<uint32_t>(sizeof(T));
        return ((len + epb - 1U) / epb) * epb;
    }

    __aicore__ inline void CopyIn(LocalTensor<T> dst, const GlobalTensor<T>& src, uint32_t offset,
        uint32_t len)
    {
        const uint32_t aligned_len = AlignedLen(len);
        const uint32_t right_padding = aligned_len - len;
        DataCopyExtParams params{1, static_cast<uint32_t>(len * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad{right_padding != 0, 0, static_cast<uint8_t>(right_padding), T(0)};
        DataCopyPad(dst, src[offset], params, pad);
    }

    __aicore__ inline void CopyOut(const LocalTensor<T> src, const GlobalTensor<T>& dst, uint32_t offset,
        uint32_t len)
    {
        DataCopyExtParams params{1, static_cast<uint32_t>(len * sizeof(T)), 0, 0, 0};
        DataCopyPad(dst[offset], src, params);
    }

    __aicore__ inline void ToFloat(LocalTensor<float> value, LocalTensor<T> x, LocalTensor<T> residual,
        uint32_t len)
    {
        if constexpr (sizeof(T) == sizeof(float)) {
            Add(value, x, residual, static_cast<int32_t>(len));
        } else {
            Cast(x_float_.Get<float>(), x, RoundMode::CAST_NONE, static_cast<int32_t>(len));
            Cast(residual_float_.Get<float>(), residual, RoundMode::CAST_NONE, static_cast<int32_t>(len));
            Add(value, x_float_.Get<float>(), residual_float_.Get<float>(), static_cast<int32_t>(len));
        }
    }

    __aicore__ inline void Affine(LocalTensor<float> value, LocalTensor<T> gamma, LocalTensor<T> bias,
        uint32_t len)
    {
        const int32_t n = static_cast<int32_t>(len);
        if constexpr (sizeof(T) == sizeof(float)) {
            Mul(value, value, gamma, n);
            Add(value, value, bias, n);
        } else {
            Cast(x_float_.Get<float>(), gamma, RoundMode::CAST_NONE, n);
            Cast(residual_float_.Get<float>(), bias, RoundMode::CAST_NONE, n);
            Mul(value, value, x_float_.Get<float>(), n);
            Add(value, value, residual_float_.Get<float>(), n);
        }
    }

    // Textbook GetValue sum of squares over one tile of u = x+residual.
    __aicore__ inline float TileSumSq(uint32_t gm_offset, uint32_t valid_len)
    {
        LocalTensor<T> x_local = x_queue_.AllocTensor<T>();
        LocalTensor<T> r_local = residual_queue_.AllocTensor<T>();
        CopyIn(x_local, x_, gm_offset, valid_len);
        CopyIn(r_local, residual_, gm_offset, valid_len);
        x_queue_.EnQue(x_local);
        residual_queue_.EnQue(r_local);
        x_local = x_queue_.DeQue<T>();
        r_local = residual_queue_.DeQue<T>();

        LocalTensor<float> value = value_float_.Get<float>();
        ToFloat(value, x_local, r_local, valid_len);
        PipeBarrier<PIPE_V>();
        event_t ev = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(ev);
        WaitFlag<HardEvent::V_S>(ev);

        float acc = 0.0f;
        for (uint32_t i = 0; i < valid_len; ++i) {
            const float v = value.GetValue(i);
            acc += v * v;
        }
        event_t ev2 = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(ev2);
        WaitFlag<HardEvent::S_V>(ev2);
        PipeBarrier<PIPE_V>();

        x_queue_.FreeTensor(x_local);
        residual_queue_.FreeTensor(r_local);
        return acc;
    }

    __aicore__ inline void NormalizeTile(uint32_t gm_offset, uint32_t dim_offset, uint32_t valid_len,
        float scale)
    {
        LocalTensor<T> x_local = x_queue_.AllocTensor<T>();
        LocalTensor<T> r_local = residual_queue_.AllocTensor<T>();
        LocalTensor<T> g_local = gamma_queue_.AllocTensor<T>();
        LocalTensor<T> b_local = bias_queue_.AllocTensor<T>();
        CopyIn(x_local, x_, gm_offset, valid_len);
        CopyIn(r_local, residual_, gm_offset, valid_len);
        CopyIn(g_local, gamma_, dim_offset, valid_len);
        CopyIn(b_local, bias_, dim_offset, valid_len);
        x_queue_.EnQue(x_local);
        residual_queue_.EnQue(r_local);
        gamma_queue_.EnQue(g_local);
        bias_queue_.EnQue(b_local);
        x_local = x_queue_.DeQue<T>();
        r_local = residual_queue_.DeQue<T>();
        g_local = gamma_queue_.DeQue<T>();
        b_local = bias_queue_.DeQue<T>();

        LocalTensor<float> value = value_float_.Get<float>();
        ToFloat(value, x_local, r_local, valid_len);
        Muls(value, value, scale, static_cast<int32_t>(valid_len));
        Affine(value, g_local, b_local, valid_len);

        LocalTensor<T> out_local = output_queue_.AllocTensor<T>();
        if constexpr (sizeof(T) == sizeof(float)) {
            DataCopy(out_local, value, static_cast<int32_t>(valid_len));
        } else {
            Cast(out_local, value, RoundMode::CAST_RINT, static_cast<int32_t>(valid_len));
        }
        output_queue_.EnQue(out_local);
        out_local = output_queue_.DeQue<T>();
        CopyOut(out_local, output_, gm_offset, valid_len);
        output_queue_.FreeTensor(out_local);

        x_queue_.FreeTensor(x_local);
        residual_queue_.FreeTensor(r_local);
        gamma_queue_.FreeTensor(g_local);
        bias_queue_.FreeTensor(b_local);
    }

    TPipe pipe_;
    TQue<QuePosition::VECIN, BUFFER_NUM> x_queue_, residual_queue_, gamma_queue_, bias_queue_;
    TQue<QuePosition::VECOUT, BUFFER_NUM> output_queue_;
    TBuf<TPosition::VECCALC> x_float_, residual_float_, value_float_, sum_;
    GlobalTensor<T> x_, residual_, gamma_, bias_, output_;
    uint32_t outer_{0};
    uint32_t dim_{0};
    uint32_t tile_len_{256};
    float epsilon_{1e-5f};
};

template <typename T>
__aicore__ inline void RunTwoPass(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t outer, uint32_t dim, float epsilon)
{
    WideXTwoPass<T> op;
    op.Init(x, residual, gamma, bias, output, outer, dim, epsilon);
    op.Process();
}

inline bool IsSingleTensorGroup(const TensorGroupInfo& info)
{
    return info.tensors != nullptr && info.numTensors >= 1 && info.tensors[0].shape != nullptr;
}

inline bool IsPositiveShape(const TensorInfo& t)
{
    if (t.numDims < 1 || t.numDims > 4) {
        return false;
    }
    for (int64_t i = 0; i < t.numDims; ++i) {
        if (t.shape[i] <= 0) {
            return false;
        }
    }
    return true;
}

inline bool SameShape(const TensorInfo& a, const TensorInfo& b)
{
    if (a.numDims != b.numDims) {
        return false;
    }
    for (int64_t i = 0; i < a.numDims; ++i) {
        if (a.shape[i] != b.shape[i]) {
            return false;
        }
    }
    return true;
}

inline bool Validate(const TensorGroupInfo& info_x, const TensorGroupInfo& info_residual,
    const TensorGroupInfo& info_gamma, const TensorGroupInfo& info_bias, const TensorGroupInfo& info_output,
    uint32_t& outer, uint32_t& dim, uint32_t& dtype)
{
    if (!IsSingleTensorGroup(info_x) || !IsSingleTensorGroup(info_residual) ||
        !IsSingleTensorGroup(info_gamma) || !IsSingleTensorGroup(info_bias) ||
        !IsSingleTensorGroup(info_output)) {
        return false;
    }
    const TensorInfo& x = info_x.tensors[0];
    const TensorInfo& r = info_residual.tensors[0];
    const TensorInfo& g = info_gamma.tensors[0];
    const TensorInfo& b = info_bias.tensors[0];
    const TensorInfo& o = info_output.tensors[0];
    if (!IsPositiveShape(x) || !IsPositiveShape(r) || !IsPositiveShape(g) || !IsPositiveShape(b) ||
        !IsPositiveShape(o)) {
        return false;
    }
    if (!SameShape(x, r) || !SameShape(x, o) || g.numDims != 1 || b.numDims != 1 ||
        g.shape[0] != x.shape[x.numDims - 1] || b.shape[0] != x.shape[x.numDims - 1]) {
        return false;
    }
    if (x.dtype < 0 || x.dtype > 2 || r.dtype != x.dtype || g.dtype != x.dtype || b.dtype != x.dtype ||
        o.dtype != x.dtype) {
        return false;
    }
    dim = static_cast<uint32_t>(x.shape[x.numDims - 1]);
    uint64_t rows = 1;
    for (int64_t i = 0; i < x.numDims - 1; ++i) {
        rows *= static_cast<uint64_t>(x.shape[i]);
    }
    outer = static_cast<uint32_t>(rows);
    dtype = static_cast<uint32_t>(x.dtype);
    return outer > 0 && dim > 0;
}

}  // namespace

extern "C" __global__ __vector__ void add_rms_norm_bias_kernel(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
    GM_ADDR bias, GM_ADDR output, uint32_t outer, uint32_t dim, float epsilon, uint32_t dtype)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        return;
    }
    if (outer == 0 || dim == 0) {
        return;
    }
    if (dtype == 0) {
        RunTwoPass<float>(x, residual, gamma, bias, output, outer, dim, epsilon);
    } else if (dtype == 1) {
        RunTwoPass<half>(x, residual, gamma, bias, output, outer, dim, epsilon);
    } else if (dtype == 2) {
        RunTwoPass<bfloat16_t>(x, residual, gamma, bias, output, outer, dim, epsilon);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
    const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma, GM_ADDR bias,
    const TensorGroupInfo& info_bias, GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        return;
    }
    uint32_t outer = 0;
    uint32_t dim = 0;
    uint32_t dtype = 0;
    if (!Validate(info_x, info_residual, info_gamma, info_bias, info_output, outer, dim, dtype)) {
        return;
    }
    uint32_t blocks = availableCoreNum > 0 ? static_cast<uint32_t>(availableCoreNum) : 1U;
    if (blocks > outer) {
        blocks = outer;
    }
    if (blocks == 0) {
        return;
    }
    add_rms_norm_bias_kernel<<<blocks, nullptr, stream>>>(x, residual, gamma, bias, output, outer, dim,
        epsilon, dtype);
}
