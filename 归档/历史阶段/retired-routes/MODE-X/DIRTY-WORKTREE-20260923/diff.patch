diff --git a/phase4/workspaces/MODE-X/local_full.asc b/phase4/workspaces/MODE-X/local_full.asc
new file mode 100644
index 0000000..dfdfc33
--- /dev/null
+++ b/phase4/workspaces/MODE-X/local_full.asc
@@ -0,0 +1,120 @@
+// Local full-link driver. Not submitted.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cmath>
+#include "acl/acl.h"
+
+#ifndef TENSOR_GROUP_INFO_DEFINED
+#define TENSOR_GROUP_INFO_DEFINED
+struct TensorInfo {
+    const int64_t* shape;
+    int64_t numDims;
+    int32_t dtype;
+};
+struct TensorGroupInfo {
+    const TensorInfo* tensors;
+    int64_t numTensors;
+};
+#endif
+
+#include <vector>
+#include "data_utils.h"
+
+#define ACL_CHECK(expr) \
+    do { \
+        aclError _ret = (expr); \
+        if (_ret != 0) { \
+            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); \
+            return 1; \
+        } \
+    } while (0)
+#define FILE_CHECK(expr) \
+    do { \
+        if (!(expr)) { \
+            fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); \
+            return 1; \
+        } \
+    } while (0)
+
+#include "submission.asc"
+
+// Usage: mode_x_full_link rows d dtype
+// reads ./input/{x,residual,gamma,bias}.bin writes ./output/output.bin
+int main(int argc, char** argv)
+{
+    if (argc < 4) {
+        fprintf(stderr, "usage: %s rows d dtype\n", argv[0]);
+        return 2;
+    }
+    const int64_t rows = atoll(argv[1]);
+    const int64_t d = atoll(argv[2]);
+    const int32_t dtype = atoi(argv[3]);
+    const size_t es = dtype == 0 ? 4u : 2u;
+    const size_t xyBytes = (size_t)rows * (size_t)d * es;
+    const size_t gbBytes = (size_t)d * es;
+    float epsilon = 1e-5f;
+
+    int32_t deviceId = 0;
+    int64_t availableCoreNum = 0;
+    aclrtStream stream = nullptr;
+    ACL_CHECK(aclInit(nullptr));
+    ACL_CHECK(aclrtSetDevice(deviceId));
+    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
+    ACL_CHECK(aclrtCreateStream(&stream));
+
+    int64_t x_shape[] = {rows, d};
+    int64_t g_shape[] = {d};
+    TensorInfo x_t[] = {{x_shape, 2, dtype}};
+    TensorInfo r_t[] = {{x_shape, 2, dtype}};
+    TensorInfo g_t[] = {{g_shape, 1, dtype}};
+    TensorInfo b_t[] = {{g_shape, 1, dtype}};
+    TensorInfo o_t[] = {{x_shape, 2, dtype}};
+    TensorGroupInfo info_x = {x_t, 1};
+    TensorGroupInfo info_r = {r_t, 1};
+    TensorGroupInfo info_g = {g_t, 1};
+    TensorGroupInfo info_b = {b_t, 1};
+    TensorGroupInfo info_o = {o_t, 1};
+
+    uint8_t *hx = nullptr, *dx = nullptr, *hr = nullptr, *dr = nullptr;
+    uint8_t *hg = nullptr, *dg = nullptr, *hb = nullptr, *db = nullptr;
+    uint8_t *ho = nullptr, *doo = nullptr;
+    ACL_CHECK(aclrtMallocHost((void**)&hx, xyBytes));
+    ACL_CHECK(aclrtMalloc((void**)&dx, xyBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMallocHost((void**)&hr, xyBytes));
+    ACL_CHECK(aclrtMalloc((void**)&dr, xyBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMallocHost((void**)&hg, gbBytes));
+    ACL_CHECK(aclrtMalloc((void**)&dg, gbBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMallocHost((void**)&hb, gbBytes));
+    ACL_CHECK(aclrtMalloc((void**)&db, gbBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMallocHost((void**)&ho, xyBytes));
+    ACL_CHECK(aclrtMalloc((void**)&doo, xyBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    FILE_CHECK(ReadFile("./input/x.bin", xyBytes, hx, xyBytes));
+    FILE_CHECK(ReadFile("./input/residual.bin", xyBytes, hr, xyBytes));
+    FILE_CHECK(ReadFile("./input/gamma.bin", gbBytes, hg, gbBytes));
+    FILE_CHECK(ReadFile("./input/bias.bin", gbBytes, hb, gbBytes));
+    ACL_CHECK(aclrtMemcpy(dx, xyBytes, hx, xyBytes, ACL_MEMCPY_HOST_TO_DEVICE));
+    ACL_CHECK(aclrtMemcpy(dr, xyBytes, hr, xyBytes, ACL_MEMCPY_HOST_TO_DEVICE));
+    ACL_CHECK(aclrtMemcpy(dg, gbBytes, hg, gbBytes, ACL_MEMCPY_HOST_TO_DEVICE));
+    ACL_CHECK(aclrtMemcpy(db, gbBytes, hb, gbBytes, ACL_MEMCPY_HOST_TO_DEVICE));
+
+    run_kernel((GM_ADDR)dx, info_x, (GM_ADDR)dr, info_r, (GM_ADDR)dg, info_g, (GM_ADDR)db, info_b,
+        (GM_ADDR)doo, info_o, availableCoreNum, stream, epsilon);
+    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 30000);
+    if (sync_ret_ != 0) {
+        fprintf(stderr, "[ERROR] sync ret=%d\n", sync_ret_);
+        return 1;
+    }
+    ACL_CHECK(aclrtMemcpy(ho, xyBytes, doo, xyBytes, ACL_MEMCPY_DEVICE_TO_HOST));
+    FILE_CHECK(WriteFile("./output/output.bin", ho, xyBytes));
+
+    aclrtFree(dx); aclrtFreeHost(hx);
+    aclrtFree(dr); aclrtFreeHost(hr);
+    aclrtFree(dg); aclrtFreeHost(hg);
+    aclrtFree(db); aclrtFreeHost(hb);
+    aclrtFree(doo); aclrtFreeHost(ho);
+    aclrtDestroyStream(stream);
+    aclrtResetDevice(deviceId);
+    aclFinalize();
+    return 0;
+}
