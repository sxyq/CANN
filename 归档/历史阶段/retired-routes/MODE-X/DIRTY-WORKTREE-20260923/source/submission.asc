#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

// MODE-X V001 — Official Tiling Five-Mode Dispatch (R029 taxonomy, own ABI)
// Modes: SINGLE_N / MERGE_N / MULTI_N / SPLIT_D / NORMAL
// Select at runtime from (D, R, UB). No cross-core SyncAll. No official tiling ABI copy.
// Judge ABI: DataCopyPad rightPadding in BYTES; ReduceSum 8KiB tmp 8B-aligned dest;
//            launch <<<blockDim, nullptr, stream>>>; no TensorInfo redefine in this file.

namespace mode_x_v001 {

constexpr uint32_t kReduceTmpBytes = 8 * 1024;
constexpr uint32_t kVecChunk = 128;
constexpr uint32_t kUbBudget = 180 * 1024;
constexpr uint32_t kFixedBytes = kReduceTmpBytes + 768;
constexpr uint32_t kMaxMergeK = 16;
constexpr uint32_t kMinTile = 256;

enum Mode : int32_t {
    MODE_SINGLE_N = 0,
    MODE_MERGE_N = 1,
    MODE_MULTI_N = 2,
    MODE_SPLIT_D = 3,
    MODE_NORMAL = 4
};

__aicore__ inline uint32_t Align32(uint32_t bytes)
{
    return (bytes + 31U) & ~31U;
}

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline uint32_t MaxU32(uint32_t a, uint32_t b)
{
    return a > b ? a : b;
}

// Host-side clones for mode selection (not __aicore__).
inline uint32_t HostAlign32(uint32_t bytes)
{
    return (bytes + 31U) & ~31U;
}

inline uint32_t HostMinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

inline uint32_t HostMaxU32(uint32_t a, uint32_t b)
{
    return a > b ? a : b;
}

// rightPadding unit is BYTES (32B remainder), not elements.
__aicore__ inline uint8_t RightPadBytes(uint32_t bytes)
{
    const uint32_t rem = bytes % 32U;
    return rem == 0U ? static_cast<uint8_t>(0) : static_cast<uint8_t>(32U - rem);
}

template <typename T>
__aicore__ inline void CopyInPad(AscendC::LocalTensor<T> dst, const AscendC::GlobalTensor<T>& src, uint32_t len)
{
    if (len == 0) {
        return;
    }
    const uint32_t bytes = len * static_cast<uint32_t>(sizeof(T));
    const uint8_t rpad = RightPadBytes(bytes);
    AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
    AscendC::DataCopyPadExtParams<T> padParams{rpad != 0, 0, rpad, 0};
    AscendC::DataCopyPad(dst, src, copyParams, padParams);
}

template <typename T>
__aicore__ inline void CopyOutPad(const AscendC::GlobalTensor<T>& dst, AscendC::LocalTensor<T> src, uint32_t len)
{
    if (len == 0) {
        return;
    }
    const uint32_t bytes = len * static_cast<uint32_t>(sizeof(T));
    AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
    AscendC::DataCopyPad(dst, src, copyParams);
}

__aicore__ inline void SyncVToS()
{
    const auto ev = GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(ev);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(ev);
}

__aicore__ inline void SyncMte2ToV()
{
    const auto ev = GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ev);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ev);
}

__aicore__ inline void SyncVToMte3()
{
    const auto ev = GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ev);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ev);
}

// ---- runtime mode selection (host, from D / R / UB) ----
inline uint32_t ElemSize(int32_t dtype)
{
    return dtype == 0 ? 4u : 2u;
}

inline uint32_t SelectTile(uint32_t d, uint32_t es)
{
    const uint32_t per = 4u + 5u * es;  // u fp32 + x,r,g,b,o
    uint32_t room = (kUbBudget > kFixedBytes) ? (kUbBudget - kFixedBytes) / per : kMinTile;
    room = (room / 32u) * 32u;
    uint32_t tile = HostMinU32(d, HostMaxU32(kMinTile, room));
    if (tile > 8192u) {
        tile = 8192u;
    }
    return tile == 0 ? 1u : tile;
}

inline uint32_t SelectMergeK(uint32_t rows, uint32_t d, uint32_t es)
{
    const uint32_t rowBytes = 3u * es * d;  // x,r,out per row in batch
    const uint32_t fixed = 4u * d + 2u * es * d + kFixedBytes;
    uint32_t k = 1;
    if (rowBytes > 0 && kUbBudget > fixed) {
        k = (kUbBudget - fixed) / rowBytes;
    }
    if (k < 1) {
        k = 1;
    }
    if (k > kMaxMergeK) {
        k = kMaxMergeK;
    }
    if (k > rows) {
        k = rows;
    }
    return k;
}

inline bool FullUFits(uint32_t d, uint32_t es)
{
    const uint32_t uBytes = HostAlign32((d + 32u) * 4u);
    const uint32_t minQ = 5u * HostAlign32((kVecChunk + 32u) * es) + 2u * HostAlign32((kVecChunk + 32u) * 4u) + 256u;
    // Keep 25% UB free for pipeline depth beyond residency + fixed.
    return (uBytes + kFixedBytes + minQ) <= (kUbBudget * 3u / 4u);
}

inline int32_t SelectMode(uint32_t rows, uint32_t d, uint32_t es)
{
    if (rows == 0 || d == 0) {
        return MODE_NORMAL;
    }
    const bool fullU = FullUFits(d, es);
    if (!fullU) {
        const uint32_t tile = SelectTile(d, es);
        if (tile >= kMinTile && tile < d) {
            return MODE_SPLIT_D;
        }
        return MODE_NORMAL;
    }
    if (rows == 1) {
        return MODE_SINGLE_N;
    }
    const uint32_t k = SelectMergeK(rows, d, es);
    // Batch only when several rows fit and D is not huge (batch DMA wins on mid/narrow).
    if (k >= 2 && d <= 8192u) {
        return MODE_MERGE_N;
    }
    return MODE_MULTI_N;
}

template <typename T>
class ModeXOp {
public:
    __aicore__ inline ModeXOp(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
        uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores,
        uint32_t mode, uint32_t tileElems, uint32_t mergeK)
    {
        rows_ = rows;
        d_ = d;
        epsilon_ = epsilon;
        invD_ = invD;
        mode_ = mode;
        es_ = static_cast<uint32_t>(sizeof(T));
        chunk_ = MinU32(kVecChunk, d_);
        if (chunk_ == 0) {
            chunk_ = 1;
        }
        tile_ = tileElems == 0 ? chunk_ : tileElems;
        if (tile_ > d_) {
            tile_ = d_;
        }
        if (tile_ == 0) {
            tile_ = 1;
        }
        mergeK_ = mergeK == 0 ? 1u : mergeK;
        usedCores_ = usedCores == 0 ? 1u : usedCores;

        // Contiguous row (or merge-batch) slice for this core. No cross-core wait.
        const uint32_t bid = AscendC::GetBlockIdx();
        if (mode_ == MODE_MERGE_N) {
            const uint32_t units = (rows_ + mergeK_ - 1) / mergeK_;
            const uint32_t per = (units + usedCores_ - 1) / usedCores_;
            if (bid >= usedCores_ || per == 0) {
                firstRow_ = 0;
                rowCount_ = 0;
            } else {
                const uint32_t u0 = bid * per;
                const uint32_t u1 = MinU32(units, u0 + per);
                if (u0 >= u1) {
                    firstRow_ = 0;
                    rowCount_ = 0;
                } else {
                    firstRow_ = u0 * mergeK_;
                    rowCount_ = MinU32(rows_ - firstRow_, (u1 - u0) * mergeK_);
                }
            }
        } else {
            const uint32_t per = (rows_ + usedCores_ - 1) / usedCores_;
            if (bid >= usedCores_ || per == 0) {
                firstRow_ = 0;
                rowCount_ = 0;
            } else {
                firstRow_ = bid * per;
                if (firstRow_ >= rows_) {
                    firstRow_ = 0;
                    rowCount_ = 0;
                } else {
                    rowCount_ = MinU32(rows_ - firstRow_, per);
                }
            }
        }

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), static_cast<uint64_t>(rows_) * d_);
        rGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual), static_cast<uint64_t>(rows_) * d_);
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma), d_);
        bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias), d_);
        oGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), static_cast<uint64_t>(rows_) * d_);

        // Workspace plan driven by mode + UB budget.
        const uint32_t inBytes = Align32((chunk_ + 32u) * es_);
        const uint32_t workBytes = Align32((chunk_ + 32u) * 4u);
        uint32_t uElems = d_ + 32u;
        if (mode_ == MODE_SPLIT_D || mode_ == MODE_NORMAL) {
            uElems = tile_ + 32u;
        }
        const uint32_t uBytes = Align32(uElems * 4u);

        // MERGE_N: multi-row contiguous batch of x/r/o.
        uint32_t batchElems = 0;
        if (mode_ == MODE_MERGE_N) {
            uint32_t krows = mergeK_;
            if (krows > rowCount_) {
                krows = rowCount_;
            }
            batchElems = krows * d_ + 32u;
        }
        const uint32_t batchBytes = batchElems == 0 ? inBytes : Align32(batchElems * es_);

        pipe_->InitBuffer(xQue_, 1, batchBytes);
        pipe_->InitBuffer(rQue_, 1, batchBytes);
        pipe_->InitBuffer(oQue_, 1, batchBytes);
        pipe_->InitBuffer(gQue_, 1, inBytes);
        pipe_->InitBuffer(bQue_, 1, inBytes);
        pipe_->InitBuffer(uBuf_, uBytes);
        pipe_->InitBuffer(workA_, workBytes);
        pipe_->InitBuffer(workB_, workBytes);
        // 8B-aligned ReduceSum dest (32B alloc) + dedicated 8KiB tmp.
        pipe_->InitBuffer(leafBuf_, 32);
        pipe_->InitBuffer(reduceTmp_, kReduceTmpBytes);
        pipe_->InitBuffer(scalarBuf_, 64);
    }

    __aicore__ inline void Process()
    {
        if (rowCount_ == 0) {
            return;
        }
        switch (mode_) {
            case MODE_SINGLE_N:
                ProcessFullU(firstRow_, firstRow_ + 1);
                break;
            case MODE_MERGE_N:
                ProcessMerge();
                break;
            case MODE_MULTI_N:
                ProcessFullU(firstRow_, firstRow_ + rowCount_);
                break;
            case MODE_SPLIT_D:
                ProcessSplit(tile_);
                break;
            case MODE_NORMAL:
            default:
                ProcessSplit(chunk_);
                break;
        }
    }

private:
    __aicore__ inline void AddIntoU(AscendC::LocalTensor<float> uSeg, uint32_t gmOff, uint32_t len)
    {
        for (uint32_t off = 0; off < len; off += chunk_) {
            const uint32_t n32 = MinU32(chunk_, len - off);
            const int32_t n = static_cast<int32_t>(n32);
            AscendC::LocalTensor<T> xLocal = xQue_.AllocTensor<T>();
            AscendC::LocalTensor<T> rLocal = rQue_.AllocTensor<T>();
            CopyInPad<T>(xLocal, xGm_[gmOff + off], n32);
            CopyInPad<T>(rLocal, rGm_[gmOff + off], n32);
            xQue_.EnQue(xLocal);
            rQue_.EnQue(rLocal);
            xLocal = xQue_.DeQue<T>();
            rLocal = rQue_.DeQue<T>();
            if constexpr (sizeof(T) == 4) {
                AscendC::LocalTensor<float> xF = xLocal;
                AscendC::LocalTensor<float> rF = rLocal;
                AscendC::Add<float>(uSeg[off], xF, rF, n);
            } else {
                AscendC::LocalTensor<float> xF = workB_.Get<float>();
                AscendC::LocalTensor<float> rF = workA_.Get<float>();
                AscendC::Cast<float, T>(xF, xLocal, AscendC::RoundMode::CAST_NONE, n);
                AscendC::Cast<float, T>(rF, rLocal, AscendC::RoundMode::CAST_NONE, n);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add<float>(uSeg[off], xF, rF, n);
            }
            AscendC::PipeBarrier<PIPE_V>();
            xQue_.FreeTensor(xLocal);
            rQue_.FreeTensor(rLocal);
        }
    }

    __aicore__ inline float ReduceSquares(AscendC::LocalTensor<float> uSeg, uint32_t len)
    {
        AscendC::LocalTensor<float> reduceTmp = reduceTmp_.Get<float>();
        AscendC::LocalTensor<float> acc = scalarBuf_.Get<float>();
        AscendC::LocalTensor<float> leaf = leafBuf_.Get<float>();
        AscendC::LocalTensor<float> sq = workA_.Get<float>();
        const int32_t one = 1;
        AscendC::Duplicate<float>(acc, 0.0f, one);
        for (uint32_t off = 0; off < len; off += kVecChunk) {
            const uint32_t n32 = MinU32(kVecChunk, len - off);
            const uint32_t reduceN = (n32 + 7U) & ~7U;
            const int32_t n = static_cast<int32_t>(n32);
            AscendC::Mul<float>(sq, uSeg[off], uSeg[off], n);
            if (reduceN > n32) {
                AscendC::Duplicate<float>(sq[n32], 0.0f, static_cast<int32_t>(reduceN - n32));
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceSum<float, true>(leaf, sq, reduceTmp, static_cast<int32_t>(reduceN));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add<float>(acc, acc, leaf, one);
            AscendC::PipeBarrier<PIPE_V>();
        }
        SyncVToS();
        return acc.GetValue(0);
    }

    __aicore__ inline float InvRmsFromSumSq(float sumSq)
    {
        AscendC::LocalTensor<float> s = scalarBuf_.Get<float>();
        AscendC::LocalTensor<float> tmp = workA_.Get<float>();
        AscendC::LocalTensor<float> oneT = workB_.Get<float>();
        const int32_t one = 1;
        const float mean = sumSq * invD_ + epsilon_;
        s.SetValue(0, mean);
        oneT.SetValue(0, 1.0f);
        AscendC::Sqrt<float>(tmp, s, one);
        AscendC::Div<float>(s, oneT, tmp, one);
        SyncVToS();
        return s.GetValue(0);
    }

    __aicore__ inline void ApplyRow(AscendC::LocalTensor<float> uSeg, uint32_t gmOff, uint32_t len, float invRms)
    {
        for (uint32_t off = 0; off < len; off += chunk_) {
            const uint32_t n32 = MinU32(chunk_, len - off);
            const int32_t n = static_cast<int32_t>(n32);
            AscendC::LocalTensor<T> gLocal = gQue_.AllocTensor<T>();
            AscendC::LocalTensor<T> bLocal = bQue_.AllocTensor<T>();
            AscendC::LocalTensor<T> oLocal = oQue_.AllocTensor<T>();
            CopyInPad<T>(gLocal, gGm_[off], n32);
            CopyInPad<T>(bLocal, bGm_[off], n32);
            gQue_.EnQue(gLocal);
            bQue_.EnQue(bLocal);
            gLocal = gQue_.DeQue<T>();
            bLocal = bQue_.DeQue<T>();
            AscendC::LocalTensor<float> y = workA_.Get<float>();
            AscendC::LocalTensor<float> gF = workB_.Get<float>();
            if constexpr (sizeof(T) == 4) {
                AscendC::LocalTensor<float> gg = gLocal;
                AscendC::Mul<float>(y, uSeg[off], gg, n);
            } else {
                AscendC::Cast<float, T>(gF, gLocal, AscendC::RoundMode::CAST_NONE, n);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul<float>(y, uSeg[off], gF, n);
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls<float>(y, y, invRms, n);
            AscendC::PipeBarrier<PIPE_V>();
            if constexpr (sizeof(T) == 4) {
                AscendC::LocalTensor<float> bb = bLocal;
                AscendC::Add<float>(y, y, bb, n);
                AscendC::LocalTensor<float> oo = oLocal;
                AscendC::DataCopy(oo, y, n);
            } else {
                AscendC::Cast<float, T>(gF, bLocal, AscendC::RoundMode::CAST_NONE, n);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add<float>(y, y, gF, n);
                AscendC::Cast<T, float>(oLocal, y, AscendC::RoundMode::CAST_RINT, n);
            }
            AscendC::PipeBarrier<PIPE_V>();
            SyncVToMte3();
            CopyOutPad<T>(oGm_[gmOff + off], oLocal, n32);
            oQue_.FreeTensor(oLocal);
            gQue_.FreeTensor(gLocal);
            bQue_.FreeTensor(bLocal);
        }
    }

    // Full-u residency: one x/r read, u kept in UB, then normalize.
    __aicore__ inline void ProcessFullU(uint32_t rowBegin, uint32_t rowEnd)
    {
        AscendC::LocalTensor<float> uSeg = uBuf_.Get<float>();
        for (uint32_t r = rowBegin; r < rowEnd; ++r) {
            const uint32_t gmOff = r * d_;
            AddIntoU(uSeg, gmOff, d_);
            const float sumSq = ReduceSquares(uSeg, d_);
            const float invRms = InvRmsFromSumSq(sumSq);
            ApplyRow(uSeg, gmOff, d_, invRms);
        }
    }

    // Multi-row batch: one contiguous DataCopyPad for K rows of x/r, then per-row rms.
    __aicore__ inline void ProcessMerge()
    {
        AscendC::LocalTensor<float> uSeg = uBuf_.Get<float>();
        uint32_t remaining = rowCount_;
        uint32_t row = firstRow_;
        while (remaining > 0) {
            const uint32_t krows = MinU32(mergeK_, remaining);
            const uint32_t batchLen = krows * d_;
            const uint32_t batchOff = row * d_;

            AscendC::LocalTensor<T> xBatch = xQue_.AllocTensor<T>();
            AscendC::LocalTensor<T> rBatch = rQue_.AllocTensor<T>();
            CopyInPad<T>(xBatch, xGm_[batchOff], batchLen);
            CopyInPad<T>(rBatch, rGm_[batchOff], batchLen);
            xQue_.EnQue(xBatch);
            rQue_.EnQue(rBatch);
            xBatch = xQue_.DeQue<T>();
            rBatch = rQue_.DeQue<T>();
            SyncMte2ToV();

            for (uint32_t i = 0; i < krows; ++i) {
                const uint32_t rowOff = i * d_;
                for (uint32_t off = 0; off < d_; off += chunk_) {
                    const uint32_t n32 = MinU32(chunk_, d_ - off);
                    const int32_t n = static_cast<int32_t>(n32);
                    if constexpr (sizeof(T) == 4) {
                        AscendC::LocalTensor<float> xF = xBatch[rowOff + off];
                        AscendC::LocalTensor<float> rF = rBatch[rowOff + off];
                        AscendC::Add<float>(uSeg[off], xF, rF, n);
                    } else {
                        AscendC::LocalTensor<float> xF = workB_.Get<float>();
                        AscendC::LocalTensor<float> rF = workA_.Get<float>();
                        AscendC::Cast<float, T>(xF, xBatch[rowOff + off], AscendC::RoundMode::CAST_NONE, n);
                        AscendC::Cast<float, T>(rF, rBatch[rowOff + off], AscendC::RoundMode::CAST_NONE, n);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add<float>(uSeg[off], xF, rF, n);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                }
                const float sumSq = ReduceSquares(uSeg, d_);
                const float invRms = InvRmsFromSumSq(sumSq);
                ApplyRow(uSeg, (row + i) * d_, d_, invRms);
            }
            xQue_.FreeTensor(xBatch);
            rQue_.FreeTensor(rBatch);
            row += krows;
            remaining -= krows;
        }
    }

    // D-tile running reduce (NOT cross-core SyncAll D-slice).
    // Phase 1 accumulates sum(u*u) over tiles; Phase 2 re-applies normalize.
    __aicore__ inline void ProcessSplit(uint32_t tileElems)
    {
        AscendC::LocalTensor<float> uSeg = uBuf_.Get<float>();
        const uint32_t tile = tileElems == 0 ? chunk_ : tileElems;
        for (uint32_t r = firstRow_; r < firstRow_ + rowCount_; ++r) {
            const uint32_t gmOff = r * d_;
            AscendC::LocalTensor<float> acc = scalarBuf_.Get<float>();
            AscendC::LocalTensor<float> leaf = leafBuf_.Get<float>();
            AscendC::LocalTensor<float> reduceTmp = reduceTmp_.Get<float>();
            AscendC::LocalTensor<float> sq = workA_.Get<float>();
            const int32_t one = 1;
            AscendC::Duplicate<float>(acc, 0.0f, one);
            for (uint32_t col = 0; col < d_; col += tile) {
                const uint32_t len = MinU32(tile, d_ - col);
                AddIntoU(uSeg, gmOff + col, len);
                for (uint32_t off = 0; off < len; off += kVecChunk) {
                    const uint32_t n32 = MinU32(kVecChunk, len - off);
                    const uint32_t reduceN = (n32 + 7U) & ~7U;
                    const int32_t n = static_cast<int32_t>(n32);
                    AscendC::Mul<float>(sq, uSeg[off], uSeg[off], n);
                    if (reduceN > n32) {
                        AscendC::Duplicate<float>(sq[n32], 0.0f, static_cast<int32_t>(reduceN - n32));
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::ReduceSum<float, true>(leaf, sq, reduceTmp, static_cast<int32_t>(reduceN));
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add<float>(acc, acc, leaf, one);
                    AscendC::PipeBarrier<PIPE_V>();
                }
            }
            SyncVToS();
            const float sumSq = acc.GetValue(0);
            const float invRms = InvRmsFromSumSq(sumSq);
            for (uint32_t col = 0; col < d_; col += tile) {
                const uint32_t len = MinU32(tile, d_ - col);
                AddIntoU(uSeg, gmOff + col, len);
                ApplyRow(uSeg, gmOff + col, len, invRms);
            }
        }
    }

    AscendC::TPipe* pipe_{nullptr};
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQue_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> rQue_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> gQue_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> bQue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> oQue_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> uBuf_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> workA_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> workB_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> leafBuf_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> reduceTmp_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> scalarBuf_;

    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> rGm_;
    AscendC::GlobalTensor<T> gGm_;
    AscendC::GlobalTensor<T> bGm_;
    AscendC::GlobalTensor<T> oGm_;

    uint32_t rows_{0};
    uint32_t d_{0};
    float epsilon_{1e-5f};
    float invD_{1.0f};
    uint32_t firstRow_{0};
    uint32_t rowCount_{0};
    uint32_t usedCores_{1};
    uint32_t mode_{0};
    uint32_t es_{2};
    uint32_t chunk_{128};
    uint32_t tile_{128};
    uint32_t mergeK_{1};
};

template <typename T>
__aicore__ inline void RunMode(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores,
    uint32_t mode, uint32_t tileElems, uint32_t mergeK)
{
    AscendC::TPipe pipe;
    ModeXOp<T> op(&pipe);
    op.Init(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores, mode, tileElems, mergeK);
    op.Process();
}

}  // namespace mode_x_v001

extern "C" __global__ __vector__ void mode_x_add_rms_norm_bias(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
    GM_ADDR bias, GM_ADDR output, uint32_t rows, uint32_t d, float epsilon, float invD, uint32_t usedCores,
    uint32_t mode, uint32_t tileElems, uint32_t mergeK, int32_t dtype)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        return;
    }
    if (rows == 0 || d == 0 || usedCores == 0) {
        return;
    }
    if (dtype == 0) {
        mode_x_v001::RunMode<float>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores,
            mode, tileElems, mergeK);
    } else if (dtype == 1) {
        mode_x_v001::RunMode<half>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores,
            mode, tileElems, mergeK);
    } else if (dtype == 2) {
        mode_x_v001::RunMode<bfloat16_t>(x, residual, gamma, bias, output, rows, d, epsilon, invD, usedCores,
            mode, tileElems, mergeK);
    }
}

#ifndef MODE_X_DEVICE_ONLY
namespace mode_x_v001 {
namespace {

inline bool GroupPresent(const TensorGroupInfo& g)
{
    return g.tensors != nullptr && g.numTensors > 0 && g.tensors[0].shape != nullptr && g.tensors[0].numDims > 0;
}

inline void ShapeRD(const TensorGroupInfo& g, uint32_t& rows, uint32_t& d)
{
    const TensorInfo& t = g.tensors[0];
    d = static_cast<uint32_t>(t.shape[t.numDims - 1]);
    uint64_t r = 1;
    for (int64_t i = 0; i < t.numDims - 1; ++i) {
        r *= static_cast<uint64_t>(t.shape[i]);
    }
    rows = static_cast<uint32_t>(r);
}

}  // namespace
}  // namespace mode_x_v001

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR residual,
    const TensorGroupInfo& info_residual, GM_ADDR gamma, const TensorGroupInfo& info_gamma, GM_ADDR bias,
    const TensorGroupInfo& info_bias, GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    if (x == nullptr || residual == nullptr || gamma == nullptr || bias == nullptr || output == nullptr) {
        return;
    }
    if (!mode_x_v001::GroupPresent(info_x) || !mode_x_v001::GroupPresent(info_residual) ||
        !mode_x_v001::GroupPresent(info_gamma) || !mode_x_v001::GroupPresent(info_bias) ||
        !mode_x_v001::GroupPresent(info_output)) {
        return;
    }
    uint32_t rows = 0;
    uint32_t d = 0;
    mode_x_v001::ShapeRD(info_x, rows, d);
    if (rows == 0 || d == 0 || availableCoreNum <= 0) {
        return;
    }
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype < 0 || dtype > 2) {
        return;
    }
    const uint32_t es = mode_x_v001::ElemSize(dtype);
    const int32_t mode = mode_x_v001::SelectMode(rows, d, es);
    const uint32_t tileElems = mode_x_v001::SelectTile(d, es);
    const uint32_t mergeK = mode_x_v001::SelectMergeK(rows, d, es);
    const float invD = 1.0f / static_cast<float>(d);

    uint32_t usedCores = rows;
    if (mode == mode_x_v001::MODE_MERGE_N) {
        const uint32_t k = mergeK == 0 ? 1u : mergeK;
        usedCores = (rows + k - 1) / k;
    }
    if (static_cast<int64_t>(usedCores) > availableCoreNum) {
        usedCores = static_cast<uint32_t>(availableCoreNum);
    }
    if (usedCores == 0) {
        return;
    }

    // Row-parallel (or batch-parallel) partition. SINGLE_N uses 1 core / 1 row.
    // Each core takes a contiguous slice of rows; SPLIT_D/NORMAL tile D inside the core.
    // No SyncAll: idle cores exit, workers never wait on non-workers.
    mode_x_add_rms_norm_bias<<<usedCores, nullptr, stream>>>(x, residual, gamma, bias, output, rows, d, epsilon,
        invD, usedCores, static_cast<uint32_t>(mode), tileElems, mergeK, dtype);
}
#endif  // MODE_X_DEVICE_ONLY
