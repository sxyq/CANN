#include <stdint.h>
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include "acl/acl.h"
#include "../op_kernel/add_rms_norm_bias_tiling.h"

#define GM_ADDR __gm__ uint8_t*
extern "C" __global__ __vector__ void add_rms_norm_bias_kernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR out, GM_ADDR tiling);

static bool ReadBinary(const char* path, void* buffer, size_t length)
{
    int fd = open(path, O_RDONLY);
    if (fd < 0) return false;
    ssize_t n = read(fd, buffer, length);
    close(fd);
    return n == static_cast<ssize_t>(length);
}

static bool WriteBinary(const char* path, const void* buffer, size_t length)
{
    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (fd < 0) return false;
    ssize_t n = write(fd, buffer, length);
    close(fd);
    return n == static_cast<ssize_t>(length);
}

static void KernelCall(uint32_t blockNum, aclrtStream stream,
                       const char* const* inputNames, const size_t* inputLengths,
                       const char* outputName, size_t outputLength,
                       const AddRmsNormBiasTilingData& tiling)
{
    uint8_t* hostIn[4] = {nullptr, nullptr, nullptr, nullptr};
    uint8_t* devIn[4] = {nullptr, nullptr, nullptr, nullptr};
    uint8_t* hostOut = nullptr;
    uint8_t* devOut = nullptr;
    uint8_t* devTiling = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&devTiling), sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE);

    for (int i = 0; i < 4; ++i) {
        aclrtMallocHost(reinterpret_cast<void**>(&hostIn[i]), inputLengths[i]);
        aclrtMalloc(reinterpret_cast<void**>(&devIn[i]), inputLengths[i], ACL_MEM_MALLOC_HUGE_FIRST);
        ReadBinary(inputNames[i], hostIn[i], inputLengths[i]);
        aclrtMemcpy(devIn[i], inputLengths[i], hostIn[i], inputLengths[i], ACL_MEMCPY_HOST_TO_DEVICE);
    }
    aclrtMallocHost(reinterpret_cast<void**>(&hostOut), outputLength);
    aclrtMalloc(reinterpret_cast<void**>(&devOut), outputLength, ACL_MEM_MALLOC_HUGE_FIRST);

    add_rms_norm_bias_kernel<<<blockNum, nullptr, stream>>>(
        devIn[0], devIn[1], devIn[2], devIn[3], devOut, devTiling);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(hostOut, outputLength, devOut, outputLength, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteBinary(outputName, hostOut, outputLength);
    aclrtFree(devOut);
    aclrtFreeHost(hostOut);
    aclrtFree(devTiling);
    for (int i = 0; i < 4; ++i) {
        aclrtFree(devIn[i]);
        aclrtFreeHost(hostIn[i]);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    const int32_t deviceId = 0;
    int32_t ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        return ret;
    }

    int64_t coreCount = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount);
    if (ret != ACL_SUCCESS || coreCount <= 0) {
        aclrtResetDevice(deviceId);
        return ret == ACL_SUCCESS ? ACL_ERROR_INVALID_PARAM : ret;
    }

    const uint32_t outer = 8;
    const uint32_t dim = 4096;
    const uint32_t alignedDim = ((dim + 7) / 8) * 8;
    const uint32_t rowsPerBlock = 1;
    const uint32_t blockNum = (outer + rowsPerBlock - 1) / rowsPerBlock;
    AddRmsNormBiasTilingData tiling{blockNum, outer, dim, alignedDim, rowsPerBlock, outer - (blockNum - 1) * rowsPerBlock, RNB_EPSILON};
    const size_t rowBytes = static_cast<size_t>(dim) * sizeof(float);
    const size_t inputBytes = static_cast<size_t>(outer) * rowBytes;
    const size_t vectorBytes = rowBytes;

    const char* inputNames[4] = {
        "./input/input_x.bin", "./input/input_residual.bin",
        "./input/input_gamma.bin", "./input/input_bias.bin"};
    const size_t inputLengths[4] = {inputBytes, inputBytes, vectorBytes, vectorBytes};
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    KernelCall(blockNum, stream, inputNames, inputLengths, "./output/output.bin", inputBytes, tiling);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
