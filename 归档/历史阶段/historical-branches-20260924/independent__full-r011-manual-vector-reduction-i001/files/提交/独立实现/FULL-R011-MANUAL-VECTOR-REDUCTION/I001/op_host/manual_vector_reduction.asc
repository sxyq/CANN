// ============================================================================
// Ascend C Kernel 直调样例 - Add 算子（Host + Main 入口）
// ============================================================================
//
// 文件结构说明：
//   op_kernel/manual_vector_reduction_tiling.h   - Tiling 常量 + 结构体（纯 C/C++，kernel 和 host 共用）
//   op_kernel/manual_vector_reduction_kernel.asc - Kernel 实现（KernelManualVectorReduction 类 + manual_vector_reduction_kernel 核函数入口）
//   op_host/manual_vector_reduction.asc          - 本文件：Host 端代码 + main 入口（引用 op_kernel/ 下的文件）
//
// [MODIFY] 创建新算子时的修改点（搜索 [MODIFY] 标记）:
// 1. KernelCall 中的函数名和参数
// 2. Tiling 计算逻辑
// 3. 输入/输出数量
// 4. CMakeLists.txt 中的目标名
// ============================================================================

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include "acl/acl.h"
#include "../op_kernel/manual_vector_reduction_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件（包含 kernel_operator.h）
#include "../op_kernel/manual_vector_reduction_kernel.asc"

// ============================================================================
// Host 端代码 - 运行在 CPU 上
// ============================================================================

struct ArgInfo {
    const char *fileName;
    size_t length;
};

// [PATTERN] KernelCall 封装 - 处理完整的核函数调用流程
// [MODIFY] 修改函数名和参数
void KernelCall(uint32_t blockNum, aclrtStream stream,
    const ArgInfo *inputsInfo, uint32_t inputCount,
    const ArgInfo *outputsInfo, uint32_t outputCount,
    uint8_t *tilingData)
{
    uint8_t *inputHost[4] = {nullptr};
    uint8_t *inputDevice[4] = {nullptr};
    uint8_t *outputHost[2] = {nullptr};
    uint8_t *outputDevice[2] = {nullptr};
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(ManualVectorReductionTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(ManualVectorReductionTilingData), tilingData,
        sizeof(ManualVectorReductionTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (uint32_t i = 0; i < inputCount; i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (uint32_t i = 0; i < outputCount; i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // [MODIFY] kernel 入口函数名
    manual_vector_reduction_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1], inputDevice[2], inputDevice[3],
        outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (uint32_t i = 0; i < outputCount; i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (uint32_t i = 0; i < inputCount; i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// [PATTERN] ACL 标准初始化流程
int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // [MODIFY] 获取设备最大核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // [MODIFY] 根据你的算子调整这些参数
    uint32_t outer = 8;
    uint32_t lastDim = 4096;
    uint64_t totalLength = static_cast<uint64_t>(outer) * lastDim;
    size_t inputByteSize = totalLength * sizeof(float);
    size_t parameterByteSize = static_cast<size_t>(lastDim) * sizeof(float);
    size_t outputByteSize = inputByteSize;

    // [MODIFY] 设置 Tiling 数据
    ManualVectorReductionTilingData tiling;
    uint32_t rowsPerCore = (outer + static_cast<uint32_t>(availableCoreNum) - 1) /
                           static_cast<uint32_t>(availableCoreNum);
    uint32_t blockNum = (outer + rowsPerCore - 1) / rowsPerCore;
    tiling.blockNum = blockNum;
    tiling.outer = outer;
    tiling.lastDim = lastDim;
    tiling.rowsPerCore = rowsPerCore;
    tiling.tailRowsLastCore = outer - rowsPerCore * (blockNum - 1);
    tiling.epsilon = 1e-5f;

    // [MODIFY] 根据你的输入/输出文件调整
    ArgInfo inputsInfo[4] = {
        {"./input/input_x.bin", inputByteSize},
        {"./input/input_residual.bin", inputByteSize},
        {"./input/input_gamma.bin", parameterByteSize},
        {"./input/input_bias.bin", parameterByteSize}
    };
    ArgInfo outputsInfo[1] = {
        {"./output/output.bin", outputByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blockNum, stream, inputsInfo, 4, outputsInfo, 1, (uint8_t *)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
