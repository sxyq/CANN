#include <stdio.h>
#include <stdint.h>
#include <stddef.h>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t *shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo *tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#define ACL_CHECK(expr) do { \
    aclError _ret = (expr); \
    if (_ret != ACL_SUCCESS) { \
        fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); \
        return 1; \
    } \
} while (0)
#define FILE_CHECK(expr) do { \
    if (!(expr)) { \
        fprintf(stderr, "[ERROR] file operation failed at %s:%d\n", __FILE__, __LINE__); \
        return 1; \
    } \
} while (0)

#include "kernel.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t xShape[] = {1, 64};
    TensorInfo xTensors[] = {{xShape, 2, 1}};
    TensorGroupInfo infoX = {xTensors, 1};
    int64_t residualShape[] = {1, 64};
    TensorInfo residualTensors[] = {{residualShape, 2, 1}};
    TensorGroupInfo infoResidual = {residualTensors, 1};
    int64_t gammaShape[] = {64};
    TensorInfo gammaTensors[] = {{gammaShape, 1, 1}};
    TensorGroupInfo infoGamma = {gammaTensors, 1};
    int64_t biasShape[] = {64};
    TensorInfo biasTensors[] = {{biasShape, 1, 1}};
    TensorGroupInfo infoBias = {biasTensors, 1};
    int64_t outputShape[] = {1, 64};
    TensorInfo outputTensors[] = {{outputShape, 2, 1}};
    TensorGroupInfo infoOutput = {outputTensors, 1};

    const size_t bytes = 64 * sizeof(half);
    uint8_t *xHost = nullptr, *xDevice = nullptr;
    uint8_t *residualHost = nullptr, *residualDevice = nullptr;
    uint8_t *gammaHost = nullptr, *gammaDevice = nullptr;
    uint8_t *biasHost = nullptr, *biasDevice = nullptr;
    uint8_t *outputHost = nullptr, *outputDevice = nullptr;

    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void **>(&xHost), bytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void **>(&xDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x.bin", bytes, xHost, bytes));
    ACL_CHECK(aclrtMemcpy(xDevice, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void **>(&residualHost), bytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void **>(&residualDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/residual.bin", bytes, residualHost, bytes));
    ACL_CHECK(aclrtMemcpy(residualDevice, bytes, residualHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void **>(&gammaHost), bytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void **>(&gammaDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/gamma.bin", bytes, gammaHost, bytes));
    ACL_CHECK(aclrtMemcpy(gammaDevice, bytes, gammaHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void **>(&biasHost), bytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void **>(&biasDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/bias.bin", bytes, biasHost, bytes));
    ACL_CHECK(aclrtMemcpy(biasDevice, bytes, biasHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void **>(&outputHost), bytes));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void **>(&outputDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)xDevice, infoX,
               (GM_ADDR)residualDevice, infoResidual,
               (GM_ADDR)gammaDevice, infoGamma,
               (GM_ADDR)biasDevice, infoBias,
               (GM_ADDR)outputDevice, infoOutput,
               availableCoreNum, stream, 1e-5f);

    ACL_CHECK(aclrtSynchronizeStreamWithTimeout(stream, 3000));
    ACL_CHECK(aclrtMemcpy(outputHost, bytes, outputDevice, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/output.bin", outputHost, bytes));

    aclrtFree(xDevice);
    aclrtFreeHost(xHost);
    aclrtFree(residualDevice);
    aclrtFreeHost(residualHost);
    aclrtFree(gammaDevice);
    aclrtFreeHost(gammaHost);
    aclrtFree(biasDevice);
    aclrtFreeHost(biasHost);
    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
