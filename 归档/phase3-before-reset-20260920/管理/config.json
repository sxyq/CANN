{
  "schema_version": 1,
  "submission": {
    "min_interval_seconds": 120,
    "unique_submission_worker": true,
    "require_pushed_commit": true,
    "require_source_identity": true
  },
  "performance_convergence": {
    "minimum_stable_score_gain": 0.1,
    "required_non_improving_valid_versions": 8,
    "required_champion_repeats": 2,
    "maximum_champion_repeat_delta": 0.1,
    "official_score_only": true,
    "local_profiling_is_diagnostic_only": true
  },
  "online_validity": {
    "required_passed_cases": 15,
    "require_official_score": true,
    "excluded_results": [
      "Compile Error",
      "Runtime Error",
      "Precision Error",
      "truncated_upload",
      "unknown_source_identity"
    ]
  },
  "storage": {
    "pause_when_free_space_gib_below": 20,
    "pause_when_filesystem_use_percent_at_least": 98,
    "delete_archived_cache_directly": true,
    "never_delete_repository_root": true,
    "never_delete_public_toolchain": true,
    "never_delete_other_user_data": true
  }
}
